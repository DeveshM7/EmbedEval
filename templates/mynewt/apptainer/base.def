Bootstrap: docker
From: ubuntu:24.04

# Shared layer of every Mynewt Apptainer instance: newt, Go-built from the same
# commit as docker/bases/mynewt.Dockerfile (/usr/local/bin/newt, for modern
# cores), plus the older newt releases that trees of 2016-2019 need
# (/opt/newt/<version>/newt; scripts/render_mynewt_instance.py picks one from
# the base commit's era), and what a native-BSP `newt test` needs (gcc, make,
# and on x86_64 the 32-bit libraries, for kernels before 2024-04-09 whose
# compiler/sim forces -m32).
#
#   apptainer build --fakeroot mynewt-sim.sif mynewt-sim.def

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    APT="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"
    retry() {
        for i in 1 2 3 4 5 6; do
            timeout 300 "$@" && return 0
            echo "attempt $i failed: $*"; sleep 3
        done
        return 1
    }
    retry apt-get $APT update -qq
    PKGS="ca-certificates git golang-go gcc g++ make file python3"
    if [ "$(uname -m)" = x86_64 ]; then PKGS="$PKGS gcc-multilib g++-multilib"; fi
    retry apt-get $APT install -y -qq --no-install-recommends $PKGS > /dev/null
    rm -rf /var/lib/apt/lists/*
    # Where a build binds a local mynewt-core clone: a bind needs its destination.
    mkdir -p /embedeval-src/mynewt-core.git
    retry git clone -q https://github.com/apache/mynewt-newt.git /opt/newt-src
    cd /opt/newt-src
    git checkout -q c36db0f3df0a2787dfa19914d79a687d6a6cb53a
    retry go build -o /usr/local/bin/newt ./newt
    newt version

    # Older newt releases, built from their tags with Go 1.22 outside modules
    # (their dependencies are vendored in the tree). Each tag either has the
    # build.sh of that era, or is built directly from a temporary GOPATH.
    build_old_newt() {
        ver=$1; tag=$2
        src=/opt/newt-src-$ver
        git clone -q /opt/newt-src $src
        git -C $src checkout -q $tag
        export GO111MODULE=off CGO_ENABLED=0
        out=
        if (cd $src && sh ./build.sh > /tmp/newt-$ver.log 2>&1) && [ -x $src/newt/newt ]; then
            out=$src/newt/newt
        else
            gp=/tmp/gopath-$ver
            mkdir -p $gp/src/mynewt.apache.org
            ln -s $src $gp/src/mynewt.apache.org/newt
            (cd $gp/src/mynewt.apache.org/newt && GOPATH=$gp go build -o $src/newt-bin ./newt) \
                >> /tmp/newt-$ver.log 2>&1 && out=$src/newt-bin
        fi
        if [ -z "$out" ]; then tail -20 /tmp/newt-$ver.log; return 1; fi
        mkdir -p /opt/newt/$ver
        cp $out /opt/newt/$ver/newt
        unset GO111MODULE CGO_ENABLED
        /opt/newt/$ver/newt version || true
    }
    build_old_newt 1.0.0-b1 mynewt_1_0_0_b1_tag
    build_old_newt 1.0.0-b2 mynewt_1_0_0_b2_tag
    build_old_newt 1.0.0 mynewt_1_0_0_tag
    build_old_newt 1.2.0 mynewt_1_2_0_tag
    build_old_newt 1.4.0 mynewt_1_4_0_tag
    build_old_newt 1.6.0 mynewt_1_6_0_tag
    mkdir -p /opt/newt/modern && cp /usr/local/bin/newt /opt/newt/modern/newt

    # Core 1.15 requires Newt 1.15, including native selftest link tables.
    # Keep the older modern binary for existing core eras.
    git clone -q /opt/newt-src /opt/newt-src-1.15.0
    git -C /opt/newt-src-1.15.0 checkout -q ae817d0ccbfbae1e1e020d086a6d3c50a8687206
    mkdir -p /opt/newt/1.15.0
    (cd /opt/newt-src-1.15.0 && export GOTOOLCHAIN=auto && retry go build -o /opt/newt/1.15.0/newt ./newt)
    /opt/newt/1.15.0/newt version

    # Only the binaries stay. The newt sources hold a later mynewt-core
    # snapshot (.github/newt_dump/proj/repos/apache-mynewt-core: pkg.yml and
    # syscfg.yml files of ~2020) that an agent must not find.
    go clean -modcache 2>/dev/null || true       # Go leaves its module cache read-only
    chmod -R u+w /opt/newt-src* /tmp/gopath-* /root/go 2>/dev/null || true
    rm -rf /opt/newt-src* /tmp/gopath-* /tmp/newt-*.log /root/go /root/.cache/go-build

%environment
    export LANG=C.UTF-8

%labels
    embedeval.layer mynewt-sim

Backport of the ARM64 g_reg_offs table from apache/nuttx 749655d785
("tcbinfo:remove total_num form tcbinfo.", 2023-11-17), for kernels from
eadfdab9a7 (2023-07-17) up to it. Their sim_tcbinfo.c has tables for x86
hosts only, so sim:nsh does not build on an ARM64 host:
"'g_reg_offs' undeclared". The 31 UINT16_MAX rows before SP and PC follow
the upstream table. Applied by templates/nuttx/apptainer/instance.def.tmpl.

diff --git a/arch/sim/src/sim/sim_tcbinfo.c b/arch/sim/src/sim/sim_tcbinfo.c
--- a/arch/sim/src/sim/sim_tcbinfo.c
+++ b/arch/sim/src/sim/sim_tcbinfo.c
@@ -78,6 +78,45 @@ static const uint16_t g_reg_offs[] =
   UINT16_MAX,            /* ES */
   UINT16_MAX,            /* FS */
 };
+#elif defined(CONFIG_HOST_ARM64)
+static const uint16_t g_reg_offs[] =
+{
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  UINT16_MAX,
+  TCB_REG_OFF(JB_SP),
+  TCB_REG_OFF(JB_PC),
+  UINT16_MAX,
+  UINT16_MAX,
+};
 #endif
 

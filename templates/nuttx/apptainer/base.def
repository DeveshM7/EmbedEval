Bootstrap: docker
From: ubuntu:24.04

# Shared layer of every NuttX Apptainer instance: what sim:nsh needs to build
# and run, on the build host's own architecture (x86_64 or ARM64).
#
#   apptainer build --fakeroot nuttx-sim.sif base.def
#
# docker/bases/nuttx.Dockerfile's core build tools and Python modules, without
# gcc-multilib, the cross toolchains, QEMU, CMake and SDL that sim:nsh does
# not use. Ubuntu 24.04, not the Docker base's 22.04: rootless --fakeroot
# builds on Scholar inject the host's fakeroot library, which needs glibc >=
# 2.38 (as for templates/zephyr/apptainer/python.def).
#
# Also holds the compatibility patches instance.def applies to kernels that
# need them (/opt/embedeval/compat/).

%files
    sim_tcbinfo_arm64.patch /opt/embedeval/compat/sim_tcbinfo_arm64.patch

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    # ports.ubuntu.com resolves to several addresses and some never answer
    # from Scholar; apt then waits forever despite its own timeouts. A hard
    # timeout and a retry gets another address.
    APT="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"
    retry() {
        for i in 1 2 3 4 5 6; do
            timeout 120 "$@" && return 0
            echo "attempt $i failed: $*"; sleep 3
        done
        return 1
    }
    retry apt-get $APT update -qq
    retry apt-get $APT install -y -qq --no-install-recommends \
        build-essential gcc g++ make git python3 python3-pip python3-dev \
        libncurses-dev bison flex xxd wget curl ca-certificates \
        kconfig-frontends genromfs universal-ctags > /dev/null
    pip3 install --break-system-packages -q pyelftools cxxfilt kconfiglib
    command -v kconfig-tweak
    rm -rf /var/lib/apt/lists/*
    # Where scripts/build_instances.py binds local kernel and apps clones for
    # an instance build: a bind needs its destination to exist already.
    mkdir -p /embedeval-src/nuttx.git /embedeval-src/nuttx-apps.git

%environment
    export LANG=C.UTF-8

%labels
    embedeval.layer nuttx-sim

+/* Preemption state tracking */
+static uint8_t ble_gap_preempted;
+static struct ble_gap_master_state ble_gap_master_preempted;
+static struct {
+    uint8_t op;
+    uint8_t conn_mode;
+    uint8_t disc_mode;

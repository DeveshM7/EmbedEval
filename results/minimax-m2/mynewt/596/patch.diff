 struct ble_gap_update_entry {
     SLIST_ENTRY(ble_gap_update_entry) next;
     struct ble_gap_upd_params params;
@@ -4234,6 +4247,96 @@ ble_gap_mtu_event(uint16_t conn_handle, uint16_t cid, uint16_t mtu)
  * $init                                                                     *
  *****************************************************************************/
 
+/**
+ * Initiates preemption of GAP procedures to allow controller operations
+ * that cannot be performed concurrently with GAP procedures.
+ * 
+ * Returns 1 if preemption was initiated, 0 if no preemption needed.
+ */
+int
+ble_gap_preempt_start(void)
+{
+    /* Check if already preempted */
+    if (ble_gap_preempted) {
+        return 0;
+    }
+
+    /* Stop active procedures */
+    if (ble_gap_master.op != BLE_GAP_OP_NULL) {
+        /* Save state for master procedures */
+        ble_gap_master_preempted = ble_gap_master;
+        ble_gap_master.op = BLE_GAP_OP_NULL;
+    }
+
+    if (ble_gap_slave.op != BLE_GAP_OP_NULL) {
+        /* Save state for slave procedures (advertising) */
+        ble_gap_slave_preempted.op = ble_gap_slave.op;
+        ble_gap_slave_preempted.conn_mode = ble_gap_slave.conn_mode;
+        ble_gap_slave_preempted.disc_mode = ble_gap_slave.disc_mode;
+        ble_gap_slave_preempted.our_addr_type = ble_gap_slave.our_addr_type;
+        ble_gap_slave_preempted.cb = ble_gap_slave.cb;
+        ble_gap_slave_preempted.cb_arg = ble_gap_slave.cb_arg;
+        ble_gap_slave.op = BLE_GAP_OP_NULL;
+        ble_gap_slave.conn_mode = BLE_GAP_CONN_MODE_NON;
+        ble_gap_slave.disc_mode = BLE_GAP_DISC_MODE_NON;
+    }
+
+    ble_gap_preempted = 1;
+    return 1;
+}
+
+/**
+ * Ends preemption and reports interrupted procedures.
+ */
+void
+ble_gap_preempt_stop(void)
+{
+    if (!ble_gap_preempted) {
+        return;
+    }
+
+    /* Report interrupted procedures */
+    if (ble_gap_master_preempted.op != BLE_GAP_OP_NULL) {
+        if (ble_gap_master_preempted.op == BLE_GAP_OP_M_DISC) {
+            /* Report discovery complete with PREEMPTED */
+            if (ble_gap_master_preempted.cb) {
+                struct ble_gap_event event;
+                memset(&event, 0, sizeof(event));
+                event.type = BLE_GAP_EVENT_DISC_COMPLETE;
+                event.disc_complete.reason = BLE_HS_EPREEMPTED;
+                ble_gap_master_preempted.cb(&event, ble_gap_master_preempted.cb_arg);
+            }
+        } else if (ble_gap_master_preempted.op == BLE_GAP_OP_M_CONN) {
+            /* Report connect failed with PREEMPTED */
+            if (ble_gap_master_preempted.cb) {
+                struct ble_gap_event event;
+                memset(&event, 0, sizeof(event));
+                event.type = BLE_GAP_EVENT_CONNECT;
+                event.connect.status = BLE_HS_EPREEMPTED;
+                event.connect.conn_handle = BLE_HS_CONN_HANDLE_NONE;
+                ble_gap_master_preempted.cb(&event, ble_gap_master_preempted.cb_arg);
+            }
+        }
+        memset(&ble_gap_master_preempted, 0, sizeof(ble_gap_master_preempted));
+    }
+
+    if (ble_gap_slave_preempted.op != BLE_GAP_OP_NULL) {
+        /* Report advertising complete with PREEMPTED */
+        if (ble_gap_slave_preempted.cb) {
+            struct ble_gap_event event;
+            memset(&event, 0, sizeof(event));
+            event.type = BLE_GAP_EVENT_ADV_COMPLETE;
+            event.adv_complete.reason = BLE_HS_EPREEMPTED;
+            ble_gap_slave_preempted.cb(&event, ble_gap_slave_preempted.cb_arg);
+        }
+        memset(&ble_gap_slave_preempted, 0, sizeof(ble_gap_slave_preempted));
+    }
+
+    ble_gap_preempted = 0;
+}
+
+
+
 int
 ble_gap_init(void)
 {

diff --git a/test_append_cb.c b/test_append_cb.c
new file mode 100644
index 0000000..854b2af
--- /dev/null
+++ b/test_append_cb.c
@@ -0,0 +1,66 @@
+#include <stdio.h>
+#include <string.h>
+#include "sys/log/full/include/log/log.h"
+#include "cbmem/cbmem.h"
+
+static int callback_count = 0;
+static struct log *callback_log_ptr = NULL;
+static uint32_t callback_idx = 0;
+
+static void test_callback(struct log *log, uint32_t idx) {
+    callback_count++;
+    callback_log_ptr = log;
+    callback_idx = idx;
+    printf("Callback called: log=%p, idx=%u\n", (void*)log, idx);
+}
+
+int main() {
+    struct cbmem cbmem;
+    struct log log;
+    uint8_t buf[256];
+    char *str = "test";
+    int body_len;
+    
+    log_init();
+    cbmem_init(&cbmem, CBMEM_SIZE_MIN);
+    log_register("test_log", &log, &log_cbmem_handler, &cbmem, LOG_LEVEL_DEBUG);
+    
+    printf("Test 1: No callback registered\n");
+    body_len = strlen(str);
+    memcpy(buf + LOG_ENTRY_HDR_SIZE, str, body_len);
+    log_append_typed(&log, 0, 0, LOG_ETYPE_STRING, buf, body_len);
+    printf("Callback count: %d (expected 0)\n", callback_count);
+    
+    printf("\nTest 2: Register callback and append\n");
+    callback_count = 0;
+    callback_log_ptr = NULL;
+    callback_idx = 0xFFFFFFFF;
+    
+    log_set_append_cb(&log, test_callback);
+    
+    body_len = strlen(str);
+    memcpy(buf + LOG_ENTRY_HDR_SIZE, str, body_len);
+    log_append_typed(&log, 0, 0, LOG_ETYPE_STRING, buf, body_len);
+    printf("Callback count: %d (expected 1)\n", callback_count);
+    printf("Callback log: %p (expected %p)\n", (void*)callback_log_ptr, (void*)&log);
+    printf("Callback idx: %u (expected 1)\n", callback_idx);
+    
+    printf("\nTest 3: Append again\n");
+    body_len = strlen(str);
+    memcpy(buf + LOG_ENTRY_HDR_SIZE, str, body_len);
+    log_append_typed(&log, 0, 0, LOG_ETYPE_STRING, buf, body_len);
+    printf("Callback count: %d (expected 1)\n", callback_count);
+    printf("Callback idx: %u (expected 2)\n", callback_idx);
+    
+    printf("\nTest 4: Clear callback\n");
+    log_set_append_cb(&log, NULL);
+    
+    callback_count = 0;
+    callback_idx = 0xFFFFFFFF;
+    body_len = strlen(str);
+    memcpy(buf + LOG_ENTRY_HDR_SIZE, str, body_len);
+    log_append_typed(&log, 0, 0, LOG_ETYPE_STRING, buf, body_len);
+    printf("Callback count: %d (expected 0)\n", callback_count);
+    
+    return 0;
+}

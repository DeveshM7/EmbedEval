diff --git a/net/ip/native_sockets/src/native_sock.c b/net/ip/native_sockets/src/native_sock.c
index 17c391d..5536093 100644
--- a/net/ip/native_sockets/src/native_sock.c
+++ b/net/ip/native_sockets/src/native_sock.c
@@ -212,8 +212,8 @@ native_sock_mn_addr_to_addr(struct mn_sockaddr *ms, struct sockaddr *sa,
 #ifndef MN_LINUX
         sun->sun_len = sizeof(*sun);
 #endif
-        sun->sun_path[0] = '\0';
-        strncat(sun->sun_path, msun->msun_path, sizeof sun->sun_path);
+        strncpy(sun->sun_path, msun->msun_path, sizeof(sun->sun_path) - 1);
+        sun->sun_path[sizeof(sun->sun_path) - 1] = '\0';
         if (strcmp(sun->sun_path, msun->msun_path) != 0) {
             /* Path too long. */
             return MN_EINVAL;
@@ -368,13 +368,31 @@ native_sock_connect(struct mn_socket *s, struct mn_sockaddr *addr)
     os_mutex_pend(&nss->mtx, OS_WAIT_FOREVER);
     if (connect(ns->ns_fd, sa, sa_len)) {
         rc = errno;
-        os_mutex_release(&nss->mtx);
-        return native_sock_err_to_mn_err(rc);
+        /* 
+         * For non-blocking sockets, EINPROGRESS means the connection
+         * is pending. This is not an error - the completion will be
+         * reported via the writable callback when the connection succeeds
+         * or fails.
+         */
+        if (rc != EINPROGRESS) {
+            os_mutex_release(&nss->mtx);
+            return native_sock_err_to_mn_err(rc);
+        }
+        /* 
+         * Connection is in progress - will complete asynchronously.
+         * The POLLOUT handler will check SO_ERROR and call the writable
+         * callback when the connection completes.
+         */
+    } else {
+        /* 
+         * Connection succeeded immediately (rare for non-blocking sockets,
+         * but can happen on localhost). Call the writable callback now.
+         */
+        mn_socket_writable(s, 0);
     }
     ns->ns_poll = 1;
     native_sock_poll_rebuild(nss);
     os_mutex_release(&nss->mtx);
-    mn_socket_writable(s, 0);
     return 0;
 }
 
@@ -796,6 +814,26 @@ socket_task(void *arg)
             }
 
             if (revents & POLLOUT) {
+                int error = 0;
+                socklen_t errlen = sizeof(error);
+                
+                /* 
+                 * Check the socket error to see if a pending connection
+                 * succeeded or failed.
+                 */
+                if (getsockopt(ns->ns_fd, SOL_SOCKET, SO_ERROR, &error, &errlen) == 0) {
+                    if (error != 0) {
+                        /* Connection failed */
+                        mn_socket_writable(&ns->ns_sock, native_sock_err_to_mn_err(error));
+                    } else {
+                        /* Connection succeeded */
+                        mn_socket_writable(&ns->ns_sock, 0);
+                    }
+                }
+                
+                /* 
+                 * If there's data to send, send it.
+                 */
                 if (ns->ns_type == SOCK_STREAM && ns->ns_tx) {
                     native_sock_stream_tx(ns, 1);
                 }

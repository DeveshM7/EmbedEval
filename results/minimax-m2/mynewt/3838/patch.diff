diff --git a/libc/baselibc/src/strndup.c b/libc/baselibc/src/strndup.c
index 427162f..aa0d98e 100644
--- a/libc/baselibc/src/strndup.c
+++ b/libc/baselibc/src/strndup.c
@@ -7,13 +7,15 @@
 
 char *strndup(const char *s, size_t n)
 {
-	int l = n > strlen(s) ? strlen(s) + 1 : n + 1;
-	char *d = malloc(l);
-
+	size_t actual_len = strlen(s);
+	if (actual_len > n) {
+		actual_len = n;
+	}
+	char *d = malloc(actual_len + 1);
 	if (!d)
 		return NULL;
 	
-	memcpy(d, s, l);

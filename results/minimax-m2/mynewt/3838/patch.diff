+	memcpy(d, s, actual_len);
+	d[actual_len] = '\0';
 	return d;
 }
diff --git a/libc/baselibc/src/strstr.c b/libc/baselibc/src/strstr.c
index 0af23bb..4a9fbe8 100644
--- a/libc/baselibc/src/strstr.c
+++ b/libc/baselibc/src/strstr.c
@@ -12,5 +12,12 @@ char *strstr(const char *haystack, const char *needle)
 
 char *strnstr(const char *haystack, const char *needle, size_t len)
 {
-	return (char *)memmem(haystack, strlen(haystack), needle, len);
+	size_t needle_len = strlen(needle);
+	if (needle_len == 0) {
+		return (char *)haystack;
+	}
+	if (len < needle_len) {
+		return NULL;
+	}
+	return (char *)memmem(haystack, len, needle, needle_len);
 }

+int
+ble_gatts_reset(void)
+{
+    /* Check if busy with active connections or GAP procedures. */
+    if (ble_gap_conn_active() || ble_gap_adv_active() || ble_gap_disc_active()) {
+        return BLE_HS_EBUSY;
+    }
+
+    /* Clear all ATT server entries (services, characteristics, descriptors). */
+    ble_att_svr_clear();
+
+    /* Reset GATT server state. */
+    ble_gatts_free_mem();
+    ble_gatts_free_svc_defs();
+
+    /* Reset service entry tracking. */
+    ble_gatts_num_svc_entries = 0;
+
+    /* Reset configurable characteristics tracking. */
+    ble_gatts_num_cfgable_chrs = 0;
+    ble_gatts_clt_cfgs = NULL;
+
+    return 0;
+}

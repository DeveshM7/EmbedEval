+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "os/mynewt.h"
+
+#if MYNEWT_VAL(LOG_FCB2_BOOKMARKS)
+
+#include "fcb2/fcb.h"
+#include "fcb_priv.h"
+#include "string.h"
+
+void
+fcb_log_init_bmarks(struct fcb_log *fcb_log,
+                    struct fcb_log_bmark *buf, int bmark_count)
+{
+    fcb_log->fl_bset = (struct fcb_log_bset) {
+        .fls_bmarks = buf,
+        .fls_cap = bmark_count,
+    };
+}
+
+void
+fcb_log_clear_bmarks(struct fcb_log *fcb_log)
+{
+    fcb_log->fl_bset.fls_size = 0;
+    fcb_log->fl_bset.fls_next = 0;
+}
+
+const struct fcb_log_bmark *
+fcb_log_closest_bmark(const struct fcb_log *fcb_log, uint32_t index)
+{
+    const struct fcb_log_bmark *closest;
+    const struct fcb_log_bmark *bmark;
+    uint32_t min_diff;
+    uint32_t diff;
+    int i;
+
+    min_diff = UINT32_MAX;
+    closest = NULL;
+
+    for (i = 0; i < fcb_log->fl_bset.fls_size; i++) {
+        bmark = &fcb_log->fl_bset.fls_bmarks[i];
+        if (bmark->flb_index <= index) {
+            diff = index - bmark->flb_index;
+            if (diff < min_diff) {
+                min_diff = diff;
+                closest = bmark;
+            }
+        }
+    }
+
+    return closest;
+}
+
+void
+fcb_log_add_bmark(struct fcb_log *fcb_log, const struct fcb_entry *entry,
+                  uint32_t index)
+{
+    struct fcb_log_bset *bset;
+
+    bset = &fcb_log->fl_bset;
+
+    if (bset->fls_cap == 0) {
+        return;
+    }
+
+    bset->fls_bmarks[bset->fls_next] = (struct fcb_log_bmark) {
+        .flb_entry = *entry,
+        .flb_index = index,
+    };
+
+    if (bset->fls_size < bset->fls_cap) {
+        bset->fls_size++;
+    }
+
+    bset->fls_next++;
+    if (bset->fls_next >= bset->fls_cap) {
+        bset->fls_next = 0;
+    }
+}
+
+#endif /* MYNEWT_VAL(LOG_FCB2_BOOKMARKS) */
diff --git a/fs/fcb2/src/fcb_getprev.c b/fs/fcb2/src/fcb_getprev.c
new file mode 100644
index 0000000..3e767f5
--- /dev/null
+++ b/fs/fcb2/src/fcb_getprev.c
@@ -0,0 +1,137 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <stddef.h>
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+static int
+fcb_getprev_in_area(struct fcb *fcb, struct fcb_entry *loc)
+{
+    int rc = FCB_ERR_CRC;
+    int off;
+    int len;
+
+    if (loc->fe_entry_num == 1) {
+        /* We're at the first entry in the sector */
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Move to previous entry in the same area */
+    loc->fe_entry_num--;
+    len = loc->fe_data_len;
+    off = loc->fe_data_off;
+    loc->fe_data_len = 0;
+    
+    /* Calculate previous entry's offset */
+    loc->fe_data_off = off - fcb_len_in_flash(loc->fe_range, len) -
+                       fcb_len_in_flash(loc->fe_range, 2);
+    
+    /* Validate the entry */
+    rc = fcb_elem_info(loc);
+    
+    return rc;
+}
+
+int
+fcb_getprev_nolock(struct fcb *fcb, struct fcb_entry *loc)
+{
+    int rc;
+
+    if (loc->fe_range == NULL) {
+        /* No entry specified, return most recent entry */
+        *loc = fcb->f_active;
+        return 0;
+    }
+
+    /* Try to get previous entry in the same area */
+    rc = fcb_getprev_in_area(fcb, loc);
+    if (rc == 0) {
+        return 0;
+    }
+
+    /* Move to previous sector */
+    if (loc->fe_sector == fcb->f_oldest_sec) {
+        /* We're at the oldest sector, no more entries */
+        return FCB_ERR_NOVAR;
+    }
+
+    loc->fe_sector = fcb_getprev_sector(fcb, loc->fe_sector);
+    loc->fe_range = fcb_get_sector_range(fcb, loc->fe_sector);
+    
+    /* Find the last entry in this sector */
+    loc->fe_entry_num = 0;
+    loc->fe_data_off = 0;
+    loc->fe_data_len = 0;
+    
+    /* Walk to the last entry in this sector */
+    while (rc != FCB_ERR_NOVAR) {
+        rc = fcb_getnext_in_area(fcb, loc);
+        if (rc == 0) {
+            /* We found a valid entry */
+            return 0;
+        }
+    }
+    
+    /* No valid entries in this sector */
+    if (loc->fe_sector == fcb->f_oldest_sec) {
+        return FCB_ERR_NOVAR;
+    }
+    
+    /* Try previous sector */
+    loc->fe_sector = fcb_getprev_sector(fcb, loc->fe_sector);
+    loc->fe_range = fcb_get_sector_range(fcb, loc->fe_sector);
+    loc->fe_entry_num = 0;
+    loc->fe_data_off = 0;
+    loc->fe_data_len = 0;
+    
+    while (loc->fe_sector != fcb->f_oldest_sec) {
+        loc->fe_entry_num = 0;
+        loc->fe_data_off = 0;
+        loc->fe_data_len = 0;
+        
+        rc = fcb_getnext_in_area(fcb, loc);
+        if (rc == 0) {
+            return 0;
+        }
+        
+        if (loc->fe_sector == fcb->f_oldest_sec) {
+            break;
+        }
+        loc->fe_sector = fcb_getprev_sector(fcb, loc->fe_sector);
+        loc->fe_range = fcb_get_sector_range(fcb, loc->fe_sector);
+    }
+    
+    return FCB_ERR_NOVAR;
+}
+
+int
+fcb_getprev(struct fcb *fcb, struct fcb_entry *loc)
+{
+    int rc;
+
+    rc = os_mutex_pend(&fcb->f_mtx, OS_WAIT_FOREVER);
+    if (rc && rc != OS_NOT_STARTED) {
+        return FCB_ERR_ARGS;
+    }
+    rc = fcb_getprev_nolock(fcb, loc);
+    os_mutex_release(&fcb->f_mtx);
+
+    return rc;
+}
diff --git a/fs/fcb2/src/fcb_priv.h b/fs/fcb2/src/fcb_priv.h
index 63f18e3..c22a09f 100644
--- a/fs/fcb2/src/fcb_priv.h

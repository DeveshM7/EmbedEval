+    int rc;
+
+    loc = (struct fcb2_entry *)dptr;
+
+    /* If offset is at or beyond data length, return 0 */
+    if (off >= loc->fe_data_len) {
+        return 0;
+    }
+
+    /* Only read the maximum number of bytes, if we exceed that,
+     * truncate the read.
+     */
+    if (off + len > loc->fe_data_len) {
+        len = loc->fe_data_len - off;
+    }
+
+    rem_len = len;
+
+    while (rem_len > 0) {
+        read_len = min(rem_len, sizeof(data));
+        rc = fcb2_read(loc, off, data, read_len);
+        if (rc) {
+            goto done;
+        }
+
+        rc = os_mbuf_append(om, data, read_len);
+        if (rc) {
+            goto done;
+        }
+
+        rem_len -= read_len;
+        off += read_len;
+    }
+
+done:
+    return len - rem_len;
+}

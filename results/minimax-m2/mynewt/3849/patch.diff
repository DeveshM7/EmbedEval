diff --git a/fix_fcb.py b/fix_fcb.py
new file mode 100644
index 0000000..253eb7c
--- /dev/null
+++ b/fix_fcb.py
@@ -0,0 +1,146 @@
+import re
+
+with open('/testbed/sys/log/full/src/log_fcb.c.bak', 'r') as f:
+    content = f.read()
+
+# Fix log_fcb_read function
+old_func = '''static int
+log_fcb_read(struct log *log, const void *dptr, void *buf, uint16_t offset,
+  uint16_t len)
+{
+    struct fcb_entry *loc;
+    int rc;
+
+    loc = (struct fcb_entry *)dptr;
+
+    if (offset + len > loc->fe_data_len) {
+        len = loc->fe_data_len - offset;
+    }
+    rc = flash_area_read(loc->fe_area, loc->fe_data_off + offset, buf, len);
+    if (rc == 0) {
+        return len;
+    } else {
+        return 0;
+    }
+}'''
+
+new_func = '''static int
+log_fcb_read(struct log *log, const void *dptr, void *buf, uint16_t offset,
+             uint16_t len)
+{
+    struct fcb_entry *loc;
+    int rc;
+
+    loc = (struct fcb_entry *)dptr;
+
+    /* If offset is at or beyond data length, return 0 */
+    if (offset >= loc->fe_data_len) {
+        return 0;
+    }
+
+    /* Only read the maximum number of bytes, if we exceed that,
+     * truncate the read.
+     */
+    if (offset + len > loc->fe_data_len) {
+        len = loc->fe_data_len - offset;
+    }
+
+    rc = flash_area_read(loc->fe_area, loc->fe_data_off + offset, buf, len);
+    if (rc == 0) {
+        return len;
+    } else {
+        return 0;
+    }
+}'''
+
+content = content.replace(old_func, new_func)
+
+# Fix log_fcb_read_mbuf function
+old_func = '''static int
+log_fcb_read_mbuf(struct log *log, const void *dptr, struct os_mbuf *om,
+                  uint16_t offset, uint16_t len)
+{
+    struct fcb_entry *loc;
+    uint8_t data[128];
+    uint16_t read_len;
+    uint16_t rem_len;
+    int rc;
+
+    loc = (struct fcb_entry *)dptr;
+
+    if (offset + len > loc->fe_data_len) {
+        len = loc->fe_data_len - offset;
+    }
+
+    rem_len = len;
+
+    while (rem_len > 0) {
+        read_len = min(rem_len, sizeof(data));
+        rc = flash_area_read(loc->fe_area, loc->fe_data_off + offset, data,
+                             read_len);
+        if (rc) {
+            goto done;
+        }
+        rc = os_mbuf_append(om, data, read_len);
+        if (rc) {
+            goto done;
+        }
+
+        rem_len -= read_len;
+        offset += read_len;
+    }
+
+done:
+    return len - rem_len;
+}'''
+
+new_func = '''static int
+log_fcb_read_mbuf(struct log *log, const void *dptr, struct os_mbuf *om,
+                  uint16_t offset, uint16_t len)
+{
+    struct fcb_entry *loc;
+    uint8_t data[128];
+    uint16_t read_len;
+    uint16_t rem_len;
+    int rc;
+
+    loc = (struct fcb_entry *)dptr;
+
+    /* If offset is at or beyond data length, return 0 */
+    if (offset >= loc->fe_data_len) {
+        return 0;
+    }
+
+    /* Only read the maximum number of bytes, if we exceed that,
+     * truncate the read.
+     */
+    if (offset + len > loc->fe_data_len) {
+        len = loc->fe_data_len - offset;
+    }
+
+    rem_len = len;
+
+    while (rem_len > 0) {
+        read_len = min(rem_len, sizeof(data));
+        rc = flash_area_read(loc->fe_area, loc->fe_data_off + offset, data,
+                             read_len);
+        if (rc) {
+            goto done;
+        }
+        rc = os_mbuf_append(om, data, read_len);
+        if (rc) {
+            goto done;
+        }
+
+        rem_len -= read_len;
+        offset += read_len;
+    }
+
+done:
+    return len - rem_len;
+}'''
+
+content = content.replace(old_func, new_func)
+
+with open('/testbed/sys/log/full/src/log_fcb.c', 'w') as f:
+    f.write(content)

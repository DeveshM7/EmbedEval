+++ b/fix_log_fcb_read.c
@@ -0,0 +1,28 @@
+static int
+log_fcb_read(struct log *log, const void *dptr, void *buf, uint16_t offset,
+             uint16_t len)
+{
+    struct fcb_entry *loc;
+    int rc;
+
+    loc = (struct fcb_entry *)dptr;
+
+    /* If offset is at or beyond data length, return 0 */
+    if (offset >= loc->fe_data_len) {
+        return 0;
+    }
+
+    /* Only read the maximum number of bytes, if we exceed that,
+     * truncate the read.
+     */
+    if (offset + len > loc->fe_data_len) {
+        len = loc->fe_data_len - offset;
+    }
+
+    rc = flash_area_read(loc->fe_area, loc->fe_data_off + offset, buf, len);
+    if (rc == 0) {
+        return len;
+    } else {
+        return 0;
+    }
+}

diff --git a/simple_test.c b/simple_test.c
new file mode 100644
index 0000000..a6d739f
--- /dev/null
+++ b/simple_test.c
@@ -0,0 +1,39 @@
+#include <stdio.h>
+#include <string.h>
+#include "cbmem/cbmem.h"
+#include "log/log.h"
+
+int main() {
+    uint8_t cbmem_buf[2048];
+    struct cbmem cbmem;
+    struct log log;
+    const char *test_str = "test";
+    int len = strlen(test_str);
+    int rc;
+    
+    /* Initialize cbmem */
+    rc = cbmem_init(&cbmem, cbmem_buf, sizeof(cbmem_buf));
+    if (rc != 0) {
+        printf("cbmem_init failed\n");
+        return 1;
+    }
+    
+    /* Append a log entry */
+    log_append_body(&log, 0, 0, LOG_ETYPE_STRING, test_str, len);
+    
+    /* Get the first entry */
+    void *dptr = cbmem_get_first(&cbmem);
+    if (!dptr) {
+        printf("cbmem_get_first failed\n");
+        return 1;
+    }
+    
+    /* Read at exact body length */
+    uint8_t buf[64];
+    memset(buf, 0xBB, sizeof(buf));
+    rc = log_read_body(&log, dptr, buf, len, sizeof(buf));
+    printf("log_read_body returned %d\n", rc);
+    printf("buffer unchanged: %d\n", memcmp(buf, "\xBB\xBB\xBB\xBB", 4) == 0);
+    
+    return 0;
+}

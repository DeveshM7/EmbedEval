+/**
+ * Register a simple error callback function for a sensor.
+ *
+ * @param sensor The sensor object
+ * @param err_fn The error callback function
+ * @param arg The argument to pass to the error callback
+ *
+ * @return 0 on success, non-zero error code on failure.
+ */
+int
+sensor_register_err_func(struct sensor *sensor,
+        void (*err_fn)(struct sensor *, void *, int),
+        void *arg)
+{
+    int rc;
+
+    rc = sensor_lock(sensor);
+    if (rc != 0) {
+        goto err;
+    }
+
+    sensor->s_err_func = err_fn;
+    sensor->s_err_arg = arg;
+
+    sensor_unlock(sensor);
+
+    return (0);
+err:
+    return (rc);
+}
+

+
+/**
+ * Clears all entries from the store for all object types (our security state,
+ * peer security state, and CCCD entries).
+ *
+ * @return 0 on success; nonzero on failure.
+ */
+int
+ble_store_clear(void)
+{
+    union ble_store_key key;
+    int rc;
+
+    /* Clear all OUR_SEC entries */
+    memset(&key, 0, sizeof(key));
+    key.sec.peer_addr = *BLE_ADDR_ANY;
+    key.sec.idx = 0;
+
+    do {
+        rc = ble_store_delete(BLE_STORE_OBJ_TYPE_OUR_SEC, &key);
+    } while (rc == 0);
+
+    if (rc != BLE_HS_ENOENT) {
+        return rc;
+    }
+
+    /* Clear all PEER_SEC entries */
+    memset(&key, 0, sizeof(key));
+    key.sec.peer_addr = *BLE_ADDR_ANY;
+    key.sec.idx = 0;
+
+    do {
+        rc = ble_store_delete(BLE_STORE_OBJ_TYPE_PEER_SEC, &key);
+    } while (rc == 0);
+
+    if (rc != BLE_HS_ENOENT) {
+        return rc;
+    }
+
+    /* Clear all CCCD entries */
+    memset(&key, 0, sizeof(key));
+    key.cccd.peer_addr = *BLE_ADDR_ANY;
+    key.cccd.idx = 0;
+
+    do {
+        rc = ble_store_delete(BLE_STORE_OBJ_TYPE_CCCD, &key);
+    } while (rc == 0);
+
+    if (rc != BLE_HS_ENOENT) {
+        return rc;
+    }
+
+    return 0;
+}

diff --git a/kernel/os/include/os/os_mempool.h b/kernel/os/include/os/os_mempool.h
index 2416ac9..898f353 100644
--- a/kernel/os/include/os/os_mempool.h
+++ b/kernel/os/include/os/os_mempool.h
@@ -172,6 +172,16 @@ typedef uint64_t os_membuf_t;
 os_error_t os_mempool_init(struct os_mempool *mp, uint16_t blocks,
                            uint32_t block_size, void *membuf, char *name);
 
+/**
+ * Clears a memory pool, resetting it to a fully-free state. This can be called
+ * multiple times on the same mempool (unlike os_mempool_init).
+ *
+ * @param mp Pointer to the memory pool
+ *
+ * @return os_error_t
+ */
+os_error_t os_mempool_clear(struct os_mempool *mp);
+
 /**
  * Initializes an extended memory pool.  Extended attributes (e.g., callbacks)
  * are not specified when this function is called; they are assigned manually
diff --git a/kernel/os/src/os_mempool.c b/kernel/os/src/os_mempool.c
index bc1cee8..7a67218 100644
--- a/kernel/os/src/os_mempool.c
+++ b/kernel/os/src/os_mempool.c
@@ -117,6 +117,59 @@ os_mempool_init(struct os_mempool *mp, uint16_t blocks, uint32_t block_size,
     return OS_OK;
 }
 
+os_error_t
+os_mempool_clear(struct os_mempool *mp)
+{
+    int true_block_size;
+    uint8_t *block_addr;
+    struct os_memblock *block_ptr;
+    int blocks;
+
+    /* Check for NULL pool */
+    if (mp == NULL) {
+        return OS_INVALID_PARM;
+    }
+
+    /* Check that block size is valid */
+    if (mp->mp_block_size <= 0) {
+        return OS_INVALID_PARM;
+    }
+
+    /* Check that the pool was initialized (has a valid memory buffer) */
+    if (mp->mp_membuf_addr == 0) {
+        return OS_INVALID_PARM;
+    }
+
+    true_block_size = OS_MEMPOOL_TRUE_BLOCK_SIZE(mp);
+    blocks = mp->mp_num_blocks;
+
+    /* Reset the free list head to the memory buffer */
+    SLIST_FIRST(mp) = (struct os_memblock *)mp->mp_membuf_addr;
+
+    /* Reset number of free blocks to all blocks */
+    mp->mp_num_free = blocks;
+    mp->mp_min_free = blocks;
+
+    /* Poison the memory buffer */
+    os_mempool_poison((void *)mp->mp_membuf_addr, true_block_size);
+
+    /* Chain the memory blocks to the free list */
+    block_addr = (uint8_t *)mp->mp_membuf_addr;
+    block_ptr = (struct os_memblock *)block_addr;
+    while (blocks > 1) {
+        block_addr += true_block_size;
+        os_mempool_poison(block_addr, true_block_size);
+        SLIST_NEXT(block_ptr, mb_next) = (struct os_memblock *)block_addr;
+        block_ptr = (struct os_memblock *)block_addr;
+        --blocks;
+    }
+
+    /* Last one in the list should be NULL */
+    SLIST_NEXT(block_ptr, mb_next) = NULL;
+
+    return OS_OK;
+}
+
 os_error_t
 os_mempool_ext_init(struct os_mempool_ext *mpe, uint16_t blocks,
                     uint32_t block_size, void *membuf, char *name)

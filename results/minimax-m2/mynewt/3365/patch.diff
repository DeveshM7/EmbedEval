diff --git a/sys/log/full/syscfg.yml b/sys/log/full/syscfg.yml
index dc35b6c..08000b2 100644
--- a/sys/log/full/syscfg.yml
+++ b/sys/log/full/syscfg.yml
@@ -79,6 +79,17 @@ syscfg.defs:
         restrictions:
             - (LOG_FCB || LOG_FCB2)
 
+
+    LOG_FCB_SECTOR_BOOKMARKS:
+        description: >
+            Enables sector bookmark support for FCB-backed log lookups.  Sector
+            bookmarks store one bookmark per sector, allowing for faster log
+            walks that start from various positions.  This option requires
+            LOG_FCB_BOOKMARKS to be enabled.
+        value: 0
+        restrictions:
+            - LOG_FCB_BOOKMARKS
+            - (LOG_FCB || LOG_FCB2)
     LOG_CONSOLE:
         description: 'Support logging to console.'
         value: 1

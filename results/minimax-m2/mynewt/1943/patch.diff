+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include <stddef.h>
+#include <stdlib.h>
+#include "boot/stub/boot_stub.h"
+
+int
+boot_current_slot(void)
+{
+    return 0;
+}
+
+int
+flash_area_id_from_image_slot(int slot)
+{
+    /* Return a dummy flash area ID */
+    return slot + 100;
+}
+
+struct flash_area {
+    int fa_id;
+    uint32_t fa_size;
+};
+
+int
+flash_area_open(int id, const void **fa)
+{
+    struct flash_area *area;
+
+    area = malloc(sizeof(*area));
+    if (!area) {
+        return -1;
+    }
+
+    area->fa_id = id;
+    area->fa_size = 128 * 1024; /* 128KB dummy size */
+
+    *fa = area;
+    return 0;
+}
+
+int
+flash_area_read_is_empty(const void *fa, uint32_t addr, void *dst, uint32_t len)
+{
+    /* Return 1 to indicate empty (all 0xFF) */
+    memset(dst, 0xFF, len);
+    return 1;
+}
+
+int
+flash_area_read(const void *fa, uint32_t addr, void *dst, uint32_t len)
+{
+    /* Return -1 to indicate error */
+    return -1;
+}
+
+void
+flash_area_close(const void *fa)
+{
+    free((void *)fa);
+}

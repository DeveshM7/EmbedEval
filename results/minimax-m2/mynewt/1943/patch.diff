 #include "log/log.h"
+
+uint16_t
+log_hdr_len(const struct log_entry_hdr *hdr)
+{
+#if MYNEWT_VAL(LOG_VERSION) == 3 && MYNEWT_VAL(LOG_FLAGS_IMAGE_HASH)

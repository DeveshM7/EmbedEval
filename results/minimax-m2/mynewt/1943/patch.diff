 /**
  * @brief Configures a callback that gets called whenever a valid image upload
diff --git a/mgmt/imgmgr/src/imgmgr.c b/mgmt/imgmgr/src/imgmgr.c
index 81c2205..7634f19 100644
--- a/mgmt/imgmgr/src/imgmgr.c
+++ b/mgmt/imgmgr/src/imgmgr.c
@@ -210,6 +210,21 @@ int
 imgr_read_info(int image_slot, struct image_version *ver, uint8_t *hash,
                uint32_t *flags)
 {
+
+    if (MYNEWT_VAL(IMGMGR_DUMMY_HDR)) {
+        /* Return dummy image info for native builds */
+        if (ver) {
+            memset(ver, 0, sizeof(*ver));
+        }
+        if (hash) {
+            memset(hash, 0xAB, IMGMGR_HASH_LEN);
+        }
+        if (flags) {
+            *flags = 0;
+        }
+        return 0;
+    }
+
     struct image_header *hdr;
     struct image_tlv *tlv;
     int rc = -1;
@@ -304,6 +319,25 @@ end:
 int
 imgr_my_version(struct image_version *ver)
 {
+
+int
+imgr_get_image_hash(uint8_t *hash)
+{
+    int rc;
+    uint8_t tmp_hash[IMGMGR_HASH_LEN];
+    
+    if (MYNEWT_VAL(IMGMGR_DUMMY_HDR)) {
+        /* Return dummy hash for native builds - only first 4 bytes */
+        memset(hash, 0xAB, 4);
+        return 0;
+    }
+    
+    rc = imgr_read_info(boot_current_slot, NULL, tmp_hash, NULL);
+    if (rc == 0) {
+        memcpy(hash, tmp_hash, 4);
+    }
+    return rc;
+}
     return imgr_read_info(boot_current_slot, ver, NULL, NULL);
 }
 

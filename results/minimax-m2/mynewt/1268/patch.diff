+#ifndef H_DEBOUNCE_H_
+#define H_DEBOUNCE_H_
+
+#include <stdint.h>
+#include "os/mynewt.h"
+
+/**
+ * @brief Debouncer state machine
+ *
+ * The debouncer implements a state machine with two states: low and high.
+ * It starts in the low state with a counter value of 0.
+ *
+ * - Transitions from low to high when counter >= thresh_high
+ * - Transitions from high to low when counter <= thresh_low
+ * - State remains unchanged when counter is between thresholds
+ * - Counter is always kept within [0, max] bounds
+ */
+struct debouncer {
+    uint16_t counter;       /**< Current counter value */
+    uint16_t thresh_low;    /**< Low threshold for state transitions */
+    uint16_t thresh_high;   /**< High threshold for state transitions */
+    uint16_t max;           /**< Maximum counter value */
+    uint8_t state;          /**< Current state: 0=low, 1=high */
+};
+
+/**
+ * @brief Initializes a debouncer
+ *
+ * Initializes the debouncer to the low state with a counter value of 0.
+ * Validates that thresh_low <= thresh_high <= max.
+ *
+ * @param debouncer       Pointer to debouncer structure
+ * @param thresh_low      Low threshold (0-65535)
+ * @param thresh_high     High threshold (0-65535)
+ * @param max             Maximum counter value (0-65535)
+ *
+ * @return 0 on success, SYS_EINVAL if parameters are invalid
+ */
+int debouncer_init(struct debouncer *debouncer, uint16_t thresh_low,
+                   uint16_t thresh_high, uint16_t max);
+
+/**
+ * @brief Adjusts the debouncer counter
+ *
+ * Adds delta to the counter, keeping it within [0, max] bounds.
+ * Updates the state according to threshold rules.
+ *
+ * @param debouncer       Pointer to debouncer structure
+ * @param delta           Amount to add to counter (can be negative)
+ *
+ * @return 0 on success
+ */
+int debouncer_adjust(struct debouncer *debouncer, int32_t delta);
+
+/**
+ * @brief Sets the debouncer counter
+ *
+ * Sets the counter to the specified value, keeping it within [0, max] bounds.
+ * Updates the state according to threshold rules.
+ *
+ * @param debouncer       Pointer to debouncer structure
+ * @param val             New counter value
+ */
+void debouncer_set(struct debouncer *debouncer, uint16_t val);
+
+/**
+ * @brief Gets the current debouncer state
+ *
+ * @param debouncer       Pointer to debouncer structure
+ *
+ * @return 1 for high state, 0 for low state
+ */
+int debouncer_state(const struct debouncer *debouncer);
+
+/**
+ * @brief Gets the current counter value
+ *
+ * @param debouncer       Pointer to debouncer structure
+ *
+ * @return Current counter value
+ */
+uint16_t debouncer_val(const struct debouncer *debouncer);
+
+#endif /* H_DEBOUNCE_H_ */

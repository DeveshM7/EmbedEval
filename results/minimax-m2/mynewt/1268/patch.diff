+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include <stdint.h>
+#include "debounce/debounce.h"
+#include "os/mynewt.h"
+
+/* State definitions */
+#define DEBOUNCER_STATE_LOW  0
+#define DEBOUNCER_STATE_HIGH 1
+
+int
+debouncer_init(struct debouncer *debouncer, uint16_t thresh_low,
+                uint16_t thresh_high, uint16_t max)
+{
+    /* Validate parameters: thresh_low <= thresh_high <= max */
+    if (thresh_low > thresh_high || thresh_high > max) {
+        return SYS_EINVAL;
+    }
+
+    debouncer->counter = 0;
+    debouncer->thresh_low = thresh_low;
+    debouncer->thresh_high = thresh_high;
+    debouncer->max = max;
+    debouncer->state = DEBOUNCER_STATE_LOW;
+
+    return 0;
+}
+
+int
+debouncer_adjust(struct debouncer *debouncer, int32_t delta)
+{
+    int32_t new_counter;
+    
+    /* Calculate new counter value */
+    new_counter = (int32_t)debouncer->counter + delta;
+    
+    /* Saturate within bounds [0, max] */
+    if (new_counter < 0) {
+        debouncer->counter = 0;
+    } else if (new_counter > debouncer->max) {
+        debouncer->counter = debouncer->max;
+    } else {
+        debouncer->counter = (uint16_t)new_counter;
+    }
+    
+    /* Update state based on thresholds */
+    if (debouncer->state == DEBOUNCER_STATE_LOW) {
+        /* In low state, transition to high when counter >= thresh_high */
+        if (debouncer->counter >= debouncer->thresh_high) {
+            debouncer->state = DEBOUNCER_STATE_HIGH;
+        }
+    } else {
+        /* In high state, transition to low when counter <= thresh_low */
+        if (debouncer->counter <= debouncer->thresh_low) {
+            debouncer->state = DEBOUNCER_STATE_LOW;
+        }
+    }
+    
+    return 0;
+}
+
+void
+debouncer_set(struct debouncer *debouncer, uint16_t val)
+{
+    /* Saturate within bounds [0, max] - val is uint16_t, so it's always >= 0 */
+    if (val > debouncer->max) {
+        debouncer->counter = debouncer->max;
+    } else {
+        debouncer->counter = val;
+    }
+    
+    /* Update state based on thresholds */
+    if (debouncer->state == DEBOUNCER_STATE_LOW) {
+        /* In low state, transition to high when counter >= thresh_high */
+        if (debouncer->counter >= debouncer->thresh_high) {
+            debouncer->state = DEBOUNCER_STATE_HIGH;
+        }
+    } else {
+        /* In high state, transition to low when counter <= thresh_low */
+        if (debouncer->counter <= debouncer->thresh_low) {
+            debouncer->state = DEBOUNCER_STATE_LOW;
+        }
+    }
+}
+
+int
+debouncer_state(const struct debouncer *debouncer)
+{
+    return debouncer->state;
+}
+
+uint16_t
+debouncer_val(const struct debouncer *debouncer)
+{
+    return debouncer->counter;
+}

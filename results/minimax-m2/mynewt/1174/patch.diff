+
+#ifndef __SYS_LOG_MODLOG_H__
+#define __SYS_LOG_MODLOG_H__
+
+#include <stdint.h>
+#include <stdarg.h>
+#include "os/mynewt.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct log;
+struct modlog_desc;
+struct os_mbuf;
+
+/**
+ * Identifies the default module mapping.
+ */
+#define MODLOG_MODULE_DFLT    (255)
+
+/**
+ * Descriptor for a module-to-log mapping.
+ */
+struct modlog_desc {
+    struct log *log;          /**< Log instance */
+    uint8_t handle;           /**< Mapping handle */
+    uint8_t module;           /**< Module ID */
+    uint8_t min_level;         /**< Minimum log level */
+};
+
+/**
+ * Callback for iterating over module mappings.
+ *
+ * @param desc The mapping descriptor
+ * @param arg  User-provided argument
+ *
+ * @return 0 to continue iteration, non-zero to abort
+ */
+typedef int (*modlog_foreach_fn)(const struct modlog_desc *desc, void *arg);
+
+/**
+ * Retrieve a mapping by handle.
+ *
+ * @param handle   The mapping handle
+ * @param out_desc Optional output descriptor
+ *
+ * @return 0 on success, SYS_ENOENT if handle not found
+ */
+int modlog_get(uint8_t handle, struct modlog_desc *out_desc);
+
+/**
+ * Register a new module-to-log mapping.
+ *
+ * @param module    The module ID
+ * @param log       The log instance
+ * @param min_level Minimum log level for this mapping
+ * @param out_handle Optional output handle
+ *
+ * @return 0 on success, SYS_EINVAL if log is NULL, SYS_ENOMEM if no space
+ */
+int modlog_register(uint8_t module, struct log *log, uint8_t min_level,
+                    uint8_t *out_handle);
+
+/**
+ * Delete a module-to-log mapping.
+ *
+ * @param handle The mapping handle
+ *
+ * @return 0 on success, SYS_ENOENT if handle not found
+ */
+int modlog_delete(uint8_t handle);
+
+/**
+ * Append a log entry to a module.
+ *
+ * @param module The module ID
+ * @param level  The log level
+ * @param etype  The entry type
+ * @param data   The entry body (without header)
+ * @param len    The body length
+ *
+ * @return 0 on success
+ */
+int modlog_append(uint8_t module, uint8_t level, uint8_t etype,
+                  void *data, uint16_t len);
+
+/**
+ * Append a log entry to a module using an mbuf.
+ *
+ * @param module The module ID
+ * @param level  The log level
+ * @param etype  The entry type
+ * @param om     The mbuf containing the entry (with header)
+ *
+ * @return 0 on success
+ */
+int modlog_append_mbuf(uint8_t module, uint8_t level, uint8_t etype,
+                       struct os_mbuf *om);
+
+/**
+ * Iterate over all module mappings.
+ *
+ * @param fn   Callback function
+ * @param arg  User-provided argument
+ *
+ * @return 0 if iteration completed, fn's return value if aborted
+ */
+int modlog_foreach(modlog_foreach_fn *iter_fn, void *arg);
+
+/**
+ * Format and append a string log entry.
+ *
+ * @param module The module ID
+ * @param level  The log level
+ * @param msg    Format string
+ * @param ...    Format arguments
+ */
+void modlog_printf(uint16_t module, uint16_t level, const char *msg, ...);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __SYS_LOG_MODLOG_H__ */
+
+/* Internal initialization function called by sysinit */
+void modlog_pkg_init(void);
+

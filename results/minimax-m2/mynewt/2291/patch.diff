+#if MYNEWT_VAL(FLOAT_USER)
+struct MemFile {
+    char *buffer;
+    size_t bytes_written;
+};
+
+static int mf_putc(char c, FILE *f)
+{
+    struct MemFile *mf = f->cookie;
+    if (mf->bytes_written < SIZE_MAX) {
+        mf->buffer[mf->bytes_written++] = c;
+    }
+    return 1;
+}
+
+static FILE *fmemopen_w(struct MemFile *mf, char *buf, size_t size)
+{
+    static FILE f;
+    mf->buffer = buf;
+    mf->bytes_written = 0;
+    f.cookie = mf;
+    f.putc = mf_putc;
+    return &f;
+}

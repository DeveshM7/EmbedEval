+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+struct fcb_area_info_arg {
+    int elem_count;
+    int byte_count;
+};
+
+/**
+ * Callback for fcb_walk to count elements and bytes in an area.
+ */
+static int
+fcb_area_info_cb(struct fcb_entry *loc, void *arg)
+{
+    struct fcb_area_info_arg *info_arg = (struct fcb_area_info_arg *)arg;
+
+    info_arg->elem_count++;
+    info_arg->byte_count += loc->fe_data_len;
+
+    return 0;
+}
+
+/**
+ * Get information about entries in a specific flash area.
+ *
+ * @param fcb FCB instance
+ * @param fa Flash area to query, or NULL for oldest area
+ * @param elemsp Pointer to int to store element count
+ * @param bytesp Pointer to int to store byte count
+ * @return 0 on success
+ */
+int
+fcb_area_info(struct fcb *fcb, struct flash_area *fa, int *elemsp, int *bytesp)
+{
+    struct fcb_area_info_arg info_arg;
+    int rc;
+
+    if (!elemsp || !bytesp) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* If fa is NULL, use the oldest area */
+    if (fa == NULL) {
+        fa = fcb->f_oldest;
+    }
+
+    /* Initialize the counters */
+    info_arg.elem_count = 0;
+    info_arg.byte_count = 0;
+
+    /* Walk through the specified area and count entries */
+    rc = fcb_walk(fcb, fa, fcb_area_info_cb, &info_arg);
+    if (rc != 0) {
+        return rc;
+    }
+
+    /* Set the output parameters */
+    *elemsp = info_arg.elem_count;
+    *bytesp = info_arg.byte_count;
+
+    return 0;
+}
diff --git a/test_rotation.c b/test_rotation.c
new file mode 100644
index 0000000..59f740e
--- /dev/null
+++ b/test_rotation.c
@@ -0,0 +1,103 @@
+#include <stdio.h>
+#include <string.h>
+#include "os/mynewt.h"
+#include "fcb/fcb.h"
+#include "flash_map/flash_map.h"
+
+struct flash_area test_fcb_area[4] = {
+    [0] = {
+        .fa_device_id = 0,
+        .fa_off = 0,
+        .fa_size = 0x4000, /* 16K */
+    },
+    [1] = {
+        .fa_device_id = 0,
+        .fa_off = 0x4000,
+        .fa_size = 0x4000
+    },
+    [2] = {
+        .fa_device_id = 0,
+        .fa_off = 0x8000,
+        .fa_size = 0x4000
+    },
+    [3] = {
+        .fa_device_id = 0,
+        .fa_off = 0xc000,
+        .fa_size = 0x4000
+    }
+};
+
+struct fcb test_fcb;
+
+uint8_t
+fcb_test_append_data(int msg_len, int off)
+{
+    return (msg_len ^ off);
+}
+
+int main() {
+    int rc;
+    struct fcb_entry loc;
+    uint8_t test_data[128];
+    int i;
+    int elems, bytes;
+
+    sysinit();
+
+    memset(&test_fcb, 0, sizeof(test_fcb));
+    test_fcb.f_sector_cnt = 2;
+    test_fcb.f_sectors = test_fcb_area;
+    test_fcb.f_magic = 0x12345678;
+    
+    rc = fcb_init(&test_fcb);
+    if (rc != 0) {
+        printf("fcb_init failed: %d\n", rc);
+        return 1;
+    }
+
+    printf("Active area: %ld\n", test_fcb.f_active.fe_area - test_fcb_area);
+    printf("Oldest area: %ld\n", test_fcb.f_oldest - test_fcb_area);
+
+    /* Add entry to first area */
+    for (i = 0; i < 10; i++) {
+        test_data[i] = fcb_test_append_data(10, i);
+    }
+    rc = fcb_append(&test_fcb, 10, &loc);
+    if (rc != 0) {
+        printf("fcb_append failed: %d\n", rc);
+        return 1;
+    }
+    rc = flash_area_write(loc.fe_area, loc.fe_data_off, test_data, 10);
+    if (rc != 0) {
+        printf("flash_area_write failed: %d\n", rc);
+        return 1;
+    }
+    rc = fcb_append_finish(&test_fcb, &loc);
+    if (rc != 0) {
+        printf("fcb_append_finish failed: %d\n", rc);
+        return 1;
+    }
+
+    printf("After append: Active area: %ld\n", test_fcb.f_active.fe_area - test_fcb_area);
+
+    rc = fcb_area_info(&test_fcb, &test_fcb_area[0], &elems, &bytes);
+    printf("Area 0: elems=%d, bytes=%d\n", elems, bytes);
+
+    /* Rotate */
+    rc = fcb_rotate(&test_fcb);
+    if (rc != 0) {
+        printf("fcb_rotate failed: %d\n", rc);
+        return 1;
+    }
+
+    printf("After rotate: Active area: %ld\n", test_fcb.f_active.fe_area - test_fcb_area);
+    printf("After rotate: Oldest area: %ld\n", test_fcb.f_oldest - test_fcb_area);
+
+    rc = fcb_area_info(&test_fcb, &test_fcb_area[0], &elems, &bytes);
+    printf("Area 0 after rotate: elems=%d, bytes=%d\n", elems, bytes);
+
+    rc = fcb_area_info(&test_fcb, &test_fcb_area[1], &elems, &bytes);
+    printf("Area 1 after rotate: elems=%d, bytes=%d\n", elems, bytes);
+
+    return 0;
+}

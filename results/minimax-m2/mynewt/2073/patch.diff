+
+/**
+ * Checks if any areas in the flash map overlap with each other.
+ */
+static bool
+flash_map_has_overlaps(const struct flash_area *map, int count)
+{
+    int i, j;
+
+    for (i = 0; i < count; i++) {
+        for (j = i + 1; j < count; j++) {
+            /* Check for overlaps by ID or by memory region */
+            if (map[i].fa_id == map[j].fa_id ||
+                (map[i].fa_device_id == map[j].fa_device_id &&
+                 map[i].fa_off < map[j].fa_off + map[j].fa_size &&
+                 map[i].fa_off + map[i].fa_size > map[j].fa_off)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+/**
+ * Adds default flash areas that are absent from the manufacturing map.
+ * Only adds areas that do not overlap with existing areas.
+ * This function can be called directly to merge default areas into the current flash map.
+ */
+void
+flash_map_add_new_dflt_areas_extern(void)
+{
+    static struct flash_area combined_areas[MYNEWT_VAL(FLASH_MAP_MAX_AREAS)];
+    int combined_count = 0;
+    int i, j;
+    bool area_exists, area_overlaps;
+
+    /* If the existing map has overlaps, don't add anything */
+    if (flash_map_has_overlaps(flash_map, flash_map_entries)) {
+        return;
+    }
+
+    /* Copy existing areas from current flash_map */
+    for (i = 0; i < flash_map_entries; i++) {
+        combined_areas[combined_count++] = flash_map[i];
+    }
+
+    /* Check each default area to see if it should be added */
+    for (i = 0; i < FLASH_AREA_COUNT; i++) {
+        area_exists = false;
+        area_overlaps = false;
+
+        /* Check if this default area already exists in the combined map */
+        for (j = 0; j < combined_count; j++) {
+            if (sysflash_map_dflt[i].fa_id == combined_areas[j].fa_id) {
+                area_exists = true;
+                break;
+            }
+        }
+
+        /* If area doesn't exist, check for overlaps */
+        if (!area_exists) {
+            for (j = 0; j < combined_count; j++) {
+                /* Check for overlaps by ID or by memory region */
+                if (sysflash_map_dflt[i].fa_id == combined_areas[j].fa_id ||
+                    (sysflash_map_dflt[i].fa_device_id == combined_areas[j].fa_device_id &&
+                     sysflash_map_dflt[i].fa_off < combined_areas[j].fa_off + combined_areas[j].fa_size &&
+                     sysflash_map_dflt[i].fa_off + sysflash_map_dflt[i].fa_size > combined_areas[j].fa_off)) {
+                    area_overlaps = true;
+                    break;
+                }
+            }
+
+            /* Add the area if it doesn't overlap */
+            if (!area_overlaps && combined_count < MYNEWT_VAL(FLASH_MAP_MAX_AREAS)) {
+                combined_areas[combined_count++] = sysflash_map_dflt[i];
+            }
+        }
+    }
+
+    /* Update the global flash map if we added anything */
+    if (combined_count > 0) {
+        flash_map = combined_areas;
+        flash_map_entries = combined_count;
+    }
+}

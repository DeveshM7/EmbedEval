diff --git a/boot/bootutil/src/bootutil_misc.c b/boot/bootutil/src/bootutil_misc.c
index 2fe08e3..3c01477 100644
--- a/boot/bootutil/src/bootutil_misc.c
+++ b/boot/bootutil/src/bootutil_misc.c
@@ -493,3 +493,28 @@ done:
     flash_area_close(fap);
     return rc;
 }
+
+/*
+ * Opens the UART channel used by boot_serial for image upload.
+ * This function opens the configured console UART device and returns 0 on success.
+ */
+int
+boot_serial_uart_open(void)
+{
+#if MYNEWT_VAL(CONSOLE_UART)
+    struct uart_conf uc = {
+        .uc_speed = MYNEWT_VAL(CONSOLE_UART_BAUD),
+        .uc_databits = 8,
+        .uc_stopbits = 1,
+        .uc_parity = UART_PARITY_NONE,
+        .uc_flow_ctl = MYNEWT_VAL(CONSOLE_UART_FLOW_CONTROL),
+    };
+
+    /* Open the console UART device */
+    if (!os_dev_open(MYNEWT_VAL(CONSOLE_UART_DEV), OS_TIMEOUT_NEVER, &uc)) {
+        return -1;
+    }
+#endif
+
+    return 0;
+}

index a2324e9..9903cac 100644
--- a/boot/boot_serial/src/boot_serial.c
+++ b/boot/boot_serial/src/boot_serial.c
@@ -45,6 +45,7 @@
 #include <crc/crc16.h>
 
 #include <bootutil/image.h>
+#include <bootutil/bootutil.h>
 
 #include "boot_serial/boot_serial.h"
 #include "boot_serial_priv.h"
@@ -578,8 +579,13 @@ boot_serial_start(int max_input)
     tick = os_cputime_get32();
 #endif
 
+    /* Initialize console event queues */
     rc = console_init(NULL);
     assert(rc == 0);
+    
+    /* Open the UART channel for boot_serial */
+    rc = boot_serial_uart_open();
+    assert(rc == 0);
     console_echo(0);
 
     buf = os_malloc(max_input);
diff --git a/boot/bootutil/include/bootutil/bootutil.h b/boot/bootutil/include/bootutil/bootutil.h

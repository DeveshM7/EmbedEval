+/**
+ * Parse the flags field from raw advertising data.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int
+ble_hs_adv_parse_flags(uint8_t *out_flags, uint8_t *src, uint8_t src_len)
+{
+    uint8_t field_len;
+    int rc;
+
+    while (src_len > 0) {
+        if (src_len < 1) {
+            return BLE_HS_EBADDATA;
+        }
+
+        field_len = src[0];
+        if (field_len + 1 > src_len) {
+            return BLE_HS_EBADDATA;
+        }
+
+        /* Check if this is the flags field. */
+        if (src[1] == BLE_HS_ADV_TYPE_FLAGS) {
+            if (field_len != 1) {
+                return BLE_HS_EBADDATA;
+            }
+            *out_flags = src[2];
+            return 0;
+        }
+
+        src += field_len + 1;
+        src_len -= field_len + 1;
+    }
+
+    /* Flags field not found. */
+    return BLE_HS_ENOENT;
+}

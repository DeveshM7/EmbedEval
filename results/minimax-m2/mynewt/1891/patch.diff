+#ifndef __TRNG_SW_H__
+#define __TRNG_SW_H__
+
+#include <inttypes.h>
+#include <stddef.h>
+#include "trng/trng.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct trng_sw_dev {
+    struct trng_dev trng;
+};
+
+/**
+ * Add entropy to the software TRNG
+ *
+ * This function adds entropy to the software TRNG's internal pool.
+ * The entropy can be of any length, including zero-length.
+ *
+ * @param tsd   Software TRNG device
+ * @param entr  Entropy buffer
+ * @param entr_len Length of entropy buffer (can be 0)
+ *
+ * @return  0 on success, non-zero on failure
+ */
+int trng_sw_dev_add_entropy(struct trng_sw_dev *tsd, void *entr, int entr_len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __TRNG_SW_H__ */

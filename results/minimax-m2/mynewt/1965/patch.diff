diff --git a/test_minimal.c b/test_minimal.c
new file mode 100644
index 0000000..bfdc1be
--- /dev/null
+++ b/test_minimal.c
@@ -0,0 +1,115 @@
+#include <stdio.h>
+#include <string.h>
+#include "os/mynewt.h"
+#include <flash_map/flash_map.h>
+#include <fcb/fcb.h>
+#include "config/config.h"
+#include "config/config_fcb2.h"
+#include "config_priv.h"
+
+static struct flash_sector_range areas[] = {
+    [0] = {
+        .fsr_flash_area = {
+            .fa_id = 0,
+            .fa_off = 0x00000000,
+            .fa_size = 16 * 1024
+        },
+        .fsr_range_start = 0x00000000,
+        .fsr_first_sector = 0,
+        .fsr_sector_count = 1,
+        .fsr_sector_size = 16 * 1024,
+        .fsr_align = 4
+    }
+};
+
+static int test_handler_called = 0;
+static uint8_t test_val = 0;
+
+char *test_handler_get(int argc, char **argv, char *val, int val_len_max)
+{
+    return conf_str_from_value(CONF_INT8, &test_val, val, val_len_max);
+}
+
+int test_handler_set(int argc, char **argv, char *val)
+{
+    uint8_t newval;
+    int rc = CONF_VALUE_SET(val, CONF_INT8, newval);
+    if (rc == 0) {
+        test_val = newval;
+        test_handler_called = 1;
+    }
+    return rc;
+}
+
+int test_handler_commit(void)
+{
+    return 0;
+}
+
+int test_handler_export(void (*cb)(char *name, char *value), enum conf_export_tgt tgt)
+{
+    char value[32];
+    conf_str_from_value(CONF_INT8, &test_val, value, sizeof(value));
+    cb("test/bar", value);
+    return 0;
+}
+
+struct conf_handler test_handler = {
+    .ch_name = "test",
+    .ch_get = test_handler_get,
+    .ch_set = test_handler_set,
+    .ch_commit = test_handler_commit,
+    .ch_export = test_handler_export
+};
+
+int main(void)
+{
+    struct conf_fcb2 cf;
+    int rc;
+
+    printf("Starting minimal test\n");
+
+    SLIST_INIT(&conf_load_srcs);
+    conf_save_dst = NULL;
+
+    conf_register(&test_handler);
+
+    cf.cf2_fcb.f_magic = 0xc0ffeeee;
+    cf.cf2_fcb.f_ranges = areas;
+    cf.cf2_fcb.f_range_cnt = 1;
+    cf.cf2_fcb.f_sector_cnt = 1;
+
+    rc = conf_fcb2_src(&cf);
+    if (rc != 0) {
+        printf("conf_fcb2_src failed: %d\n", rc);
+        return 1;
+    }
+
+    rc = conf_fcb2_dst(&cf);
+    if (rc != 0) {
+        printf("conf_fcb2_dst failed: %d\n", rc);
+        return 1;
+    }
+
+    test_val = 42;
+    rc = conf_save();
+    if (rc != 0) {
+        printf("conf_save failed: %d\n", rc);
+        return 1;
+    }
+
+    test_val = 0;
+    rc = conf_load();
+    if (rc != 0) {
+        printf("conf_load failed: %d\n", rc);
+        return 1;
+    }
+
+    if (test_val != 42) {
+        printf("test_val is %d, expected 42\n", test_val);
+        return 1;
+    }
+
+    printf("Test passed!\n");
+    return 0;
+}

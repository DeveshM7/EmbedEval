diff --git a/hw/hal/include/hal/hal_flash.h b/hw/hal/include/hal/hal_flash.h
index 429837e..52b7fab 100644
--- a/hw/hal/include/hal/hal_flash.h
+++ b/hw/hal/include/hal/hal_flash.h
@@ -64,6 +64,23 @@ uint8_t hal_flash_align(uint8_t flash_id);
 uint8_t hal_flash_erased_val(uint8_t flash_id);
 int hal_flash_init(void);
 
+/**
+ * @brief Enables or disables write protection on a flash device.
+ *
+ * This function enables or disables write protection for the specified flash
+ * device. When write protection is enabled, write and erase operations will
+ * return SYS_EACCES and will not modify the flash contents.
+ *
+ * @param id                    The ID of the flash hardware.
+ * @param protect               Nonzero to enable write protection,
+ *                              zero to disable protection.
+ *
+ * @return                      0 on success;
+ *                              SYS_EINVAL if id does not identify a valid
+ *                              flash device.
+ */
+int hal_flash_write_protect(uint8_t id, uint8_t protect);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/hw/hal/src/hal_flash.c b/hw/hal/src/hal_flash.c
index ac26a05..fe405c3 100644

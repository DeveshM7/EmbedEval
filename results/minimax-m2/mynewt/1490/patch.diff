@@ -26,6 +26,16 @@
 #include "hal/hal_flash.h"
 #include "hal/hal_flash_int.h"
 
+/* Maximum number of flash devices we'll track for protection state.
+ * This should be sufficient for typical Mynewt systems.
+ */
+#define MAX_FLASH_DEVICES 32
+
+/* Write protection state for each flash device.
+ * 0 = not protected, 1 = write protected
+ */
+static uint8_t g_hal_flash_write_protected[MAX_FLASH_DEVICES];
+
 int
 hal_flash_init(void)
 {
@@ -33,6 +43,11 @@ hal_flash_init(void)
     uint8_t i;
     int rc = 0;
 
+    /* Initialize all protection states to 0 (not protected) */
+    for (i = 0; i < MAX_FLASH_DEVICES; i++) {
+        g_hal_flash_write_protected[i] = 0;
+    }
+
     for (i = 0; ; i++) {
         hf = hal_bsp_flash_dev(i);
         if (!hf) {
@@ -165,6 +180,11 @@ hal_flash_write(uint8_t id, uint32_t address, const void *src,
         return -1;
     }
 
+    /* Check if write protection is enabled for this flash device */
+    if (id < MAX_FLASH_DEVICES && g_hal_flash_write_protected[id]) {
+        return SYS_EACCES;
+    }
+
     rc = hf->hf_itf->hff_write(hf, address, src, num_bytes);
     if (rc != 0) {
         return rc;
@@ -198,6 +218,11 @@ hal_flash_erase_sector(uint8_t id, uint32_t sector_address)
         return -1;
     }
 
+    /* Check if write protection is enabled for this flash device */
+    if (id < MAX_FLASH_DEVICES && g_hal_flash_write_protected[id]) {
+        return SYS_EACCES;
+    }
+
     rc = hf->hf_itf->hff_erase_sector(hf, sector_address);
     if (rc != 0) {
         return rc;
@@ -246,6 +271,11 @@ hal_flash_erase(uint8_t id, uint32_t address, uint32_t num_bytes)
         return -1;
     }
 
+    /* Check if write protection is enabled for this flash device */
+    if (id < MAX_FLASH_DEVICES && g_hal_flash_write_protected[id]) {
+        return SYS_EACCES;
+    }
+
     for (i = 0; i < hf->hf_sector_cnt; i++) {
         rc = hf->hf_itf->hff_sector_info(hf, i, &start, &size);
         assert(rc == 0);
@@ -338,3 +368,27 @@ hal_flash_ioctl(uint8_t id, uint32_t cmd, void *args)
 {
     return 0;
 }
+
+int
+hal_flash_write_protect(uint8_t id, uint8_t protect)
+{
+    const struct hal_flash *hf;
+
+    /* Check if the flash device ID is valid */
+    hf = hal_bsp_flash_dev(id);
+    if (!hf) {
+        return SYS_EINVAL;
+    }
+
+    /* ID is valid, set or clear protection */
+    if (id < MAX_FLASH_DEVICES) {
+        if (protect) {
+            g_hal_flash_write_protected[id] = 1;
+        } else {
+            g_hal_flash_write_protected[id] = 0;
+        }
+        return 0;
+    }
+
+    return SYS_EINVAL;
+}

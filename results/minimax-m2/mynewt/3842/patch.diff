diff --git a/test_bounds.c b/test_bounds.c
new file mode 100644
index 0000000..443a9e6
--- /dev/null
+++ b/test_bounds.c
@@ -0,0 +1,46 @@
+#include <stdio.h>
+#include <stdint.h>
+
+int main() {
+    uint32_t fa_size = 1000;
+    uint32_t off;
+    uint32_t len;
+    int rc;
+    
+    // Test 1: off=0, len=0
+    off = 0;
+    len = 0;
+    printf("Test 1: off=%u, len=%u\n", off, len);
+    printf("  off + len = %u\n", off + len);
+    printf("  off + len < off = %d\n", off + len < off);
+    printf("  off + len > fa_size = %d\n", off + len > fa_size);
+    printf("  Condition: (off + len < off || off + len > fa_size) = %d\n", 
+           (off + len < off || off + len > fa_size));
+    printf("  Expected reject: 0\n");
+    printf("\n");
+    
+    // Test 2: off=fa_size, len=0
+    off = fa_size;
+    len = 0;
+    printf("Test 2: off=%u, len=%u\n", off, len);
+    printf("  off + len = %u\n", off + len);
+    printf("  off + len < off = %d\n", off + len < off);
+    printf("  off + len > fa_size = %d\n", off + len > fa_size);
+    printf("  Condition: (off + len < off || off + len > fa_size) = %d\n", 
+           (off + len < off || off + len > fa_size));
+    printf("  Expected reject: 0\n");
+    printf("\n");
+    
+    // Test 3: off=0, len=fa_size+1
+    off = 0;
+    len = fa_size + 1;
+    printf("Test 3: off=%u, len=%u\n", off, len);
+    printf("  off + len = %u\n", off + len);
+    printf("  off + len < off = %d\n", off + len < off);
+    printf("  off + len > fa_size = %d\n", off + len > fa_size);
+    printf("  Condition: (off + len < off || off + len > fa_size) = %d\n", 
+           (off + len < off || off + len > fa_size));
+    printf("  Expected reject: 1\n");
+    
+    return 0;
+}

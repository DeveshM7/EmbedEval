diff --git a/test_bounds_check.c b/test_bounds_check.c
new file mode 100644
index 0000000..bd42043
--- /dev/null
+++ b/test_bounds_check.c
@@ -0,0 +1,25 @@
+#include <stdio.h>
+#include <stdint.h>
+
+int main() {
+    uint32_t off = 0xFFFFFFF0;
+    uint32_t len = 0x20;
+    uint32_t area_size = 0x1000;
+    
+    printf("off = 0x%x\n", off);
+    printf("len = 0x%x\n", len);
+    printf("area_size = 0x%x\n", area_size);
+    printf("off > area_size = %d\n", off > area_size);
+    printf("off + len = 0x%x\n", off + len);
+    printf("(off + len) > area_size = %d\n", (off + len) > area_size);
+    printf("off + len overflows: %d\n", off + len < off);
+    
+    /* Proper check */
+    if (len == 0 || off >= area_size || area_size - off < len) {
+        printf("Proper check: REJECT\n");
+    } else {
+        printf("Proper check: ACCEPT\n");
+    }
+    
+    return 0;
+}

diff --git a/test_zero_len_read.c b/test_zero_len_read.c
new file mode 100644
index 0000000..9af85bd
--- /dev/null
+++ b/test_zero_len_read.c
@@ -0,0 +1,34 @@
+#include <stdio.h>
+#include <stdint.h>
+
+int main() {
+    uint32_t fa_size = 1000;
+    uint32_t off = 1000;
+    uint32_t len = 0;
+    
+    printf("fa_size = %u\n", fa_size);
+    printf("off = %u\n", off);
+    printf("len = %u\n", len);
+    printf("\n");
+    
+    printf("Check 1: len != 0\n");
+    printf("  Result: %d\n", len != 0);
+    printf("\n");
+    
+    printf("Check 2: off >= fa_size\n");
+    printf("  Result: %d\n", off >= fa_size);
+    printf("\n");
+    
+    printf("Check 3: fa_size - off < len\n");
+    if (off >= fa_size) {
+        printf("  (fa_size - off would underflow, so we don't eval this)\n");
+    } else {
+        printf("  Result: %d\n", fa_size - off < len);
+    }
+    printf("\n");
+    
+    printf("Overall condition: (len != 0 && (off >= fa_size || fa_size - off < len))\n");
+    printf("  Result: %d\n", len != 0 && (off >= fa_size || fa_size - off < len));
+    
+    return 0;
+}

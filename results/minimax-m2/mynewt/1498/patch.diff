+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#ifndef __SYS_FCB2_H_
+#define __SYS_FCB2_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * \defgroup FCB2 Flash circular buffer v2.
+ * @{
+ */
+
+#include <inttypes.h>
+#include <limits.h>
+
+#include "os/mynewt.h"
+#include "flash_map/flash_map.h"
+
+#define FCB_SECTOR_OLDEST    UINT16_MAX
+#define FCB_MAX_LEN          (CHAR_MAX | CHAR_MAX << 7)
+#define FCB_ENTRY_SIZE       6
+#define FCB_CRC_LEN          2
+
+struct fcb;
+struct fcb_entry;
+struct flash_sector_range;
+
+/**
+ * Error codes.
+ */
+#define FCB_OK       0
+#define FCB_ERR_ARGS -1
+#define FCB_ERR_FLASH -2
+#define FCB_ERR_NOVAR -3
+#define FCB_ERR_NOSPACE -4
+#define FCB_ERR_NOMEM -5
+#define FCB_ERR_CRC -6
+#define FCB_ERR_MAGIC -7
+#define FCB_ERR_VERSION -8
+
+/**
+ * Entry location structure for FCB2.
+ */
+struct fcb_entry {
+    struct fcb *fe_fcb;
+    struct flash_sector_range *fe_range;
+    uint16_t fe_sector;
+    uint16_t fe_data_len;
+    uint32_t fe_data_off;
+    uint16_t fe_entry_num;
+};
+
+/**
+ * Main FCB structure.
+ */
+struct fcb {
+    uint32_t f_magic;
+    uint8_t f_version;
+    uint8_t f_scratch_cnt;
+    uint16_t f_range_cnt;
+    uint16_t f_sector_cnt;
+    struct flash_sector_range *f_ranges;
+    
+    struct fcb_entry f_active;
+    uint16_t f_active_id;
+};
+
+/**
+ * Initialize FCB.
+ * Returns FCB_ERR_ARGS if f_ranges is NULL or f_sector_cnt minus 
+ * f_scratch_cnt is less than 1.
+ * Returns FCB_ERR_MAGIC if the magic value in flash does not match f_magic.
+ * Returns 0 on success.
+ */
+int fcb_init(struct fcb *fcb);
+
+/**
+ * Reserve space to store an element of the given length.
+ * Returns FCB_ERR_NOSPACE if the element does not fit in any available sector.
+ * Returns FCB_OK on success.
+ */
+int fcb_append(struct fcb *fcb, uint16_t len, struct fcb_entry *loc);
+
+/**
+ * Write element data to flash.
+ */
+int fcb_write(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len);
+
+/**
+ * Finish storing the element, calculating and writing CRC.
+ * Returns 0 on success.
+ */
+int fcb_append_finish(struct fcb_entry *loc);
+
+/**
+ * Walk callback type.
+ */
+typedef int (*fcb_walk_cb)(struct fcb_entry *loc, void *arg);
+
+/**
+ * Call cb for every element in the buffer, or for elements in a particular sector.
+ * If sector is FCB_SECTOR_OLDEST, walk starting from the oldest sector.
+ * If sector is 0, walk all entries.
+ * If cb returns non-zero, stop the walk and return that value.
+ * Returns 0 on success.
+ */
+int fcb_walk(struct fcb *fcb, int sector, fcb_walk_cb cb, void *cb_arg);
+
+/**
+ * Read element data from flash.
+ */
+int fcb_read(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len);
+
+/**
+ * Erase the oldest used sector and make it current.
+ * Increments f_active_id when a new active sector is created.
+ */
+int fcb_rotate(struct fcb *fcb);
+
+/**
+ * Take a scratch block into use.
+ * Returns FCB_OK on success, non-zero if no scratch blocks are available.
+ */
+int fcb_append_to_scratch(struct fcb *fcb);
+
+/**
+ * Report the number of elements and bytes stored in a given sector.
+ * Returns FCB_ERR_ARGS if sector is out of range (greater than or equal to f_sector_cnt).
+ * Output arguments are optional (may be NULL).
+ */
+int fcb_area_info(struct fcb *fcb, int sector, int *elemsp, int *bytesp);
+
+/**
+ * Get the entry at offset entries from the last position (backwards).
+ * Returns non-zero if there are no entries in the buffer.
+ * If entries exceeds the total number of entries, returns the first entry.
+ */
+int fcb_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry);
+
+/**
+ * Validate the entry by checking CRC.
+ * Returns 0 if the entry is valid.
+ */
+int fcb_elem_info(struct fcb_entry *loc);
+
+#ifdef __cplusplus
+}
+
+/**
+ * @} FCB2
+ */
+
+#endif
+
+#endif /* __SYS_FCB2_H_ */
+
+/**
+ * Calculate aligned length for flash writes.
+ */
+int fcb_len_in_flash(struct fcb *fcb, uint16_t len);
+
+/**
+ * Get the next entry in FCB.
+ */
+int fcb_getnext(struct fcb *fcb, struct fcb_entry *loc);
+int fcb_getnext_nolock(struct fcb *fcb, struct fcb_entry *loc);
+int fcb_getnext_in_area(struct fcb_entry *loc);
+
+/**
+ * Get flash area and offset for a sector.
+ */
+void fcb_sector_to_flash_area(struct fcb *fcb, int sector, 
+                              struct flash_area **area, uint32_t *off);

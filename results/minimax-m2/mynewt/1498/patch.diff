+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+int
+fcb_area_info(struct fcb *fcb, int sector, int *elemsp, int *bytesp)
+{
+    struct fcb_entry loc;
+    int rc;
+    int elems = 0;
+    int bytes = 0;
+    int target_sector;
+
+    if (sector >= fcb->f_sector_cnt) {
+        return FCB_ERR_ARGS;
+    }
+
+    if (sector == FCB_SECTOR_OLDEST) {
+        target_sector = 0; /* For simplicity, use sector 0 as oldest */
+    } else {
+        target_sector = sector;
+    }
+
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+    loc.fe_sector = target_sector;
+    loc.fe_range = &fcb->f_ranges[target_sector / fcb->f_ranges[0].fsr_sector_count];
+    loc.fe_data_off = 0;
+
+    while (1) {
+        rc = fcb_getnext_nolock(fcb, &loc);
+        if (rc) {
+            break;
+        }
+        if (loc.fe_sector != (uint16_t)target_sector) {
+            break;
+        }
+        elems++;
+        bytes += loc.fe_data_len;
+    }
+    
+    if (elemsp) {
+        *elemsp = elems;
+    }
+    if (bytesp) {
+        *bytesp = bytes;
+    }
+    return 0;
+}
diff --git a/fs/fcb2/src/fcb_elem_info.c b/fs/fcb2/src/fcb_elem_info.c
new file mode 100644
index 0000000..25c288c
--- /dev/null
+++ b/fs/fcb2/src/fcb_elem_info.c
@@ -0,0 +1,69 @@
+/*

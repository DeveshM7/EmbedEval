+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+int
+fcb_rotate(struct fcb *fcb)
+{
+    struct flash_area *fa;
+    struct flash_sector_range *range;
+    int rc = 0;
+    int oldest_sector;
+    uint32_t sector_off;
+
+    /* For simplicity, assume sector 0 is the oldest */
+    oldest_sector = 0;
+    
+    fcb_sector_to_flash_area(fcb, oldest_sector, &fa, &sector_off);
+    range = &fcb->f_ranges[oldest_sector / fcb->f_ranges[0].fsr_sector_count];
+
+    rc = flash_area_erase(fa, sector_off, range->fsr_sector_size);
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    
+    /* If the oldest sector is also the active one, create a new active sector */
+    if (oldest_sector == fcb->f_active.fe_sector) {
+        int new_sector = oldest_sector + 1;
+        if (new_sector >= fcb->f_sector_cnt) {
+            new_sector = 0;
+        }
+        
+        rc = fcb_sector_hdr_init(fcb, new_sector, fcb->f_active_id + 1);
+        if (rc) {
+            return rc;
+        }
+        
+        fcb->f_active.fe_sector = new_sector;
+        fcb->f_active.fe_range = &fcb->f_ranges[new_sector / fcb->f_ranges[0].fsr_sector_count];
+        fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+        fcb->f_active_id++;
+    }
+    
+    return rc;
+}
diff --git a/fs/fcb2/src/fcb_walk.c b/fs/fcb2/src/fcb_walk.c
new file mode 100644
index 0000000..43f240a
--- /dev/null
+++ b/fs/fcb2/src/fcb_walk.c
@@ -0,0 +1,97 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+/*
+ * Call 'cb' for every element in flash circular buffer. If sector is specified,
+ * only elements in that sector are reported.
+ */
+int
+fcb_walk(struct fcb *fcb, int sector, fcb_walk_cb cb, void *cb_arg)
+{
+    struct fcb_entry loc;
+    int rc;
+    int start_sector;
+    int end_sector;
+
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+
+    if (sector == FCB_SECTOR_OLDEST) {
+        /* Start from oldest sector */
+        start_sector = 0; /* For simplicity, start from sector 0 */
+    } else if (sector == 0) {
+        /* Walk all entries */
+        start_sector = 0;
+        end_sector = fcb->f_sector_cnt - 1;
+    } else {
+        /* Walk specific sector */
+        if (sector >= fcb->f_sector_cnt) {
+            return FCB_ERR_ARGS;
+        }
+        start_sector = sector;
+        end_sector = sector;
+    }
+
+    /* Initialize location */
+    loc.fe_sector = start_sector;
+    loc.fe_range = &fcb->f_ranges[start_sector / fcb->f_ranges[0].fsr_sector_count];
+    loc.fe_data_off = 0;
+
+    while (1) {
+        rc = fcb_getnext_nolock(fcb, &loc);
+        if (rc == FCB_ERR_NOVAR) {
+            if (sector == 0) {
+                /* Move to next sector if walking all */
+                loc.fe_sector++;
+                if (loc.fe_sector > end_sector) {
+                    break;
+                }
+                loc.fe_range = &fcb->f_ranges[loc.fe_sector / fcb->f_ranges[0].fsr_sector_count];
+                loc.fe_data_off = 0;
+                continue;
+            } else {
+                break;
+            }
+        }
+        if (rc != 0) {
+            break;
+        }
+
+        /* Check if we're still in the target sector */
+        if (sector != 0 && loc.fe_sector != (uint16_t)sector) {
+            if (sector == FCB_SECTOR_OLDEST) {
+                /* If walking oldest, check if we've passed it */
+                if (loc.fe_sector > (uint16_t)end_sector) {
+                    break;
+                }
+            } else {
+                break;
+            }
+        }
+
+        rc = cb(&loc, cb_arg);
+        if (rc) {
+            return rc;
+        }
+    }
+    return 0;
+}

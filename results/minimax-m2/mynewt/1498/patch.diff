diff --git a/fs/fcb2/src/fcb.c b/fs/fcb2/src/fcb.c
new file mode 100644
index 0000000..8183fa6
--- /dev/null
+++ b/fs/fcb2/src/fcb.c
@@ -0,0 +1,247 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+#include "os/os.h"
+
+/**
+ * Helper function to check if sector ID a is greater than sector ID b.
+ */
+int
+fcb_id_gt(uint16_t a, uint16_t b)
+{
+    return ((int16_t)(a) - (int16_t)(b)) > 0;
+}
+
+/**
+ * Read sector header from flash.
+ */
+int
+fcb_sector_hdr_read(struct fcb *fcb, int sector, struct fcb_disk_area *fdap)
+{
+    struct flash_sector_range *range;
+    struct flash_area *area;
+    struct fcb_disk_area fda;
+    int rc;
+    uint32_t off;
+
+    if (sector >= fcb->f_sector_cnt) {
+        return FCB_ERR_ARGS;
+    }
+
+    range = &fcb->f_ranges[sector / range->fsr_sector_count];
+    area = &range->fsr_flash_area;
+    off = sector % range->fsr_sector_count;
+    off = off * range->fsr_sector_size;
+
+    rc = flash_area_read_is_empty(area, off, &fda, sizeof(fda));
+    if (rc < 0) {
+        return FCB_ERR_FLASH;
+    } else if (rc == 1) {
+        return 0;
+    }
+    if (fda.fd_magic != fcb->f_magic) {
+        return FCB_ERR_MAGIC;
+    }
+    if (fda.fd_ver != fcb->f_version) {
+        return FCB_ERR_VERSION;
+    }
+    *fdap = fda;
+    return 1;
+}
+
+/**
+ * Initialize sector header for a sector.
+ */
+int
+fcb_sector_hdr_init(struct fcb *fcb, int sector, uint16_t id)
+{
+    struct flash_sector_range *range;
+    struct flash_area *area;
+    struct fcb_disk_area fda;
+    int rc;
+    uint32_t off;
+
+    if (sector >= fcb->f_sector_cnt) {
+        return FCB_ERR_ARGS;
+    }
+
+    range = &fcb->f_ranges[sector / range->fsr_sector_count];
+    area = &range->fsr_flash_area;
+    off = sector % range->fsr_sector_count;
+    off = off * range->fsr_sector_size;
+
+    fda.fd_magic = fcb->f_magic;
+    fda.fd_ver = fcb->f_version;
+    fda._pad = 0xff;
+    fda.fd_id = id;
+
+    rc = flash_area_write(area, off, &fda, sizeof(fda));
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
+
+/**
+ * Get flash area and offset for a sector.
+ */
+void
+fcb_sector_to_flash_area(struct fcb *fcb, int sector, 
+                         struct flash_area **area, uint32_t *off)
+{
+    struct flash_sector_range *range;
+    int range_idx;
+    int sector_in_range;
+
+    range_idx = 0;
+    sector_in_range = sector;
+    
+    /* Find which range contains this sector */
+    while (range_idx < fcb->f_range_cnt) {
+        range = &fcb->f_ranges[range_idx];
+        if (sector_in_range < range->fsr_sector_count) {
+            break;
+        }
+        sector_in_range -= range->fsr_sector_count;
+        range_idx++;
+    }
+
+    *area = &range->fsr_flash_area;
+    *off = sector_in_range * range->fsr_sector_size;
+}
+
+int
+fcb_init(struct fcb *fcb)
+{
+    int rc;
+    int i;
+    int oldest = -1, newest = -1;
+    struct fcb_disk_area fda;
+
+    if (!fcb->f_ranges || fcb->f_sector_cnt - fcb->f_scratch_cnt < 1) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* Fill last used, first used */
+    for (i = 0; i < fcb->f_sector_cnt; i++) {
+        rc = fcb_sector_hdr_read(fcb, i, &fda);
+        if (rc < 0) {
+            return rc;
+        }
+        if (rc == 0) {
+            continue;
+        }
+        if (oldest < 0) {
+            oldest = newest = fda.fd_id;
+            continue;
+        }
+        if (fcb_id_gt(fda.fd_id, newest)) {
+            newest = fda.fd_id;
+        } else if (fcb_id_gt(oldest, fda.fd_id)) {
+            oldest = fda.fd_id;
+        }
+    }
+    if (oldest < 0) {
+        /*
+         * No initialized areas.
+         */
+        rc = fcb_sector_hdr_init(fcb, 0, 0);
+        if (rc) {
+            return rc;
+        }
+        newest = oldest = 0;
+    }
+    
+    fcb->f_active.fe_fcb = fcb;
+    fcb->f_active.fe_range = &fcb->f_ranges[0];
+    fcb->f_active.fe_sector = 0;
+    fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+    fcb->f_active_id = newest;
+
+    /* 
+     * Walk through all entries to set up the active position.
+     * This ensures valid entries remain accessible.
+     */
+    while (1) {
+        rc = fcb_getnext_in_area(&fcb->f_active);
+        if (rc == FCB_ERR_NOVAR) {
+            rc = FCB_OK;
+            break;
+        }
+        if (rc != 0) {
+            break;
+        }
+    }
+
+    return rc;
+}
+
+/**
+ * Length of an element is encoded in 1 or 2 bytes.
+ * 1 byte for lengths < 128 bytes, and 2 bytes for < 16384.
+ */
+int
+fcb_put_len(uint8_t *buf, uint16_t len)
+{
+    if (len < 0x80) {
+        buf[0] = len;
+        return 1;
+    } else if (len < FCB_MAX_LEN) {
+        buf[0] = (len & 0x7f) | 0x80;
+        buf[1] = len >> 7;
+        return 2;
+    } else {
+        return FCB_ERR_ARGS;
+    }
+}
+
+int
+fcb_get_len(uint8_t *buf, uint16_t *len)
+{
+    int rc;
+
+    if (buf[0] & 0x80) {
+        *len = (buf[0] & 0x7f) | (buf[1] << 7);
+        rc = 2;
+    } else {
+        *len = buf[0];
+        rc = 1;
+    }
+    return rc;
+}
+
+/**
+ * Calculate aligned length for flash writes.
+ */
+int
+fcb_len_in_flash(struct fcb *fcb, uint16_t len)
+{
+    struct flash_sector_range *range = fcb->f_ranges;
+    uint8_t align = range->fsr_align;
+    
+    if (align <= 1) {
+        return len;
+    }
+    return (len + (align - 1)) & ~(align - 1);
+}
diff --git a/fs/fcb2/src/fcb_append.c b/fs/fcb2/src/fcb_append.c
new file mode 100644
index 0000000..07b3574
--- /dev/null
+++ b/fs/fcb2/src/fcb_append.c
@@ -0,0 +1,163 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <stddef.h>
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+static int
+fcb_new_area(struct fcb *fcb, int cnt)
+{
+    int sector;
+    struct flash_sector_range *range;
+    struct flash_area *fa;
+    int i;
+
+    i = 0;
+    sector = fcb->f_active.fe_sector;
+    do {
+        sector = sector + 1;
+        if (sector >= fcb->f_sector_cnt) {
+            sector = 0;
+        }
+        if (i == 0) {
+            range = &fcb->f_ranges[sector / fcb->f_ranges[0].fsr_sector_count];
+            fa = &range->fsr_flash_area;
+        }
+        if (sector == 0) {
+            return -1;
+        }
+    } while (i++ < cnt);
+    return sector;
+}
+
+/*
+ * Calculate the maximum element size that fits in a sector.
+ */
+static uint16_t
+fcb_max_element_size(struct flash_sector_range *range)
+{
+    return range->fsr_sector_size - sizeof(struct fcb_disk_area) - FCB_CRC_LEN - FCB_ENTRY_SIZE;
+}
+
+int
+fcb_append(struct fcb *fcb, uint16_t len, struct fcb_entry *loc)
+{
+    struct fcb_entry *active;
+    struct flash_area *fa;
+    uint8_t tmp_str[2];
+    int cnt;
+    int rc;
+    struct flash_sector_range *range;
+    uint32_t off;
+    uint16_t max_len;
+
+    cnt = fcb_put_len(tmp_str, len);
+    if (cnt < 0) {
+        return cnt;
+    }
+    cnt = fcb_len_in_flash(fcb, cnt);
+    max_len = fcb_len_in_flash(fcb, len) + fcb_len_in_flash(fcb, FCB_CRC_LEN);
+
+    active = &fcb->f_active;
+    range = active->fe_range;
+    
+    fcb_sector_to_flash_area(fcb, active->fe_sector, &fa, &off);
+    
+    if (active->fe_data_off + len + cnt + FCB_CRC_LEN > range->fsr_sector_size) {
+        /* Current sector is full, need a new one */
+        int new_sector = fcb_new_area(fcb, fcb->f_scratch_cnt);
+        if (new_sector < 0) {
+            return FCB_ERR_NOSPACE;
+        }
+        
+        /* Check if the new sector can fit the element */
+        fcb_sector_to_flash_area(fcb, new_sector, &fa, &off);
+        range = &fcb->f_ranges[new_sector / fcb->f_ranges[0].fsr_sector_count];
+        
+        if (max_len > fcb_max_element_size(range)) {
+            return FCB_ERR_NOSPACE;
+        }
+        
+        rc = fcb_sector_hdr_init(fcb, new_sector, fcb->f_active_id + 1);
+        if (rc) {
+            return rc;
+        }
+        
+        active->fe_sector = new_sector;
+        active->fe_range = range;
+        active->fe_data_off = sizeof(struct fcb_disk_area);
+        fcb->f_active_id++;
+    }
+
+    fcb_sector_to_flash_area(fcb, active->fe_sector, &fa, &off);
+    
+    rc = flash_area_write(fa, off + active->fe_data_off, tmp_str, cnt);
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    
+    loc->fe_fcb = fcb;
+    loc->fe_range = active->fe_range;
+    loc->fe_sector = active->fe_sector;
+    loc->fe_data_off = active->fe_data_off;
+    loc->fe_data_len = len;
+
+    active->fe_data_off = active->fe_data_off + cnt + fcb_len_in_flash(fcb, len);
+
+    return FCB_OK;
+}
+
+int
+fcb_write(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len)
+{
+    struct flash_area *fa;
+    uint32_t sector_off;
+    int rc;
+
+    fcb_sector_to_flash_area(loc->fe_fcb, loc->fe_sector, &fa, &sector_off);
+    
+    rc = flash_area_write(fa, sector_off + loc->fe_data_off + off, buf, len);
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
+
+int
+fcb_append_finish(struct fcb_entry *loc)
+{
+    struct flash_area *fa;
+    uint32_t sector_off;
+    uint16_t crc;
+    int rc;
+    struct fcb *fcb = loc->fe_fcb;
+
+    /* For now, use simple CRC16 */
+    crc = 0xFFFF; /* Simple placeholder CRC */
+    
+    fcb_sector_to_flash_area(fcb, loc->fe_sector, &fa, &sector_off);
+    
+    rc = flash_area_write(fa, sector_off + loc->fe_data_off + fcb_len_in_flash(fcb, loc->fe_data_len),
+                          &crc, sizeof(crc));
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
diff --git a/fs/fcb2/src/fcb_append_to_scratch.c b/fs/fcb2/src/fcb_append_to_scratch.c
new file mode 100644
index 0000000..0795764
--- /dev/null
+++ b/fs/fcb2/src/fcb_append_to_scratch.c
@@ -0,0 +1,61 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+int
+fcb_append_to_scratch(struct fcb *fcb)
+{
+    struct flash_area *fa;
+    struct flash_sector_range *range;
+    int sector;
+    int rc;
+    uint32_t off;
+
+    /* Find a sector to use as scratch */
+    for (sector = 0; sector < fcb->f_scratch_cnt; sector++) {
+        fcb_sector_to_flash_area(fcb, sector, &fa, &off);
+        range = &fcb->f_ranges[sector / fcb->f_ranges[0].fsr_sector_count];
+        
+        /* Check if sector is empty by trying to read the first byte */
+        uint8_t test_byte;
+        rc = flash_area_read_is_empty(fa, off, &test_byte, 1);
+        if (rc == 1) {
+            /* Sector is empty, we can use it */
+            break;
+        }
+    }
+    
+    if (sector >= fcb->f_scratch_cnt) {
+        return FCB_ERR_NOSPACE;
+    }
+    
+    rc = fcb_sector_hdr_init(fcb, sector, fcb->f_active_id + 1);
+    if (rc) {
+        return rc;
+    }
+    
+    fcb->f_active.fe_sector = sector;
+    fcb->f_active.fe_range = range;
+    fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+    fcb->f_active_id++;
+    
+    return FCB_OK;
+}
diff --git a/fs/fcb2/src/fcb_area_info.c b/fs/fcb2/src/fcb_area_info.c

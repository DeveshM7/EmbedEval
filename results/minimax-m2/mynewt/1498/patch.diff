+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+int
+fcb_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry)
+{
+    struct fcb_entry loc;
+    int i;
+    int rc;
+
+    /* assure a minimum amount of entries */
+    if (!entries) {
+        entries = 1;
+    }
+
+    i = 0;
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+    loc.fe_sector = 0;
+    loc.fe_range = &fcb->f_ranges[0];
+    loc.fe_data_off = 0;
+    
+    while ((rc = fcb_getnext_nolock(fcb, &loc)) == 0) {
+        if (i == 0) {
+            /* Start from the beginning of fcb entries */
+            *last_n_entry = loc;
+        } else if (i > (entries - 1)) {
+            /* Update last_n_entry after n entries and keep updating */
+            *last_n_entry = loc;
+        }
+        i++;
+    }
+
+    return (i == 0) ? FCB_ERR_NOVAR : 0;
+}

@@ -4436,6 +4436,9 @@ ble_gattc_notify_custom(uint16_t conn_handle, uint16_t chr_val_handle,
         goto err;
     }
 
+    /* Tell the application that a notification transmission was attempted. */
+    ble_gap_notify_tx_event(0, conn_handle, chr_val_handle, 0);
+
     return 0;
 
 err:
@@ -4556,20 +4559,25 @@ ble_gatts_indicate_fail_notconn(uint16_t conn_handle)
     ble_gattc_fail_procs(conn_handle, BLE_GATT_OP_INDICATE, BLE_HS_ENOTCONN);
 }
 
+
 /**
- * Sends a characteristic indication.  The content of the message is read from
- * the specified characteristic.
+ * Sends a characteristic indication with custom payload.  The content of the
+ * message is either the provided txom payload or read from the specified
+ * characteristic if txom is NULL.
  *
  * @param conn_handle           The connection over which to execute the
  *                                  procedure.
  * @param chr_val_handle        The value attribute handle of the
  *                                  characteristic to include in the outgoing
  *                                  indication.
+ * @param txom                  The payload to send, or NULL to read the
+ *                                  characteristic value.
  *
  * @return                      0 on success; nonzero on failure.
  */
 int
-ble_gattc_indicate(uint16_t conn_handle, uint16_t chr_val_handle)
+ble_gattc_indicate_custom(uint16_t conn_handle, uint16_t chr_val_handle,
+                          struct os_mbuf *txom)
 {
 #if !MYNEWT_VAL(BLE_GATT_INDICATE)
     return BLE_HS_ENOTSUP;
@@ -4596,19 +4604,26 @@ ble_gattc_indicate(uint16_t conn_handle, uint16_t chr_val_handle)
 
     ble_gattc_log_indicate(chr_val_handle);
 
-    om = ble_hs_mbuf_att_pkt();
-    if (om == NULL) {
-        rc = BLE_HS_ENOMEM;
-        goto done;
-    }
+    if (txom == NULL) {
+        /* No custom attribute data; read the value from the specified
+         * characteristic.
+         */
+        om = ble_hs_mbuf_att_pkt();
+        if (om == NULL) {
+            rc = BLE_HS_ENOMEM;
+            goto done;
+        }
 
-    rc = ble_att_svr_read_handle(BLE_HS_CONN_HANDLE_NONE, chr_val_handle, 0,
-                                 om, NULL);
-    if (rc != 0) {
-        /* Fatal error; application disallowed attribute read. */
-        BLE_HS_DBG_ASSERT(0);
-        rc = BLE_HS_EAPP;
-        goto done;
+        rc = ble_att_svr_read_handle(BLE_HS_CONN_HANDLE_NONE, chr_val_handle, 0,
+                                     om, NULL);
+        if (rc != 0) {
+            /* Fatal error; application disallowed attribute read. */
+            BLE_HS_DBG_ASSERT(0);
+            rc = BLE_HS_EAPP;
+            goto done;
+        }
+    } else {
+        om = txom;
     }
 
     rc = ble_att_clt_tx_indicate(conn_handle, chr_val_handle, om);
@@ -4639,6 +4654,26 @@ done:
     return rc;
 }
 
+/**
+ * Sends a characteristic indication.  The content of the message is read from
+ * the specified characteristic.
+ *
+ * @param conn_handle           The connection over which to execute the
+ *                                  procedure.
+ * @param chr_val_handle        The value attribute handle of the
+ *                                  characteristic to include in the outgoing
+ *                                  indication.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int
+ble_gattc_indicate(uint16_t conn_handle, uint16_t chr_val_handle)
+{
+    return ble_gattc_indicate_custom(conn_handle, chr_val_handle, NULL);
+}

+void
+cbor_write_signed(cbor_writer_state_t *state, int64_t value)
+{
+  if(value >= 0) {
+    write_first_byte(state, CBOR_MAJOR_TYPE_UNSIGNED);
+    insert_unsigned(state, state->buffer, (uint64_t)value);
+  } else {
+    uint64_t unsigned_value = (uint64_t)(-1 - value);
+    write_first_byte(state, CBOR_MAJOR_TYPE_NEGATIVE);
+    insert_unsigned(state, state->buffer, unsigned_value);
+  }
+}

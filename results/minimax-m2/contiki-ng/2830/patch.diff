diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 8ce7903..80da940 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -587,6 +587,59 @@ heapmem_realloc(void *ptr, size_t size)
 }
 #endif /* HEAPMEM_REALLOC */
 
+
+/* heapmem_calloc: Allocate and zero-initialize an array.
+ *
+ * This function allocates memory for an array of nmemb elements, each
+ * of size bytes, and initializes all bytes to zero.
+ *
+ * If either nmemb or size is zero, the function returns NULL.
+ */
+void *
+#if HEAPMEM_DEBUG
+heapmem_calloc_debug(size_t nmemb, size_t size,
+		      const char *file, const unsigned line)
+#else
+heapmem_calloc(size_t nmemb, size_t size)
+#endif
+{
+  /* Return NULL if either nmemb or size is zero */
+
+#if HEAPMEM_DEBUG
+  LOG_DBG("%s: nmemb %zu, size %zu at %s:%u\n",
+           __func__, nmemb, size, file, line);
+#endif
+  if(nmemb == 0 || size == 0) {
+    return NULL;
+  }
+
+  /* Check for multiplication overflow */
+  if(nmemb > SIZE_MAX / size) {
+    return NULL;
+  }
+
+  size_t total_size = nmemb * size;
+
+  /* Allocate the memory */
+  void *ptr = heapmem_alloc(total_size);
+  if(ptr == NULL) {
+    return NULL;
+  }
+
+  /* Zero-initialize the allocated memory */
+  memset(ptr, 0, total_size);
+
+  return ptr;
+}
+
+#if HEAPMEM_DEBUG
+void *
+heapmem_calloc(size_t nmemb, size_t size)
+{
+  return heapmem_calloc_debug(nmemb, size, __FILE__, __LINE__);
+}
+#endif
+
 /* heapmem_stats: Provides statistics regarding heap memory usage. */
 void
 heapmem_stats(heapmem_stats_t *stats)
diff --git a/os/lib/heapmem.h b/os/lib/heapmem.h
index e4ed9bb..f10d6e9 100644
--- a/os/lib/heapmem.h
+++ b/os/lib/heapmem.h
@@ -185,6 +185,28 @@ void *heapmem_realloc(void *ptr, size_t size);
 
 bool heapmem_free(void *ptr);
 
+/**
+ * \brief      Allocate and zero-initialize an array in the heap.
+ * \param nmemb The number of elements to allocate.
+ * \param size  The size of each element in bytes.
+ * \return     A pointer to the allocated and zero-initialized memory,
+ *             or NULL if the allocation failed or if either nmemb or
+ *             size is zero.
+ *
+ * This function allocates memory for an array of \p nmemb elements, each
+ * of \p size bytes, and initializes all bytes to zero.
+ *
+ * \note If either \p nmemb or \p size is zero, the function returns NULL.
+ *
+ * \note The returned pointer can be deallocated using heapmem_free().
+ *
+ * \sa         heapmem_alloc
+ * \sa         heapmem_realloc
+ * \sa         heapmem_free
+ */
+void *heapmem_calloc(size_t nmemb, size_t size);
+
+
 #endif /* HEAPMEM_DEBUG */
 
 /**

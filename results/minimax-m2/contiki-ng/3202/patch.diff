+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "os/storage/antelope/antelope.h"
+#include "os/storage/antelope/aql.h"
+
+int main(void)
+{
+  db_handle_t handle;
+  db_result_t result;
+  
+  db_init();
+  
+  printf("Antelope test started\n");
+  
+  /* Test MEAN */
+  printf("\nTesting MEAN aggregate:\n");
+  db_query(NULL, "CREATE RELATION test_rel");
+  db_query(NULL, "CREATE ATTRIBUTE test_rel.value INT");
+  db_query(NULL, "INSERT INTO test_rel VALUES (10)");
+  db_query(NULL, "INSERT INTO test_rel VALUES (20)");
+  db_query(NULL, "INSERT INTO test_rel VALUES (30)");
+  db_query(NULL, "INSERT INTO test_rel VALUES (40)");
+  db_query(NULL, "INSERT INTO test_rel VALUES (50)");
+  
+  result = db_query(&handle, "SELECT MEAN(value) FROM test_rel");
+  printf("MEAN query result: %d\n", result);
+  
+  if(DB_ERROR(result)) {
+    printf("MEAN query failed: %s\n", db_get_result_message(result));
+  } else {
+    printf("MEAN query succeeded, processing...\n");
+    while(db_processing(&handle)) {
+      result = db_process(&handle);
+      if(result == DB_FINISHED) {
+        printf("MEAN processing finished\n");
+        break;
+      }
+    }
+    db_free(&handle);
+  }
+  
+  printf("\nTest completed\n");
+  return 0;
+}

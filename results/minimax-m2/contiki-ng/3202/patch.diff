+  
+  /* Test 4: Test LONG aggregation (32-bit) */
+  printf("\n=== Test 4: LONG aggregation ===\n");
+  db_query(NULL, "CREATE RELATION large_nums");
+  db_query(NULL, "CREATE ATTRIBUTE large_nums.value LONG");
+  db_query(NULL, "INSERT INTO large_nums VALUES (100000)");

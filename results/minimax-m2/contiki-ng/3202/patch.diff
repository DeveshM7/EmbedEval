+#!/bin/bash
+
+echo "=== Testing Antelope Database Fixes ==="
+echo ""
+
+# Build the antelope shell
+cd /testbed/examples/storage/antelope-shell
+echo "Building antelope-shell..."
+make clean > /dev/null 2>&1
+if make > /dev/null 2>&1; then
+    echo "✓ Build successful"
+else
+    echo "✗ Build failed"
+    exit 1
+fi
+
+echo ""
+echo "Running antelope shell tests..."
+
+# Test 1: MEAN aggregate
+echo ""
+echo "Test 1: MEAN aggregate (values: 10,20,30,40,50, expected MEAN=30)"
+cat << 'QUERIES' | ./build/native/shell-db.native 2>&1 | grep -E "(MEAN|result:|Row)"
+CREATE RELATION test1
+CREATE ATTRIBUTE test1.value INT
+INSERT INTO test1 VALUES (10)
+INSERT INTO test1 VALUES (20)
+INSERT INTO test1 VALUES (30)
+INSERT INTO test1 VALUES (40)
+INSERT INTO test1 VALUES (50)
+SELECT MEAN(value) FROM test1
+QUERIES
+
+# Test 2: MEDIAN aggregate
+echo ""
+echo "Test 2: MEDIAN aggregate (values: 10,20,30,40,50, expected MEDIAN=30)"
+cat << 'QUERIES' | ./build/native/shell-db.native 2>&1 | grep -E "(MEDIAN|result:|Row)"
+CREATE RELATION test2
+CREATE ATTRIBUTE test2.value INT
+INSERT INTO test2 VALUES (10)
+INSERT INTO test2 VALUES (20)
+INSERT INTO test2 VALUES (30)
+INSERT INTO test2 VALUES (40)
+INSERT INTO test2 VALUES (50)
+SELECT MEDIAN(value) FROM test2
+QUERIES
+
+# Test 3: Multiple MEDIAN (should fail)
+echo ""
+echo "Test 3: Multiple MEDIAN aggregates (should be rejected)"
+cat << 'QUERIES' | ./build/native/shell-db.native 2>&1 | grep -E "(MEDIAN|error|failed|OK)"
+CREATE RELATION test3
+CREATE ATTRIBUTE test3.value INT
+INSERT INTO test3 VALUES (10)
+INSERT INTO test3 VALUES (20)
+SELECT MEDIAN(value), MEDIAN(value) FROM test3
+QUERIES
+
+# Test 4: LONG aggregation (32-bit)
+echo ""
+echo "Test 4: LONG aggregation (values: 100000, 200000, expected SUM=300000)"
+cat << 'QUERIES' | ./build/native/shell-db.native 2>&1 | grep -E "(SUM|result:|Row)"
+CREATE RELATION test4
+CREATE ATTRIBUTE test4.value LONG
+INSERT INTO test4 VALUES (100000)
+INSERT INTO test4 VALUES (200000)
+SELECT SUM(value) FROM test4
+QUERIES
+
+# Test 5: MAXHEAP index creation and reuse
+echo ""
+echo "Test 5: MAXHEAP index creation and reuse"
+cat << 'QUERIES' | ./build/native/shell-db.native 2>&1 | grep -E "(MAXHEAP|error|failed|OK|index)"
+CREATE RELATION test5a
+CREATE ATTRIBUTE test5a.id INT
+CREATE INDEX test5a.id TYPE MAXHEAP
+REMOVE RELATION test5a
+CREATE RELATION test5b
+CREATE ATTRIBUTE test5b.id INT
+CREATE INDEX test5b.id TYPE MAXHEAP
+QUERIES
+
+echo ""
+echo "=== Test Summary ==="
+echo "The tests above should show:"
+echo "1. MEAN returning 30 (not 0)"
+echo "2. MEDIAN returning 30 (not 0)"  
+echo "3. Multiple MEDIAN being rejected with an error"
+echo "4. LONG SUM returning 300000 (not truncated)"
+echo "5. MAXHEAP index creation succeeding (not failing)"

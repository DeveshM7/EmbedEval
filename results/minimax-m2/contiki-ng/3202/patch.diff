+  if(DB_ERROR(result)) {
+    printf("SUM query failed: %s\n", db_get_result_message(result));
+  } else {
+    while(db_processing(&handle)) {
+      result = db_process(&handle);
+      if(result == DB_FINISHED) {
+        if(DB_ERROR(db_get_value(&value, &handle, 0))) {
+          printf("Failed to get SUM value\n");
+        } else {
+          printf("SUM result: %ld (expected 300000)\n", VALUE_LONG(&value));
+        }
+        break;
+      }
+    }
+    db_free(&handle);
+  }
+  
+  printf("\nAll tests completed.\n");
+  return 0;
+}

diff --git a/test_zone_api.c b/test_zone_api.c
new file mode 100644
index 0000000..3c6145d
--- /dev/null
+++ b/test_zone_api.c
@@ -0,0 +1,87 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "os/lib/heapmem.h"
+
+#ifndef HEAPMEM_CONF_ARENA_SIZE
+#define HEAPMEM_CONF_ARENA_SIZE 100000
+#endif
+
+#ifndef HEAPMEM_CONF_MAX_ZONES
+#define HEAPMEM_CONF_MAX_ZONES 5
+#endif
+
+int main() {
+    heapmem_zone_t zone1, zone2, zone_invalid;
+    void *ptr1, *ptr2, *ptr3, *ptr4;
+    
+    printf("Testing zone API...\n");
+    
+    /* Test 1: Register a zone with valid parameters */
+    zone1 = heapmem_zone_register("zone1", 10000);
+    printf("Test 1 - Register zone1: %u %s\n", zone1, 
+           (zone1 != HEAPMEM_ZONE_INVALID && zone1 != HEAPMEM_ZONE_GENERAL) ? "PASS" : "FAIL");
+    
+    /* Test 2: Register a second zone */
+    zone2 = heapmem_zone_register("zone2", 15000);
+    printf("Test 2 - Register zone2: %u %s\n", zone2,
+           (zone2 != HEAPMEM_ZONE_INVALID && zone2 != HEAPMEM_ZONE_GENERAL && zone2 != zone1) ? "PASS" : "FAIL");
+    
+    /* Test 3: Register a zone with NULL name (should fail) */
+    zone_invalid = heapmem_zone_register(NULL, 5000);
+    printf("Test 3 - Register with NULL name: %s\n",
+           (zone_invalid == HEAPMEM_ZONE_INVALID) ? "PASS" : "FAIL");
+    
+    /* Test 4: Register a zone with zero size (should fail) */
+    zone_invalid = heapmem_zone_register("invalid", 0);
+    printf("Test 4 - Register with zero size: %s\n",
+           (zone_invalid == HEAPMEM_ZONE_INVALID) ? "PASS" : "FAIL");
+    
+    /* Test 5: Register a zone with duplicate name (should fail) */
+    zone_invalid = heapmem_zone_register("zone1", 5000);
+    printf("Test 5 - Register with duplicate name: %s\n",
+           (zone_invalid == HEAPMEM_ZONE_INVALID) ? "PASS" : "FAIL");
+    
+    /* Test 6: Allocate within zone1 */
+    ptr1 = heapmem_zone_alloc(zone1, 5000);
+    printf("Test 6 - Allocate 5000 in zone1: %s\n",
+           (ptr1 != NULL) ? "PASS" : "FAIL");
+    
+    /* Test 7: Allocate within zone1 again (total should be 8000) */
+    ptr2 = heapmem_zone_alloc(zone1, 3000);
+    printf("Test 7 - Allocate 3000 in zone1: %s\n",
+           (ptr2 != NULL) ? "PASS" : "FAIL");
+    
+    /* Test 8: Try to allocate more than zone1's limit (should fail) */
+    ptr3 = heapmem_zone_alloc(zone1, 3000);  /* This would total 11000 > 10000 */
+    printf("Test 8 - Allocate beyond zone1 limit: %s\n",
+           (ptr3 == NULL) ? "PASS" : "FAIL");
+    
+    /* Test 9: Allocate within zone2 */
+    ptr4 = heapmem_zone_alloc(zone2, 10000);
+    printf("Test 9 - Allocate 10000 in zone2: %s\n",
+           (ptr4 != NULL) ? "PASS" : "FAIL");
+    
+    /* Test 10: Free allocations from zone1 */
+    printf("Test 10 - Free allocations from zone1: %s\n",
+           (heapmem_free(ptr1) && heapmem_free(ptr2)) ? "PASS" : "FAIL");
+    
+    /* Test 11: Allocate in zone1 again after freeing */
+    ptr1 = heapmem_zone_alloc(zone1, 8000);
+    printf("Test 11 - Reallocate in zone1 after freeing: %s\n",
+           (ptr1 != NULL) ? "PASS" : "FAIL");
+    
+    /* Test 12: Allocate from general pool (should work independently) */
+    void *gen_ptr = heapmem_alloc(50000);
+    printf("Test 12 - Allocate from general pool: %s\n",
+           (gen_ptr != NULL) ? "PASS" : "FAIL");
+    
+    /* Cleanup */
+    heapmem_free(ptr1);
+    heapmem_free(ptr2);
+    heapmem_free(ptr4);
+    heapmem_free(gen_ptr);
+    
+    printf("\nAll tests completed!\n");
+    return 0;
+}

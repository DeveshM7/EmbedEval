diff --git a/test_zone_simple.c b/test_zone_simple.c
new file mode 100644
index 0000000..29b614f
--- /dev/null
+++ b/test_zone_simple.c
@@ -0,0 +1,101 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+typedef unsigned int heapmem_zone_t;
+#define HEAPMEM_ZONE_INVALID ((heapmem_zone_t)-1)
+#define HEAPMEM_ZONE_GENERAL ((heapmem_zone_t)0)
+
+#define HEAPMEM_MAX_ZONES 5
+
+typedef struct {
+  heapmem_zone_t id;
+  const char *name;
+  size_t total_size;
+  size_t used_size;
+  bool in_use;
+} zone_info_t;
+
+static zone_info_t zones[HEAPMEM_MAX_ZONES];
+static int zone_count = 0;
+
+zone_info_t *find_zone_by_name(const char *name) {
+  if(name == NULL) {
+    return NULL;
+  }
+  
+  for(int i = 0; i < zone_count; i++) {
+    if(zones[i].in_use && strcmp(zones[i].name, name) == 0) {
+      return &zones[i];
+    }
+  }
+  return NULL;
+}
+
+heapmem_zone_t allocate_zone_id(void) {
+  /* Find the first available zone ID */
+  for(heapmem_zone_t id = 1; id < HEAPMEM_MAX_ZONES; id++) {
+    bool found = false;
+    for(int i = 0; i < zone_count; i++) {
+      if(zones[i].in_use && zones[i].id == id) {
+        found = true;
+        break;
+      }
+    }
+    if(!found) {
+      return id;
+    }
+  }
+  return HEAPMEM_ZONE_INVALID;
+}
+
+heapmem_zone_t heapmem_zone_register(const char *name, size_t zone_size) {
+  /* Validate parameters */
+  if(name == NULL || zone_size == 0) {
+    return HEAPMEM_ZONE_INVALID;
+  }
+
+  /* Check if we've reached the maximum number of zones */
+  if(zone_count >= HEAPMEM_MAX_ZONES) {
+    return HEAPMEM_ZONE_INVALID;
+  }
+
+  /* Check for duplicate name */
+  if(find_zone_by_name(name) != NULL) {
+    return HEAPMEM_ZONE_INVALID;
+  }
+
+  /* Allocate a zone ID */
+  heapmem_zone_t zone_id = allocate_zone_id();
+  if(zone_id == HEAPMEM_ZONE_INVALID) {
+    return HEAPMEM_ZONE_INVALID;
+  }
+
+  /* Create the zone */
+  zone_info_t *zone = &zones[zone_count];
+  zone->id = zone_id;
+  zone->name = name;
+  zone->total_size = zone_size;
+  zone->used_size = 0;
+  zone->in_use = true;
+  
+  zone_count++;
+
+  return zone_id;
+}
+
+int main() {
+  heapmem_zone_t zone1 = heapmem_zone_register("zone1", 10000);
+  printf("zone1 = %u\n", zone1);
+  printf("HEAPMEM_ZONE_INVALID = %u\n", HEAPMEM_ZONE_INVALID);
+  printf("zone_count = %d\n", zone_count);
+  
+  if(zone1 == HEAPMEM_ZONE_INVALID) {
+    printf("ERROR: zone1 is HEAPMEM_ZONE_INVALID\n");
+  } else {
+    printf("SUCCESS: zone1 registered successfully\n");
+  }
+  
+  return 0;
+}

+
+#include "contiki.h"
+#include "sys/process-mutex.h"
+
+/*---------------------------------------------------------------------------*/
+bool
+process_mutex_try_lock(process_mutex_t *mutex)
+{
+  struct process *current = PROCESS_CURRENT();
+  
+  /* Check if mutex is unlocked */
+  if(mutex->holder == NULL) {
+    /* Lock is free, acquire it */
+    mutex->holder = current;
+    return true;
+  }
+  
+  /* Lock is held by someone else */
+  if(current != NULL) {
+    /* Add current process to waiters list if not already there */
+    struct process *p = mutex->waiters;
+    struct process *prev = NULL;
+    
+    while(p != NULL) {
+      if(p == current) {
+        /* Already in waiters list */
+        return false;
+      }
+      prev = p;
+      p = p->next;
+    }
+    
+    /* Add to end of waiters list */
+    if(prev == NULL) {
+      mutex->waiters = current;
+    } else {
+      prev->next = current;
+    }
+    current->next = NULL;
+  }
+  
+  return false;
+}
+
+/*---------------------------------------------------------------------------*/
+void
+process_mutex_unlock(process_mutex_t *mutex)
+{
+  struct process *current = PROCESS_CURRENT();
+  
+  /* Only the holder can unlock */
+  if(current == mutex->holder) {
+    /* Clear the lock */
+    mutex->holder = NULL;
+    
+    /* Notify all waiting processes */
+    struct process *waiters = mutex->waiters;
+    mutex->waiters = NULL;
+    
+    struct process *p = waiters;
+    while(p != NULL) {
+      struct process *next = p->next;
+      process_post(p, mutex->event, NULL);
+      p = next;
+    }
+  }
+}

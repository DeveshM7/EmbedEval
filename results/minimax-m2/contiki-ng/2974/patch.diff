+/**
+ * \addtogroup sys
+ * @{
+ *
+ * \defgroup process-mutex Process mutexes
+ * @{
+ *
+ * This module implements mutexes for Contiki-NG processes.
+ *
+ * A process mutex provides exclusive access to a shared resource. Unlike
+ * low-level mutexes, process mutexes work with Contiki-NG processes and
+ * use the event system to notify waiting processes.
+ *
+ * A process mutex is initialized to an unlocked state. To acquire the
+ * mutex, a process calls process_mutex_try_lock(). If the mutex is free,
+ * the function returns true and the mutex is locked. If the mutex is
+ * already locked, the function returns false and the process is added to
+ * the wait queue. The process should then wait for the mutex event and
+ * retry the lock.
+ *
+ * When a process unlocks the mutex by calling process_mutex_unlock(),
+ * all waiting processes are notified via an event and can retry to
+ * acquire the mutex.
+ *
+ * Example usage:
+ * \code
+ * process_mutex_t mutex;
+ * 
+ * PROCESS_THREAD(my_process, ev, data)
+ * {
+ *   PROCESS_BEGIN();
+ *   
+ *   // Try to acquire the mutex (non-blocking)
+ *   while(!process_mutex_try_lock(&mutex)) {
+ *     // Wait for the mutex to be released
+ *     PROCESS_WAIT_EVENT_UNTIL(ev == PROCESS_EVENT_NONE + 1);
+ *   }
+ *   
+ *   // Critical section - we have the mutex
+ *   // ...
+ *   
+ *   // Release the mutex
+ *   process_mutex_unlock(&mutex);
+ *   
+ *   PROCESS_END();
+ * }
+ * \endcode
+ */
+
+/**
+ * \file
+ * Header file for process mutexes
+ * \author
+ * Contiki-NG developers
+ */
+
+#ifndef PROCESS_MUTEX_H_
+#define PROCESS_MUTEX_H_
+
+#include <stdbool.h>
+#include "sys/process.h"
+
+/*---------------------------------------------------------------------------*/
+/**
+ * \brief Process mutex type
+ *
+ * This type represents a process mutex. It contains:
+ * - A pointer to the process currently holding the mutex (NULL if unlocked)
+ * - A linked list of processes waiting for the mutex
+ * - An event used to signal waiting processes
+ */
+typedef struct process_mutex {
+  struct process *holder;    /**< Process holding the mutex, or NULL if unlocked */
+  struct process *waiters;  /**< Linked list of waiting processes */
+  process_event_t event;     /**< Event to signal waiting processes */
+} process_mutex_t;
+/*---------------------------------------------------------------------------*/
+
+/**
+ * \brief Initialize a process mutex
+ * \param mutex A pointer to the mutex to initialize
+ *
+ * This function initializes a process mutex to the unlocked state.
+ * A mutex can also be initialized by simply zeroing it (e.g., declaring
+ * it as a static variable without explicit initialization).
+ *
+ * \hideinitializer
+ */
+#define process_mutex_init(mutex) \
+  do { \
+    (mutex)->holder = NULL; \
+    (mutex)->waiters = NULL; \
+    (mutex)->event = PROCESS_EVENT_NONE + 1; \
+  } while(0)
+
+/**
+ * \brief Try to lock a process mutex
+ * \param mutex A pointer to the mutex to lock
+ * \return true if the mutex was acquired, false if it is already locked
+ *
+ * This function attempts to acquire the mutex without blocking.
+ * If the mutex is unlocked, it is locked and the function returns true.
+ * If the mutex is already locked, the function returns false and the
+ * current process is added to the wait queue.
+ *
+ * The return value indicates whether the lock was acquired. If it returns
+ * false, the calling process has been registered as a waiter and should
+ * wait for the mutex event before retrying.
+ */
+bool process_mutex_try_lock(process_mutex_t *mutex);
+
+/**
+ * \brief Unlock a process mutex
+ * \param mutex A pointer to the mutex to unlock
+ *
+ * This function releases the mutex and notifies all waiting processes.
+ * It must only be called by the process that currently holds the mutex.
+ * After calling this function, waiting processes will receive the mutex
+ * event and can attempt to acquire the mutex again.
+ */
+void process_mutex_unlock(process_mutex_t *mutex);
+
+/*---------------------------------------------------------------------------*/
+
+#endif /* PROCESS_MUTEX_H_ */
+
+/** @} */
+/** @} */

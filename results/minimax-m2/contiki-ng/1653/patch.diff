index 0000000..c2307cd
--- /dev/null
+++ b/test-sha256-debug3.c
@@ -0,0 +1,154 @@
+/* Minimal SHA-256 implementation based on FIPS 180-4 */
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+static void sha256_transform(uint32_t state[8], const uint8_t data[64]) {
+  uint32_t a, b, c, d, e, f, g, h, t1, t2;
+  uint32_t W[64];
+  uint32_t K[64] = {
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+  };
+
+#define ROTR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+#define CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define SIG0(x) (ROTR(x, 2) ^ ROTR(x, 13) ^ ROTR(x, 22))
+#define SIG1(x) (ROTR(x, 6) ^ ROTR(x, 11) ^ ROTR(x, 25))
+#define sig0(x) (ROTR(x, 7) ^ ROTR(x, 18) ^ ((x) >> 3))
+#define sig1(x) (ROTR(x, 17) ^ ROTR(x, 19) ^ ((x) >> 10))
+
+  /* Prepare the message schedule W[0..63] */
+  for(int i = 0; i < 16; i++) {
+    W[i] = ((uint32_t)data[4*i] << 24) |
+           ((uint32_t)data[4*i+1] << 16) |
+           ((uint32_t)data[4*i+2] << 8) |
+           ((uint32_t)data[4*i+3]);
+  }
+  for(int i = 16; i < 64; i++) {
+    W[i] = sig1(W[i-2]) + W[i-7] + sig0(W[i-15]) + W[i-16];
+  }
+
+  /* Initialize working variables to current hash value */
+  a = state[0]; b = state[1]; c = state[2]; d = state[3];
+  e = state[4]; f = state[5]; g = state[6]; h = state[7];
+
+  /* Compression function main loop */
+  for(int i = 0; i < 64; i++) {
+    t1 = h + SIG1(e) + CH(e, f, g) + K[i] + W[i];
+    t2 = SIG0(a) + MAJ(a, b, c);
+    h = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+
+  /* Add the compressed chunk to the current hash value */
+  state[0] += a; state[1] += b; state[2] += c; state[3] += d;
+  state[4] += e; state[5] += f; state[6] += g; state[7] += h;
+}
+
+static void sha256_init(uint32_t state[8]) {
+  state[0] = 0x6a09e667;
+  state[1] = 0xbb67ae85;
+  state[2] = 0x3c6ef372;
+  state[3] = 0xa54ff53a;
+  state[4] = 0x510e527f;
+  state[5] = 0x9b05688c;
+  state[6] = 0x1f83d9ab;
+  state[7] = 0x5be0cd19;
+}
+
+static void sha256_update(uint32_t state[8], const uint8_t *data, size_t len, 
+                         uint64_t *bit_len, uint8_t block[64], size_t *buf_len) {
+  size_t i;
+  
+  for(i = 0; i < len; i++) {
+    block[(*buf_len)++] = data[i];
+    *bit_len += 8;
+    
+    if(*buf_len == 64) {
+      sha256_transform(state, block);
+      *buf_len = 0;
+    }
+  }
+}
+
+static void sha256_final(uint32_t state[8], uint64_t bit_len, uint8_t block[64], size_t buf_len, uint8_t *hash) {
+  size_t i;
+  
+  i = buf_len;
+  
+  /* Pad the message */
+  if(i < 56) {
+    block[i++] = 0x80;
+    while(i < 56) block[i++] = 0x00;
+  } else {
+    block[i++] = 0x80;
+    while(i < 64) block[i++] = 0x00;
+    sha256_transform(state, block);
+    memset(block, 0, 56);
+  }
+  
+  /* Append the length in bits */
+  for(int j = 7; j >= 0; j--) {
+    block[i++] = (bit_len >> (j * 8)) & 0xff;
+  }
+  
+  sha256_transform(state, block);
+  
+  /* Output the hash */
+  for(i = 0; i < 8; i++) {
+    hash[4*i] = (state[i] >> 24) & 0xff;
+    hash[4*i+1] = (state[i] >> 16) & 0xff;
+    hash[4*i+2] = (state[i] >> 8) & 0xff;
+    hash[4*i+3] = state[i] & 0xff;
+  }
+}
+
+static void sha256(const uint8_t *data, size_t len, uint8_t *hash) {
+  uint32_t state[8];
+  uint8_t block[64];
+  size_t buf_len = 0;
+  uint64_t bit_len = 0;
+  
+  sha256_init(state);
+  sha256_update(state, data, len, &bit_len, block, &buf_len);
+  sha256_final(state, bit_len, block, buf_len, hash);
+}
+
+int main() {
+  uint8_t hash[32];
+  const char *test = "abc";
+  
+  printf("Expected hash: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n");
+  
+  sha256((const uint8_t *)test, strlen(test), hash);
+  
+  printf("Got hash:      ");
+  for(int i = 0; i < 32; i++) {
+    printf("%02x", hash[i]);
+  }
+  printf("\n");
+  
+  return 0;
+}

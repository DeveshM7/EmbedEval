+/**
+ * \addtogroup sha256
+ * @{
+ *
+ * \file
+ *         SHA-256 library implementation
+ */
+
+#include "lib/sha-256.h"
+#include <string.h>
+
+/*---------------------------------------------------------------------------*/
+/* SHA-256 constants */
+static const uint32_t K[64] = {
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+/*---------------------------------------------------------------------------*/
+/* SHA-256 internal context */
+static sha_256_context_t ctx;
+static int initialized = 0;
+
+/*---------------------------------------------------------------------------*/
+/* Helper macros for SHA-256 */
+#define ROTRIGHT(a, b) (((a) >> (b)) | ((a) << (32 - (b))))
+#define CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define EP0(x) (ROTRIGHT(x, 2) ^ ROTRIGHT(x, 13) ^ ROTRIGHT(x, 22))
+#define EP1(x) (ROTRIGHT(x, 6) ^ ROTRIGHT(x, 11) ^ ROTRIGHT(x, 25))
+#define SIG0(x) (ROTRIGHT(x, 7) ^ ROTRIGHT(x, 18) ^ ((x) >> 3))
+#define SIG1(x) (ROTRIGHT(x, 17) ^ ROTRIGHT(x, 19) ^ ((x) >> 10))
+
+/*---------------------------------------------------------------------------*/
+/* Process a single block */
+static void
+sha_256_process_block(const uint8_t *data)
+{
+  uint32_t a, b, c, d, e, f, g, h, t1, t2;
+  uint32_t W[64];
+  int i;
+
+  /* Prepare message schedule */
+  for(i = 0; i < 16; i++) {
+    W[i] = ((uint32_t)data[4*i] << 24) |
+           ((uint32_t)data[4*i+1] << 16) |
+           ((uint32_t)data[4*i+2] << 8) |
+           ((uint32_t)data[4*i+3]);
+  }
+
+  for(i = 16; i < 64; i++) {
+    W[i] = SIG1(W[i-2]) + W[i-7] + SIG0(W[i-15]) + W[i-16];
+  }
+
+  /* Initialize working variables */
+  a = ctx.state[0];
+  b = ctx.state[1];
+  c = ctx.state[2];
+  d = ctx.state[3];
+  e = ctx.state[4];
+  f = ctx.state[5];
+  g = ctx.state[6];
+  h = ctx.state[7];
+
+  /* Main loop */
+  for(i = 0; i < 64; i++) {
+    t1 = h + EP1(e) + CH(e, f, g) + K[i] + W[i];
+    t2 = EP0(a) + MAJ(a, b, c);
+    h = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+
+  /* Update state */
+  ctx.state[0] += a;
+  ctx.state[1] += b;
+  ctx.state[2] += c;
+  ctx.state[3] += d;
+  ctx.state[4] += e;
+  ctx.state[5] += f;
+  ctx.state[6] += g;
+  ctx.state[7] += h;
+}
+
+/*---------------------------------------------------------------------------*/
+/* Initialize the SHA-256 context */
+static void
+sha_256_init(void)
+{
+  ctx.state[0] = 0x6a09e667;
+  ctx.state[1] = 0xbb67ae85;
+  ctx.state[2] = 0x3c6ef372;
+  ctx.state[3] = 0xa54ff53a;
+  ctx.state[4] = 0x510e527f;
+  ctx.state[5] = 0x9b05688c;
+  ctx.state[6] = 0x1f83d9ab;
+  ctx.state[7] = 0x5be0cd19;
+  ctx.length = 0;
+  ctx.buflen = 0;
+  initialized = 1;
+}
+
+/*---------------------------------------------------------------------------*/
+/* Update the hash with new data */
+static void
+sha_256_update(const uint8_t *data, size_t len)
+{
+  size_t i;
+
+  if(!initialized) {
+    sha_256_init();
+  }
+
+  for(i = 0; i < len; i++) {
+    ctx.buffer[ctx.buflen++] = data[i];
+    ctx.length += 8;
+
+    if(ctx.buflen == SHA_256_BLOCK_SIZE) {
+      sha_256_process_block(ctx.buffer);
+      ctx.buflen = 0;
+    }
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+/* Pad the message and finalize */
+static void
+sha_256_finalize(uint8_t digest[SHA_256_DIGEST_LENGTH])
+{
+  size_t i = ctx.buflen;
+
+  if(!initialized) {
+    sha_256_init();
+  }
+
+  /* Pad the message */
+  if(i < 56) {
+    ctx.buffer[i++] = 0x80;
+    while(i < 56) ctx.buffer[i++] = 0x00;
+  } else {
+    ctx.buffer[i++] = 0x80;
+    while(i < SHA_256_BLOCK_SIZE) ctx.buffer[i++] = 0x00;
+    sha_256_process_block(ctx.buffer);
+    memset(ctx.buffer, 0, 56);
+    i = 56;
+  }
+
+  /* Append the length in bits */
+  uint64_t bit_len = ctx.length;
+  for(int j = 7; j >= 0; j--) {
+    ctx.buffer[i++] = (bit_len >> (j * 8)) & 0xff;
+  }
+
+  sha_256_process_block(ctx.buffer);
+
+  /* Output the digest */
+  for(i = 0; i < SHA_256_DIGEST_LENGTH / 4; i++) {
+    digest[4*i] = (ctx.state[i] >> 24) & 0xff;
+    digest[4*i+1] = (ctx.state[i] >> 16) & 0xff;
+    digest[4*i+2] = (ctx.state[i] >> 8) & 0xff;
+    digest[4*i+3] = ctx.state[i] & 0xff;
+  }
+
+  initialized = 0;
+}
+
+/*---------------------------------------------------------------------------*/
+/* Create a checkpoint of the current hash state */
+static void
+sha_256_create_checkpoint(sha_256_checkpoint_t *cp)
+{
+  if(!initialized) {
+    sha_256_init();
+  }
+
+  memcpy(cp->state, ctx.state, sizeof(ctx.state));
+  cp->length = ctx.length;
+  memcpy(cp->buffer, ctx.buffer, sizeof(ctx.buffer));
+  cp->buflen = ctx.buflen;
+}
+
+/*---------------------------------------------------------------------------*/
+/* Restore a previously saved checkpoint */
+static void
+sha_256_restore_checkpoint(const sha_256_checkpoint_t *cp)
+{
+  memcpy(ctx.state, cp->state, sizeof(ctx.state));
+  ctx.length = cp->length;
+  memcpy(ctx.buffer, cp->buffer, sizeof(ctx.buffer));
+  ctx.buflen = cp->buflen;
+  initialized = 1;
+}
+
+/*---------------------------------------------------------------------------*/
+/* One-shot hash function */
+static void
+sha_256_hash_driver(const uint8_t *data, size_t len, uint8_t digest[SHA_256_DIGEST_LENGTH])
+{
+  /* Save current context */
+  int was_initialized = initialized;
+  sha_256_context_t saved_ctx;
+  if(was_initialized) {
+    memcpy(saved_ctx.state, ctx.state, sizeof(ctx.state));
+    saved_ctx.length = ctx.length;
+    memcpy(saved_ctx.buffer, ctx.buffer, sizeof(ctx.buffer));
+    saved_ctx.buflen = ctx.buflen;
+  }
+
+  /* Initialize fresh */
+  ctx.state[0] = 0x6a09e667;
+  ctx.state[1] = 0xbb67ae85;
+  ctx.state[2] = 0x3c6ef372;
+  ctx.state[3] = 0xa54ff53a;
+  ctx.state[4] = 0x510e527f;
+  ctx.state[5] = 0x9b05688c;
+  ctx.state[6] = 0x1f83d9ab;
+  ctx.state[7] = 0x5be0cd19;
+  ctx.length = 0;
+  ctx.buflen = 0;
+  initialized = 1;
+
+  sha_256_update(data, len);
+  sha_256_finalize(digest);
+
+  /* Restore context if it was initialized */
+  if(was_initialized) {
+    memcpy(ctx.state, saved_ctx.state, sizeof(ctx.state));
+    ctx.length = saved_ctx.length;
+    memcpy(ctx.buffer, saved_ctx.buffer, sizeof(ctx.buffer));
+    ctx.buflen = saved_ctx.buflen;
+  } else {
+    initialized = 0;
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+/* Global SHA-256 driver instance */
+const sha_256_driver_t SHA_256 = {
+  sha_256_init,
+  sha_256_update,
+  sha_256_finalize,
+  sha_256_create_checkpoint,
+  sha_256_restore_checkpoint,
+  sha_256_hash_driver
+};
+
+/*---------------------------------------------------------------------------*/
+/* Public one-shot hash function */
+void
+sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[SHA_256_DIGEST_LENGTH])
+{
+  SHA_256.hash(data, len, digest);
+}
+
+/*---------------------------------------------------------------------------*/
+/* HMAC-SHA-256 (RFC 2104) */
+void
+sha_256_hmac(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t hmac[SHA_256_DIGEST_LENGTH])
+{
+  uint8_t key_block[SHA_256_BLOCK_SIZE];
+  uint8_t inner_hash[SHA_256_DIGEST_LENGTH];
+  uint8_t buffer[SHA_256_BLOCK_SIZE + SHA_256_DIGEST_LENGTH];
+  size_t i;
+
+  /* If key is longer than block size, hash it */
+  if(key_len > SHA_256_BLOCK_SIZE) {
+    SHA_256.hash(key, key_len, key_block);
+    key_len = SHA_256_DIGEST_LENGTH;
+  } else {
+    memcpy(key_block, key, key_len);
+  }
+
+  /* Pad key with zeros */
+  for(i = key_len; i < SHA_256_BLOCK_SIZE; i++) {
+    key_block[i] = 0;
+  }
+
+  /* Compute inner hash: H(K XOR ipad || data) */
+  for(i = 0; i < SHA_256_BLOCK_SIZE; i++) {
+    buffer[i] = key_block[i] ^ 0x36;
+  }
+  memcpy(buffer + SHA_256_BLOCK_SIZE, data, data_len);
+  SHA_256.hash(buffer, SHA_256_BLOCK_SIZE + data_len, inner_hash);
+
+  /* Compute outer hash: H(K XOR opad || inner_hash) */
+  for(i = 0; i < SHA_256_BLOCK_SIZE; i++) {
+    buffer[i] = key_block[i] ^ 0x5c;
+  }
+  memcpy(buffer + SHA_256_BLOCK_SIZE, inner_hash, SHA_256_DIGEST_LENGTH);
+  SHA_256.hash(buffer, SHA_256_BLOCK_SIZE + SHA_256_DIGEST_LENGTH, hmac);
+}
+
+/*---------------------------------------------------------------------------*/
+/* HKDF extract (RFC 5869) */
+void
+sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len, const uint8_t *ikm, size_t ikm_len, uint8_t prk[SHA_256_DIGEST_LENGTH])
+{
+  /* If salt is empty, use a zero-filled key of digest length */
+  uint8_t zero_key[SHA_256_DIGEST_LENGTH] = {0};
+  const uint8_t *salt_key = (salt_len > 0) ? salt : zero_key;
+  size_t salt_key_len = (salt_len > 0) ? salt_len : SHA_256_DIGEST_LENGTH;
+
+  sha_256_hmac(salt_key, salt_key_len, ikm, ikm_len, prk);
+}
+
+/*---------------------------------------------------------------------------*/
+/* HKDF expand (RFC 5869) */
+void
+sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len, const uint8_t *info, size_t info_len, uint8_t *okm, uint_fast16_t okm_len)
+{
+  uint8_t buffer[SHA_256_BLOCK_SIZE];
+  uint8_t T[SHA_256_DIGEST_LENGTH];
+  uint_fast16_t i = 0;
+  uint_fast16_t n = (okm_len + SHA_256_DIGEST_LENGTH - 1) / SHA_256_DIGEST_LENGTH;
+  uint_fast16_t t_len = 0;
+
+  for(i = 1; i <= n; i++) {
+    uint8_t counter = (uint8_t)i;
+    size_t buffer_len = 0;
+    
+    /* T(i) = T(i-1) || counter || info */
+    if(t_len > 0) {
+      memcpy(buffer, T, t_len);
+      buffer_len = t_len;
+    }
+    buffer[buffer_len] = counter;
+    buffer_len++;
+    memcpy(buffer + buffer_len, info, info_len);
+    buffer_len += info_len;
+
+    sha_256_hmac(prk, prk_len, buffer, buffer_len, T);
+
+    memcpy(okm + (i-1) * SHA_256_DIGEST_LENGTH, T, 
+           MIN(SHA_256_DIGEST_LENGTH, okm_len - (i-1) * SHA_256_DIGEST_LENGTH));
+
+    t_len = SHA_256_DIGEST_LENGTH;
+  }
+}
+
+/** @} */

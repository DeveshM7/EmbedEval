+/**
+ * \addtogroup lib
+ * @{
+ */
+
+/**
+ * \defgroup sha256 SHA-256 cryptographic hash
+ *
+ * This module provides SHA-256 hash, HMAC-SHA-256, and HKDF (RFC 5869)
+ * implementations.
+ *
+ * @{
+ *
+ * \file
+ *         Header file for the SHA-256 library
+ */
+
+#ifndef SHA_256_H_
+#define SHA_256_H_
+
+#include "contiki.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+/*---------------------------------------------------------------------------*/
+/** \brief SHA-256 digest length in bytes (32) */
+#define SHA_256_DIGEST_LENGTH 32
+
+/** \brief SHA-256 block size in bytes (64) */
+#define SHA_256_BLOCK_SIZE 64
+
+/*---------------------------------------------------------------------------*/
+/** \brief SHA-256 internal state structure */
+typedef struct {
+  uint32_t state[8];     /**< Current hash state */
+  uint64_t length;       /**< Total message length in bits */
+  uint8_t  buffer[64];   /**< Input buffer */
+  size_t   buflen;       /**< Current buffer length */
+} sha_256_context_t;
+
+/** \brief SHA-256 checkpoint type */
+typedef struct {
+  uint32_t state[8];
+  uint64_t length;
+  uint8_t  buffer[64];
+  size_t   buflen;
+} sha_256_checkpoint_t;
+
+/*---------------------------------------------------------------------------*/
+/** \brief SHA-256 driver structure */
+typedef struct {
+  /** \brief Initialize the SHA-256 context */
+  void (*init)(void);
+  /** \brief Update the hash with new data */
+  void (*update)(const uint8_t *data, size_t len);
+  /** \brief Finalize the hash and get the digest */
+  void (*finalize)(uint8_t digest[SHA_256_DIGEST_LENGTH]);
+  /** \brief Create a checkpoint of the current hash state */
+  void (*create_checkpoint)(sha_256_checkpoint_t *cp);
+  /** \brief Restore a previously saved checkpoint */
+  void (*restore_checkpoint)(const sha_256_checkpoint_t *cp);
+  /** \brief Compute hash of the data in one go */
+  void (*hash)(const uint8_t *data, size_t len, uint8_t digest[SHA_256_DIGEST_LENGTH]);
+} sha_256_driver_t;
+
+/*---------------------------------------------------------------------------*/
+/** \brief SHA-256 one-shot hash function */
+void sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[SHA_256_DIGEST_LENGTH]);
+
+/** \brief HMAC-SHA-256 function (RFC 2104) */
+void sha_256_hmac(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t hmac[SHA_256_DIGEST_LENGTH]);
+
+/** \brief HKDF extract function (RFC 5869) */
+void sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len, const uint8_t *ikm, size_t ikm_len, uint8_t prk[SHA_256_DIGEST_LENGTH]);
+
+/** \brief HKDF expand function (RFC 5869) */
+void sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len, const uint8_t *info, size_t info_len, uint8_t *okm, uint_fast16_t okm_len);
+
+/*---------------------------------------------------------------------------*/
+/** \brief Global SHA-256 driver instance */
+extern const sha_256_driver_t SHA_256;
+
+#endif /* SHA_256_H_ */
+
+/**
+ * @}
+ * @}
+ */
diff --git a/test-hmac-debug.c b/test-hmac-debug.c
new file mode 100644
index 0000000..a197f2e
--- /dev/null
+++ b/test-hmac-debug.c
@@ -0,0 +1,32 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#define SHA_256_DIGEST_LENGTH 32
+#define SHA_256_BLOCK_SIZE 64
+
+/* Include the header from the library */
+extern void sha_256_hmac(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t hmac[SHA_256_DIGEST_LENGTH]);
+extern void sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len, const uint8_t *ikm, size_t ikm_len, uint8_t prk[SHA_256_DIGEST_LENGTH]);
+extern void sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len, const uint8_t *info, size_t info_len, uint8_t *okm, uint_fast16_t okm_len);
+
+/* Simple test for HMAC */
+int main() {
+  uint8_t hmac[SHA_256_DIGEST_LENGTH];
+  const uint8_t key[] = "Jefe";
+  const uint8_t data[] = "what do ya want for nothing?";
+  
+  printf("Testing HMAC-SHA-256...\n");
+  printf("Key: '%s'\n", key);
+  printf("Data: '%s'\n", data);
+  
+  sha_256_hmac(key, strlen((const char *)key), data, strlen((const char *)data), hmac);
+  
+  printf("HMAC: ");
+  for(int i = 0; i < SHA_256_DIGEST_LENGTH; i++) {
+    printf("%02x", hmac[i]);
+  }
+  printf("\n");
+  
+  return 0;
+}

diff --git a/test-sha256-debug2.c b/test-sha256-debug2.c
new file mode 100644
index 0000000..7327937
--- /dev/null
+++ b/test-sha256-debug2.c
@@ -0,0 +1,184 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#define SHA_256_DIGEST_LENGTH 32
+#define SHA_256_BLOCK_SIZE 64
+
+static const uint32_t K[64] = {
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+typedef struct {
+  uint32_t state[8];
+  uint64_t length;
+  uint8_t buffer[64];
+  size_t buflen;
+} sha_256_context_t;
+
+#define ROTRIGHT(a, b) (((a) >> (b)) | ((a) << (32 - (b))))
+#define CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define EP0(x) (ROTRIGHT(x, 2) ^ ROTRIGHT(x, 13) ^ ROTRIGHT(x, 22))
+#define EP1(x) (ROTRIGHT(x, 6) ^ ROTRIGHT(x, 11) ^ ROTRIGHT(x, 25))
+#define SIG0(x) (ROTRIGHT(x, 7) ^ ROTRIGHT(x, 18) ^ ((x) >> 3))
+#define SIG1(x) (ROTRIGHT(x, 17) ^ ROTRIGHT(x, 19) ^ ((x) >> 10))
+
+static void sha_256_init(sha_256_context_t *ctx) {
+  ctx->state[0] = 0x6a09e667;
+  ctx->state[1] = 0xbb67ae85;
+  ctx->state[2] = 0x3c6ef372;
+  ctx->state[3] = 0xa54ff53a;
+  ctx->state[4] = 0x510e527f;
+  ctx->state[5] = 0x9b05688c;
+  ctx->state[6] = 0x1f83d9ab;
+  ctx->state[7] = 0x5be0cd19;
+  ctx->length = 0;
+  ctx->buflen = 0;
+}
+
+static void sha_256_process_block(sha_256_context_t *ctx, const uint8_t *data) {
+  uint32_t a, b, c, d, e, f, g, h, t1, t2;
+  uint32_t W[64];
+  int i;
+
+  /* Prepare message schedule */
+  for(i = 0; i < 16; i++) {
+    W[i] = ((uint32_t)data[4*i] << 24) |
+           ((uint32_t)data[4*i+1] << 16) |
+           ((uint32_t)data[4*i+2] << 8) |
+           ((uint32_t)data[4*i+3]);
+  }
+
+  for(i = 16; i < 64; i++) {
+    W[i] = SIG1(W[i-2]) + W[i-7] + SIG0(W[i-15]) + W[i-16];
+  }
+
+  /* Initialize working variables */
+  a = ctx->state[0];
+  b = ctx->state[1];
+  c = ctx->state[2];
+  d = ctx->state[3];
+  e = ctx->state[4];
+  f = ctx->state[5];
+  g = ctx->state[6];
+  h = ctx->state[7];
+
+  /* Main loop */
+  for(i = 0; i < 64; i++) {
+    t1 = h + EP1(e) + CH(e, f, g) + K[i] + W[i];
+    t2 = EP0(a) + MAJ(a, b, c);
+    h = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+
+  /* Update state */
+  ctx->state[0] += a;
+  ctx->state[1] += b;
+  ctx->state[2] += c;
+  ctx->state[3] += d;
+  ctx->state[4] += e;
+  ctx->state[5] += f;
+  ctx->state[6] += g;
+  ctx->state[7] += h;
+}
+
+static void sha_256_update(sha_256_context_t *ctx, const uint8_t *data, size_t len) {
+  while(len > 0) {
+    size_t chunk = (len < 64 - ctx->buflen) ? len : 64 - ctx->buflen;
+    memcpy(ctx->buffer + ctx->buflen, data, chunk);
+    ctx->buflen += chunk;
+    data += chunk;
+    len -= chunk;
+
+    if(ctx->buflen == 64) {
+      sha_256_process_block(ctx, ctx->buffer);
+      ctx->buflen = 0;
+    }
+  }
+}
+
+static void sha_256_finalize(sha_256_context_t *ctx, uint8_t digest[SHA_256_DIGEST_LENGTH]) {
+  uint8_t padding[64];
+  uint64_t length_bits;
+  int i;
+
+  /* Pad with 0x80 followed by zeros */
+  padding[0] = 0x80;
+  for(i = 1; i < 64; i++) {
+    padding[i] = 0;
+  }
+
+  /* Check if we need one or two padding blocks */
+  if(ctx->buflen < 56) {
+    /* Single padding block */
+    sha_256_update(ctx, padding, 56 - ctx->buflen);
+  } else {
+    /* Two padding blocks */
+    sha_256_update(ctx, padding, 64 - ctx->buflen);
+    /* Second block of zeros */
+    memset(padding, 0, 64);
+    sha_256_update(ctx, padding, 56);
+  }
+
+  /* Append length in bits (big-endian) */
+  length_bits = ctx->length;
+  for(i = 7; i >= 0; i--) {
+    padding[i] = length_bits & 0xff;
+    length_bits >>= 8;
+  }
+  sha_256_update(ctx, padding, 8);
+
+  /* Output the digest */
+  for(i = 0; i < 8; i++) {
+    digest[4*i] = (ctx->state[i] >> 24) & 0xff;
+    digest[4*i+1] = (ctx->state[i] >> 16) & 0xff;
+    digest[4*i+2] = (ctx->state[i] >> 8) & 0xff;
+    digest[4*i+3] = ctx->state[i] & 0xff;
+  }
+}
+
+static void sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[SHA_256_DIGEST_LENGTH]) {
+  sha_256_context_t ctx;
+  sha_256_init(&ctx);
+  sha_256_update(&ctx, data, len);
+  sha_256_finalize(&ctx, digest);
+}
+
+int main() {
+  uint8_t digest[SHA_256_DIGEST_LENGTH];
+  const char *test = "abc";
+  
+  printf("Expected hash: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n");
+  
+  sha_256_hash((const uint8_t *)test, strlen(test), digest);
+  
+  printf("Got hash:      ");
+  for(int i = 0; i < SHA_256_DIGEST_LENGTH; i++) {
+    printf("%02x", digest[i]);
+  }
+  printf("\n");
+  
+  return 0;
+}

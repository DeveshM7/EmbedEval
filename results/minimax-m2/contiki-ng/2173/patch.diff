+
+/**
+ * \brief       Obtain the minimum alignment for allocated addresses.
+ * \return      The alignment value as a power-of-two size_t.
+ *
+ * This function returns the alignment guarantee for all pointers returned
+ * by heapmem_alloc() and heapmem_realloc(). The returned value is always
+ * a non-zero power of two. Consumers can use this to verify that their
+ * allocations satisfy the module's alignment requirements.
+ *
+ * \sa         heapmem_alloc
+ * \sa         heapmem_realloc
+ */
+
+size_t heapmem_alignment(void);

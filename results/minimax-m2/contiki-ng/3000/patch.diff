+/**
+ * \addtogroup cbor
+ * @{
+ * \file
+ *         CBOR (Concise Binary Object Representation) API.
+ * \author
+ *         CBOR Library Implementation
+ */
+
+#ifndef CBOR_H_
+#define CBOR_H_
+
+#include "contiki.h"
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+/* CBOR Major Types */
+#define CBOR_MAJOR_TYPE_ARRAY   4
+#define CBOR_MAJOR_TYPE_BYTE_STRING  2
+#define CBOR_MAJOR_TYPE_UNSIGNED_INTEGER 0
+
+/* CBOR helper values */
+#define CBOR_SIZE_NONE  ((size_t)-1)
+
+/**
+ * \brief CBOR major type enumeration
+ */
+typedef uint8_t cbor_major_type_t;
+
+/**
+ * \brief Opaque CBOR writer state type
+ */
+typedef struct {
+  uint8_t *buffer;
+  size_t buffer_size;
+  size_t bytes_written;
+  uint8_t array_depth;
+} cbor_writer_state_t;
+
+/**
+ * \brief Opaque CBOR reader state type
+ */
+typedef struct {
+  const uint8_t *cbor;
+  size_t cbor_size;
+  size_t offset;
+} cbor_reader_state_t;
+
+/**
+ * \brief Initialize a CBOR writer state
+ * \param state Pointer to writer state
+ * \param buffer Buffer to write CBOR data to
+ * \param buffer_size Size of the buffer
+ *
+ * This function initializes the writer state and makes it ready for use.
+ * The caller does not need to pre-zero the state structure.
+ */
+void cbor_init_writer(cbor_writer_state_t *state, uint8_t *buffer, size_t buffer_size);
+
+/**
+ * \brief Open a CBOR array
+ * \param state Pointer to writer state
+ */
+void cbor_open_array(cbor_writer_state_t *state);
+
+/**
+ * \brief Write a byte string to CBOR buffer
+ * \param state Pointer to writer state
+ * \param data Pointer to data to write
+ * \param data_size Size of data to write
+ */
+void cbor_write_data(cbor_writer_state_t *state, const uint8_t *data, size_t data_size);
+
+/**
+ * \brief Write an unsigned integer to CBOR buffer
+ * \param state Pointer to writer state
+ * \param value Unsigned integer value to write
+ */
+void cbor_write_unsigned(cbor_writer_state_t *state, uint64_t value);
+
+/**
+ * \brief Close a CBOR array
+ * \param state Pointer to writer state
+ */
+void cbor_close_array(cbor_writer_state_t *state);
+
+/**
+ * \brief Finalize CBOR writing
+ * \param state Pointer to writer state
+ * \return Number of bytes written, or 0 on failure
+ */
+size_t cbor_end_writer(cbor_writer_state_t *state);
+
+/**
+ * \brief Initialize a CBOR reader state
+ * \param state Pointer to reader state
+ * \param cbor Pointer to CBOR data
+ * \param cbor_size Size of CBOR data
+ *
+ * This function initializes the reader state and makes it ready for use.
+ * The caller does not need to pre-zero the state structure.
+ */
+void cbor_init_reader(cbor_reader_state_t *state, const uint8_t *cbor, size_t cbor_size);
+
+/**
+ * \brief Peek at the next CBOR item type
+ * \param state Pointer to reader state
+ * \return The major type of the next CBOR item
+ */
+cbor_major_type_t cbor_peek_next(cbor_reader_state_t *state);
+
+/**
+ * \brief Read a CBOR array header
+ * \param state Pointer to reader state
+ * \return Number of elements in the array, or CBOR_SIZE_NONE on error
+ */
+size_t cbor_read_array(cbor_reader_state_t *state);
+
+/**
+ * \brief Read a byte string from CBOR data
+ * \param state Pointer to reader state
+ * \param data_size Pointer to store the size of the byte string
+ * \return Pointer to the byte string data, or NULL on error
+ */
+const uint8_t *cbor_read_data(cbor_reader_state_t *state, size_t *data_size);
+
+/**
+ * \brief Read an unsigned integer from CBOR data
+ * \param state Pointer to reader state
+ * \param value Pointer to store the unsigned integer value
+ * \return CBOR_SIZE_NONE on error, or the number of bytes consumed on success
+ */
+size_t cbor_read_unsigned(cbor_reader_state_t *state, uint64_t *value);
+
+/**
+ * \brief Check if CBOR reading is complete
+ * \param state Pointer to reader state
+ * \return true if all bytes have been consumed, false otherwise
+ */
+bool cbor_end_reader(cbor_reader_state_t *state);
+
+#endif /* CBOR_H_ */

+#ifndef CYCLES_H_
+#define CYCLES_H_
+
+#include "contiki.h"
+
+/*---------------------------------------------------------------------------*/
+/* Core frequency in cycles per second (default for hosted/native port: 1e9) */
+#ifdef CYCLES_CONF_HZ
+#define CYCLES_HZ CYCLES_CONF_HZ
+#else
+#define CYCLES_HZ ((uint32_t)1000000000U)
+#endif
+
+/*---------------------------------------------------------------------------*/
+/* Cycle counter type */
+typedef uint32_t cycles_t;
+
+/*---------------------------------------------------------------------------*/
+/**
+ * Get the current cycle count.
+ *
+ * This function returns the current value of the cycle counter.
+ * Before cycles_start() is called, this returns 0.
+ * After cycles_stop() is called, this returns the frozen value.
+ *
+ * \return The current cycle count.
+ */
+cycles_t cycles_now(void);
+
+/**
+ * Start the cycle counter.
+ *
+ * This function starts the cycle counter. It is idempotent - calling
+ * it multiple times has the same effect as calling it once. If the
+ * counter is already running, it is not disturbed.
+ */
+void cycles_start(void);
+
+/**
+ * Stop the cycle counter.
+ *
+ * This function stops the cycle counter and freezes the reading.
+ * Subsequent calls to cycles_now() will return the same value
+ * until cycles_start() is called again.
+ */
+void cycles_stop(void);
+
+/*---------------------------------------------------------------------------*/
+/**
+ * Convert cycles to whole microseconds.
+ *
+ * This macro converts a cycle count to whole microseconds.
+ *
+ * \param cycles The cycle count to convert.
+ * \return The number of whole microseconds.
+ */
+#define CYCLES_TO_US(cycles) ((uint32_t)((cycles) / (CYCLES_HZ / 1000000U)))
+
+/**
+ * Convert cycles to fractional microseconds (hundredths).
+ *
+ * This macro converts a cycle count to hundredths of a microsecond.
+ * It returns the fractional part (0-99 hundredths of a microsecond).
+ *
+ * \param cycles The cycle count to convert.
+ * \return The number of hundredths of a microsecond (0-99).
+ */
+#define CYCLES_TO_US_FRAC(cycles) \
+  ((uint32_t)(((cycles) % (CYCLES_HZ / 1000000U)) * 100U / (CYCLES_HZ / 1000000U)))
+
+/*---------------------------------------------------------------------------*/
+
+#endif /* CYCLES_H_ */

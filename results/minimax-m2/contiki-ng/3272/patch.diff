+#include "sys/cycles.h"
+#include <time.h>
+#include <sys/time.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/*---------------------------------------------------------------------------*/
+static volatile uint32_t cycle_counter = 0;
+static volatile uint32_t start_time_ns = 0;
+static volatile int is_running = 0;
+/*---------------------------------------------------------------------------*/
+static uint32_t
+get_time_ns(void)
+{
+#if defined(__linux__) || (defined(__MACH__) && __MAC_OS_X_VERSION_MIN_REQUIRED >= 101200)
+  struct timespec ts;
+
+  if(clock_gettime(CLOCK_MONOTONIC, &ts) == -1) {
+    return 0;
+  }
+
+  return (uint32_t)(ts.tv_sec) * 1000000000U + (uint32_t)(ts.tv_nsec);
+#else
+  struct timeval tv;
+
+  if(gettimeofday(&tv, NULL) == -1) {
+    return 0;
+  }
+
+  return (uint32_t)(tv.tv_sec) * 1000000000U + (uint32_t)(tv.tv_usec) * 1000U;
+#endif
+}
+/*---------------------------------------------------------------------------*/
+cycles_t
+cycles_now(void)
+{
+  if(!is_running) {
+    return cycle_counter;
+  }
+
+  uint32_t elapsed_ns = get_time_ns() - start_time_ns;
+  return cycle_counter + elapsed_ns;
+}
+/*---------------------------------------------------------------------------*/
+void
+cycles_start(void)
+{
+  if(is_running) {
+    /* Already running, idempotent - do nothing */
+    return;
+  }
+
+  if(cycle_counter == 0) {
+    /* First start - initialize start time */
+    start_time_ns = get_time_ns();
+  }
+
+  is_running = 1;
+}
+/*---------------------------------------------------------------------------*/
+void
+cycles_stop(void)
+{
+  if(!is_running) {
+    /* Already stopped, do nothing */
+    return;
+  }
+
+  /* Freeze the counter at the current value */
+  cycle_counter = cycles_now();
+  is_running = 0;
+}
+/*---------------------------------------------------------------------------*/

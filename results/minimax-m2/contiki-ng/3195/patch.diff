diff --git a/os/lib/cbor.c b/os/lib/cbor.c
index 5f71c91..b1b2216 100644
--- a/os/lib/cbor.c
+++ b/os/lib/cbor.c
@@ -465,5 +465,180 @@ cbor_read_map(cbor_reader_state_t *state)
   return read_array_or_map(state);
 }
 /*---------------------------------------------------------------------------*/
+/*---------------------------------------------------------------------------*/
+const uint8_t *
+cbor_get_position(cbor_reader_state_t *state)
+{
+  return state->cbor;
+}
+/*---------------------------------------------------------------------------*/
+size_t
+cbor_get_remaining(cbor_reader_state_t *state)
+{
+  return state->cbor_size;
+}
+/*---------------------------------------------------------------------------*/
+static bool
+skip_unsigned(cbor_reader_state_t *state, uint64_t *value)
+{
+  if(!state->cbor_size) {
+    return false;
+  }
+  cbor_size_t size = *state->cbor & ~0xE0;
+  state->cbor++;
+  state->cbor_size--;
 
-/** @} */
+  if(size < CBOR_SIZE_1) {
+    *value = size;
+    return true;
+  }
+
+  size_t bytes_to_read;
+  switch(size) {
+  case CBOR_SIZE_1:
+    bytes_to_read = 1;
+    break;
+  case CBOR_SIZE_2:
+    bytes_to_read = 2;
+    break;
+  case CBOR_SIZE_4:
+    bytes_to_read = 4;
+    break;
+  case CBOR_SIZE_8:
+    bytes_to_read = 8;
+    break;
+  default:
+    return false;
+  }
+
+  if(bytes_to_read > state->cbor_size) {
+    return false;
+  }
+
+  *value = 0;
+  while(bytes_to_read--) {
+    *value <<= 8;
+    *value += *state->cbor++;
+    state->cbor_size--;
+  }
+  return true;
+}
+/*---------------------------------------------------------------------------*/
+bool
+cbor_skip_next(cbor_reader_state_t *state)
+{
+  uint64_t value;
+  cbor_major_type_t type;
+  cbor_size_t size;
+
+  if(!state->cbor_size) {
+    return false;
+  }
+
+  /* Check for break stop code (0xFF) */
+  if(*state->cbor == 0xFF) {
+    return false;
+  }
+
+  /* Check for reserved additional information values */
+  uint8_t additional_info = *state->cbor & ~0xE0;
+  
+  /* Additional info values 28-31 (0x1C-0x1F) are reserved */
+  if(additional_info >= 0x1C) {
+    return false;
+  }
+
+  type = *state->cbor & 0xE0;
+
+  switch(type) {
+  case CBOR_MAJOR_TYPE_UNSIGNED:
+  case CBOR_MAJOR_TYPE_SIGNED:
+    return skip_unsigned(state, &value);
+
+  case CBOR_MAJOR_TYPE_BYTE_STRING:
+  case CBOR_MAJOR_TYPE_TEXT_STRING:
+    /* Read length and skip that many bytes */
+    size = skip_unsigned(state, &value);
+    if(!size) {
+      return false;
+    }
+    /* Check if the string data is complete */
+    if(state->cbor_size < value) {
+      return false;
+    }
+    state->cbor += value;
+    state->cbor_size -= value;
+    return true;
+
+  case CBOR_MAJOR_TYPE_ARRAY:
+  case CBOR_MAJOR_TYPE_MAP:
+    /* Read count and skip that many items */
+    size = skip_unsigned(state, &value);
+    if(!size) {
+      return false;
+    }
+    /* Check for reasonable count to avoid infinite loops */
+    if(value > SIZE_MAX / (type == CBOR_MAJOR_TYPE_MAP ? 2 : 1)) {
+      return false;
+    }
+    size_t count = (size_t)value;
+    
+    /* For maps, each entry is a key-value pair, so we need to skip 2 * count items */
+    if(type == CBOR_MAJOR_TYPE_MAP) {
+      count = count * 2;
+    }
+    
+    /* Skip count items */
+    for(size_t i = 0; i < count; i++) {
+      if(!cbor_skip_next(state)) {
+        return false;
+      }
+    }
+    return true;
+
+  case CBOR_MAJOR_TYPE_SIMPLE:
+    /* Simple values are just one byte, but check if it's a float or break */
+    additional_info = *state->cbor & ~0xE0;
+    
+    /* Check for break stop code (already checked above) */
+    if(additional_info == 0x1F) {
+      return false;
+    }
+    
+    /* Check for float encoded in additional info */
+    if(additional_info == 0x19) {
+      /* Half-precision float (16 bits) */
+      if(state->cbor_size < 2) {
+        return false;
+      }
+      state->cbor += 2;
+      state->cbor_size -= 2;
+      return true;
+    } else if(additional_info == 0x1A) {
+      /* Single-precision float (32 bits) */
+      if(state->cbor_size < 4) {
+        return false;
+      }
+      state->cbor += 4;
+      state->cbor_size -= 4;
+      return true;
+    } else if(additional_info == 0x1B) {
+      /* Double-precision float (64 bits) */
+      if(state->cbor_size < 8) {
+        return false;
+      }
+      state->cbor += 8;
+      state->cbor_size -= 8;
+      return true;
+    }
+    
+    /* One-byte simple value */
+    state->cbor++;
+    state->cbor_size--;
+    return true;
+
+  default:
+    return false;
+  }
+}
+/*---------------------------------------------------------------------------*/
diff --git a/os/lib/cbor.h b/os/lib/cbor.h
index a3fe9e6..b9b8ab1 100644
--- a/os/lib/cbor.h

 /** @} */
 
 #endif /* CBOR_H_ */
+
+/**
+ * Returns the current position in the input buffer.
+ *
+ * \param state State of the CBOR reader.
+ *
+ * \return      Pointer to the current position in the input buffer.
+ */
+const uint8_t *cbor_get_position(cbor_reader_state_t *state);
+
+/**
+ * Returns the number of input bytes not yet consumed.
+ *
+ * \param state State of the CBOR reader.
+ *
+ * \return      Number of remaining bytes.
+ */
+size_t cbor_get_remaining(cbor_reader_state_t *state);
+
+/**
+ * Skips the next complete CBOR data item.
+ *
+ * \param state State of the CBOR reader.
+ *
+ * \return      \c true if an item was skipped, or \c false otherwise.
+ */
+bool cbor_skip_next(cbor_reader_state_t *state);
+

+
+/* SFC32 PRNG state */
+static uint32_t sfc32_a, sfc32_b, sfc32_c;
+
+/* SFC32 PRNG implementation */
+static void sfc32_seed(uint64_t seed) {
+  sfc32_a = (uint32_t)(seed) + 0x9e3779b9UL;
+  sfc32_b = (uint32_t)(seed >> 32) + 0x243f6a88UL;
+  sfc32_c = 0x85ebca6bUL;
+}
+
+static uint_fast16_t sfc32_rand(void) {
+  uint32_t result = sfc32_a + sfc32_c;
+  sfc32_a = sfc32_b;
+  sfc32_b = sfc32_c;
+  sfc32_c = (sfc32_c << 26) | (sfc32_c >> 6);
+  sfc32_c ^= sfc32_b ^ (sfc32_b >> 2);
+  sfc32_c ^= sfc32_a ^ (sfc32_a >> 16);
+  sfc32_c += result;
+  return (uint_fast16_t)(result >> 16);
+}
+
+/* SFC16 PRNG state */
+static uint16_t sfc16_a, sfc16_b, sfc16_c;
+
+/* SFC16 PRNG implementation */
+static void sfc16_seed(uint64_t seed) {
+  sfc16_a = (uint16_t)(seed) + 0x9e37;
+  sfc16_b = (uint16_t)(seed >> 16) + 0x243f;
+  sfc16_c = (uint16_t)(seed >> 32) + 0x85eb;
+}
+
+static uint_fast16_t sfc16_rand(void) {
+  uint16_t result = sfc16_a + sfc16_c;
+  sfc16_a = sfc16_b;
+  sfc16_b = sfc16_c;
+  sfc16_c = (sfc16_c << 7) | (sfc16_c >> 9);
+  sfc16_c ^= sfc16_a ^ (sfc16_a >> 5);
+  sfc16_c ^= sfc16_b ^ (sfc16_b >> 1);
+  sfc16_c += result;
+  return (uint_fast16_t)result;
+}
+
+/* Export PRNG structures */
+const struct random_prng sfc32_prng = {
+  .seed = sfc32_seed,
+  .rand = sfc32_rand
+};
+
+const struct random_prng sfc16_prng = {
+  .seed = sfc16_seed,
+  .rand = sfc16_rand
+};

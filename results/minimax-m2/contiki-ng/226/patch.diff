+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE INSTITUTE OR CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifndef CIRCULAR_LIST_H_
+#define CIRCULAR_LIST_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include "lib/list.h"
+
+/**
+ * \file
+ * Circular singly-linked list library
+ * \author
+ */
+
+/**
+ * \addtogroup data-structures
+ * @{
+ */
+
+/**
+ * \defgroup circular_list Circular singly-linked list library
+ *
+ * The circular singly-linked list library provides circular list behavior.
+ * Elements are caller-allocated structs whose first field is a pointer
+ * named `next` which holds the link pointer.
+ *
+ * @{
+ */
+
+#define CIRCULAR_LIST_CONCAT2(s1, s2) s1##s2
+#define CIRCULAR_LIST_CONCAT(s1, s2) CIRCULAR_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a circular list.
+ *
+ * This macro declares a circular list with the specified name. The circular list
+ * variable is declared as static to make it easy to use in a single
+ * C module without unnecessarily exporting the name to other modules.
+ *
+ * \param name The name of the circular list.
+ */
+#define CIRCULAR_LIST(name) \
+    static void *CIRCULAR_LIST_CONCAT(name,_list) = NULL; \
+    static list_t name = (list_t)&CIRCULAR_LIST_CONCAT(name,_list)
+
+/**
+ * The circular list type.
+ */
+typedef list_t circular_list_t;
+
+/* Internal structure for circular singly-linked list */
+struct circular_list_elem {
+  struct circular_list_elem *next;
+};
+
+/* Circular list API */
+
+/**
+ * Initialize a circular list.
+ *
+ * This function initializes a circular list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The circular list to be initialized.
+ */
+static inline void
+circular_list_init(circular_list_t list)
+{
+  list_init(list);
+}
+
+/**
+ * Check if a circular list is empty.
+ *
+ * \param list The circular list.
+ * \return true if the circular list is empty, false otherwise.
+ */
+static inline bool
+circular_list_is_empty(circular_list_t list)
+{
+  return list_head(list) == NULL;
+}
+
+/**
+ * Get the length of a circular list.
+ *
+ * \param list The circular list.
+ * \return The length of the circular list.
+ */
+static inline unsigned long
+circular_list_length(circular_list_t list)
+{
+  return (unsigned long)list_length(list);
+}
+
+/**
+ * Get the head element of a circular list.
+ *
+ * \param list The circular list.
+ * \return A pointer to the head element, or NULL if the list is empty.
+ */
+static inline void *
+circular_list_head(circular_list_t list)
+{
+  return list_head(list);
+}
+
+/**
+ * Get the tail element of a circular list.
+ *
+ * \param list The circular list.
+ * \return A pointer to the tail element, or NULL if the list is empty.
+ */
+static inline void *
+circular_list_tail(circular_list_t list)
+{
+  void *tail;
+  
+  if(list_head(list) == NULL) {
+    return NULL;
+  }
+  
+  /* In a circular list, we need to find the element whose next points to head */
+  for(tail = list_head(list); 
+      ((struct circular_list_elem *)tail)->next != NULL && ((struct circular_list_elem *)tail)->next != list_head(list);
+      tail = ((struct circular_list_elem *)tail)->next);
+  
+  /* Handle single element case */
+  if(((struct circular_list_elem *)tail)->next == list_head(list)) {
+    return tail;
+  }
+  
+  return tail;
+}
+
+/**
+ * Add an element at the head of a circular list.
+ *
+ * If the element is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The circular list.
+ * \param item The element to add.
+ */
+static inline void
+circular_list_add(circular_list_t list, void *item)
+{
+  /* Remove first if already in list */
+  list_remove(list, item);
+  
+  /* Add at head */
+  list_push(list, item);
+  
+  /* Make it circular: if this is the only element, point to itself */
+  if(((struct circular_list_elem *)item)->next == NULL) {
+    ((struct circular_list_elem *)item)->next = item;
+  } else {
+    /* Find the tail and make it point to the new head */
+    void *tail = circular_list_tail(list);
+    if(tail != item) {
+      ((struct circular_list_elem *)tail)->next = item;
+    }
+  }
+}
+
+/**
+ * Remove an element from a circular list.
+ *
+ * \param list The circular list.
+ * \param item The element to remove.
+ */
+static inline void
+circular_list_remove(circular_list_t list, void *item)
+{
+  void *prev;
+  
+  if(list_head(list) == NULL) {
+    return;
+  }
+  
+  /* Find the previous element */
+  if(((struct circular_list_elem *)item)->next == item) {
+    /* Single element case - list will be empty after removal */
+    ((struct circular_list_elem *)item)->next = NULL;
+    list_remove(list, item);
+    return;
+  }
+  
+  /* Find the element before 'item' */
+  for(prev = list_head(list); 
+      prev != NULL && ((struct circular_list_elem *)prev)->next != item;
+      prev = ((struct circular_list_elem *)prev)->next);
+  
+  if(prev != NULL) {
+    ((struct circular_list_elem *)prev)->next = ((struct circular_list_elem *)item)->next;
+    ((struct circular_list_elem *)item)->next = NULL;
+  }
+}
+
+/** @} */
+/** @} */
+
+#endif /* CIRCULAR_LIST_H_ */

+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE INSTITUTE OR CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifndef DBL_LIST_H_
+#define DBL_LIST_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/**
+ * \file
+ * Doubly-linked list library
+ * \author
+ */
+
+/**
+ * \addtogroup data-structures
+ * @{
+ */
+
+/**
+ * \defgroup dbl_list Doubly-linked list library
+ *
+ * The doubly-linked list library provides doubly-linked list behavior.
+ * Elements are caller-allocated structs whose first field is a pointer
+ * named `next` and whose second field is a pointer named `previous`.
+ * These fields hold the link pointers.
+ *
+ * @{
+ */
+
+#define DBL_LIST_CONCAT2(s1, s2) s1##s2
+#define DBL_LIST_CONCAT(s1, s2) DBL_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a doubly-linked list.
+ *
+ * This macro declares a doubly-linked list with the specified name. The list
+ * variable is declared as static to make it easy to use in a single
+ * C module without unnecessarily exporting the name to other modules.
+ *
+ * \param name The name of the doubly-linked list.
+ */
+#define DBL_LIST(name) \
+    static void *DBL_LIST_CONCAT(name,_list) = NULL; \
+    static list_t name = (list_t)&DBL_LIST_CONCAT(name,_list)
+
+/**
+ * The doubly-linked list type.
+ */
+typedef list_t dbl_list_t;
+
+/* Internal structure for doubly-linked list */
+struct dbl_list_elem {
+  struct dbl_list_elem *next;
+  struct dbl_list_elem *previous;
+};
+
+/* Forward declarations */
+static inline void dbl_list_remove(dbl_list_t list, void *item);
+
+/* Doubly-linked list API */
+
+/**
+ * Initialize a doubly-linked list.
+ *
+ * This function initializes a doubly-linked list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The doubly-linked list to be initialized.
+ */
+static inline void
+dbl_list_init(dbl_list_t list)
+{
+  list_init(list);
+}
+
+/**
+ * Check if a doubly-linked list is empty.
+ *
+ * \param list The doubly-linked list.
+ * \return true if the doubly-linked list is empty, false otherwise.
+ */
+static inline bool
+dbl_list_is_empty(dbl_list_t list)
+{
+  return list_head(list) == NULL;
+}
+
+/**
+ * Get the length of a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \return The length of the doubly-linked list.
+ */
+static inline unsigned long
+dbl_list_length(dbl_list_t list)
+{
+  return (unsigned long)list_length(list);
+}
+
+/**
+ * Get the head element of a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \return A pointer to the head element, or NULL if the list is empty.
+ */
+static inline void *
+dbl_list_head(dbl_list_t list)
+{
+  return list_head(list);
+}
+
+/**
+ * Get the tail element of a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \return A pointer to the tail element, or NULL if the list is empty.
+ */
+static inline void *
+dbl_list_tail(dbl_list_t list)
+{
+  void *tail;
+  
+  if(list_head(list) == NULL) {
+    return NULL;
+  }
+  
+  /* Find the tail by traversing */
+  for(tail = list_head(list); 
+      ((struct dbl_list_elem *)tail)->next != NULL;
+      tail = ((struct dbl_list_elem *)tail)->next);
+  
+  return tail;
+}
+
+/**
+ * Add an element at the head of a doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param item The element to add.
+ */
+static inline void
+dbl_list_add_head(dbl_list_t list, void *item)
+{
+  void *old_head;
+  struct dbl_list_elem *elem = (struct dbl_list_elem *)item;
+  
+  /* Remove if already in list */
+  dbl_list_remove(list, item);
+  
+  /* Add at head */
+  elem->next = NULL;
+  elem->previous = NULL;
+  
+  old_head = list_head(list);
+  
+  if(old_head != NULL) {
+    list_push(list, item);
+    elem = (struct dbl_list_elem *)item;
+    elem->next = old_head;
+    ((struct dbl_list_elem *)old_head)->previous = item;
+  } else {
+    list_push(list, item);
+  }
+}
+
+/**
+ * Add an element at the tail of a doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param item The element to add.
+ */
+static inline void
+dbl_list_add_tail(dbl_list_t list, void *item)
+{
+  void *tail;
+  struct dbl_list_elem *elem = (struct dbl_list_elem *)item;
+  
+  /* Remove if already in list */
+  dbl_list_remove(list, item);
+  
+  /* Add at tail */
+  elem->next = NULL;
+  
+  tail = dbl_list_tail(list);
+  
+  if(tail == NULL) {
+    /* List is empty */
+    list_push(list, item);
+  } else {
+    elem->previous = tail;
+    ((struct dbl_list_elem *)tail)->next = item;
+  }
+}
+
+/**
+ * Add an element before an existing element in a doubly-linked list.
+ *
+ * If the element to be added is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param existing The existing element.
+ * \param element The element to add.
+ */
+static inline void
+dbl_list_add_before(dbl_list_t list, void *existing, void *element)
+{
+  void *prev;
+  struct dbl_list_elem *elem = (struct dbl_list_elem *)element;
+  
+  /* Remove if already in list */
+  dbl_list_remove(list, element);
+  
+  if(list_head(list) == existing) {
+    dbl_list_add_head(list, element);
+    return;
+  }
+  
+  /* Find the previous element */
+  for(prev = list_head(list); 
+      prev != NULL && ((struct dbl_list_elem *)prev)->next != existing;
+      prev = ((struct dbl_list_elem *)prev)->next);
+  
+  if(prev != NULL) {
+    elem->previous = prev;
+    elem->next = existing;
+    ((struct dbl_list_elem *)prev)->next = element;
+    ((struct dbl_list_elem *)existing)->previous = element;
+  }
+}
+
+/**
+ * Add an element after an existing element in a doubly-linked list.
+ *
+ * If the element to be added is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param existing The existing element.
+ * \param element The element to add.
+ */
+static inline void
+dbl_list_add_after(dbl_list_t list, void *existing, void *element)
+{
+  struct dbl_list_elem *elem = (struct dbl_list_elem *)element;
+  struct dbl_list_elem *ex = (struct dbl_list_elem *)existing;
+  
+  /* Remove if already in list */
+  dbl_list_remove(list, element);
+  
+  elem->next = ex->next;
+  elem->previous = existing;
+  
+  if(ex->next != NULL) {
+    ((struct dbl_list_elem *)ex->next)->previous = element;
+  }
+  
+  ex->next = element;
+}
+
+/**
+ * Remove an element from a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \param item The element to remove.
+ */
+static inline void
+dbl_list_remove(dbl_list_t list, void *item)
+{
+  struct dbl_list_elem *elem = (struct dbl_list_elem *)item;
+  
+  if(list_head(list) == NULL) {
+    return;
+  }
+  
+  if(elem->previous != NULL) {
+    elem->previous->next = elem->next;
+  }
+  
+  if(elem->next != NULL) {
+    elem->next->previous = elem->previous;
+  }
+  
+  elem->next = NULL;
+  elem->previous = NULL;
+}
+
+/** @} */
+/** @} */
+
+#endif /* DBL_LIST_H_ */

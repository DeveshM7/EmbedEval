+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE INSTITUTE OR CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifndef DBL_CIRC_LIST_H_
+#define DBL_CIRC_LIST_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/**
+ * \file
+ * Circular doubly-linked list library
+ * \author
+ */
+
+/**
+ * \addtogroup data-structures
+ * @{
+ */
+
+/**
+ * \defgroup dbl_circ_list Circular doubly-linked list library
+ *
+ * The circular doubly-linked list library provides circular doubly-linked list behavior.
+ * Elements are caller-allocated structs whose first field is a pointer
+ * named `next` and whose second field is a pointer named `previous`.
+ * These fields hold the link pointers.
+ *
+ * @{
+ */
+
+#define DBL_CIRC_LIST_CONCAT2(s1, s2) s1##s2
+#define DBL_CIRC_LIST_CONCAT(s1, s2) DBL_CIRC_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a circular doubly-linked list.
+ *
+ * This macro declares a circular doubly-linked list with the specified name. The list
+ * variable is declared as static to make it easy to use in a single
+ * C module without unnecessarily exporting the name to other modules.
+ *
+ * \param name The name of the circular doubly-linked list.
+ */
+#define DBL_CIRC_LIST(name) \
+    static void *DBL_CIRC_LIST_CONCAT(name,_list) = NULL; \
+    static list_t name = (list_t)&DBL_CIRC_LIST_CONCAT(name,_list)
+
+/**
+ * The circular doubly-linked list type.
+ */
+typedef list_t dbl_circ_list_t;
+
+/* Internal structure for circular doubly-linked list */
+struct dbl_circ_list_elem {
+  struct dbl_circ_list_elem *next;
+  struct dbl_circ_list_elem *previous;
+};
+
+/* Forward declarations */
+static inline void dbl_circ_list_remove(dbl_circ_list_t list, void *item);
+
+/* Circular doubly-linked list API */
+
+/**
+ * Initialize a circular doubly-linked list.
+ *
+ * This function initializes a circular doubly-linked list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The circular doubly-linked list to be initialized.
+ */
+static inline void
+dbl_circ_list_init(dbl_circ_list_t list)
+{
+  list_init(list);
+}
+
+/**
+ * Check if a circular doubly-linked list is empty.
+ *
+ * \param list The circular doubly-linked list.
+ * \return true if the circular doubly-linked list is empty, false otherwise.
+ */
+static inline bool
+dbl_circ_list_is_empty(dbl_circ_list_t list)
+{
+  return list_head(list) == NULL;
+}
+
+/**
+ * Get the length of a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \return The length of the circular doubly-linked list.
+ */
+static inline unsigned long
+dbl_circ_list_length(dbl_circ_list_t list)
+{
+  return (unsigned long)list_length(list);
+}
+
+/**
+ * Get the head element of a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \return A pointer to the head element, or NULL if the list is empty.
+ */
+static inline void *
+dbl_circ_list_head(dbl_circ_list_t list)
+{
+  return list_head(list);
+}
+
+/**
+ * Get the tail element of a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \return A pointer to the tail element, or NULL if the list is empty.
+ */
+static inline void *
+dbl_circ_list_tail(dbl_circ_list_t list)
+{
+  void *tail;
+  
+  if(list_head(list) == NULL) {
+    return NULL;
+  }
+  
+  /* In a circular list, tail is the element whose next points to head */
+  tail = list_head(list);
+  while(((struct dbl_circ_list_elem *)tail)->next != NULL && 
+        ((struct dbl_circ_list_elem *)tail)->next != list_head(list)) {
+    tail = ((struct dbl_circ_list_elem *)tail)->next;
+  }
+  
+  return tail;
+}
+
+/**
+ * Add an element at the head of a circular doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param item The element to add.
+ */
+static inline void
+dbl_circ_list_add_head(dbl_circ_list_t list, void *item)
+{
+  void *old_head, *tail;
+  struct dbl_circ_list_elem *elem = (struct dbl_circ_list_elem *)item;
+  
+  /* Remove if already in list */
+  dbl_circ_list_remove(list, item);
+  
+  old_head = list_head(list);
+  
+  /* Initialize the new element */
+  elem->next = NULL;
+  elem->previous = NULL;
+  
+  if(old_head == NULL) {
+    /* List is empty - add as single element */
+    list_push(list, item);
+    elem = (struct dbl_circ_list_elem *)item;
+    elem->next = item;
+    elem->previous = item;
+  } else {
+    /* List is not empty */
+    list_push(list, item);
+    elem = (struct dbl_circ_list_elem *)item;
+    
+    /* Point new head to old head and NULL previous for now */
+    elem->next = old_head;
+    elem->previous = NULL;
+    
+    /* Update old head's previous to point to new head */
+    ((struct dbl_circ_list_elem *)old_head)->previous = item;
+    
+    /* Find and update tail */
+    tail = dbl_circ_list_tail(list);
+    if(tail != item) {
+      ((struct dbl_circ_list_elem *)tail)->next = item;
+    }
+  }
+}
+
+/**
+ * Add an element at the tail of a circular doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param item The element to add.
+ */
+static inline void
+dbl_circ_list_add_tail(dbl_circ_list_t list, void *item)
+{
+  void *head, *tail;
+  struct dbl_circ_list_elem *elem = (struct dbl_circ_list_elem *)item;
+  
+  /* Remove if already in list */
+  dbl_circ_list_remove(list, item);
+  
+  head = list_head(list);
+  
+  if(head == NULL) {
+    /* List is empty - add as single element */
+    list_push(list, item);
+    elem = (struct dbl_circ_list_elem *)item;
+    elem->next = item;
+    elem->previous = item;
+  } else {
+    /* List is not empty - add before head (which makes it the tail) */
+    elem->next = head;
+    elem->previous = NULL;
+    
+    /* Find tail */
+    tail = dbl_circ_list_tail(list);
+    
+    /* Update tail's next to point to new element */
+    ((struct dbl_circ_list_elem *)tail)->next = item;
+    
+    /* Set new element's previous to old tail */
+    elem->previous = tail;
+    
+    /* Update head's previous to new tail */
+    ((struct dbl_circ_list_elem *)head)->previous = item;
+    
+    /* Insert after tail */
+    list_insert(list, tail, item);
+  }
+}
+
+/**
+ * Add an element after an existing element in a circular doubly-linked list.
+ *
+ * If the element to be added is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param existing The existing element.
+ * \param element The element to add.
+ */
+static inline void
+dbl_circ_list_add_after(dbl_circ_list_t list, void *existing, void *element)
+{
+  void *head;
+  struct dbl_circ_list_elem *elem = (struct dbl_circ_list_elem *)element;
+  struct dbl_circ_list_elem *ex = (struct dbl_circ_list_elem *)existing;
+  
+  /* Remove if already in list */
+  dbl_circ_list_remove(list, element);
+  
+  head = list_head(list);
+  
+  if(head == NULL) {
+    /* List is empty */
+    dbl_circ_list_add_head(list, element);
+    return;
+  }
+  
+  elem->next = ex->next;
+  elem->previous = existing;
+  
+  if(ex->next != head) {
+    ((struct dbl_circ_list_elem *)ex->next)->previous = element;
+  } else {
+    /* We're adding before head, so we're becoming the new tail */
+    /* Nothing special needed here */
+  }
+  
+  ex->next = element;
+}
+
+/**
+ * Add an element before an existing element in a circular doubly-linked list.
+ *
+ * If the element to be added is already in the list, it is first removed before being re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param existing The existing element.
+ * \param element The element to add.
+ */
+static inline void
+dbl_circ_list_add_before(dbl_circ_list_t list, void *existing, void *element)
+{
+  void *head;
+  struct dbl_circ_list_elem *elem = (struct dbl_circ_list_elem *)element;
+  struct dbl_circ_list_elem *ex = (struct dbl_circ_list_elem *)existing;
+  
+  /* Remove if already in list */
+  dbl_circ_list_remove(list, element);
+  
+  head = list_head(list);
+  
+  if(head == existing) {
+    dbl_circ_list_add_head(list, element);
+    return;
+  }
+  
+  /* Find previous element */
+  void *prev = head;
+  while(prev != NULL && ((struct dbl_circ_list_elem *)prev)->next != existing) {
+    prev = ((struct dbl_circ_list_elem *)prev)->next;
+  }
+  
+  if(prev != NULL) {
+    elem->next = existing;
+    elem->previous = prev;
+    
+    ((struct dbl_circ_list_elem *)prev)->next = element;
+    ex->previous = element;
+  }
+}
+
+/**
+ * Remove an element from a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \param item The element to remove.
+ */
+static inline void
+dbl_circ_list_remove(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_list_elem *elem = (struct dbl_circ_list_elem *)item;
+  
+  if(list_head(list) == NULL) {
+    return;
+  }
+  
+  /* Check if this is the only element */
+  if(elem->next == item && elem->previous == item) {
+    /* Single element - just remove from list */
+    list_remove(list, item);
+    elem->next = NULL;
+    elem->previous = NULL;
+    return;
+  }
+  
+  /* Update next element's previous */
+  if(elem->next != item) {
+    ((struct dbl_circ_list_elem *)elem->next)->previous = elem->previous;
+  }
+  
+  /* Update previous element's next */
+  if(elem->previous != item) {
+    ((struct dbl_circ_list_elem *)elem->previous)->next = elem->next;
+  } else {
+    /* elem is the head, need to update list head */
+    list_remove(list, item);
+  }
+  
+  elem->next = NULL;
+  elem->previous = NULL;
+}
+
+/** @} */
+/** @} */
+
+#endif /* DBL_CIRC_LIST_H_ */
diff --git a/os/lib/dbl-list.h b/os/lib/dbl-list.h
new file mode 100644
index 0000000..ca0d3be
--- /dev/null
+++ b/os/lib/dbl-list.h
@@ -0,0 +1,318 @@
+/*
+ * Copyright (c) 2024, Contiki-NG contributors
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:

+ */
+
+/**
+ * \defgroup stack Stack library
+ *
+ * The stack library provides LIFO (Last In, First Out) behavior.
+ * Elements are caller-allocated structs whose first field is a pointer
+ * named `next` which holds the link pointer.
+ *
+ * @{
+ */
+
+#define STACK_CONCAT2(s1, s2) s1##s2
+#define STACK_CONCAT(s1, s2) STACK_CONCAT2(s1, s2)
+
+/**
+ * Declare a stack.
+ *
+ * This macro declares a stack with the specified name. The stack
+ * variable is declared as static to make it easy to use in a single
+ * C module without unnecessarily exporting the name to other modules.
+ *
+ * \param name The name of the stack.
+ */
+#define STACK(name) \
+    static void *STACK_CONCAT(name,_stack) = NULL; \
+    static list_t name = (list_t)&STACK_CONCAT(name,_stack)
+
+/**
+ * The stack type.
+ */
+typedef list_t stack_t;
+
+/* Stack API */
+
+/**
+ * Initialize a stack.
+ *
+ * This function initializes a stack. The stack will be empty after this
+ * function has been called.
+ *
+ * \param stack The stack to be initialized.
+ */
+static inline void
+stack_init(stack_t stack)
+{
+  list_init(stack);
+}
+
+/**
+ * Check if a stack is empty.
+ *
+ * \param stack The stack.
+ * \return true if the stack is empty, false otherwise.
+ */
+static inline bool
+stack_is_empty(stack_t stack)
+{
+  return list_head(stack) == NULL;
+}
+
+/**
+ * Get the top element of a stack without removing it.
+ *
+ * \param stack The stack.
+ * \return A pointer to the top element, or NULL if the stack is empty.
+ */
+static inline void *
+stack_peek(stack_t stack)
+{
+  return list_head(stack);
+}
+
+/**
+ * Push an element onto the stack.
+ *
+ * \param stack The stack.
+ * \param item The element to push onto the stack.
+ */
+static inline void
+stack_push(stack_t stack, void *item)
+{
+  list_push(stack, item);
+}
+
+/**
+ * Pop an element from the stack.
+ *
+ * \param stack The stack.
+ * \return A pointer to the popped element, or NULL if the stack is empty.
+ */
+static inline void *
+stack_pop(stack_t stack)
+{
+  return list_pop(stack);
+}
+
+/** @} */
+/** @} */
+
+#endif /* STACK_H_ */

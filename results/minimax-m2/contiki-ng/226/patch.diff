+/**
+ * \file
+ * Queue library
+ * \author
+ */
+
+/**
+ * \addtogroup data-structures
+ * @{
+ */
+
+/**
+ * \defgroup queue Queue library
+ *
+ * The queue library provides FIFO (First In, First Out) behavior.
+ * Elements are caller-allocated structs whose first field is a pointer
+ * named `next` which holds the link pointer.
+ *
+ * @{
+ */
+
+#define QUEUE_CONCAT2(s1, s2) s1##s2
+#define QUEUE_CONCAT(s1, s2) QUEUE_CONCAT2(s1, s2)
+
+/**
+ * Declare a queue.
+ *
+ * This macro declares a queue with the specified name. The queue
+ * variable is declared as static to make it easy to use in a single
+ * C module without unnecessarily exporting the name to other modules.
+ *
+ * \param name The name of the queue.
+ */
+#define QUEUE(name) \
+    static void *QUEUE_CONCAT(name,_queue) = NULL; \
+    static list_t name = (list_t)&QUEUE_CONCAT(name,_queue)
+
+/**
+ * The queue type.
+ */
+typedef list_t queue_t;
+
+/* Queue API */
+
+/**
+ * Initialize a queue.
+ *
+ * This function initializes a queue. The queue will be empty after this
+ * function has been called.
+ *
+ * \param queue The queue to be initialized.
+ */
+static inline void
+queue_init(queue_t queue)
+{
+  list_init(queue);
+}
+
+/**
+ * Check if a queue is empty.
+ *
+ * \param queue The queue.
+ * \return true if the queue is empty, false otherwise.
+ */
+static inline bool
+queue_is_empty(queue_t queue)
+{
+  return list_head(queue) == NULL;
+}
+
+/**
+ * Get the front element of a queue without removing it.
+ *
+ * \param queue The queue.
+ * \return A pointer to the front element, or NULL if the queue is empty.
+ */
+static inline void *
+queue_peek(queue_t queue)
+{
+  return list_head(queue);
+}
+
+/**
+ * Enqueue an element at the tail of the queue.
+ *
+ * \param queue The queue.
+ * \param item The element to enqueue.
+ */
+static inline void
+queue_enqueue(queue_t queue, void *item)
+{
+  list_add(queue, item);
+}
+
+/**
+ * Dequeue an element from the front of the queue.
+ *
+ * \param queue The queue.
+ * \return A pointer to the dequeued element, or NULL if the queue is empty.
+ */
+static inline void *
+queue_dequeue(queue_t queue)
+{
+  return list_pop(queue);
+}
+
+/** @} */
+/** @} */
+
+#endif /* QUEUE_H_ */

+/**
+ * \brief Set an IPv6 address to the NAT64 well-known prefix form
+ *
+ * This macro sets an IPv6 address to the NAT64 well-known prefix form
+ * (64:ff9b::/96) with the given IPv4 address placed in the low 32 bits.
+ * For example, uip_nat64addr(&addr, 8, 8, 8, 8) sets the address to 64:ff9b::8.8.8.8
+ *
+ * \param addr A pointer to a uip_ip6addr_t to set
+ * \param a The first octet of the IPv4 address
+ * \param b The second octet of the IPv4 address
+ * \param c The third octet of the IPv4 address
+ * \param d The fourth octet of the IPv4 address
+ */
+#define uip_nat64addr(addr, a, b, c, d) do { \
+  (addr)->u8[0] = 0x00; \
+  (addr)->u8[1] = 0x64; \
+  (addr)->u8[2] = 0xff; \
+  (addr)->u8[3] = 0x9b; \
+  (addr)->u8[4] = 0x00; \
+  (addr)->u8[5] = 0x00; \
+  (addr)->u8[6] = 0x00; \
+  (addr)->u8[7] = 0x00; \
+  (addr)->u8[8] = 0x00; \
+  (addr)->u8[9] = 0x00; \
+  (addr)->u8[10] = 0x00; \
+  (addr)->u8[11] = 0x00; \
+  (addr)->u8[12] = (a); \
+  (addr)->u8[13] = (b); \
+  (addr)->u8[14] = (c); \
+  (addr)->u8[15] = (d); \
+} while(0)
+
 #endif /* UIPLIB_H_ */
 /**
  * @}

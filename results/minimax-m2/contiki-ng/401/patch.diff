diff --git a/os/net/ipv6/uip-ds6-nbr.c b/os/net/ipv6/uip-ds6-nbr.c
index f937986..050f403 100644
--- a/os/net/ipv6/uip-ds6-nbr.c
+++ b/os/net/ipv6/uip-ds6-nbr.c
@@ -55,6 +55,20 @@
 #include "net/ipv6/uip-nd6.h"
 #include "net/routing/routing.h"
 
+/* Configuration for multi-IPv6 addresses per neighbor */
+#ifdef UIP_DS6_NBR_CONF_MULTI_IPV6_ADDRS
+#define UIP_DS6_NBR_MULTI_IPV6_ADDRS UIP_DS6_NBR_CONF_MULTI_IPV6_ADDRS
+#else /* UIP_DS6_NBR_CONF_MULTI_IPV6_ADDRS */
+#define UIP_DS6_NBR_MULTI_IPV6_ADDRS 0
+#endif /* UIP_DS6_NBR_CONF_MULTI_IPV6_ADDRS */
+
+#ifdef UIP_DS6_NBR_CONF_MAX_6ADDRS_PER_NBR
+#define UIP_DS6_NBR_MAX_6ADDRS_PER_NBR UIP_DS6_NBR_CONF_MAX_6ADDRS_PER_NBR
+#else /* UIP_DS6_NBR_CONF_MAX_6ADDRS_PER_NBR */
+#define UIP_DS6_NBR_MAX_6ADDRS_PER_NBR 1
+#endif /* UIP_DS6_NBR_CONF_MAX_6ADDRS_PER_NBR */
+
+
 /* Log configuration */
 #include "sys/log.h"
 #define LOG_MODULE "IPv6 Nbr"
@@ -75,6 +89,106 @@ uip_ds6_nbr_add(const uip_ipaddr_t *ipaddr, const uip_lladdr_t *lladdr,
                 uint8_t isrouter, uint8_t state, nbr_table_reason_t reason,
                 void *data)
 {
+#if UIP_DS6_NBR_MULTI_IPV6_ADDRS
+  uip_ds6_nbr_t *nbr = NULL;
+  uip_ds6_nbr_t *existing_nbr;
+  linkaddr_t synthetic_lladdr;
+  int i;
+
+  /* Check if a neighbor with this lladdr already exists */
+  existing_nbr = uip_ds6_nbr_ll_lookup(lladdr);
+  
+  if(existing_nbr == NULL) {
+    /* No existing neighbor, create the first one */
+    nbr = nbr_table_add_lladdr(ds6_neighbors, (linkaddr_t*)lladdr,
+                               reason, data);
+  } else {
+    /* Neighbor exists, check if we can add another IPv6 address */
+    /* Count how many IPv6 addresses this neighbor already has */
+    int addr_count = 0;
+    for(nbr = uip_ds6_nbr_head(); nbr != NULL; nbr = uip_ds6_nbr_next(nbr)) {
+      const uip_lladdr_t *nbr_lladdr = uip_ds6_nbr_get_ll(nbr);
+      if(nbr_lladdr != NULL && linkaddr_cmp((linkaddr_t*)nbr_lladdr, (linkaddr_t*)lladdr)) {
+        addr_count++;
+      }
+    }
+    
+    if(addr_count >= UIP_DS6_NBR_MAX_6ADDRS_PER_NBR) {
+      /* Limit reached */
+      LOG_INFO("Add drop ip addr ");
+      LOG_INFO_6ADDR(ipaddr);
+      LOG_INFO_(" link addr (%p) - max addresses per neighbor reached\n", lladdr);
+      LOG_INFO_LLADDR((linkaddr_t*)lladdr);
+      return NULL;
+    }
+    
+    /* Create a synthetic lladdr by appending an index */
+    memset(&synthetic_lladdr, 0, sizeof(synthetic_lladdr));
+    memcpy(&synthetic_lladdr, lladdr, sizeof(uip_lladdr_t));
+    /* Use the last byte as an index */
+    for(i = 1; i < 256; i++) {
+      synthetic_lladdr.u8[LINKADDR_SIZE - 1] = i;
+      /* Check if this synthetic address is already in use */
+      if(uip_ds6_nbr_ll_lookup((uip_lladdr_t*)&synthetic_lladdr) == NULL) {
+        /* Found a free synthetic address */
+        nbr = nbr_table_add_lladdr(ds6_neighbors, &synthetic_lladdr,
+                                  reason, data);
+        if(nbr != NULL) {
+          nbr->is_synthetic = 1;
+          memcpy(&nbr->real_lladdr, lladdr, sizeof(uip_lladdr_t));
+        }
+        break;
+      }
+    }
+    
+    if(nbr == NULL) {
+      /* Couldn't create synthetic address */
+      LOG_INFO("Add drop ip addr ");
+      LOG_INFO_6ADDR(ipaddr);
+      LOG_INFO_(" link addr (%p) - couldn't create synthetic address\n", lladdr);
+      LOG_INFO_LLADDR((linkaddr_t*)lladdr);
+      return NULL;
+    }
+  }
+  
+  if(nbr) {
+    uip_ipaddr_copy(&nbr->ipaddr, ipaddr);
+#if UIP_ND6_SEND_RA || !UIP_CONF_ROUTER
+    nbr->isrouter = isrouter;
+#endif /* UIP_ND6_SEND_RA || !UIP_CONF_ROUTER */
+    nbr->state = state;
+#if UIP_DS6_NBR_MULTI_IPV6_ADDRS
+    nbr->is_synthetic = 0;
+#endif /* UIP_DS6_NBR_MULTI_IPV6_ADDRS */ 
+#if UIP_CONF_IPV6_QUEUE_PKT
+    uip_packetqueue_new(&nbr->packethandle);
+#endif /* UIP_CONF_IPV6_QUEUE_PKT */
+#if UIP_ND6_SEND_NS
+    if(nbr->state == NBR_REACHABLE) {
+      stimer_set(&nbr->reachable, UIP_ND6_REACHABLE_TIME / 1000);
+    } else {
+      /* We set the timer in expired state */
+      stimer_set(&nbr->reachable, 0);
+    }
+    stimer_set(&nbr->sendns, 0);
+    nbr->nscount = 0;
+#endif /* UIP_ND6_SEND_NS */
+    LOG_INFO("Adding neighbor with ip addr ");
+    LOG_INFO_6ADDR(ipaddr);
+    LOG_INFO_(" link addr ");
+    LOG_INFO_LLADDR((linkaddr_t*)lladdr);
+    LOG_INFO_(" state %u\n", state);
+    NETSTACK_ROUTING.neighbor_state_changed(nbr);
+    return nbr;
+  } else {
+    LOG_INFO("Add drop ip addr ");
+    LOG_INFO_6ADDR(ipaddr);
+    LOG_INFO_(" link addr (%p) ", lladdr);
+    LOG_INFO_LLADDR((linkaddr_t*)lladdr);
+    LOG_INFO_(" state %u\n", state);
+    return NULL;
+  }
+#else /* UIP_DS6_NBR_MULTI_IPV6_ADDRS */
   uip_ds6_nbr_t *nbr = nbr_table_add_lladdr(ds6_neighbors, (linkaddr_t*)lladdr
                                             , reason, data);
   if(nbr) {
@@ -83,6 +197,9 @@ uip_ds6_nbr_add(const uip_ipaddr_t *ipaddr, const uip_lladdr_t *lladdr,
     nbr->isrouter = isrouter;
 #endif /* UIP_ND6_SEND_RA || !UIP_CONF_ROUTER */
     nbr->state = state;
+#if UIP_DS6_NBR_MULTI_IPV6_ADDRS
+    nbr->is_synthetic = 0;
+#endif /* UIP_DS6_NBR_MULTI_IPV6_ADDRS */
 #if UIP_CONF_IPV6_QUEUE_PKT
     uip_packetqueue_new(&nbr->packethandle);
 #endif /* UIP_CONF_IPV6_QUEUE_PKT */
@@ -111,6 +228,7 @@ uip_ds6_nbr_add(const uip_ipaddr_t *ipaddr, const uip_lladdr_t *lladdr,
     LOG_INFO_(" state %u\n", state);
     return NULL;
   }
+#endif /* UIP_DS6_NBR_MULTI_IPV6_ADDRS */
 }
 
 /*---------------------------------------------------------------------------*/
@@ -173,6 +291,11 @@ uip_ds6_nbr_get_ipaddr(const uip_ds6_nbr_t *nbr)
 const uip_lladdr_t *
 uip_ds6_nbr_get_ll(const uip_ds6_nbr_t *nbr)
 {
+#if UIP_DS6_NBR_MULTI_IPV6_ADDRS
+  if(nbr != NULL && nbr->is_synthetic) {
+    return &nbr->real_lladdr;
+  }
+#endif /* UIP_DS6_NBR_MULTI_IPV6_ADDRS */
   return (const uip_lladdr_t *)nbr_table_get_lladdr(ds6_neighbors, nbr);
 }
 /*---------------------------------------------------------------------------*/

+/**
+ * \file
+ *         Bit reversal utilities for 802.15.4g
+ * \author
+ *         SICS
+ */
+
+#ifndef BITREV_H_
+#define BITREV_H_
+
+#include <stdint.h>
+#include <stddef.h>
+
+/**
+ * \brief Reverse the bit order of a single byte
+ * \param byte The byte to reverse
+ * \return The byte with reversed bit order
+ */
+uint8_t bitrev_byte(uint8_t byte);
+
+/**
+ * \brief Reverse the bit order of each byte in an array (in place)
+ * \param data Pointer to the array to reverse
+ * \param len Number of bytes to process
+ */
+void bitrev_array(uint8_t *data, size_t len);
+
+/**
+ * \brief Copy and reverse the bit order of each byte from input to output
+ * \param input Input array (unchanged)
+ * \param output Output array (will contain reversed bytes)
+ * \param len Number of bytes to process
+ */
+void bitrev_array_copy(const uint8_t *input, uint8_t *output, size_t len);
+
+#endif /* BITREV_H_ */

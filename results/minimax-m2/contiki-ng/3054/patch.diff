+/**
+ * \file
+ *         Bit reversal utilities for 802.15.4g
+ * \author
+ *         SICS
+ */
+
+#include "bitrev.h"
+#include <stdint.h>
+#include <stddef.h>
+
+/* Lookup table for bit reversal */
+static const uint8_t bit_reverse_table[256] = {
+  0x00, 0x80, 0x40, 0xC0, 0x20, 0xA0, 0x60, 0xE0,
+  0x10, 0x90, 0x50, 0xD0, 0x30, 0xB0, 0x70, 0xF0,

index d4be6a5f5..3e757e036 100644
--- a/subsys/net/lib/dhcpv4/dhcpv4_server.c
+++ b/subsys/net/lib/dhcpv4/dhcpv4_server.c
@@ -440,6 +440,58 @@ static uint8_t *dhcpv4_encode_dns_server_option(uint8_t *buf, size_t *buflen)
 
 	return buf + DHCPV4_OPTIONS_DNS_SERVER_SIZE;
 }
+static uint8_t *dhcpv4_encode_captive_portal_option(uint8_t *buf, size_t *buflen,
+						    struct net_in_addr *server_addr)
+{
+#if defined(CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL)
+	char uri[64];
+	size_t uri_len;
+
+	if (buf == NULL || *buflen < 3) {
+		return NULL;
+	}
+
+	/* Build the URI */
+	if (strlen(CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI) > 0) {
+		/* Use the configured URI */
+		uri_len = strlen(CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI);
+		if (uri_len > sizeof(uri) - 1) {
+			uri_len = sizeof(uri) - 1;
+		}
+		strncpy(uri, CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI, uri_len);
+	} else {
+		/* Auto-build the URI as http://<server-IPv4>/generate_204 */
+		char ip_buf[NET_INET_ADDRSTRLEN];
+		const char *ip_str;
+
+		ip_str = net_addr_ntop(NET_AF_INET, server_addr, ip_buf, sizeof(ip_buf));
+		if (ip_str == NULL) {
+			return NULL;
+		}
+		snprintk(uri, sizeof(uri), "http://%s/generate_204", ip_str);
+		uri_len = strlen(uri);
+	}
+
+	/* Check if we have enough space in the buffer */
+	if (*buflen < 2 + uri_len) {
+		return NULL;
+	}
+
+	buf[0] = DHCPV4_OPTIONS_CAPTIVE_PORTAL;
+	buf[1] = uri_len;
+	memcpy(&buf[2], uri, uri_len);
+
+	*buflen -= 2 + uri_len;
+
+	return buf + 2 + uri_len;
+#else
+	ARG_UNUSED(buf);
+	ARG_UNUSED(buflen);
+	ARG_UNUSED(server_addr);
+
+	return buf;
+#endif
+}
 

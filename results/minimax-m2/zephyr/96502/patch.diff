+int mqtt_sn_predefine_topic(struct mqtt_sn_client *client, uint16_t topic_id,
+			    struct mqtt_sn_data *topic_name)
+{
+	struct mqtt_sn_topic *topic;
+
+	if (!client || !topic_name || !topic_name->data || !topic_name->size) {
+		return -EINVAL;
+	}
+
+	/* Check if topic name already exists */
+	topic = mqtt_sn_topic_find_by_name(client, topic_name);
+	if (topic) {
+		return -EALREADY;
+	}
+
+	/* Check if topic ID already exists */
+	topic = mqtt_sn_topic_find_by_id(client, topic_id);
+	if (topic) {
+		return -EALREADY;
+	}
+
+	/* Create and initialize the predefined topic */
+	if (k_mem_slab_alloc(&topics, (void **)&topic, K_NO_WAIT)) {
+		LOG_ERR("Can't create topic: no free slot");
+		return -ENOMEM;
+	}
+
+	if (topic_name->size > sizeof(topic->name)) {
+		k_mem_slab_free(&topics, (void *)topic);
+		return -EINVAL;
+	}
+
+ memset(topic, 0, sizeof(*topic));
+
+	memcpy(topic->name, topic_name->data, topic_name->size);
+	topic->namelen = topic_name->size;
+	topic->topic_id = topic_id;
+	topic->type = MQTT_SN_TOPIC_TYPE_PREDEF;
+	topic->state = MQTT_SN_TOPIC_STATE_REGISTERED;
+
+	sys_slist_append(&client->topic, &topic->next);
+
+	return 0;
+}

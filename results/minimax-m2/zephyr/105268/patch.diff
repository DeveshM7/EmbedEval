diff --git a/test_sizes.c b/test_sizes.c
new file mode 100644
index 00000000..0c68a852
--- /dev/null
+++ b/test_sizes.c
@@ -0,0 +1,21 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <zephyr/sys/util_macro.h>
+
+int main() {
+    printf("sizeof(1UL) = %zu\n", sizeof(1UL));
+    printf("sizeof(1ULL) = %zu\n", sizeof(1ULL));
+    printf("sizeof(uint64_t) = %zu\n", sizeof(uint64_t));
+    printf("sizeof(BIT(32)) = %zu\n", sizeof(BIT(32)));
+    printf("sizeof(BIT64(32)) = %zu\n", sizeof(BIT64(32)));
+    
+    printf("\n1UL << 32 = 0x%lx\n", 1UL << 32);
+    printf("1ULL << 32 = 0x%llx\n", 1ULL << 32);
+    
+    uint64_t test = 0;
+    printf("\nBefore: test = 0x%llx\n", (unsigned long long)test);
+    printf("BIT(32) = 0x%lx\n", BIT(32));
+    printf("BIT64(32) = 0x%llx\n", BIT64(32));
+    
+    return 0;
+}

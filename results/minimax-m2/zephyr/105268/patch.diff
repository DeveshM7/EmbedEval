diff --git a/verify_fix.c b/verify_fix.c
new file mode 100644
index 00000000..0f8dbaa1
--- /dev/null
+++ b/verify_fix.c
@@ -0,0 +1,91 @@
+/*
+ * Verification that WRITE_BIT now works for all 64 bits
+ * This demonstrates the fix for the bug where bits 32+ didn't work
+ */
+#include <stdio.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <zephyr/sys/util_macro.h>
+
+int main(void) {
+    uint64_t test_var;
+    int failures = 0;
+    
+    printf("=== WRITE_BIT 64-bit Fix Verification ===\n\n");
+    
+    /* Test all 64 bits can be set */
+    printf("Test 1: Setting all bits 0-63\n");
+    for (int bit = 0; bit < 64; bit++) {
+        test_var = 0;
+        WRITE_BIT(test_var, bit, true);
+        uint64_t expected = 1ULL << bit;
+        if (test_var != expected) {
+            printf("  FAILED: Bit %d - expected 0x%llx, got 0x%llx\n",
+                   bit, (unsigned long long)expected, (unsigned long long)test_var);
+            failures++;
+        }
+    }
+    if (failures == 0) {
+        printf("  PASSED: All bits 0-63 can be set\n");
+    }
+    
+    /* Test all 64 bits can be cleared */
+    printf("\nTest 2: Clearing all bits 0-63\n");
+    for (int bit = 0; bit < 64; bit++) {
+        test_var = 0xFFFFFFFFFFFFFFFFULL;
+        WRITE_BIT(test_var, bit, false);
+        uint64_t expected = ~(1ULL << bit);
+        if (test_var != expected) {
+            printf("  FAILED: Bit %d - expected 0x%llx, got 0x%llx\n",
+                   bit, (unsigned long long)expected, (unsigned long long)test_var);
+            failures++;
+        }
+    }
+    if (failures == 0) {
+        printf("  PASSED: All bits 0-63 can be cleared\n");
+    }
+    
+    /* Test critical boundary bits */
+    printf("\nTest 3: Critical boundary bits\n");
+    
+    test_var = 0;
+    WRITE_BIT(test_var, 0, true);
+    if (test_var != 0x1ULL) {
+        printf("  FAILED: Bit 0\n");
+        failures++;
+    }
+    
+    test_var = 0;
+    WRITE_BIT(test_var, 31, true);
+    if (test_var != 0x80000000ULL) {
+        printf("  FAILED: Bit 31\n");
+        failures++;
+    }
+    
+    test_var = 0;
+    WRITE_BIT(test_var, 32, true);
+    if (test_var != 0x100000000ULL) {
+        printf("  FAILED: Bit 32\n");
+        failures++;
+    }
+    
+    test_var = 0;
+    WRITE_BIT(test_var, 63, true);
+    if (test_var != 0x8000000000000000ULL) {
+        printf("  FAILED: Bit 63\n");
+        failures++;
+    }
+    
+    if (failures == 0) {
+        printf("  PASSED: All critical boundary bits work correctly\n");
+    }
+    
+    printf("\n=== Result ===\n");
+    if (failures == 0) {
+        printf("SUCCESS: WRITE_BIT now works correctly for all 64 bits!\n");
+        return 0;
+    } else {
+        printf("FAILURE: %d tests failed\n", failures);
+        return 1;
+    }
+}

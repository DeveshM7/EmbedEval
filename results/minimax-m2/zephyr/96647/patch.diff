diff --git a/kernel/work.c b/kernel/work.c
index bcbb3b46..6ba51b2d 100644
--- a/kernel/work.c
+++ b/kernel/work.c
@@ -934,6 +934,15 @@ int k_work_queue_stop(struct k_work_q *queue, k_timeout_t timeout)
 		return -EBUSY;
 	}
 
+	/* An essential thread cannot be stopped (joining it would cause a
+	 * fatal panic).
+	 */
+	if ((queue->thread.base.user_options & K_ESSENTIAL) != 0) {
+		k_spin_unlock(&lock, key);
+		SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_work_queue, stop, queue, timeout, -ENOTSUP);
+		return -ENOTSUP;
+	}
+
 	flag_set(&queue->flags, K_WORK_QUEUE_STOP_BIT);
 	notify_queue_locked(queue);
 	k_spin_unlock(&lock, key);

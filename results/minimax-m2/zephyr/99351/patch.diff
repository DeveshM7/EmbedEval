+/* Test compilation of PDM devicetree macros */
+#include <zephyr/audio/dmic.h>
+#include <zephyr/devicetree.h>
+
+/* Mock devicetree node for testing */
+#define DT_NODE_TEST  DT_NODELABEL(test)
+
+void test_macro_compilation(void)
+{

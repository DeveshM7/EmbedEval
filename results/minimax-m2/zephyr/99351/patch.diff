+# PDM/DMIC Devicetree Implementation Summary
+
+## Overview
+Added support for configuring Digital Microphone (PDM/DMIC) API from devicetree by implementing three new macros in `/testbed/include/zephyr/audio/dmic.h`.
+
+## Changes Made
+
+### 1. Added Three New Macros in `zephyr/audio/dmic.h`
+
+#### PDM_DT_IO_CFG_GET(node_id)
+- **Purpose**: Returns a `struct pdm_io_cfg` initialized from devicetree properties
+- **Location**: Line 133-140 of dmic.h
+- **Implementation**: Uses compound literal syntax to initialize the struct with values from devicetree
+- **Required Properties**:
+  - `clk-frequency-min`: minimum PDM clock frequency (uint32_t)
+  - `clk-frequency-max`: maximum PDM clock frequency (uint32_t)
+  - `clk-duty-cycle-min`: minimum duty cycle in % (uint8_t)
+  - `clk-duty-cycle-max`: maximum duty cycle in % (uint8_t)
+
+#### PDM_DT_HAS_LEFT_CHANNEL(node_id)
+- **Purpose**: Checks if a devicetree PDM microphone node has a left channel
+- **Location**: Line 152-153 of dmic.h
+- **Implementation**: Uses `DT_NODE_HAS_PROP` macro
+- **Returns**: 1 if node has `channel-left` property, 0 otherwise
+
+#### PDM_DT_HAS_RIGHT_CHANNEL(node_id)
+- **Purpose**: Checks if a devicetree PDM microphone node has a right channel
+- **Location**: Line 164-165 of dmic.h
+- **Implementation**: Uses `DT_NODE_HAS_PROP` macro
+- **Returns**: 1 if node has `channel-right` property, 0 otherwise
+
+## Devicetree Node Requirements
+
+A devicetree node using compatible `"zephyr,pdm-dmic"` should define:
+
+```
+/ {
+    my_mic: pdm-mic@address {
+        compatible = "zephyr,pdm-dmic";
+        clk-frequency-min = <1000000>;
+        clk-frequency-max = <3500000>;
+        clk-duty-cycle-min = <40>;
+        clk-duty-cycle-max = <60>;
+        channel-left;        /* Optional: indicates left channel available */
+        channel-right;       /* Optional: indicates right channel available */
+    };
+};
+```
+
+## Example Usage
+
+```c
+#include <zephyr/audio/dmic.h>
+#include <zephyr/devicetree.h>
+
+#define MY_MIC_NODE DT_NODELABEL(my_mic)
+
+void setup_mic(void)
+{
+    struct pdm_io_cfg io_cfg;
+    struct dmic_cfg dmic_cfg;
+    
+    /* Get IO configuration from devicetree */
+    io_cfg = PDM_DT_IO_CFG_GET(MY_MIC_NODE);
+    
+    /* Check available channels */
+    bool has_left = PDM_DT_HAS_LEFT_CHANNEL(MY_MIC_NODE);
+    bool has_right = PDM_DT_HAS_RIGHT_CHANNEL(MY_MIC_NODE);
+    
+    /* Use the configuration */
+    dmic_cfg.io = io_cfg;
+    /* ... configure other fields ... */
+}
+```
+
+## Implementation Details
+
+- All macros are implemented using standard Zephyr devicetree APIs (`DT_PROP`, `DT_NODE_HAS_PROP`)
+- The macros follow the same naming convention as other Zephyr devicetree macros (e.g., `GPIO_DT_SPEC_GET`)
+- Documentation follows Doxygen format with proper `@brief`, `@param`, and `@return` tags
+- The implementation is consistent with existing Zephyr coding style
+
+## Files Modified
+
+1. `/testbed/include/zephyr/audio/dmic.h` - Added three new macros with documentation
+
+## Testing
+
+The implementation:
+- Is syntactically correct (verified by successful compilation)
+- Follows Zephyr devicetree macro patterns
+- Uses proper devicetree APIs
+- Includes comprehensive documentation
+
+The macros can be used in any Zephyr project that:
+- Has a devicetree node with compatible "zephyr,pdm-dmic"
+- Includes the necessary properties (clk-frequency-min, clk-frequency-max, clk-duty-cycle-min, clk-duty-cycle-max)
+- Optionally includes channel-left and/or channel-right properties
diff --git a/include/zephyr/audio/dmic.h b/include/zephyr/audio/dmic.h
index bb46e008..6f2c6b2b 100644
--- a/include/zephyr/audio/dmic.h
+++ b/include/zephyr/audio/dmic.h
@@ -105,6 +105,69 @@ struct pdm_io_cfg {
 	/**
 	 * @}
 	 */
+
+/**
+ * Devicetree helper macros
+ */
+
+/**
+ * @defgroup devicetree_pdmic Devicetree PDM microphone configuration
+ * @{
+ */
+
+/**
+ * @brief Get PDM IO configuration from a devicetree node
+ *
+ * This macro returns a pdm_io_cfg structure initialized with values
+ * from a devicetree node describing a PDM microphone.
+ *
+ * The devicetree node must have the compatible "zephyr,pdm-dmic" and the
+ * following properties:
+ * - clk-frequency-min: minimum PDM clock frequency (uint32_t)
+ * - clk-frequency-max: maximum PDM clock frequency (uint32_t)
+ * - clk-duty-cycle-min: minimum duty cycle in % (uint8_t)
+ * - clk-duty-cycle-max: maximum duty cycle in % (uint8_t)
+ *
+ * @param node_id devicetree node identifier
+ * @return struct pdm_io_cfg initialized from devicetree properties
+ */
+#define PDM_DT_IO_CFG_GET(node_id) \
+	((struct pdm_io_cfg) \
+	{ \
+		.min_pdm_clk_freq = DT_PROP(node_id, clk_frequency_min), \
+		.max_pdm_clk_freq = DT_PROP(node_id, clk_frequency_max), \
+		.min_pdm_clk_dc = DT_PROP(node_id, clk_duty_cycle_min), \
+		.max_pdm_clk_dc = DT_PROP(node_id, clk_duty_cycle_max), \
+	})
+
+/**
+ * @brief Check if a devicetree PDM microphone node has a left channel
+ *
+ * Checks if the devicetree node has the "channel-left" property present.
+ * This property indicates that the microphone provides a left channel.
+ *
+ * @param node_id devicetree node identifier
+ * @return 1 if the node has the channel-left property, 0 otherwise
+ */
+#define PDM_DT_HAS_LEFT_CHANNEL(node_id) \
+	DT_NODE_HAS_PROP(node_id, channel_left)
+
+/**
+ * @brief Check if a devicetree PDM microphone node has a right channel
+ *
+ * Checks if the devicetree node has the "channel-right" property present.
+ * This property indicates that the microphone provides a right channel.
+ *
+ * @param node_id devicetree node identifier
+ * @return 1 if the node has the channel-right property, 0 otherwise
+ */
+#define PDM_DT_HAS_RIGHT_CHANNEL(node_id) \
+	DT_NODE_HAS_PROP(node_id, channel_right)
+
+/**
+ * @}
+ */
+
 };
 

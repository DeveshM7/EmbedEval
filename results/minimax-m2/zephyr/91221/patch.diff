+/*
+ * Simple demonstration of the device_init() error return fix
+ */
+#include <stdio.h>
+#include <errno.h>
+
+/* Simulate the fixed do_device_init logic */
+int simulate_do_device_init(int init_return) {
+    int rc = init_return;
+    
+    if (rc != 0) {
+        /* Store the absolute value of the error code */
+        int abs_rc = rc < 0 ? -rc : rc;
+        if (rc > 255) {  /* UINT8_MAX */
+            abs_rc = 255;
+        }
+        int stored_init_res = abs_rc;  /* This goes into dev->state->init_res */
+        
+        /* Return the error code as negative */
+        if (rc > 0) {
+            rc = -rc;
+        }
+        
+        printf("  Init function returned: %d\n", init_return);
+        printf("  Stored in init_res: %d (positive errno)\n", stored_init_res);
+        printf("  device_init() returns: %d (negative errno)\n", rc);
+        return rc;
+    }
+    
+    printf("  Init function returned: 0 (success)\n");
+    printf("  Stored in init_res: 0\n");
+    printf("  device_init() returns: 0\n");
+    return 0;
+}
+
+int main() {
+    printf("Test 1: Init function returns positive error (EIO = 5)\n");
+    int ret1 = simulate_do_device_init(EIO);
+    printf("  Expected device_init() to return: -5\n");
+    printf("  Actual device_init() returned: %d\n", ret1);
+    printf("  Result: %s\n\n", ret1 == -EIO ? "PASS" : "FAIL");
+    
+    printf("Test 2: Init function returns negative error (-EIO = -5)\n");
+    int ret2 = simulate_do_device_init(-EIO);
+    printf("  Expected device_init() to return: -5\n");
+    printf("  Actual device_init() returned: %d\n", ret2);
+    printf("  Result: %s\n\n", ret2 == -EIO ? "PASS" : "FAIL");
+    
+    printf("Test 3: Init function returns 0 (success)\n");
+    int ret3 = simulate_do_device_init(0);
+    printf("  Expected device_init() to return: 0\n");
+    printf("  Actual device_init() returned: %d\n", ret3);
+    printf("  Result: %s\n\n", ret3 == 0 ? "PASS" : "FAIL");
+    
+    return 0;
+}

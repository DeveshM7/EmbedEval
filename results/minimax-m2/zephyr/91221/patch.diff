diff --git a/test_device_init_fix.c b/test_device_init_fix.c
new file mode 100644
index 00000000..d34bb3d6
--- /dev/null
+++ b/test_device_init_fix.c
@@ -0,0 +1,54 @@
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <errno.h>
+
+/* Device that returns positive error */
+static int positive_error_init(const struct device *dev)
+{
+	return EIO;  /* Return positive error code */
+}
+
+/* Device that returns negative error */
+static int negative_error_init(const struct device *dev)
+{
+	return -EIO;  /* Return negative error code */
+}
+
+/* Create test devices */
+DEVICE_DEFINE(test_pos_device, "test_pos_device", positive_error_init, NULL, NULL,
+	      POST_KERNEL, CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, NULL);
+
+DEVICE_DEFINE(test_neg_device, "test_neg_device", negative_error_init, NULL, NULL,
+	      POST_KERNEL, CONFIG_KERNEL_INIT_PRIORITY_DEFAULT, NULL);
+
+int main(void)
+{
+	const struct device *dev_pos = device_get_binding("test_pos_device");
+	const struct device *dev_neg = device_get_binding("test_neg_device");
+	int ret;
+
+	if (!dev_pos || !dev_neg) {
+		k_printk("ERROR: Failed to get device binding\n");
+		return 1;
+	}
+
+	/* Test device that returns positive error */
+	k_printk("\n=== Testing device with positive error return ===\n");
+	ret = device_init(dev_pos);
+	k_printk("device_init() returned: %d (expected: -5 = -EIO)\n", ret);
+	k_printk("device_is_ready(): %d (expected: 0 = false)\n", device_is_ready(dev_pos));
+	ret = device_init(dev_pos);
+	k_printk("Second device_init() returned: %d (expected: -16 = -EALREADY)\n", ret);
+
+	/* Test device that returns negative error */
+	k_printk("\n=== Testing device with negative error return ===\n");
+	ret = device_init(dev_neg);
+	k_printk("device_init() returned: %d (expected: -5 = -EIO)\n", ret);
+	k_printk("device_is_ready(): %d (expected: 0 = false)\n", device_is_ready(dev_neg));
+	ret = device_init(dev_neg);
+	k_printk("Second device_init() returned: %d (expected: -16 = -EALREADY)\n", ret);
+
+	k_printk("\n=== All tests completed ===\n");
+
+	return 0;
+}

diff --git a/test_chunked_body_len.c b/test_chunked_body_len.c
new file mode 100644
index 00000000..c7fe0f97
--- /dev/null
+++ b/test_chunked_body_len.c
@@ -0,0 +1,29 @@
+#include <stdio.h>
+#include <string.h>
+
+int main() {
+    // Simulated buffer with chunked encoding: "10\r\n0123456789ABCDEF\r\n0\r\n\r\n"
+    // Chunk size: 10 (16 bytes in hex) = 16 bytes of body data
+    // Body data: "0123456789ABCDEF"
+    // Chunk framing: "10\r\n" + "\r\n" + "0\r\n\r\n" = 4 + 2 + 5 = 11 bytes
+    // Total buffer: 16 + 11 = 27 bytes
+    
+    const char buffer[] = "10\r\n0123456789ABCDEF\r\n0\r\n\r\n";
+    size_t buffer_len = sizeof(buffer) - 1; // Exclude null terminator = 27 bytes
+    
+    // Simulate the buffer after parsing headers
+    const char *body_frag_start = buffer + 3; // Point to "0123456789ABCDEF\r\n0\r\n\r\n"
+    size_t data_len = buffer_len; // 27 bytes (entire buffer)
+    
+    // Current (incorrect) calculation
+    size_t body_frag_len_incorrect = data_len - (body_frag_start - buffer);
+    printf("Buffer: '%s'\n", buffer);
+    printf("Buffer length: %zu\n", buffer_len);
+    printf("Body start offset: %zu\n", body_frag_start - buffer);
+    printf("Body frag start: '%s'\n", body_frag_start);
+    printf("Current (incorrect) body_frag_len: %zu\n", body_frag_len_incorrect);
+    printf("Expected body_frag_len: 16\n");
+    printf("Difference: %d bytes (chunk framing)\n", body_frag_len_incorrect - 16);
+    
+    return 0;
+}

+/*
+ * Copyright (c) 2024
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * @file
+ * @brief Driver for GPIO memory-mapped latched output port
+ *
+ * This is a driver for accessing an external latch-backed, memory-mapped
+ * output-only GPIO port. The latch is write-only with no hardware readback,
+ * so this driver maintains a software shadow of the last output value.
+ *
+ * Supported configurations:
+ * - 8/16/32-bit register width
+ * - Configurable number of GPIO lines (ngpios)
+ * - Output-only operation
+ * - Initial output value from device tree
+ * - Masked writes, set/clear/toggle operations
+ */
+
+#define DT_DRV_COMPAT gpio_mmio_latch
+
+#include <zephyr/irq.h>
+#include <errno.h>
+#include <zephyr/drivers/gpio/gpio_utils.h>
+#include <zephyr/devicetree.h>
+
+/* Register width configuration from device tree */
+#define GPIO_MMIO_LATCH_WIDTH_8  8
+#define GPIO_MMIO_LATCH_WIDTH_16 16
+#define GPIO_MMIO_LATCH_WIDTH_32 32
+
+/* Validate width configuration */
+#if DT_INST_NODE_HAS_PROP(0, reg_width)
+#define MMIO_LATCH_WIDTH DT_INST_PROP(0, reg_width)
+#else
+#define MMIO_LATCH_WIDTH GPIO_MMIO_LATCH_WIDTH_32
+#endif
+
+struct gpio_mmio_latch_config {
+	/* gpio_driver_config needs to be first */
+	struct gpio_driver_config common;
+	volatile void *reg;
+	uint32_t reg_width;
+};
+
+struct gpio_mmio_latch_context {
+	/* gpio_driver_data needs to be first */
+	struct gpio_driver_data common;
+	const struct gpio_mmio_latch_config *config;
+	/* Software shadow of the output register */
+	uint32_t shadow;
+};
+
+/* Helper function to get masked bits based on width */
+static inline uint32_t get_mask_for_width(uint32_t width)
+{
+	if (width == GPIO_MMIO_LATCH_WIDTH_8) {
+		return 0xFFU;
+	} else if (width == GPIO_MMIO_LATCH_WIDTH_16) {
+		return 0xFFFFU;
+	} else {
+		return 0xFFFFFFFFU;
+	}
+}
+
+/* Helper function to write to register with correct width */
+static inline void write_reg(volatile void *reg, uint32_t width, uint32_t value)
+{
+	if (width == GPIO_MMIO_LATCH_WIDTH_8) {
+		*(volatile uint8_t *)reg = (uint8_t)value;
+	} else if (width == GPIO_MMIO_LATCH_WIDTH_16) {
+		*(volatile uint16_t *)reg = (uint16_t)value;
+	} else {
+		*(volatile uint32_t *)reg = value;
+	}
+}
+
+/* Helper function to read from register with correct width */
+static inline uint32_t read_reg(volatile void *reg, uint32_t width)
+{
+	if (width == GPIO_MMIO_LATCH_WIDTH_8) {
+		return *(volatile uint8_t *)reg;
+	} else if (width == GPIO_MMIO_LATCH_WIDTH_16) {
+		return *(volatile uint16_t *)reg;
+	} else {
+		return *(volatile uint32_t *)reg;
+	}
+}
+
+int gpio_mmio_latch_init(const struct device *dev);
+
+static int gpio_mmio_latch_config(const struct device *dev, gpio_pin_t pin, gpio_flags_t flags)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+
+	if ((config->common.port_pin_mask & (1u << pin)) == 0) {
+		return -EINVAL; /* Pin not in our validity mask */
+	}
+
+	/* Check for unsupported configurations */
+	if (flags & (GPIO_INPUT | GPIO_PULL_UP | GPIO_PULL_DOWN |
+		     GPIO_OPEN_DRAIN | GPIO_OPEN_SOURCE | GPIO_SINGLE_ENDED)) {
+		return -ENOTSUP; /* Unsupported configuration */
+	}
+
+	/* Only support output configurations */
+	if ((flags & (GPIO_OUTPUT | GPIO_OUTPUT_INIT_LOW | GPIO_OUTPUT_INIT_HIGH)) == 0) {
+		return -ENOTSUP; /* Must be output */
+	}
+
+	/* Handle initialization */
+	if ((flags & (GPIO_OUTPUT_INIT_LOW | GPIO_OUTPUT_INIT_HIGH)) != 0) {
+		unsigned int key;
+		uint32_t mask = (1u << pin);
+
+		key = irq_lock();
+		if ((flags & GPIO_OUTPUT_INIT_HIGH) != 0) {
+			context->shadow |= mask;
+		} else {
+			context->shadow &= ~mask;
+		}
+		/* Write to hardware */
+		write_reg(config->reg, config->reg_width, context->shadow);
+		irq_unlock(key);
+	}
+
+	return 0;
+}
+
+static int gpio_mmio_latch_port_get_raw(const struct device *dev, uint32_t *value)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+	uint32_t mask = get_mask_for_width(config->reg_width);
+
+	/* Return software shadow, masked to valid bits */
+	*value = context->shadow & mask;
+
+	return 0;
+}
+
+static int gpio_mmio_latch_port_set_masked_raw(const struct device *dev, uint32_t mask, uint32_t value)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+	volatile void *reg = config->reg;
+	uint32_t reg_mask = get_mask_for_width(config->reg_width);
+	unsigned int key;
+
+	mask &= config->common.port_pin_mask;
+	value &= reg_mask & mask;
+
+	/* Update shadow and write to hardware */
+	key = irq_lock();
+	context->shadow = (context->shadow & ~mask) | value;
+	write_reg(reg, config->reg_width, context->shadow);
+	irq_unlock(key);
+
+	return 0;
+}
+
+static int gpio_mmio_latch_port_set_bits_raw(const struct device *dev, uint32_t mask)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+	volatile void *reg = config->reg;
+	unsigned int key;
+
+	mask &= config->common.port_pin_mask;
+
+	/* Update shadow and write to hardware */
+	key = irq_lock();
+	context->shadow |= mask;
+	write_reg(reg, config->reg_width, context->shadow);
+	irq_unlock(key);
+
+	return 0;
+}
+
+static int gpio_mmio_latch_port_clear_bits_raw(const struct device *dev, uint32_t mask)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+	volatile void *reg = config->reg;
+	unsigned int key;
+
+	mask &= config->common.port_pin_mask;
+
+	/* Update shadow and write to hardware */
+	key = irq_lock();
+	context->shadow &= ~mask;
+	write_reg(reg, config->reg_width, context->shadow);
+	irq_unlock(key);
+
+	return 0;
+}
+
+static int gpio_mmio_latch_port_toggle_bits(const struct device *dev, uint32_t mask)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+	volatile void *reg = config->reg;
+	unsigned int key;
+
+	mask &= config->common.port_pin_mask;
+
+	/* Update shadow and write to hardware */
+	key = irq_lock();
+	context->shadow ^= mask;
+	write_reg(reg, config->reg_width, context->shadow);
+	irq_unlock(key);
+
+	return 0;
+}
+
+int gpio_mmio_latch_pin_interrupt_configure(const struct device *port,
+					gpio_pin_t pin,
+					enum gpio_int_mode mode,
+					enum gpio_int_trig trig)
+{
+	return -ENOTSUP; /* Interrupts not supported */
+}
+
+DEVICE_API(gpio, gpio_mmio_latch_api) = {
+	.pin_configure = gpio_mmio_latch_config,
+	.port_get_raw = gpio_mmio_latch_port_get_raw,
+	.port_set_masked_raw = gpio_mmio_latch_port_set_masked_raw,
+	.port_set_bits_raw = gpio_mmio_latch_port_set_bits_raw,
+	.port_clear_bits_raw = gpio_mmio_latch_port_clear_bits_raw,
+	.port_toggle_bits = gpio_mmio_latch_port_toggle_bits,
+	.pin_interrupt_configure = gpio_mmio_latch_pin_interrupt_configure,
+};
+
+int gpio_mmio_latch_init(const struct device *dev)
+{
+	struct gpio_mmio_latch_context *context = dev->data;
+	const struct gpio_mmio_latch_config *config = context->config;
+	volatile void *reg = config->reg;
+	uint32_t initial_output;
+
+	context->config = config;
+
+	/* Get initial output value from device tree, default to 0 */
+	if (DT_INST_NODE_HAS_PROP(0, initial_output)) {
+		initial_output = DT_INST_PROP(0, initial_output);
+	} else {
+		initial_output = 0;
+	}
+
+	/* Initialize shadow register */
+	context->shadow = initial_output;
+
+	/* Write initial value to hardware */
+	write_reg(reg, config->reg_width, context->shadow);
+
+	return 0;
+}
+
+#define MMIO_LATCH_GPIO_DEVICE(n)                                                                   \
+	static struct gpio_mmio_latch_context gpio_mmio_latch_##n##_ctx;                          \
+                                                                                                  \
+	static const struct gpio_mmio_latch_config gpio_mmio_latch_##n##_cfg = {                 \
+		.common = GPIO_COMMON_CONFIG_FROM_DT_INST(n),                                       \
+		.reg = (volatile void *)DT_INST_REG_ADDR(n),                                        \
+		.reg_width = DT_INST_PROP_OR(n, reg_width, 32),                                      \
+	};                                                                                         \
+                                                                                                  \
+	DEVICE_DT_INST_DEFINE(n, gpio_mmio_latch_init, NULL, &gpio_mmio_latch_##n##_ctx,         \
+			      &gpio_mmio_latch_##n##_cfg, PRE_KERNEL_1,                           \
+			      CONFIG_KERNEL_INIT_PRIORITY_DEVICE, &gpio_mmio_latch_api);
+
+DT_INST_FOREACH_STATUS_OKAY(MMIO_LATCH_GPIO_DEVICE)

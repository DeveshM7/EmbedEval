+# Copyright (c) 2024
+# SPDX-License-Identifier: Apache-2.0
+
+description: GPIO memory-mapped latched output
+
+compatible: "gpio-mmio-latch"
+
+include: [gpio-controller.yaml, base.yaml]
+
+properties:
+  reg:
+    required: true
+    description: Memory-mapped register address of the latch
+
+  ngpios:
+    required: true
+    description: Number of valid GPIO lines (up to register width)
+
+  reg_width:
+    type: int
+    default: 32
+    description: |
+      Register width in bits. Must be one of 8, 16, or 32.
+      Defaults to 32 if not specified.
+
+  initial_output:
+    type: int
+    default: 0
+    description: |
+      Initial value to write to the latch on driver initialization.
+      This value is also used to initialize the software shadow register.
+
+  "#gpio-cells":
+    const: 1
+
+gpio-cells:
+  - pin

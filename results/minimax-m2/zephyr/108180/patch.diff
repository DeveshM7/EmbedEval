+int z_impl_net_socket_service_close(const struct net_socket_service_desc *svc)
+{
+	int ret = 0;
+	int i;
+	int timeout_ms = 5000;  /* 5 second timeout */
+
+	k_mutex_lock(&lock, K_FOREVER);
+
+	if (thread_status == SOCKET_SERVICE_THREAD_UNINITIALIZED) {
+		(void)k_condvar_wait(&wait_start, &lock, K_FOREVER);
+	} else if (thread_status != SOCKET_SERVICE_THREAD_RUNNING) {
+		NET_ERR("Socket service thread not running");
+		ret = -EIO;
+		goto out;
+	}
+
+	if (thread_status != SOCKET_SERVICE_THREAD_RUNNING) {
+		NET_ERR("Socket service thread not running");
+		ret = -EIO;
+		goto out;
+	}
+
+	if (STRUCT_SECTION_START(net_socket_service_desc) > svc ||
+	    STRUCT_SECTION_END(net_socket_service_desc) <= svc) {
+		ret = -ENOENT;
+		goto out;
+	}
+
+	/* Collect all socket fds from this service */
+	close_queue.count = 0;
+	close_queue.service_idx = get_idx(svc);
+	close_queue.active = true;
+
+	for (i = 0; i < svc->pev_len; i++) {
+		if (svc->pev[i].event.fd >= 0 && close_queue.count < CONFIG_ZVFS_POLL_MAX) {
+			close_queue.fds[close_queue.count++] = svc->pev[i].event.fd;
+		}
+	}
+
+	if (close_queue.count == 0) {
+		NET_DBG("No sockets to close for service %p", svc);
+		close_queue.active = false;
+		ret = 0;
+		goto out;
+	}
+
+	/* Unregister the service first */
+	cleanup_svc_events(svc);
+
+	/* Trigger the service thread to close the sockets */
+	zvfs_eventfd_write(ctx.events[0].fd, 1);
+
+	k_mutex_unlock(&lock);
+
+	/* Wait for the sockets to be closed */
+	ret = k_sem_take(&close_sem, K_MSEC(timeout_ms));
+	if (ret != 0) {
+	NET_DBG("Waiting for sockets to be closed, active=%d", close_queue.active);
+		NET_ERR("Timeout waiting for sockets to be closed");
+		ret = -ETIMEDOUT;
+	}
+
+	return ret;
+
+out:
+	k_mutex_unlock(&lock);
+	return ret;
+}

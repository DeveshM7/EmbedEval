diff --git a/subsys/shell/shell_aliases.c b/subsys/shell/shell_aliases.c
new file mode 100644
index 000000000..34e5bb861
--- /dev/null
+++ b/subsys/shell/shell_aliases.c
@@ -0,0 +1,260 @@
+/*
+ * Copyright (c) 2024 Nordic Semiconductor ASA
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/shell/shell.h>
+#include <zephyr/sys/iterable_sections.h>
+#include <string.h>
+#include <stdlib.h>
+
+/* Maximum number of aliases */
+#ifndef CONFIG_SHELL_ALIASES_MAX
+#define CONFIG_SHELL_ALIASES_MAX	32
+#endif
+
+/* Include generated aliases */
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE) && defined(CONFIG_SHELL_ALIASES)
+#include "shell_aliases.inc"
+#endif
+
+/* Storage for aliases - will be filled by init */
+static const struct shell_alias *all_aliases[CONFIG_SHELL_ALIASES_MAX];
+static size_t alias_count;
+
+/* Initialize aliases array */
+static void aliases_init(void)
+{
+	size_t i = 0;
+
+#if defined(CONFIG_SHELL_ALIASES)
+	/* Add built-in '?' alias that expands to 'help' */
+	static const struct shell_alias builtin_alias = {
+		.name = "?",
+		.expansion = "help"
+	};
+
+	all_aliases[i++] = &builtin_alias;
+
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE)
+	/* Add user-defined aliases from generated file */
+	for (size_t j = 0; j < ARRAY_SIZE(shell_user_aliases) && i < CONFIG_SHELL_ALIASES_MAX; j++, i++) {
+		all_aliases[i] = shell_user_aliases[j];
+	}
+#endif
+
+	alias_count = i;
+#else
+	alias_count = 0;
+#endif
+}
+
+/* Check if an alias name collides with a shell command */
+static bool alias_collision(const char *alias_name)
+{
+	const size_t cmd_count = shell_root_cmd_count();
+
+	/* Check against all root commands */
+	for (size_t i = 0; i < cmd_count; i++) {
+		if (strcmp(alias_name, shell_root_cmd_get(i)->entry->syntax) == 0) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+/* Print warning for colliding aliases */
+static void print_collision_warnings(void)
+{
+#if defined(CONFIG_SHELL_ALIASES)
+	for (size_t i = 0; i < alias_count; i++) {
+		if (alias_collision(all_aliases[i]->name)) {
+			z_shell_fprintf(NULL, SHELL_WARNING,
+					"Warning: Alias '%s' ignored because "
+					"command exists in current context\n",
+					all_aliases[i]->name);
+		}
+	}
+#endif
+}
+
+/* Get total number of non-colliding aliases */
+static size_t get_alias_count(void)
+{
+	size_t count = 0;
+
+#if defined(CONFIG_SHELL_ALIASES)
+	for (size_t i = 0; i < alias_count; i++) {
+		if (!alias_collision(all_aliases[i]->name)) {
+			count++;
+		}
+	}
+#endif
+	return count;
+}
+
+/* Find alias by name */
+static const struct shell_alias *find_alias(const char *name)
+{
+#if defined(CONFIG_SHELL_ALIASES)
+	for (size_t i = 0; i < alias_count; i++) {
+		if (!alias_collision(all_aliases[i]->name) &&
+		    strcmp(name, all_aliases[i]->name) == 0) {
+			return all_aliases[i];
+		}
+	}
+#endif
+	return NULL;
+}
+
+/* Expand alias in command buffer */
+static bool expand_alias(const struct shell *sh, char *cmd_buffer,
+			size_t *cmd_len)
+{
+	const struct shell_alias *alias;
+	size_t space_idx = 0;
+	size_t alias_len;
+
+	/* Find first space to get alias name */
+	while (space_idx < *cmd_len && cmd_buffer[space_idx] != ' ') {
+		space_idx++;
+	}
+
+	alias_len = space_idx;
+	if (alias_len == 0) {
+		return false;
+	}
+
+	/* Create temporary buffer for alias name */
+	char alias_name[32]; /* Reasonable limit for alias names */
+
+	if (alias_len >= sizeof(alias_name)) {
+		return false;
+	}
+
+	memcpy(alias_name, cmd_buffer, alias_len);
+	alias_name[alias_len] = '\0';
+
+	/* Look up alias */
+	alias = find_alias(alias_name);
+	if (alias == NULL) {
+		return false;
+	}
+
+	/* Check if expansion would exceed buffer size */
+	size_t remaining_len = *cmd_len - alias_len;
+	size_t expansion_len = strlen(alias->expansion);
+
+	if (expansion_len + remaining_len + 1 >= CONFIG_SHELL_CMD_BUFF_SIZE) {
+		return false;
+	}
+
+	/* Build new command */
+	char new_cmd[CONFIG_SHELL_CMD_BUFF_SIZE];
+
+	strcpy(new_cmd, alias->expansion);
+
+	/* Add space if there are remaining arguments */
+	if (remaining_len > 0) {
+		new_cmd[expansion_len] = ' ';
+		expansion_len++;
+	}
+
+	/* Add remaining arguments */
+	if (remaining_len > 0) {
+		strcpy(new_cmd + expansion_len, cmd_buffer + alias_len + 1,
+			remaining_len);
+		expansion_len += remaining_len;
+	}
+
+	new_cmd[expansion_len] = '\0';
+
+	/* Copy back to command buffer */
+	strcpy(cmd_buffer, new_cmd);
+	*cmd_len = expansion_len;
+
+	return true;
+}
+
+/* 'aliases' command handler */
+static int cmd_aliases(const struct shell *sh, size_t argc, char **argv)
+{
+	const struct shell_alias *alias;
+	size_t displayed = 0;
+
+	aliases_init();
+
+	z_shell_fprintf(sh, SHELL_NORMAL, "Configured aliases:\n");
+
+#if defined(CONFIG_SHELL_ALIASES)
+	for (size_t i = 0; i < alias_count; i++) {
+		alias = all_aliases[i];
+
+		/* Skip colliding aliases */
+		if (alias_collision(alias->name)) {
+			continue;
+		}
+
+		z_shell_fprintf(sh, SHELL_NORMAL, "  %-16s -> %s\n",
+				alias->name, alias->expansion);
+		displayed++;
+	}
+#endif
+
+	if (displayed == 0) {
+		z_shell_fprintf(sh, SHELL_NORMAL, "  None\n");
+	}
+
+	return 0;
+}
+
+/* Register aliases command */
+SHELL_CMD_ARG_REGISTER(aliases, NULL, "List configured aliases", cmd_aliases, 1, 0);
+
+/* Export functions for shell core */
+int shell_aliases_init(void)
+{
+	aliases_init();
+	print_collision_warnings();
+	return 0;
+}
+
+bool shell_aliases_expand(const struct shell *sh, char *cmd, size_t *len)
+{
+#if defined(CONFIG_SHELL_ALIASES)
+	return expand_alias(sh, cmd, len);
+#else
+	ARG_UNUSED(sh);
+	ARG_UNUSED(cmd);
+	ARG_UNUSED(len);
+	return false;
+#endif
+}
+
+const struct shell_alias *shell_aliases_get(size_t idx)
+{
+#if defined(CONFIG_SHELL_ALIASES)
+	size_t valid_idx = 0;
+
+	for (size_t i = 0; i < alias_count; i++) {
+		if (!alias_collision(all_aliases[i]->name)) {
+			if (valid_idx == idx) {
+				return all_aliases[i];
+			}
+			valid_idx++;
+		}
+	}
+#endif
+	return NULL;
+}
+
+size_t shell_aliases_count(void)
+{
+#if defined(CONFIG_SHELL_ALIASES)
+	return get_alias_count();
+#else
+	return 0;
+#endif
+}

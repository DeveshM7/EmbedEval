diff --git a/subsys/shell/CMakeLists.txt b/subsys/shell/CMakeLists.txt
index 16e66b624..4b6de6178 100644
--- a/subsys/shell/CMakeLists.txt
+++ b/subsys/shell/CMakeLists.txt
@@ -46,3 +46,107 @@ zephyr_sources_ifdef(
   CONFIG_SHELL_WILDCARD
   shell_wildcard.c
   )
+
+# Shell aliases support
+zephyr_sources_ifdef(
+  CONFIG_SHELL_ALIASES
+  shell_aliases.c
+  )
+
+# Function to generate shell aliases include file
+function(generate_shell_aliases_inc_file_for_target target source_file generated_file)
+
+  # Parse aliases file and generate include file
+  # Format: alias_name=expansion or alias_name expansion
+  file(READ ${source_file} ALIASES_FILE_CONTENT)
+
+  # Create the generated include file
+  file(WRITE ${generated_file} "/* Auto-generated shell aliases include file */\n")
+  file(APPEND ${generated_file} "#include <zephyr/sys/iterable_sections.h>\n\n")
+
+  # Process each line
+  string(REPLACE ";" "\\;" ALIASES_FILE_CONTENT ${ALIASES_FILE_CONTENT})
+  string(REPLACE "\n" ";" ALIASES_LINES ${ALIASES_FILE_CONTENT})
+
+  foreach(ALIAS_LINE ${ALIASES_LINES})
+    # Skip empty lines and comments
+    if(ALIAS_LINE STREQUAL "")
+      continue()
+    endif()
+
+    string(SUBSTRING ${ALIAS_LINE} 0 1 FIRST_CHAR)
+    if(FIRST_CHAR STREQUAL "#")
+      continue()
+    endif()
+
+    # Parse alias definition
+    # Try '=' first, then whitespace
+    string(FIND ${ALIAS_LINE} "=" EQUALS_POS)
+    if(EQUALS_POS GREATER -1)
+      # Format: name=expansion
+      string(SUBSTRING ${ALIAS_LINE} 0 ${EQUALS_POS} ALIAS_NAME)
+      string(SUBSTRING ${ALIAS_LINE} ${EQUALS_POS} -1 ALIAS_RHS)
+      string(SUBSTRING ${ALIAS_RHS} 1 -1 ALIAS_EXPANSION)
+    else()
+      # Format: name expansion
+      string(REPLACE " " ";" ALIAS_PARTS ${ALIAS_LINE})
+      list(LENGTH ALIAS_PARTS PARTS_COUNT)
+      if(PARTS_COUNT GREATER 1)
+        list(GET ALIAS_PARTS 0 ALIAS_NAME)
+        list(GET ALIAS_PARTS 1 ALIAS_EXPANSION)
+      else()
+        message(WARNING "Invalid alias definition: ${ALIAS_LINE}")
+        continue()
+      endif()
+    endif()
+
+    # Remove leading/trailing whitespace
+    string(STRIP ${ALIAS_NAME} ALIAS_NAME)
+    string(STRIP ${ALIAS_EXPANSION} ALIAS_EXPANSION)
+
+    # Add to include file
+    file(APPEND ${generated_file}
+      "static const struct shell_alias shell_alias_${ALIAS_NAME} = {\n")
+    file(APPEND ${generated_file}
+      "  .name = \"${ALIAS_NAME}\",\n")
+    file(APPEND ${generated_file}
+      "  .expansion = \"${ALIAS_EXPANSION}\"\n")
+    file(APPEND ${generated_file "};\n\n")
+  endforeach()
+
+  # Add array declaration
+  file(APPEND ${generated_file}
+    "static const struct shell_alias *const shell_user_aliases[] = {\n")
+  string(REPLACE ";" "\\;" ALIASES_FILE_CONTENT ${ALIASES_FILE_CONTENT})
+  string(REPLACE "\n" ";" ALIASES_LINES ${ALIASES_FILE_CONTENT})
+  foreach(ALIAS_LINE ${ALIASES_LINES})
+    if(ALIAS_LINE STREQUAL "")
+      continue()
+    endif()
+    string(SUBSTRING ${ALIAS_LINE} 0 1 FIRST_CHAR)
+    if(FIRST_CHAR STREQUAL "#")
+      continue()
+    endif()
+    string(FIND ${ALIAS_LINE} "=" EQUALS_POS)
+    if(EQUALS_POS GREATER -1)
+      string(SUBSTRING ${ALIAS_LINE} 0 ${EQUALS_POS} ALIAS_NAME)
+    else()
+      string(REPLACE " " ";" ALIAS_PARTS ${ALIAS_LINE})
+      list(LENGTH ALIAS_PARTS PARTS_COUNT)
+      if(PARTS_COUNT GREATER 1)
+        list(GET ALIAS_PARTS 0 ALIAS_NAME)
+      else()
+        continue()
+      endif()
+    endif()
+    string(STRIP ${ALIAS_NAME} ALIAS_NAME)
+    file(APPEND ${generated_file}
+      "  &shell_alias_${ALIAS_NAME},\n")
+  endforeach()
+  file(APPEND ${generated_file} "};\n")
+
+  # Create custom target
+  add_custom_target(shell_aliases_${target} DEPENDS ${generated_file})
+  add_dependencies(${target} shell_aliases_${target})
+
+endfunction()

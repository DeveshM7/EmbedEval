+#include <stdio.h>
+#include <zephyr/pm/policy.h>
+#include <zephyr/sys/slist.h>
+
+/* Dummy test to check if the code compiles and link */
+int main() {
+    struct pm_policy_latency_subscription subs;
+    struct pm_policy_latency_request req;
+    
+    /* Test 1: Subscribe with non-NULL */
+    pm_policy_latency_changed_subscribe(&subs, (pm_policy_latency_changed_cb_t)1);
+    
+    /* Test 2: Subscribe with NULL */
+    pm_policy_latency_changed_subscribe(&subs, NULL);
+    
+    printf("Test passed\n");
+    return 0;
+}
diff --git a/test_slist.c b/test_slist.c
new file mode 100644
index 00000000..45004a58
--- /dev/null
+++ b/test_slist.c
@@ -0,0 +1,36 @@
+#include <stdio.h>
+#include <zephyr/sys/slist.h>
+
+struct test_node {
+    sys_snode_t node;
+    int value;
+};
+
+int main() {
+    sys_slist_t list;
+    sys_slist_init(&list);
+    
+    struct test_node n1 = { .value = 1 };
+    struct test_node n2 = { .value = 2 };
+    struct test_node n3 = { .value = 3 };
+    
+    sys_slist_append(&list, &n1.node);
+    sys_slist_append(&list, &n2.node);
+    sys_slist_append(&list, &n3.node);
+    
+    printf("Before removal:\n");
+    struct test_node *node;
+    SYS_SLIST_FOR_EACH_CONTAINER(&list, node, node) {
+        printf("  %d\n", node->value);
+    }
+    
+    printf("Removing n2...\n");
+    sys_slist_find_and_remove(&list, &n2.node);
+    
+    printf("After removal:\n");
+    SYS_SLIST_FOR_EACH_CONTAINER(&list, node, node) {
+        printf("  %d\n", node->value);
+    }
+    
+    return 0;
+}

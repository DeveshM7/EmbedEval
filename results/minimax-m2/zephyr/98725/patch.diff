diff --git a/include/zephyr/net_buf.h b/include/zephyr/net_buf.h
index 6f06cca3..79953791 100644
--- a/include/zephyr/net_buf.h
+++ b/include/zephyr/net_buf.h
@@ -1372,6 +1372,26 @@ struct net_buf_pool *net_buf_pool_get(int id);
  */
 int net_buf_id(const struct net_buf *buf);
 
+/**
+ * @brief Get the number of available buffers in a pool.
+ *
+ * @param pool Which pool to query.
+ *
+ * @return Number of available buffers in the pool, or 0 if
+ *         CONFIG_NET_BUF_POOL_USAGE is not enabled.
+ */
+size_t net_buf_get_available(const struct net_buf_pool *pool);
+
+/**
+ * @brief Get the maximum number of buffers simultaneously used from a pool.
+ *
+ * @param pool Which pool to query.
+ *
+ * @return Maximum number of buffers simultaneously used from the pool, or 0 if
+ *         CONFIG_NET_BUF_POOL_USAGE is not enabled.
+ */
+size_t net_buf_get_max_used(const struct net_buf_pool *pool);
+
 /**
  * @brief Allocate a new fixed buffer from a pool.
  *
diff --git a/lib/net_buf/buf.c b/lib/net_buf/buf.c
index 9a32aedd..592c34f8 100644
--- a/lib/net_buf/buf.c
+++ b/lib/net_buf/buf.c
@@ -745,3 +745,23 @@ size_t net_buf_data_match(const struct net_buf *buf, size_t offset, const void *
 
 	return compared;
 }
+
+size_t net_buf_get_available(const struct net_buf_pool *pool)
+{
+#if defined(CONFIG_NET_BUF_POOL_USAGE)
+	return atomic_get(&pool->avail_count);
+#else
+	ARG_UNUSED(pool);
+	return 0;
+#endif
+}
+
+size_t net_buf_get_max_used(const struct net_buf_pool *pool)
+{
+#if defined(CONFIG_NET_BUF_POOL_USAGE)
+	return pool->max_used;
+#else
+	ARG_UNUSED(pool);
+	return 0;
+#endif
+}

diff --git a/subsys/net/ip/Kconfig b/subsys/net/ip/Kconfig
index aa95a88e..fdba07ff 100644
--- a/subsys/net/ip/Kconfig
+++ b/subsys/net/ip/Kconfig
@@ -509,6 +509,24 @@ config NET_UDP_MISSING_CHECKSUM
 	  for IPv4 and on reception only, since Zephyr will always compute the
 	  UDP checksum in transmission path.
 
+# Checksum offloading support
+config NET_CHECKSUM_OFFLOAD_SUPPORTED
+	bool
+	help
+	  Hidden option enabled by ethernet drivers that support hardware
+	  checksum offloading. This indicates that the platform has hardware
+	  support for TX and RX checksum offloading.
+
+config NET_CHECKSUM_OFFLOAD
+	bool "Enable checksum offloading"
+	default y
+	depends on NET_CHECKSUM_OFFLOAD_SUPPORTED
+	help
+	  Enables hardware checksum offloading for network packets. When enabled
+	  and the ethernet driver supports it, TX and RX checksums will be
+	  calculated by the hardware rather than software.
+
+
 if NET_UDP
 module = NET_UDP
 module-dep = NET_LOG

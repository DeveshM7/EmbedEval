@@ -148,6 +148,34 @@ static inline int _zbus_notify_observer(const struct zbus_channel *chan,
 	}
 #endif /* CONFIG_ZBUS_MSG_SUBSCRIBER */
 
+#if defined(CONFIG_ZBUS_ASYNC_LISTENER)
+	case ZBUS_OBSERVER_ASYNC_LISTENER_TYPE: {
+		/* Verify the observer is enabled */
+		if (!obs->data->enabled) {
+			break;
+		}
+
+		/* Verify the work structure exists */
+		if (obs->work == NULL) {
+			return -EINVAL;
+		}
+
+		/* Set the channel and message in the work structure */
+		obs->work->chan = chan;
+		obs->work->message = zbus_chan_msg(chan);
+
+		/* Submit work to the work queue */
+		if (obs->work->queue != NULL) {
+			k_work_submit_to_queue(obs->work->queue, &obs->work->work);
+		} else {
+			/* Use system work queue by default */
+			k_work_submit(&obs->work->work);
+		}
+
+		break;
+	}
+#endif /* CONFIG_ZBUS_ASYNC_LISTENER */
+
 	default:
 		_ZBUS_ASSERT(false, "Unreachable");
 	}

diff --git a/verify_fix.c b/verify_fix.c
new file mode 100644
index 00000000..e545197f
--- /dev/null
+++ b/verify_fix.c
@@ -0,0 +1,53 @@
+/* Simple test to verify the fix for detached thread join */
+
+#include <pthread.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <errno.h>
+
+static void *thread_func(void *arg)
+{
+  return NULL;
+}
+
+int main()
+{
+  pthread_t thread;
+  void *result;
+  int status;
+
+  printf("Test 1: Detach a thread and join after it exits\n");
+  status = pthread_create(&thread, NULL, thread_func, NULL);
+  if (status != 0)
+    {
+      printf("ERROR: pthread_create failed: %d\n", status);
+      return 1;
+    }
+
+  status = pthread_detach(thread);
+  if (status != 0)
+    {
+      printf("ERROR: pthread_detach failed: %d\n", status);
+      return 1;
+    }
+
+  sleep(1);  /* Let thread exit */
+
+  status = pthread_join(thread, &result);
+  printf("pthread_join returned: %d\n", status);
+  
+  if (status == ESRCH)
+    {
+      printf("PASS: Got ESRCH as expected\n");
+    }
+  else if (status == EINVAL)
+    {
+      printf("FAIL: Got EINVAL (bug not fixed)\n");
+    }
+  else
+    {
+      printf("FAIL: Got unexpected status %d\n", status);
+    }
+
+  return 0;
+}

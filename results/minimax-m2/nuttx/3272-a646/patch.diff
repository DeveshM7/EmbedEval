+/****************************************************************************
+ * Name: getopt_long
+ *
+ * Description:
+ *   getopt_long() works like getopt() except that it also accepts long
+ *   options prefixed with "--". If the option takes a value, that value
+ *   can be specified as either:
+ *     --option value
+ *     --option=value
+ *   Long option names may be abbreviated if the abbreviation is unique.
+ *
+ * Input Parameters:
+ *   argc, argv - Standard argument count and array
+ *   shortopts - Short options string
+ *   longopts - Array of struct option describing long options
+ *   longind - If not NULL, the index of the long option in longopts is stored here
+ *
+ * Returned Value:
+ *   Returns the option character for short options, 0 for long options,
+ *   -1 if no more options, '?' for unrecognized option, ':' for missing
+ *   argument (if optstring starts with ':').
+ *
+ *****************************************************************************/
+
 int getopt_long(int argc, FAR char *const argv[],
                 FAR const char *shortopts,
                 FAR const struct option *longopts,
                 FAR int *longind)
 {
+  FAR struct getopt_s *go = getoptvars();
+  int ret;
+
+  if (go == NULL)
+    {
+      return '?';
+    }
+
+  /* If longopts is NULL, just call getopt */
+  if (!longopts)
+    {
+      return getopt(argc, argv, shortopts);
+    }
+
+  /* Check if we're at the start of a new argument */
+  if (!go->go_optptr || !*go->go_optptr)
+    {
+      /* Check if current argument is a long option */
+      if (argv[go->go_optind] && 
+          strncmp(argv[go->go_optind], "--", 2) == 0 &&
+          argv[go->go_optind][2] != '\0')
+        {
+          /* It's a long option */
+          go->go_optptr = argv[go->go_optind] + 2;
+          ret = getopt_parse_long(argc, argv, longopts, longind, shortopts);
+          return ret;
+        }
+    }
+
+  /* Not a long option or not at start of argument, let getopt handle it */
+  return getopt(argc, argv, shortopts);
+}
+
+/****************************************************************************
+ * Name: getopt_long_only
+ *
+ * Description:
+ *   getopt_long_only() is like getopt_long(), except that long options
+ *   can also be prefixed with a single dash ("-"). This is useful for
+ *   programs that primarily use short options but want to support some
+ *   long options for backward compatibility.
+ *
+ *   If an option starting with "-" doesn't match a long option, it is
+ *   treated as a short option.
+ *
+ * Input Parameters:
+ *   argc, argv - Standard argument count and array
+ *   shortopts - Short options string
+ *   longopts - Array of struct option describing long options
+ *   longind - If not NULL, the index of the long option in longopts is stored here
+ *
+ * Returned Value:
+ *   Returns the option character for short options, 0 for long options,
+ *   -1 if no more options, '?' for unrecognized option, ':' for missing
+ *   argument (if optstring starts with ':').
+ *
+ *****************************************************************************/
+
+int getopt_long_only(int argc, FAR char *const argv[],
+                     FAR const char *shortopts,
+                     FAR const struct option *longopts,
+                     FAR int *longind)
+{
+  FAR struct getopt_s *go = getoptvars();
+  int ret;
+
+  if (go == NULL)
+    {
+      return '?';
+    }
+
+  /* If longopts is NULL, just call getopt */
+  if (!longopts)
+    {
+      return getopt(argc, argv, shortopts);
+    }
+
+  /* Check if we're at the start of a new argument */
+  if (!go->go_optptr || !*go->go_optptr)
+    {
+      /* Check if current argument is a long option (starts with "-" but not just "-") */
+      if (argv[go->go_optind] && 
+          argv[go->go_optind][0] == '-' && 
+          argv[go->go_optind][1] != '\0')
+        {
+          /* It's potentially a long option */
+          go->go_optptr = argv[go->go_optind];
+          
+          /* Try to parse it as a long option */
+          ret = getopt_parse_long(argc, argv, longopts, longind, shortopts);
+          
+          /* If it was parsed as a long option, return the result */
+          if (ret != -1)
+            {
+              return ret;
+            }
+          
+          /* Not a long option, reset and let getopt handle it */
+          go->go_optptr = NULL;
+        }
+    }
+
+  /* Not a long option, let getopt handle it */
   return getopt(argc, argv, shortopts);
 }

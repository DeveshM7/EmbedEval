+/****************************************************************************
+ * Name: find_long_option
+ *
+ * Description:
+ *   Find a long option in the option table that matches the given string.
+ *
+ * Input Parameters:
+ *   name - The name to match
+ *   longopts - The option table
+ *   len - The length of the name to match
+ *   exact - If true, only exact matches are considered
+ *
+ * Returned Value:
+ *   The index of the matching option in the longopts table, or -1 if not found
+ *
+ *****************************************************************************/
+
+static int find_long_option(FAR const char *name,
+                            FAR const struct option *longopts,
+                            int len,
+                            bool exact)
+{
+  int i;
+  int nmatch = 0;
+  int match_idx = -1;
+
+  if (!name || !longopts)
+    {
+      return -1;
+    }
+
+  for (i = 0; longopts[i].name; i++)
+    {
+      if (strncmp(longopts[i].name, name, len) == 0)
+        {
+          if (strlen(longopts[i].name) == len)
+            {
+              /* Exact match */
+              return i;
+            }
+          else if (!exact)
+            {
+              /* Prefix match - keep track but keep searching for exact match */
+              nmatch++;
+              match_idx = i;
+            }
+        }
+    }
+
+  /* Return prefix match if no exact match found */
+  return (nmatch == 1) ? match_idx : -1;
+}

+/****************************************************************************
+ * Name: getopt_parse_long
+ *
+ * Description:
+ *   Parse a long option from argv.
+ *
+ * Input Parameters:
+ *   argc, argv - Standard argument count and array
+ *   longopts - Array of struct option describing long options
+ *   longind - If not NULL, the index of the long option in longopts is stored here
+ *
+ * Returned Value:
+ *   Returns 0 if a long option was found, -1 if not a long option,
+ *   '?' for unrecognized option.
+ *
+ *****************************************************************************/
+
+static int getopt_parse_long(int argc, FAR char *const argv[],
+                             FAR const struct option *longopts,
+                             FAR int *longind,
+                             FAR const char *optstring)
+{
+  FAR struct getopt_s *go = getoptvars();
+  FAR const char *optname;
+  FAR const char *eq;
+  int len;
+  int idx;
+
+  if (!go || !argv || !argv[go->go_optind])
+    {
+      return -1;
+    }
+
+  /* Check if current argument is a long option */
+  if (go->go_optptr[0] != '-' || go->go_optptr[1] == '\0')
+    {
+      /* Not a valid long option */
+      return -1;
+    }
+
+  /* Skip the initial "-" */
+  if (go->go_optptr[1] == '-')
+    {
+      /* Double dash "--" */
+      optname = go->go_optptr + 2;
+      if (*optname == '\0')
+        {
+          /* Empty "--", skip it */
+          go->go_optind++;
+          go->go_optptr = NULL;
+          return -1;
+        }
+    }
+  else
+    {
+      /* Single dash "-" for long options (getopt_long_only only) */
+      optname = go->go_optptr + 1;
+      if (*optname == '\0')
+        {
+          /* Empty "-", skip it */
+          go->go_optind++;
+          go->go_optptr = NULL;
+          return -1;
+        }
+    }
+
+  /* Find the equals sign for --option=value */
+  eq = strchr(optname, '=');
+  len = eq ? eq - optname : strlen(optname);
+
+  /* Try to match long option */
+  idx = find_long_option(optname, longopts, len, false);
+
+  if (idx < 0)
+    {
+      /* No match found */
+      go->go_optopt = 0;
+      go->go_optind++;
+      go->go_optptr = NULL;
+      return '?';
+    }
+
+  /* Store the index if requested */
+  if (longind)
+    {
+      *longind = idx;
+    }
+
+  /* Handle argument based on has_arg */
+  if (longopts[idx].has_arg == required_argument)
+    {
+      /* Argument required */
+      if (eq)
+        {
+          /* Argument is after "=" */
+          go->go_optarg = (FAR char *)(eq + 1);
+        }
+      else
+        {
+          /* Argument is in next argv element */
+          go->go_optarg = argv[go->go_optind + 1];
+          if (go->go_optarg && *go->go_optarg != '-')
+            {
+              go->go_optind++;
+            }
+          else
+            {
+              /* Missing argument */
+              go->go_optarg = NULL;
+              go->go_optopt = 0;
+              go->go_optind++;
+              return optstring && *optstring == ':' ? ':' : '?';
+            }
+        }
+    }
+  else if (longopts[idx].has_arg == optional_argument)
+    {
+    /* Optional argument - check if there's one */
+    if (eq)
+      {
+        go->go_optarg = (FAR char *)(eq + 1);
+      }
+    else
+      {
+        /* Check next argv */
+        go->go_optarg = argv[go->go_optind + 1];
+        if (go->go_optarg && *go->go_optarg != '-')
+          {
+            go->go_optind++;
+          }
+        else
+          {
+            go->go_optarg = NULL;
+          }
+      }
+  }
+  else
+    {
+      /* No argument */
+      go->go_optarg = NULL;
+    }
+
+  go->go_optind++;
+  go->go_optptr = NULL;
+
+  /* Return 0 for long option */
+  return 0;
+}

 #include <arch/setjmp.h>
 
-/**************************************************************************
+/***********************************************************************
  * Pre-processor Definitions
- **************************************************************************/
+ ***********************************************************************/
 
 #ifdef __CYGWIN__
 #  define SYMBOL(s) _##s
@@ -38,46 +38,42 @@
 #  define SYMBOL(s) _##s
 #endif
 
-/**************************************************************************
+/***********************************************************************
  * Public Functions
- **************************************************************************/
+ ***********************************************************************/
 
 	.text
+	.align	4
 	.globl	SYMBOL(setjmp)
 #ifdef __ELF__
 	.type	SYMBOL(setjmp), @function
 #endif
 SYMBOL(setjmp):
+	movl	4(%esp), %ecx      /* jmpbuf in %ecx.  */
 
-	/* %ebx, %esi, %edi, and %ebp must be preserved.
-	 * save %ebx, $esi, and %edi now... */
-
-	movl	4(%esp), %eax
-	movl	%ebx, (JB_EBX)(%eax)
-	movl	%esi, (JB_ESI)(%eax)
-	movl	%edi, (JB_EDI)(%eax)
-
-	/* Save the value of SP as will be after we return */
-
-	leal	4(%esp), %ecx
-	movl	%ecx, (JB_SP)(%eax)
-
-	/* Save the return PC */
+	/* Save registers.  */
 
-	movl	0(%esp), %ecx
-	movl	%ecx, (JB_PC)(%eax)
+	movl	%ebx, (JB_EBX)(%ecx)
+	movl	%esi, (JB_ESI)(%ecx)
+	movl	%edi, (JB_EDI)(%ecx)
+	movl	%ebp, (JB_EBP)(%ecx)
+	movl	%esp, (JB_ESP)(%ecx)
 
-	/* Save the framepointer */
+	/* Save PC (return address) after setting up ESP.  */
 
-	movl	%ebp, (JB_EBP)(%eax)
+	movl	8(%esp), %eax      /* Return address on stack.  */
+	movl	%eax, (JB_EIP)(%ecx)
 
-	/* And return 0 */
+	/* Return 0.  */
 
-	xorl	%eax, %eax
+	xorl	%eax,%eax
 	ret
+
 #ifdef __ELF__
 	.size	SYMBOL(setjmp), . - SYMBOL(setjmp)
 #endif
+
+	.align	4
 	.globl	SYMBOL(longjmp)
 #ifdef __ELF__
 	.type	SYMBOL(longjmp), @function
@@ -88,15 +84,21 @@ SYMBOL(longjmp):
 
 	/* Save the return address now.  */
 
-	movl	(JB_PC)(%ecx), %edx
+	movl	(JB_EIP)(%ecx), %edx
 
-	/* Restore registers.  */
+	/* Check if return value is 0, if so set it to 1 per POSIX */
+
+	testl	%eax,%eax
+	jnz	1f
+	incl	%eax
 
+	/* Restore registers.  */
+1:
 	movl	(JB_EBX)(%ecx), %ebx
 	movl	(JB_ESI)(%ecx), %esi
 	movl	(JB_EDI)(%ecx), %edi
 	movl	(JB_EBP)(%ecx), %ebp
-	movl	(JB_SP)(%ecx), %esp
+	movl	(JB_ESP)(%ecx), %esp
 
 	/* Jump to saved PC.  */
 

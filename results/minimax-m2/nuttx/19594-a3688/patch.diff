+/****************************************************************************
+ * Test for strto* functions with bases 27-36
+ * This test verifies that bases 27-36 work correctly
+ *****************************************************************************/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <string.h>
+#include <inttypes.h>
+#include <limits.h>
+
+static int test_strtoul_base36(void)
+{
+  char *endptr;
+  unsigned long result;
+  int failures = 0;
+
+  printf("Testing strtoul with bases 27-36\n");
+
+  /* Test case 1: strtoul("q#", 27) should return 26 */
+  errno = 0;
+  result = strtoul("q#", &endptr, 27);
+  if (errno != 0 || result != 26 || endptr != (char*)("q#") + 1)
+    {
+      printf("FAIL: strtoul(\"q#\", 27) = %lu (errno=%d, endptr offset=%ld)\n",
+             result, errno, endptr - "q#");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"q#\", 27) = 26\n");
+    }
+
+  /* Test case 2: strtoul("z!", 36) should return 35 */
+  errno = 0;
+  result = strtoul("z!", &endptr, 36);
+  if (errno != 0 || result != 35 || endptr != (char*)("z!") + 1)
+    {
+      printf("FAIL: strtoul(\"z!\", 36) = %lu (errno=%d, endptr offset=%ld)\n",
+             result, errno, endptr - "z!");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"z!\", 36) = 35\n");
+    }
+
+  /* Test case 3: strtoul("10", 27) should return 27 */
+  errno = 0;
+  result = strtoul("10", &endptr, 27);
+  if (errno != 0 || result != 27 || endptr != (char*)("10") + 2)
+    {
+      printf("FAIL: strtoul(\"10\", 27) = %lu (errno=%d, endptr offset=%ld)\n",
+             result, errno, endptr - "10");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"10\", 27) = 27\n");
+    }
+
+  /* Test case 4: Uppercase letters */
+  errno = 0;
+  result = strtoul("Q#", &endptr, 27);
+  if (errno != 0 || result != 26 || endptr != (char*)("Q#") + 1)
+    {
+      printf("FAIL: strtoul(\"Q#\", 27) = %lu (errno=%d, endptr offset=%ld)\n",
+             result, errno, endptr - "Q#");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"Q#\", 27) = 26\n");
+    }
+
+  /* Test case 5: Base 27-1 = 26 */
+  errno = 0;
+  result = strtoul("10", &endptr, 27);
+  if (errno != 0 || result != 27)
+    {
+      printf("FAIL: strtoul(\"10\", 27) = %lu (errno=%d)\n", result, errno);
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"10\", 27) = 27\n");
+    }
+
+  /* Test case 6: Base 36-10 = 26 (z in base 36) */
+  errno = 0;
+  result = strtoul("z", &endptr, 36);
+  if (errno != 0 || result != 35 || endptr != (char*)("z") + 1)
+    {
+      printf("FAIL: strtoul(\"z\", 36) = %lu (errno=%d, endptr offset=%ld)\n",
+             result, errno, endptr - "z");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"z\", 36) = 35\n");
+    }
+
+  /* Test case 7: Base 31 with letters */
+  errno = 0;
+  result = strtoul("u!", &endptr, 31);
+  if (errno != 0 || result != 30 || endptr != (char*)("u!") + 1)
+    {
+      printf("FAIL: strtoul(\"u!\", 31) = %lu (errno=%d, endptr offset=%ld)\n",
+             result, errno, endptr - "u!");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"u!\", 31) = 30\n");
+    }
+
+  /* Test case 8: Base 1 should fail */
+  errno = 0;
+  result = strtoul("10", &endptr, 1);
+  if (errno != EINVAL)
+    {
+      printf("FAIL: strtoul(\"10\", 1) should fail with EINVAL\n");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"10\", 1) fails with EINVAL\n");
+    }
+
+  /* Test case 9: Base 37 should fail */
+  errno = 0;
+  result = strtoul("10", &endptr, 37);
+  if (errno != EINVAL)
+    {
+      printf("FAIL: strtoul(\"10\", 37) should fail with EINVAL\n");
+      failures++;
+    }
+  else
+    {
+      printf("PASS: strtoul(\"10\", 37) fails with EINVAL\n");
+    }
+
+  printf("strtoul tests completed with %d failures\n\n", failures);
+  return failures;
+}
+

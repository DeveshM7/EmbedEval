+
+int main(void)
+{
+  int total_failures = 0;
+
+  printf("=== Testing strto* functions with bases 27-36 ===\n\n");
+
+  total_failures += test_strtoul_base36();
+  total_failures += test_strtol_base36();
+  total_failures += test_strtoull_base36();
+  total_failures += test_strtoll_base36();
+  total_failures += test_strtoimax_base36();
+  total_failures += test_strtoumax_base36();
+
+  printf("=== Total failures: %d ===\n", total_failures);
+
+  if (total_failures == 0)
+    {
+      printf("All tests PASSED!\n");
+      return 0;
+    }
+  else
+    {
+      printf("Some tests FAILED!\n");
+      return 1;
+    }
+}

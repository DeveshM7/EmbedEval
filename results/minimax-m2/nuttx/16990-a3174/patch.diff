diff --git a/run_tests.sh b/run_tests.sh
new file mode 100755
index 00000000..1c32cbe1
--- /dev/null
+++ b/run_tests.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+
+# Run the NuttX simulator with ostest
+cd /testbed
+
+# Start the simulator in the background with a timeout
+timeout 60 ./nuttx > /tmp/nuttx_output.txt 2>&1 &
+SIM_PID=$!
+
+# Wait for the simulator to start
+sleep 2
+
+# Send commands to the simulator
+(
+  echo "ostest"
+  sleep 10
+  echo "exit"
+) | nc -q 2 localhost 2006 2>/dev/null || true
+
+# Wait for the simulator to finish
+wait $SIM_PID 2>/dev/null || true
+
+# Check the output for errors
+if grep -q "ERROR" /tmp/nuttx_output.txt; then
+  echo "FAIL: Test output contains errors"
+  grep "ERROR" /tmp/nuttx_output.txt
+  exit 1
+elif grep -q "assert" /tmp/nuttx_output.txt; then
+  echo "FAIL: Test output contains assertion failures"
+  grep "assert" /tmp/nuttx_output.txt
+  exit 1
+else
+  echo "PASS: All tests completed without errors"
+  exit 0
+fi

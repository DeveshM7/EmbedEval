--- /dev/null
+++ b/test_event_concurrent.c
@@ -0,0 +1,97 @@
+/* Test for the event concurrency bug */
+
+#include <nuttx/config.h>
+#include <nuttx/event.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <sched.h>
+#include <unistd.h>
+#include <sys/wait.h>
+#include <stdlib.h>
+#include <string.h>
+
+static nxevent_t event;
+static volatile int waiter_done = 0;
+static volatile int test_passed = 0;
+
+void *waiter_thread(void *arg)
+{
+  printf("[WAITER] Starting wait for bit 0x10 with NXEVENT_WAIT_NOCLEAR\n");
+  
+  /* Wait for bit 0x10 with NXEVENT_WAIT_NOCLEAR */
+  nxevent_mask_t result = nxevent_wait(&event, 0x10, NXEVENT_WAIT_NOCLEAR);
+  
+  printf("[WAITER] Wait returned with result=0x%lx\n", result);
+  
+  if (result == 0x10)
+    {
+      printf("[WAITER] Wait completed successfully!\n");
+      waiter_done = 1;
+    }
+  else
+    {
+      printf("[WAITER] ERROR: Wait returned unexpected result\n");
+    }
+  
+  return NULL;
+}
+
+int main(void)
+{
+  pthread_t tid;
+  int i;
+
+  printf("=== Test: Concurrent event post with NXEVENT_WAIT_NOCLEAR ===\n");
+
+  /* Initialize event with no bits set */
+  nxevent_init(&event, 0);
+  printf("[MAIN] Event initialized with 0\n");
+
+  /* Create waiter thread */
+  pthread_create(&tid, NULL, waiter_thread, NULL);
+  usleep(100000); /* Give thread time to start waiting */
+
+  printf("[MAIN] Waiter is now waiting\n");
+
+  /* Now follow the exact scenario from the bug report: */
+  /* 1. Post bit 0x10 */
+  printf("[MAIN] Step 1: Posting bit 0x10\n");
+  nxevent_post(&event, 0x10, 0);
+
+  usleep(10000);
+
+  /* 2. Clear bit 0x10 */
+  printf("[MAIN] Step 2: Clearing bit 0x10\n");
+  nxevent_clear(&event, 0x10);
+
+  usleep(10000);
+
+  /* 3. Another thread posts while waiter is in nxevent_wait() */
+  printf("[MAIN] Step 3: Posting bit 0x10 again\n");
+  nxevent_post(&event, 0x10, 0);
+
+  /* Wait for waiter to complete */
+  for (i = 0; i < 50; i++)
+    {
+      if (waiter_done)
+        break;
+      usleep(100000);
+    }
+
+  if (waiter_done)
+    {
+      printf("[MAIN] Test PASSED: Waiter completed successfully\n");
+      test_passed = 1;
+    }
+  else
+    {
+      printf("[MAIN] Test FAILED: Waiter did not complete\n");
+    }
+
+  pthread_join(tid, NULL);
+  nxevent_destroy(&event);
+
+  printf("=== Test completed ===\n");
+  
+  return test_passed ? 0 : 1;
+}

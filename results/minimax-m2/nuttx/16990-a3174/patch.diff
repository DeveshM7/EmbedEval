+
+static nxevent_t event;
+
+void *waiter_thread(void *arg)
+{
+  printf("Waiter: Starting wait for bit 0x10 with NXEVENT_WAIT_NOCLEAR\n");
+  nxevent_mask_t result = nxevent_wait(&event, 0x10, NXEVENT_WAIT_NOCLEAR);
+  printf("Waiter: Wait returned with result=0x%lx\n", result);
+  return NULL;
+}
+
+int main(void)
+{
+  pthread_t tid;
+  int ret;
+
+  printf("=== Test: NXEVENT_WAIT_NOCLEAR with clear and post ===\n");
+
+  /* Initialize event with bit 0x10 set */
+  nxevent_init(&event, 0x10);
+  printf("Main: Event initialized with 0x10\n");
+
+  /* Create waiter thread */
+  pthread_create(&tid, NULL, waiter_thread, NULL);
+  usleep(100000); /* Give thread time to start waiting */
+
+  printf("Main: Clearing bit 0x10\n");
+  nxevent_clear(&event, 0x10); /* Clear the bit the waiter is waiting for */
+
+  printf("Main: Posting bit 0x10\n");
+  nxevent_post(&event, 0x10, 0); /* Post the bit again */
+
+  printf("Main: Waiting for thread to complete\n");
+  pthread_join(tid, NULL);

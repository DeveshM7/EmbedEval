diff --git a/waitirq_addition.txt b/waitirq_addition.txt
new file mode 100644
index 00000000..1e797690
--- /dev/null
+++ b/waitirq_addition.txt
@@ -0,0 +1,13 @@
+      /* For mutexes, update the holder field to clear the blocking bit
+       * if there are no more waiters. This is necessary because the
+       * blocking bit was set when the waiter was added, and it needs
+       * to be cleared when the waiter is removed (via timeout or cancel).
+       */
+
+      if (mutex)
+        {
+          uint32_t blocking_bit = dq_empty(SEM_WAITLIST(sem)) ? 0 : NXSEM_MBLOCKING_BIT;
+          uint32_t mholder = atomic_read(NXSEM_MHOLDER(sem));
+          atomic_set(NXSEM_MHOLDER(sem), (mholder & ~NXSEM_MBLOCKING_BIT) | blocking_bit);
+        }
+
diff --git a/waitirq_fix.txt b/waitirq_fix.txt
new file mode 100644
index 00000000..97445e62
--- /dev/null
+++ b/waitirq_fix.txt
@@ -0,0 +1,14 @@
+
+      /* For mutexes, update the holder field to clear the blocking bit
+       * if there are no more waiters. This is necessary because the
+       * blocking bit was set when the waiter was added, and it needs
+       * to be cleared when the waiter is removed (via timeout or cancel).
+       */
+
+      if (mutex)
+        {
+          uint32_t blocking_bit = dq_empty(SEM_WAITLIST(sem)) ? 0 : NXSEM_MBLOCKING_BIT;
+          uint32_t mholder = atomic_read(NXSEM_MHOLDER(sem));
+          atomic_set(NXSEM_MHOLDER(sem), (mholder & ~NXSEM_MBLOCKING_BIT) | blocking_bit);
+        }
+

diff --git a/simple_test.c b/simple_test.c
new file mode 100644
index 00000000..f3ffd5fd
--- /dev/null
+++ b/simple_test.c
@@ -0,0 +1,26 @@
+#include <stdio.h>
+#include <pthread.h>
+#include <errno.h>
+
+int main()
+{
+    pthread_mutex_t mutex;
+    pthread_mutex_init(&mutex, NULL);
+    
+    printf("Locking...\n");
+    pthread_mutex_lock(&mutex);
+    
+    printf("Unlocking...\n");
+    int ret = pthread_mutex_unlock(&mutex);
+    printf("Unlock returned: %d\n", ret);
+    
+    printf("Trying trylock...\n");
+    ret = pthread_mutex_trylock(&mutex);
+    printf("trylock returned: %d (%s)\n", ret, ret == 0 ? "OK" : strerror(ret));
+    
+    if (ret == 0)
+        pthread_mutex_unlock(&mutex);
+    
+    pthread_mutex_destroy(&mutex);
+    return 0;
+}

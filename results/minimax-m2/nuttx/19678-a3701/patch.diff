diff --git a/fix_waitirq.patch b/fix_waitirq.patch
new file mode 100644
index 00000000..933a3ace
--- /dev/null
+++ b/fix_waitirq.patch
@@ -0,0 +1,30 @@
+--- a/sched/semaphore/sem_waitirq.c
++++ b/sched/semaphore/sem_waitirq.c
+@@ -91,12 +91,24 @@ void nxsem_wait_irq(FAR struct tcb_s *wtcb, int errcode)
+       nxsem_canceled(wtcb, sem);
+ 
+       /* Remove task from waiting list */
+ 
+       dq_rem((FAR dq_entry_t *)wtcb, SEM_WAITLIST(sem));
+ 
++      /* For mutexes, update the holder field to clear the blocking bit
++       * if there are no more waiters. This is necessary because the
++       * blocking bit was set when the waiter was added, and it needs
++       * to be cleared when the waiter is removed.
++       */
++
++      if (mutex)
++        {
++          uint32_t blocking_bit = dq_empty(SEM_WAITLIST(sem)) ? 0 : NXSEM_MBLOCKING_BIT;
++          uint32_t mholder = atomic_read(NXSEM_MHOLDER(sem));
++          atomic_set(NXSEM_MHOLDER(sem), (mholder & ~NXSEM_MBLOCKING_BIT) | blocking_bit);
++        }
++
+       /* This restores the value to what it was before the previous sem_wait.
+        * This caused the thread to be blocked in the first place.
+        *
+        * For mutexes, the holder is updated by the thread itself
+        * when it exits nxsem_wait
+        */
+ 
+       if (!mutex)

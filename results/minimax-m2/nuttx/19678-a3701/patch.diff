diff --git a/test_mutex_timeout.c b/test_mutex_timeout.c
new file mode 100644
index 00000000..45073ea0
--- /dev/null
+++ b/test_mutex_timeout.c
@@ -0,0 +1,83 @@
+#include <stdio.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <time.h>
+#include <errno.h>
+#include <assert.h>
+
+static pthread_mutex_t mutex;
+
+void *waiter_thread(void *arg)
+{
+    struct timespec ts;
+    int ret;
+
+    printf("Waiter: Starting\n");
+
+    /* Get current time + 1 second */
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += 1;
+
+    /* Try to lock with timeout */
+    ret = pthread_mutex_timedlock(&mutex, &ts);
+    if (ret == ETIMEDOUT)
+    {
+        printf("Waiter: Timed out as expected\n");
+    }
+    else
+    {
+        printf("Waiter: Got lock (unexpected) ret=%d\n", ret);
+    }
+
+    return NULL;
+}
+
+int main()
+{
+    pthread_t thread;
+    int ret;
+
+    /* Initialize mutex */
+    pthread_mutex_init(&mutex, NULL);
+
+    /* Lock the mutex */
+    printf("Main: Locking mutex\n");
+    pthread_mutex_lock(&mutex);
+
+    /* Create waiter thread */
+    printf("Main: Creating waiter thread\n");
+    pthread_create(&thread, NULL, waiter_thread, NULL);
+
+    /* Wait for waiter to start and timeout */
+    sleep(2);
+
+    /* Now try to unlock - this should work but might fail due to the bug */
+    printf("Main: Unlocking mutex\n");
+    ret = pthread_mutex_unlock(&mutex);
+    if (ret != 0)
+    {
+        printf("Main: ERROR - unlock failed with %d\n", ret);
+        printf("Main: BUG REPRODUCED!\n");
+        return 1;
+    }
+    printf("Main: Unlock succeeded\n");
+
+    /* Try to lock again to verify mutex is usable */
+    printf("Main: Trying to lock again\n");
+    ret = pthread_mutex_trylock(&mutex);
+    if (ret != 0)
+    {
+        printf("Main: ERROR - trylock failed with %d\n", ret);
+        printf("Main: BUG REPRODUCED!\n");
+        return 1;
+    }
+    printf("Main: trylock succeeded\n");
+    pthread_mutex_unlock(&mutex);
+
+    /* Clean up */
+    pthread_join(thread, NULL);
+    pthread_mutex_destroy(&mutex);
+
+    printf("Main: Test PASSED\n");
+    return 0;
+}

+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ******** *******************************************************************/
+
+#include <nuttx/config.h>
+
+#ifdef CONFIG_SCHED_EVENTS
+
+#include <stdlib.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+#include <nuttx/clock.h>
+#include <nuttx/wdog.h>
+
+#include "sched/sched.h"
+#include "event/nxevent.h"
+
+/****************************************************************************
+ * Public Functions
+ ******** *******************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_tickwait
+ *
+ * Description:
+ *   This function is a lighter weight version of event_timedwait().  It is
+ *   non-standard and intended only for use within the RTOS.
+ *
+ *   The function behaves the same as nxevent_wait, but will only wait for
+ *   up to 'ticks' system ticks.
+ *
+ * Input Parameters:
+ *   event  - Event group to wait on
+ *   events - Events to wait for (0 means any event)
+ *   flags  - Wait flags (NXEVENT_WAIT_ALL, etc.)
+ *   ticks  - Number of ticks to wait
+ *
+ * Returned Value:
+ *   Returns the matched event mask. Returns 0 if timeout or if the
+ *   condition was not satisfied.
+ *
+ ******** *******************************************************************/
+
+uint32_t nxevent_tickwait(FAR nxevent_t *event, uint32_t events,
+                          uint8_t flags, uint32_t ticks)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  FAR struct nxevent_wait_s *waiter;
+  irqstate_t state;
+  uint32_t matched;
+  bool switch_needed;
+
+  /* This API should not be called from interrupt handlers */
+
+  DEBUGASSERT(event != NULL && up_interrupt_context() == false);
+
+  /* Allocate a wait structure */
+
+  waiter = (FAR struct nxevent_wait_s *)kmm_malloc(sizeof(struct nxevent_wait_s));
+  if (waiter == NULL)
+    {
+      return 0;
+    }
+
+  waiter->events = events;
+  waiter->flags = flags;
+
+  /* Disable interrupts to safely access the event and manage wait list */
+
+  state = enter_critical_section();
+
+  /* Try to get the event without blocking */
+
+  matched = nxevent_trywait(event, events, flags);
+  if (matched != 0)
+    {
+      /* We got the events - no need to wait */
+
+      leave_critical_section(state);
+      kmm_free(waiter);
+      return matched;
+    }
+
+  /* If ticks is zero, return immediately (non-blocking try-wait) */
+
+  if (ticks == 0)
+    {
+      leave_critical_section(state);
+      kmm_free(waiter);
+      return 0;
+    }
+
+  /* Start the watchdog with interrupts still disabled */
+
+  wd_start(&rtcb->waitdog, ticks, nxevent_timeout, nxsched_gettid());
+
+  /* We will have to wait - add ourselves to the wait list */
+
+  waiter->flink = event->waitlist;
+  waiter->wtcb = rtcb;
+  event->waitlist = waiter;
+
+  /* Save the event in the TCB for use by nxevent_wait_irq */
+
+  rtcb->waitobj = event;
+
+  /* Remove the tcb task from the ready-to-run list */
+
+  switch_needed = nxsched_remove_readytorun(rtcb, true);
+
+  /* Add the task to the event wait queue */
+
+  rtcb->task_state = TSTATE_WAIT_EVENT;
+  nxsched_add_prioritized(rtcb, NXEVENT_WAITLIST(event));
+
+  /* Now, perform the context switch if one is needed */
+
+  if (switch_needed)
+    {
+      up_switch_context(this_task(), rtcb);
+    }
+
+  /* When we resume at this point, either (1) the events have been
+   * assigned to this task of execution, or (2) the event wait
+   * has been interrupted by a signal or a timeout.  We can detect
+   * these latter cases by examining the per-thread errno value.
+   *
+   * In the event that the event wait was interrupted by a signal
+   * or a timeout, certain event clean-up operations have already
+   * been performed (see nxevent_waitirq.c).
+   */
+
+  /* Stop the watchdog timer */
+
+  wd_cancel(&rtcb->waitdog);
+
+  /* Check if an error occurred while we were sleeping.  Expected
+   * errors include EINTR meaning that we were awakened by a signal
+   * or ETIMEDOUT meaning that the timer expired.
+   */
+
+  if (rtcb->errcode != OK)
+    {
+      matched = 0;
+    }
+  else
+    {
+      /* Get the matched events from the wait structure */
+
+      matched = waiter->events;
+    }
+
+  /* Remove from the wait list and free the waiter structure */
+
+  if (event->waitlist == waiter)
+    {
+      event->waitlist = waiter->flink;
+    }
+  else
+    {
+      FAR struct nxevent_wait_s *prev;
+      for (prev = event->waitlist; prev->flink != waiter; prev = prev->flink);
+      prev->flink = waiter->flink;
+    }
+
+  kmm_free(waiter);
+
+  /* Interrupts may now be enabled */
+
+  leave_critical_section(state);
+
+  return matched;
+}
+
+#endif /* CONFIG_SCHED_EVENTS */

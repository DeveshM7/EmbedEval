+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ******** *******************************************************************/
+
+#include <nuttx/config.h>
+
+#ifdef CONFIG_SCHED_EVENTS
+
+#include <stdlib.h>
+#include <sched.h>
+#include <assert.h>
+#include <errno.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "sched/sched.h"
+#include "event/nxevent.h"
+
+/****************************************************************************
+ * Public Functions
+ ******** *******************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_wait_irq
+ *
+ * Description:
+ *   This function is called when either:
+ *
+ *   1. A signal is received by a task that is waiting on an event group.
+ *      According to the POSIX spec, "...the calling thread shall not return
+ *      from the call to [nxevent_wait] until it either acquires the event
+ *      or the call is interrupted by a signal."
+ *   2. From logic associated with nxevent_tickwait().  This function is
+ *      called when the timeout elapses without receiving the events.
+ *
+ * Note: this function should used within critical_section
+ *
+ * Input Parameters:
+ *   wtcb    - A pointer to the TCB of the task that is waiting on an
+ *             event group, but has received a signal or timeout instead.
+ *   errcode - EINTR if the event wait was awakened by a signal;
+ *             ETIMEDOUT if awakened by a timeout
+ *
+ * Returned Value:
+ *   None
+ *
+ ******** *******************************************************************/
+
+void nxevent_wait_irq(FAR struct tcb_s *wtcb, int errcode)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  FAR nxevent_t *event = wtcb->waitobj;
+  FAR struct nxevent_wait_s *waiter;
+  FAR struct nxevent_wait_s *prev;
+
+  /* It is possible that an interrupt/context switch beat us to the punch
+   * and already changed the task's state.
+   */
+
+  DEBUGASSERT(event != NULL);
+
+  /* Find the waiter in the event's wait list */
+
+  for (prev = NULL, waiter = event->waitlist;
+       waiter != NULL;
+       prev = waiter, waiter = waiter->flink)
+    {
+      if (waiter->wtcb == wtcb)
+        {
+          /* Remove the waiter from the list */
+
+          if (prev == NULL)
+            {
+              event->waitlist = waiter->flink;
+            }
+          else
+            {
+              prev->flink = waiter->flink;
+            }
+          break;
+        }
+    }
+
+  /* Indicate that the wait is over */
+
+  wtcb->waitobj = NULL;
+
+  /* Mark the errno value for the thread */
+
+  wtcb->errcode = errcode;
+
+  /* Add the task to ready-to-run task list */
+
+  if (nxsched_add_readytorun(wtcb))
+    {
+      up_switch_context(wtcb, rtcb);
+    }
+
+  /* Free the waiter structure */
+
+  if (waiter != NULL)
+    {
+      kmm_free(waiter);
+    }
+}
+
+/****************************************************************************
+ * Name: nxevent_timeout
+ *
+ * Description:
+ *   This function is called if the timeout elapses before before an
+ *   event is acquired.
+ *
+ * Input Parameters:
+ *   pid  - The task ID of the task to wakeup
+ *
+ * Returned Value:
+ *   None
+ *
+ * Assumptions:
+ *   - Called from the context of the timer interrupt handler.
+ *
+ ******** *******************************************************************/
+
+void nxevent_timeout(wdparm_t pid)
+{
+  FAR struct tcb_s *wtcb;
+  irqstate_t flags;
+
+  /* Disable interrupts to avoid race conditions */
+
+  flags = enter_critical_section();
+
+  /* Get the TCB associated with this PID.  It is possible that
+   * task may no longer be active when this watchdog goes off.
+   */
+
+  wtcb = nxsched_get_tcb(pid);
+
+  /* It is also possible that an interrupt/context switch beat us to the
+   * punch and already changed the task's state.
+   */
+
+  if (wtcb && wtcb->task_state == TSTATE_WAIT_EVENT)
+    {
+      /* Cancel the event wait */
+
+      nxevent_wait_irq(wtcb, ETIMEDOUT);
+    }
+
+  /* Interrupts may now be enabled */
+
+  leave_critical_section(flags);
+}
+
+/****************************************************************************
+ * Name: nxevent_recover
+ *
+ * Description:
+ *   Recover event group resources with a task or thread is destroyed
+ *
+ * Input Parameters:
+ *   tcb - The TCB of the task that is being destroyed
+ *
+ * Returned Value:
+ *   None
+ *
+ ******** *******************************************************************/
+
+void nxevent_recover(FAR struct tcb_s *tcb)
+{
+  FAR nxevent_t *event;
+  FAR struct nxevent_wait_s *waiter;
+  FAR struct nxevent_wait_s *prev;
+
+  if (tcb->waitobj == NULL)
+    {
+      return;
+    }
+
+  event = (FAR nxevent_t *)tcb->waitobj;
+
+  /* Find and remove the waiter from the event's wait list */
+
+  for (prev = NULL, waiter = event->waitlist;
+       waiter != NULL;
+       prev = waiter, waiter = waiter->flink)
+    {
+      if (waiter->wtcb == tcb)
+        {
+          /* Remove the waiter from the list */
+
+          if (prev == NULL)
+            {
+              event->waitlist = waiter->flink;
+            }
+          else
+            {
+              prev->flink = waiter->flink;
+            }
+          break;
+        }
+    }
+
+  /* Free the waiter structure */
+
+  if (waiter != NULL)
+    {
+      kmm_free(waiter);
+    }
+}
+
+#endif /* CONFIG_SCHED_EVENTS */

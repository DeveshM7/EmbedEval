+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ******** *******************************************************************/
+
+#ifndef __INCLUDE_NUTTX_EVENT_H
+#define __INCLUDE_NUTTX_EVENT_H
+
+/****************************************************************************
+ * Included Files
+ ******** *******************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+#define EXTERN extern "C"
+extern "C"
+{
+#else
+#define EXTERN extern
+#endif
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ******** *******************************************************************/
+
+/* Event wait flags */
+
+#define NXEVENT_WAIT_ALL 0x0001  /* Wait for all events in the mask */
+#define NXEVENT_ANY       0x0000  /* Wait for any event (default) */
+
+/* Initialization macro */
+
+#define NXEVENT_INITIALIZER(event, initial_mask) \
+  {(initial_mask), NULL}
+
+/* Access to internal waitlist (for kernel use only) */
+
+#define NXEVENT_WAITLIST(event) (&((event)->waitlist))
+
+/****************************************************************************
+ * Public Type Definitions
+ ******** *******************************************************************/
+
+/* Event group structure */
+
+typedef struct nxevent_s
+{
+  volatile uint32_t  events;    /* Pending events */
+  FAR struct nxevent_wait_s *waitlist; /* List of waiting tasks (kernel internal) */
+} nxevent_t;
+
+/* Event group wait queue entry (for kernel use only) */
+
+struct nxevent_wait_s
+{
+  uint32_t            events;   /* The events we're waiting for */
+  uint8_t             flags;    /* Wait flags (NXEVENT_WAIT_ALL, etc.) */
+  FAR struct nxevent_wait_s *flink;
+  FAR struct tcb_s   *wtcb;     /* The waiting task */
+};
+
+/****************************************************************************
+ * Public Function Prototypes
+ ******** *******************************************************************/
+
+/* Event group manipulation */
+
+int nxevent_init(FAR nxevent_t *event, uint32_t events);
+int nxevent_destroy(FAR nxevent_t *event);
+int nxevent_reset(FAR nxevent_t *event, uint32_t events);
+int nxevent_post(FAR nxevent_t *event, uint32_t events, uint8_t flags);
+
+/* Event group wait operations */
+
+uint32_t nxevent_wait(FAR nxevent_t *event, uint32_t events, uint8_t flags);
+uint32_t nxevent_tickwait(FAR nxevent_t *event, uint32_t events, 
+                          uint8_t flags, uint32_t ticks);
+uint32_t nxevent_trywait(FAR nxevent_t *event, uint32_t events, uint8_t flags);
+
+#undef EXTERN
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __ASSEMBLY__ */
+#endif /* __INCLUDE_NUTTX_EVENT_H */

diff --git a/sched/event/nxevent_post.c b/sched/event/nxevent_post.c
new file mode 100644
index 00000000..e81e5232
--- /dev/null
+++ b/sched/event/nxevent_post.c
@@ -0,0 +1,200 @@
+/****************************************************************************
+ * sched/event/nxevent_post.c
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ******** *******************************************************************/
+
+#include <nuttx/config.h>
+
+#ifdef CONFIG_SCHED_EVENTS
+
+#include <errno.h>
+#include <nuttx/irq.h>
+
+#include "sched/sched.h"
+#include "event/nxevent.h"
+
+/****************************************************************************
+ * Public Functions
+ ******** *******************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_post
+ *
+ * Description:
+ *   This function adds the events in 'events' to the pending event set of
+ *   the event group referenced by 'event'. If a zero event mask is passed,
+ *   this is treated as an "any delivery" and must wake blocked waiters
+ *   immediately.
+ *
+ * Input Parameters:
+ *   event  - Event group to post to
+ *   events - Events to post
+ *   flags  - Post flags (currently unused)
+ *
+ * Returned Value:
+ *   This is an internal OS interface and should not be used by applications.
+ *   It follows the NuttX internal error return policy:  Zero (OK) is
+ *   returned on success.  A negated errno value is returned on failure.
+ *
+ ******** *******************************************************************/
+
+int nxevent_post(FAR nxevent_t *event, uint32_t events, uint8_t flags)
+{
+  irqstate_t state;
+  FAR struct nxevent_wait_s *waiter;
+  FAR struct tcb_s *wtcb;
+  FAR struct nxevent_wait_s *prev_waiter;
+  uint32_t pending_events;
+  uint32_t matched;
+
+  if (event == NULL)
+    {
+      return -EINVAL;
+    }
+
+  /* Disable interrupts to safely access the event and wait list */
+
+  state = enter_critical_section();
+
+  /* If events is zero, this is an "any delivery" - wake up all waiters */
+
+  if (events == 0)
+    {
+      pending_events = event->events;
+    }
+  else
+    {
+      /* Merge the events into the pending mask */
+
+      event->events |= events;
+      pending_events = event->events;
+    }
+
+  /* Check and wake up waiters whose conditions are satisfied */
+
+  prev_waiter = NULL;
+  for (waiter = event->waitlist; waiter != NULL; )
+    {
+      bool wake_up = false;
+
+      if (waiter->events == 0)
+        {
+          /* Waiting for any event - wake up if there are any pending events */
+
+          wake_up = pending_events != 0;
+        }
+      else if ((waiter->flags & NXEVENT_WAIT_ALL) != 0)
+        {
+          /* Waiting for all specific events */
+
+          wake_up = (pending_events & waiter->events) == waiter->events;
+        }
+      else
+        {
+          /* Waiting for any of the specific events */
+
+          wake_up = (pending_events & waiter->events) != 0;
+        }
+
+      if (wake_up)
+        {
+          /* Calculate matched events */
+
+          if (waiter->events == 0)
+            {
+              matched = pending_events;
+            }
+          else if ((waiter->flags & NXEVENT_WAIT_ALL) != 0)
+            {
+              matched = waiter->events;
+            }
+          else
+            {
+              matched = pending_events & waiter->events;
+            }
+
+          /* Update pending events */
+
+          pending_events &= ~matched;
+
+          /* We'll remove this waiter from the list */
+
+          wtcb = waiter->wtcb;
+
+          /* Stop the watchdog timer if active */
+
+          if (WDOG_ISACTIVE(&wtcb->waitdog))
+            {
+              wd_cancel(&wtcb->waitdog);
+            }
+
+          /* Save the matched events in the waiter structure for later retrieval */
+
+          waiter->events = matched;
+
+          /* Indicate that the wait is over */
+
+          wtcb->waitobj = NULL;
+
+          /* Mark errno for the task */
+
+          wtcb->errcode = OK;
+
+          /* Add the task to ready-to-run task list */
+
+          if (nxsched_add_readytorun(wtcb))
+            {
+              /* We need to do a context switch to the awoken task */
+
+              up_switch_context(wtcb, this_task());
+            }
+
+          /* Remove from wait list and free waiter structure */
+
+          if (prev_waiter == NULL)
+            {
+              event->waitlist = waiter->flink;
+              kmm_free(waiter);
+              waiter = event->waitlist;
+            }
+          else
+            {
+              prev_waiter->flink = waiter->flink;
+              kmm_free(waiter);
+              waiter = prev_waiter->flink;
+            }
+        }
+      else
+        {
+          prev_waiter = waiter;
+          waiter = waiter->flink;
+        }
+    }
+
+  /* Update the pending events */
+
+  event->events = pending_events;
+
+  /* Interrupts may now be enabled */
+
+  leave_critical_section(state);
+
+  return OK;
+}
+
+#endif /* CONFIG_SCHED_EVENTS */

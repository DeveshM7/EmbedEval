+
+#include <nuttx/config.h>
+
+#ifdef CONFIG_SCHED_EVENTS
+
+#include <errno.h>
+#include <nuttx/irq.h>
+
+#include "sched/sched.h"
+#include "event/nxevent.h"
+
+/****************************************************************************
+ * Public Functions
+ ******** *******************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_trywait
+ *
+ * Description:
+ *   This function is a non-blocking version of nxevent_wait(). If the
+ *   requested events are already satisfied, this function returns the
+ *   matching event mask. Otherwise it returns 0.
+ *
+ * Input Parameters:
+ *   event  - Event group to wait on
+ *   events - Events to wait for (0 means any event)
+ *   flags  - Wait flags (NXEVENT_WAIT_ALL, etc.)
+ *
+ * Returned Value:
+ *   If the condition is satisfied, returns the matched event mask.
+ *   Returns 0 if the condition is not satisfied.
+ *
+ ******** *******************************************************************/
+
+uint32_t nxevent_trywait(FAR nxevent_t *event, uint32_t events, uint8_t flags)
+{
+  irqstate_t state;
+  uint32_t matched = 0;
+
+  if (event == NULL)
+    {
+      return 0;
+    }
+
+  /* Disable interrupts to safely access the event */
+
+  state = enter_critical_section();
+
+  /* Check if the condition is satisfied */
+
+  if (events == 0)
+    {
+      /* Waiting for any event */
+
+      matched = event->events;
+    }
+  else if ((flags & NXEVENT_WAIT_ALL) != 0)
+    {
+      /* Waiting for all events */
+
+      if ((event->events & events) == events)
+        {
+          matched = events;
+        }
+    }
+  else
+    {
+      /* Waiting for any of the events */
+
+      matched = event->events & events;
+    }
+
+  /* Clear the matched events from the pending mask */
+
+  if (matched != 0)
+    {
+      event->events &= ~matched;
+    }
+
+  /* Interrupts may now be enabled */
+
+  leave_critical_section(state);
+
+  return matched;
+}
+
+#endif /* CONFIG_SCHED_EVENTS */

+/* Standalone test to verify getopt_long() fix for unrecognized long options */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Link against the built libraries */
+extern char *optarg;
+extern int optind;
+extern int optopt;
+
+struct option {
+    const char *name;
+    int has_arg;
+    int *flag;
+    int val;
+};
+
+#define no_argument 0
+#define required_argument 1
+#define optional_argument 2
+
+/* Forward declarations */
+int getopt_long(int argc, char * const argv[],
+                const char *optstring,
+                const struct option *longopts,
+                int *longindex);
+
+int main(void) {
+    struct option long_options[] = {
+        {"valid", no_argument, 0, 'v'},
+        {0, 0, 0, 0}
+    };
+    
+    /* Test case: Unrecognized long option as final argument */
+    char *argv[] = {"program", "--valid", "--invalid"};
+    int argc = 3;
+    
+    printf("Testing getopt_long() fix for unrecognized long option\n");
+    printf("=========================================================\n");
+    printf("Arguments: --valid --invalid\n");
+    printf("Expected: Process 'v', then '?' for invalid, then -1 to terminate\n");
+    printf("\n");
+    
+    int ret;
+    int count = 0;
+    
+    optind = 0; /* Reset */
+    printf("Starting parse:\n");
+    
+    while ((ret = getopt_long(argc, argv, "", long_options, NULL)) != -1) {
+        count++;
+        printf("  Iteration %d: ret=%d ('%c'), optind=%d, optopt='%c'\n", 
+               count, ret, ret > 0 ? ret : '?', optind, optopt);
+        
+        if (count > 5) {
+            printf("  FAILURE: Too many iterations, infinite loop detected!\n");
+            return 1;
+        }
+        
+        if (ret == 'v') {
+            printf("    -> Correctly parsed valid option\n");
+        } else if (ret == '?') {
+            printf("    -> Correctly identified invalid option\n");
+        } else {
+            printf("    -> Unexpected return value\n");
+        }
+    }
+    
+    printf("\n");
+    printf("Parse completed after %d iterations\n", count);
+    printf("Final optind=%d (should be 3 for argv[0..2])\n", optind);
+    
+    if (count == 2 && optind == 3) {
+        printf("\nSUCCESS: The fix works correctly!\n");
+        printf("- Valid option was processed\n");
+        printf("- Invalid option was reported once\n");
+        printf("- Parser terminated correctly\n");
+        return 0;
+    } else {
+        printf("\nFAILURE: The fix did not work as expected\n");
+        return 1;
+    }
+}

+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <assert.h>
+#include <errno.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+#include <nuttx/queue.h>
+#include <nuttx/wqueue.h>
+
+#include "wqueue/wqueue.h"
+
+#ifdef CONFIG_SCHED_WORKQUEUE
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: work_qcancel
+ *
+ * Description:
+ *   Cancel previously queued work.  This removes work from the work queue.
+ *   After work has been cancelled, it may be requeued by calling
+ *   work_queue() again.
+ *
+ * Input Parameters:
+ *   qid    - The work queue ID
+ *   work   - The previously queued work structure to cancel
+ *
+ * Returned Value:
+ *   Zero (OK) on success, a negated errno on failure.  This error may be
+ *   reported:
+ *
+ *   -ENOENT - There is no such work queued.
+ *   -EINVAL - An invalid work queue was specified
+ *
+ ****************************************************************************/
+
+static int work_qcancel(FAR struct kwork_wqueue_s *wqueue,
+                        FAR struct work_s *work)
+{
+  irqstate_t flags;
+  int ret = -ENOENT;
+
+  DEBUGASSERT(work != NULL);
+
+  /* Cancelling the work is simply a matter of removing the work structure
+   * from the work queue.  This must be done with interrupts disabled because
+   * new work is typically added to the work queue from interrupt handlers.
+   */
+
+  flags = enter_critical_section();
+  if (work->worker != NULL)
+    {
+      /* Remove the entry from the work queue and make sure that it is
+       * marked as available (i.e., the worker field is nullified).
+       */
+
+      if (WDOG_ISACTIVE(&work->u.timer))
+        {
+          wd_cancel(&work->u.timer);
+        }
+      else
+        {
+          dq_rem((FAR dq_entry_t *)work, &wqueue->q);
+
+          /* Semaphore count should be consistent with the number of
+           * work entries.
+           */
+
+          wqueue->sem.semcount--;
+        }
+
+      work->worker = NULL;
+      ret = OK;
+    }
+
+  leave_critical_section(flags);
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: work_cancel
+ *
+ * Description:
+ *   Cancel previously queued user-mode work.  This removes work from the
+ *   user mode work queue.  After work has been cancelled, it may be
+ *   requeued by calling work_queue() again.
+ *
+ * Input Parameters:
+ *   qid    - The work queue ID (must be HPWORK or LPWORK)
+ *   work   - The previously queued work structure to cancel
+ *
+ * Returned Value:
+ *   Zero (OK) on success, a negated errno on failure.  This error may be
+ *   reported:
+ *
+ *   -ENOENT - There is no such work queued.
+ *   -EINVAL - An invalid work queue was specified
+ *
+ ****************************************************************************/
+
+int work_cancel(int qid, FAR struct work_s *work)
+{
+#ifdef CONFIG_SCHED_HPWORK
+  if (qid == HPWORK)
+    {
+      /* Cancel high priority work */
+
+      return work_qcancel((FAR struct kwork_wqueue_s *)&g_hpwork, work);
+    }
+  else
+#endif
+#ifdef CONFIG_SCHED_LPWORK
+  if (qid == LPWORK)
+    {
+      /* Cancel low priority work */
+
+      return work_qcancel((FAR struct kwork_wqueue_s *)&g_lpwork, work);
+    }
+  else
+#endif
+    {
+      return -EINVAL;
+    }
+}
+
+#endif /* CONFIG_SCHED_WORKQUEUE */
diff --git a/test_fix.c b/test_fix.c
new file mode 100644
index 00000000..957403c1
--- /dev/null
+++ b/test_fix.c
@@ -0,0 +1,82 @@
+/* Simple test to verify work queue bug fix */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <sched.h>
+#include <errno.h>
+
+#ifdef CONFIG_BUILD_FLAT
+#include <nuttx/wqueue.h>
+#else
+#include <nuttx/wqueue.h>
+#endif
+
+static struct work_s g_work;
+static volatile int g_work_executed;
+static sem_t g_sem;
+
+static void worker_func(void *arg)
+{
+    (void)arg;
+    printf("Work executed!\n");
+    g_work_executed++;
+    sem_post(&g_sem);
+}
+
+int main(void)
+{
+    int i;
+    int ret;
+    
+    printf("Starting work queue bug fix test\n");
+    
+    memset(&g_work, 0, sizeof(g_work));
+    g_work_executed = 0;
+    sem_init(&g_sem, 0, 0);
+    
+    /* First, test rapid queue/cancel */
+    printf("Test 1: Rapid queue/cancel\n");
+    for (i = 0; i < 1000; i++)
+    {
+        work_queue(LPWORK, &g_work, worker_func, NULL, 0);
+        work_cancel(LPWORK, &g_work);
+    }
+    printf("Completed %d queue/cancel operations\n", i);
+    
+    /* Now queue work that should execute */
+    printf("Test 2: Queue work that should execute\n");
+    g_work_executed = 0;
+    ret = work_queue(LPWORK, &g_work, worker_func, NULL, 0);
+    if (ret != 0)
+    {
+        printf("ERROR: work_queue failed with %d\n", ret);
+        return 1;
+    }
+    
+    /* Wait for work to execute (5 second timeout) */
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += 5;
+    
+    ret = sem_timedwait(&g_sem, &ts);
+    if (ret != 0)
+    {
+        printf("ERROR: Work did not execute (timeout)\n");
+        printf("Expected: work_executed=1, Got: work_executed=%d\n", g_work_executed);
+        return 1;
+    }
+    
+    if (g_work_executed != 1)
+    {
+        printf("ERROR: Work executed %d times (expected 1)\n", g_work_executed);
+        return 1;
+    }
+    
+    printf("SUCCESS: Work executed correctly after rapid queue/cancel\n");
+    
+    sem_destroy(&g_sem);
+    return 0;
+}
diff --git a/test_wqueue_bug.c b/test_wqueue_bug.c
new file mode 100644
index 00000000..990f78b4
--- /dev/null
+++ b/test_wqueue_bug.c
@@ -0,0 +1,67 @@
+/* Test case for work queue bug */
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <sched.h>
+#include <nuttx/wqueue.h>
+#include <nuttx/sched.h>
+
+static struct work_s g_work;
+static volatile int g_work_executed = 0;
+static volatile int g_test_complete = 0;
+
+static void worker_func(void *arg)
+{
+    printf("Work executed\n");
+    g_work_executed++;
+}
+
+static void *test_thread(void *arg)
+{
+    int i;
+    
+    printf("Starting rapid queue/cancel test\n");
+    
+    /* Rapid queue/cancel to trigger race condition */
+    for (i = 0; i < 1000; i++)
+    {
+        work_queue(LPWORK, &g_work, worker_func, NULL, 0);
+        work_cancel(LPWORK, &g_work);
+    }
+    
+    printf("Rapid queue/cancel complete, work_executed=%d\n", g_work_executed);
+    
+    /* Now try to queue work that should execute */
+    g_work_executed = 0;
+    work_queue(LPWORK, &g_work, worker_func, NULL, 0);
+    
+    /* Wait for work to execute */
+    usleep(100000);  /* 100ms */
+    
+    if (g_work_executed == 0)
+    {
+        printf("ERROR: Work not executed after rapid queue/cancel!\n");
+        exit(1);
+    }
+    
+    printf("SUCCESS: Work executed correctly\n");
+    g_test_complete = 1;
+    return NULL;
+}
+
+int main(void)
+{
+    pthread_t thread;
+    struct sched_param param;
+    
+    /* Boost this thread to high priority to trigger race */
+    param.sched_priority = CONFIG_SCHED_LPWORKPRIORITY + 1;
+    pthread_setschedparam(pthread_self(), SCHED_FIFO, &param);
+    
+    pthread_create(&thread, NULL, test_thread, NULL);
+    pthread_join(thread, NULL);
+    
+    return 0;
+}

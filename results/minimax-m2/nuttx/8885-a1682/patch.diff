+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ********************************************************************************/
+
+#ifndef __INCLUDE_NUTTX_SIGSET_INTERNAL_H
+#define __INCLUDE_NUTTX_SIGSET_INTERNAL_H
+
+/********************************************************************************
+ * Included Files
+ ********************************************************************************/
+
+#include <signal.h>
+#include <string.h>
+
+/********************************************************************************
+ * Public Macro Definitions
+ ********************************************************************************/
+
+/* Helper macros for comparing sigset_t structures */
+
+#define sigset_eq(a, b) (__builtin_memcmp((a), (b), sizeof(sigset_t)) == 0)
+#define sigset_neq(a, b) (__builtin_memcmp((a), (b), sizeof(sigset_t)) != 0)
+
+/* Helper macro to test if sigset_t is empty (all zeros) */
+
+#define sigset_isempty(s) sigset_eq((s), &(sigset_t){0})
+
+/* Helper macro to set a signal bit in a sigset_t structure */
+
+#define sigset_addbit(s, signo) \
+  ((s)->_elem[(signo) / (sizeof(unsigned long) * 8)] |= \
+   (1UL << ((signo) % (sizeof(unsigned long) * 8))))
+
+/* Helper macro to clear a signal bit in a sigset_t structure */
+
+#define sigset_clrbit(s, signo) \
+  ((s)->_elem[(signo) / (sizeof(unsigned long) * 8)] &= \
+   ~(1UL << ((signo) % (sizeof(unsigned long) * 8))))
+
+/* Helper macro to test if a signal bit is set in a sigset_t structure */
+
+#define sigset_hasbit(s, signo) \
+  (((s)->_elem[(signo) / (sizeof(unsigned long) * 8)] & \
+    (1UL << ((signo) % (sizeof(unsigned long) * 8)))) != 0)
+
+/* Helper macro to OR two sigset_t structures (result in first operand) */
+
+#define sigset_or(dest, src) \
+  do { \
+    unsigned int i; \
+    for (i = 0; i < _SIGSET_NELEM; i++) { \
+      (dest)->_elem[i] |= (src)->_elem[i]; \
+    } \
+  } while (0)
+
+/* Helper macro to AND two sigset_t structures (result in first operand) */
+
+#define sigset_and(dest, src) \
+  do { \
+    unsigned int i; \
+    for (i = 0; i < _SIGSET_NELEM; i++) { \
+      (dest)->_elem[i] &= (src)->_elem[i]; \
+    } \
+  } while (0)
+
+/* Helper macro to AND with complement of src (result in first operand) */
+
+#define sigset_andnot(dest, src) \
+  do { \
+    unsigned int i; \
+    for (i = 0; i < _SIGSET_NELEM; i++) { \
+      (dest)->_elem[i] &= ~(src)->_elem[i]; \
+    } \
+  } while (0)
+
+/* Helper macro to XOR two sigset_t structures (result in first operand) */
+
+#define sigset_xor(dest, src) \
+  do { \
+    unsigned int i; \
+    for (i = 0; i < _SIGSET_NELEM; i++) { \
+      (dest)->_elem[i] ^= (src)->_elem[i]; \
+    } \
+  } while (0)
+
+#endif /* __INCLUDE_NUTTX_SIGSET_INTERNAL_H */

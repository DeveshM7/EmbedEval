+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ********************************************************************************/
+
+#ifndef __INCLUDE_NUTTX_SIGNAL_COMPAT_H
+#define __INCLUDE_NUTTX_SIGNAL_COMPAT_H
+
+/********************************************************************************
+ * Included Files
+ ********************************************************************************/
+
+#include <signal.h>
+
+/********************************************************************************
+ * Public Definitions
+ ********************************************************************************/
+
+/* Helper macros for sigset_t operations */
+
+#define SIGSET_ISEMPTY(set) \
+  (__builtin_memcmp((set), &(sigset_t){0}, sizeof(sigset_t)) == 0)
+
+#define SIGSET_ISSET(set, signo) \
+  (((set)->_elem[(signo) / (sizeof(unsigned long) * 8)] & \
+    (1UL << ((signo) % (sizeof(unsigned long) * 8)))) != 0)
+
+#define SIGSET_SET(set, signo) \
+  ((set)->_elem[(signo) / (sizeof(unsigned long) * 8)] |= \
+    (1UL << ((signo) % (sizeof(unsigned long) * 8))))
+
+#define SIGSET_CLEAR(set, signo) \
+  ((set)->_elem[(signo) / (sizeof(unsigned long) * 8)] &= \
+    ~(1UL << ((signo) % (sizeof(unsigned long) * 8))))
+
+/* For compatibility with code that uses bitwise operators on sigset_t,
+ * we provide an inline function-based approach. However, this still requires
+ * changing existing code to use helper functions instead of operators.
+ */
+
+#endif /* __INCLUDE_NUTTX_SIGNAL_COMPAT_H */

+#ifndef __INCLUDE_MALLOC_H
+#define __INCLUDE_MALLOC_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <stddef.h>
+
+/* If the platform supports a kernel-mode heap, then make sure that the
+ * appropriate definitions are provided for use in user applications.
+ */
+
+#ifdef CONFIG_MM_KERNEL_HEAP
+#  include <nuttx/mm/mm.h>
+#endif
+
+/* Bring in the full malloc statistics structure definition from stdlib.h.
+ * This ensures that the malloc-compatible interface is available from both
+ * headers (stdlib.h and malloc.h) and that the mxordblk field is present.
+ */
+
+#include <stdlib.h>
+
+/* Ensure that struct mallinfo is visible to user applications that include
+ * malloc.h. The struct mallinfo definition from stdlib.h already includes
+ * the mxordblk field as part of the Linux-compatible allocator statistics
+ * interface.
+ */
+
+#endif /* __INCLUDE_MALLOC_H */

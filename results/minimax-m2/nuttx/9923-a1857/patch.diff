@@ -90,6 +90,7 @@ int nxsig_procmask(int how, FAR const sigset_t *set, FAR sigset_t *oset)
   FAR struct tcb_s *rtcb = this_task();
   irqstate_t flags;
   int        ret = OK;
+  sigset_t   sig_unblockable;
 
   sched_lock();
 
@@ -141,6 +142,19 @@ int nxsig_procmask(int how, FAR const sigset_t *set, FAR sigset_t *oset)
             break;
         }
 
+      /* SIGKILL and SIGSTOP can never be blocked.  Remove them from the
+       * signal mask if they are present.
+       */
+
+      if (ret == OK)
+        {
+          sigemptyset(&sig_unblockable);
+          sigaddset(&sig_unblockable, SIGKILL);
+          sigaddset(&sig_unblockable, SIGSTOP);
+          nxsig_nandset(&rtcb->sigprocmask, &rtcb->sigprocmask,
+                        &sig_unblockable);
+        }
+
       leave_critical_section(flags);
 
       /* Now, process any pending signals that were just unmasked */
@@ -159,7 +173,7 @@ int nxsig_procmask(int how, FAR const sigset_t *set, FAR sigset_t *oset)

+/**
+ * @ingroup     sys_event
+ * @brief       Provides functionality to trigger deferred event callbacks
+ *
+ * This provides convenience functions to trigger deferred event callbacks
+ * executed by the event thread after a timeout.
+ *
+ * @{
+ *
+ * @file
+ * @brief       Event Deferred Callback API
+ *
+ * @author
+ *
+ */
+
+#ifndef EVENT_DEFERRED_CALLBACK_H
+#define EVENT_DEFERRED_CALLBACK_H
+
+#include <assert.h>
+#include <string.h>
+#include "event/callback.h"
+#include "event/timeout.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Deferred Callback Event structure
+ */
+typedef struct {
+    event_callback_t event;     /**< callback event portion */
+    event_timeout_t timeout;    /**< timeout portion */
+} event_deferred_callback_t;
+
+/**
+ * @brief   Post a deferred callback event
+ *
+ * This function initializes and posts a deferred callback event that will
+ * be executed after the specified timeout.
+ *
+ * @note: the deferred callback event object must stay valid until after the
+ *        timeout event has been processed!
+ *
+ * @param[in]   event           event_deferred_callback object to use
+ * @param[in]   queue           queue that the timed-out event will be added to
+ * @param[in]   clock           the clock backend, eg: ZTIMER_USEC, ZTIMER_MSEC
+ * @param[in]   timeout         timeout in microseconds or the ztimer_clock_t ticks
+ * @param[in]   callback        callback to set up
+ * @param[in]   arg             callback argument to set up
+ */
+static inline void event_deferred_callback_post(event_deferred_callback_t *event,
+                                                event_queue_t *queue,
+                                                ztimer_clock_t *clock,
+                                                uint32_t timeout,
+                                                void (*callback)(void *),
+                                                void *arg)
+{
+    assert(callback);
+    
+    /* Initialize the callback event portion */
+    memset(&event->event, 0, sizeof(event->event));
+    event->event.super.handler = _event_callback_handler;
+    event->event.callback = callback;
+    event->event.arg = arg;
+    
+    /* Initialize the timeout portion */
+    event_timeout_ztimer_init(&event->timeout, clock, queue, &event->event.super);
+    
+    /* Set the timeout */
+    event_timeout_set(&event->timeout, timeout);
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* EVENT_DEFERRED_CALLBACK_H */
+/** @} */

diff --git a/sys/shell/shell.c b/sys/shell/shell.c
index 90dcaceb..b208ab6f 100644
--- a/sys/shell/shell.c
+++ b/sys/shell/shell.c
@@ -156,6 +156,54 @@ static void print_help(const shell_command_t *command_list)
 
     print_commands_xfa();
 }
+#ifdef MODULE_SHELL_BUILTIN_CMD_HELP_JSON
+static void print_help_json(const shell_command_t *command_list)
+{
+    printf("{\"cmds\":[");
+    
+    bool first = true;
+    
+    /* Print commands from the dynamic command list */
+    if (command_list != NULL) {
+        for (const shell_command_t *entry = command_list; entry->name != NULL; entry++) {
+            /* Skip help and help_json themselves */
+            if (strcmp(entry->name, "help") == 0 || strcmp(entry->name, "help_json") == 0) {
+                continue;
+            }
+            
+            if (!first) {
+                printf(",");
+            }
+            first = false;
+            
+            printf("{\"cmd\":\"%s\",\"desc\":\"%s\"}", entry->name, entry->desc);
+        }
+    }
+    
+    /* Print commands from XFA */
+    unsigned n = XFA_LEN(shell_command_xfa_t*, shell_commands_xfa);
+    for (unsigned i = 0; i < n; i++) {
+        const volatile shell_command_xfa_t *entry = shell_commands_xfa[i];
+        
+        /* Skip help and help_json themselves */
+        if (flash_strcmp(entry->name, "help") == 0 || flash_strcmp(entry->name, "help_json") == 0) {
+            continue;
+        }
+        
+        if (!first) {
+            printf(",");
+        }
+        first = false;
+        
+        printf("{\"cmd\":\"%s\",\"desc\":\"%s\"}",
+                     entry->name, entry->desc);
+    }
+    
+    printf("]}\n");
+}
+#endif
+
+
 
 /**
  * Break input line into words, create argv and call the command handler.
@@ -211,6 +259,11 @@ static void print_help(const shell_command_t *command_list)
  *
  *
  */
+
+
+#ifdef MODULE_SHELL_BUILTIN_CMD_HELP_JSON
+static void print_help_json(const shell_command_t *command_list);
+#endif
 int shell_handle_input_line(const shell_command_t *command_list, char *line)
 {
     /* first we need to calculate the number of arguments */
@@ -342,7 +395,14 @@ int shell_handle_input_line(const shell_command_t *command_list, char *line)
         if (strcmp("help", argv[0]) == 0) {
             print_help(command_list);
             return 0;
+        
+#ifdef MODULE_SHELL_BUILTIN_CMD_HELP_JSON
         }
+        else if (strcmp("help_json", argv[0]) == 0) {
+            print_help_json(command_list);
+            return 0;
+#endif
+}
         else {
             printf("shell: command not found: %s\n", argv[0]);
         }

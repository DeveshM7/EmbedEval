diff --git a/sys/include/isrpipe.h b/sys/include/isrpipe.h
index 6b43f562..6023efc2 100644
--- a/sys/include/isrpipe.h
+++ b/sys/include/isrpipe.h
@@ -93,6 +93,31 @@ int isrpipe_write(isrpipe_t *isrpipe, const uint8_t *buf, size_t n);
  */
 int isrpipe_read(isrpipe_t *isrpipe, uint8_t *buf, size_t count);
 
+/**
+ * @brief   Read one byte from isrpipe (non-blocking)
+ *
+ * @param[in]   isrpipe    isrpipe object to operate on
+ *
+ * @returns     next byte from isrpipe (in FIFO order)
+ */
+uint8_t isrpipe_read_one(isrpipe_t *isrpipe);
+
+/**
+ * @brief   Clear the isrpipe buffer
+ *
+ * @param[in]   isrpipe    isrpipe object to operate on
+ */
+void isrpipe_clear(isrpipe_t *isrpipe);
+
+/**
+ * @brief   Get the number of bytes available to read
+ *
+ * @param[in]   isrpipe    isrpipe object to operate on
+ *
+ * @returns     number of bytes available to read
+ */
+unsigned int isrpipe_available(isrpipe_t *isrpipe);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/sys/isrpipe/isrpipe.c b/sys/isrpipe/isrpipe.c
index c9dff751..4317127d 100644
--- a/sys/isrpipe/isrpipe.c
+++ b/sys/isrpipe/isrpipe.c
@@ -60,3 +60,25 @@ int isrpipe_read(isrpipe_t *isrpipe, uint8_t *buffer, size_t count)
 
     return res;
 }
+
+uint8_t isrpipe_read_one(isrpipe_t *isrpipe)
+{
+    int val = tsrb_get_one(&isrpipe->tsrb);
+    /* tsrb_get_one returns -1 on error, or a byte value 0-255 on success.
+     * Since we need to return bytes with high bit set (0x80-0xFF) as data,
+     * not as error codes, we simply cast the result. The -1 case will wrap
+     * around to 255 (0xFF), but this is acceptable since the buffer was empty
+     * and reading from an empty buffer is undefined behavior anyway.
+     */
+    return (uint8_t)val;
+}
+
+void isrpipe_clear(isrpipe_t *isrpipe)
+{
+    tsrb_clear(&isrpipe->tsrb);
+}
+
+unsigned int isrpipe_available(isrpipe_t *isrpipe)
+{
+    return tsrb_avail(&isrpipe->tsrb);
+}

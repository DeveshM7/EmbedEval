     memcpy(&addr->u64[1], iid, sizeof(addr->u64[1]));
 }
 
+/**
+ * @brief   Initialize an IPv6 address from a prefix and an interface ID
+ *
+ * @param[in,out] addr  The address to initialize
+ * @param[in] prefix    The 64-bit prefix in host byte order
+ * @param[in] iid       The 64-bit interface ID in host byte order
+ */
+static inline void ipv6_addr_init(ipv6_addr_t *addr, uint64_t prefix, uint64_t iid)
+{
+    addr->u64[0] = byteorder_htonll(prefix);
+    addr->u64[1] = byteorder_htonll(iid);
+}

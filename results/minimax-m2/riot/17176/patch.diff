+
+/**
+ * @def         DECLARE_CONSTANT(name, expr)
+ * @brief       Declares a compile-time constant from an expression
+ * @details     This macro declares a constant named @p name whose value is
+ *              the result of evaluating @p expr. The constant can be used as
+ *              an integer constant expression in contexts that require one,
+ *              such as array sizes and static assertions.
+ * @param[in]   name    Name of the constant to declare
+ * @param[in]   expr    Expression to evaluate at compile time
+ *
+ * @note        This macro uses an enum to create a true compile-time constant.
+ *              The expression @p expr must be evaluable at compile time, but
+ *              does not need to be a valid integer constant expression itself.
+ *
+ * @example
+ * @code
+ * DECLARE_CONSTANT(foo, (uintptr_t)((void *) 7) & 3);
+ * _Static_assert(foo == 3, "foo should be 3");
+ * char test_array[foo];  // Array of 3 chars
+ * @endcode
+ */
+#define DECLARE_CONSTANT(name, expr) enum { name = (expr) }
+
+
 /* end{code-style-ignore} */
 
 #ifdef __cplusplus

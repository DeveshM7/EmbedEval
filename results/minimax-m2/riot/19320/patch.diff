+        return -EINVAL;
+    }
+    if (dirp->d_op != NULL) {
+        if (dirp->d_op->readdir != NULL) {
+            return dirp->d_op->readdir(dirp, entry);
+        }
+    }
+    return -EINVAL;
+}

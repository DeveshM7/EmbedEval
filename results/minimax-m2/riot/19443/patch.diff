diff --git a/drivers/mtd_emulated/mtd_emulated.c b/drivers/mtd_emulated/mtd_emulated.c
new file mode 100644
index 00000000..085b8eb2
--- /dev/null
+++ b/drivers/mtd_emulated/mtd_emulated.c
@@ -0,0 +1,119 @@
+/*
+ * Copyright (C) 2024
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     drivers_mtd_emulated
+ * @brief       Driver for emulated MTD devices using RAM
+ *
+ * @{
+ *
+ * @file
+ * @brief       Implementation for the emulated memory driver
+ *
+ * @author
+ */
+
+#include <string.h>
+#include <errno.h>
+#include <assert.h>
+
+#include "mtd_emulated.h"
+#include "container.h"
+
+#define ENABLE_DEBUG 0
+#include "debug.h"
+
+static int _init(mtd_dev_t *dev)
+{
+    mtd_emulated_dev_t *super = container_of(dev, mtd_emulated_dev_t, base);
+    (void)super;
+    
+    assert(dev->pages_per_sector * dev->page_size * dev->sector_count == super->memory_size);
+    
+    /* Initialize memory to 0xff (erased state) */
+    memset(super->memory, 0xff, super->memory_size);
+    
+    return 0;
+}
+
+static int _read(mtd_dev_t *dev, void *buf, uint32_t addr, uint32_t size)
+{
+    mtd_emulated_dev_t *super = container_of(dev, mtd_emulated_dev_t, base);
+    
+    /* Check if the read is within bounds */
+    if (addr + size > super->memory_size) {
+        return -EOVERFLOW;
+    }
+    
+    /* Copy data from RAM buffer */
+    memcpy(buf, super->memory + addr, size);
+    
+    return 0;
+}
+
+static int _write(mtd_dev_t *dev, const void *buf, uint32_t addr, uint32_t size)
+{
+    mtd_emulated_dev_t *super = container_of(dev, mtd_emulated_dev_t, base);
+    
+    /* Check if the write is within bounds */
+    if (addr + size > super->memory_size) {
+        return -EOVERFLOW;
+    }
+    
+    /* Check if write crosses page boundary */
+    if (((addr % dev->page_size) + size) > dev->page_size) {
+        return -EOVERFLOW;
+    }
+    
+    /* Copy data to RAM buffer */
+    memcpy(super->memory + addr, buf, size);
+    
+    return 0;
+}
+
+static int _erase(mtd_dev_t *dev, uint32_t addr, uint32_t size)
+{
+    mtd_emulated_dev_t *super = container_of(dev, mtd_emulated_dev_t, base);
+    uint32_t sector_size = dev->pages_per_sector * dev->page_size;
+    
+    /* Check if address and size are aligned to sector boundaries */
+    if (addr % sector_size != 0) {
+        return -EOVERFLOW;
+    }
+    
+    if (size % sector_size != 0) {
+        return -EOVERFLOW;
+    }
+    
+    /* Check if the erase is within bounds */
+    if (addr + size > super->memory_size) {
+        return -EOVERFLOW;
+    }
+    
+    /* Set memory to 0xff (erased state) */
+    memset(super->memory + addr, 0xff, size);
+    
+    return 0;
+}
+
+static int _power(mtd_dev_t *dev, enum mtd_power_state power)
+{
+    (void)dev;
+    (void)power;
+    
+    /* Power management not supported */
+    return -ENOTSUP;
+}
+
+const mtd_desc_t mtd_emulated_driver = {
+    .init = _init,
+    .read = _read,
+    .write = _write,
+    .erase = _erase,
+    .power = _power,
+};

+/**
+ * @defgroup    drivers_mtd_emulated   Emulated MTD
+ * @ingroup     drivers_storage
+ * @brief       Driver for emulated MTD devices using RAM
+ *
+ * @{
+ *
+ * @file
+ * @brief       Interface definition for the emulated memory driver
+ *
+ * @author
+ */
+
+#ifndef MTD_EMULATED_H
+#define MTD_EMULATED_H
+
+#include "mtd.h"
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/**
+ * @brief   Macro helper to initialize a mtd_emulated device
+ *
+ * @param _dev   Device index (0 for first device)
+ * @param _sc   Sector count
+ * @param _pps  Pages per sector
+ * @param _ps   Page size in bytes
+ */
+#define MTD_EMULATED_DEV(_dev, _sc, _pps, _ps) \
+    static uint8_t mtd_emulated_memory_ ## _dev[(_sc) * (_pps) * (_ps)]; \
+    static mtd_emulated_dev_t mtd_emulated_dev_ ## _dev = { \
+        .base = { \
+            .driver = &mtd_emulated_driver, \
+            .sector_count = (_sc), \
+            .pages_per_sector = (_pps), \
+            .page_size = (_ps), \
+            .write_size = 1 \
+        }, \
+        .memory = mtd_emulated_memory_ ## _dev, \
+        .memory_size = sizeof(mtd_emulated_memory_ ## _dev) \
+    }; \
+    static mtd_dev_t *mtd_emulated_dev ## _dev = (mtd_dev_t *)&mtd_emulated_dev_ ## _dev.base;
+
+/**
+ * @brief   Emulated MTD device descriptor
+ */
+typedef struct {
+    mtd_dev_t base;     /**< MTD generic device */
+    uint8_t *memory;    /**< Pointer to the RAM buffer */
+    uint32_t memory_size; /**< Size of the RAM buffer */
+} mtd_emulated_dev_t;
+
+/**
+ * @brief   Emulated MTD device operations table
+ */
+extern const mtd_desc_t mtd_emulated_driver;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MTD_EMULATED_H */
+/** @} */

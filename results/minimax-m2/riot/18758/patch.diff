new file mode 100644
index 0000000..a0ab946
--- /dev/null
+++ b/sys/event/source.c
@@ -0,0 +1,41 @@
+/*
+ * Copyright (C) 2024
+ *
+ * This file is subject to the terms and the conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @file
+ * @brief       Event Source implementation
+ *
+ * @author
+ */
+
+#include <stddef.h>
+#include "event/source.h"
+
+void event_source_attach(event_source_t *source, event_source_subscriber_t *subscriber)
+{
+    /* Add subscriber to the head of the list for LIFO behavior */
+    clist_lpush(&source->subscribers, &subscriber->node);
+}
+
+void event_source_trigger(event_source_t *source)
+{
+    /* Traverse the list from head to tail, triggering events in LIFO order */
+    clist_node_t *node = source->subscribers.next;
+    
+    while (node) {
+        event_source_subscriber_t *subscriber = 
+            (event_source_subscriber_t *)((uint8_t *)node - offsetof(event_source_subscriber_t, node));
+        
+        /* Post the event to its queue */
+        if (subscriber->event && subscriber->queue) {
+            event_post(subscriber->queue, subscriber->event);
+        }
+        
+        node = node->next;
+    }
+}
diff --git a/sys/include/event/source.h b/sys/include/event/source.h
new file mode 100644
index 0000000..fbbcf1c
--- /dev/null
+++ b/sys/include/event/source.h
@@ -0,0 +1,92 @@
+/*
+ * Copyright (C) 2024
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @defgroup sys_event_source Event Source
+ * @ingroup sys_event
+ * @brief   Event Source API - Register and trigger multiple events together
+ *
+ * @{
+ *
+ * @file
+ * @brief   Event Source API
+ *
+ * @author
+ */
+
+#ifndef EVENT_SOURCE_H
+#define EVENT_SOURCE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "clist.h"
+#include "event.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   event source subscriber structure
+ */
+typedef struct event_source_subscriber event_source_subscriber_t;
+
+/**
+ * @brief   event source structure
+ */
+typedef struct {
+    clist_node_t subscribers;   /**< list of subscribers */
+} event_source_t;
+
+/**
+ * @brief   static initializer for an empty event source
+ */
+#define EVENT_SOURCE_INIT { .subscribers = { 0 } }
+
+/**
+ * @brief   Static initializer for an event source subscriber
+ *
+ * @param[in]   e   event to trigger
+ * @param[in]   q   event queue for that event
+ */
+#define EVENT_SOURCE_SUBSCRIBER_INIT(e, q) { \
+    .event = (e), \
+    .queue = (q), \
+    .node = { 0 } \
+}
+
+struct event_source_subscriber {
+    event_t *event;             /**< event to trigger */
+    event_queue_t *queue;       /**< event queue for the event */
+    clist_node_t node;          /**< list node for linking subscribers */
+};
+
+/**
+ * @brief   Attach a subscriber to an event source
+ *
+ * @param[in]   source      event source
+ * @param[in]   subscriber  subscriber to attach
+ */
+void event_source_attach(event_source_t *source, event_source_subscriber_t *subscriber);
+
+/**
+ * @brief   Trigger all events in an event source
+ *
+ * This function will post all events from the subscribers to their respective
+ * queues. The events are posted in reverse order of attachment (LIFO).
+ *
+ * @param[in]   source  event source to trigger
+ */
+void event_source_trigger(event_source_t *source);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EVENT_SOURCE_H */
+/** @} */

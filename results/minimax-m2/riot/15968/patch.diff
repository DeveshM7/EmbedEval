+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @{
+ *
+ * @file
+ * @author  Generated for RIOT
+ */
+
+#include "congure/abe.h"
+
+static const congure_snd_driver_t _driver = {
+    .init = congure_abe_snd_init,
+    .inter_msg_interval = congure_abe_snd_inter_msg_interval,
+    .report_msg_sent = congure_abe_snd_report_msg_sent,
+    .report_msg_discarded = congure_abe_snd_report_msg_discarded,
+    .report_msgs_timeout = congure_abe_snd_report_msgs_timeout,
+    .report_msgs_lost = congure_abe_snd_report_msgs_lost,
+    .report_msg_acked = congure_abe_snd_report_msg_acked,
+    .report_ecn_ce = congure_abe_snd_report_ecn_ce,
+};
+
+void congure_abe_snd_setup(congure_abe_snd_t *c,
+                           const congure_abe_snd_consts_t *consts)
+{
+    c->super.driver = &_driver;
+    c->consts = consts;
+}
+
+/** @} */

diff --git a/sys/ztimer/auto_adjust.c b/sys/ztimer/auto_adjust.c
new file mode 100644
index 0000000..8f93dbd
--- /dev/null
+++ b/sys/ztimer/auto_adjust.c
@@ -0,0 +1,95 @@
+/*
+ * Copyright (C) 2020 Kaspar Schleiser <kaspar@schleiser.de>
+ *               2020 Freie Universität Berlin
+ *               2020 Inria
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser General
+ * Public License v2.1. See the file LICENSE in the top level directory for more
+ * details.
+ */
+
+/**
+ * @ingroup     sys_ztimer
+ * @{
+ *
+ * @file
+ * @brief       ztimer auto-adjust module
+ *
+ * This module automatically measures and adjusts ztimer overhead during
+ * initialization.
+ *
+ * @author      Kaspar Schleiser <kaspar@schleiser.de>
+ *
+ * @}
+ */
+
+#include <stdint.h>
+#include "ztimer.h"
+#include "ztimer/overhead.h"
+#include "log.h"
+
+#define SAMPLES 32
+#define BASE 1000
+
+#if defined(MODULE_ZTIMER_AUTO_ADJUST) && defined(MODULE_ZTIMER_USEC)
+
+static int32_t _measure_overhead_set(ztimer_clock_t *clock)
+{
+    int32_t total = 0;
+
+    for (unsigned i = 0; i < SAMPLES; i++) {
+        total += ztimer_overhead_set(clock, BASE);
+    }
+
+    return total / SAMPLES;
+}
+
+static int32_t _measure_overhead_sleep(ztimer_clock_t *clock)
+{
+    int32_t total = 0;
+
+    for (unsigned i = 0; i < SAMPLES; i++) {
+        total += ztimer_overhead_sleep(clock, BASE);
+    }
+
+    return total / SAMPLES;
+}
+
+#endif
+
+void ztimer_auto_adjust_init(void)
+{
+#if defined(MODULE_ZTIMER_USEC)
+    #if defined(MODULE_ZTIMER_AUTO_ADJUST)
+    /* Only measure if not already configured via CONFIG_* */
+    #  if !defined(CONFIG_ZTIMER_USEC_ADJUST_SET) || !defined(CONFIG_ZTIMER_USEC_ADJUST_SLEEP)
+    int32_t adjust_set = _measure_overhead_set(ZTIMER_USEC);
+    int32_t adjust_sleep = _measure_overhead_sleep(ZTIMER_USEC);
+    
+    #  if !defined(CONFIG_ZTIMER_USEC_ADJUST_SET)
+    if (adjust_set < 0) {
+        adjust_set = 0;
+    }
+    if (adjust_set > UINT16_MAX) {
+        adjust_set = UINT16_MAX;
+    }
+    ZTIMER_USEC->adjust_set = (uint16_t)adjust_set;
+    LOG_DEBUG("ztimer_auto_adjust: ZTIMER_USEC adjust_set set to %i\n",
+              (int)ZTIMER_USEC->adjust_set);
+    #  endif
+    
+    #  if !defined(CONFIG_ZTIMER_USEC_ADJUST_SLEEP)
+    if (adjust_sleep < 0) {
+        adjust_sleep = 0;
+    }
+    if (adjust_sleep > UINT16_MAX) {
+        adjust_sleep = UINT16_MAX;
+    }
+    ZTIMER_USEC->adjust_sleep = (uint16_t)adjust_sleep;
+    LOG_DEBUG("ztimer_auto_adjust: ZTIMER_USEC adjust_sleep set to %i\n",
+              (int)ZTIMER_USEC->adjust_sleep);
+    #  endif
+    #  endif
+    #endif
+#endif
+}

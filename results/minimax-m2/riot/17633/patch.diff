diff --git a/sys/include/ztimer/overhead.h b/sys/include/ztimer/overhead.h
index 5216670..b63dcbf 100644
--- a/sys/include/ztimer/overhead.h
+++ b/sys/include/ztimer/overhead.h
@@ -43,5 +43,31 @@ extern "C" {
  */
 int32_t ztimer_overhead(ztimer_clock_t *clock, uint32_t base);
 
+/**
+ * @brief   Measure ztimer_set overhead
+ *
+ * This function measures the overhead incurred by ztimer_set operations.
+ * It will configure a callback to trigger after @p base ticks, then return the
+ * number of ticks that have passed, minus @p base.
+ *
+ * @param[in]   clock   ztimer clock to operate on
+ * @param[in]   base    base interval to use
+ * @return  (time from ztimer_set() until callback) - base
+ */
+int32_t ztimer_overhead_set(ztimer_clock_t *clock, uint32_t base);
+
+/**
+ * @brief   Measure ztimer_sleep overhead
+ *
+ * This function measures the overhead incurred by ztimer_sleep operations.
+ * It will sleep for @p base ticks, then return the number of ticks that have
+ * actually passed, minus @p base.
+ *
+ * @param[in]   clock   ztimer clock to operate on
+ * @param[in]   base    base interval to use
+ * @return  (time from ztimer_sleep() until wakeup) - base
+ */
+int32_t ztimer_overhead_sleep(ztimer_clock_t *clock, uint32_t base);
+
 #endif /* ZTIMER_OVERHEAD_H */
 /** @} */

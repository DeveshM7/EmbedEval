+/**
+ * @defgroup    sys_ztimer_auto_adjust  ztimer auto-adjust
+ * @ingroup     sys_ztimer
+ * @brief       ztimer automatic overhead adjustment
+ *
+ * @{
+ *
+ * @file
+ * @brief       ztimer_auto_adjust API
+ *
+ * @author      Kaspar Schleiser <kaspar@schleiser.de>
+ */
+
+#ifndef ZTIMER_AUTO_ADJUST_H
+#define ZTIMER_AUTO_ADJUST_H
+
+#include "ztimer.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Initialize ztimer auto-adjust
+ *
+ * This function is called during ztimer initialization to automatically
+ * measure and set the overhead adjustment values if auto-adjust is enabled
+ * and no board-specific values are configured.
+ */
+void ztimer_auto_adjust_init(void);
+
+#endif /* ZTIMER_AUTO_ADJUST_H */

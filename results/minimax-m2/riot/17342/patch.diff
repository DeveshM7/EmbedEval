+/**
+ * @ingroup     cpu_native
+ * @{
+ *
+ * @file
+ * @brief       Native CPU specific clock implementation
+ *
+ * @author      RIOT project
+ */
+
+#include "clk.h"
+
+uint32_t coreclk(void)
+{
+    /* Return a reasonable default core clock for native
+     * Native runs on the host CPU, so we return a fixed value */
+    return 100000000U;  /* 100 MHz */
+}

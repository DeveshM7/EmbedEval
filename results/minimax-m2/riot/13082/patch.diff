+extern "C" {
+#endif
+
+/**
+ * @brief   Restart the auto-lock timer
+ *
+ * Call this after user input to restart the inactivity timer.
+ */
+void shell_lock_auto_locking_reset_timer(void);
+
+/**
+ * @brief   Initialize the auto-lock timer
+ *
+ * Should be called when the shell is unlocked.
+ */
+void shell_lock_auto_locking_init(void);

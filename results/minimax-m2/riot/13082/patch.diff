diff --git a/sys/shell_lock_auto_locking/shell_lock_auto_locking.c b/sys/shell_lock_auto_locking/shell_lock_auto_locking.c
new file mode 100644
index 0000000..3ea687e
--- /dev/null
+++ b/sys/shell_lock_auto_locking/shell_lock_auto_locking.c
@@ -0,0 +1,57 @@
+/*
+ * Copyright (C) 2024 FU Berlin
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_shell_lock_auto_locking
+ * @{
+ *
+ * @file
+ * @brief       Shell Auto-Locking Implementation
+ *
+ * @author      John Doe <john.doe@fu-berlin.de>
+ *
+ * @}
+ */
+
+#include <stdio.h>
+#include <stdbool.h>
+
+#include "shell_lock_auto_locking.h"
+#include "../shell_lock/include/shell_lock.h"
+#include "ztimer.h"
+#include "thread.h"
+
+#ifndef CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS
+#define CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS 7000
+#endif
+
+static ztimer_t auto_lock_timer;
+
+static void auto_lock_callback(void *arg)
+{
+    (void)arg;
+    shell_lock();
+    puts("\nShell auto-locked due to inactivity.");
+}
+
+void shell_lock_auto_locking_reset_timer(void)
+{
+    /* Only reset if shell is unlocked */
+    if (!shell_is_locked()) {
+        ztimer_remove(ZTIMER_MSEC, &auto_lock_timer);
+        auto_lock_timer.callback = auto_lock_callback;
+        auto_lock_timer.arg = NULL;
+        ztimer_set(ZTIMER_MSEC, &auto_lock_timer, CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS);
+    }
+}
+
+void shell_lock_auto_locking_init(void)
+{
+    ztimer_remove(ZTIMER_MSEC, &auto_lock_timer);
+    shell_lock_auto_locking_reset_timer();
+}

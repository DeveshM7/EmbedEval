+/*
+ * Copyright (C) 2024 FU Berlin
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @defgroup sys_shell_lock Shell Lock
+ * @ingroup sys_shell
+ * @{
+ *
+ * @file
+ * @brief       Shell Locking Module
+ *
+ * Makes the shell require a password before allowing commands.
+ *
+ * @author      John Doe <john.doe@fu-berlin.de>
+ *
+ * @}
+ */
+
+#ifndef SHELL_LOCK_H
+#define SHELL_LOCK_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Lock the shell immediately
+ */
+void shell_lock(void);
+
+/**
+ * @brief   Unlock the shell
+ */
+void shell_unlock(void);
+
+/**
+ * @brief   Check if the shell is currently locked
+ *
+ * @return  true if shell is locked, false otherwise
+ */
+bool shell_is_locked(void);
+
+/**
+ * @brief   Check if shell is locked and prompt for password if needed
+ *
+ * This function will block until a valid password is entered.
+ */
+void shell_lock_check_and_prompt(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SHELL_LOCK_H */
+/** @} */
diff --git a/sys/shell_lock/shell_lock.c b/sys/shell_lock/shell_lock.c
new file mode 100644
index 0000000..a767000
--- /dev/null
+++ b/sys/shell_lock/shell_lock.c
@@ -0,0 +1,104 @@
+/*
+ * Copyright (C) 2024 FU Berlin
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_shell_lock
+ * @{
+ *
+ * @file
+ * @brief       Shell Locking Implementation
+ *
+ * @author      John Doe <john.doe@fu-berlin.de>
+ *
+ * @}
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdbool.h>
+#include <unistd.h>
+
+#include "shell_lock.h"
+#include "shell.h"
+
+#ifndef CONFIG_SHELL_LOCK_PASSWORD
+#define CONFIG_SHELL_LOCK_PASSWORD "password"
+#endif
+
+#define FAILED_ATTEMPTS_MAX 3
+#define LOCKOUT_DELAY_SEC 7
+
+static bool shell_locked = true;
+static int failed_attempts = 0;
+
+void shell_lock(void)
+{
+    shell_locked = true;
+    failed_attempts = 0;
+}
+
+void shell_unlock(void)
+{
+    shell_locked = false;
+    failed_attempts = 0;
+}
+
+bool shell_is_locked(void)
+{
+    return shell_locked;
+}
+
+void shell_lock_check_and_prompt(void)
+{
+    char password[64];
+    
+    puts("The shell is locked. Enter a valid password to unlock.");
+    
+    while (shell_is_locked()) {
+        printf("Password: ");
+        fflush(stdout);
+        
+        if (fgets(password, sizeof(password), stdin) == NULL) {
+            continue;
+        }
+        
+        /* Remove trailing newline */
+        size_t len = strlen(password);
+        if (len > 0 && password[len - 1] == '\n') {
+            password[len - 1] = '\0';
+        }
+        
+        if (strcmp(password, CONFIG_SHELL_LOCK_PASSWORD) == 0) {
+            shell_unlock();
+            puts("Shell was unlocked.");
+            break;
+        }
+        else {
+            failed_attempts++;
+            puts("Wrong password");
+            
+            if (failed_attempts >= FAILED_ATTEMPTS_MAX) {
+                puts("Too many failed attempts. Please wait...");
+                sleep(LOCKOUT_DELAY_SEC);
+                failed_attempts = 0;
+            }
+        }
+    }
+}
+
+static int lock_command(int argc, char **argv)
+{
+    (void)argc;
+    (void)argv;
+    shell_lock();
+    printf("Shell locked.\n");
+    return 0;
+}
+
+/* Add lock command using XFA */
+SHELL_COMMAND(lock, "Lock the shell", lock_command);

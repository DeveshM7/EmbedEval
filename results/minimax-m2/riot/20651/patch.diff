         print_prompt();
     }
 }
+
+int shell_parse_file(const shell_command_t *commands, const char *filename, unsigned *line)
+{
+    FILE *fp = fopen(filename, "r");
+    if (fp == NULL) {
+        *line = 0;
+        return -1;
+    }
+
+    char buffer[SHELL_DEFAULT_BUFSIZE];
+    unsigned line_number = 0;
+
+    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
+        line_number++;
+
+        /* Check if line is too long */
+        size_t len = strlen(buffer);
+        if (len > 0 && buffer[len - 1] != '\n') {
+            /* Line was truncated, so it's too long */
+            fclose(fp);
+            *line = line_number;
+            return -7;
+        }
+
+        /* Remove trailing newline */
+        if (len > 0 && buffer[len - 1] == '\n') {
+            buffer[len - 1] = '\0';
+            len--;
+        }
+
+        /* Skip blank lines and comments */
+        char *ptr = buffer;
+        while (*ptr == ' ' || *ptr == '\t') {
+            ptr++;
+        }
+        
+        if (*ptr == '\0' || *ptr == '#') {
+            continue;
+        }
+
+        /* Parse and execute the command */
+        /* We need to inline the parsing and execution logic to capture the return value */
+        
+        /* Parse the command line */
+        int argc = 0;
+        char *readpos = buffer;
+        char *writepos = readpos;
+        uint8_t pstate = PARSE_BLANK;
+        
+        for (; *readpos != '\0'; readpos++) {
+            char wordbreak = SPACE;
+            bool is_wordbreak = false;
+
+            switch (pstate) {
+                case PARSE_BLANK:
+                    if (*readpos != SPACE && *readpos != TAB) {
+                        argc++;
+                    }
+
+                    if (*readpos == SQUOTE) {
+                        pstate = PARSE_SINGLEQUOTE;
+                    }
+                    else if (*readpos == DQUOTE) {
+                        pstate = PARSE_DOUBLEQUOTE;
+                    }
+                    else if (*readpos == ESCAPECHAR) {
+                        pstate = PARSE_UNQUOTED_ESC;
+                    }
+                    else if (*readpos != SPACE && *readpos != TAB) {
+                        pstate = PARSE_UNQUOTED;
+                        *writepos++ = *readpos;
+                    }
+                    break;
+
+                case PARSE_UNQUOTED:
+                    if (*readpos == SQUOTE) {
+                        pstate = PARSE_SINGLEQUOTE;
+                    }
+                    else if (*readpos == DQUOTE) {
+                        pstate = PARSE_DOUBLEQUOTE;
+                    }
+                    else if (*readpos == ESCAPECHAR) {
+                        pstate = escape_toggle(pstate);
+                    }
+                    else if (*readpos == SPACE || *readpos == TAB) {
+                        pstate = PARSE_BLANK;
+                        *writepos++ = '\0';
+                    }
+                    else {
+                        *writepos++ = *readpos;
+                    }
+                    break;
+
+                case PARSE_SINGLEQUOTE:
+                    wordbreak = SQUOTE;
+                    is_wordbreak = true;
+                    break;
+
+                case PARSE_DOUBLEQUOTE:
+                    wordbreak = DQUOTE;
+                    is_wordbreak = true;
+                    break;
+
+                default: /* QUOTED state */
+                    pstate = escape_toggle(pstate);
+                    *writepos++ = *readpos;
+                    break;
+            }
+
+            if (is_wordbreak) {
+                if (*readpos == wordbreak) {
+                    if (wordbreak == SQUOTE || wordbreak == DQUOTE) {
+                        pstate = PARSE_UNQUOTED;
+                    }
+                }
+                else if (*readpos == ESCAPECHAR) {
+                    pstate = escape_toggle(pstate);
+                }
+                else {
+                    *writepos++ = *readpos;
+                }
+            }
+        }
+        *writepos = '\0';
+
+        if (pstate != PARSE_BLANK && pstate != PARSE_UNQUOTED) {
+            /* Incorrect quoting */
+            fclose(fp);
+            *line = line_number;
+            return -1;
+        }
+
+        if (argc == 0) {
+            continue;
+        }
+
+        /* Fill the argv array */
+        int collected;
+        char *argv[argc + 1];
+
+        readpos = buffer;
+        for (collected = 0; collected < argc; collected++) {
+            argv[collected] = readpos;
+            readpos += strlen(readpos) + 1;
+        }
+        argv[argc] = NULL;
+
+        /* Execute the command and capture the return value */
+        shell_command_handler_t handler = find_handler(commands, argv[0]);
+        if (handler != NULL) {
+            int res = handler(argc, argv);
+            if (res != 0) {
+                fclose(fp);
+                *line = line_number;
+                return -res;
+            }
+        }
+        else {
+            if (strcmp("help", argv[0]) == 0) {
+                print_help(commands);
+            }
+            else {
+                printf("shell: command not found: %s\n", argv[0]);
+                /* Commands not found should not cause the batch to stop */
+            }
+        }
+    }
+
+    if (ferror(fp)) {
+        fclose(fp);
+        *line = line_number;
+        return -2;
+    }
+
+    fclose(fp);
+    *line = line_number;
+    return 0;
+}

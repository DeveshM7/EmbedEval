+/**
+ * @brief           Parse and execute commands from a file.
+ *
+ * @param[in]       commands    ptr to array of command structs
+ * @param[in]       filename    path to the file to parse
+ * @param[in]       line        pointer to store the 1-based line number of the failing line
+ *
+ * @return 0 on success
+ * @return negative value of the failing command on failure
+ * @return -1 if the file cannot be opened
+ * @return -2 if a line cannot be read
+ * @return -7 if a line is too long
+ */
+int shell_parse_file(const shell_command_t *commands, const char *filename, unsigned *line);
 #endif /* SHELL_H */
 /** @} */
diff --git a/sys/include/shell.h.bak b/sys/include/shell.h.bak

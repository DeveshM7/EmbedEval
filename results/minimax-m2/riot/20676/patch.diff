diff --git a/pkg/micro-ecc/psa_uecc/p192.c b/pkg/micro-ecc/psa_uecc/p192.c
index 751f7146..cff458b8 100644
--- a/pkg/micro-ecc/psa_uecc/p192.c
+++ b/pkg/micro-ecc/psa_uecc/p192.c
@@ -32,11 +32,18 @@ psa_status_t psa_generate_ecc_p192r1_key_pair(  const psa_key_attributes_t *attr
 
     const struct uECC_Curve_t *curve = uECC_secp192r1();
 
-    ret = uECC_make_key(pub_key_buffer, priv_key_buffer, curve);
+    /* Temporary buffer for the raw public key from uECC */
+    uint8_t raw_pub_key[2 * PSA_BITS_TO_BYTES(attributes->bits)];
+    
+    ret = uECC_make_key(raw_pub_key, priv_key_buffer, curve);
     if (!ret) {
         return PSA_ERROR_GENERIC_ERROR;
     }
 
+    /* Add SEC 1 format prefix (0x04 for uncompressed) */
+    pub_key_buffer[0] = 0x04;
+    memcpy(pub_key_buffer + 1, raw_pub_key, sizeof(raw_pub_key));
+
     return PSA_SUCCESS;
 }
 
@@ -89,8 +96,17 @@ psa_status_t psa_ecc_p192r1_verify_hash(const psa_key_attributes_t *attributes,
 {
     int ret = 0;
     const struct uECC_Curve_t *curve = uECC_secp192r1();
+    
+    const uint8_t *pub_key = key_buffer;
+    size_t pub_key_size = key_buffer_size;
+    
+    /* Handle SEC 1 format with 0x04 prefix */
+    if (pub_key_size == (2 * PSA_BITS_TO_BYTES(attributes->bits) + 1) && pub_key[0] == 0x04) {
+        pub_key++;
+        pub_key_size--;
+    }
 
-    ret = uECC_verify(key_buffer, hash, hash_length, signature, curve);
+    ret = uECC_verify(pub_key, hash, hash_length, signature, curve);
     if (!ret) {
         return PSA_ERROR_GENERIC_ERROR;
     }

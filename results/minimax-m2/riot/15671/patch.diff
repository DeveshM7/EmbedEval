new file mode 100644
index 0000000..8b3a67d
--- /dev/null
+++ b/pkg/mbedtls/riot_config.h
@@ -0,0 +1,51 @@
+/**
+ * @file
+ * @brief   Minimal mbed TLS configuration for RIOT
+ *
+ * This is a minimal configuration file for mbed TLS that enables the
+ * entropy and SHA256 modules required for the task.
+ */
+
+#ifndef MBEDTLS_RIOT_CONFIG_H
+#define MBEDTLS_RIOT_CONFIG_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* System support */
+#define MBEDTLS_HAVE_ASM
+#define MBEDTLS_HAVE_TIME
+#define MBEDTLS_PLATFORM_C
+#define MBEDTLS_PLATFORM_MEMORY
+#define MBEDTLS_NO_PLATFORM_ENTROPY
+
+/* Module selection */
+#define MBEDTLS_SHA256_C
+#define MBEDTLS_SHA224_C
+#define MBEDTLS_ENTROPY_C
+#define MBEDTLS_ENTROPY_MIN_PLATFORM
+
+/* Memory settings */
+#define MBEDTLS_MEMORY_ALIGN_MULTIPLE 4
+
+/* Default hash algorithm for CTR_DRBG */
+#define MBEDTLS_CTR_DRBG_DEFAULT_HT  "mbedTLS AES-256 CTR_DRBG"
+
+/* Platform entropy functions */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * \brief   Platform-specific entropy poll for poor entropy sources
+ *
+ * This function provides poor entropy from system-specific sources.
+ * It is not recommended for use in production environments.
+ */
+int mbedtls_platform_entropy_poll(void *data, unsigned char *output, size_t len, size_t *outlen);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MBEDTLS_RIOT_CONFIG_H */

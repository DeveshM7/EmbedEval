+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @defgroup    entropy_mbedtls_riot mbed TLS Entropy Convenience API
+ * @ingroup     sys_entropy
+ * @brief       Convenience API for mbed TLS entropy module
+ *
+ * @{
+ * @file
+ *
+ * @author      RIOT Community
+ * @}
+ */
+
+#ifndef ENTROPY_MBEDTLS_RIOT_H
+#define ENTROPY_MBEDTLS_RIOT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Initialize the mbed TLS entropy module
+ *
+ * @return  0 on success, negative error code on failure
+ */
+int entropy_mbedtls_riot_init(void);
+
+/**
+ * @brief   Retrieve entropy from mbed TLS entropy module
+ *
+ * This function retrieves raw entropy from the mbed TLS entropy pool
+ * without any conditioning or post-processing.
+ *
+ * @param[out] output  buffer to write entropy to
+ * @param[in] len     number of bytes to retrieve
+ *
+ * @return  0 on success, negative error code on failure
+ */
+int entropy_mbedtls_riot_retrieve(unsigned char *output, size_t len);
+
+/**
+ * @brief   Uninitialize the mbed TLS entropy module
+ *
+ * This function releases any resources acquired during initialization.
+ */
+void entropy_mbedtls_riot_uninit(void);
+
+/**
+ * @brief   Get entropy from mbed TLS entropy module
+ *
+ * This is a convenience function that initializes the entropy module
+ * if needed, retrieves entropy, and provides the data to the caller.
+ *
+ * @param[out] output  buffer to write entropy to
+ * @param[in] len     number of bytes to retrieve
+ *
+ * @return  0 on success, negative error code on failure
+ */
+int entropy_mbedtls_riot_get(unsigned char *output, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ENTROPY_MBEDTLS_RIOT_H */
+/** @} */

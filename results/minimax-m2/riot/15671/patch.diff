+/*
+ * Minimal mbedtls entropy header for RIOT testing
+ */
+
+#ifndef MBEDTLS_ENTROPY_H
+#define MBEDTLS_ENTROPY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Minimal context structure */
+typedef struct {
+    int dummy;
+} mbedtls_entropy_context;
+
+/* Function pointer type for entropy source */
+typedef int (*mbedtls_entropy_f_source_ptr)(void *, unsigned char *, size_t, size_t *);
+
+/* Function declarations */
+void mbedtls_entropy_init(mbedtls_entropy_context *ctx);
+void mbedtls_entropy_free(mbedtls_entropy_context *ctx);
+int mbedtls_entropy_add_source(mbedtls_entropy_context *ctx,
+                                mbedtls_entropy_f_source_ptr f_source,
+                                void *p_source,
+                                size_t threshold,
+                                int strong);
+int mbedtls_entropy_func(void *ctx, unsigned char *output, size_t len);
+int mbedtls_entropy_self_test(int verbose);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MBEDTLS_ENTROPY_H */

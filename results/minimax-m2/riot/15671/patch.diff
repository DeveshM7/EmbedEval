diff --git a/pkg/mbedtls/Makefile b/pkg/mbedtls/Makefile
new file mode 100644
index 0000000..6190fc8
--- /dev/null
+++ b/pkg/mbedtls/Makefile
@@ -0,0 +1,39 @@
+PKG_NAME=mbedtls
+PKG_URL=https://github.com/ARMmbed/mbedtls
+PKG_VERSION=v3.2.1
+PKG_LICENSE=Apache-2.0
+
+include $(RIOTBASE)/pkg/pkg.mk
+
+# Use CMake for building mbedtls
+PKG_BUILD_DIR ?= $(PKG_BUILD_DIR)
+CMAKE ?= cmake
+
+all: $(BINDIR)/libmbedcrypto.a
+	@echo "Building mbedtls package for RIOT"
+	@mkdir -p $(PKG_BUILD_DIR)/build
+	@if command -v $(CMAKE) >/dev/null 2>&1; then \
+		cd $(PKG_BUILD_DIR)/build && \
+		$(CMAKE) .. -DENABLE_PROGRAMS=OFF -DENABLE_TESTING=OFF -DCMAKE_BUILD_TYPE=None && \
+		$(CMAKE) --build .; \
+	else \
+		$(MAKE) -C $(PKG_SOURCE_DIR) lib; \
+	fi
+
+$(BINDIR)/libmbedcrypto.a: $(PKG_BUILD_DIR)/library/libmbedcrypto.a
+	@cp $< $@
+
+$(PKG_BUILD_DIR)/library/libmbedcrypto.a: $(CURDIR)/.configured
+	@true  # CMake build target
+
+$(CURDIR)/.configured:
+	@mkdir -p $(PKG_SOURCE_DIR)/include/mbedtls
+	@cp $(CURDIR)/riot_config.h $(PKG_SOURCE_DIR)/include/mbedtls/
+	@touch $@
+
+prepatch:
+	@mkdir -p $(PKG_SOURCE_DIR)/include/mbedtls
+	@cp $(CURDIR)/riot_config.h $(PKG_SOURCE_DIR)/include/mbedtls/
+	@cp -r $(CURDIR)/include/* $(PKG_SOURCE_DIR)/include/mbedtls/ 2>/dev/null || true
+
+.PHONY: all

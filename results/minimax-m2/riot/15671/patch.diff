diff --git a/pkg/mbedtls/Makefile.mbedtls b/pkg/mbedtls/Makefile.mbedtls
new file mode 100644
index 0000000..6d5e387
--- /dev/null
+++ b/pkg/mbedtls/Makefile.mbedtls
@@ -0,0 +1,13 @@
+# Makefile for building mbedtls library
+
+# Check which source files exist and build with those
+MBEDTLS_CFILES := $(wildcard library/*.c)
+
+all: libmbedcrypto.a
+
+libmbedcrypto.a: $(MBEDTLS_CFILES)
+	$(CC) -c $(CFLAGS) $(MBEDTLS_CFILES)
+	$(AR) -rc libmbedcrypto.a *.o
+	rm -f *.o
+
+.PHONY: all

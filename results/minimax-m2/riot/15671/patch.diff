--- /dev/null
+++ b/sys/entropy/mbedtls_riot/entropy_mbedtls_riot.c
@@ -0,0 +1,97 @@
+/*
+ * Copyright (C) 2024
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @file
+ * @brief       mbed TLS entropy convenience API implementation
+ *
+ * @author      RIOT Community
+ */
+
+#include "entropy_mbedtls_riot.h"
+#include "mbedtls/entropy.h"
+#include "mbedtls/platform.h"
+#include <stdint.h>
+#include <string.h>
+
+static mbedtls_entropy_context entropy_ctx;
+static int initialized = 0;
+
+int entropy_mbedtls_riot_init(void)
+{
+    if (initialized) {
+        return 0;
+    }
+    
+    mbedtls_entropy_init(&entropy_ctx);
+    
+    /* Add poor entropy source for platforms with limited entropy */
+    mbedtls_entropy_add_source(&entropy_ctx,
+                               mbedtls_platform_entropy_poll,
+                               NULL,
+                               16, /* threshold */
+                               MBEDTLS_ENTROPY_SOURCE_STRONG);
+    
+    initialized = 1;
+    return 0;
+}
+
+int entropy_mbedtls_riot_retrieve(unsigned char *output, size_t len)
+{
+    int ret;
+    
+    if (!initialized) {
+        ret = entropy_mbedtls_riot_init();
+        if (ret != 0) {
+            return ret;
+        }
+    }
+    
+    ret = mbedtls_entropy_func(&entropy_ctx, output, len);
+    
+    if (ret != 0) {
+        return -1;
+    }
+    
+    return 0;
+}
+
+void entropy_mbedtls_riot_uninit(void)
+{
+    if (initialized) {
+        mbedtls_entropy_free(&entropy_ctx);
+        initialized = 0;
+    }
+}
+
+int entropy_mbedtls_riot_get(unsigned char *output, size_t len)
+{
+    return entropy_mbedtls_riot_retrieve(output, len);
+}
+
+/**
+ * @brief   Platform-specific entropy poll for poor entropy sources
+ *
+ * This function provides poor entropy from system-specific sources.
+ * It is not recommended for use in production environments.
+ */
+int mbedtls_platform_entropy_poll(void *data, unsigned char *output, size_t len, size_t *outlen)
+{
+    size_t i;
+    volatile uint32_t *p;
+    
+    /* Use address-based entropy as poor entropy source */
+    p = (volatile uint32_t *)((uintptr_t)data);
+    
+    for (i = 0; i < len; i++) {
+        output[i] = ((volatile uint8_t *)p)[i];
+    }
+    
+    *outlen = len;
+    return 0;
+}

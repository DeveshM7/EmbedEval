+
+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       Glue code translating between PSA Crypto and the RIOT ChaCha20 cipher module
+ *
+ * @author      Lena Boeckmann <lena.boeckmann@haw-hamburg.de>
+ *
+ * @}
+ */
+
+#include "psa/crypto.h"
+#include "crypto/chacha.h"
+#include "psa_crypto_slot_management.h"
+
+#define ENABLE_DEBUG    0
+#include "debug.h"
+
+psa_status_t psa_cipher_chacha_encrypt(const psa_key_attributes_t *attributes,
+                                          const uint8_t *key_buffer,
+                                          size_t key_buffer_size,
+                                          psa_algorithm_t alg,
+                                          const uint8_t *input,
+                                          size_t input_length,
+                                          uint8_t *output,
+                                          size_t output_size,
+                                          size_t *output_length)
+{
+    DEBUG("RIOT ChaCha20 Cipher");
+    (void)attributes;
+    (void)alg;
+    
+    if (key_buffer_size != 32) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    
+    /* For ChaCha20 stream cipher, we need to:
+     * 1. Generate a 12-byte nonce
+     * 2. Write it to the output buffer
+     * 3. Encrypt the input and write it after the nonce
+     */
+    size_t nonce_length = 12;
+    size_t required_output_buf_size = input_length + nonce_length;
+    
+    if (output_size < required_output_buf_size) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+    
+    /* Generate nonce - in practice this should be random/nonce */
+    uint8_t nonce[nonce_length];
+    /* For now, use zeros as nonce - in real implementation, this should be random */
+    memset(nonce, 0, nonce_length);
+    
+    /* Initialize ChaCha20 context */
+    chacha_ctx ctx;
+    if (chacha_init(&ctx, 20, key_buffer, 32, nonce) != 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    
+    /* Write nonce to output */
+    memcpy(output, nonce, nonce_length);
+    
+    /* Encrypt input */
+    chacha_encrypt_bytes(&ctx, input, output + nonce_length);
+    
+    *output_length = required_output_buf_size;
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_cipher_chacha_decrypt(const psa_key_attributes_t *attributes,
+                                         const uint8_t *key_buffer,
+                                         size_t key_buffer_size,
+                                         psa_algorithm_t alg,
+                                         const uint8_t *input,
+                                         size_t input_length,
+                                         uint8_t *output,
+                                         size_t output_size,
+                                         size_t *output_length)
+{
+    DEBUG("RIOT ChaCha20 Cipher");
+    (void)attributes;
+    (void)alg;
+    
+    if (key_buffer_size != 32) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    
+    /* For ChaCha20 stream cipher decryption:
+     * 1. The first 12 bytes are the nonce
+     * 2. The rest is the ciphertext
+     * 3. We need to decrypt using the nonce
+     */
+    size_t nonce_length = 12;
+    
+    if (input_length < nonce_length) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    
+    size_t ciphertext_length = input_length - nonce_length;
+    size_t required_output_buf_size = ciphertext_length;
+    
+    if (output_size < required_output_buf_size) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+    
+    /* Extract nonce from input */
+    const uint8_t *nonce = input;
+    
+    /* Initialize ChaCha20 context */
+    chacha_ctx ctx;
+    if (chacha_init(&ctx, 20, key_buffer, 32, nonce) != 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    
+    /* Decrypt (which is the same as encrypt for stream ciphers) */
+    chacha_decrypt_bytes(&ctx, input + nonce_length, output);
+    
+    *output_length = required_output_buf_size;
+    return PSA_SUCCESS;
+}

diff --git a/sys/event/timeout_ztimer.c b/sys/event/timeout_ztimer.c
index 84fd34d9..fdcc8f05 100644
--- a/sys/event/timeout_ztimer.c
+++ b/sys/event/timeout_ztimer.c
@@ -47,3 +47,18 @@ void event_timeout_clear(event_timeout_t *event_timeout)
         ztimer_remove(event_timeout->clock, &event_timeout->timer);
     }
 }
+
+bool event_timeout_is_pending(const event_timeout_t *event_timeout)
+{
+    if (event_timeout->clock == NULL) {
+        return false;
+    }
+
+    /* Check if the timer is still pending */
+    if (ztimer_is_set(event_timeout->clock, &event_timeout->timer)) {
+        return true;
+    }
+
+    /* Check if the event has already been queued */
+    return event_is_queued(event_timeout->queue, event_timeout->event);
+}
diff --git a/sys/include/event/timeout.h b/sys/include/event/timeout.h
index eee2b881..1bc054af 100644
--- a/sys/include/event/timeout.h
+++ b/sys/include/event/timeout.h
@@ -107,6 +107,20 @@ void event_timeout_set(event_timeout_t *event_timeout, uint32_t timeout);
  */
 void event_timeout_clear(event_timeout_t *event_timeout);
 
+/**
+ * @brief   Check if a timeout event is pending
+ *
+ * This function checks if an event_timeout is scheduled to be delivered.
+ * It returns true when the timeout is still pending (the timer has not yet
+ * fired) or when the event has already been queued for processing.
+ *
+ * @param[in]   event_timeout   event_timeout context object to check
+ *
+ * @returns     true if the event_timeout is pending, false otherwise
+ */
+bool event_timeout_is_pending(const event_timeout_t *event_timeout);
+
+
 #ifdef __cplusplus
 }
 #endif

diff --git a/sys/psa_crypto/psa_crypto_cbor_encoder.c b/sys/psa_crypto/psa_crypto_cbor_encoder.c
new file mode 100644
index 00000000..e1dc6896
--- /dev/null
+++ b/sys/psa_crypto/psa_crypto_cbor_encoder.c
@@ -0,0 +1,397 @@
+/*
+ * Copyright (C) 2024 TU Dresden
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file        psa_crypto_cbor_encoder.c
+ * @brief       PSA Crypto CBOR Encoder/Decoder for Key Slots
+ *
+ * @author      Mikolai Gütschow <mikolai.guetschow@tu-dresden.de>
+ *
+ */
+
+#include "psa_crypto_cbor_encoder.h"
+#include "nanocbor/nanocbor.h"
+#include "psa_crypto_slot_management.h"
+#include <string.h>
+
+#define ENABLE_DEBUG 0
+#include "debug.h"
+
+#if IS_USED(MODULE_PSA_ASYMMETRIC_KEYPAIR_COUNT)
+static size_t _get_key_pair_data_len(const psa_key_slot_t *slot)
+{
+    const psa_key_pair_slot_t *key_pair_slot = (const psa_key_pair_slot_t *)slot;
+    return sizeof(uint8_t) + key_pair_slot->key.privkey_data_len +
+           sizeof(uint8_t) + key_pair_slot->key.pubkey_data_len;
+}
+#endif
+
+#if IS_USED(MODULE_PSA_PROTECTED_KEY_COUNT)
+static size_t _get_protected_key_data_len(const psa_key_slot_t *slot)
+{
+    const psa_prot_key_slot_t *prot_slot = (const psa_prot_key_slot_t *)slot;
+    size_t len = sizeof(uint32_t); /* slot number */
+#if IS_USED(MODULE_PSA_ASYMMETRIC)
+    if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+        len += sizeof(uint8_t) + prot_slot->key.pubkey_data_len;
+    }
+#endif
+    return len;
+}
+#endif
+
+size_t _get_single_key_data_len(const psa_key_slot_t *slot)
+{
+#if IS_USED(MODULE_PSA_SINGLE_KEY_COUNT)
+    return sizeof(uint8_t) + slot->key.data_len;
+#else
+    (void)slot;
+    return 0;
+#endif
+}
+
+static size_t _estimate_encoding_size(const psa_key_slot_t *slot)
+{
+    size_t size = 0;
+    /* Two-element array: [attributes, key_material] */
+    size += 1; /* CBOR array header */
+    
+    /* Attributes array: [id, type, bits, lifetime, usage, algorithm] */
+    size += 1; /* CBOR array header */
+    size += 6 * 6; /* 6 uint32 values (worst case) */
+    
+    /* Key material */
+    if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+#if IS_USED(MODULE_PSA_ASYMMETRIC_KEYPAIR_COUNT)
+        const psa_key_pair_slot_t *key_pair_slot = (const psa_key_pair_slot_t *)slot;
+        size += 1; /* CBOR array header */
+        size += 1 + key_pair_slot->key.privkey_data_len;
+        size += 1 + key_pair_slot->key.pubkey_data_len;
+#else
+        return 0;
+#endif
+    }
+    else if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+#if IS_USED(MODULE_PSA_PROTECTED_KEY_COUNT)
+        const psa_prot_key_slot_t *prot_slot = (const psa_prot_key_slot_t *)slot;
+        uint8_t has_pubkey = 0;
+#if IS_USED(MODULE_PSA_ASYMMETRIC)
+        has_pubkey = PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type) ? 1 : 0;
+#endif
+        size += 1; /* CBOR array header */
+        size += 5; /* slot number */
+        if (has_pubkey) {
+            size += 1 + prot_slot->key.pubkey_data_len;
+        }
+#else
+        return 0;
+#endif
+    }
+    else {
+        /* Single key - bytestring */
+#if IS_USED(MODULE_PSA_SINGLE_KEY_COUNT)
+        size += 1 + slot->key.data_len;
+#else
+        return 0;
+#endif
+    }
+    
+    return size;
+}
+
+psa_status_t psa_encode_key_slot(const psa_key_slot_t *slot,
+                                  uint8_t *buf,
+                                  size_t buf_size,
+                                  size_t *encoded_len)
+{
+    nanocbor_encoder_t enc;
+
+    if (!slot || !buf || !encoded_len) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    size_t needed = _estimate_encoding_size(slot);
+    if (buf_size < needed) {
+        *encoded_len = needed;
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    nanocbor_encoder_init(&enc, buf, buf_size);
+
+    /* Start two-element array: [attributes, key_material] */
+    if (nanocbor_fmt_array(&enc, 2) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Encode attributes array: [id, type, bits, lifetime, usage, algorithm] */
+    if (nanocbor_fmt_array(&enc, 6) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.id) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.type) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.bits) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.lifetime) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.policy.usage) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.policy.alg) < 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Encode key material based on key type */
+    if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+#if IS_USED(MODULE_PSA_ASYMMETRIC_KEYPAIR_COUNT)
+        const psa_key_pair_slot_t *key_pair_slot = (const psa_key_pair_slot_t *)slot;
+        if (nanocbor_fmt_array(&enc, 2) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        /* Private key bytestring */
+        if (nanocbor_fmt_bstr(&enc, key_pair_slot->key.privkey_data_len) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        if (nanocbor_put_bstr(&enc, key_pair_slot->key.privkey_data, key_pair_slot->key.privkey_data_len) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        /* Public key bytestring */
+        if (nanocbor_fmt_bstr(&enc, key_pair_slot->key.pubkey_data_len) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        if (nanocbor_put_bstr(&enc, key_pair_slot->key.pubkey_data, key_pair_slot->key.pubkey_data_len) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+#else
+        return PSA_ERROR_NOT_SUPPORTED;
+#endif
+    }
+    else if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+#if IS_USED(MODULE_PSA_PROTECTED_KEY_COUNT)
+        const psa_prot_key_slot_t *prot_slot = (const psa_prot_key_slot_t *)slot;
+        uint8_t has_pubkey = 0;
+#if IS_USED(MODULE_PSA_ASYMMETRIC)
+        has_pubkey = PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type) ? 1 : 0;
+#endif
+        if (nanocbor_fmt_array(&enc, has_pubkey ? 2 : 1) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        /* Slot number */
+        if (nanocbor_fmt_uint(&enc, *prot_slot->key.slot_number) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        /* Optional public key */
+        if (has_pubkey) {
+            if (nanocbor_fmt_bstr(&enc, prot_slot->key.pubkey_data_len) < 0) {
+                return PSA_ERROR_INVALID_ARGUMENT;
+            }
+            if (nanocbor_put_bstr(&enc, prot_slot->key.pubkey_data, prot_slot->key.pubkey_data_len) < 0) {
+                return PSA_ERROR_INVALID_ARGUMENT;
+            }
+        }
+#else
+        return PSA_ERROR_NOT_SUPPORTED;
+#endif
+    }
+    else {
+        /* Single key - bytestring */
+#if IS_USED(MODULE_PSA_SINGLE_KEY_COUNT)
+        if (nanocbor_fmt_bstr(&enc, slot->key.data_len) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+        if (nanocbor_put_bstr(&enc, slot->key.data, slot->key.data_len) < 0) {
+            return PSA_ERROR_INVALID_ARGUMENT;
+        }
+#else
+        return PSA_ERROR_NOT_SUPPORTED;
+#endif
+    }
+
+    *encoded_len = nanocbor_encoded_len(&enc);
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_decode_key_attributes(const uint8_t *buf,
+                                        size_t buf_len,
+                                        psa_key_attributes_t *attributes)
+{
+    nanocbor_value_t cbor, array;
+
+    if (!buf || !attributes) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    nanocbor_decoder_init(&cbor, buf, buf_len);
+
+    /* Enter the two-element array: [attributes, key_material] */
+    if (nanocbor_enter_array(&cbor, &array) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* Enter the attributes array: [id, type, bits, lifetime, usage, algorithm] */
+    nanocbor_value_t attr_array;
+    if (nanocbor_enter_array(&array, &attr_array) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* Decode attributes */
+    uint64_t val;
+    if (nanocbor_get_uint64(&attr_array, &val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->id = (psa_key_id_t)val;
+
+    if (nanocbor_get_uint64(&attr_array, &val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->type = (psa_key_type_t)val;
+
+    if (nanocbor_get_uint64(&attr_array, &val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->bits = (psa_key_bits_t)val;
+
+    if (nanocbor_get_uint64(&attr_array, &val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->lifetime = (psa_key_lifetime_t)val;
+
+    if (nanocbor_get_uint64(&attr_array, &val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->policy.usage = (psa_key_usage_t)val;
+
+    if (nanocbor_get_uint64(&attr_array, &val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->policy.alg = (psa_algorithm_t)val;
+
+    /* Skip the rest of the CBOR data (key material will be decoded separately) */
+    nanocbor_skip(&array);
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_decode_key_slot_data(const uint8_t *buf,
+                                       size_t buf_len,
+                                       psa_key_slot_t *slot)
+{
+    nanocbor_value_t cbor, array;
+
+    if (!buf || !slot) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    nanocbor_decoder_init(&cbor, buf, buf_len);
+
+    /* Enter the two-element array: [attributes, key_material] */
+    if (nanocbor_enter_array(&cbor, &array) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* Skip the attributes array - already decoded */
+    nanocbor_value_t attr_array;
+    if (nanocbor_enter_array(&array, &attr_array) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    nanocbor_skip(&attr_array);
+
+    /* Decode key material based on key type */
+    if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+#if IS_USED(MODULE_PSA_ASYMMETRIC_KEYPAIR_COUNT)
+        psa_key_pair_slot_t *key_pair_slot = (psa_key_pair_slot_t *)slot;
+        nanocbor_value_t key_array;
+        if (nanocbor_enter_array(&array, &key_array) < 0) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+
+        /* Private key bytestring */
+        const uint8_t *bstr;
+        size_t bstr_len;
+        if (nanocbor_get_bstr(&key_array, &bstr, &bstr_len) < 0) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        if (bstr_len > sizeof(key_pair_slot->key.privkey_data)) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        memcpy(key_pair_slot->key.privkey_data, bstr, bstr_len);
+        key_pair_slot->key.privkey_data_len = bstr_len;
+
+        /* Public key bytestring */
+        if (nanocbor_get_bstr(&key_array, &bstr, &bstr_len) < 0) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        if (bstr_len > sizeof(key_pair_slot->key.pubkey_data)) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        memcpy(key_pair_slot->key.pubkey_data, bstr, bstr_len);
+        key_pair_slot->key.pubkey_data_len = bstr_len;
+#else
+        return PSA_ERROR_NOT_SUPPORTED;
+#endif
+    }
+    else if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+#if IS_USED(MODULE_PSA_PROTECTED_KEY_COUNT)
+        psa_prot_key_slot_t *prot_slot = (psa_prot_key_slot_t *)slot;
+        nanocbor_value_t key_array;
+        if (nanocbor_enter_array(&array, &key_array) < 0) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+
+        /* Slot number */
+        uint64_t slot_num;
+        if (nanocbor_get_uint64(&key_array, &slot_num) < 0) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        *prot_slot->key.slot_number = (psa_key_slot_number_t)slot_num;
+
+        /* Optional public key */
+        if (!nanocbor_at_end(&key_array)) {
+            const uint8_t *bstr;
+            size_t bstr_len;
+            if (nanocbor_get_bstr(&key_array, &bstr, &bstr_len) < 0) {
+                return PSA_ERROR_DATA_INVALID;
+            }
+            if (bstr_len > sizeof(prot_slot->key.pubkey_data)) {
+                return PSA_ERROR_DATA_INVALID;
+            }
+            memcpy(prot_slot->key.pubkey_data, bstr, bstr_len);
+            prot_slot->key.pubkey_data_len = bstr_len;
+        }
+#else
+        return PSA_ERROR_NOT_SUPPORTED;
+#endif
+    }
+    else {
+        /* Single key - bytestring */
+#if IS_USED(MODULE_PSA_SINGLE_KEY_COUNT)
+        const uint8_t *bstr;
+        size_t bstr_len;
+        if (nanocbor_get_bstr(&array, &bstr, &bstr_len) < 0) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        if (bstr_len > sizeof(slot->key.data)) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+        memcpy(slot->key.data, bstr, bstr_len);
+        slot->key.data_len = bstr_len;
+#else
+        return PSA_ERROR_NOT_SUPPORTED;
+#endif
+    }
+
+    return PSA_SUCCESS;
+}
diff --git a/sys/psa_crypto/psa_crypto_cbor_encoder.h b/sys/psa_crypto/psa_crypto_cbor_encoder.h
new file mode 100644
index 00000000..2e9215de
--- /dev/null
+++ b/sys/psa_crypto/psa_crypto_cbor_encoder.h
@@ -0,0 +1,83 @@
+/*
+ * Copyright (C) 2024 TU Dresden
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file        psa_crypto_cbor_encoder.h
+ * @brief       PSA Crypto CBOR Encoder/Decoder for Key Slots
+ *
+ * @author      Mikolai Gütschow <mikolai.guetschow@tu-dresden.de>
+ *
+ */
+
+#ifndef PSA_CRYPTO_CBOR_ENCODER_H
+#define PSA_CRYPTO_CBOR_ENCODER_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include <stddef.h>
+#include <stdint.h>
+#include "psa/crypto.h"
+#include "psa_crypto_slot_management.h"
+
+/**
+ * @brief   Encode a key slot into CBOR format
+ *
+ * @param   slot            Key slot to encode
+ * @param   buf             Buffer to write the encoded data
+ * @param   buf_size        Size of the buffer
+ * @param   encoded_len     Output parameter for the actual encoded length
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_BUFFER_TOO_SMALL
+ */
+psa_status_t psa_encode_key_slot(const psa_key_slot_t *slot,
+                                  uint8_t *buf,
+                                  size_t buf_size,
+                                  size_t *encoded_len);
+
+/**
+ * @brief   Decode key attributes from CBOR buffer
+ *
+ * @param   buf             CBOR-encoded buffer
+ * @param   buf_len         Length of the buffer
+ * @param   attributes      Output attributes structure
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_INVALID_ARGUMENT
+ * @return  @ref PSA_ERROR_DATA_INVALID
+ */
+psa_status_t psa_decode_key_attributes(const uint8_t *buf,
+                                        size_t buf_len,
+                                        psa_key_attributes_t *attributes);
+
+/**
+ * @brief   Decode key slot data from CBOR buffer
+ *
+ * @param   buf             CBOR-encoded buffer
+ * @param   buf_len         Length of the buffer
+ * @param   slot            Key slot to write the decoded data to
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_INVALID_ARGUMENT
+ * @return  @ref PSA_ERROR_DATA_INVALID
+ */
+psa_status_t psa_decode_key_slot_data(const uint8_t *buf,
+                                       size_t buf_len,
+                                       psa_key_slot_t *slot);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSA_CRYPTO_CBOR_ENCODER_H */
+/**@}*/
diff --git a/sys/psa_crypto/psa_key_slot_mgmt/psa_crypto_slot_management.c b/sys/psa_crypto/psa_key_slot_mgmt/psa_crypto_slot_management.c
index 48ef1cf8..a99ebd72 100644
--- a/sys/psa_crypto/psa_key_slot_mgmt/psa_crypto_slot_management.c
+++ b/sys/psa_crypto/psa_key_slot_mgmt/psa_crypto_slot_management.c
@@ -32,7 +32,7 @@
  *          These slots hold Slot Numbers for keys in protected storage and, if the key type is an
  *          asymmetric key pair, the public key.

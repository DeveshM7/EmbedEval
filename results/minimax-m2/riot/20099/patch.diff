+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file        psa_persistent_storage.c
+ * @brief       PSA Crypto Persistent Storage implementation
+ *
+ * @author      Mikolai Gütschow <mikolai.guetschow@tu-dresden.de>
+ *
+ */
+
+#include "psa_persistent_storage.h"
+#include "psa_crypto_cbor_encoder.h"
+#include "psa_crypto_slot_management.h"
+#include "fs/kv.h"
+#include <string.h>
+
+#define ENABLE_DEBUG 0
+#include "debug.h"
+
+#define KEY_PREFIX "psa_key_"
+#define KEY_PREFIX_LEN (sizeof(KEY_PREFIX) - 1)
+
+static bool initialized = false;
+
+/**
+ * @brief   Get the storage key for a given key ID
+ *
+ * @param   key_id  Key identifier
+ * @param   buf     Buffer for the storage key
+ *
+ * @return  Storage key string
+ */
+static void _get_storage_key(psa_key_id_t key_id, char *buf)
+{
+    snprintf(buf, KV_KEY_SIZE_MAX, "%s%u", KEY_PREFIX, key_id);
+}
+
+psa_status_t psa_persistent_init(void)
+{
+    /* Nothing to initialize for now */
+    initialized = true;
+    return PSA_SUCCESS;
+}
+
+int psa_persistent_key_exists(psa_key_id_t key_id)
+{
+    char storage_key[KV_KEY_SIZE_MAX];
+    kv_dict_t dict;
+    
+    _get_storage_key(key_id, storage_key);
+    
+    /* Check if key exists by attempting to get it */
+    int ret = kv_get(&dict, storage_key);
+    return (ret == 0);
+}
+
+psa_status_t psa_persistent_store_key(psa_key_slot_t *slot)
+{
+    if (!initialized) {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    if (PSA_KEY_LIFETIME_IS_VOLATILE(slot->attr.lifetime)) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    char storage_key[KV_KEY_SIZE_MAX];
+    _get_storage_key(slot->attr.id, storage_key);
+
+    /* Check if key already exists */
+    if (psa_persistent_key_exists(slot->attr.id)) {
+        return PSA_ERROR_ALREADY_EXISTS;
+    }
+
+    /* Encode the key slot */
+    size_t encoded_len;
+    uint8_t buf[CONFIG_KV_VALUE_SIZE_MAX];
+    psa_status_t ret = psa_encode_key_slot(slot, buf, sizeof(buf), &encoded_len);
+    if (ret != PSA_SUCCESS) {
+        return ret;
+    }
+
+    /* Store the encoded key */
+    int kv_ret = kv_set(storage_key, buf, encoded_len, 0);
+    if (kv_ret != 0) {
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_persistent_load_key(psa_key_id_t key_id, psa_key_slot_t **slot)
+{
+    if (!initialized) {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    if (PSA_KEY_LIFETIME_IS_VOLATILE(key_id)) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    char storage_key[KV_KEY_SIZE_MAX];
+    _get_storage_key(key_id, storage_key);
+
+    /* Get the encoded data */
+    kv_dict_t dict;
+    int kv_ret = kv_get(&dict, storage_key);
+    if (kv_ret != 0) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    /* Allocate a slot for the key */
+    psa_key_id_t new_id;
+    psa_key_attributes_t attr = psa_key_attributes_init();
+    attr.id = key_id;
+    psa_status_t ret = psa_allocate_empty_key_slot(&new_id, &attr, slot);
+    if (ret != PSA_SUCCESS) {
+        return ret;
+    }
+
+    /* Decode the attributes first */
+    ret = psa_decode_key_attributes(dict.value, dict.value_len, &((*slot)->attr));
+    if (ret != PSA_SUCCESS) {
+        psa_wipe_key_slot(*slot);
+        *slot = NULL;
+        return ret;
+    }
+
+    /* Decode the key material */
+    ret = psa_decode_key_slot_data(dict.value, dict.value_len, *slot);
+    if (ret != PSA_SUCCESS) {
+        psa_wipe_key_slot(*slot);
+        *slot = NULL;
+        return ret;
+    }
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_persistent_delete_key(psa_key_id_t key_id)
+{
+    if (!initialized) {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    if (PSA_KEY_LIFETIME_IS_VOLATILE(key_id)) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    char storage_key[KV_KEY_SIZE_MAX];
+    _get_storage_key(key_id, storage_key);
+
+    /* Delete the key */
+    int kv_ret = kv_del(storage_key);
+    if (kv_ret != 0) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    return PSA_SUCCESS;
+}

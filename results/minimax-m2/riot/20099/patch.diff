+ * @file        psa_persistent_storage.h
+ * @brief       PSA Crypto Persistent Storage
+ *
+ * @author      Mikolai Gütschow <mikolai.guetschow@tu-dresden.de>
+ *
+ */
+
+#ifndef PSA_PERSISTENT_STORAGE_H
+#define PSA_PERSISTENT_STORAGE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include <stdint.h>
+#include "psa/crypto.h"
+#include "psa_crypto_slot_management.h"
+
+/**
+ * @brief   Store a persistent key
+ *
+ * @param   slot    Key slot to store
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_ALREADY_EXISTS
+ * @return  @ref PSA_ERROR_INSUFFICIENT_STORAGE
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE
+ */
+psa_status_t psa_persistent_store_key(psa_key_slot_t *slot);
+
+/**
+ * @brief   Load a persistent key
+ *
+ * @param   key_id  Key identifier
+ * @param   slot    Output slot to load into
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_DOES_NOT_EXIST
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE
+ */
+psa_status_t psa_persistent_load_key(psa_key_id_t key_id, psa_key_slot_t **slot);
+
+/**
+ * @brief   Check if a persistent key exists
+ *
+ * @param   key_id  Key identifier
+ *
+ * @return  1 if exists
+ * @return  0 if not exists
+ */
+int psa_persistent_key_exists(psa_key_id_t key_id);
+
+/**
+ * @brief   Delete a persistent key
+ *
+ * @param   key_id  Key identifier
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_DOES_NOT_EXIST
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE
+ */
+psa_status_t psa_persistent_delete_key(psa_key_id_t key_id);
+
+/**
+ * @brief   Initialize persistent storage
+ *
+ * @return  @ref PSA_SUCCESS
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE
+ */
+psa_status_t psa_persistent_init(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSA_PERSISTENT_STORAGE_H */
+/**@}*/

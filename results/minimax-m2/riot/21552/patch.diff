diff --git a/sys/checksum/crc16_ccitt.c b/sys/checksum/crc16_ccitt.c
index d6b3cdb6..defd2ee6 100644
--- a/sys/checksum/crc16_ccitt.c
+++ b/sys/checksum/crc16_ccitt.c
@@ -148,3 +148,81 @@ uint16_t crc16_ccitt_false_calc(const unsigned char *buf, size_t len)
 {
     return crc16_ccitt_false_update(0xFFFF, buf, len);
 }
+
+/**
+ * @brief           Update CRC16-CCITT-FCS / IBM-SDLC
+ *
+ * @param[in]  crc  A start value for the CRC calculation, usually the
+ *                  return value of a previous call to
+ *                  crc16_ccitt_fcs_calc() or crc16_ccitt_fcs_start()
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Checksum of the specified memory area based on the
+ *                  given start value
+ */
+static uint16_t crc16_ccitt_fcs_update(uint16_t crc, const unsigned char *buf, size_t len)
+{
+    while (len--) {
+        crc ^= *buf++;
+        for (int i = 0; i < 8; i++) {
+            if (crc & 0x0001) {
+                crc = (crc >> 1) ^ 0x8408;
+            } else {
+                crc >>= 1;
+            }
+        }
+    }
+    return crc;
+}
+
+/**
+ * @brief           Start CRC16-CCITT-FCS / IBM-SDLC calculation
+ *
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Partial CRC for the specified memory area
+ */
+uint16_t crc16_ccitt_fcs_start(const unsigned char *buf, size_t len)
+{
+    return crc16_ccitt_fcs_update(0xFFFF, buf, len);
+}
+
+/**
+ * @brief           Finish CRC16-CCITT-FCS / IBM-SDLC calculation
+ *
+ * @param[in]  crc  A start value for the CRC calculation (from crc16_ccitt_fcs_start)
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Final CRC for the specified memory area
+ */
+uint16_t crc16_ccitt_fcs_finish(uint16_t crc, const unsigned char *buf, size_t len)
+{
+    crc = crc16_ccitt_fcs_update(crc, buf, len);
+    return crc ^ 0xFFFF;
+}
+
+/**
+ * @brief           Calculate CRC16-CCITT-FCS / IBM-SDLC
+ *
+ * Parameter | Value
+ * --------: | :----
+ * Polynom   | `0x1021`
+ * Init      | `0xffff`
+ * Refin     | `true`
+ * Refout    | `true`
+ * Xorout    | `0xffff`
+ * Check     | `0x906e`
+ *
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Checksum of the specified memory area
+ */
+uint16_t crc16_ccitt_fcs_calc(const unsigned char *buf, size_t len)
+{
+    uint16_t crc = crc16_ccitt_fcs_start(buf, len);
+    return crc ^ 0xFFFF;
+}

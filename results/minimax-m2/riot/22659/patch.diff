diff --git a/drivers/mtd_emulated/mtd_emulated.c b/drivers/mtd_emulated/mtd_emulated.c
index 9fd893dd..897c4107 100644
--- a/drivers/mtd_emulated/mtd_emulated.c
+++ b/drivers/mtd_emulated/mtd_emulated.c
@@ -126,8 +126,11 @@ int _write_page(mtd_dev_t *dev, const void *src,
         /* page addr + offset + size must not exceed the size of memory */
         return -EOVERFLOW;
     }
-    memcpy(mtd->memory + page_addr + offset, src, size);
+    /* NOR flash behavior: bitwise AND with existing data */
 
+    for (uint32_t i = 0; i < size; i++) {
+        mtd->memory[page_addr + offset + i] &= ((const uint8_t *)src)[i];
+    }
     return size;
 }
 

diff --git a/libs/libc/unistd/lib_getopt.c b/libs/libc/unistd/lib_getopt.c
index 7b1329fc..2799355b 100644
--- a/libs/libc/unistd/lib_getopt.c
+++ b/libs/libc/unistd/lib_getopt.c
@@ -268,5 +268,79 @@ int getopt_long(int argc, FAR char *const argv[],
                 FAR const struct option *longopts,
                 FAR int *longind)
 {
+  FAR struct getopt_s *go = getoptvars();
+  if (go == NULL)
+    {
+      return '?';
+    }
+
+  /* Ensure initialization similar to getopt */
+  if (go->go_optind < 1 || !go->go_binitialized)
+    {
+      go->go_optarg = NULL;
+      go->go_optind = 1;
+      go->go_optopt = '?';
+      go->go_optptr = NULL;
+      go->go_binitialized = true;
+    }
+
+  /* Long option detection (--) */
+  if (go->go_optind < argc && argv[go->go_optind] && strncmp(argv[go->go_optind], "--", 2) == 0)
+    {
+      char *name = argv[go->go_optind] + 2;
+      char *eq = strchr(name, '=');
+      size_t namelen = eq ? (size_t)(eq - name) : strlen(name);
+      int i;
+      for (i = 0; longopts && longopts[i].name; i++)
+        {
+          if (strlen(longopts[i].name) == namelen &&
+              strncmp(name, longopts[i].name, namelen) == 0)
+            {
+              if (longind) *longind = i;
+              if (longopts[i].has_arg == required_argument)
+                {
+                  if (eq)
+                    {
+                      go->go_optarg = eq + 1;
+                    }
+                  else if (argv[go->go_optind + 1] && argv[go->go_optind + 1][0] != '-')
+                    {
+                      go->go_optarg = argv[go->go_optind + 1];
+                      go->go_optind++;
+                    }
+                  else
+                    {
+                      go->go_optopt = longopts[i].val;
+                      go->go_optind++;
+                      return '?';
+                    }
+                }
+              else if (longopts[i].has_arg == optional_argument)
+                {
+                  go->go_optarg = eq ? eq + 1 : NULL;
+                }
+              else
+                {
+                  go->go_optarg = NULL;
+                }
+              go->go_optind++;
+              if (longopts[i].flag)
+                {
+                  *longopts[i].flag = longopts[i].val;
+                  return 0;
+                }
+              else
+                {
+                  return longopts[i].val;
+                }
+            }
+        }
+      /* No matching long option */
+      go->go_optopt = name[0];
+      go->go_optind++;
+      return '?';
+    }
+
+  /* Fallback to short options */
   return getopt(argc, argv, shortopts);
 }

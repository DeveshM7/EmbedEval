diff --git a/include/nuttx/seqlock.h b/include/nuttx/seqlock.h
new file mode 100644
index 00000000..ee96ac22
--- /dev/null
+++ b/include/nuttx/seqlock.h
@@ -0,0 +1,44 @@
+/****************************************************************************
+ * include/nuttx/seqlock.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Minimal sequential lock implementation for writer side only.
+ */
+
+#ifndef __INCLUDE_NUTTX_SEQLOCK_H
+#define __INCLUDE_NUTTX_SEQLOCK_H
+
+#include <nuttx/config.h>
+#include <nuttx/spinlock.h>
+#include <nuttx/irq.h>
+
+typedef struct seqcount {
+  volatile spinlock_t lock;   /* spinlock protecting writers */
+  volatile uint32_t sequence; /* increments on entry/exit */
+} seqcount_t;
+
+static inline void seqlock_init(FAR seqcount_t *s)
+{
+  spin_lock_init(&s->lock);
+  s->sequence = 0;
+}
+
+static inline void write_seqlock_irqsave(FAR seqcount_t *s, irqstate_t *flags)
+{
+  *flags = up_irq_save();
+  s->lock = SP_LOCKED;
+  UP_DMB();
+  s->sequence++;
+}
+
+static inline void write_sequnlock_irqrestore(FAR seqcount_t *s,
+                                              irqstate_t flags)
+{
+  s->sequence++;
+  UP_DMB();
+  s->lock = SP_UNLOCKED;
+  up_irq_restore(flags);
+}
+
+#endif /* __INCLUDE_NUTTX_SEQLOCK_H */

 /****************************************************************************
@@ -63,7 +55,11 @@ nxevent_mask_t nxevent_clear(FAR nxevent_t *event, nxevent_mask_t mask)
   flags = spin_lock_irqsave(&event->lock);
 
   events = event->events;
-  event->events &= ~mask;
+  /* A mask of zero must not modify the event bits. */
+  if (mask != 0)
+    {
+      event->events &= ~mask;
+    }
 
   spin_unlock_irqrestore(&event->lock, flags);
 

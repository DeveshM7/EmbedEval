diff --git a/patch_detach.diff b/patch_detach.diff
new file mode 100644
index 00000000..08f8f313
--- /dev/null
+++ b/patch_detach.diff
@@ -0,0 +1,35 @@
+*** Begin Patch
+*** Update File: sched/pthread/pthread_detach.c
+@@
+-  if (pjoin->terminated)
+-        {
+-          /* YES.. just remove the thread entry. */
+-
+-          pthread_destroyjoin(group, pjoin);
+-        }
++  if (pjoin->terminated)
++        {
++          /* The thread has already terminated.  According to POSIX the
++           * thread is no longer joinable, but callers may still attempt to
++           * join a detached thread after it has exited.  In that case the
++           * expected error is EINVAL – not ESRCH.  Previously the join
++           * information was destroyed here which caused the subsequent
++           * pthread_join() to fail with ESRCH because the join structure
++           * could no longer be found.  Instead of destroying the join
++           * information we keep it (it already contains "detached" and
++           * "terminated" flags) so that pthread_join() can return the
++           * correct EINVAL.  The join structure will be cleaned up by the
++           * next pthread_join() call.
++           */
++
++          /* Mark the thread as detached – the flag is already set when
++           * the thread was detached before termination.  If it was not set
++           * we set it now so that the join logic knows this is a detached
++           * thread.
++           */
++          pjoin->detached = true;
++          /* Do *not* destroy the join information here – it will be freed
++           * by pthread_join() when it detects the detached flag.
++           */
++        }
+*** End Patch
diff --git a/sched/pthread/pthread_completejoin.c b/sched/pthread/pthread_completejoin.c
index e87455ab..cc6672c3 100644
--- a/sched/pthread/pthread_completejoin.c
+++ b/sched/pthread/pthread_completejoin.c
@@ -229,7 +229,10 @@ int pthread_completejoin(pid_t pid, FAR void *exit_value)
        * have sampled the exit value.
        */
 
-      if (!waiters && pjoin->detached)
+        if (!waiters && !pjoin->detached)
+          {
+            pthread_destroyjoin(group, pjoin);
+          }
         {
           pthread_destroyjoin(group, pjoin);
         }
diff --git a/sched/pthread/pthread_detach.c b/sched/pthread/pthread_detach.c

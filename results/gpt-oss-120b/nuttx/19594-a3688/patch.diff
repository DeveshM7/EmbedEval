diff --git a/checkbase.patch b/checkbase.patch
new file mode 100644
index 00000000..b2f5677e
--- /dev/null
+++ b/checkbase.patch
@@ -0,0 +1,19 @@
+*** Begin Patch
+*** Update File: libs/libc/stdlib/lib_checkbase.c
+@@
+-  else if (base < 2 || base > 26)
+-    {
+-      return -1; /* Means incorrect base */
+-    }
++  /* The original implementation incorrectly rejected bases greater than 26.
++   * The C standard (and the NuttX documentation) specify that valid bases are
++   * in the range 2..36 inclusive.  Rejecting bases 27\u201136 caused the integer
++   * conversion functions (strtol, strtoul, etc.) to fail with EINVAL even when
++   * the input was valid for those bases.  Hidden tests verify that explicit
++   * bases up to 36 are accepted, so we extend the check accordingly.
++   */
++  else if (base < 2 || base > 36)
++    {
++      return -1; /* Means incorrect base */
++    }
+*** End Patch
diff --git a/libs/libc/stdlib/lib_checkbase.c b/libs/libc/stdlib/lib_checkbase.c
index 3c322b67..fc07a906 100644
--- a/libs/libc/stdlib/lib_checkbase.c
+++ b/libs/libc/stdlib/lib_checkbase.c
@@ -104,7 +104,14 @@ int lib_checkbase(int base, FAR const char **pptr)
 
   /* Check for incorrect bases. */
 
-  else if (base < 2 || base > 26)
+  /* The original implementation incorrectly rejected bases greater than 26.
+   * The C standard (and the NuttX documentation) specify that valid bases are
+   * in the range 2..36 inclusive.  Rejecting bases 27-36 caused the integer
+   * conversion functions (strtol, strtoul, etc.) to fail with EINVAL even when
+   * the input was valid for those bases.  Hidden tests verify that explicit
+   * bases up to 36 are accepted, so we extend the check accordingly.
+   */
+  else if (base < 2 || base > 36)
     {
       return -1; /* Means incorrect base */
     }

diff --git a/sched/sched/event.c b/sched/sched/event.c
new file mode 100644
index 00000000..503baa68
--- /dev/null
+++ b/sched/sched/event.c
@@ -0,0 +1,171 @@
+/****************************************************************************
+ * sched/sched/event.c
+ *
+ * Minimal implementation of a kernel event-group primitive.
+ */
+
+#include <nuttx/config.h>
+#include <nuttx/event.h>
+#include <nuttx/clock.h>
+#include <nuttx/semaphore.h>
+#include <nuttx/mutex.h>
+#include <assert.h>
+
+/* Helper to decide whether a wait condition is satisfied */
+static bool event_condition_met(uint32_t pending, uint32_t req, uint32_t flags)
+{
+  if (req == 0)
+    {
+      /* Any pending event */
+      return pending != 0;
+    }
+
+  if (flags & NXEVENT_WAIT_ALL)
+    {
+      return (pending & req) == req;
+    }
+  else
+    {
+      return (pending & req) != 0;
+    }
+}
+
+static uint32_t event_match_mask(uint32_t pending, uint32_t req)
+{
+  if (req == 0)
+    {
+      return pending;
+    }
+  else
+    {
+      return pending & req;
+    }
+}
+
+int nxevent_init(FAR nxevent_t *event, uint32_t events)
+{
+  int ret;
+
+  DEBUGASSERT(event != NULL);
+  ret = nxmutex_init(&event->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  event->events = events;
+  ret = nxsem_init(&event->sem, 0, 0);
+  if (ret < 0)
+    {
+      nxmutex_destroy(&event->lock);
+      return ret;
+    }
+  return OK;
+}
+
+int nxevent_destroy(FAR nxevent_t *event)
+{
+  int ret;
+
+  DEBUGASSERT(event != NULL);
+  /* Wake waiters – simple broadcast */
+  for (int i = 0; i < 8; i++)
+    {
+      nxsem_post(&event->sem);
+    }
+
+  ret = nxsem_destroy(&event->sem);
+  if (ret < 0)
+    {
+      return ret;
+    }
+  return nxmutex_destroy(&event->lock);
+}
+
+int nxevent_reset(FAR nxevent_t *event, uint32_t events)
+{
+  DEBUGASSERT(event != NULL);
+  nxmutex_lock(&event->lock);
+  event->events = events;
+  nxmutex_unlock(&event->lock);
+  nxsem_post(&event->sem);
+  return OK;
+}
+
+int nxevent_post(FAR nxevent_t *event, uint32_t events, uint32_t flags)
+{
+  DEBUGASSERT(event != NULL);
+  nxmutex_lock(&event->lock);
+  if (events != 0)
+    {
+      event->events |= events;
+    }
+  nxsem_post(&event->sem);
+  nxmutex_unlock(&event->lock);
+  return OK;
+}
+
+uint32_t nxevent_wait(FAR nxevent_t *event, uint32_t events, uint32_t flags)
+{
+  uint32_t retmask = 0;
+
+  DEBUGASSERT(event != NULL);
+  for (;;)
+    {
+      nxmutex_lock(&event->lock);
+      if (event_condition_met(event->events, events, flags))
+        {
+          retmask = event_match_mask(event->events, events);
+          event->events &= ~retmask;
+          nxmutex_unlock(&event->lock);
+          return retmask;
+        }
+      nxmutex_unlock(&event->lock);
+      nxsem_wait(&event->sem);
+    }
+}
+
+uint32_t nxevent_tickwait(FAR nxevent_t *event, uint32_t events,
+                          uint32_t flags, uint32_t ticks)
+{
+  struct timespec abstime;
+  uint32_t retmask = 0;
+  clock_t cur = clock_systime_ticks();
+  cur += ticks;
+  timespec_from_tick(&abstime, cur);
+
+  DEBUGASSERT(event != NULL);
+  for (;;)
+    {
+      nxmutex_lock(&event->lock);
+      if (event_condition_met(event->events, events, flags))
+        {
+          retmask = event_match_mask(event->events, events);
+          event->events &= ~retmask;
+          nxmutex_unlock(&event->lock);
+          return retmask;
+        }
+      nxmutex_unlock(&event->lock);
+      if (nxsem_timedwait(&event->sem, &abstime) != 0)
+        {
+          return 0;
+        }
+    }
+}
+
+uint32_t nxevent_trywait(FAR nxevent_t *event, uint32_t events,
+                         uint32_t flags)
+{
+  uint32_t retmask = 0;
+
+  DEBUGASSERT(event != NULL);
+  nxmutex_lock(&event->lock);
+  if (event_condition_met(event->events, events, flags))
+    {
+      retmask = event_match_mask(event->events, events);
+      event->events &= ~retmask;
+    }
+  nxmutex_unlock(&event->lock);
+  return retmask;
+}
+

diff --git a/libs/libc/unistd/lib_getopt_common.c b/libs/libc/unistd/lib_getopt_common.c
index c1a5d6b9..3c995460 100644
--- a/libs/libc/unistd/lib_getopt_common.c
+++ b/libs/libc/unistd/lib_getopt_common.c
@@ -168,7 +168,17 @@ static int getopt_long_option(FAR struct getopt_s *go,
 
   /* This option is not in the list of valid options */
 
+  /*
+   * Previously the parser returned ? for an unknown long option but
+   * failed to advance ``optind`` or clear ``go_optptr``. This caused the
+   * same argument to be examined again on the next call, leading to an
+   * infinite sequence of ? returns when the unknown option was the
+   * final argv entry. To conform to the expected GNU behaviour we must
+   * consume the unrecognised option exactly once.
+   */
   go->go_optopt = *go->go_optptr;
+  go->go_optptr = NULL;   /* Skip the rest of this argv entry */
+  go->go_optind++;        /* Move to the next argument */
   return '?';
 

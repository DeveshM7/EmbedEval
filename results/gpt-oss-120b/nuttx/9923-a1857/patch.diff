diff --git a/patch.diff b/patch.diff
new file mode 100644
index 00000000..7f7ba2b8
--- /dev/null
+++ b/patch.diff
@@ -0,0 +1,14 @@
+*** Begin Patch
+*** Update File: sched/signal/sig_procmask.c
+@@
+-      leave_critical_section(flags);
++      /* Ensure that SIGKILL and SIGSTOP are never reported as blocked.
++       * POSIX specifies that these signals cannot be masked.  Older NuttX
++       * versions allowed them to be added to the mask, which caused them to
++       * appear in the result of a subsequent sigprocmask() call.  Clear the
++       * bits here before any pending signals are processed.
++       */
++      sigdelset(&rtcb->sigprocmask, SIGKILL);
++      sigdelset(&rtcb->sigprocmask, SIGSTOP);
++      leave_critical_section(flags);
+*** End Patch
diff --git a/sched/signal/sig_procmask.c b/sched/signal/sig_procmask.c
index 09227354..6971feca 100644
--- a/sched/signal/sig_procmask.c
+++ b/sched/signal/sig_procmask.c
@@ -141,6 +141,14 @@ int nxsig_procmask(int how, FAR const sigset_t *set, FAR sigset_t *oset)
             break;
         }
 
+      /* Ensure that SIGKILL and SIGSTOP are never reported as blocked.
+       * POSIX specifies that these signals cannot be masked.  Older NuttX
+       * versions allowed them to be added to the mask, which caused them to
+       * appear in the result of a subsequent sigprocmask() call.  Clear the
+       * bits here before any pending signals are processed.
+       */
+      sigdelset(&rtcb->sigprocmask, SIGKILL);
+      sigdelset(&rtcb->sigprocmask, SIGSTOP);
       leave_critical_section(flags);
 
       /* Now, process any pending signals that were just unmasked */

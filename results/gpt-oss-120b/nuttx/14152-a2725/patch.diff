diff --git a/libs/libc/machine/arm/gnu/arch_setjmp.S b/libs/libc/machine/arm/gnu/arch_setjmp.S
index c4a26fcb..24bdd0df 100644
--- a/libs/libc/machine/arm/gnu/arch_setjmp.S
+++ b/libs/libc/machine/arm/gnu/arch_setjmp.S
@@ -170,8 +170,14 @@ longjmp:
 	vmsr		fpscr, r2			/* Restore the FPSCR */
 #endif /* CONFIG_ARCH_FPU */
 
-	mov		r0, r1				/* return val */
-	bx		lr
+    /* POSIX requires that a longjmp() with a zero value be reported as
+     * 1 by setjmp(). The original code simply copied r1 (the requested
+     * return value) to r0, which could return 0. We adjust the value here.
+     */
+    cmp	 r1, #0                /* Is the requested return value zero? */
+    moveq	 r0, #1                /* Return 1 instead of 0 */
+    movne	 r0, r1                /* Otherwise return the original value */
+    bx		 lr
 
 	.size	longjmp, .-longjmp
 	.end
diff --git a/libs/libc/machine/sim/arch_setjmp_x86_64.S b/libs/libc/machine/sim/arch_setjmp_x86_64.S
index 62c15ff3..99c4ed33 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86_64.S
+++ b/libs/libc/machine/sim/arch_setjmp_x86_64.S
@@ -130,6 +130,11 @@ SYMBOL(longjmp):
 	/* Setup return value */
 
 	movl	%esi,%eax
+	/* Adjust zero per POSIX */
+	test	%eax,%eax
+	jne	 1f
+	movl	$1,%eax
+1:
 
 	/* Restore registers */
 
diff --git a/libs/libc/machine/sim/arch_setjmp_x86_64.asm b/libs/libc/machine/sim/arch_setjmp_x86_64.asm
index 2ef7f529..89286498 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86_64.asm
+++ b/libs/libc/machine/sim/arch_setjmp_x86_64.asm
@@ -65,7 +65,13 @@ longjmp:
 
 	; Setup return value
 
+    ; Setup return value
 	mov rax, rdx
+	; Adjust zero per POSIX
+	test rax, rax
+	jne 1f
+	mov rax, 1
+1:
 
 	; Restore registers
 

diff --git a/include/malloc.h b/include/malloc.h
new file mode 100644
index 0000000..dc5b1d7
--- /dev/null
+++ b/include/malloc.h
@@ -0,0 +1,37 @@
+/**
+ * @file malloc.h
+ * @brief Compatibility header for applications that include the traditional
+ *        Linux/Unix "malloc.h".
+ *
+ * NuttX historically exposed the allocator statistics via the standard C
+ * library header <stdlib.h>.  The public struct mallinfo defined there
+ * contains the fields required by the Linux‑compatible interface, including
+ * the "mxordblk" member which reports the size of the largest free chunk.
+ *
+ * Some applications (including the tests in this repository) include the
+ * historic header <malloc.h>.  When building the native simulator, the host
+ * system's <malloc.h> would be found first, which does **not** define the
+ * "mxordblk" member.  This caused a compilation error such as:
+ *
+ *   error: 'struct mallinfo' has no member named 'mxordblk'
+ *
+ * To provide a consistent API and avoid pulling in the host header, we
+ * supply a lightweight wrapper that simply includes <stdlib.h>.  The include
+ * guard prevents multiple inclusion, and the underlying <stdlib.h> already
+ * defines the complete struct mallinfo and the mallinfo() function prototype.
+ *
+ * Including both <stdlib.h> and this <malloc.h> in the same translation unit
+ * is safe – the guard in <stdlib.h> prevents redefinition of the struct, and
+ * the wrapper adds no additional symbols.
+ */
+
+#ifndef __MALLOC_H
+#define __MALLOC_H
+
+/* The public allocator statistics API lives in <stdlib.h> for NuttX.  By
+ * including it here we expose the same definitions without pulling in the
+ * host's system header.
+ */
+#include <stdlib.h>
+
+#endif /* __MALLOC_H */

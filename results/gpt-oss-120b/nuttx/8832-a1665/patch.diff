diff --git a/fix.patch b/fix.patch
new file mode 100644
index 00000000..cb0194b8
--- /dev/null
+++ b/fix.patch
@@ -0,0 +1,41 @@
+*** Begin Patch
+*** Update File: sched/wqueue/kwork_cancel.c
+@@
+-        else
+-        {
+-          dq_rem((FAR dq_entry_t *)work, &wqueue->q);
+-
+-          /* Semaphore count should be consistent with the number of
+-           * work entries.
+-           */
+-
+-          wqueue->sem.semcount--;
+-        }
++        else
++        {
++          dq_rem((FAR dq_entry_t *)work, &wqueue->q);
++
++          /* Adjust the semaphore count to reflect the removal of the
++           * work item.  The original implementation directly decremented
++           * the semaphore count field.  That is unsafe when a worker thread
++           * is blocked in nxsem_wait_uninterruptible – the semaphore count
++           * may be zero while a waiter exists, and a direct decrement would
++           * make the count negative.  The result is that a later
++           * nxsem_post (when new work is queued) will incorrectly wake the
++           * worker, which then finds the queue empty and goes back to wait,
++           * effectively losing the newly queued work.
++           *
++           * The correct approach is to decrement the semaphore only if its
++           * count is positive.  We achieve this by attempting a non‑blocking
++           * wait on the semaphore.  If the semaphore count is zero (meaning
++           * a waiter is already pending), nxsem_trywait will fail with
++           * -EBUSY and the count will remain unchanged – the pending waiter
++           * will be satisfied by the next nxsem_post when new work arrives.
++           */
++          /* nxsem_trywait returns OK when the semaphore was decremented.
++           * When it returns -EBUSY, the semaphore count is already zero and
++           * a waiter is pending, so we leave the count unchanged.
++           */
++          (void)nxsem_trywait(&wqueue->sem);
++        }
+*** End Patch
diff --git a/sched/wqueue/kwork_cancel.c b/sched/wqueue/kwork_cancel.c
index fd8055ea..5e9684b9 100644
--- a/sched/wqueue/kwork_cancel.c
+++ b/sched/wqueue/kwork_cancel.c
@@ -89,11 +89,15 @@ static int work_qcancel(FAR struct kwork_wqueue_s *wqueue,
         {
           dq_rem((FAR dq_entry_t *)work, &wqueue->q);
 
-          /* Semaphore count should be consistent with the number of
-           * work entries.
+          /* Adjust the semaphore count to reflect the removal of the work
+           * item.  Directly decrementing the semaphore count field is unsafe
+           * when a worker thread is blocked on nxsem_wait_uninterruptible –
+           * the count may be zero while a waiter exists, leading to a
+           * negative count and lost wake‑ups.  Instead, attempt a non‑blocking
+           * wait; if the count is positive it will be decremented, otherwise
+           * we leave it unchanged because a waiter is already pending.
            */
-
-          wqueue->sem.semcount--;
+          (void)nxsem_trywait(&wqueue->sem);
         }
 
       work->worker = NULL;

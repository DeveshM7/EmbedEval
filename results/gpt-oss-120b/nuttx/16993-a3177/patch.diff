+/****************************************************************************
+ * sched/event/event_getmask.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * This file implements nxevent_getmask(), which returns the current event
+ * mask without modifying the state. The function is safe for use in an
+ * interrupt handler by protecting the access with the event's spinlock.
+ ****************************************************************************/
+
+#include "event.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+nxevent_mask_t nxevent_getmask(FAR nxevent_t *event)
+{
+  nxevent_mask_t mask;
+  irqstate_t flags;
+
+  DEBUGASSERT(event != NULL);
+
+  flags = spin_lock_irqsave(&event->lock);
+  mask = event->events;
+  spin_unlock_irqrestore(&event->lock, flags);
+
+  return mask;
+}

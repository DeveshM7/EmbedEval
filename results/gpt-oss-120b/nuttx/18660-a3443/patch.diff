diff --git a/include/nuttx/debug.h b/include/nuttx/debug.h
new file mode 100644
index 00000000..b3f414c3
--- /dev/null
+++ b/include/nuttx/debug.h
@@ -0,0 +1,31 @@
+/**
+ * @file nuttx/debug.h
+ *
+ * Compatibility shim for legacy code that includes the NuttX debug
+ * logging header via the namespaced path <nuttx/debug.h>.
+ *
+ * Historically the public debug interface lived at the top‑level include
+ * directory as <debug.h>.  Many kernel and application sources, however,
+ * expect the namespaced form.  The lack of this header results in a build
+ * failure such as:
+ *
+ *   fatal error: nuttx/debug.h: No such file or directory
+ *
+ * To resolve this we provide a thin wrapper that simply re‑exports the
+ * original header.  All macros and definitions (e.g., _info, _err, etc.)
+ * remain unchanged because they are defined in <debug.h>.
+ *
+ * The wrapper is deliberately minimal – it does not duplicate any code and
+ * therefore stays in sync with the upstream implementation automatically.
+ * Existing unqualified includes (<debug.h>) continue to work, and the new
+ * namespaced include becomes the canonical public header as required by the
+ * task description.
+ */
+
+#ifndef __INCLUDE_NUTTX_DEBUG_H
+#define __INCLUDE_NUTTX_DEBUG_H
+
+/* Re‑export the original public debug header. */
+#include <debug.h>
+
+#endif /* __INCLUDE_NUTTX_DEBUG_H */

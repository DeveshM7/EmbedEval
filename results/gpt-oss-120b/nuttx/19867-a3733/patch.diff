diff --git a/atomic_add.patch b/atomic_add.patch
new file mode 100644
index 00000000..a3b8b7ec
--- /dev/null
+++ b/atomic_add.patch
@@ -0,0 +1,32 @@
+*** Begin Patch
+*** Update File: include/nuttx/atomic.h
+@@
+-#define atomic_fetch_add(obj, val)            ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQ_REL)
+-#define atomic_fetch_add_acquire(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQUIRE)
+-#define atomic_fetch_add_release(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_RELEASE)
+-#define atomic_fetch_add_relaxed(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_RELAXED)
+-#define atomic64_fetch_add(obj, val)          ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_ACQ_REL)
+-#define atomic64_fetch_add_acquire(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_ACQUIRE)
+-#define atomic64_fetch_add_release(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_RELEASE)
+-#define atomic64_fetch_add_relaxed(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_RELAXED)
++#define atomic_fetch_add(obj, val)            ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQ_REL)
++#define atomic_fetch_add_acquire(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQUIRE)
++#define atomic_fetch_add_release(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_RELEASE)
++#define atomic_fetch_add_relaxed(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_RELAXED)
++#define atomic64_fetch_add(obj, val)          ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_ACQ_REL)
++#define atomic64_fetch_add_acquire(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_ACQUIRE)
++#define atomic64_fetch_add_release(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_RELEASE)
++#define atomic64_fetch_add_relaxed(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_RELAXED)
++
++/* Compatibility wrapper for the historic "atomic_add" API.
++ * The original NuttX public API exposed atomic_add() which behaved like
++ * atomic_fetch_add(): it atomically adds the supplied value to the target
++ * and returns the previous value. Modern implementations only provide the
++ * fetch_* family of functions, which broke code that still calls atomic_add().
++ * The macro below maps atomic_add() to the appropriate fetch_add operation
++ * using the default acquire‑release ordering. This preserves existing
++ * semantics, does not interfere with the newer fetch_* names, and ensures
++ * that callers linking against atomic_add succeed.
++ */
++#define atomic_add(obj, val)                  ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQ_REL)
+*** End Patch
diff --git a/include/nuttx/atomic.h b/include/nuttx/atomic.h
index 02fb266a..30f9c734 100644
--- a/include/nuttx/atomic.h
+++ b/include/nuttx/atomic.h
@@ -138,6 +138,7 @@ typedef volatile int64_t atomic64_t;
 #define atomic_fetch_add_acquire(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQUIRE)
 #define atomic_fetch_add_release(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_RELEASE)
 #define atomic_fetch_add_relaxed(obj, val)    ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_RELAXED)
+#define atomic_add(obj, val)                  ATOMIC_FUNC(fetch_add, 4)(obj, val, __ATOMIC_ACQ_REL)
 #define atomic64_fetch_add(obj, val)          ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_ACQ_REL)
 #define atomic64_fetch_add_acquire(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_ACQUIRE)
 #define atomic64_fetch_add_release(obj, val)  ATOMIC_FUNC(fetch_add, 8)(obj, val, __ATOMIC_RELEASE)

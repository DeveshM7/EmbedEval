+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "os/mynewt.h"
+
+#if MYNEWT_VAL(CONFIG_FCB2)
+
+#include <fcb/fcb.h>
+#include <string.h>
+
+#include "config/config.h"
+#include "config/config_store.h"
+#include "config/config_fcb2.h"
+#include "config/config_generic_kv.h"
+#include "config_priv.h"
+#include "config/config_fcb.h"
+
+#define CONF_FCB_VERS        1
+
+struct conf_fcb_load_cb_arg {
+    conf_store_load_cb cb;
+    void *cb_arg;
+};
+
+static int conf_fcb_load(struct conf_store *, conf_store_load_cb, void *);
+static int conf_fcb_save(struct conf_store *, const char *, const char *);
+
+static struct conf_store_itf conf_fcb_itf = {
+    .csi_load = conf_fcb_load,
+    .csi_save = conf_fcb_save,
+};
+
+int
+conf_fcb2_src(struct conf_fcb2 *cf)
+{
+    int rc;
+
+    cf->cf2_fcb.f_version = CONF_FCB_VERS;
+    if (cf->cf2_fcb.f_sector_cnt > 1) {
+        cf->cf2_fcb.f_scratch_cnt = 1;
+    } else {
+        cf->cf2_fcb.f_scratch_cnt = 0;
+    }
+    while (1) {
+        rc = fcb_init(while (1) {cf->cf2_fcb);
+        if (rc) {
+            return OS_INVALID_PARM;
+        }
+        break;
+    }
+        rc = fcb_init(&cf->cf2_fcb);
+        if (rc) {
+            return OS_INVALID_PARM;
+        }
+        if (cf->cf2_fcb.f_scratch_cnt && fcb_free_sector_cnt(&cf->cf2_fcb) < 1) {
+            flash_area_erase(cf->cf2_fcb.f_active.fe_area, 0,
+                             cf->cf2_fcb.f_active.fe_area->fa_size);
+        } else {
+            break;
+        }
+    }
+
+    cf->cf_store.cs_itf = &conf_fcb_itf;
+    conf_src_register(&cf->cf_store);
+    return OS_OK;
+}
+
+int
+conf_fcb2_dst(struct conf_fcb2 *cf)
+{
+    cf->cf_store.cs_itf = &conf_fcb_itf;
+    conf_dst_register(&cf->cf_store);
+    return OS_OK;
+}
+
+static int
+conf_fcb_load_cb(struct fcb_entry *loc, void *arg)
+{
+    struct conf_fcb_load_cb_arg *argp = arg;
+    char buf[CONF_MAX_NAME_LEN + CONF_MAX_VAL_LEN + 32];
+    char *name_str, *val_str;
+    int rc, len;
+
+    len = loc->fe_data_len;
+    if (len >= sizeof(buf)) {
+        len = sizeof(buf) - 1;
+    }
+    rc = fcb_read(loc, 0, buf, len);
+    if (rc) {
+        return 0;
+    }
+    buf[len] = '\0';
+    rc = conf_line_parse(buf, &name_str, &val_str);
+    if (rc) {
+        return 0;
+    }
+    argp->cb(name_str, val_str, argp->cb_arg);
+    return 0;
+}
+
+static int
+conf_fcb_load(struct conf_store *cs, conf_store_load_cb cb, void *cb_arg)
+{
+    struct conf_fcb2 *cf = (struct conf_fcb2 *)cs;
+    struct conf_fcb_load_cb_arg arg;
+    int rc;
+
+    arg.cb = cb;
+    arg.cb_arg = cb_arg;
+    rc = fcb_walk(&cf->cf2_fcb, 0, conf_fcb_load_cb, &arg);
+    if (rc) {
+        return OS_EINVAL;
+    }
+    return OS_OK;
+}
+
+static int
+conf_fcb_save(struct conf_store *cs, const char *name, const char *value)
+{
+    struct conf_fcb2 *cf = (struct conf_fcb2 *)cs;
+    return conf_fcb_kv_save(&cf->cf2_fcb, name, value);
+}
+
+/* Helper used by compression */
+static int
+conf_fcb_var_read(struct fcb_entry *loc, char *buf, char **name, char **val)
+{
+    int rc = fcb_read(loc, 0, buf, loc->fe_data_len);
+    if (rc) {
+        return rc;
+    }
+    buf[loc->fe_data_len] = '\0';
+    rc = conf_line_parse(buf, name, val);
+    return rc;
+}
+
+void
+conf_fcb2_compress(struct conf_fcb2 *cf,
+                   int (*copy_or_not)(const char *name, const char *val,
+                                      void *cn_arg),
+                   void *cn_arg)
+{
+    int rc;
+    char buf1[CONF_MAX_NAME_LEN + CONF_MAX_VAL_LEN + 32];
+    char buf2[CONF_MAX_NAME_LEN + CONF_MAX_VAL_LEN + 32];
+    struct fcb_entry loc1, loc2;
+    char *name1, *val1, *name2, *val2;
+    int copy;
+
+    rc = fcb_append_to_scratch(&cf->cf2_fcb);
+    if (rc) {
+        return;
+    }
+    loc1.fe_area = NULL; // placeholder, not used in fcb2
+    while (fcb_getnext(&cf->cf2_fcb, &loc1) == 0) {
+        if (loc1.fe_sector != cf->cf2_fcb.f_oldest_sec) {
+            break;
+        }
+        rc = conf_fcb_var_read(&loc1, buf1, &name1, &val1);
+        if (rc) {
+            continue;
+        }
+        if (!val1) {
+            continue;
+        }
+        loc2 = loc1;
+        copy = 1;
+        while (fcb_getnext(&cf->cf2_fcb, &loc2) == 0) {
+            rc = conf_fcb_var_read(&loc2, buf2, &name2, &val2);
+            if (rc) {
+                continue;
+            }
+            if (!strcmp(name1, name2)) {
+                copy = 0;
+                break;
+            }
+        }
+        if (!copy) {
+            continue;
+        }
+        if (copy_or_not) {
+            if (copy_or_not(name1, val1, cn_arg)) {
+                continue;
+            }
+        }
+        rc = fcb_read(&loc1, 0, buf1, loc1.fe_data_len);
+        if (rc) {
+            continue;
+        }
+        rc = fcb_append(&cf->cf2_fcb, loc1.fe_data_len, &loc2);
+        if (rc) {
+            continue;
+        }
+        rc = flash_area_write(loc2.fe_area, loc2.fe_data_off, buf1, loc1.fe_data_len);
+        if (rc) {
+            continue;
+        }
+        fcb_append_finish(&cf->cf2_fcb, &loc2);
+    }
+    (void)fcb_rotate(&cf->cf2_fcb);
+}
+
+#endif /* MYNEWT_VAL(CONFIG_FCB2) */
+

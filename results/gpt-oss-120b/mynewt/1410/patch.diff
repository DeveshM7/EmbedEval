+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+int
+fcb_area_info(struct fcb *fcb, struct flash_area *fa,
+              int *elemsp, int *bytesp)
+{
+    struct flash_area *area;
+    struct area_info {
+        int elems;
+        int bytes;
+    } ai = {0, 0};
+    int rc;
+
+    if (!fcb || !elemsp || !bytesp) {
+        return FCB_ERR_ARGS;
+    }
+
+    area = fa ? fa : fcb->f_oldest;
+
+    /* Iterate over entries while holding the mutex to avoid side effects */
+    struct fcb_entry loc;
+    memset(&loc, 0, sizeof(loc));
+    rc = os_mutex_pend(&fcb->f_mtx, OS_WAIT_FOREVER);
+    if (rc && rc != OS_NOT_STARTED) {
+        return FCB_ERR_ARGS;
+    }
+    while ((rc = fcb_getnext_nolock(fcb, &loc)) == 0) {
+        if (loc.fe_area == area) {
+            ai.elems++;
+            ai.bytes += loc.fe_data_len;
+        }
+    }
+    os_mutex_release(&fcb->f_mtx);
+
+    *elemsp = ai.elems;
+    *bytesp = ai.bytes;
+    return 0;
+}
+

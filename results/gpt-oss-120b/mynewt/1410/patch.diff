@@ -112,6 +112,30 @@ typedef int (*fcb_walk_cb)(struct fcb_entry *loc, void *arg);
 int fcb_walk(struct fcb *, struct flash_area *, fcb_walk_cb cb, void *cb_arg);
 int fcb_getnext(struct fcb *, struct fcb_entry *loc);
 
+/**
+ * \brief Retrieve information about a specific flash area used by the FCB.
+ *
+ * This function reports the number of stored entries (elements) and the total
+ * number of user data bytes contained within those entries for the specified
+ * flash area. If the supplied flash area pointer is NULL the function reports
+ * information for the current oldest area (the one that would be rotated out
+ * next). Areas that have been rotated away or wiped are considered empty and
+ * therefore report zero entries and zero bytes.
+ *
+ * The function always returns 0; any error conditions are considered a test
+ * failure and are handled by the caller via assertions.
+ *
+ * @param fcb   Pointer to the initialised FCB instance.
+ * @param fa    Flash area to query. May be NULL to query the oldest area.
+ * @param elemsp  Output parameter receiving the number of stored entries.
+ * @param bytesp  Output parameter receiving the total number of user data
+ *                bytes across all entries.
+ * @return 0 on success.
+ */
+int fcb_area_info(struct fcb *fcb, struct flash_area *fa,
+                  int *elemsp, int *bytesp);
+int fcb_getnext(struct fcb *, struct fcb_entry *loc);
+
 /**

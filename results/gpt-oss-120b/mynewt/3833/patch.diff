diff --git a/patch1.diff b/patch1.diff
new file mode 100644
index 0000000..bdcb8da
--- /dev/null
+++ b/patch1.diff
@@ -0,0 +1,23 @@
+*** Begin Patch
+*** Update File: encoding/cborattr/src/cborattr.c
+@@
+-            case CborAttrArrayType:
+-                err |= cbor_read_array(&cur_value, &cursor->addr.array);
+-                continue;
++            case CborAttrArrayType:
++                /* Handle array attribute. If the value is not an array, treat
++                 * it as absent. According to the updated specification we must
++                 * set the count to 0 when the attribute is optional (nodefault
++                 * == false) and leave it unchanged when nodefault is true.
++                 */
++                if (cbor_value_is_array(&cur_value)) {
++                    err |= cbor_read_array(&cur_value, &cursor->addr.array);
++                } else {
++                    /* Not an array – treat as missing. */
++                    if (!cursor->nodefault && cursor->addr.array.count) {
++                        *cursor->addr.array.count = 0;
++                    }
++                    /* No error, just advance past the value. */
++                }
++                continue;
+*** End Patch

diff --git a/boot/boot_serial/src/boot_serial.c b/boot/boot_serial/src/boot_serial.c
index a2324e9..68abda8 100644
--- a/boot/boot_serial/src/boot_serial.c
+++ b/boot/boot_serial/src/boot_serial.c
@@ -628,6 +628,26 @@ boot_serial_start(int max_input)
  * os_init() will not be called with bootloader, so we need to initialize
  * devices created by hal_bsp_init() here.
  */
+/*
+ * Open the UART console used by the bootloader.
+ *
+ * This wrapper initialises the console subsystem (which on the native
+ * simulated platform is backed by the UART driver) and disables echo.
+ * It returns 0 on success, non-zero on failure.
+ */
+int
+boot_serial_uart_open(void)
+{
+    int rc;
+
+    rc = console_init(NULL);
+    if (rc != 0) {
+        return rc;
+    }
+    console_echo(0);
+    return 0;
+}
+
 void
 boot_serial_os_dev_init(void)

+*** Begin Patch
+*** Update File: sys/config/src/config.c
+@@
+ struct conf_handler *
+ conf_parse_and_lookup(char *name, int *name_argc, char *name_argv[])
+ {
+-    int rc;
+-
+-    rc = conf_parse_name(name, name_argc, name_argv);
+-    if (rc) {
+-        return NULL;
+-    }
+-    return conf_handler_lookup(name_argv[0]);
++    int rc;
++
++    /* Parse the name into its hierarchical tokens. */
++    rc = conf_parse_name(name, name_argc, name_argv);
++    if (rc) {
++        return NULL;
++    }
++
++    /* Reject names that contain no tokens \u2013 this includes empty strings
++     * and strings that consist solely of the separator (e.g. "/").  Prior to
++     * this change the code would attempt to access name_argv[0] which is
++     * undefined, leading to crashes when looking up unknown configuration
++     * entries (see config_test_getset_unknown). */
++    if (*name_argc == 0) {
++        return NULL;
++    }
++
++    return conf_handler_lookup(name_argv[0]);
+ }
+*** End Patch

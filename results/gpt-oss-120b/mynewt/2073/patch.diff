+++ b/sys/flash_map/include/flash_map/flash_map.h.patch
@@ -0,0 +1,20 @@
+*** Begin Patch
+*** Update File: sys/flash_map/include/flash_map/flash_map.h
+@@
+ int flash_area_id_to_image_slot(int area_id);
++
++/**
++ * Add any missing default flash map areas to the current flash map.
++ *
++ * The function inspects the default flash map (generated from the BSP
++ * configuration and referenced via the symbol `sysflash_map_dflt`).  For each
++ * default area that is *not* already present in the manufacturing flash map
++ * (identified by duplicate IDs) and that does not overlap an existing area,
++ * the area is appended to the map.
++ *
++ * The function is intentionally exposed as an external API so that tests and
++ * external callers can trigger the merge logic without having to replicate the
++ * internal implementation details.  It takes no arguments and returns nothing.
++ */
++void flash_map_add_new_dflt_areas_extern(void);
+*** End Patch

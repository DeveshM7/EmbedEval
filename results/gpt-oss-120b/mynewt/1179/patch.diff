+    }
         goto err;
     }
 
@@ -475,3 +481,47 @@ log_flush(struct log *log)
 err:
     return (rc);
 }
+
+/**
+ * Get the minimum log level configured for a module. If per‑module log
+ * filtering is disabled this always returns 0. If the module has not been
+ * configured a level of 0 (LOG_LEVEL_DEBUG) is returned.
+ */
+uint8_t
+log_level_get(uint8_t module)
+{
+#if MYNEWT_VAL(LOG_MODULE_LEVEL)
+    if (module > LOG_MODULE_MAX) {
+        return 0;
+    }
+    return log_module_levels[module];
+#else
+    (void)module;
+    return 0;
+#endif
+}
+
+/**
+ * Set the minimum log level for a module. Acceptable levels are 0‑15. Returns
+ * SYS_EINVAL if the level is out of range, SYS_ENOTSUP if the feature is
+ * disabled, or 0 on success.
+ */
+int
+log_level_set(uint8_t module, uint8_t level)
+{
+#if MYNEWT_VAL(LOG_MODULE_LEVEL)
+    if (module > LOG_MODULE_MAX) {
+        return SYS_EINVAL;
+    }
+    if (level > 15) {
+        return SYS_EINVAL;
+    }
+    log_module_levels[module] = level;
+    return 0;
+#else
+    (void)module;
+    (void)level;
+    return SYS_ENOTSUP;
+#endif
+}
+

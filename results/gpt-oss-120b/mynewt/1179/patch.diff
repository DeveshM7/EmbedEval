diff --git a/sys/log/full/test_per_module/src/log_test.c b/sys/log/full/test_per_module/src/log_test.c
new file mode 100644
index 0000000..ed306e1
--- /dev/null
+++ b/sys/log/full/test_per_module/src/log_test.c
@@ -0,0 +1,83 @@
+#include <string.h>
+
+#include "os/mynewt.h"
+#include "testutil/testutil.h"
+#include "fcb/fcb.h"
+#include "log/log.h"
+
+struct flash_area fcb_areas[] = {
+    [0] = {
+        .fa_off = 0x00000000,
+        .fa_size = 16 * 1024
+    },
+    [1] = {
+        .fa_off = 0x00004000,
+        .fa_size = 16 * 1024
+    }
+};
+struct fcb log_fcb;
+struct log my_log;
+
+int
+log_test_walk1(struct log *log, struct log_offset *log_offset,
+               void *dptr, uint16_t len)
+{
+    return 0; // not used
+}
+
+int
+log_test_walk2(struct log *log, struct log_offset *log_offset,
+               void *dptr, uint16_t len)
+{
+    return 0;
+}
+
+// Include the test case we added in a separate file.
+/* Test case for per-module log level filtering. */
+TEST_CASE(log_module_level)
+{
+    int rc;
+    int i;
+
+    log_fcb.f_sectors = fcb_areas;
+    log_fcb.f_sector_cnt = sizeof(fcb_areas) / sizeof(fcb_areas[0]);
+    log_fcb.f_magic = 0x7EADBADF;
+    log_fcb.f_version = 0;
+
+    for (i = 0; i < log_fcb.f_sector_cnt; i++) {
+        rc = flash_area_erase(&fcb_areas[i], 0, fcb_areas[i].fa_size);
+        TEST_ASSERT(rc == 0);
+    }
+
+    rc = fcb_init(&log_fcb);
+    TEST_ASSERT(rc == 0);
+
+    rc = log_register("log", &my_log, &log_fcb_handler, &log_fcb, LOG_SYSLEVEL);
+    TEST_ASSERT(rc == 0);
+
+    rc = log_level_set(LOG_MODULE_TEST, LOG_LEVEL_INFO);
+    TEST_ASSERT(rc == 0);
+
+    rc = log_append(&my_log, LOG_MODULE_TEST, LOG_LEVEL_DEBUG, "msg", 3);
+    TEST_ASSERT(rc != 0);
+
+    rc = log_append(&my_log, LOG_MODULE_TEST, LOG_LEVEL_INFO, "msg", 3);
+    TEST_ASSERT(rc == 0);
+}
+
+
+TEST_CASE_DECL(log_module_level)
+
+TEST_SUITE(log_test_all)
+{
+    log_module_level();
+}
+
+#if MYNEWT_VAL(SELFTEST)
+int main(int argc, char **argv)
+{
+    sysinit();
+    log_test_all();
+    return tu_any_failed;
+}
+#endif

diff --git a/mbuf.patch b/mbuf.patch
new file mode 100644
index 0000000..ebd55bf
--- /dev/null
+++ b/mbuf.patch
@@ -0,0 +1,153 @@
+--- a/kernel/os/src/os_mbuf.c
++++ b/kernel/os/src/os_mbuf.c
+@@
+-struct os_mbuf *
+-os_mbuf_off(const struct os_mbuf *om, int off, uint16_t *out_off)
+-{
+-    struct os_mbuf *next;
+-    struct os_mbuf *cur;
+-
+-    /* Cast away const. */
+-    cur = (struct os_mbuf *)om;
+-
+-    while (1) {
+-        if (cur == NULL) {
+-            return NULL;
+-        }
+-
+-        next = SLIST_NEXT(cur, om_next);
+-
+-        if (cur->om_len > off ||
+-            (cur->om_len == off && next == NULL)) {
+-
+-            *out_off = off;
+-            return cur;
+-        }
+-
+-        off -= cur->om_len;
+-        cur = next;
+-    }
+-}
++/**
++ * Return the mbuf in the chain that contains the byte at the given offset.
++ *
++ * The original implementation assumed the caller would never pass a negative
++ * offset.  Several callers (including newly added tests) rely on the function
++ * to gracefully reject such inputs.  For consistency with other mbuf helper
++ * functions (e.g. os_mbuf_copydata) we now treat a negative offset as an error
++ * and return NULL.
++ */
++struct os_mbuf *
++os_mbuf_off(const struct os_mbuf *om, int off, uint16_t *out_off)
++{
++    struct os_mbuf *next;
++    struct os_mbuf *cur;
++
++    /* Negative offsets are invalid – reject them early. */
++    if (off < 0) {
++        return NULL;
++    }
++
++    /* Cast away const. */
++    cur = (struct os_mbuf *)om;
++
++    while (1) {
++        if (cur == NULL) {
++            return NULL;
++        }
++
++        next = SLIST_NEXT(cur, om_next);
++
++        if (cur->om_len > off ||
++            (cur->om_len == off && next == NULL)) {
++
++            *out_off = (uint16_t)off;
++            return cur;
++        }
++
++        off -= cur->om_len;
++        cur = next;
++    }
++}
+@@
+-int
+-os_mbuf_copydata(const struct os_mbuf *om, int off, int len, void *dst)
+-{
+-    unsigned int count;
+-    uint8_t *udst;
+-
+-    if (!len) {
+-        return 0;
+-    }
+-
+-    udst = dst;
+-
+-    while (off > 0) {
+-        if (!om) {
+-            return (-1);
+-        }
+-
+-        if (off < om->om_len) {
+-            break;
+-        }
+-        off -= om->om_len;
+-        om = SLIST_NEXT(om, om_next);
+-    }
+-    while (len > 0 && om != NULL) {
+-        count = min(om->om_len - off, len);
+-        memcpy(udst, om->om_data + off, count);
+-        len -= count;
+-        udst += count;
+-        off = 0;
+-        om = SLIST_NEXT(om, om_next);
+-    }
+-
+-    return (len > 0 ? -1 : 0);
+-}
++/**
++ * Copy data from a mbuf chain to a destination buffer.
++ *
++ * The function now validates its parameters more strictly.  A negative
++ * offset or a negative length is considered an error and the function returns
++ * -1 without touching the destination buffer.  This mirrors the behaviour of
++ * other mbuf APIs that reject invalid arguments.
++ */
++int
++os_mbuf_copydata(const struct os_mbuf *om, int off, int len, void *dst)
++{
++    unsigned int count;
++    uint8_t *udst;
++
++    /* Reject negative offsets and lengths. */
++    if (off < 0 || len < 0) {
++        return -1;
++    }
++
++    if (!len) {
++        return 0;
++    }
++
++    udst = dst;
++
++    while (off > 0) {
++        if (!om) {
++            return (-1);
++        }
++
++        if (off < om->om_len) {
++            break;
++        }
++        off -= om->om_len;
++        om = SLIST_NEXT(om, om_next);
++    }
++    while (len > 0 && om != NULL) {
++        count = min(om->om_len - off, (unsigned int)len);
++        memcpy(udst, om->om_data + off, count);
++        len -= count;
++        udst += count;
++        off = 0;
++        om = SLIST_NEXT(om, om_next);
++    }
++
++    return (len > 0 ? -1 : 0);
++}
diff --git a/mbuf_test_add.patch b/mbuf_test_add.patch

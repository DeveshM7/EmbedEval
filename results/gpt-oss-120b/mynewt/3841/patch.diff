@@ -0,0 +1,46 @@
+diff --git a/kernel/os/selftest/src/mbuf_test.c b/kernel/os/selftest/src/mbuf_test.c
+index 0000000..1111111 100644
+--- a/kernel/os/selftest/src/mbuf_test.c
++++ b/kernel/os/selftest/src/mbuf_test.c
+@@
+-TEST_CASE_DECL(os_mbuf_test_pack_chains)
+-TEST_CASE_DECL(os_mbuf_test_copydata_negative)
++TEST_CASE_DECL(os_mbuf_test_pack_chains)
++TEST_CASE_DECL(os_mbuf_test_copydata_negative)
+@@
+-    os_mbuf_test_pack_chains();
+-    os_mbuf_test_copydata_negative();
++    os_mbuf_test_pack_chains();
++    os_mbuf_test_copydata_negative();
+ }
++
++/* Test that os_mbuf_copydata rejects negative offsets and lengths and does not modify the destination buffer. Also test that os_mbuf_off returns NULL for negative offsets. */
++static void
++os_mbuf_test_copydata_negative(void)
++{
++    struct os_mbuf *om;
++    uint8_t dst[4];
++    int rc;
++    uint16_t out_off;
++
++    om = os_mbuf_get(&os_mbuf_pool, 0);
++    TEST_ASSERT_FATAL(om != NULL, "Failed to allocate mbuf");
++    om->om_len = 2;
++    om->om_data = om->om_databuf;
++    om->om_data[0] = 0x11;
++    om->om_data[1] = 0x22;
++
++    memset(dst, 0xAA, sizeof dst);
++
++    rc = os_mbuf_copydata(om, -1, 1, dst);
++    TEST_ASSERT(rc == -1);
++    TEST_ASSERT(memcmp(dst, (uint8_t[4]){0xAA,0xAA,0xAA,0xAA}, sizeof dst) == 0);
++
++    rc = os_mbuf_copydata(om, 0, -1, dst);
++    TEST_ASSERT(rc == -1);
++    TEST_ASSERT(memcmp(dst, (uint8_t[4]){0xAA,0xAA,0xAA,0xAA}, sizeof dst) == 0);
++
++    TEST_ASSERT(os_mbuf_off(om, -5, &out_off) == NULL);
++
++    os_mbuf_free_chain(om);
++}

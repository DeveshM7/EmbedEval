diff --git a/hw/sensor/test_err_listener/src/sensor_err_listener_test.c b/hw/sensor/test_err_listener/src/sensor_err_listener_test.c
new file mode 100644
index 0000000..6eeb468
--- /dev/null
+++ b/hw/sensor/test_err_listener/src/sensor_err_listener_test.c
@@ -0,0 +1,89 @@
+#include "sensor/sensor.h"
+#include "testutil/testutil.h"
+
+/* Global variables to capture callback invocation */
+static int err_call_count;
+static struct sensor *called_sensor;
+static void *called_arg;
+static int called_status;
+static sensor_type_t called_type;
+
+static void err_callback(struct sensor *sensor, void *arg, int status,
+                         sensor_type_t type)
+{
+    err_call_count++;
+    called_sensor = sensor;
+    called_arg = arg;
+    called_status = status;
+    called_type = type;
+}
+
+/* Mock driver read that always fails */
+static int mock_read_fail(struct sensor *sensor, sensor_type_t type,
+                          sensor_data_func_t data_func, void *arg,
+                          uint32_t timeout)
+{
+    (void)sensor; (void)type; (void)data_func; (void)arg; (void)timeout;
+    return -1; /* non‑zero error */
+}
+
+/* Mock driver read that succeeds */
+static int mock_read_success(struct sensor *sensor, sensor_type_t type,
+                             sensor_data_func_t data_func, void *arg,
+                             uint32_t timeout)
+{
+    (void)sensor; (void)type; (void)data_func; (void)arg; (void)timeout;
+    return 0;
+}
+
+static struct sensor_driver driver_fail = { .sd_read = mock_read_fail };
+static struct sensor_driver driver_success = { .sd_read = mock_read_success };
+
+TEST_CASE(sensor_err_listener_test)
+{
+    struct sensor s;
+    struct sensor_err_listener l;
+    int rc;
+
+    /* Initialize sensor */
+    rc = sensor_init(&s, NULL);
+    TEST_ASSERT_FATAL(rc == 0, "sensor_init failed");
+
+    /* Set driver that fails */
+    sensor_set_driver(&s, SENSOR_TYPE_ACCELEROMETER, &driver_fail);
+    s.s_types = SENSOR_TYPE_ACCELEROMETER;
+    s.s_mask = SENSOR_TYPE_ACCELEROMETER;
+
+    /* Register error listener with matching mask */
+    l.sel_sensor_type = SENSOR_TYPE_ACCELEROMETER;
+    l.sel_func = err_callback;
+    l.sel_arg = (void*)0xdeadbeef;
+    rc = sensor_register_err_listener(&s, &l);
+    TEST_ASSERT_FATAL(rc == 0, "register err listener failed");
+
+    err_call_count = 0;
+    rc = sensor_read(&s, SENSOR_TYPE_ACCELEROMETER, NULL, NULL, 0);
+    TEST_ASSERT_FATAL(rc != 0, "read should fail");
+    TEST_ASSERT_FATAL(err_call_count == 1, "error listener not called");
+    TEST_ASSERT_FATAL(called_sensor == &s, "listener got wrong sensor");
+    TEST_ASSERT_FATAL(called_arg == (void*)0xdeadbeef, "listener arg mismatch");
+    TEST_ASSERT_FATAL(called_status == rc, "listener status mismatch");
+    TEST_ASSERT_FATAL(called_type == SENSOR_TYPE_ACCELEROMETER, "listener type mismatch");
+
+    /* Reset count and change driver to success; listener should not be called */
+    sensor_set_driver(&s, SENSOR_TYPE_ACCELEROMETER, &driver_success);
+    err_call_count = 0;
+    s.s_mask = SENSOR_TYPE_ACCELEROMETER;
+    rc = sensor_read(&s, SENSOR_TYPE_ACCELEROMETER, NULL, NULL, 0);
+    TEST_ASSERT_FATAL(rc == 0, "read should succeed");
+    TEST_ASSERT_FATAL(err_call_count == 0, "listener called on success");
+
+    /* Test non‑matching mask */
+    l.sel_sensor_type = 0; /* no bits */
+    sensor_set_driver(&s, SENSOR_TYPE_ACCELEROMETER, &driver_fail);
+    err_call_count = 0;
+    rc = sensor_read(&s, SENSOR_TYPE_ACCELEROMETER, NULL, NULL, 0);
+    TEST_ASSERT_FATAL(rc != 0, "read should fail");
+    TEST_ASSERT_FATAL(err_call_count == 0, "listener called despite non‑matching mask");
+}
+

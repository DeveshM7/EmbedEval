diff --git a/hw/sensor/src/sensor.c b/hw/sensor/src/sensor.c
index 36d85ef..fa4aca5 100644
--- a/hw/sensor/src/sensor.c
+++ b/hw/sensor/src/sensor.c
@@ -990,6 +990,21 @@ err:
     return (rc);
 }
 
+/* Register a sensor error listener */
+int
+sensor_register_err_listener(struct sensor *sensor,
+        struct sensor_err_listener *err_listener)
+{
+    int rc;
+    rc = sensor_lock(sensor);
+    if (rc != 0) {
+        return rc;
+    }
+    SLIST_INSERT_HEAD(&sensor->s_err_listener_list, err_listener, sel_next);
+    sensor_unlock(sensor);
+    return 0;
+}
+
 /**
  * Un-register a sensor listener. This allows a calling application to unset
  * callbacks for a given sensor object.
@@ -2163,6 +2178,13 @@ sensor_read(struct sensor *sensor, sensor_type_t type,
     rc = sensor->s_funcs->sd_read(sensor, type, sensor_read_data_func, &src,
                                   timeout);
     if (rc) {
+        /* Call error listeners matching the type */
+        struct sensor_err_listener *l;
+        SLIST_FOREACH(l, &sensor->s_err_listener_list, sel_next) {
+            if (l->sel_sensor_type & type) {
+                l->sel_func(sensor, l->sel_arg, rc, type);
+            }
+        }
         goto err;
     }
 

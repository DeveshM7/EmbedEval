+        rc = log_append_body(mm->desc.log, module,
                               level, etype, data, len);
         if (rc != 0) {
             return SYS_EIO;
@@ -278,11 +278,12 @@ modlog_append_mbuf_one(struct modlog_mapping *mm, uint8_t module,

diff --git a/net/nimble/controller/src/ble_ll_conn.c b/net/nimble/controller/src/ble_ll_conn.c
index 2d4c099..42cb717 100644
--- a/net/nimble/controller/src/ble_ll_conn.c
+++ b/net/nimble/controller/src/ble_ll_conn.c
@@ -572,7 +572,7 @@ ble_ll_conn_calc_access_addr(void)
  * @return uint8_t
  */
 uint8_t
-ble_ll_conn_calc_dci(struct ble_ll_conn_sm *conn)
+ble_ll_conn_calc_dci(struct ble_ll_conn_sm *conn, uint16_t latency)
 {
     int     i;
     int     j;
@@ -584,6 +584,7 @@ ble_ll_conn_calc_dci(struct ble_ll_conn_sm *conn)
     uint8_t mask;
     uint8_t usable_chans;
 
+    /* CSA2 channel selection */    if (CONN_F_CSA2_SUPP(conn)) {        uint16_t prn = (uint16_t)((conn->channel_id + conn->hop_inc * conn->event_cntr) & 0xFFFF);        curchan = prn % BLE_PHY_NUM_DATA_CHANS;        conn->unmapped_chan = curchan;        /* Check if channel is usable; if not, remap similar to CSA1 */        uint8_t bitpos = 1 << (curchan & 0x07);        if ((conn->chanmap[curchan >> 3] & bitpos) == 0) {            uint8_t remap_index = curchan % conn->num_used_chans;            uint8_t chan = 0;            uint8_t cntr = 0;            for (int i = 0; i < BLE_LL_CONN_CHMAP_LEN; i++) {                uint8_t usable = conn->chanmap[i];                if (usable) {                    uint8_t mask = 0x01;                    for (int j = 0; j < 8; j++) {                        if (usable & mask) {                            if (cntr == remap_index) {                                return (chan + j);                            }                            ++cntr;                        }                        mask <<= 1;                    }                }                chan += 8;            }        }        return curchan;    }
     /* Get next unmapped channel */
     curchan = conn->last_unmapped_chan + conn->hop_inc;
     if (curchan > BLE_PHY_NUM_DATA_CHANS) {
@@ -1490,6 +1491,7 @@ ble_ll_conn_master_init(struct ble_ll_conn_sm *connsm,
 
     /*  Calculate random access address and crc initialization value */
     connsm->access_addr = ble_ll_conn_calc_access_addr();
+    connsm->channel_id = (uint16_t)((connsm->access_addr & 0xFFFF) ^ (connsm->access_addr >> 16));
     connsm->crcinit = rand() & 0xffffff;
 
     /* Set initial schedule callback */
@@ -1536,7 +1538,7 @@ ble_ll_conn_sm_new(struct ble_ll_conn_sm *connsm)
 
     /* Calculate the next data channel */
     connsm->last_unmapped_chan = 0;
-    connsm->data_chan_index = ble_ll_conn_calc_dci(connsm);
+    connsm->data_chan_index = ble_ll_conn_calc_dci(connsm, 0);
 
     /* Connection end event */
     connsm->conn_ev_end.ev_arg = connsm;
@@ -1860,7 +1862,7 @@ ble_ll_conn_next_event(struct ble_ll_conn_sm *connsm)
     /* Calculate data channel index of next connection event */
     while (latency > 0) {
         connsm->last_unmapped_chan = connsm->unmapped_chan;
-        connsm->data_chan_index = ble_ll_conn_calc_dci(connsm);
+        connsm->data_chan_index = ble_ll_conn_calc_dci(connsm, 0);
         --latency;
     }
 

+/**
+ * Delete every object from the BLE store.  This is a convenience wrapper that
+ * removes all objects of the three supported types: our security state,
+ * peer security state, and CCCD entries.  It succeeds even if the store is
+ * already empty.
+ *
+ * @return 0 on success; nonzero on error.
+ */
+int
+ble_store_clear(void)
+{
+    union ble_store_key key;
+    int rc;
+
+    memset(&key, 0, sizeof key);
+
+    rc = ble_store_util_delete_all(BLE_STORE_OBJ_TYPE_OUR_SEC, &key);
+    if (rc != 0) {
+        return rc;
+    }
+
+    rc = ble_store_util_delete_all(BLE_STORE_OBJ_TYPE_PEER_SEC, &key);
+    if (rc != 0) {
+        return rc;
+    }
+
+    rc = ble_store_util_delete_all(BLE_STORE_OBJ_TYPE_CCCD, &key);
+    return rc;
+}

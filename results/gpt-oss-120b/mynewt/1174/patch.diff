index 0000000..99f31ec
--- /dev/null
+++ b/sys/log/modlog/src/modlog.c
@@ -0,0 +1,210 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "os/mynewt.h"
+#include "log/log.h"
+#include "modlog/modlog.h"
+
+#ifndef MODLOG_MAX_MAPPINGS
+#define MODLOG_MAX_MAPPINGS 8
+#endif
+
+static struct modlog_desc g_descs[MODLOG_MAX_MAPPINGS];
+static uint8_t g_next_handle = 1;
+
+static struct modlog_desc *
+find_by_handle(uint8_t handle)
+{
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        if (g_descs[i].handle == handle) {
+            return &g_descs[i];
+        }
+    }
+    return NULL;
+}
+
+int
+modlog_get(uint8_t handle, struct modlog_desc *out_desc)
+{
+    struct modlog_desc *d = find_by_handle(handle);
+    if (!d) {
+        return SYS_ENOENT;
+    }
+    if (out_desc) {
+        *out_desc = *d;
+    }
+    return 0;
+}
+
+int
+modlog_register(uint8_t module, struct log *log, uint8_t min_level,
+                uint8_t *out_handle)
+{
+    if (!log) {
+        return SYS_EINVAL;
+    }
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        if (g_descs[i].handle == 0) {
+            uint8_t h = g_next_handle++;
+            if (g_next_handle == 0) {
+                g_next_handle = 1;
+            }
+            g_descs[i].log = log;
+            g_descs[i].module = module;
+            g_descs[i].min_level = min_level;
+            g_descs[i].handle = h;
+            if (out_handle) {
+                *out_handle = h;
+            }
+            return 0;
+        }
+    }
+    return SYS_ENOMEM;
+}
+
+int
+modlog_delete(uint8_t handle)
+{
+    struct modlog_desc *d = find_by_handle(handle);
+    if (!d) {
+        return SYS_ENOENT;
+    }
+    memset(d, 0, sizeof(*d));
+    return 0;
+}
+
+static void
+forward_entry(uint8_t module, uint8_t level, uint8_t etype,
+               void *data, uint16_t len, struct modlog_desc *desc)
+{
+    if (level < desc->min_level) {
+        return;
+    }
+    log_append_typed(desc->log, module, level, etype, data, len);
+}
+
+int
+modlog_append(uint8_t module, uint8_t level, uint8_t etype,
+              void *data, uint16_t len)
+{
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        struct modlog_desc *d = &g_descs[i];
+        if (d->handle == 0) {
+            continue;
+        }
+        if (d->module == module || d->module == MODLOG_MODULE_DFLT) {
+            forward_entry(module, level, etype, data, len, d);
+        }
+    }
+    return 0;
+}
+
+int
+modlog_append_mbuf(uint8_t module, uint8_t level, uint8_t etype,
+                   struct os_mbuf *om)
+{
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        struct modlog_desc *d = &g_descs[i];
+        if (d->handle == 0) {
+            continue;
+        }
+        if (d->module == module || d->module == MODLOG_MODULE_DFLT) {
+            log_append_mbuf_typed(d->log, module, level, etype, om);
+        }
+    }
+    os_mbuf_free_chain(om);
+    return 0;
+}
+
+int
+modlog_foreach(modlog_foreach_fn fn, void *arg)
+{
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        for (int j = i + 1; j < MODLOG_MAX_MAPPINGS; j++) {
+            if (g_descs[j].handle && (!g_descs[i].handle ||
+                g_descs[j].module < g_descs[i].module)) {
+                struct modlog_desc tmp = g_descs[i];
+                g_descs[i] = g_descs[j];
+                g_descs[j] = tmp;
+            }
+        }
+    }
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        if (g_descs[i].handle == 0) {
+            continue;
+        }
+        int rc = fn(&g_descs[i], arg);
+        if (rc != 0) {
+            return rc;
+        }
+    }
+    return 0;
+}
+
+void
+modlog_printf(uint16_t module, uint16_t level, const char *msg, ...)
+{
+    char fmt_buf[MODLOG_MAX_PRINTF_LEN];
+    va_list ap;
+    int len;
+
+    va_start(ap, msg);
+    len = vsnprintf(fmt_buf, MODLOG_MAX_PRINTF_LEN, msg, ap);
+    va_end(ap);
+    if (len < 0) {
+        return;
+    }
+    if ((size_t)len >= MODLOG_MAX_PRINTF_LEN) {
+        len = MODLOG_MAX_PRINTF_LEN - 1;
+    }
+    uint8_t tmp[LOG_ENTRY_HDR_SIZE + MODLOG_MAX_PRINTF_LEN];
+    struct log_entry_hdr hdr;
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.ue_module = (uint8_t)module;
+    hdr.ue_level = (uint8_t)level;
+    #if MYNEWT_VAL(LOG_VERSION) > 2
+    hdr.ue_etype = LOG_ETYPE_STRING;
+#endif
+    memcpy(tmp, &hdr, LOG_ENTRY_HDR_SIZE);
+    memcpy(tmp + LOG_ENTRY_HDR_SIZE, fmt_buf, len);
+    modlog_append((uint8_t)module, (uint8_t)level, LOG_ETYPE_STRING,
+                  tmp, (uint16_t)len);
+}
+
+void
+modlog_pkg_init(void)
+{
+    if (!MODLOG_CONSOLE_DFLT) {
+        return;
+    }
+    static struct log console_log;
+    int rc = log_register("modlog_console", &console_log,
+                          (struct log_handler *)&log_console_handler,
+                          NULL, LOG_SYSLEVEL);
+    if (rc == 0) {
+        (void)modlog_register(MODLOG_MODULE_DFLT, &console_log,
+                               LOG_LEVEL_DEBUG, NULL);
+    }
+}
+

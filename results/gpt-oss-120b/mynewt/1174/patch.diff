+/**
+ * @file modlog.h
+ * @brief Module‑mapped logging API.
+ */
+
+#ifndef __MODLOG_MODLOG_H__
+#define __MODLOG_MODLOG_H__
+
+#include "os/mynewt.h"
+#include "log/log.h"
+
+/** Default module identifier – used for fallback mappings. */
+#define MODLOG_MODULE_DFLT 255
+
+/** Mapping descriptor. */
+struct modlog_desc {
+    struct log *log;      /**< Underlying log instance */
+    uint8_t     handle;   /**< Unique handle for this mapping */
+    uint8_t     module;   /**< Module this mapping handles */
+    uint8_t     min_level;/**< Minimum log level required to forward */
+};
+
+/** Callback type for iteration. */
+typedef int (*modlog_foreach_fn)(const struct modlog_desc *desc, void *arg);
+
+int modlog_get(uint8_t handle, struct modlog_desc *out_desc);
+int modlog_register(uint8_t module, struct log *log, uint8_t min_level,
+                    uint8_t *out_handle);
+int modlog_delete(uint8_t handle);
+int modlog_append(uint8_t module, uint8_t level, uint8_t etype,
+                  void *data, uint16_t len);
+int modlog_append_mbuf(uint8_t module, uint8_t level, uint8_t etype,
+                       struct os_mbuf *om);
+int modlog_foreach(modlog_foreach_fn fn, void *arg);
+void modlog_printf(uint16_t module, uint16_t level, const char *msg, ...);
+
+/* Configuration values – defined via syscfg.yml */
+#define MODLOG_MAX_PRINTF_LEN   MYNEWT_VAL(MODLOG_MAX_PRINTF_LEN)
+#define MODLOG_CONSOLE_DFLT    MYNEWT_VAL(MODLOG_CONSOLE_DFLT)
+
+/** Package initializer – registers a default console mapping if enabled. */
+void modlog_pkg_init(void);
+
+#endif /* __MODLOG_MODLOG_H__ */

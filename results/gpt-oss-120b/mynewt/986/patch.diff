diff --git a/diff.patch b/diff.patch
new file mode 100644
index 0000000..715956e
--- /dev/null
+++ b/diff.patch
@@ -0,0 +1,27 @@
+*** Begin Patch
+*** Update File: kernel/sim/src/sim_sched_gen.c
+@@
+-    task = sf->sf_task;
+-    task->t_func(task->t_arg);
+-
+-    /* This should never return */
+-    assert(0);
++    task = sf->sf_task;
++    /*
++     * In the native simulator a task's entry function is expected to loop
++     * forever. Historically the wrapper asserted if the function ever
++     * returned, which caused the simulator to abort. Some unit‑tests create
++     * short‑lived tasks whose handler returns; the intended behaviour is for
++     * the scheduler to treat the return as a normal yield and schedule the
++     * next ready task – effectively restarting the task without aborting.
++     */
++    task->t_func(task->t_arg);
++
++    /* Handler returned – schedule next task (may be the same task). */
++    os_sched(NULL);
++
++    /* If the scheduler returns (e.g., no other runnable tasks), fall back to
++     * the original behaviour to avoid undefined execution flow.
++     */
++    assert(0);
+*** End Patch
diff --git a/kernel/sim/src/sim_sched_gen.c b/kernel/sim/src/sim_sched_gen.c

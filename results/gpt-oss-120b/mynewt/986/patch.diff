diff --git a/patch.diff b/patch.diff
new file mode 100644
index 0000000..7ebe347
--- /dev/null
+++ b/patch.diff
@@ -0,0 +1,29 @@
+*** Begin Patch
+*** Update File: kernel/sim/src/sim_sched_gen.c
+@@
+-    task->t_func(task->t_arg);
+-
+-    /* This should never return */
+-    assert(0);
++    /*
++     * In the native simulator a task's entry function is expected to loop
++     * forever.  Historically the wrapper asserted if the function ever
++     * returned, which caused the simulator to abort.  Some unit‑tests create
++     * short‑lived tasks whose handler returns; the intended behaviour is for
++     * the scheduler to treat the return as the end of the current time slice
++     * and immediately schedule the next ready task – effectively "restarting"
++     * the task without aborting the simulator.
++     */
++    task->t_func(task->t_arg);
++
++    /* Handler returned – schedule next task (which may be the same task).
++     * os_sched(NULL) performs a context switch to the next ready task.
++     */
++    os_sched(NULL);
++
++    /* If the scheduler returns (which can happen only if there are no other
++     * runnable tasks), we fall back to the original behaviour to avoid
++     * undefined execution flow.
++     */
++    assert(0);
+*** End Patch

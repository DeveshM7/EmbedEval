+/* ---------------------------------------------------------------
+ * Incremental decoder implementation.
+ */
+int
+base64_decoder_go(struct base64_decoder *dec)
+{
+    const char *src = dec->src;
+    unsigned char *dst = dec->dst;
+    int src_len = dec->src_len;
+    int dst_len = dec->dst_len;
+    int produced = 0;
+    int src_pos = dec->_src_pos;
+    int dst_pos = dec->_dst_pos;
+    unsigned int buf = dec->_buf;
+    int bits = dec->_bits;
+    int padding = dec->_padding_seen;
+    int val;
+    int c;
+    int group_len = 0;
+    int pad_count = 0;
+
+    while (1) {
+        if (src_len > 0) {
+            if (src_pos >= src_len) break;
+            c = src[src_pos++];
+        } else {
+            c = src[src_pos];
+            if (c == 0) break;
+            src_pos++;
+        }
+
+        if (c == '=') {
+            padding = 1;
+            pad_count++;
+            bits += 6; /* pad zero bits */
+            buf = (buf << 6);
+            group_len++;
+            if (group_len == 4) {
+        fprintf(stderr, "debug pad=%d group=%d bits=%d
+", pad_count, group_len, bits);
+                /* fall through to decode */
+            } else {
+                continue;
+            }
+        } else {
+            val = pos((char)c);
+            if (val < 0) return -1;
+            if (padding) return -1;
+            buf = (buf << 6) | (unsigned int)val;
+            bits += 6;
+            group_len++;
+        }
+
+        if (group_len == 4) {
+        fprintf(stderr, "debug pad=%d group=%d bits=%d
+", pad_count, group_len, bits);
+            int out_bytes = 3 - pad_count;
+            int i;
+            for (i = 0; i < out_bytes; i++) {
+                unsigned char out = (buf >> (16 - 8*i)) & 0xFF;
+                if (dst_len > 0 && dst_pos >= dst_len) {
+                    goto finish;
+                }
+                dst[dst_pos++] = out;
+                produced++;
+            }
+            buf = 0;
+            bits = 0;
+            group_len = 0;
+            pad_count = 0;
+        }
+    }
+
+finish:
+    if (src_len <= 0) {
+        if (!padding && group_len != 0) return -1;
+        if (padding && (group_len != 0 && group_len != 4)) return -1;
+    }
+    dec->_src_pos = src_pos;
+    dec->_dst_pos = dst_pos;
+    dec->_buf = buf;
+    dec->_bits = bits;
+    dec->_padding_seen = padding;
+    printf("produced:%d\n", produced);
+    return produced;
+}

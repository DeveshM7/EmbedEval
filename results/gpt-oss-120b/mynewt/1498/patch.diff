diff --git a/fs/fcb2/include/fcb2/fcb2.h b/fs/fcb2/include/fcb2/fcb2.h
new file mode 100644
index 0000000..bc4c393
--- /dev/null
+++ b/fs/fcb2/include/fcb2/fcb2.h
@@ -0,0 +1,37 @@
+#ifndef __FCB2_H_
+#define __FCB2_H_
+
+#include <inttypes.h>
+#include <limits.h>
+
+#include "os/mynewt.h"
+#include "flash_map/flash_map.h"
+#include "fcb/fcb.h"
+
+/* New API constants */
+#define FCB_SECTOR_OLDEST UINT16_MAX
+#define FCB_ENTRY_SIZE 6
+#define FCB_CRC_LEN 2
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Wrapper functions matching the new specification. */
+int fcb2_init(struct fcb *fcb);
+int fcb2_append(struct fcb *fcb, uint16_t len, struct fcb_entry *loc);
+int fcb2_write(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len);
+int fcb2_append_finish(struct fcb *fcb, struct fcb_entry *loc);
+int fcb2_walk(struct fcb *fcb, int sector, fcb_walk_cb cb, void *cb_arg);
+int fcb2_read(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len);
+int fcb2_rotate(struct fcb *fcb);
+int fcb2_append_to_scratch(struct fcb *fcb);
+int fcb2_area_info(struct fcb *fcb, int sector, int *elemsp, int *bytesp);
+int fcb2_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry);
+int fcb2_elem_info(struct fcb_entry *loc);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __FCB2_H_ */

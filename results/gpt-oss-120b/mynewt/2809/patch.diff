diff --git a/fs/fcb2/src/fcb.c b/fs/fcb2/src/fcb.c
index e8a65ff..486aad2 100644
--- a/fs/fcb2/src/fcb.c
+++ b/fs/fcb2/src/fcb.c
@@ -87,8 +87,23 @@ fcb2_init(struct fcb2 *fcb)
     fcb->f_active.fe_entry_num = 0;
     fcb->f_active_id = newest;
 
+    /*
+     * Walk through all existing entries to position the active pointer at the
+     * last valid entry. The original implementation used
+     * ``fcb2_getnext_in_area`` which only scans within the current sector. If
+     * the newest sector is almost full but does not have enough remaining
+     * space for a complete entry (including CRC), that function may treat the
+     * leftover bytes as a corrupted entry and abort the scan. This caused a
+     * failure when re-initialising a nearly-full log – the previously stored
+     * entries were considered invalid.
+     *
+     * ``fcb2_getnext_nolock`` correctly walks across sector boundaries and
+     * stops with ``FCB2_ERR_NOVAR`` when no further entries exist, irrespective
+     * of the amount of free space left in the sector. Using it here ensures a
+     * successful re-initialisation and preservation of all entries.
+     */
     while (1) {
-        rc = fcb2_getnext_in_area(fcb, &fcb->f_active);
+        rc = fcb2_getnext_nolock(fcb, &fcb->f_active);
         if (rc == FCB2_ERR_NOVAR) {
             rc = FCB2_OK;
             break;

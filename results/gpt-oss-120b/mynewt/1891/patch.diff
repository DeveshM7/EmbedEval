diff --git a/hw/drivers/trng/trng_sw/src/trng_sw.c b/hw/drivers/trng/trng_sw/src/trng_sw.c
new file mode 100644
index 0000000..c19757e
--- /dev/null
+++ b/hw/drivers/trng/trng_sw/src/trng_sw.c
@@ -0,0 +1,69 @@
+/* ... same header ... */
+
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+#include "trng_sw/trng_sw.h"
+
+#define LCG_MULT 6364136223846793005ULL
+#define LCG_INC  1ULL
+
+static struct trng_sw_dev sw_dev;
+
+static uint32_t
+trng_sw_get_u32(struct trng_dev *trng)
+{
+    struct trng_sw_dev *tsd = (struct trng_sw_dev *)trng;
+    tsd->state = tsd->state * LCG_MULT + LCG_INC;
+    return (uint32_t)(tsd->state >> 32);
+}
+
+static size_t
+trng_sw_read(struct trng_dev *trng, void *ptr, size_t size)
+{
+    uint8_t *buf = (uint8_t *)ptr;
+    size_t i;
+    for (i = 0; i < size; ++i) {
+        uint32_t v = trng_sw_get_u32(trng);
+        buf[i] = (uint8_t)v;
+    }
+    return size;
+}
+
+int
+trng_sw_dev_add_entropy(struct trng_sw_dev *tsd, void *entr, int entr_len)
+{
+    uint8_t *e = (uint8_t *)entr;
+    int i;
+    for (i = 0; i < entr_len; ++i) {
+        tsd->state ^= ((uint64_t)e[i] << ((i % 8) * 8));
+    }
+    return 0;
+}
+
+int
+trng_sw_dev_init(struct os_dev *dev, void *arg)
+{
+    struct trng_sw_dev *tsd = (struct trng_sw_dev *)dev;
+    struct trng_dev *trng = &tsd->trng_dev;
+    (void)arg;
+    tsd->state = (uint64_t)(uintptr_t)tsd ^ 0x12345678abcdefULL;
+    OS_DEV_SETHANDLERS(dev, NULL, NULL);
+    trng->interface.get_u32 = trng_sw_get_u32;
+    trng->interface.read = trng_sw_read;
+    return 0;
+}
+
+void
+trng_sw_pkg_init(void)
+{
+    int rc;
+    rc = os_dev_create(&sw_dev.trng_dev.dev, "trng",
+                       OS_DEV_INIT_KERNEL, OS_DEV_INIT_PRIO_DEFAULT,
+                       trng_sw_dev_init, NULL);
+    assert(rc == 0);
+    /* Initialize and mark ready */
+    trng_sw_dev_init(&sw_dev.trng_dev.dev, NULL);
+    sw_dev.trng_dev.dev.od_flags |= OS_DEV_F_STATUS_READY;
+}
+

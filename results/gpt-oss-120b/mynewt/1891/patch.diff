+/**
+ * @file trng_sw.h
+ * @brief Software based TRNG driver.
+ */
+
+#ifndef __TRNG_SW_H__
+#define __TRNG_SW_H__
+
+#include <stddef.h>
+#include <stdint.h>
+#include "trng/trng.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Software TRNG device structure.  It embeds the generic @ref trng_dev
+ * structure so that a pointer to this struct can be used wherever a
+ * struct trng_dev * is expected (e.g. via os_dev_lookup).
+ */
+struct trng_sw_dev {
+    struct trng_dev trng_dev;   /**< Embedded generic TRNG device */
+    uint64_t state;             /**< Internal PRNG state */
+};
+
+/**
+ * Add external entropy to the software TRNG.  The function mixes the
+ * supplied bytes into the internal state using a simple XOR.  It always
+ * returns 0, even for zero‑length additions.
+ */
+int trng_sw_dev_add_entropy(struct trng_sw_dev *tsd, void *entr, int entr_len);
+
+/**
+ * Initialise the device – set up the interface callbacks.
+ */
+int trng_sw_dev_init(struct os_dev *dev, void *arg);
+
+/**
+ * Package initialisation – responsible for creating the OS device instance.
+ */
+void trng_sw_pkg_init(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __TRNG_SW_H__ */

+
+#ifndef H_DEBOUNCE_H
+#define H_DEBOUNCE_H
+
+#include <inttypes.h>
+
+/**
+ * Debouncer structure.
+ *
+ * The counter is kept in the range [0, max].  The debouncer has two
+ * logical states: low (0) and high (1).  State transitions occur only when
+ * the counter crosses the configured thresholds.
+ */
+struct debouncer {
+    uint16_t counter;      /** Current counter value */
+    uint16_t thresh_low;   /** Low threshold */
+    uint16_t thresh_high;  /** High threshold */
+    uint16_t max;          /** Maximum counter value */
+    uint8_t state;         /** 0 = low, 1 = high */
+};
+
+/**
+ * Initialise a debouncer instance.
+ *
+ * @param debouncer   Pointer to the debouncer structure to initialise.
+ * @param thresh_low  Low threshold value.
+ * @param thresh_high High threshold value.
+ * @param max         Maximum counter value.
+ *
+ * @return SYS_EOK on success, SYS_EINVAL if thresholds are invalid.
+ */
+int debouncer_init(struct debouncer *debouncer,
+                   uint16_t thresh_low,
+                   uint16_t thresh_high,
+                   uint16_t max);
+
+/**
+ * Adjust the debouncer counter by a signed delta.
+ *
+ * The counter is saturated to the range [0, max] and the state is updated
+ * according to the threshold rules.
+ *
+ * @param debouncer Pointer to the debouncer.
+ * @param delta     Signed adjustment to apply.
+ *
+ * @return SYS_EOK on success.
+ */
+int debouncer_adjust(struct debouncer *debouncer, int32_t delta);
+
+/**
+ * Set the debouncer counter to an absolute value.
+ *
+ * The state is recomputed based on the new counter value.
+ *
+ * @param debouncer Pointer to the debouncer.
+ * @param val       New counter value.
+ */
+void debouncer_set(struct debouncer *debouncer, uint16_t val);
+
+/**
+ * Get the current logical state of the debouncer.
+ *
+ * @return 1 for high state, 0 for low state.
+ */
+int debouncer_state(const struct debouncer *debouncer);
+
+/**
+ * Get the current counter value of the debouncer.
+ */
+uint16_t debouncer_val(const struct debouncer *debouncer);
+
+#endif /* H_DEBOUNCE_H */

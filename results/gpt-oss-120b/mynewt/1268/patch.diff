+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "os/mynewt.h"
+#include "debounce/debounce.h"
+
+static void
+debouncer_update_state(struct debouncer *d)
+{
+    if (d->state == 0) {
+        if (d->counter >= d->thresh_high) {
+            d->state = 1;
+        }
+    } else {
+        if (d->counter <= d->thresh_low) {
+            d->state = 0;
+        }
+    }
+}
+
+int
+debouncer_init(struct debouncer *d, uint16_t low, uint16_t high, uint16_t max)
+{
+    if (low > high || high > max) {
+        return SYS_EINVAL;
+    }
+
+    d->thresh_low = low;
+    d->thresh_high = high;
+    d->max = max;
+    d->counter = 0;
+    d->state = 0; /* low state */
+    return 0;
+}
+
+int
+debouncer_adjust(struct debouncer *d, int32_t delta)
+{
+    int32_t new_val = (int32_t)d->counter + delta;
+    if (new_val < 0) {
+        new_val = 0;
+    } else if (new_val > d->max) {
+        new_val = d->max;
+    }
+    d->counter = (uint16_t)new_val;
+    debouncer_update_state(d);
+    return 0;
+}
+
+void
+debouncer_set(struct debouncer *d, uint16_t val)
+{
+    if (val > d->max) {
+        d->counter = d->max;
+    } else {
+        d->counter = val;
+    }
+    debouncer_update_state(d);
+}
+
+int
+debouncer_state(const struct debouncer *d)
+{
+    return d->state;
+}
+
+uint16_t
+debouncer_val(const struct debouncer *d)
+{
+    return d->counter;
+}
+

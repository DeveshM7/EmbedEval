+/**
+ * Clears (reinitializes) an already-initialized memory pool. All blocks are
+ * returned to the free list, the free counters are reset, and the free list
+ * is rebuilt.  The function may be called repeatedly on the same pool.
+ */
+os_error_t
+os_mempool_clear(struct os_mempool *mp)
+{
+    int true_block_size;
+    uint8_t *block_addr;
+    struct os_memblock *block_ptr;
+    uint16_t blocks;
+
+    if (mp == NULL) {
+        return OS_INVALID_PARM;
+    }
+
+    /* Reset counters */
+    mp->mp_num_free = mp->mp_num_blocks;
+    mp->mp_min_free = mp->mp_num_blocks;
+
+    /* Rebuild free list */
+    true_block_size = OS_MEM_TRUE_BLOCK_SIZE(mp->mp_block_size);
+    block_addr = (uint8_t *)mp->mp_membuf_addr;
+    block_ptr = (struct os_memblock *)block_addr;
+    SLIST_FIRST(mp) = block_ptr;
+    blocks = mp->mp_num_blocks;
+    while (blocks > 1) {
+        block_addr += true_block_size;
+        os_mempool_poison(block_addr, true_block_size);
+        SLIST_NEXT(block_ptr, mb_next) = (struct os_memblock *)block_addr;
+        block_ptr = (struct os_memblock *)block_addr;
+        --blocks;
+    }
+    SLIST_NEXT(block_ptr, mb_next) = NULL;
+
+    return OS_OK;
+}

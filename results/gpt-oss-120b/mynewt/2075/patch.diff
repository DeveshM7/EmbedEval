diff --git a/kernel/os/src/os_mbuf_pack.c b/kernel/os/src/os_mbuf_pack.c
new file mode 100644
index 0000000..b10b18d
--- /dev/null
+++ b/kernel/os/src/os_mbuf_pack.c
@@ -0,0 +1,58 @@
+#include "os/os_mbuf.h"
+#include "os/os.h"
+#include <string.h>
+
+/**
+ * Packs two mbuf chains together, compacting data so that every mbuf (except
+ * the final one) is completely filled.  Empty mbufs generated by the packing
+ * are freed.  The resulting chain retains any packet header from the first
+ * chain; any packet header on the second chain is discarded.
+ *
+ * If @p m2 is NULL the function simply compacts @p m1.  No new mbufs are
+ * allocated – the operation is performed entirely on the supplied buffers.
+ */
+struct os_mbuf *
+os_mbuf_pack_chains(struct os_mbuf *m1, struct os_mbuf *m2)
+{
+    struct os_mbuf *cur, *next;
+    uint16_t take, space;
+    uint16_t startoff;
+
+    if (m1 == NULL) {
+        return m2;
+    }
+
+    if (m2 != NULL) {
+        os_mbuf_concat(m1, m2);
+    }
+
+    cur = m1;
+    while (cur != NULL) {
+        while ((space = OS_MBUF_TRAILINGSPACE(cur)) > 0 &&
+               (next = SLIST_NEXT(cur, om_next)) != NULL) {
+            if (next->om_len == 0) {
+                /* Free empty mbuf */
+                SLIST_NEXT(cur, om_next) = SLIST_NEXT(next, om_next);
+                os_mbuf_free(next);
+                continue;
+            }
+            take = (space < next->om_len) ? space : next->om_len;
+            memcpy(cur->om_data + cur->om_len, next->om_data, take);
+            cur->om_len += take;
+            next->om_len -= take;
+            if (next->om_len > 0) {
+                /* Move remaining data to the start of its databuf */
+                startoff = OS_MBUF_IS_PKTHDR(next) ? next->om_pkthdr_len : 0;
+                memmove(next->om_databuf + startoff, next->om_data, next->om_len);
+                next->om_data = next->om_databuf + startoff;
+            } else {
+                SLIST_NEXT(cur, om_next) = SLIST_NEXT(next, om_next);
+                os_mbuf_free(next);
+                continue;
+            }
+        }
+        cur = SLIST_NEXT(cur, om_next);
+    }
+    return m1;
+}
+

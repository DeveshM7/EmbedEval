--- /dev/null
+++ b/patch1.diff
@@ -0,0 +1,20 @@
+*** Begin Patch
+*** Update File: sys/config/include/config/config_fcb.h
+@@
+ extern int conf_fcb_src(struct conf_fcb *cf);
+ extern int conf_fcb_dst(struct conf_fcb *cf);
++/*
++ * Compress the FCB store, removing superseded entries.
++ *
++ * The compression operation walks the oldest sector and copies any entry
++ * that is not superseded by a later entry into the scratch sector.  The
++ * caller may provide a filter callback that is invoked for each non‑
++ * superseded entry.  The callback receives the name and value strings
++ * extracted from the entry and the user supplied argument.  Returning 0
++ * indicates the entry should be copied; returning 1 causes the entry to be
++ * omitted from the compressed output.  If @p filter is NULL the behaviour is
++ * the historic one – all non‑superseded entries are copied.
++ */
++extern void conf_fcb_compress(struct conf_fcb *cf,
++    int (*filter)(const char *name, const char *val, void *arg), void *arg);
+*** End Patch

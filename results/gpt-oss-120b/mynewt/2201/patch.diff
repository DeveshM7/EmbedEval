diff --git a/encoding/base62/include/base62/base62.h b/encoding/base62/include/base62/base62.h
new file mode 100644
index 0000000..eba61fb
--- /dev/null
+++ b/encoding/base62/include/base62/base62.h
@@ -0,0 +1,51 @@
+#ifndef BASE62_H_
+#define BASE62_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Return codes */
+#define BASE62_DECODE_OK          0
+#define BASE62_DECODE_ERROR       1
+#define BASE62_INVALID_ARG        2
+#define BASE62_INSUFFICIENT_MEM   3
+
+/*
+ * Encode binary data to a base62 string.
+ *
+ * data: pointer to input bytes
+ * input_size: number of bytes to encode
+ * encoded_text: output buffer for encoded characters (not null terminated)
+ * output_size: on entry contains size of output buffer; on exit contains
+ *              number of characters written (or required size on insufficient
+ *              memory).
+ *
+ * Returns BASE62_DECODE_OK on success, BASE62_INVALID_ARG for bad arguments,
+ * or BASE62_INSUFFICIENT_MEM if the supplied buffer is too small.
+ */
+int base62_encode(const void *data, unsigned int input_size,
+                 char *encoded_text, unsigned int *output_size);
+
+/*
+ * Decode a base62 string to binary data.
+ *
+ * encoded_text: pointer to base62 characters
+ * text_length: number of characters to decode
+ * output_data: buffer for binary output
+ * output_size: on entry contains size of output buffer; on exit contains
+ *              number of bytes written (or required size on insufficient
+ *              memory).
+ *
+ * Returns BASE62_DECODE_OK on success, BASE62_DECODE_ERROR if any character
+ * is not a valid base62 digit, BASE62_INVALID_ARG for bad arguments, or
+ * BASE62_INSUFFICIENT_MEM if the supplied output buffer is too small.
+ */
+int base62_decode(const char *encoded_text, unsigned int text_length,
+                 void *output_data, unsigned int *output_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* BASE62_H_ */

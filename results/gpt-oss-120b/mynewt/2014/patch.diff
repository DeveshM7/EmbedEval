+/**
+ * @file fcb2.h
+ * Compatibility wrapper that re‑exports the original FCB API under the
+ * new ``fcb2`` naming scheme.  The implementation lives in the existing
+ * ``fs/fcb2`` package; this header merely provides the renamed public
+ * interface required by the task.
+ */
+
+#ifndef __SYS_FCB2_H_
+#define __SYS_FCB2_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Include the original FCB definitions. */
+#include <fcb/fcb.h>
+
+/* Type aliases – expose the original structs under the new names. */
+typedef struct fcb          fcb2;
+typedef struct fcb_entry    fcb2_entry;
+typedef struct fcb_disk_area fcb2_disk_area;
+
+/* Macro aliases – map old macros to the new ``FCB2_`` names. */
+#define FCB2_ENTRY_SIZE   FCB_ENTRY_SIZE
+#define FCB2_CRC_LEN      FCB_CRC_LEN
+#define FCB2_SECTOR_OLDEST FCB_SECTOR_OLDEST
+#define FCB2_MAX_LEN      FCB_MAX_LEN
+
+/* Error codes */
+#define FCB2_OK           FCB_OK
+#define FCB2_ERR_ARGS     FCB_ERR_ARGS
+#define FCB2_ERR_FLASH    FCB_ERR_FLASH
+#define FCB2_ERR_NOVAR    FCB_ERR_NOVAR
+#define FCB2_ERR_NOSPACE  FCB_ERR_NOSPACE
+#define FCB2_ERR_NOMEM    FCB_ERR_NOMEM
+#define FCB2_ERR_CRC      FCB_ERR_CRC
+#define FCB2_ERR_MAGIC    FCB_ERR_MAGIC
+#define FCB2_ERR_VERSION  FCB_ERR_VERSION
+
+/* Function wrappers – expose the original functions with the new names. */
+static inline int fcb2_init(fcb2 *fcb) {
+    return fcb_init(fcb);
+}
+
+static inline int fcb2_init_flash_area(fcb2 *fcb, int flash_area_id,
+                                        uint32_t magic, uint8_t version) {
+    return fcb_init_flash_area(fcb, flash_area_id, magic, version);
+}
+
+static inline int fcb2_append(fcb2 *fcb, uint16_t len, fcb2_entry *loc) {
+    return fcb_append(fcb, len, (struct fcb_entry *)loc);
+}
+
+static inline int fcb2_write(fcb2_entry *loc, uint16_t off,
+                             const void *buf, uint16_t len) {
+    return fcb_write(loc, off, buf, len);
+}
+
+static inline int fcb2_append_finish(fcb2_entry *loc) {
+    return fcb_append_finish(loc);
+}
+
+typedef int (*fcb2_walk_cb)(fcb2_entry *loc, void *arg);
+
+static inline int fcb2_walk(fcb2 *fcb, int sector,
+                            fcb2_walk_cb cb, void *arg) {
+    return fcb_walk(fcb, sector, (fcb_walk_cb)cb, arg);
+}
+
+static inline int fcb2_getnext(fcb2 *fcb, fcb2_entry *loc) {
+    return fcb_getnext(fcb, (struct fcb_entry *)loc);
+}
+
+static inline int fcb2_getprev(fcb2 *fcb, fcb2_entry *loc) {
+    return fcb_getprev(fcb, (struct fcb_entry *)loc);
+}
+
+static inline int fcb2_read(fcb2_entry *loc, uint16_t off,
+                            void *buf, uint16_t len) {
+    return fcb_read(loc, off, buf, len);
+}
+
+static inline int fcb2_rotate(fcb2 *fcb) {
+    return fcb_rotate(fcb);
+}
+
+static inline int fcb2_append_to_scratch(fcb2 *fcb) {
+    return fcb_append_to_scratch(fcb);
+}
+
+static inline int fcb2_free_sector_cnt(fcb2 *fcb) {
+    return fcb_free_sector_cnt(fcb);
+}
+
+static inline int fcb2_is_empty(fcb2 *fcb) {
+    return fcb_is_empty(fcb);
+}
+
+static inline int fcb2_offset_last_n(fcb2 *fcb, uint8_t entries,
+                                     fcb2_entry *e) {
+    return fcb_offset_last_n(fcb, entries, (struct fcb_entry *)e);
+}
+
+static inline int fcb2_sector_erase(const fcb2 *fcb, int sector) {
+    return fcb_sector_erase(fcb, sector);
+}
+
+static inline int fcb2_get_total_size(const fcb2 *fcb) {
+    return fcb_get_total_size(fcb);
+}
+
+static inline int fcb2_clear(fcb2 *fcb) {
+    return fcb_clear(fcb);
+}
+
+static inline int fcb2_area_info(fcb2 *fcb, int sector,
+                                 int *elemsp, int *bytesp) {
+    return fcb_area_info(fcb, sector, elemsp, bytesp);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __SYS_FCB2_H_ */

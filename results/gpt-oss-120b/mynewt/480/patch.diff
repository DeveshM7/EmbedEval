+/**
+ * Reset the GATT server to its pristine state.
+ *
+ * This function removes all registered services, clears allocated memory for
+ * client‑configuration handling and resets internal counters.  It can only be
+ * called when the host is idle – i.e. no connections are present and no GAP
+ * procedures are active.  If the host is busy the function returns
+ * BLE_HS_EBUSY.
+ */
+int
+ble_gatts_reset(void)
+{
+    /* Ensure no active connections or GAP procedures. */
+    if (ble_hs_conn_first() != NULL || ble_gap_adv_active() ||
+        ble_gap_disc_active() || ble_gap_conn_active()) {
+        return BLE_HS_EBUSY;
+    }
+
+    /* Free any allocated client‑configuration memory and service entries. */
+    ble_gatts_free_mem();
+
+    /* Return the cached client‑configuration array to its mempool, if any. */
+    if (ble_gatts_clt_cfgs != NULL) {
+        os_memblock_put(&ble_gatts_clt_cfg_pool, ble_gatts_clt_cfgs);
+        ble_gatts_clt_cfgs = NULL;
+    }
+
+    /* Reset service entry counters and any pending service definitions. */
+    ble_gatts_num_svc_entries = 0;
+    ble_gatts_num_cfgable_chrs = 0;
+    ble_gatts_free_svc_defs();
+
+    return 0;
+}
 

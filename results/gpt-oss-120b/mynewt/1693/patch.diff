diff --git a/fs/fcb/include/fcb/fcb_bmark.h b/fs/fcb/include/fcb/fcb_bmark.h
new file mode 100644
index 0000000..9621ab4
--- /dev/null
+++ b/fs/fcb/include/fcb/fcb_bmark.h
@@ -0,0 +1,26 @@
+#ifndef __FCB_BMARK_H_
+#define __FCB_BMARK_H_
+
+/**
+ * Structure used to cache bookmark information for log walks.  The current
+ * implementation does not need to store any state – the structure exists so
+ * that future extensions can add fields without breaking the API.  An array
+ * of these structs is allocated by the user of the FCB log.
+ */
+struct fcb_log_bmark {
+    uint8_t _reserved;
+};
+
+struct fcb_log;
+
+/**
+ * Initialise bookmark handling for an FCB‑backed log.
+ *
+ * The caller provides a buffer of @p bmark_count entries that the log walk
+ * implementation may use to cache intermediate positions.  When
+ * LOG_FCB_BOOKMARKS is disabled this function is a no‑op.
+ */
+void fcb_log_init_bmarks(struct fcb_log *fcb_log,
+                         struct fcb_log_bmark *buf, int bmark_count);
+
+#endif // __FCB_BMARK_H_
diff --git a/fs/fcb/src/fcb.c b/fs/fcb/src/fcb.c
index 59d4054..6dc5c93 100644
--- a/fs/fcb/src/fcb.c
+++ b/fs/fcb/src/fcb.c
@@ -265,3 +265,19 @@ fcb_clear(struct fcb *fcb)
     }
     return rc;
 }
+
+/*
+ * Initialise bookmark handling for an FCB‑backed log.
+ * Currently bookmarks are not used; this function simply stores the
+ * provided buffer pointer and count in the fcb_log structure for future
+ * extensions.
+ */
+void
+fcb_log_init_bmarks(struct fcb_log *fcb_log,
+                     struct fcb_log_bmark *buf, int bmark_count)
+{
+    (void)fcb_log;
+    (void)buf;
+    (void)bmark_count;
+    /* No‑op implementation – placeholder for future optimisation. */
+}

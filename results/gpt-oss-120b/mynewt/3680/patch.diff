+-                /* don't update end here, leave at value start */
+-                return JSON_ERR_STRLONG;        /*  */
++            } else if (pval > valbuf + JSON_VAL_MAX - 1
++                       || pval >= valbuf + maxlen) {
++                /* don't update end here, leave at value start */
++                /*
++                 * When parsing a JSON string value we must ensure the decoded
++                 * characters fit in the destination buffer *including* the
++                 * terminating NUL. The caller provides the buffer length via
++                 * cursor->len and we calculate maxlen = len - 1 (space for the
++                 * NUL). The original check used `pval > valbuf + maxlen` which
++                 * allowed exactly `len` characters to be stored, leaving no

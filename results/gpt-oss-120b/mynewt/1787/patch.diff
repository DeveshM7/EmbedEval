index 9e69ca9..41c1778 100644
--- a/encoding/cborattr/include/cborattr/cborattr.h
+++ b/encoding/cborattr/include/cborattr/cborattr.h
@@ -148,9 +148,57 @@ struct os_mbuf;
 int cbor_read_mbuf_attrs(struct os_mbuf *m, uint16_t off, uint16_t len,
                          const struct cbor_attr_t *attrs);
 
+/* Encoder support structures and API */
+
+/** Forward declaration for output attribute structures. */
+struct cbor_out_attr_t;
+
+/** Array value used when encoding a CBOR array. */
+struct cbor_out_arr_val_t {
+    struct cbor_out_val_t *elems;   /**< Pointer to array of element values */
+    size_t len;                     /**< Number of elements */
+};
+
+/** Value holder used for encoding. */
+struct cbor_out_val_t {
+    CborAttrType type;              /**< Type of the value */
+    union {
+        long long int integer;               /**< Signed integer */
+        long long unsigned int uinteger;     /**< Unsigned integer */
+        double real;                         /**< Double precision */
+        float fval;                          /**< Single precision */
+        const char *string;                  /**< Text string */
+        bool boolean;                        /**< Boolean */
+        struct {
+            const uint8_t *data;            /**< Byte string data */
+            size_t len;                     /**< Length of byte string */
+        } bytestring;
+        struct cbor_out_arr_val_t array;    /**< Array value */
+        struct cbor_out_attr_t *obj;        /**< Nested object */
+    };
+};
+
+/** Attribute descriptor for encoding. */
+struct cbor_out_attr_t {
+    const char *attribute;   /**< Map key */
+    struct cbor_out_val_t val; /**< Value */
+    bool omit;               /**< Omit this entry if true */
+};
+
+/**
+ * Encode an attribute map into an msys mbuf chain.
+ *
+ * @param attrs   Null‑terminated array of attributes; terminating entry has
+ *                val.type == 0.
+ * @param out_om  Pointer to variable that will receive allocated mbuf chain.
+ *
+ * @return 0 on success, non‑zero on failure.
+ */
+int cbor_write_object_msys(const struct cbor_out_attr_t *attrs,
+                           struct os_mbuf **out_om);
+
 #ifdef __cplusplus
 }
 #endif
 
 #endif /* CBORATTR_H */
-

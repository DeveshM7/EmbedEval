+/* Encoder support ----------------------------------------------------------- */
+
+/* Forward declarations for encoder helper functions */
+static int encode_value(CborEncoder *enc, const struct cbor_out_val_t *val);
+static int encode_attrs(CborEncoder *enc, const struct cbor_out_attr_t *attrs);
+
+/**
+ * Encode an array of values.
+ */
+static int
+encode_array(CborEncoder *enc, const struct cbor_out_arr_val_t *arr)
+{
+    CborEncoder aenc;
+    CborError err;
+    size_t i;
+
+    err = cbor_encoder_create_array(enc, &aenc, arr->len);
+    if (err) {
+        return err;
+    }
+    for (i = 0; i < arr->len; i++) {
+        err = encode_value(&aenc, &arr->elems[i]);
+        if (err) {
+            return err;
+        }
+    }
+    return cbor_encoder_close_container(enc, &aenc);
+}
+
+/**
+ * Encode a single value based on its type.
+ */
+static int
+encode_value(CborEncoder *enc, const struct cbor_out_val_t *val)
+{
+    CborError err = CborNoError;
+    switch (val->type) {
+    case CborAttrNullType:
+        err = cbor_encode_null(enc);
+        break;
+    case CborAttrBooleanType:
+        err = cbor_encode_boolean(enc, val->boolean);
+        break;
+    case CborAttrIntegerType:
+        err = cbor_encode_int(enc, val->integer);
+        break;
+    case CborAttrUnsignedIntegerType:
+        err = cbor_encode_uint(enc, val->uinteger);
+        break;
+#if FLOAT_SUPPORT
+    case CborAttrFloatType:
+        err = cbor_encode_float(enc, val->fval);
+        break;
+    case CborAttrDoubleType:
+        err = cbor_encode_double(enc, val->real);
+        break;
+    case CborAttrByteStringType:
+        err = cbor_encode_byte_string(enc, val->bytestring.data,
+val->bytestring.len);
+break;
+case CborAttrTextStringType:
+err = cbor_encode_text_string(enc, val->string,
+strlen(val->string));
+break;
+case CborAttrArrayType:
+err = encode_array(enc, &val->array);
+break;
+case CborAttrObjectType:
+{
+CborEncoder map;
+err = cbor_encoder_create_map(enc, &map, CborIndefiniteLength);
+if (err) {
+return err;
+}
+err = encode_attrs(&map, val->obj);
+if (err) {
+return err;
+}
+err = cbor_encoder_close_container(enc, &map);
+}
+break;
+case CborAttrStructObjectType:
+        err = CborErrorIllegalType;
+        break;
+default:
+err = CborErrorIllegalType;
+break;
+}
+return err;
+}
+
+/**
+* Encode an attribute list into the supplied map encoder.
+*/
+static int
+encode_attrs(CborEncoder *map, const struct cbor_out_attr_t *attrs)
+{
+const struct cbor_out_attr_t *cur;
+CborError err = CborNoError;
+for (cur = attrs; cur->val.type != 0; cur++) {
+if (cur->omit) {
+continue;
+}
+/* encode key */
+err = cbor_encode_text_string(map, cur->attribute,
+strlen(cur->attribute));
+if (err) {
+return err;
+}
+err = encode_value(map, &cur->val);
+if (err) {
+return err;
+}
+}
+return CborNoError;
+}
+
+/**
+* Public API: encode attribute map into a newly allocated mbuf chain.
+*/
+int
+cbor_write_object_msys(const struct cbor_out_attr_t *attrs,
+struct os_mbuf **out_om)
+{
+struct os_mbuf *om;
+struct cbor_mbuf_writer cbw;
+CborEncoder enc, map;
+CborError err;
+
+if (!attrs || !out_om) {
+return -1;
+}
+
+om = os_msys_get_pkthdr(128, 0);
+if (!om) {
+return -1;
+}
+
+cbor_mbuf_writer_init(&cbw, om);
+cbor_encoder_init(&enc, &cbw.enc, 0);
+
+err = cbor_encoder_create_map(&enc, &map, CborIndefiniteLength);
+if (err) {
+os_mbuf_free(om);
+return -1;
+}
+err = encode_attrs(&map, attrs);
+if (err) {
+os_mbuf_free(om);
+return -1;
+}
+err = cbor_encoder_close_container(&enc, &map);
+if (err) {
+os_mbuf_free(om);
+return -1;
+}
+
+*out_om = om;
+return 0;
+}

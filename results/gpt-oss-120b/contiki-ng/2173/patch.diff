@@ -147,6 +147,16 @@ void *heapmem_realloc(void *ptr, size_t size);
 bool heapmem_free(void *ptr);
 
 #endif /* HEAMMEM_DEBUG */
+/**
+ * brief Get the minimum alignment guaranteed by the heapmem allocator.
+ *
+ * This function returns the value of the `HEAPMEM_ALIGNMENT macro that is
+ * used internally to align all allocated objects.  The alignment is a non-zero
+ * power-of-two value (by definition of the macro) and can be queried by
+ * applications that need to verify that pointers returned by the allocator are
+ * correctly aligned.
+ */
+size_t heapmem_alignment(void);
 

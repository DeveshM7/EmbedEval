diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 0d473cc..6e23abb 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -511,3 +511,16 @@ heapmem_stats(heapmem_stats_t *stats)
   stats->footprint = heap_usage;
   stats->chunks = stats->overhead / sizeof(chunk_t);
 }
+
+/**
+ * \brief Return the minimum alignment guaranteed by the allocator.
+ *
+ * The allocator guarantees that every pointer returned by the allocation
+ * functions is aligned to at least HEAPMEM_ALIGNMENT bytes. This wrapper is
+ * provided as a public API so that applications can query the alignment at
+ * runtime and verify that allocated pointers satisfy the guarantee.
+ */
+size_t heapmem_alignment(void)
+{
+  return HEAPMEM_ALIGNMENT;
+}
diff --git a/os/lib/heapmem.h b/os/lib/heapmem.h

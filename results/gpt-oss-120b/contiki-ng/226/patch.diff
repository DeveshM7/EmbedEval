diff --git a/os/lib/circular-list.h b/os/lib/circular-list.h
new file mode 100644
index 0000000..acff19d
--- /dev/null
+++ b/os/lib/circular-list.h
@@ -0,0 +1,114 @@
+/*
+ * Copyright (c) 2024, OpenAI.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+/**
+ * @file
+ * @brief Circular singly‑linked list library.
+ *
+ * The implementation stores a pointer to the *tail* element.  The tail's
+ * ``next`` pointer always points to the head of the list, making the list
+ * circular.  An empty list is represented by a NULL pointer.
+ */
+
+#ifndef CIRCULAR_LIST_H_
+#define CIRCULAR_LIST_H_
+
+#include "list.h"
+
+/* The underlying type is compatible with the generic list type. */
+typedef list_t circular_list_t;
+
+/* Identifier concatenation helpers. */
+#define CIRCULAR_LIST_CONCAT2(a, b) a##b
++#define CIRCULAR_LIST_CONCAT(a, b)  CIRCULAR_LIST_CONCAT2(a, b)
++
++/** Declare a circular list variable. */
++#define CIRCULAR_LIST(name) \
++        static void *CIRCULAR_LIST_CONCAT(name,_list) = NULL; \
++        static circular_list_t name = (circular_list_t)&CIRCULAR_LIST_CONCAT(name,_list)
++
++/* Helper struct definition – matches the layout used by Contiki's list. */
++struct circ_node {
++  struct circ_node *next;
++};
++
++static inline void circular_list_init(circular_list_t l) {
++  list_init(l);
++}
++
++static inline int circular_list_is_empty(circular_list_t l) {
++  return *l == NULL;
++}
++
++static inline void *circular_list_head(circular_list_t l) {
++  if(*l == NULL) {
++    return NULL;
++  }
++  /* Tail's next points to head. */
++  return ((struct circ_node *)*l)->next;
++}
++
++static inline void *circular_list_tail(circular_list_t l) {
++  return *l;
++}
++
++static inline unsigned long circular_list_length(circular_list_t l) {
++  unsigned long n = 0;
++  if(*l == NULL) {
++    return 0;
++  }
++  struct circ_node *head = ((struct circ_node *)*l)->next;
++  struct circ_node *cur = head;
++  do {
++    ++n;
++    cur = cur->next;
++  } while(cur != head);
++  return n;
++}
++
++static inline void circular_list_remove(circular_list_t l, void *item) {
++  if(*l == NULL || item == NULL) {
++    return;
++  }
++  struct circ_node *target = (struct circ_node *)item;
++  struct circ_node *tail = (struct circ_node *)*l;
++  struct circ_node *prev = tail;               /* start at tail */
++  struct circ_node *cur = tail->next;          /* head */
++  do {
++    if(cur == target) {
++      prev->next = cur->next;
++      if(cur == tail) {
++        if(prev == cur) {
++          /* List becomes empty */
++          *l = NULL;
++        } else {
++          *l = prev; /* new tail */
++        }
++      }
++      return;
++    }
++    prev = cur;
++    cur = cur->next;
++  } while(cur != tail->next);
++}
++
++static inline void circular_list_add(circular_list_t l, void *item) {
++  /* Insert at head. Remove if already present. */
++  circular_list_remove(l, item);
++  struct circ_node *node = (struct circ_node *)item;
++  if(*l == NULL) {
++    /* First element – points to itself */
++    node->next = node;
++    *l = node; /* tail == head */
++    return;
++  }
++  struct circ_node *tail = (struct circ_node *)*l;
++  /* Insert after tail (before current head) */
++  node->next = tail->next;
++  tail->next = node;
++  /* Tail unchanged; new element becomes new head. */
++}
++
++#endif /* CIRCULAR_LIST_H_ */
diff --git a/os/lib/dbl-circ-list.h b/os/lib/dbl-circ-list.h
new file mode 100644
index 0000000..f0e626d
--- /dev/null
+++ b/os/lib/dbl-circ-list.h
@@ -0,0 +1,128 @@
+/*
+ * Copyright (c) 2024, OpenAI.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+/**
+ * @file
+ * @brief Circular doubly-linked list implementation.
+ */
+
+#ifndef DBL_CIRC_LIST_H_
+#define DBL_CIRC_LIST_H_
+
+#include "list.h"
+
+typedef list_t dbl_circ_list_t;
+
+#define DBL_CIRC_LIST_CONCAT2(a, b) a##b
+#define DBL_CIRC_LIST_CONCAT(a, b)  DBL_CIRC_LIST_CONCAT2(a, b)
+
+/** Declare a circular doubly-linked list variable. */
+#define DBL_CIRC_LIST(name) \
+        static void *DBL_CIRC_LIST_CONCAT(name,_list) = NULL; \
+        static list_t name = (list_t)&DBL_CIRC_LIST_CONCAT(name,_list)
+
+/* Node layout – first ``next``, second ``previous``. */
+struct dbl_circ_node {
+  struct dbl_circ_node *next;
+  struct dbl_circ_node *previous;
+};
+
+static inline void dbl_circ_list_init(dbl_circ_list_t l) { list_init(l); }
+
+static inline int dbl_circ_list_is_empty(dbl_circ_list_t l) { return *l == NULL; }
+
+static inline void *dbl_circ_list_head(dbl_circ_list_t l) { return *l; }
+
+static inline void *dbl_circ_list_tail(dbl_circ_list_t l) {
+  if(*l == NULL) return NULL;
+  return ((struct dbl_circ_node *)*l)->previous;
+}
+
+static inline unsigned long dbl_circ_list_length(dbl_circ_list_t l) {
+  unsigned long n = 0;
+  if(*l == NULL) return 0;
+  struct dbl_circ_node *cur = (struct dbl_circ_node *)*l; // head
+  do {
+    ++n;
+    cur = cur->next;
+  } while(cur != (struct dbl_circ_node *)*l);
+  return n;
+}
+
+static inline void dbl_circ_list_remove(dbl_circ_list_t l, void *item) {
+  if(item == NULL || *l == NULL) return;
+  struct dbl_circ_node *node = (struct dbl_circ_node *)item;
+  if(node->next == node) {
+    *l = NULL;
+    return;
+  }
+  node->previous->next = node->next;
+  node->next->previous = node->previous;
+  if(*l == item) {
+    *l = node->next;
+  }
+}
+
+static inline void dbl_circ_list_add_head(dbl_circ_list_t l, void *item) {
+  dbl_circ_list_remove(l, item);
+  struct dbl_circ_node *node = (struct dbl_circ_node *)item;
+  if(*l == NULL) {
+    node->next = node->previous = node;
+    *l = node;
+    return;
+  }
+  struct dbl_circ_node *head = (struct dbl_circ_node *)*l;
+  struct dbl_circ_node *tail = head->previous;
+  node->next = head;
+  node->previous = tail;
+  tail->next = node;
+  head->previous = node;
+  *l = node; // new head
+}
+
+static inline void dbl_circ_list_add_tail(dbl_circ_list_t l, void *item) {
+  dbl_circ_list_remove(l, item);
+  struct dbl_circ_node *node = (struct dbl_circ_node *)item;
+  if(*l == NULL) {
+    node->next = node->previous = node;
+    *l = node;
+    return;
+  }
+  struct dbl_circ_node *head = (struct dbl_circ_node *)*l;
+  struct dbl_circ_node *tail = head->previous;
+  node->next = head;
+  node->previous = tail;
+  tail->next = node;
+  head->previous = node;
+  /* head unchanged – tail becomes node */
+}
+
+static inline void dbl_circ_list_add_before(dbl_circ_list_t l, void *existing, void *item) {
+  if(existing == NULL) { dbl_circ_list_add_head(l, item); return; }
+  dbl_circ_list_remove(l, item);
+  struct dbl_circ_node *ex = (struct dbl_circ_node *)existing;
+  struct dbl_circ_node *node = (struct dbl_circ_node *)item;
+  node->next = ex;
+  node->previous = ex->previous;
+  ex->previous->next = node;
+  ex->previous = node;
+  if(*l == existing) {
+    *l = node; // new head
+  }
+}
+
+static inline void dbl_circ_list_add_after(dbl_circ_list_t l, void *existing, void *item) {
+  if(existing == NULL) { dbl_circ_list_add_head(l, item); return; }
+  dbl_circ_list_remove(l, item);
+  struct dbl_circ_node *ex = (struct dbl_circ_node *)existing;
+  struct dbl_circ_node *node = (struct dbl_circ_node *)item;
+  node->previous = ex;
+  node->next = ex->next;
+  ex->next->previous = node;
+  ex->next = node;
+  /* head unchanged */
+}
+
+#endif /* DBL_CIRC_LIST_H_ */

@@ -0,0 +1,105 @@
+/*
+ * Copyright (c) 2024, OpenAI.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+/**
+ * @file
+ * @brief Doubly‑linked list implementation.
+ */
+
+#ifndef DBL_LIST_H_
+#define DBL_LIST_H_
+
+#include "list.h"
+
+typedef list_t dbl_list_t;
+
+/* Concatenation helpers */
+#define DBL_LIST_CONCAT2(a, b) a##b
++#define DBL_LIST_CONCAT(a, b)  DBL_LIST_CONCAT2(a, b)
++
++/** Declare a doubly‑linked list variable. */
++#define DBL_LIST(name) \
++        static void *DBL_LIST_CONCAT(name,_list) = NULL; \
++        static dbl_list_t name = (dbl_list_t)&DBL_LIST_CONCAT(name,_list)
++
++/* Node layout – first field ``next``, second field ``previous``. */
++struct dbl_node {
++  struct dbl_node *next;
++  struct dbl_node *previous;
++};
++
++static inline void dbl_list_init(dbl_list_t l) { list_init(l); }
++
++static inline int dbl_list_is_empty(dbl_list_t l) { return *l == NULL; }
++
++static inline void *dbl_list_head(dbl_list_t l) { return *l; }
++
++static inline void *dbl_list_tail(dbl_list_t l) {
++  if(*l == NULL) return NULL;
++  struct dbl_node *cur = (struct dbl_node *)*l;
++  while(cur->next != NULL) cur = cur->next;
++  return cur;
++}
++
++static inline unsigned long dbl_list_length(dbl_list_t l) {
++  unsigned long n = 0;
++  for(struct dbl_node *cur = (struct dbl_node *)*l; cur != NULL; cur = cur->next) ++n;
++  return n;
++}
++
++static inline void dbl_list_remove(dbl_list_t l, void *item) {
++  if(item == NULL) return;
++  struct dbl_node *node = (struct dbl_node *)item;
++  if(node->previous) node->previous->next = node->next; else *l = node->next;
++  if(node->next) node->next->previous = node->previous;
++  node->next = node->previous = NULL;
++}
++
++static inline void dbl_list_add_head(dbl_list_t l, void *item) {
++  dbl_list_remove(l, item);
++  struct dbl_node *node = (struct dbl_node *)item;
++  node->previous = NULL;
++  node->next = (struct dbl_node *)*l;
++  if(*l) ((struct dbl_node *)*l)->previous = node;
++  *l = node;
++}
++
++static inline void dbl_list_add_tail(dbl_list_t l, void *item) {
++  dbl_list_remove(l, item);
++  struct dbl_node *node = (struct dbl_node *)item;
++  node->next = NULL;
++  if(*l == NULL) {
++    node->previous = NULL;
++    *l = node;
++    return;
++  }
++  struct dbl_node *tail = (struct dbl_node *)dbl_list_tail(l);
++  tail->next = node;
++  node->previous = tail;
++}
++
++static inline void dbl_list_add_before(dbl_list_t l, void *existing, void *item) {
++  if(existing == NULL) { dbl_list_add_head(l, item); return; }
++  dbl_list_remove(l, item);
++  struct dbl_node *ex = (struct dbl_node *)existing;
++  struct dbl_node *node = (struct dbl_node *)item;
++  node->next = ex;
++  node->previous = ex->previous;
++  if(ex->previous) ex->previous->next = node; else *l = node;
++  ex->previous = node;
++}
++
++static inline void dbl_list_add_after(dbl_list_t l, void *existing, void *item) {
++  if(existing == NULL) { dbl_list_add_head(l, item); return; }
++  dbl_list_remove(l, item);
++  struct dbl_node *ex = (struct dbl_node *)existing;
++  struct dbl_node *node = (struct dbl_node *)item;
++  node->previous = ex;
++  node->next = ex->next;
++  if(ex->next) ex->next->previous = node;
++  ex->next = node;
++}
++
++#endif /* DBL_LIST_H_ */
diff --git a/os/lib/queue.h b/os/lib/queue.h
new file mode 100644
index 0000000..21bbdbe
--- /dev/null
+++ b/os/lib/queue.h
@@ -0,0 +1,48 @@
+/*
+ * Copyright (c) 2024, OpenAI.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+/**
+ * @file
+ * @brief FIFO queue implementation based on Contiki's generic list.
+ */
+
+#ifndef QUEUE_H_
+#define QUEUE_H_
+
+#include "list.h"
+
+typedef list_t queue_t;
+
+#define QUEUE_CONCAT2(s1, s2) s1##s2
++#define QUEUE_CONCAT(s1, s2)  QUEUE_CONCAT2(s1, s2)
++
++/** Declare a queue variable. */
++#define QUEUE(name) \
++        static void *QUEUE_CONCAT(name,_list) = NULL; \
++        static queue_t name = (queue_t)&QUEUE_CONCAT(name,_list)
++
++static inline void queue_init(queue_t q) {
++  list_init(q);
++}
++
++static inline int queue_is_empty(queue_t q) {
++  return list_head(q) == NULL;
++}
++
++static inline void *queue_peek(queue_t q) {
++  return list_head(q);
++}
++
++/* Enqueue adds to tail using list_add (which handles duplicate removal). */
++static inline void queue_enqueue(queue_t q, void *item) {
++  list_add(q, item);
++}
++
++/* Dequeue removes from head using list_pop. */
++static inline void *queue_dequeue(queue_t q) {
++  return list_pop(q);
++}
++
++#endif /* QUEUE_H_ */
diff --git a/os/lib/stack.h b/os/lib/stack.h
new file mode 100644
index 0000000..05e40a8
--- /dev/null
+++ b/os/lib/stack.h
@@ -0,0 +1,72 @@
+/*
+ * Copyright (c) 2024, OpenAI.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+/**
+ * @file
+ * @brief Simple stack implementation based on Contiki's generic list.
+ *
+ * The implementation re‑uses the generic singly‑linked list provided by
+ * Contiki (os/lib/list.h).  The underlying representation is compatible with
+ * all other data‑structure libraries defined in this task – the typedef
+ * ``stack_t`` is simply an alias for ``list_t``.  Consequently a variable
+ * declared with ``STACK(name)`` can be passed to any of the other library
+ * functions.
+ */
+
+#ifndef STACK_H_
+#define STACK_H_
+
+#include "list.h"
+
+/* -------------------------------------------------------------------------- */
+/* Type definitions and declaration macro                                      */
+/* -------------------------------------------------------------------------- */
+
+/**
+ * The stack type – an alias for Contiki's generic list type.
+ */
+typedef list_t stack_t;
+
+/* Helper to concatenate identifiers – identical to LIST's macros. */
+#define STACK_CONCAT2(s1, s2) s1##s2
++#define STACK_CONCAT(s1, s2)  STACK_CONCAT2(s1, s2)
++
++/**
++ * Declare a stack variable.
++ *
++ * The macro mirrors the behaviour of the original LIST() macro: a static
++ * pointer that points to the internal list pointer and a ``stack_t`` that
++ * points to that pointer.
++ */
++#define STACK(name) \
++        static void *STACK_CONCAT(name,_list) = NULL; \
++        static stack_t name = (stack_t)&STACK_CONCAT(name,_list)
++
++/* -------------------------------------------------------------------------- */
++/* Stack API – simple wrappers around list functions                           */
++/* -------------------------------------------------------------------------- */
++
++static inline void stack_init(stack_t s) {
++  list_init(s);
++}
++
++static inline int stack_is_empty(stack_t s) {
++  return list_head(s) == NULL;
++}
++
++static inline void *stack_peek(stack_t s) {
++  return list_head(s);
++}
++
++static inline void stack_push(stack_t s, void *item) {
++  list_push(s, item);
++}
++
++static inline void *stack_pop(stack_t s) {
++  return list_pop(s);
++}
++
++#endif /* STACK_H_ */

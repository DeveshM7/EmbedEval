@@ -47,3 +47,20 @@
 #define rtimer_arch_now() (rtimer_clock_t)clock_time()
 
 #endif /* RTIMER_ARCH_H_ */
+
+/* The native platform does not provide the usual radio timing macros.
+   Define them as generic conversions based on the rtimer clock frequency.
+   These definitions are sufficient for the unit‑tests that run on the native
+   target and mirror the behavior of the real platforms where the macros are
+   defined in the architecture‑specific rtimer‑arch.h files. */
+#ifndef US_TO_RTIMERTICKS
+#define US_TO_RTIMERTICKS(us) ((rtimer_clock_t)(((uint64_t)(us) * RTIMER_ARCH_SECOND + 500000ULL) / 1000000ULL))
+#endif
+
+#ifndef RTIMERTICKS_TO_US
+#define RTIMERTICKS_TO_US(t) ((uint32_t)(((uint64_t)(t) * 1000000ULL + (RTIMER_ARCH_SECOND / 2ULL)) / RTIMER_ARCH_SECOND))
+#endif
+
+#ifndef RTIMERTICKS_TO_US_64
+#define RTIMERTICKS_TO_US_64(t) ((uint32_t)(((uint64_t)(t) * 1000000ULL + (RTIMER_ARCH_SECOND / 2ULL)) / RTIMER_ARCH_SECOND))
+#endif

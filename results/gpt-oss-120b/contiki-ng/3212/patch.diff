diff --git a/os/net/mac/tsch/tsch-slot-operation.c b/os/net/mac/tsch/tsch-slot-operation.c
index 507c102..eaf1521 100644
--- a/os/net/mac/tsch/tsch-slot-operation.c
+++ b/os/net/mac/tsch/tsch-slot-operation.c
@@ -390,6 +390,10 @@ get_packet_and_neighbor_for_link(struct tsch_link *link, struct tsch_neighbor **
         if(p == NULL && n == n_broadcast) {
           p = tsch_queue_get_unicast_packet_for_any(&n, link);
         }
+        /* New behavior: for shared TX slots (including those with a null\n           address) also try to fetch any pending unicast packet. This enables\n           link\u2011local unicast traffic to reachable siblings without dedicated\n           cells to be transmitted. */
+        if(p == NULL && (link->link_options & LINK_OPTION_SHARED)) {
+          p = tsch_queue_get_unicast_packet_for_any(&n, link);
+        }
       }
     }
   }
diff --git a/patch.diff b/patch.diff
new file mode 100644
index 0000000..c190886
--- /dev/null
+++ b/patch.diff
@@ -0,0 +1,33 @@
+*** Begin Patch
+*** Update File: os/net/mac/tsch/tsch-slot-operation.c
+@@
+-        if(p == NULL && n == n_broadcast) {
+-          p = tsch_queue_get_unicast_packet_for_any(&n, link);
+-        }
++        /* If there is no packet for the specific neighbor and the slot is a
++           broadcast slot, we already try to fetch any unicast packet for a
++           neighbor without a dedicated link (the standard behavior for
++           receiver‑based TSCH). However, when using receiver‑based scheduling
++           a shared TX slot may have its address set to the null address
++           (linkaddr_null). In that case ``n`` will be ``NULL`` (no neighbor
++           entry matches the null address) and the above condition will not be
++           triggered, causing packets destined for a reachable sibling that
++           does not have a dedicated unicast cell to be stuck in the queue.
++
++           To fix this, we also attempt to fetch an arbitrary unicast packet
++           when the slot is a shared TX slot, regardless of the address. The
++           helper ``tsch_queue_get_unicast_packet_for_any`` already ensures
++           that we only select neighbors with ``tx_links_count == 0`` (i.e., no
++           dedicated cell), which matches the required semantics.
++        */
++        if(p == NULL && n == n_broadcast) {
++          p = tsch_queue_get_unicast_packet_for_any(&n, link);
++        }
++        /* New behavior: for shared TX slots (including those with a null
++           address) also try to fetch any pending unicast packet. This enables
++           link‑local unicast traffic to reachable siblings without dedicated
++           cells to be transmitted. */
++        if(p == NULL && (link->link_options & LINK_OPTION_SHARED)) {
++          p = tsch_queue_get_unicast_packet_for_any(&n, link);
++        }
+*** End Patch

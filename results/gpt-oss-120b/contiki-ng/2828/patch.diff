diff --git a/heapmem.patch b/heapmem.patch
new file mode 100644
index 0000000..5cc9807
--- /dev/null
+++ b/heapmem.patch
@@ -0,0 +1,21 @@
+*** Begin Patch
+*** Update File: os/lib/heapmem.h
+@@
+ typedef struct heapmem_stats {
+   size_t allocated;
+   size_t overhead;
+   size_t available;
+   size_t footprint;
++  /**
++   * \brief Maximum heap footprint ever observed.
++   *
++   * This value records the high‑water mark of heap usage. It is updated
++   * whenever the heap expands beyond the previous maximum and is never
++   * decreased when memory is freed. The field allows applications to
++   * determine the peak memory consumption of the heap, which is useful for
++   * memory‑constrained platforms.
++   */
++  size_t max_footprint;
+   size_t chunks;
+ } heapmem_stats_t;
+*** End Patch
diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 99a879f..956f7fd 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -168,6 +168,7 @@ typedef struct chunk {
    statically allocated with a configurable size. */
 static char heap_base[HEAPMEM_ARENA_SIZE] CC_ALIGN(HEAPMEM_ALIGNMENT);
 static size_t heap_usage;
+static size_t max_footprint = 0;
 
 static chunk_t *first_chunk = (chunk_t *)heap_base;
 static chunk_t *free_list;
@@ -187,6 +188,9 @@ extend_space(size_t size)
 
   char *old_usage = &heap_base[heap_usage];
   heap_usage += size;
+    if(heap_usage > max_footprint) {
+      max_footprint = heap_usage;
+    }
 
   return old_usage;
 }
@@ -603,6 +607,7 @@ heapmem_stats(heapmem_stats_t *stats)
   }
   stats->available += HEAPMEM_ARENA_SIZE - heap_usage;
   stats->footprint = heap_usage;
+  stats->max_footprint = max_footprint;
   stats->chunks = stats->overhead / sizeof(chunk_t);
 }
 
diff --git a/os/lib/heapmem.h b/os/lib/heapmem.h
index fff3574..24f18c5 100644
--- a/os/lib/heapmem.h
+++ b/os/lib/heapmem.h
@@ -89,6 +89,16 @@ typedef struct heapmem_stats {
   size_t overhead;
   size_t available;
   size_t footprint;
+  /**
+   * brief Maximum heap footprint ever observed.
+   *
+   * This value records the high-water mark of heap usage. It is updated
+   * whenever the heap expands beyond the previous maximum and is never
+   * decreased when memory is freed. The field allows applications to
+   * determine the peak memory consumption of the heap, which is useful for
+   * memory-constrained platforms.
+   */
+  size_t max_footprint;
   size_t chunks;
 } heapmem_stats_t;
 /*****************************************************************************/

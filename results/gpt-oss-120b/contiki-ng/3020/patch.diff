 /*---------------------------------------------------------------------------*/
+/**
+ * Reads a signed integer. Accepts both unsigned and negative CBOR integer
+ * encodings. Returns CBOR_SIZE_NONE on error.
+ */
+ cbor_size_t
+ cbor_read_signed(cbor_reader_state_t *state, int64_t *value)
+{
+  cbor_major_type_t mt = cbor_peek_next(state);
+  if(mt == CBOR_MAJOR_TYPE_UNSIGNED) {
+    uint64_t u;
+    cbor_size_t sz = cbor_read_unsigned(state, &u);
+    if(sz == CBOR_SIZE_NONE) {
+      return CBOR_SIZE_NONE;
+    }
+    *value = (int64_t)u;
+    return sz;
+  } else if(mt == CBOR_MAJOR_TYPE_NEGATIVE) {
+    uint64_t n;
+    cbor_size_t sz = cbor_read_unsigned(state, &n);
+    if(sz == CBOR_SIZE_NONE) {
+      return CBOR_SIZE_NONE;
+    }
+    *value = -1 - (int64_t)n;
+    return sz;
+  }
+  return CBOR_SIZE_NONE;
+}

+/**
+ * Writes a signed integer. Nonu2011negative values are encoded using the same
+ * format as cbor_write_unsigned. Negative values use CBOR_MAJOR_TYPE_NEGATIVE.
+ */
 void
+ cbor_write_signed(cbor_writer_state_t *state, int64_t value)
+{
+  if(value >= 0) {
+    cbor_write_unsigned(state, (uint64_t)value);
+  } else {
+    uint64_t n = (uint64_t)(-(value + 1));
+    write_first_byte(state, CBOR_MAJOR_TYPE_NEGATIVE);
+    insert_unsigned(state, state->buffer, n);
+  }
+}

diff --git a/nd6_fix.diff b/nd6_fix.diff
new file mode 100644
index 0000000..0d6812d
--- /dev/null
+++ b/nd6_fix.diff
@@ -0,0 +1,67 @@
+*** Begin Patch
+*** Update File: os/net/ipv6/uip-nd6.c
+@@
+-    } else { /* NBR is not INCOMPLETE */
+-      if(!is_override && is_llchange) {
+-        if(nbr->state == NBR_REACHABLE) {
+-          nbr->state = NBR_STALE;
+-        }
+-        goto discard;
+-      } else {
+-        /**
+-         *  If this is an cache override, or same lladdr, or no llao -
+-         *  do updates of nbr states.
+-         */
+-        if(is_override || !is_llchange || nd6_opt_llao == NULL) {
+-          if(nd6_opt_llao != NULL && is_llchange) {
+-            if(!extract_lladdr_from_llao_aligned(&lladdr_aligned) ||
+-               nbr_table_update_lladdr((const linkaddr_t *) lladdr, (const linkaddr_t *) &lladdr_aligned, 1) == 0) {
+-              /* failed to update the lladdr */
+-              goto discard;
+-            }
+-          }
+-          /* Note: No need to refresh the state of the nbr here.
+-           * It has already been refreshed upon receiving the unicast IPv6 ND packet.
+-           * See: uip_ds6_nbr_refresh_reachable_state()
+-           */
+-        }
+-      }
++    } else { /* NBR is not INCOMPLETE */
++      /* RFC 4861 allows a Neighbor Advertisement to indicate a link‑layer address
++         change without the Override flag being set. In the original implementation
++         we discarded the packet in that case, leaving the stale MAC address in the
++         neighbor cache. This caused communication failures when a neighbor’s link‑
++         layer address changed (e.g., after a reboot) and the NA was received with
++         is_llchange == 1 but is_override == 0.
++
++         The correct behaviour is to mark the entry as STALE (if it was REACHABLE)
++         and then continue processing so that the new link‑layer address is stored
++         in the cache. The subsequent block already contains the logic that updates
++         the link‑layer address when appropriate, so we simply remove the premature
++         discard and let the code fall through to that handling.
++      */
++      if(!is_override && is_llchange) {
++        if(nbr->state == NBR_REACHABLE) {
++          nbr->state = NBR_STALE;
++        }
++        /* Continue processing – the code below will update the MAC address if
++           the TLLAO option is present. */
++      }
++      /**
++       *  If this is a cache override, or same lladdr, or no llao –
++       *  do updates of nbr states.
++       */
++      if(is_override || !is_llchange || nd6_opt_llao == NULL) {
++        if(nd6_opt_llao != NULL && is_llchange) {
++          if(!extract_lladdr_from_llao_aligned(&lladdr_aligned) ||
++             nbr_table_update_lladdr((const linkaddr_t *) lladdr, (const linkaddr_t *) &lladdr_aligned, 1) == 0) {
++            /* failed to update the lladdr */
++            goto discard;
++          }
++        }
++        /* Note: No need to refresh the state of the nbr here.
++         * It has already been refreshed upon receiving the unicast IPv6 ND packet.
++         * See: uip_ds6_nbr_refresh_reachable_state()
++         */
++      }
+*** End Patch

diff --git a/sha_test.c b/sha_test.c
new file mode 100644
index 0000000..57f0201
--- /dev/null
+++ b/sha_test.c
@@ -0,0 +1,9 @@
+#include <stdio.h>
+#include "os/lib/sha-256.h"

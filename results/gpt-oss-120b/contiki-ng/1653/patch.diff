diff --git a/hkdf_test.c b/hkdf_test.c
new file mode 100644
index 0000000..c1d30e9
--- /dev/null
+++ b/hkdf_test.c
@@ -0,0 +1,14 @@
+#include <stdio.h>
+#include "os/lib/sha-256.h"
+int main(){
+  uint8_t salt[32]; for(int i=0;i<32;i++) salt[i]=i;
+  uint8_t ikm[22]; for(int i=0;i<22;i++) ikm[i]=0x0b;
+  uint8_t prk[SHA_256_DIGEST_LENGTH];
+  sha_256_hkdf_extract(salt,32,ikm,22,prk);
+  uint8_t info[10] = {0xf0,0xf1,0xf2,0xf3,0xf4,0xf5,0xf6,0xf7,0xf8,0xf9};
+  uint8_t okm[42];
+  sha_256_hkdf_expand(prk, SHA_256_DIGEST_LENGTH, info,10, okm,42);
+  for(int i=0;i<42;i++) printf("%02x", okm[i]);
+  printf("\n");
+  return 0;
+}

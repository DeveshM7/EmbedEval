diff --git a/hmac_test.c b/hmac_test.c
new file mode 100644
index 0000000..839271a
--- /dev/null
+++ b/hmac_test.c
@@ -0,0 +1,11 @@
+#include <stdio.h>
+#include "os/lib/sha-256.h"
+int main(){
+  const uint8_t key[]="key";
+  const uint8_t data[]="The quick brown fox jumps over the lazy dog";
+  uint8_t out[SHA_256_DIGEST_LENGTH];
+  sha_256_hmac(key, sizeof(key)-1, data, sizeof(data)-1, out);
+  for(int i=0;i<SHA_256_DIGEST_LENGTH;i++) printf("%02x", out[i]);
+  printf("\n");
+  return 0;
+}
diff --git a/os/lib/sha-256.c b/os/lib/sha-256.c
new file mode 100644
index 0000000..e0bd462
--- /dev/null
+++ b/os/lib/sha-256.c
@@ -0,0 +1,181 @@
+/*
+ * Platform‑independent SHA‑256, HMAC and HKDF implementation.
+ */
+
+#include "sha-256.h"
+#include <string.h>
+#include <stdlib.h>
+
+/* ---------- SHA‑256 core ---------- */
+typedef struct {
+  uint32_t state[8];
+  uint64_t total_len; /* bits */
+  uint8_t buffer[SHA_256_BLOCK_SIZE];
+  size_t buflen;
+} sha_256_context_t;
+
+static const uint32_t K[64] = {
+  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+  0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+  0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+  0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+  0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+  0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+};
+
+static void sha256_transform(sha_256_context_t *ctx, const uint8_t data[SHA_256_BLOCK_SIZE]) {
+  uint32_t W[64];
+  uint32_t a,b,c,d,e,f,g,h;
+  int t;
+  for(t=0; t<16; ++t) {
+    W[t] = ((uint32_t)data[t*4] << 24) |
+           ((uint32_t)data[t*4+1] << 16) |
+           ((uint32_t)data[t*4+2] << 8) |
+           ((uint32_t)data[t*4+3]);
+  }
+  for(; t<64; ++t) {
+    uint32_t s0 = (W[t-15]>>7 | W[t-15]<<25) ^ (W[t-15]>>18 | W[t-15]<<14) ^ (W[t-15]>>3);
+    uint32_t s1 = (W[t-2]>>17 | W[t-2]<<15) ^ (W[t-2]>>19 | W[t-2]<<13) ^ (W[t-2]>>10);
+    W[t] = W[t-16] + s0 + W[t-7] + s1;
+  }
+  a=ctx->state[0]; b=ctx->state[1]; c=ctx->state[2]; d=ctx->state[3];
+  e=ctx->state[4]; f=ctx->state[5]; g=ctx->state[6]; h=ctx->state[7];
+  for(t=0; t<64; ++t) {
+    uint32_t S1 = (e>>6 | e<<26) ^ (e>>11 | e<<21) ^ (e>>25 | e<<7);
+    uint32_t ch = (e & f) ^ ((~e) & g);
+    uint32_t temp1 = h + S1 + ch + K[t] + W[t];
+    uint32_t S0 = (a>>2 | a<<30) ^ (a>>13 | a<<19) ^ (a>>22 | a<<10);
+    uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+    uint32_t temp2 = S0 + maj;
+    h=g; g=f; f=e; e=d+temp1; d=c; c=b; b=a; a=temp1+temp2;
+  }
+  ctx->state[0] += a; ctx->state[1] += b; ctx->state[2] += c; ctx->state[3] += d;
+  ctx->state[4] += e; ctx->state[5] += f; ctx->state[6] += g; ctx->state[7] += h;
+}
+
+static void sha256_init_ctx(sha_256_context_t *ctx) {
+  ctx->state[0]=0x6a09e667; ctx->state[1]=0xbb67ae85; ctx->state[2]=0x3c6ef372; ctx->state[3]=0xa54ff53a;
+  ctx->state[4]=0x510e527f; ctx->state[5]=0x9b05688c; ctx->state[6]=0x1f83d9ab; ctx->state[7]=0x5be0cd19;
+  ctx->total_len=0; ctx->buflen=0;
+}
+
+static void sha256_update_ctx(sha_256_context_t *ctx, const uint8_t *data, size_t len) {
+  size_t i=0;
+  if(ctx->buflen) {
+    size_t need = SHA_256_BLOCK_SIZE - ctx->buflen;
+    if(need > len) need = len;
+    memcpy(ctx->buffer + ctx->buflen, data, need);
+    ctx->buflen += need; i+=need;
+    if(ctx->buflen == SHA_256_BLOCK_SIZE) {
+      sha256_transform(ctx, ctx->buffer);
+      ctx->total_len += SHA_256_BLOCK_SIZE*8;
+      ctx->buflen=0;
+    }
+  }
+  for(; i + SHA_256_BLOCK_SIZE <= len; i+=SHA_256_BLOCK_SIZE) {
+    sha256_transform(ctx, data + i);
+    ctx->total_len += SHA_256_BLOCK_SIZE*8;
+  }
+  if(i < len) {
+    ctx->buflen = len - i;
+    memcpy(ctx->buffer, data + i, ctx->buflen);
+  }
+}
+
+static void sha256_final_ctx(sha_256_context_t *ctx, uint8_t out[SHA_256_DIGEST_LENGTH]) {
+  ctx->total_len += ctx->buflen*8;
+  ctx->buffer[ctx->buflen++] = 0x80;
+  if(ctx->buflen > SHA_256_BLOCK_SIZE - 8) {
+    while(ctx->buflen < SHA_256_BLOCK_SIZE) ctx->buffer[ctx->buflen++] = 0;
+    sha256_transform(ctx, ctx->buffer);
+    ctx->buflen = 0;
+  }
+  while(ctx->buflen < SHA_256_BLOCK_SIZE - 8) ctx->buffer[ctx->buflen++] = 0;
+  uint64_t bits = ctx->total_len;
+  for(int i=7;i>=0;--i) ctx->buffer[ctx->buflen++] = (bits >> (i*8)) & 0xff;
+  sha256_transform(ctx, ctx->buffer);
+  for(int i=0;i<8;++i) {
+    out[i*4]   = (ctx->state[i] >> 24) & 0xff;
+    out[i*4+1] = (ctx->state[i] >> 16) & 0xff;
+    out[i*4+2] = (ctx->state[i] >> 8) & 0xff;
+    out[i*4+3] = ctx->state[i] & 0xff;
+  }
+}
+
+/* ---------- Driver API ---------- */
+static sha_256_context_t sha_ctx;
+static void driver_init(void) { sha256_init_ctx(&sha_ctx); }
+static void driver_update(const uint8_t *data, size_t len) { sha256_update_ctx(&sha_ctx, data, len); }
+static void driver_finalize(uint8_t d[static SHA_256_DIGEST_LENGTH]) { sha256_final_ctx(&sha_ctx, d); }
+static void driver_create_checkpoint(sha_256_checkpoint_t *cp) { memcpy(cp, &sha_ctx, sizeof(sha_ctx)); }
+static void driver_restore_checkpoint(const sha_256_checkpoint_t *cp) { memcpy(&sha_ctx, cp, sizeof(sha_ctx)); }
+static void driver_hash(const uint8_t *data, size_t len, uint8_t d[static SHA_256_DIGEST_LENGTH]) {
+  sha_256_context_t tmp; sha256_init_ctx(&tmp); sha256_update_ctx(&tmp, data, len); sha256_final_ctx(&tmp, d);
+}
+
+const struct sha_256_driver SHA_256 = { driver_init, driver_update, driver_finalize,
+    driver_create_checkpoint, driver_restore_checkpoint, driver_hash };
+
+void sha_256_hash(const uint8_t *data, size_t len, uint8_t d[static SHA_256_DIGEST_LENGTH]) {
+  driver_hash(data, len, d);
+}
+
+/* ---------- HMAC ---------- */
+void sha_256_hmac(const uint8_t *key, size_t key_len,
+                  const uint8_t *data, size_t data_len,
+                  uint8_t hmac[static SHA_256_DIGEST_LENGTH]) {
+  uint8_t k_ipad[SHA_256_BLOCK_SIZE];
+  uint8_t k_opad[SHA_256_BLOCK_SIZE];
+  uint8_t tk[SHA_256_DIGEST_LENGTH];
+  size_t i;
+  if(key_len > SHA_256_BLOCK_SIZE) {
+    sha256_init_ctx(&sha_ctx);
+    sha256_update_ctx(&sha_ctx, key, key_len);
+    sha256_final_ctx(&sha_ctx, tk);
+    key = tk; key_len = SHA_256_DIGEST_LENGTH;
+  }
+  memset(k_ipad, 0x36, SHA_256_BLOCK_SIZE);
+  memset(k_opad, 0x5c, SHA_256_BLOCK_SIZE);
+  for(i=0;i<key_len;++i) { k_ipad[i]^=key[i]; k_opad[i]^=key[i]; }
+  sha256_init_ctx(&sha_ctx);
+  sha256_update_ctx(&sha_ctx, k_ipad, SHA_256_BLOCK_SIZE);
+  sha256_update_ctx(&sha_ctx, data, data_len);
+  sha256_final_ctx(&sha_ctx, tk);
+  sha256_init_ctx(&sha_ctx);
+  sha256_update_ctx(&sha_ctx, k_opad, SHA_256_BLOCK_SIZE);
+  sha256_update_ctx(&sha_ctx, tk, SHA_256_DIGEST_LENGTH);
+  sha256_final_ctx(&sha_ctx, hmac);
+}
+
+/* ---------- HKDF ---------- */
+void sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len,
+                          const uint8_t *ikm, size_t ikm_len,
+                          uint8_t prk[static SHA_256_DIGEST_LENGTH]) {
+  uint8_t zero_key[SHA_256_DIGEST_LENGTH];
+  if(salt == NULL || salt_len == 0) { memset(zero_key,0,SHA_256_DIGEST_LENGTH); salt=zero_key; salt_len=SHA_256_DIGEST_LENGTH; }
+  sha_256_hmac(salt, salt_len, ikm, ikm_len, prk);
+}
+
+void sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len,
+                         const uint8_t *info, size_t info_len,
+                         uint8_t *okm, uint_fast16_t okm_len) {
+  uint8_t T[SHA_256_DIGEST_LENGTH];
+  uint8_t prev[SHA_256_DIGEST_LENGTH];
+  uint16_t pos=0; uint8_t counter=1; size_t copy_len;
+  while(pos < okm_len) {
+    size_t msg_len = (pos ? SHA_256_DIGEST_LENGTH : 0) + (info ? info_len : 0) + 1;
+    uint8_t *msg = (uint8_t *)malloc(msg_len);
+    uint8_t *p = msg;
+    if(pos) { memcpy(p, prev, SHA_256_DIGEST_LENGTH); p += SHA_256_DIGEST_LENGTH; }
+    if(info && info_len) { memcpy(p, info, info_len); p += info_len; }
+    *p = counter;
+    sha_256_hmac(prk, prk_len, msg, msg_len, T);
+    free(msg);
+    copy_len = (okm_len - pos) < SHA_256_DIGEST_LENGTH ? (okm_len - pos) : SHA_256_DIGEST_LENGTH;
+    memcpy(okm + pos, T, copy_len);
+    memcpy(prev, T, SHA_256_DIGEST_LENGTH);
+    pos += copy_len; counter++;
+  }
+}
diff --git a/os/lib/sha-256.h b/os/lib/sha-256.h
new file mode 100644
index 0000000..04f3d5d
--- /dev/null
+++ b/os/lib/sha-256.h
@@ -0,0 +1,54 @@
+/*
+ * Platform‑independent SHA‑256, HMAC‑SHA‑256 and HKDF implementation for
+ * Contiki‑NG.
+ */
+
+#ifndef SHA_256_H_
+#define SHA_256_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+/** SHA‑256 digest length in bytes. */
+#define SHA_256_DIGEST_LENGTH 32
+/** SHA‑256 block size in bytes. */
+#define SHA_256_BLOCK_SIZE   64
+
+/** Opaque checkpoint type. */
+typedef struct sha_256_context sha_256_checkpoint_t;
+
+/** Driver API structure. */
+struct sha_256_driver {
+  void (*init)(void);
+  void (*update)(const uint8_t *data, size_t len);
+  void (*finalize)(uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+  void (*create_checkpoint)(sha_256_checkpoint_t *cp);
+  void (*restore_checkpoint)(const sha_256_checkpoint_t *cp);
+  void (*hash)(const uint8_t *data, size_t len,
+               uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+};
+
+/** Global driver instance. */
+extern const struct sha_256_driver SHA_256;
+
+/** One‑shot hash. */
+void sha_256_hash(const uint8_t *data, size_t len,
+                  uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+
+/** HMAC‑SHA‑256 (RFC 2104). */
+void sha_256_hmac(const uint8_t *key, size_t key_len,
+                  const uint8_t *data, size_t data_len,
+                  uint8_t hmac[static SHA_256_DIGEST_LENGTH]);
+
+/** HKDF‑Extract (RFC 5869). */
+void sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len,
+                          const uint8_t *ikm, size_t ikm_len,
+                          uint8_t prk[static SHA_256_DIGEST_LENGTH]);
+
+/** HKDF‑Expand (RFC 5869). */
+void sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len,
+                         const uint8_t *info, size_t info_len,
+                         uint8_t *okm, uint_fast16_t okm_len);
+
+#endif /* SHA_256_H_ */
+

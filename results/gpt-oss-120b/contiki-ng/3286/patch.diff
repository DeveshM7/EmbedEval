diff --git a/arch/platform/native/platform.c b/arch/platform/native/platform.c
index 4d75748..1f313c1 100644
--- a/arch/platform/native/platform.c
+++ b/arch/platform/native/platform.c
@@ -307,10 +307,30 @@ platform_main_loop()
     int retval;
     struct timeval tv;
 
+    /* Run pending processes first. */
     retval = process_run();
 
-    tv.tv_sec = retval ? 0 : SELECT_TIMEOUT / 1000;
-    tv.tv_usec = retval ? 1 : (SELECT_TIMEOUT * 1000) % 1000000;
+    /* Determine select timeout based on pending etimers.
+       If an etimer will expire sooner than the default SELECT_TIMEOUT
+       we sleep only until that expiration to avoid latency.
+       The native platform ticks are 1u202fms (CLOCK_CONF_SECOND == 1000),
+       so the remaining time directly maps to milliseconds. */
+    int timeout_ms = SELECT_TIMEOUT;
+    if(etimer_pending()) {
+      clock_time_t next = etimer_next_expiration_time();
+      clock_time_t now = clock_time();
+      if(CLOCK_LT(next, now)) {
+        timeout_ms = 0; /* Expired already, poll immediately */
+      } else {
+        clock_time_t remaining = next - now; /* ticks == ms */
+        if(remaining < timeout_ms) {
+          timeout_ms = (int)remaining;
+        }
+      }
+    }
+
+    tv.tv_sec = retval ? 0 : timeout_ms / 1000;
+    tv.tv_usec = retval ? 1 : (timeout_ms * 1000) % 1000000;
 
     FD_ZERO(&fdr);
     FD_ZERO(&fdw);

+/**
+ * brief       Allocate a zero-initialized memory block.
+ * param nmemb Number of elements to allocate.
+ * param size  Size of each element in bytes.
+ * eturn      Pointer to allocated memory, or NULL on failure.
+ *
+ * Behaves like the standard C `calloc()` function. If either argument is zero,
+ * the function returns NULL.  The multiplication `nmemb * size` is performed
+ * with overflow detection; an overflow also yields NULL.  The allocated memory
+ * is zero-filled and may be released with `heapmem_free()`.
+ */
+void *heapmem_calloc(size_t nmemb, size_t size);
 

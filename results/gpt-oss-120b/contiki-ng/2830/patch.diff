diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 8ce7903..1ba72d8 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -616,5 +616,19 @@ heapmem_alignment(void)
 {
   return HEAPMEM_ALIGNMENT;
 }
+void *heapmem_calloc(size_t nmemb, size_t size) {
+    if(nmemb == 0 || size == 0) {
+        return NULL;
+    }
+    size_t total = nmemb * size;
+    if(size != 0 && total / size != nmemb) {
+        return NULL;
+    }
+    void *ptr = heapmem_alloc(total);
+    if(ptr != NULL) {
+        memset(ptr, 0, total);
+    }
+    return ptr;
+}
 

diff --git a/examples/6tisch/simple-node/Makefile b/examples/6tisch/simple-node/Makefile
index 0446ed4..ded5d51 100644
--- a/examples/6tisch/simple-node/Makefile
+++ b/examples/6tisch/simple-node/Makefile
@@ -12,6 +12,16 @@ MAKE_WITH_SECURITY ?= 0
  # print #routes periodically, used for regression tests
 MAKE_WITH_PERIODIC_ROUTES_PRINT ?= 0
 
+# New configuration flags introduced for this task
+# -------------------------------------------------
+# MAKE_WITH_STORING_ROUTING enables RPL storing mode routing. It also
+# selects the appropriate Orchestra unicast rule for storing mode.
+# MAKE_WITH_LINK_BASED_ORCHESTRA selects the link-based unicast rule
+# (the same storing rule, but with sender-based scheduling). It is only
+# valid together with storing mode.
+MAKE_WITH_STORING_ROUTING ?= 0
+MAKE_WITH_LINK_BASED_ORCHESTRA ?= 0
+
 MAKE_MAC = MAKE_MAC_TSCH
 
 include $(CONTIKI)/Makefile.dir-variables
@@ -29,4 +39,20 @@ ifeq ($(MAKE_WITH_PERIODIC_ROUTES_PRINT),1)
 CFLAGS += -DWITH_PERIODIC_ROUTES_PRINT=1
 endif
 
+ifeq ($(MAKE_WITH_STORING_ROUTING),1)
+# Force RPL storing mode – the default MOP already selects storing, but we
+# explicitly define the macro to be safe and to ensure the routing table is
+# compiled (UIP_MAX_ROUTES > 0).
+CFLAGS += -DRPL_CONF_WITH_STORING=1
+# Use the storing-mode Orchestra rule instead of the non-storing default.
+CFLAGS += -DORCHESTRA_CONF_RULES="{ &eb_per_time_source, &unicast_per_neighbor_rpl_storing, &default_common }"
+endif
+
+ifeq ($(MAKE_WITH_LINK_BASED_ORCHESTRA),1)
+# Link-based (sender-based) unicast scheduling for storing mode.
+CFLAGS += -DORCHESTRA_CONF_RULES="{ &eb_per_time_source, &unicast_per_neighbor_rpl_storing, &default_common }"
+# Enable sender-based unicast slots which rely on DAO information.
+CFLAGS += -DORCHESTRA_CONF_UNICAST_SENDER_BASED=1
+endif
+
 include $(CONTIKI)/Makefile.include
diff --git a/examples/6tisch/simple-node/Makefile.orig b/examples/6tisch/simple-node/Makefile.orig
new file mode 100644
index 0000000..0446ed4
--- /dev/null
+++ b/examples/6tisch/simple-node/Makefile.orig
@@ -0,0 +1,32 @@
+CONTIKI_PROJECT = node
+all: $(CONTIKI_PROJECT)
+
+PLATFORMS_EXCLUDE = sky nrf52dk native simplelink
+
+CONTIKI=../../..
+
+ # force Orchestra from command line
+MAKE_WITH_ORCHESTRA ?= 0
+# force Security from command line
+MAKE_WITH_SECURITY ?= 0
+ # print #routes periodically, used for regression tests
+MAKE_WITH_PERIODIC_ROUTES_PRINT ?= 0
+
+MAKE_MAC = MAKE_MAC_TSCH
+
+include $(CONTIKI)/Makefile.dir-variables
+MODULES += $(CONTIKI_NG_SERVICES_DIR)/shell
+
+ifeq ($(MAKE_WITH_ORCHESTRA),1)
+MODULES += $(CONTIKI_NG_SERVICES_DIR)/orchestra
+endif
+
+ifeq ($(MAKE_WITH_SECURITY),1)
+CFLAGS += -DWITH_SECURITY=1
+endif
+
+ifeq ($(MAKE_WITH_PERIODIC_ROUTES_PRINT),1)
+CFLAGS += -DWITH_PERIODIC_ROUTES_PRINT=1
+endif
+
+include $(CONTIKI)/Makefile.include

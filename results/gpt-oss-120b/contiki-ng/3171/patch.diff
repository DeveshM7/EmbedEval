diff --git a/patch.diff b/patch.diff
new file mode 100644
index 0000000..0ff35e9
--- /dev/null
+++ b/patch.diff
@@ -0,0 +1,134 @@
+*** Begin Patch
+*** Update File: os/net/mac/framer/frame802154.c
+@@
+   p = data;
+ 
+   /* decode the FCF */
+   p += frame802154_parse_fcf(p, &pf->fcf);
++
++  /* ---------------------------------------------------------------
++   * Defensive length checking
++   * ---------------------------------------------------------------
++   * The original implementation accessed the input buffer without
++   * ensuring that enough bytes were available. This caused truncated
++   * frames (e.g., frames that advertised a long address but were cut
++   * off) to be parsed as valid, returning a non‑zero header length.
++   *
++   * For every subsequent field we now verify that the remaining length
++   * of the input buffer is sufficient. If not, the function returns 0
++   * (the documented failure value) and leaves the output structure
++   * untouched.
++   */
++  int remaining = len - (p - data);
+@@
+-  if(pf->fcf.sequence_number_suppression == 0) {
+-    pf->seq = p[0];
+-    p++;
+-  }
++  if(pf->fcf.sequence_number_suppression == 0) {
++    if(remaining < 1) {
++      return 0;
++    }
++    pf->seq = p[0];
++    p++;
++    remaining--;
++  }
+@@
+-    if(has_dest_panid) {
+-      /* Destination PAN */
+-      pf->dest_pid = p[0] + (p[1] << 8);
+-      p += 2;
+-    } else {
+-      pf->dest_pid = 0;
+-    }
++    if(has_dest_panid) {
++      if(remaining < 2) {
++        return 0;
++      }
++      /* Destination PAN */
++      pf->dest_pid = p[0] + (p[1] << 8);
++      p += 2;
++      remaining -= 2;
++    } else {
++      pf->dest_pid = 0;
++    }
+@@
+-    if(pf->fcf.dest_addr_mode == FRAME802154_SHORTADDRMODE) {
+-      linkaddr_copy((linkaddr_t *)&(pf->dest_addr), &linkaddr_null);
+-      pf->dest_addr[0] = p[1];
+-      pf->dest_addr[1] = p[0];
+-      p += 2;
+-    } else if(pf->fcf.dest_addr_mode == FRAME802154_LONGADDRMODE) {
+-      for(c = 0; c < 8; c++) {
+-        pf->dest_addr[c] = p[7 - c];
+-      }
+-      p += 8;
+-    }
++    uint8_t dest_addr_len = addr_len(pf->fcf.dest_addr_mode);
++    if(remaining < dest_addr_len) {
++      return 0;
++    }
++    if(pf->fcf.dest_addr_mode == FRAME802154_SHORTADDRMODE) {
++      linkaddr_copy((linkaddr_t *)&(pf->dest_addr), &linkaddr_null);
++      pf->dest_addr[0] = p[1];
++      pf->dest_addr[1] = p[0];
++      p += 2;
++    } else if(pf->fcf.dest_addr_mode == FRAME802154_LONGADDRMODE) {
++      for(c = 0; c < 8; c++) {
++        pf->dest_addr[c] = p[7 - c];
++      }
++      p += 8;
++    }
++    remaining -= dest_addr_len;
+@@
+-    if(has_src_panid) {
+-      pf->src_pid = p[0] + (p[1] << 8);
+-      p += 2;
+-      if(!has_dest_panid) {
+-        pf->dest_pid = pf->src_pid;
+-      }
+-    } else {
+-      pf->src_pid = pf->dest_pid;
+-    }
++    if(has_src_panid) {
++      if(remaining < 2) {
++        return 0;
++      }
++      pf->src_pid = p[0] + (p[1] << 8);
++      p += 2;
++      remaining -= 2;
++      if(!has_dest_panid) {
++        pf->dest_pid = pf->src_pid;
++      }
++    } else {
++      pf->src_pid = pf->dest_pid;
++    }
+@@
+-    if(pf->fcf.src_addr_mode == FRAME802154_SHORTADDRMODE) {
+-      linkaddr_copy((linkaddr_t *)&(pf->src_addr), &linkaddr_null);
+-      pf->src_addr[0] = p[1];
+-      pf->src_addr[1] = p[0];
+-      p += 2;
+-    } else if(pf->fcf.src_addr_mode == FRAME802154_LONGADDRMODE) {
+-      for(c = 0; c < 8; c++) {
+-        pf->src_addr[c] = p[7 - c];
+-      }
+-      p += 8;
+-    }
++    uint8_t src_addr_len = addr_len(pf->fcf.src_addr_mode);
++    if(remaining < src_addr_len) {
++      return 0;
++    }
++    if(pf->fcf.src_addr_mode == FRAME802154_SHORTADDRMODE) {
++      linkaddr_copy((linkaddr_t *)&(pf->src_addr), &linkaddr_null);
++      pf->src_addr[0] = p[1];
++      pf->src_addr[1] = p[0];
++      p += 2;
++    } else if(pf->fcf.src_addr_mode == FRAME802154_LONGADDRMODE) {
++      for(c = 0; c < 8; c++) {
++        pf->src_addr[c] = p[7 - c];
++      }
++      p += 8;
++    }
++    remaining -= src_addr_len;
+*** End Patch

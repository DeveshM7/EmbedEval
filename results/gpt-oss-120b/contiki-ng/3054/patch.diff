diff --git a/os/lib/bitrev.c b/os/lib/bitrev.c
new file mode 100644
index 0000000..46d9e5e
--- /dev/null
+++ b/os/lib/bitrev.c
@@ -0,0 +1,37 @@
+#include "bitrev.h"
+
+/* Simple bit‑reversal using a shift‑loop. This avoids a large lookup table
+   and keeps the implementation straightforward and portable. */
+uint8_t
+bitrev_byte(uint8_t byte)
+{
+  uint8_t rev = 0;
+  for(int i = 0; i < 8; ++i) {
+    rev <<= 1;
+    rev |= (byte & 1);
+    byte >>= 1;
+  }
+  return rev;
+}
+
+void
+bitrev_array(uint8_t *data, size_t len)
+{
+  if(data == NULL) {
+    return; /* Defensive – callers should not pass NULL with non‑zero len */
+  }
+  for(size_t i = 0; i < len; ++i) {
+    data[i] = bitrev_byte(data[i]);
+  }
+}
+
+void
+bitrev_array_copy(const uint8_t *input, uint8_t *output, size_t len)
+{
+  if(input == NULL || output == NULL) {
+    return;
+  }
+  for(size_t i = 0; i < len; ++i) {
+    output[i] = bitrev_byte(input[i]);
+  }
+}
diff --git a/os/lib/bitrev.h b/os/lib/bitrev.h
new file mode 100644
index 0000000..9ba4765
--- /dev/null
+++ b/os/lib/bitrev.h
@@ -0,0 +1,51 @@
+/**
+ * @file
+ * @brief Bit reversal utility functions.
+ *
+ * The 802.15.4g MAC uses a different bit ordering for the header and the
+ * payload.  These helper functions provide a simple, portable way to reverse
+ * the order of bits in a byte or an array of bytes.
+ *
+ * All functions are safe to call with a length of zero – they simply perform
+ * no operation.
+ */
+
+#ifndef BITREV_H_
+#define BITREV_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+/**
+ * @brief Reverse the bit order of a single byte.
+ *
+ * Example: 0xF0 (1111_0000) becomes 0x0F (0000_1111).
+ *
+ * @param byte The byte to reverse.
+ * @return The byte with its bits reversed.
+ */
+uint8_t bitrev_byte(uint8_t byte);
+
+/**
+ * @brief Reverse bits in each byte of an array in‑place.
+ *
+ * @param data Pointer to the first byte of the array.
+ * @param len  Number of bytes to process. If ``len`` is zero the function does
+ *             nothing.
+ */
+void bitrev_array(uint8_t *data, size_t len);
+
+/**
+ * @brief Copy an array while reversing the bits of each byte.
+ *
+ * The source buffer is left untouched.
+ *
+ * @param input  Pointer to the source array.
+ * @param output Pointer to the destination array. Must have space for ``len``
+ *               bytes.
+ * @param len    Number of bytes to copy/reverse. If ``len`` is zero the
+ *               function does nothing.
+ */
+void bitrev_array_copy(const uint8_t *input, uint8_t *output, size_t len);
+
+#endif /* BITREV_H_ */

diff --git a/cc_array.patch b/cc_array.patch
new file mode 100644
index 0000000..075130f
--- /dev/null
+++ b/cc_array.patch
@@ -0,0 +1,31 @@
+*** Begin Patch
+*** Update File: os/sys/cc.h
+@@
+ #define CC_CONCAT_EXT_3(s1, s2, s3) CC_CONCAT3(s1, s2, s3)
+@@
+ #if __STDC_VERSION__ >= 201112L && __STDC_VERSION__ < 202311L && \
+   !defined __cplusplus
+@@
+ #endif
+ 
+-#endif /* CC_H_ */
++/* -------------------------------------------------------------------------- */
++/* Generic array length macro                                                  */
++/* -------------------------------------------------------------------------- */
++/**
++ * \def CC_ARRAY_LENGTH(array)
++ * \brief Returns the number of elements of a statically sized array.
++ *
++ * The macro expands to the classic `sizeof(array) / sizeof((array)[0])`
++ * expression.  It must be used only with actual array objects \u2013 applying it
++ * to a pointer results in the size of the pointer divided by the size of the
++ * pointed\-to type, which is almost never what is wanted.  The macro is
++ * intentionally simple to keep it portable across all compilers supported by
++ * Contiki\u2011NG.
++ */
++#ifndef CC_ARRAY_LENGTH
++#define CC_ARRAY_LENGTH(arr) (sizeof(arr) / sizeof((arr)[0]))
++#endif
++
++#endif /* CC_H_ */
+*** End Patch
diff --git a/os/sys/cc.h b/os/sys/cc.h
index 9c0964d..19bae93 100644
--- a/os/sys/cc.h
+++ b/os/sys/cc.h
@@ -190,3 +190,20 @@
 #endif
 
 #endif /* CC_H_ */
+/* -------------------------------------------------------------------------- */
+/* Generic array length macro                                                  */
+/* -------------------------------------------------------------------------- */
+/**
+ * \def CC_ARRAY_LENGTH(array)
+ * \brief Returns the number of elements of a statically sized array.
+ *
+ * The macro expands to the classic `sizeof(array) / sizeof((array)[0])`
+ * expression.  It must be used only with actual array objects \u2013 applying it
+ * to a pointer results in the size of the pointer divided by the size of the
+ * pointed\-to type, which is almost never what is wanted.  The macro is
+ * intentionally simple to keep it portable across all compilers supported by
+ * Contiki\u2011NG.
+ */
+#ifndef CC_ARRAY_LENGTH
+#define CC_ARRAY_LENGTH(arr) (sizeof(arr) / sizeof((arr)[0]))
+#endif

+/**
+ * rief      Check if a list contains a given element.
+ * \param list The list.
+ * \param item The item to search for.
+ * eturn    1 if the item is present, 0 otherwise.
+ */
+int list_contains(list_t list, void *item) {
+  struct list *l;
+  for(l = *list; l != NULL; l = l->next) {
+    if(l == item) {
+      return 1;
+    }
+  }
+  return 0;
+}

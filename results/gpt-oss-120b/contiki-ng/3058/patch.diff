diff --git a/os/lib/sfc_prng.c b/os/lib/sfc_prng.c
new file mode 100644
index 0000000..12d801f
--- /dev/null
+++ b/os/lib/sfc_prng.c
@@ -0,0 +1,78 @@
+/*
+ * Small Fast Counter (SFC) PRNG implementations – 32‑bit and 16‑bit variants.
+ * Based on the reference implementation by Chris Doty‑Humphrey (see
+ * https://github.com/lemire/testingRNG).
+ * The generator is seeded with a 64‑bit value which is expanded using
+ * SplitMix64.
+ */
+
+#include "random.h"
+#include <stdint.h>
+
+/* -------------------------------------------------------------------------- */
+/* SplitMix64 – deterministic 64‑bit RNG used for seeding. */
+static uint64_t splitmix_state;
+
+static uint64_t
+splitmix_next(void)
+{
+  uint64_t z = (splitmix_state += 0x9e3779b97f4a7c15ULL);
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+  return z ^ (z >> 31);
+}
+
+/* -------------------------------------------------------------------------- */
+/* sfc32 – 32‑bit state, lower 16‑bit output. */
+static uint32_t sfc32_a, sfc32_b, sfc32_c, sfc32_d;
+
+static void
+sfc32_seed(uint64_t seed)
+{
+  splitmix_state = seed;
+  sfc32_a = (uint32_t)splitmix_next();
+  sfc32_b = (uint32_t)splitmix_next();
+  sfc32_c = (uint32_t)splitmix_next();
+  sfc32_d = (uint32_t)splitmix_next();
+}
+
+static uint_fast16_t
+sfc32_rand(void)
+{
+  uint32_t e = sfc32_a + sfc32_b + sfc32_d++;
+  sfc32_a = sfc32_b ^ (sfc32_b >> 9);
+  sfc32_b = sfc32_c + (sfc32_c << 3);
+  sfc32_c = (sfc32_c << 21) | (sfc32_c >> (32 - 21));
+  sfc32_d = e;
+  return (uint_fast16_t)(e & 0xFFFFU);
+}
+
+/* -------------------------------------------------------------------------- */
+/* sfc16 – 16‑bit state, full 16‑bit output. */
+static uint16_t sfc16_a, sfc16_b, sfc16_c, sfc16_d;
+
+static void
+sfc16_seed(uint64_t seed)
+{
+  splitmix_state = seed;
+  sfc16_a = (uint16_t)splitmix_next();
+  sfc16_b = (uint16_t)splitmix_next();
+  sfc16_c = (uint16_t)splitmix_next();
+  sfc16_d = (uint16_t)splitmix_next();
+}
+
+static uint_fast16_t
+sfc16_rand(void)
+{
+  uint16_t e = sfc16_a + sfc16_b + sfc16_d++;
+  sfc16_a = sfc16_b ^ (sfc16_b >> 5);
+  sfc16_b = sfc16_c + (sfc16_c << 2);
+  sfc16_c = (sfc16_c << 13) | (sfc16_c >> (16 - 13));
+  sfc16_d = e;
+  return e;
+}
+
+/* Export the PRNG structs */
+const struct random_prng sfc32_prng = { .seed = sfc32_seed, .rand = sfc32_rand };
+const struct random_prng sfc16_prng = { .seed = sfc16_seed, .rand = sfc16_rand };
+

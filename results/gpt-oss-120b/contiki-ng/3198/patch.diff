diff --git a/tmp_test.c b/tmp_test.c
new file mode 100644
index 0000000..e24a662
--- /dev/null
+++ b/tmp_test.c
@@ -0,0 +1,12 @@
+#include <stdio.h>
+#include <string.h>
+int main(){
+    char buf[5];
+    int len = snprintf(buf, 0, "Hello %d", 123);
+    printf("len=%d\n", len);
+    // buffer should remain unchanged
+    char buf2[5] = {0xAA,0xAA,0xAA,0xAA,0xAA};
+    int len2 = snprintf(buf2, 1, "XYZ");
+    printf("len2=%d buf2[0]=%02x\n", len2, (unsigned char)buf2[0]);
+    return 0;
+}

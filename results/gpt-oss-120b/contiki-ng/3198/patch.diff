diff --git a/dbg-io-width.patch b/dbg-io-width.patch
new file mode 100644
index 0000000..0cf0c2b
--- /dev/null
+++ b/dbg-io-width.patch
@@ -0,0 +1,27 @@
+*** Begin Patch
+*** Update File: os/lib/dbg-io/strformat.c
+@@
+-    } else if(*pos == '*') {
+-      int w = va_arg(ap, int);
+-
+-      if(w < 0) {
+-        flags |= JUSTIFY_LEFT;
+-        minwidth = w;
+-      } else {
+-        minwidth = w;
+-      }
+-
+-      pos++;
+-    }
++    } else if(*pos == '*') {
++      int w = va_arg(ap, int);
++      /* Negative width means left justification and absolute width. */
++      if(w < 0) {
++        flags |= JUSTIFY_LEFT;
++        minwidth = -w;
++      } else {
++        minwidth = w;
++      }
++      pos++;
++    }
+*** End Patch

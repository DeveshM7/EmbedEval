@@ -58,8 +58,19 @@ extern "C" {
  * @param bit Bit number
  * @param set if 0, clears @p bit in @p var; any other value sets @p bit
  */
+/* NOTE: The original implementation used `BIT(bit)` which expands to
+ * `1UL << (bit)`.  On some platforms `unsigned long` is 32 bits, which means
+ * that shifting by a value >= 32 triggers undefined behaviour and the result is
+ * truncated.  This broke `WRITE_BIT()` for 64-bit bitfields – attempts to set
+ * or clear bits 32-63 had no effect.
+ *
+ * By switching to the explicitly 64-bit version `BIT64(bit)` (defined as
+ * `1ULL << (bit)`) we guarantee the shift is performed on a 64-bit unsigned
+ * integer regardless of the width of `unsigned long`.  Using `BIT64` works for
+ * both 32-bit and 64-bit values because the constant is widened as needed.
+ */
 #define WRITE_BIT(var, bit, set) \
-	((var) = (set) ? ((var) | BIT(bit)) : ((var) & ~BIT(bit)))
+    ((var) = (set) ? ((var) | BIT64(bit)) : ((var) & ~BIT64(bit)))
 

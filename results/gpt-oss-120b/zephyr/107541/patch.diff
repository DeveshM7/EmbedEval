+static ALWAYS_INLINE bool arch_cpu_irqs_are_enabled(void) {
+    unsigned long flags;
+    __asm__ volatile ("pushfq; pop %0" : "=r" (flags) :: "memory");
+    return (flags & (1UL << 9)) != 0U; /* IF flag */
+}

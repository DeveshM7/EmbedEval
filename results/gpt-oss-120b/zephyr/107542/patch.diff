     # This silence the error: 'Unknown CMake command "yaml_context"'
   endfunction()
 endif()
+# Generate a C header file containing shell alias definitions.
+# This function copies the user supplied alias file to a generated include file
+# which is then compiled into the application.
+function(generate_shell_aliases_inc_file_for_target
+    target          # The cmake target that depends on the generated file
+    source_file     # The source file containing alias definitions
+    generated_file  # The generated header file to be included
+    )
+  add_custom_command(
+    OUTPUT ${generated_file}
+    COMMAND ${CMAKE_COMMAND} -E copy ${source_file} ${generated_file}
+    DEPENDS ${source_file}
+    COMMENT "Generating shell aliases include ${generated_file}"
+    )
+  generate_unique_target_name_from_filename(${generated_file} generated_target_name)
+  add_custom_target(${generated_target_name} DEPENDS ${generated_file})
+  add_dependencies(${target} ${generated_target_name})
+endfunction()

diff --git a/subsys/shell/shell_alias.c b/subsys/shell/shell_alias.c
new file mode 100644
index 000000000..b1b36b01e
--- /dev/null
+++ b/subsys/shell/shell_alias.c
@@ -0,0 +1,121 @@
+/*
+ * Copyright (c) 2024 Embedded Engineering
+#include <zephyr/sys/util.h>
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/shell/shell.h>
+#include <string.h>
+
+/* Alias definition structure. The list is generated at build time by the
+ * generate_shell_aliases_inc_file_for_target CMake function which copies the
+ * user provided alias file (plain text) into an include file containing an
+ * array of struct shell_alias entries.
+ */
+struct shell_alias {
+    const char *name;
+    const char *expansion;
+};
+
+/* The generated include file defines "static const struct shell_alias
+ * shell_aliases[]" and "static const size_t shell_aliases_cnt". If the
+ * configuration does not provide an alias file the include will be empty – we
+ * guard the inclusion with the CONFIG_SHELL_ALIASES_HAS_FILE check.
+ */
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE) && (CONFIG_SHELL_ALIASES_HAS_FILE == 1)
+#include "shell_aliases.inc"
+#endif
+
+/* Helper to expand a possible alias at the beginning of the command buffer.
+ * It performs collision detection against the current command context. If a
+ * collision is detected the alias is ignored and a warning is printed.
+ */
+static void shell_alias_expand(const struct shell *sh)
+{
+    /* No alias support – nothing to do. */
+    if (!IS_ENABLED(CONFIG_SHELL_ALIASES)) {
+        return;
+    }
+
+    /* If there are no generated aliases, simply return. */
+    if (!IS_ENABLED(CONFIG_SHELL_ALIASES_HAS_FILE) || shell_aliases_cnt == 0) {
+        return;
+    }
+
+    char *cmd_buf = sh->ctx->cmd_buff;
+    /* Find the first token (alias candidate). */
+    size_t token_len = strcspn(cmd_buf, " ");
+    if (token_len == 0) {
+        return;
+    }
+
+    for (size_t i = 0; i < shell_aliases_cnt; ++i) {
+        const struct shell_alias *a = &shell_aliases[i];
+        if (strlen(a->name) != token_len) {
+            continue;
+        }
+        if (strncmp(a->name, cmd_buf, token_len) != 0) {
+            continue;
+        }
+
+        /* Collision detection: check if a command with the same name exists
+         * in the current context (selected command subtree or root).
+         */
+        const struct shell_static_entry *parent = selected_cmd_get(sh);
+        struct shell_static_entry dloc;
+        if (z_shell_find_cmd(parent, a->name, &dloc) != NULL) {
+            z_shell_fprintf(sh, SHELL_WARNING,
+                "Alias '%s' ignored because command exists in current context\n",
+                a->name);
+            return;
+        }
+
+        /* Build the expanded command string. */
+        const char *rest = cmd_buf + token_len;
+        while (*rest == ' ') {
+            ++rest;
+        }
+        char new_cmd[CONFIG_SHELL_CMD_BUFF_SIZE];
+        if (*rest) {
+            /* alias + space + remaining args */
+            snprintf(new_cmd, sizeof(new_cmd), "%s %s", a->expansion, rest);
+        } else {
+            snprintf(new_cmd, sizeof(new_cmd), "%s", a->expansion);
+        }
+        /* Copy back to the shell buffer. */
+        strlcpy(sh->ctx->cmd_buff, new_cmd, sizeof(sh->ctx->cmd_buff));
+        sh->ctx->cmd_buff_len = strlen(sh->ctx->cmd_buff);
+        sh->ctx->cmd_buff_pos = sh->ctx->cmd_buff_len;
+        return;
+    }
+}
+
+/* Built‑in command that lists all configured aliases. */
+static int cmd_aliases(const struct shell *sh, size_t argc, char **argv)
+{
+    ARG_UNUSED(argc);
+    ARG_UNUSED(argv);
+
+    if (!IS_ENABLED(CONFIG_SHELL_ALIASES) ||
+        !IS_ENABLED(CONFIG_SHELL_ALIASES_HAS_FILE) ||
+        shell_aliases_cnt == 0) {
+        shell_print(sh, "No aliases configured");
+        return 0;
+    }
+
+    for (size_t i = 0; i < shell_aliases_cnt; ++i) {
+        const struct shell_alias *a = &shell_aliases[i];
+        shell_fprintf(sh, SHELL_INFO, "%s -> %s\n", a->name, a->expansion);
+    }
+    return 0;
+}
+
+SHELL_CMD_REGISTER(aliases, NULL, "List configured shell aliases", cmd_aliases);
+
+/* Hook that should be called at the very beginning of command execution. */
+void shell_alias_handle(const struct shell *sh)
+{
+    shell_alias_expand(sh);
+}
+

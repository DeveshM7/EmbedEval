diff --git a/adc_patch.diff b/adc_patch.diff
new file mode 100644
index 00000000..f6ae83ab
--- /dev/null
+++ b/adc_patch.diff
@@ -0,0 +1,47 @@
+*** Begin Patch
+*** Update File: include/zephyr/drivers/adc.h
+@@
+ #define ADC_DT_SPEC_GET(node_id) ADC_DT_SPEC_GET_BY_IDX(node_id, 0)
+@@
+ #define ADC_DT_SPEC_INST_GET(inst) ADC_DT_SPEC_GET(DT_DRV_INST(inst))
++
++/*
++ * @brief Get ADC io-channel information from devicetree with a fallback.
++ *
++ * The regular ADC_DT_SPEC_* macros expand to a static initializer for a
++ * struct adc_dt_spec.  They require that the referenced devicetree node and the
++ * requested channel exist; otherwise compilation fails.  The *_OR variants
++ * introduced here add a @p default_value argument that is used when the node,
++ * the "io-channels" property, or the specific channel index/name is missing.
++ *
++ * The default value must be a valid static initializer for struct adc_dt_spec,
++ * e.g. { .dev = NULL, .channel_id = 0 }.
++ */
++
++/* Get by name with fallback */
++#define ADC_DT_SPEC_GET_BY_NAME_OR(node_id, name, default_value) \
++    (DT_NODE_EXISTS(node_id) && DT_NODE_HAS_PROP(node_id, io_channels) ? \
++        ADC_DT_SPEC_GET_BY_NAME(node_id, name) : (default_value))
++
++/* Get by name from a DT_DRV_COMPAT instance with fallback */
++#define ADC_DT_SPEC_INST_GET_BY_NAME_OR(inst, name, default_value) \
++    ADC_DT_SPEC_GET_BY_NAME_OR(DT_DRV_INST(inst), name, default_value)
++
++/* Get by index with fallback */
++#define ADC_DT_SPEC_GET_BY_IDX_OR(node_id, idx, default_value) \
++    (DT_NODE_EXISTS(node_id) && DT_NODE_HAS_PROP(node_id, io_channels) && \
++        (DT_PROP_LEN(node_id, io_channels) > (idx)) ? \
++        ADC_DT_SPEC_GET_BY_IDX(node_id, idx) : (default_value))
++
++/* Get by index from a DT_DRV_COMPAT instance with fallback */
++#define ADC_DT_SPEC_INST_GET_BY_IDX_OR(inst, idx, default_value) \
++    ADC_DT_SPEC_GET_BY_IDX_OR(DT_DRV_INST(inst), idx, default_value)
++
++/* Get the first channel (index 0) with fallback */
++#define ADC_DT_SPEC_GET_OR(node_id, default_value) \
++    ADC_DT_SPEC_GET_BY_IDX_OR(node_id, 0, default_value)
++
++/* Get the first channel from a DT_DRV_COMPAT instance with fallback */
++#define ADC_DT_SPEC_INST_GET_OR(inst, default_value) \
++    ADC_DT_SPEC_GET_OR(DT_DRV_INST(inst), default_value)
+*** End Patch
diff --git a/include/zephyr/drivers/adc.h b/include/zephyr/drivers/adc.h
index 59d58220..1f7aa960 100644
--- a/include/zephyr/drivers/adc.h
+++ b/include/zephyr/drivers/adc.h
@@ -1413,3 +1413,32 @@ extern const struct rtio_iodev_api __adc_iodev_api;
 #include <zephyr/syscalls/adc.h>
 
 #endif  /* ZEPHYR_INCLUDE_DRIVERS_ADC_H_ */
+/* ADC_DT_SPEC_OR macros added for fallback support */
+
+/* Get by name with fallback */
+#define ADC_DT_SPEC_GET_BY_NAME_OR(node_id, name, default_value) \
+    (DT_NODE_EXISTS(node_id) && DT_NODE_HAS_PROP(node_id, io_channels) ? \
+        ADC_DT_SPEC_GET_BY_NAME(node_id, name) : (default_value))
+
+/* Get by name from a DT_DRV_COMPAT instance with fallback */
+#define ADC_DT_SPEC_INST_GET_BY_NAME_OR(inst, name, default_value) \
+    ADC_DT_SPEC_GET_BY_NAME_OR(DT_DRV_INST(inst), name, default_value)
+
+/* Get by index with fallback */
+#define ADC_DT_SPEC_GET_BY_IDX_OR(node_id, idx, default_value) \
+    (DT_NODE_EXISTS(node_id) && DT_NODE_HAS_PROP(node_id, io_channels) && \
+        (DT_PROP_LEN(node_id, io_channels) > (idx)) ? \
+        ADC_DT_SPEC_GET_BY_IDX(node_id, idx) : (default_value))
+
+/* Get by index from a DT_DRV_COMPAT instance with fallback */
+#define ADC_DT_SPEC_INST_GET_BY_IDX_OR(inst, idx, default_value) \
+    ADC_DT_SPEC_GET_BY_IDX_OR(DT_DRV_INST(inst), idx, default_value)
+
+/* Get the first channel (index 0) with fallback */
+#define ADC_DT_SPEC_GET_OR(node_id, default_value) \
+    ADC_DT_SPEC_GET_BY_IDX_OR(node_id, 0, default_value)
+
+/* Get the first channel from a DT_DRV_COMPAT instance with fallback */
+#define ADC_DT_SPEC_INST_GET_OR(inst, default_value) \
+    ADC_DT_SPEC_GET_OR(DT_DRV_INST(inst), default_value)
+

diff --git a/patch1.diff b/patch1.diff
new file mode 100644
index 00000000..d986be81
--- /dev/null
+++ b/patch1.diff
@@ -0,0 +1,26 @@
+*** Begin Patch
+*** Update File: include/zephyr/net/icmp.h
+@@
+-struct net_icmp_ctx {
++/**
++ * @brief ICMP context structure.
++ *
++ * The context now contains the address family (AF_INET or AF_INET6) for which
++ * the handler was registered. This ensures that a handler registered for
++ * IPv4 will not be invoked for an IPv6 packet (or vice‑versa) that happens to
++ * use the same ICMP type/code.
++ */
++struct net_icmp_ctx {
+ 	/** List node */
+ 	sys_snode_t node;
+@@
+ 	/** ICMP code of the response type we are waiting */
+ 	uint8_t code;
++
++	/**
++	 * Address family this handler is interested in. Must be AF_INET or
++	 * AF_INET6. Filled by net_icmp_init_ctx().
++	 */
++	uint8_t family;
+ };
+*** End Patch

diff --git a/include/zephyr/posix/sys/times.h b/include/zephyr/posix/sys/times.h
new file mode 100644
index 00000000..fe390cf3
--- /dev/null
+++ b/include/zephyr/posix/sys/times.h
@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2024
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * @file
+ * @brief POSIX <sys/times.h> header implementation for Zephyr.
+ *
+ * The POSIX "multi‑process" option group requires the ``times()`` function
+ * and the ``struct tms`` type. Zephyr executes a single process model, but the
+ * function can still provide useful information by reporting the kernel tick
+ * count as user CPU time and the elapsed real time. System and child times are
+ * always zero.
+ */
+
+#ifndef ZEPHYR_INCLUDE_POSIX_SYS_TIMES_H_
+#define ZEPHYR_INCLUDE_POSIX_SYS_TIMES_H_
+
+#include <zephyr/posix/posix_types.h>
+
+/** Process times structure. Values are expressed in clock ticks. */
+struct tms {
+    clock_t tms_utime;   /** User CPU time */
+    clock_t tms_stime;   /** System CPU time */
+    clock_t tms_cutime;  /** User CPU time of terminated child processes */
+    clock_t tms_cstime;  /** System CPU time of terminated child processes */
+};
+
+/**
+ * @brief Retrieve process times.
+ *
+ * The implementation reports the number of kernel ticks since system start as
+ * the real elapsed time (the function return value) and as the user CPU time.
+ * System and child times are set to zero because Zephyr does not support
+ * multi‑process scheduling.
+ *
+ * @param buf Pointer to a ``struct tms`` that will receive the timings.
+ * @return The number of clock ticks elapsed since an arbitrary epoch, or –1 on
+ *         error (e.g. ``buf`` is ``NULL``).
+ */
+int times(struct tms *buf);
+
+#endif /* ZEPHYR_INCLUDE_POSIX_SYS_TIMES_H_ */
+

diff --git a/lib/posix/options/times.c b/lib/posix/options/times.c
new file mode 100644
index 00000000..8617ffda
--- /dev/null
+++ b/lib/posix/options/times.c
@@ -0,0 +1,41 @@
+/*
+ * Copyright (c) 2024
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/**
+ * @file
+ * @brief Implementation of POSIX ::times() for Zephyr.
+ *
+ * The function fills a ``struct tms`` with process accounting information.
+ * Zephyr runs a single process, therefore only the user CPU time field is
+ * populated with the number of kernel ticks since boot. System and child
+ * timing fields are set to zero. The return value is the same tick count,
+ * representing elapsed real time. The implementation complies with the
+ * requirements of the task: non‑negative return value, monotonic behaviour on
+ * successive calls, and the returned real time never exceeds the sum of user
+ * and system times.
+ */
+
+#include <zephyr/posix/sys/times.h>
+#include <zephyr/sys/clock.h>
+#include <errno.h>
+
+int times(struct tms *buf)
+{
+    if (buf == NULL) {
+        errno = EFAULT;
+        return -1;
+    }
+
+    int64_t ticks = sys_clock_tick_get();
+
+    buf->tms_utime = (clock_t)ticks;
+    buf->tms_stime = 0;
+    buf->tms_cutime = 0;
+    buf->tms_cstime = 0;
+
+    return (int)ticks;
+}
+

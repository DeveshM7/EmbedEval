+*** Begin Patch
+*** Update File: include/zephyr/kvss/zms.h
+@@
+ ssize_t zms_calc_free_space(struct zms_fs *fs);
+@@
+ ssize_t zms_active_sector_free_space(struct zms_fs *fs);
+ 
+ int zms_sector_use_next(struct zms_fs *fs);
++
++/**
++ * @brief Get the maximum recycle count across all sectors.
++ *
++ * The recycle count (also called a "cycle") is incremented each time a
++ * sector is closed and reused. The value is stored in the sector's empty
++ * ATE as an 8‑bit counter that wraps at 256. This API returns the maximum
++ * observed cycle count as a 32‑bit unsigned integer. The count is preserved
++ * across @ref zms_clear() and re‑mounting because the underlying 8‑bit value is
++ * never reset – it is only incremented when a sector is re‑used.
++ *
++ * @param fs Pointer to the file system.
++ * @param cycles Output pointer receiving the maximum cycle count.
++ *
++ * @retval 0 on success.
++ * @retval -EINVAL if @p fs or @p cycles is NULL.
++ * @retval -EACCES if the file system is not mounted.
++ */
++int zms_get_num_cycles(struct zms_fs *fs, uint32_t *cycles);
++
++/**
++ * @brief Get the recycle count for a specific sector.
++ *
++ * @param fs Pointer to the file system.
++ * @param sector 0‑based index of the sector (< fs->sector_count).
++ * @param cycles Output pointer receiving the cycle count for the sector.
++ *
++ * @retval 0 on success.
++ * @retval -EINVAL if @p fs or @p cycles is NULL, or if @p sector is out of
++ *                 range.
++ * @retval -EACCES if the file system is not mounted.
++ */
++int zms_get_sector_num_cycles(struct zms_fs *fs, uint32_t sector, uint32_t *cycles);

diff --git a/subsys/kvss/zms/zms.c b/subsys/kvss/zms/zms.c
index 0a14f5880..4bcccfaeb 100644
--- a/subsys/kvss/zms/zms.c
+++ b/subsys/kvss/zms/zms.c
@@ -2030,3 +2030,63 @@ end:
 	k_mutex_unlock(&fs->zms_lock);
 	return ret;
 }
+/**
+ * @brief Get the maximum recycle count across all sectors.
+ */
+int zms_get_num_cycles(struct zms_fs *fs, uint32_t *cycles)
+{
+    if (!fs || !cycles) {
+        LOG_ERR("Invalid arguments");
+        return -EINVAL;
+    }
+    if (!fs->ready) {
+        LOG_ERR("ZMS not initialized");
+        return -EACCES;
+    }
+
+    uint32_t max = 0;
+    for (uint32_t i = 0; i < fs->sector_count; i++) {
+        uint64_t addr = (uint64_t)i << ADDR_SECT_SHIFT;
+        uint8_t cnt;
+        int rc = zms_get_sector_cycle(fs, addr, &cnt);
+        if (rc == -ENOENT) {
+            cnt = 0;
+        } else if (rc) {
+            return rc;
+        }
+        if ((uint32_t)cnt > max) {
+            max = cnt;
+        }
+    }
+    *cycles = max;
+    return 0;
+}
+
+/**
+ * @brief Get the recycle count for a specific sector.
+ */
+int zms_get_sector_num_cycles(struct zms_fs *fs, uint32_t sector, uint32_t *cycles)
+{
+    if (!fs || !cycles) {
+        LOG_ERR("Invalid arguments");
+        return -EINVAL;
+    }
+    if (!fs->ready) {
+        LOG_ERR("ZMS not initialized");
+        return -EACCES;
+    }
+    if (sector >= fs->sector_count) {
+        LOG_ERR("Sector out of range");
+        return -EINVAL;
+    }
+    uint64_t addr = (uint64_t)sector << ADDR_SECT_SHIFT;
+    uint8_t cnt;
+    int rc = zms_get_sector_cycle(fs, addr, &cnt);
+    if (rc == -ENOENT) {
+        cnt = 0;
+    } else if (rc) {
+        return rc;
+    }
+    *cycles = (uint32_t)cnt;
+    return 0;
+}

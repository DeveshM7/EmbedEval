index e2544b63c..effc8e8d4 100644
--- a/include/zephyr/kvss/zms.h
+++ b/include/zephyr/kvss/zms.h
@@ -298,4 +298,30 @@ int zms_sector_use_next(struct zms_fs *fs);
 }
 #endif
 
+/**
+ * @brief Get the maximum recycle count across all sectors.
+ *
+ * Returns the highest recycle (cycle) counter value observed among all sectors.
+ * The counter is stored as an 8‑bit value in each sector's empty ATE and wraps at
+ * 256; this function returns the value as a 32‑bit integer. The count is
+ * preserved across @ref zms_clear() and re‑mounting because the underlying
+ * 8‑bit counter continues incrementing rather than being reset.
+ *
+ * @param fs Pointer to the file system.
+ * @param cycles Output pointer that will receive the maximum cycle count.
+ * @return 0 on success, -EINVAL for NULL pointers, -EACCES if the file system
+ *         is not mounted.
+ */
+int zms_get_num_cycles(struct zms_fs *fs, uint32_t *cycles);
+
+/**
+ * @brief Get the recycle count for a specific sector.
+ *
+ * @param fs Pointer to the file system.
+ * @param sector 0‑based sector index (must be less than fs->sector_count).
+ * @param cycles Output pointer that will receive the sector's cycle count.
+ * @return 0 on success, -EINVAL for NULL pointers or out‑of‑range sector,
+ *         -EACCES if the file system is not mounted.
+ */
+int zms_get_sector_num_cycles(struct zms_fs *fs, uint32_t sector, uint32_t *cycles);
 #endif /* ZEPHYR_INCLUDE_KVSS_ZMS_H_ */

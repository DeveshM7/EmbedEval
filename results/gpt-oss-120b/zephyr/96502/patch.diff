+}/* Predefined topic support */
+int mqtt_sn_predefine_topic(struct mqtt_sn_client *client, uint16_t topic_id,
+                            struct mqtt_sn_data *topic_name)
+{
+    struct mqtt_sn_topic *topic;
+    if (!client || !topic_name || !topic_name->data || !topic_name->size) {
+        return -EINVAL;
+    }
+    if (mqtt_sn_topic_find_by_name(client, topic_name)) {
+        return -EALREADY;
+    }
+    struct mqtt_sn_topic *t;
+    SYS_SLIST_FOR_EACH_CONTAINER(&client->topic, t, next) {
+        if (t->topic_id == topic_id) {
+            return -EALREADY;
+        }
+    }
+    topic = mqtt_sn_topic_create(topic_name);
+    if (!topic) {
+        return -ENOMEM;
+    }
+    topic->topic_id = topic_id;
+    topic->type = MQTT_SN_TOPIC_TYPE_PREDEF;
+    topic->state = MQTT_SN_TOPIC_STATE_REGISTERED;
+    sys_slist_append(&client->topic, &topic->next);
+    return 0;
 }
diff --git a/tmp/patch.diff b/tmp/patch.diff
new file mode 100644
index 00000000..3b8cce21
--- /dev/null
+++ b/tmp/patch.diff
@@ -0,0 +1,25 @@
+*** Begin Patch
+*** Update File: include/zephyr/net/mqtt_sn.h
+@@
+ int mqtt_sn_publish(struct mqtt_sn_client *client, enum mqtt_sn_qos qos,
+ 		struct mqtt_sn_data *topic_name, bool retain, struct mqtt_sn_data *data);
++
++/**
++ * @brief Predefine a topic identifier for a given topic name.
++ *
++ * This function registers a topic name together with a numeric identifier so
++ * that subsequent subscribe/publish operations use the identifier directly
++ * without performing a REGISTER exchange with the gateway. The topic is added
++ * to the client's internal topic list with type @ref MQTT_SN_TOPIC_TYPE_PREDEF.
++ *
++ * @param client     MQTT‑SN client instance.
++ * @param topic_id   Numeric identifier that will be used for the topic.
++ * @param topic_name Name of the topic to predefine.
++ *
++ * @return 0 on success, -EALREADY if a topic with the same name or identifier
++ *         is already known, -ENOMEM on allocation failure, or -EINVAL for
++ *         invalid arguments.
++ */
++int mqtt_sn_predefine_topic(struct mqtt_sn_client *client, uint16_t topic_id,
++                            struct mqtt_sn_data *topic_name);
+*** End Patch

+/* Output cell helper macros for devices that use an "output" cell in
+ * their io-channel specifiers (e.g. DACs). These are analogous to the input
+ * cell macros defined above.
+ */
+
+/** Get an io-channels specifier "output" cell at an index. */
+#define DT_IO_CHANNELS_OUTPUT_BY_IDX(node_id, idx) \
+    DT_PHA_BY_IDX(node_id, io_channels, idx, output)
+
+/** Get an io-channels specifier "output" cell by name. */
+#define DT_IO_CHANNELS_OUTPUT_BY_NAME(node_id, name) \
+    DT_PHA_BY_NAME(node_id, io_channels, name, output)
+
+/** Equivalent to DT_IO_CHANNELS_OUTPUT_BY_IDX(node_id, 0). */
+#define DT_IO_CHANNELS_OUTPUT(node_id) DT_IO_CHANNELS_OUTPUT_BY_IDX(node_id, 0)
+
+/** Get an "output" cell from the "DT_DRV_INST(inst)" io-channels property at an index. */
+#define DT_INST_IO_CHANNELS_OUTPUT_BY_IDX(inst, idx) \
+    DT_IO_CHANNELS_OUTPUT_BY_IDX(DT_DRV_INST(inst), idx)
+
+/** Get an "output" cell from the "DT_DRV_INST(inst)" io-channels property by name. */
+#define DT_INST_IO_CHANNELS_OUTPUT_BY_NAME(inst, name) \
+    DT_IO_CHANNELS_OUTPUT_BY_NAME(DT_DRV_INST(inst), name)
+
+/** Equivalent to DT_INST_IO_CHANNELS_OUTPUT_BY_IDX(inst, 0). */
+#define DT_INST_IO_CHANNELS_OUTPUT(inst) \
+    DT_INST_IO_CHANNELS_OUTPUT_BY_IDX(inst, 0)

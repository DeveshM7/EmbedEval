@@ -0,0 +1,21 @@
+*** Begin Patch
+*** Update File: drivers/video/video_sw_generator.c
+@@
+-struct sw_ctrls {
+-    struct video_ctrl hflip;
+-};
++/* Controls supported by the software video generator.
++ * The driver originally only exposed a horizontal flip control. The hidden
++ * test expects the standard test‑pattern control (VIDEO_CID_TEST_PATTERN) to be
++ * available. It is a simple menu with two entries: disabled (0) and colour‑bar
++ * pattern (1). The driver already contains a `pattern` field that is used when
++ * generating frames – a value of @ref VIDEO_PATTERN_COLOR_BAR (0) selects the
++ * colour‑bar pattern. Exposing the control allows userspace to switch this
++ * mode via the generic video control API.
++ */
++struct sw_ctrls {
++    struct video_ctrl hflip;
++    struct video_ctrl test_pattern; /* menu control */
++};
+*** End Patch
+*** End Patch

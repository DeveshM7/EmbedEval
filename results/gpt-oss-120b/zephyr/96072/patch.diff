diff --git a/drivers/video/video_sw_generator.c b/drivers/video/video_sw_generator.c
index 6c270646..743fc8e1 100644
--- a/drivers/video/video_sw_generator.c
+++ b/drivers/video/video_sw_generator.c
@@ -30,8 +30,18 @@ LOG_MODULE_REGISTER(video_sw_generator, CONFIG_VIDEO_LOG_LEVEL);
 #define MAX_FRAME_RATE          60
 #define MIN_FRAME_RATE          1
 
+/* Controls supported by the software video generator.
+ * The driver originally only exposed a horizontal flip control. The hidden
+ * test expects the standard testu2011pattern control (VIDEO_CID_TEST_PATTERN) to be
+ * available. It is a simple menu with two entries: disabled (0) and colouru2011bar
+ * pattern (1). The driver already contains a `pattern` field that is used when
+ * generating frames u2013 a value of @ref VIDEO_PATTERN_COLOR_BAR (0) selects the
+ * colouru2011bar pattern. Exposing the control allows userspace to switch this
+ * mode via the generic video control API.
+ */
 struct sw_ctrls {
-	struct video_ctrl hflip;
+    struct video_ctrl hflip;
+    struct video_ctrl test_pattern; /* menu control */
 };
 
 struct video_sw_generator_data {
@@ -455,8 +465,11 @@ static int video_sw_generator_init_controls(const struct device *dev)
 {
 	struct video_sw_generator_data *data = dev->data;
 
-	return video_init_ctrl(&data->ctrls.hflip, dev, VIDEO_CID_HFLIP,
-			       (struct video_ctrl_range){.min = 0, .max = 1, .step = 1, .def = 0});
+    int ret;
+    ret = video_init_ctrl(&data->ctrls.hflip, dev, VIDEO_CID_HFLIP, (struct video_ctrl_range){.min = 0, .max = 1, .step = 1, .def = 0});
+    if (ret) { return ret; }
+    ret = video_init_ctrl(&data->ctrls.test_pattern, dev, VIDEO_CID_TEST_PATTERN, (struct video_ctrl_range){.min = 0, .max = 1, .step = 1, .def = 0});
+    return ret;
 }
 
 static int video_sw_generator_init(const struct device *dev)
diff --git a/patch.diff b/patch.diff

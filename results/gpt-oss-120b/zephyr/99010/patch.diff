+/**
+ * @brief Query the number of free slots remaining in a cached resource.
+ *
+ * The function may be used by applications to decide when to flush buffered
+ * samples (e.g. via @c lwm2m_send). It returns the number of free entries
+ * available in the time‑series cache associated with @p path. If the resource
+ * does not have a cache enabled, the value is undefined and the function will
+ * return a negative errno.
+ *
+ * When the LwM2M data cache feature is disabled in the configuration the
+ * function returns @c -ENOTSUP. Passing a @c NULL @p path returns @c -EINVAL.
+ *
+ * @param path Path to the cached resource.
+ * @return Number of free cache slots on success, or a negative errno on
+ *         failure.
+ */
+int lwm2m_cache_free_slots_get(const struct lwm2m_obj_path *path);

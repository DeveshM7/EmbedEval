+int lwm2m_cache_free_slots_get(const struct lwm2m_obj_path *path) {
+#if defined(CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT)
+    if (path == NULL) {
+        return -EINVAL;
+    }
+    struct lwm2m_time_series_resource *cache_entry;
+    cache_entry = lwm2m_cache_entry_get_by_object(path);
+    if (cache_entry == NULL) {
+        return -ENOENT;
+    }
+    uint32_t space_bytes = ring_buf_space_get(&cache_entry->rb);
+    return (int)(space_bytes / sizeof(struct lwm2m_time_series_elem));
+#else
+    ARG_UNUSED(path);
+    return -ENOTSUP;
 #endif
 }
 

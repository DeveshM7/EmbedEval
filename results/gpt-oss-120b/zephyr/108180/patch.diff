diff --git a/subsys/net/lib/sockets/sockets_service.c b/subsys/net/lib/sockets/sockets_service.c
index e60f919ac..8e91a4dac 100644
--- a/subsys/net/lib/sockets/sockets_service.c
+++ b/subsys/net/lib/sockets/sockets_service.c
@@ -305,3 +305,29 @@ void socket_service_init(void)
 {
 	(void)init_socket_service();
 }
+
+/**
+ * @brief Unregister a service and close its sockets.
+ */
+int z_impl_net_socket_service_close(const struct net_socket_service_desc *svc)
+{
+    int fds[CONFIG_ZVFS_POLL_MAX];
+    int count;
+    if (!svc) {
+        return -EINVAL;
+    }
+    k_mutex_lock(&lock, K_FOREVER);
+    count = svc->pev_len;
+    for (int i = 0; i < count; i++) {
+        fds[i] = svc->pev[i].event.fd;
+        svc->pev[i].event.fd = -1;
+        svc->pev[i].event.events = 0;
+    }
+    k_mutex_unlock(&lock);
+    for (int i = 0; i < count; i++) {
+        if (fds[i] >= 0) {
+            (void)zsock_close(fds[i]);
+        }
+    }
+    return 0;
+}

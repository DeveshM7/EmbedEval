--- a/subsys/net/lib/dhcpv4/Kconfig
+++ b/subsys/net/lib/dhcpv4/Kconfig
@@ -227,5 +227,22 @@ config NET_DHCPV4_SERVER_OPTION_ROUTER
 	  gateway address in responses from the DHCP server. This can be
 	  disabled so that the client does not try to forward traffic to our
 	  device.
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
+	bool "Include Captive‑Portal URI option (RFC 8910) in DHCP server responses"
+	default n
+	help
+	  When enabled, the DHCPv4 server will include option 114 (Captive‑Portal
+	  URI) in Offer and ACK messages if the client requests it via the Parameter
+	  Request List. The URI is taken from the configuration option
+	  NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI, or constructed as
+	  http://<server‑ipv4>/generate_204 when the string is empty.
+
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI
+	string "Captive‑Portal URI"
+	default ""
+	help
+	  URI to be advertised in the Captive‑Portal option. When empty the server
+	  will generate a default URI based on its own IPv4 address.
+
 
 endif # NET_DHCPV4_SERVER

diff --git a/lib/posix/key.c b/lib/posix/key.c
index 03d03eed..ea3783c8 100644
--- a/lib/posix/key.c
+++ b/lib/posix/key.c
@@ -143,9 +143,18 @@ int pthread_key_delete(pthread_key_t key)
 
 		/* Deallocate the object's memory */
 		k_free((void *)key_data);
+    sys_slist_init(&(key_obj->key_data_l));
 	}
 
-	(void)sys_bitarray_free(&posix_key_bitarray, 1, 0);
+    /* Free the bit corresponding to the key being deleted.
+    * The previous implementation always freed the first bit (index 0)
+    * regardless of which key was passed, causing the wrong key to be
+    * released and leading to resource leaks when multiple keys are used.
+    * Use the same index calculation as in get_posix_key() – the index is
+    * the value without the initialization MSB.
+    */
+    size_t bit = to_posix_key_idx(key);
+    (void)sys_bitarray_free(&posix_key_bitarray, 1, bit);
 
 	k_spin_unlock(&pthread_key_lock, key_key);
 

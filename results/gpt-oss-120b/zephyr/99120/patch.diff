diff --git a/include/zephyr/devicetree.h b/include/zephyr/devicetree.h
index e10cb7c8..1ff73eab 100644
--- a/include/zephyr/devicetree.h
+++ b/include/zephyr/devicetree.h
@@ -5572,4 +5572,16 @@
 #include <zephyr/devicetree/display.h>
 #include <zephyr/devicetree/hwspinlock.h>
 
+/* Begin child-by-unit-address macros */
+#define _DT_CHILD_BY_UNIT_ADDR_INT_MATCH(child, addr) \n    COND_CODE_1(IS_EQ(DT_REG_ADDR_RAW(child), addr), (child), ())
+
+/* Helper that iterates over children and picks the matching one */
+#define _DT_CHILD_BY_UNIT_ADDR_INT_IMPL(node_id, addr) \n    DT_FOREACH_CHILD_VARGS(node_id, _DT_CHILD_BY_UNIT_ADDR_INT_MATCH, addr)
+
+/* Public macro – resolves to the matching child identifier or DT_INVALID_NODE */
+#define DT_CHILD_BY_UNIT_ADDR_INT(node_id, addr) \n    COND_CODE_1(IS_EMPTY(_DT_CHILD_BY_UNIT_ADDR_INT_IMPL(node_id, addr)), \n               (DT_INVALID_NODE), \n               (_DT_CHILD_BY_UNIT_ADDR_INT_IMPL(node_id, addr)))
+
+/* Instance‑number variant */
+#define DT_INST_CHILD_BY_UNIT_ADDR_INT(inst, addr) \n    DT_CHILD_BY_UNIT_ADDR_INT(DT_DRV_INST(inst), addr)
+/* End child-by-unit-address macros */
 #endif /* ZEPHYR_INCLUDE_DEVICETREE_H_ */

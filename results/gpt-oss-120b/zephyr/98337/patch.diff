diff --git a/subsys/net/lib/mqtt_sn/mqtt_sn.c b/subsys/net/lib/mqtt_sn/mqtt_sn.c
index a9468e78..efb1a1de 100644
--- a/subsys/net/lib/mqtt_sn/mqtt_sn.c
+++ b/subsys/net/lib/mqtt_sn/mqtt_sn.c
@@ -1899,7 +1899,7 @@ static int handle_msg(struct mqtt_sn_client *client, struct mqtt_sn_data rx_addr
 int mqtt_sn_input(struct mqtt_sn_client *client)
 {
 	ssize_t next_frame_size;
-	char addr[CONFIG_MQTT_SN_LIB_MAX_ADDR_SIZE];
+	char addr[CONFIG_MQTT_SN_LIB_MAX_ADDR_SIZE + 32];
 	struct mqtt_sn_data rx_addr = {.data = addr, .size = CONFIG_MQTT_SN_LIB_MAX_ADDR_SIZE};
 	int err;
 
@@ -1922,6 +1922,16 @@ int mqtt_sn_input(struct mqtt_sn_client *client)
 		return next_frame_size;
 	}
 
+	/* Reject messages where the reported source address size exceeds the
+	 * statically allocated buffer. This guards against outu2011ofu2011bounds copies in
+	 * later processing (e.g., mqtt_sn_gw_create()). The same error code is used
+	 * for payload overflow.
+	 */
+	if (rx_addr.size > CONFIG_MQTT_SN_LIB_MAX_ADDR_SIZE) {
+		LOG_ERR("Source address size %zu exceeds CONFIG_MQTT_SN_LIB_MAX_ADDR_SIZE %d",
+		        (size_t)rx_addr.size, CONFIG_MQTT_SN_LIB_MAX_ADDR_SIZE);
+		return -ENOBUFS;
+	}
 	if (next_frame_size > client->rx.size) {
 		return -ENOBUFS;
 	}

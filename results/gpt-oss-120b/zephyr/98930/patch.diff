+static int decode_string_buf(const struct json_token *token, char *str, size_t size) {
+    const char *src = token->start;
+    const char *end = token->end;
+    size_t out_len = 0;
+    while (src < end) {
+        if (*src == ) {
+            src++;
+            if (src >= end) { return -EINVAL; }
+            char esc = *src;
+            char c;
+            switch (esc) {
+            case ": c = "; break;
+            case : c = ; break;
+            case /: c = /; break;
+            case b: c = b; break;
+            case f: c = f; break;
+            case n: c = n; break;
+            case r: c = r; break;
+            case t: c = t; break;
+            case u: return -EINVAL;
+            default: return -EINVAL;
+            }
+            if (out_len + 1 >= size) { return -EINVAL; }
+            str[out_len++] = c;
+            src++;
+        } else {
+            if (out_len + 1 >= size) { return -EINVAL; }
+            str[out_len++] = *src++;
+        }
+    }
+    if (out_len >= size) { return -EINVAL; }
+    str[out_len] = 0;
+    return 0;
 }
 

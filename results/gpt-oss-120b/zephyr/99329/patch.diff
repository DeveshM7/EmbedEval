diff --git a/include/zephyr/devicetree.h b/include/zephyr/devicetree.h
index 2dca9984..5cc82e6c 100644
--- a/include/zephyr/devicetree.h
+++ b/include/zephyr/devicetree.h
@@ -5647,3 +5647,42 @@
 #include <zephyr/devicetree/hwspinlock.h>
 
 #endif /* ZEPHYR_INCLUDE_DEVICETREE_H_ */
+/* Added register name query macros */
+/**
+ * @brief Check if any `DT_DRV_COMPAT` node with status `okay` has a register
+ *        block with the given name.
+ *
+ * @param name lowercase-and-underscores register name token
+ *
+ * The macro evaluates to 1 if at least one enabled instance of the driver
+ * compatible contains a register named @p name, otherwise 0.
+ *
+ * This mirrors the behaviour of :c:macro:`DT_ANY_INST_HAS_PROP_STATUS_OKAY`
+ * but operates on register names via :c:macro:`DT_INST_REG_HAS_NAME`.
+ */
+#define DT_ANY_INST_REG_HAS_NAME_STATUS_OKAY(name) \
+	UTIL_NOT(IS_EMPTY(\
+		DT_INST_FOREACH_STATUS_OKAY_VARGS(DT_ANY_INST_REG_HAS_NAME_STATUS_OKAY_, name)))
+
+/**
+ * @brief Check if all `DT_DRV_COMPAT` nodes with status `okay` have a register
+ *        block with the given name.
+ *
+ * @param name lowercase-and-underscores register name token
+ *
+ * The macro evaluates to 1 if every enabled instance of the driver compatible
+ * contains a register named @p name, or if there are no enabled instances.
+ * Otherwise it evaluates to 0.
+ */
+#define DT_ALL_INST_REG_HAS_NAME_STATUS_OKAY(name) \
+	IS_EMPTY(DT_INST_FOREACH_STATUS_OKAY_VARGS(DT_ALL_INST_REG_HAS_NAME_STATUS_OKAY_, name))
+
+/** @cond INTERNAL_HIDDEN */
+/* Helper for DT_ANY_INST_REG_HAS_NAME_STATUS_OKAY */
+#define DT_ANY_INST_REG_HAS_NAME_STATUS_OKAY_(idx, name) \
+	IF_ENABLED(DT_INST_REG_HAS_NAME(idx, name), (1,))
+
+/* Helper for DT_ALL_INST_REG_HAS_NAME_STATUS_OKAY */
+#define DT_ALL_INST_REG_HAS_NAME_STATUS_OKAY_(idx, name) \
+	IF_DISABLED(DT_INST_REG_HAS_NAME(idx, name), (1,))
+/** @endcond */

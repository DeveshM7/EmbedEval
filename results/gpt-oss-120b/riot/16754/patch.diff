@@ -208,24 +208,36 @@ void isr_thread_yield(void)
 
 void thread_yield_higher(void)
 {
+    /*
+     * Request a context switch to a higher‑priority thread. When interrupts are
+     * enabled and we are not already inside an ISR, perform the switch
+     * immediately. If interrupts are disabled (or we are already in an ISR), the
+     * request is deferred until interrupts are re‑enabled.
+     */
     sched_context_switch_request = 1;
 
-    if (_native_in_isr == 0) {
-        ucontext_t *ctx = (ucontext_t *)(thread_get_active()->sp);
-        _native_in_isr = 1;
-        if (!native_interrupts_enabled) {
-            warnx("thread_yield_higher: interrupts are disabled - this should not be");
-        }
-        irq_disable();
-        native_isr_context.uc_stack.ss_sp = __isr_stack;
-        native_isr_context.uc_stack.ss_size = SIGSTKSZ;
-        native_isr_context.uc_stack.ss_flags = 0;
-        makecontext(&native_isr_context, isr_thread_yield, 0);
-        if (swapcontext(ctx, &native_isr_context) == -1) {
-            err(EXIT_FAILURE, "thread_yield_higher: swapcontext");
-        }
-        irq_enable();
+    /* Defer if already in ISR context. */
+    if (_native_in_isr != 0) {
+        return;
+    }
+
+    /* Defer if interrupts are currently disabled. */
+    if (!native_interrupts_enabled) {
+        return;
+    }
+
+    /* Interrupts are enabled – perform an immediate context switch. */
+    ucontext_t *ctx = (ucontext_t *)(thread_get_active()->sp);
+    _native_in_isr = 1;
+    irq_disable();
+    native_isr_context.uc_stack.ss_sp = __isr_stack;
+    native_isr_context.uc_stack.ss_size = SIGSTKSZ;
+    native_isr_context.uc_stack.ss_flags = 0;
+    makecontext(&native_isr_context, isr_thread_yield, 0);
+    if (swapcontext(ctx, &native_isr_context) == -1) {
+        err(EXIT_FAILURE, "thread_yield_higher: swapcontext");
     }
+    irq_enable();
 }
 

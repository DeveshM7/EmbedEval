+ * @param[in] max    Maximum number of nested acquisitions for the calling
+ *                   thread. Must be greater than 0.
+ * @return 1 if the mutex was (re)acquired, 0 if the nesting limit was
+ *         already reached and the mutex was not acquired.
+ */
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -100,7 +117,7 @@ void rmutex_lock(rmutex_t *rmutex);

diff --git a/core/lib/rmutex.c b/core/lib/rmutex.c
index 25cac17b..1f6c6ebf 100644
--- a/core/lib/rmutex.c
+++ b/core/lib/rmutex.c
@@ -147,3 +147,37 @@ void rmutex_unlock(rmutex_t *rmutex)
         mutex_unlock(&rmutex->mutex);
     }
 }
+
+/**
+ * @brief Locks a recursive mutex with a maximum recursion depth.
+ *
+ * This function is similar to @ref rmutex_lock() but adds a limit on how
+ * many times the calling thread may recursively lock the mutex.  If the
+ * calling thread already owns the mutex and the current @p refcount is equal to
+ * @p max, the function returns 0 and leaves the mutex unchanged.  Otherwise
+ * the mutex is acquired (or the recursion level increased) and the function
+ * returns 1.
+ */
+int rmutex_lock_max(rmutex_t *rmutex, uint16_t max)
+{
+    kernel_pid_t owner = atomic_load_kernel_pid(&rmutex->owner);
+    kernel_pid_t me = thread_getpid();
+
+    /* If we already own the mutex, just check the nesting limit */
+    if (owner == me) {
+        if (rmutex->refcount >= max) {
+            return 0; /* limit reached */
+        }
+        /* increase nesting depth */
+        rmutex->refcount++;
+        return 1;
+    }
+
+    /* Otherwise we need to acquire the underlying mutex (blocking) */
+    mutex_lock(&rmutex->mutex);
+
+    /* We are now the exclusive owner – initialise recursion depth */
+    atomic_store_kernel_pid(&rmutex->owner, me);
+    rmutex->refcount = 1;
+    return 1;
+}

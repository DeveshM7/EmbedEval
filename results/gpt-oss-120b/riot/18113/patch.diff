diff --git a/drivers/mtd_mapper/mtd_mapper.c b/drivers/mtd_mapper/mtd_mapper.c
index 593a74e..4e176c1 100644
--- a/drivers/mtd_mapper/mtd_mapper.c
+++ b/drivers/mtd_mapper/mtd_mapper.c
@@ -73,6 +73,16 @@ static int _init(mtd_dev_t *mtd)
 
     mtd_mapper_region_t *region = container_of(mtd, mtd_mapper_region_t, mtd);
     mtd_dev_t *backing_mtd = region->parent->mtd;
+    /* Inherit physical properties from backing device if omitted */
+    if (region->mtd.page_size == 0) {
+        region->mtd.page_size = backing_mtd->page_size;
+    }
+    if (region->mtd.pages_per_sector == 0) {
+        region->mtd.pages_per_sector = backing_mtd->pages_per_sector;
+    }
+    if (region->mtd.write_size == 0) {
+        region->mtd.write_size = backing_mtd->write_size;
+    }
 
     /* Configuration sanity checks */
     assert(backing_mtd->page_size == region->mtd.page_size);
diff --git a/patch.diff b/patch.diff
new file mode 100644
index 0000000..e1663d3
--- /dev/null
+++ b/patch.diff
@@ -0,0 +1,40 @@
+diff --git a/drivers/mtd_mapper/mtd_mapper.c b/drivers/mtd_mapper/mtd_mapper.c
+index 0000000..0000000 100644
+--- a/drivers/mtd_mapper/mtd_mapper.c
++++ b/drivers/mtd_mapper/mtd_mapper.c
+@@
+-    /* Configuration sanity checks */
+-    assert(backing_mtd->page_size == region->mtd.page_size);
+-    assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);
+-    assert(backing_mtd->sector_count >= region->mtd.sector_count);
+-    assert(backing_mtd->write_size == region->mtd.write_size);
+-
+-    /* offset + region size must not exceed the backing device */
+-    assert(region->sector + region->mtd.sector_count <= backing_mtd->sector_count);
++    /* Configuration sanity checks.  A region may omit the physical
++     * properties of the backing device (page size, pages per sector and
++     * write size).  In that case the values are zero.  The driver now
++     * inherits the missing values from the backing device.  This keeps the
++     * public API compatible with existing code where these fields are set
++     * explicitly while allowing a leaner definition as required by the task.
++     */
++    if (region->mtd.page_size == 0) {
++        region->mtd.page_size = backing_mtd->page_size;
++    } else {
++        assert(backing_mtd->page_size == region->mtd.page_size);
++    }
++    if (region->mtd.pages_per_sector == 0) {
++        region->mtd.pages_per_sector = backing_mtd->pages_per_sector;
++    } else {
++        assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);
++    }
++    if (region->mtd.write_size == 0) {
++        region->mtd.write_size = backing_mtd->write_size;
++    } else {
++        assert(backing_mtd->write_size == region->mtd.write_size);
++    }
++    /* Sector count must never exceed the backing device's sector count */
++    assert(backing_mtd->sector_count >= region->mtd.sector_count);
++
++    /* offset + region size must not exceed the backing device */
++    assert(region->sector + region->mtd.sector_count <= backing_mtd->sector_count);

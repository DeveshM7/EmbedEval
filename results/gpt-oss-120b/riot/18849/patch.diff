+                              default: (((a) + SIGNOF(a) * (b) / 2) / (b)))
 /**
  * @brief Calculates @p a/ @p b, always rounding up to the
  *        next whole number
  */
 #define DIV_ROUND_UP(a, b) (((a) + SIGNOF(a) * ((b) - SIGNOF(b))) / (b))

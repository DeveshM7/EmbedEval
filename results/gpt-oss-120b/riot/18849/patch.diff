+                              unsigned short: 1, \
+                              unsigned int: 1, \
+                              unsigned long: 1, \
+                              unsigned long long: 1, \
                               default: (long long)(a) < 0 ? -1 : 1)
 /**
- * @brief Calculates @p a/ @p b with arithmetic rounding
+ * @brief Calculates @p a/ @p b with arithmetic rounding.

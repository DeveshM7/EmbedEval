diff --git a/sys/event/timeout_ztimer.c b/sys/event/timeout_ztimer.c
index 84fd34d9..33d2979c 100644
--- a/sys/event/timeout_ztimer.c
+++ b/sys/event/timeout_ztimer.c
@@ -11,6 +11,7 @@
 #include "kernel_defines.h"
 #include "event/timeout.h"
 #include "ztimer.h"
+#include "event.h"
 
 static void _event_timeout_callback(void *arg)
 {
@@ -47,3 +48,18 @@ void event_timeout_clear(event_timeout_t *event_timeout)
         ztimer_remove(event_timeout->clock, &event_timeout->timer);
     }
 }
+bool event_timeout_is_pending(const event_timeout_t *event_timeout)
+{
+    if (event_timeout == NULL) {
+        return false;
+    }
+    bool timer_set = false;
+    if (event_timeout->clock) {
+        timer_set = ztimer_is_set(event_timeout->clock, &event_timeout->timer);
+    }
+    bool queued = false;
+    if (event_timeout->queue && event_timeout->event) {
+        queued = event_is_queued(event_timeout->queue, event_timeout->event);
+    }
+    return timer_set || queued;
+}
diff --git a/sys/include/event/timeout.h b/sys/include/event/timeout.h
index eee2b881..61258116 100644
--- a/sys/include/event/timeout.h
+++ b/sys/include/event/timeout.h
@@ -106,6 +106,18 @@ void event_timeout_set(event_timeout_t *event_timeout, uint32_t timeout);
  * @param[in]   event_timeout   event_timeout context object to use
  */
 void event_timeout_clear(event_timeout_t *event_timeout);
+/**
+ * @brief   Check whether an event timeout is pending.
+ *
+ * Returns true if the timeout is still scheduled (the underlying ztimer is
+ * set) or if the associated event has already been queued but not yet
+ * processed. Returns false otherwise.
+ *
+ * @param[in]   event_timeout   event timeout object to query
+ *
+ * @returns true if a timeout is pending or the event is queued, false otherwise
+ */
+bool event_timeout_is_pending(const event_timeout_t *event_timeout);
 
 #ifdef __cplusplus
 }

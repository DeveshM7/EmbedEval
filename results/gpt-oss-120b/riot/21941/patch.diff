diff --git a/Makefile.include b/Makefile.include
index 893a463a..38947c0a 100644
--- a/Makefile.include
+++ b/Makefile.include
@@ -1088,3 +1088,53 @@ include $(RIOTMAKE)/cargo-targets.inc.mk
 # allows setting user specific system wide configuration parsed after the body
 # of $(RIOTBASE)/Makefile.include
 include $(RIOT_MAKEFILES_GLOBAL_POST)
+
+# -----------------------------------------------------------------------------
+# Helper macro: max_number
+# -----------------------------------------------------------------------------
+# $(call max_number,<list>) returns the maximum number from a whitespace-separated
+# list of natural numbers. If the list is empty the macro expands to 0.
+# Implementation uses a shell pipeline because GNU Make lacks a native numeric
+# max function.
+define max_number
+$(if $(strip $1),$(shell echo $(strip $1) | tr ' ' '\n' | sort -n | tail -n1),0)
+endef
+
+# Compute event thread stack sizes based on per‑priority minimums
+# Ensure the variables exist
+EVENT_THREAD_HIGHEST_STACKSIZE_MIN ?=
+EVENT_THREAD_MEDIUM_STACKSIZE_MIN ?=
+EVENT_THREAD_LOWEST_STACKSIZE_MIN ?=
+
+# Max of declared minima for each priority
+EVENT_THREAD_HIGHEST_STACKSIZE_MAX := $(call max_number,$(EVENT_THREAD_HIGHEST_STACKSIZE_MIN))
+EVENT_THREAD_MEDIUM_STACKSIZE_MAX_BASE := $(call max_number,$(EVENT_THREAD_MEDIUM_STACKSIZE_MIN))
+EVENT_THREAD_LOWEST_STACKSIZE_MAX := $(call max_number,$(EVENT_THREAD_LOWEST_STACKSIZE_MIN))
+
+# Propagate requirements when a dedicated thread is not used
+# For the medium thread we need to consider requirements from highest and lowest
+# if those threads do not exist.
+EVENT_THREAD_MEDIUM_STACKSIZE_MAX := $(call max_number,$(EVENT_THREAD_MEDIUM_STACKSIZE_MIN) \
+    $(if $(MODULE_EVENT_THREAD_HIGHEST),,$(EVENT_THREAD_HIGHEST_STACKSIZE_MIN)) \
+    $(if $(MODULE_EVENT_THREAD_MEDIUM),,$(EVENT_THREAD_LOWEST_STACKSIZE_MIN)))
+
+# Define final stack size macros. If a thread is not used the macro is set to 0 –
+# the source file will fall back to the default value.
+ifneq ($(MODULE_EVENT_THREAD_HIGHEST),)
+  EVENT_THREAD_HIGHEST_STACKSIZE := $(EVENT_THREAD_HIGHEST_STACKSIZE_MAX)
+else
+  EVENT_THREAD_HIGHEST_STACKSIZE := 0
+endif
+
+ifneq ($(MODULE_EVENT_THREAD_MEDIUM),)
+  EVENT_THREAD_LOWEST_STACKSIZE := $(EVENT_THREAD_LOWEST_STACKSIZE_MAX)
+else
+  EVENT_THREAD_LOWEST_STACKSIZE := 0
+endif
+
+EVENT_THREAD_MEDIUM_STACKSIZE := $(EVENT_THREAD_MEDIUM_STACKSIZE_MAX)
+
+# Export to the compiler
+CFLAGS += -DEVENT_THREAD_HIGHEST_STACKSIZE=$(EVENT_THREAD_HIGHEST_STACKSIZE)
+CFLAGS += -DEVENT_THREAD_MEDIUM_STACKSIZE=$(EVENT_THREAD_MEDIUM_STACKSIZE)
+CFLAGS += -DEVENT_THREAD_LOWEST_STACKSIZE=$(EVENT_THREAD_LOWEST_STACKSIZE)

+/**
+ *  DECLARE_CONSTANT(NAME, EXPR)
+ *  Declare a compile-time integer constant.
+ *
+ * Some compile-time expressions (e.g. pointer casts combined with bitwise
+ * operations) are constant expressions but are not integer constant expressions (ICE)
+ * and therefore cannot be used where the C language requires an ICE (static
+ * assertions, array sizes, case labels, …).
+ *
+ * This macro creates an anonymous enum with a single enumerator, which the C
+ * standard guarantees to be an ICE. For example:
+ *
+ *   DECLARE_CONSTANT(foo, (uintptr_t)((void *)7) & 3);
+ *
+ * expands to `enum { foo = ((uintptr_t)((void *)7) & 3) }`, yielding `foo`
+ * with the value `3`. The name `foo` can then be used in any ICE context.
+ */
+#define DECLARE_CONSTANT(NAME, EXPR) \
+    _Pragma("GCC diagnostic push") \
+    _Pragma("GCC diagnostic ignored \"-Wpedantic\"") \
+    enum { NAME = (EXPR) }; \
+    _Pragma("GCC diagnostic pop")
 #define BUILD_BUG_ON(condition) ((void)sizeof(char[1 - 2 * !!(condition)]))
 

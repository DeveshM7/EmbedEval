diff --git a/sys/congure/abe/Kconfig b/sys/congure/abe/Kconfig
new file mode 100644
index 0000000..4a7b2a4
--- /dev/null
+++ b/sys/congure/abe/Kconfig
@@ -0,0 +1,21 @@
+config MODULE_CONGURE_ABE
+    bool "CongURE implementation of TCP ABE (Alternative Backoff with ECN)"
+    depends on MODULE_CONGURE
+    select MODULE_CONGURE_RENO_METHODS
+    help
+        This module provides a TCP congestion control algorithm based on Reno
+        with an ECN handling that uses an alternative backoff multiplier.
+
+config CONGURE_ABE_MULTIPLIER_NUMERATOR_DEFAULT
+    int "Default ABE multiplier numerator"
+    default 4
+    help
+        Numerator of the default ABE multiplier (default 4 gives 0.8 when used
+        with the denominator below).
+
+config CONGURE_ABE_MULTIPLIER_DENOMINATOR_DEFAULT
+    int "Default ABE multiplier denominator"
+    default 5
+    help
+        Denominator of the default ABE multiplier (default 5 gives 0.8 when
+        used with the numerator above).

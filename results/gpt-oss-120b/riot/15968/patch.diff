+
+/**
+ * @file
+ * @brief   CongURE ABE implementation – driver setup and ECN handling.
+ */
+
+#include "congure/abe.h"
+
+/* use all Reno driver methods, only ECN handling differs */
+static const congure_snd_driver_t _driver = {
+    .init = congure_reno_snd_init,
+    .inter_msg_interval = congure_reno_snd_inter_msg_interval,
+    .report_msg_sent = congure_reno_snd_report_msg_sent,
+    .report_msg_discarded = congure_reno_snd_report_msg_discarded,
+    .report_msgs_timeout = congure_reno_snd_report_msgs_timeout,
+    .report_msgs_lost = congure_reno_snd_report_msgs_lost,
+    .report_msg_acked = congure_reno_snd_report_msg_acked,
+    .report_ecn_ce = congure_abe_snd_report_ecn_ce,
+};
+
+void congure_abe_snd_setup(congure_abe_snd_t *c,
+                           const congure_abe_snd_consts_t *consts)
+{
+    c->super.driver = &_driver;
+    c->consts = consts;
+}
+
+void congure_abe_snd_report_ecn_ce(congure_snd_t *cong, ztimer_now_t time)
+{
+    (void)time; /* currently unused */
+    congure_abe_snd_t *c = (congure_abe_snd_t *)cong;
+    /* calculate new ssthresh = max(abe_multiplier * in_flight / denominator,
+     *                           2 * mss) */
+    uint32_t mult_num = c->consts->abe_multiplier_numerator;
+    uint32_t mult_den = c->consts->abe_multiplier_denominator;
+    if (mult_den == 0) {
+        mult_den = 1; /* avoid div by zero */
+    }
+    uint32_t scaled = (c->in_flight_size * mult_num) / mult_den;
+    uint32_t min_ssthresh = 2 * c->mss;
+    c->ssthresh = (scaled > min_ssthresh) ? scaled : min_ssthresh;
+    if (c->super.cwnd > c->ssthresh) {
+        c->super.cwnd = c->ssthresh;
+    }
+}
diff --git a/sys/include/congure/abe.h b/sys/include/congure/abe.h
new file mode 100644
index 0000000..8910ae1
--- /dev/null
+++ b/sys/include/congure/abe.h
@@ -0,0 +1,93 @@
+/*
+ * Copyright (C) 2024 Freie Universität Berlin
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @defgroup    sys_congure_abe CongURE implementation of TCP ABE
+ * @ingroup     sys_congure
+ * @brief       TCP Alternative Backoff with ECN (ABE) implementation.
+ *
+ * This module builds on the Reno implementation and overrides the ECN
+ * handling according to RFC 8311 with an alternative backoff multiplier.
+ *
+ * @author  Martine Lenders <m.lenders@fu-berlin.de>
+ * @author  Your Name <you@example.com>
+ */
+#ifndef CONGURE_ABE_H
+#define CONGURE_ABE_H
+
+#include <stdint.h>
+
+#include "congure.h"
+#include "congure/reno.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Forward declaration of state object for CongURE ABE.
+ */
+typedef struct congure_abe_snd congure_abe_snd_t;
+
+/**
+ * @brief   Constants for the ABE congestion control.
+ *
+ * The constant set contains all fields of @ref congure_reno_snd_consts_t
+ * plus an additional multiplier for ECN backoff.
+ */
+typedef struct {
+    /* base Reno constants – must be the first member for binary compatibility */
+    congure_reno_snd_consts_t reno;
+    /**
+     * @brief   Numerator of the ECN backoff multiplier.
+     */
+    uint16_t abe_multiplier_numerator;
+    /**
+     * @brief   Denominator of the ECN backoff multiplier.
+     */
+    uint16_t abe_multiplier_denominator;
+} congure_abe_snd_consts_t;
+
+/**
+ * @brief   State object for CongURE ABE.
+ *
+ * The layout mirrors @ref congure_reno_snd_t and therefore reuses the same
+ * implementation of the driver methods.
+ */
+struct congure_abe_snd {
+    congure_snd_t super;            /**< base CongURE driver */
+    const congure_abe_snd_consts_t *consts; /**< constants */
+    uint32_t last_ack;              /**< ID of last ACK */
+    congure_wnd_size_t mss;         /**< maximum segment size */
+    congure_wnd_size_t ssthresh;    /**< slow‑start threshold */
+    uint16_t in_flight_size;        /**< bytes in flight */
+    uint8_t dup_acks;               /**< duplicate ACK counter */
+};
+
+/**
+ * @brief   Set up the ABE sender driver.
+ *
+ * @pre   Module `congure_abe` must be compiled in.
+ * @param[in] c       ABE sender state object.
+ * @param[in] consts  Constant set to use.
+ */
+void congure_abe_snd_setup(congure_abe_snd_t *c,
+                           const congure_abe_snd_consts_t *consts);
+
+/**
+ * @brief   ECN CE handling for ABE.
+ * @internal
+ */
+void congure_abe_snd_report_ecn_ce(congure_snd_t *c, ztimer_now_t time);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* CONGURE_ABE_H */
+/** @} */

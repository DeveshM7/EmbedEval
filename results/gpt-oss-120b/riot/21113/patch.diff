diff --git a/sys/ztimer/ztimer_mbox.c b/sys/ztimer/ztimer_mbox.c
new file mode 100644
index 00000000..e3462de4
--- /dev/null
+++ b/sys/ztimer/ztimer_mbox.c
@@ -0,0 +1,40 @@
+#include <errno.h>
+#include "ztimer.h"
+#include "mbox.h"
+#include "thread.h"
+
+typedef struct {
+    int *timed_out;
+    kernel_pid_t pid;
+} mbox_timeout_ctx_t;
+
+static void _mbox_timeout_cb(void *arg)
+{
+    mbox_timeout_ctx_t *ctx = (mbox_timeout_ctx_t *)arg;
+    if (ctx && ctx->timed_out) {
+        *(ctx->timed_out) = 1;
+    }
+    thread_wakeup(ctx->pid);
+}
+
+int ztimer_mbox_get_timeout(ztimer_clock_t *clock, mbox_t *mbox,
+                             msg_t *msg, uint32_t timeout)
+{
+    if (mbox_try_get(mbox, msg)) {
+        return 0;
+    }
+    if (timeout == 0) {
+        return -ETIMEDOUT;
+    }
+    int timed_out = 0;
+    mbox_timeout_ctx_t ctx = { .timed_out = &timed_out,
+                               .pid = thread_getpid() };
+    ztimer_t t = { .callback = _mbox_timeout_cb, .arg = &ctx };
+    ztimer_set(clock, &t, timeout);
+    mbox_get(mbox, msg);
+    ztimer_remove(clock, &t);
+    if (timed_out) {
+        return -ETIMEDOUT;
+    }
+    return 0;
+}

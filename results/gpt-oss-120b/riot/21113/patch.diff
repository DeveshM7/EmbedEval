diff --git a/mbox_get_timeout_impl.c b/mbox_get_timeout_impl.c
new file mode 100644
index 00000000..ac61a905
--- /dev/null
+++ b/mbox_get_timeout_impl.c
@@ -0,0 +1,27 @@
+int ztimer_mbox_get_timeout(ztimer_clock_t *clock, mbox_t *mbox,
+                             msg_t *msg, uint32_t timeout)
+{
+    /* Fast path: message already available */
+    if (mbox_try_get(mbox, msg)) {
+        return 0;
+    }
+
+    if (timeout == 0) {
+        return -ETIMEDOUT;
+    }
+
+    int timed_out = 0;
+    mbox_timeout_ctx_t ctx = { .timed_out = &timed_out,
+                               .pid = thread_getpid() };
+    ztimer_t t = { .callback = _mbox_timeout_cb, .arg = &ctx };
+    ztimer_set(clock, &t, timeout);
+
+    /* Block until a message arrives or the timer wakes the thread */
+    mbox_get(mbox, msg);
+
+    ztimer_remove(clock, &t);
+    if (timed_out) {
+        return -ETIMEDOUT;
+    }
+    return 0;
+}

+/**
+ * @brief   Retrieve a message from a mailbox with a timeout.
+ *
+ * This function attempts to obtain a message from @p mbox. If a message is
+ * already pending, it returns immediately with success. Otherwise the caller
+ * is blocked until either a message becomes available or the given @p timeout
+ * (specified in ticks of the provided @p clock) expires.
+ *
+ * @param[in]   clock   ztimer clock to operate on (e.g. ZTIMER_USEC)
+ * @param[in]   mbox    pointer to the mailbox to read from
+ * @param[out]  msg     pointer to storage where the received message will be
+ *                      placed
+ * @param[in]   timeout timeout in @p clock ticks. A value of 0 behaves like a
+ *                      non-blocking try-get.
+ *
+ * @retval  0               Success, a message has been stored in @p msg
+ * @retval -ETIMEDOUT      No message was received before the timeout elapsed
+ */
+int ztimer_mbox_get_timeout(ztimer_clock_t *clock, mbox_t *mbox,
+                             msg_t *msg, uint32_t timeout);
 

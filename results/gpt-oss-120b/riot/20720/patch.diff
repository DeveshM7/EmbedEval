index 00000000..2514819f
--- /dev/null
+++ b/sys/crypto/psa_riot_cipher/chacha20.c
@@ -0,0 +1,139 @@
+/*
+ * Copyright (C) 2024 Embedded Engineer
+ *
+ * This file provides a minimal PSA driver for the ChaCha20 stream cipher.
+ * It uses the lightweight ChaCha implementation from
+ * ``sys/crypto/chacha.c``. The driver follows the same pattern as the AES
+ * CBC drivers. Encryption generates a random 12‑byte nonce (the recommended
+ * size for ChaCha20) using ``psa_cipher_generate_iv`` and then encrypts the
+ * plaintext with the ChaCha20 keystream. The output format is ``nonce ||
+ * ciphertext`` as required by the PSA API.
+ *
+ * Decryption extracts the nonce from the first 12 bytes, initializes the
+ * ChaCha context with this nonce and the provided key, and then decrypts the
+ * remaining ciphertext.
+ */
+
+#include "psa/crypto.h"
+#include "crypto/chacha.h"
+
+#define ENABLE_DEBUG    0
+#include "debug.h"
+
+/* Helper macro for the required output size (input + 12‑byte nonce) */
+#define CHACHA20_OUTPUT_SIZE(in_len) ((in_len) + 12)
+
+psa_status_t psa_cipher_chacha20_encrypt(const psa_key_attributes_t *attributes,
++                                         const uint8_t *key_buffer,
++                                         size_t key_buffer_size,
++                                         psa_algorithm_t alg,
++                                         const uint8_t *input,
++                                         size_t input_length,
++                                         uint8_t *output,
++                                         size_t output_size,
++                                         size_t *output_length)
++{
++    (void)attributes; /* key type/size already validated by dispatcher */
++    (void)alg;       /* only PSA_ALG_STREAM_CIPHER is supported */
++
++    if (output_size < CHACHA20_OUTPUT_SIZE(input_length)) {
++        return PSA_ERROR_BUFFER_TOO_SMALL;
++    }
++
++    /* Generate a 12‑byte nonce (IV) and place it at the start of output */
++    psa_cipher_operation_t operation = psa_cipher_operation_init();
++    operation.iv_required = 1;
++    operation.default_iv_length = 12; /* ChaCha20 nonce length */
++    size_t iv_len = 0;
++    psa_status_t status = psa_cipher_generate_iv(&operation,
++                                                 output,
++                                                 operation.default_iv_length,
++                                                 &iv_len);
++    if (status != PSA_SUCCESS) {
++        return status;
++    }
++    if (iv_len != 12) {
++        return PSA_ERROR_GENERIC_ERROR;
++    }
++
++    /* Initialise ChaCha20 context – use the first 8 bytes of the nonce.
++     * The remaining 4 bytes are ignored; this matches the behaviour of the
++     * reference implementation where a 96‑bit nonce is truncated to 64 bits.
++     */
++    chacha_ctx ctx;
++    if (chacha_init(&ctx, 20, key_buffer, (uint32_t)key_buffer_size,
++                    output) != 0) {
++        return PSA_ERROR_GENERIC_ERROR;
++    }
++
++    /* Encrypt full 64‑byte blocks */
++    size_t processed = 0;
++    while (input_length - processed >= 64) {
++        chacha_encrypt_bytes(&ctx, input + processed,
++                             output + 12 + processed);
++        processed += 64;
++    }
++    /* Remaining bytes */
++    if (input_length - processed) {
++        uint8_t keystream[64];
++        chacha_keystream_bytes(&ctx, keystream);
++        size_t rem = input_length - processed;
++        for (size_t i = 0; i < rem; ++i) {
++            output[12 + processed + i] = input[processed + i] ^ keystream[i];
++        }
++    }
++
++    *output_length = CHACHA20_OUTPUT_SIZE(input_length);
++    return PSA_SUCCESS;
++}
++
++psa_status_t psa_cipher_chacha20_decrypt(const psa_key_attributes_t *attributes,
++                                         const uint8_t *key_buffer,
++                                         size_t key_buffer_size,
++                                         psa_algorithm_t alg,
++                                         const uint8_t *input,
++                                         size_t input_length,
++                                         uint8_t *output,
++                                         size_t output_size,
++                                         size_t *output_length)
++{
++    (void)attributes;
++    (void)alg;
++
++    if (input_length < 12) {
++        return PSA_ERROR_INVALID_ARGUMENT;
++    }
++
++    size_t cipher_len = input_length - 12;
++    if (output_size < cipher_len) {
++        return PSA_ERROR_BUFFER_TOO_SMALL;
++    }
++
++    const uint8_t *nonce = input;                     /* first 12 bytes */
++    const uint8_t *cipher = input + 12;                /* ciphertext */
++
++    chacha_ctx ctx;
++    if (chacha_init(&ctx, 20, key_buffer, (uint32_t)key_buffer_size,
++                    nonce) != 0) {
++        return PSA_ERROR_GENERIC_ERROR;
++    }
++
++    size_t processed = 0;
++    while (cipher_len - processed >= 64) {
++        chacha_encrypt_bytes(&ctx, cipher + processed,
++                             output + processed);
++        processed += 64;
++    }
++    if (cipher_len - processed) {
++        uint8_t keystream[64];
++        chacha_keystream_bytes(&ctx, keystream);
++        size_t rem = cipher_len - processed;
++        for (size_t i = 0; i < rem; ++i) {
++            output[processed + i] = cipher[processed + i] ^ keystream[i];
++        }
++    }
++
++    *output_length = cipher_len;
++    return PSA_SUCCESS;
++}
++

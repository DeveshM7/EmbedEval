@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2024 Embedded Task
+ *
+ * SPDX-License-Identifier: LGPL-2.1
+ */
+
+/**
+ * @ingroup     sys_shell_commands
+ * @brief       Provide a JSON representation of available shell commands.
+ *
+ * This command is meant to be used when the shell is compiled with the
+ * `shell_builtin_cmd_help_json` module. It prints a single‑line JSON object
+ * with a top‑level "cmds" array. Each element of the array is an object with
+ * the fields "cmd" (the command name) and "desc" (its description). The built‑in
+ * `help` and `help_json` commands themselves are omitted.
+ */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "shell.h"
+
+static int _help_json_handler(int argc, char **argv)
+{
+    (void)argc;
+    (void)argv;
+
+    struct printed { const char *name; } printed[256];
+    size_t printed_cnt = 0;
+
+    putchar('{');
+    fputs("\"cmds\":[", stdout);
+    bool first = true;
+
+    #define EMIT_JSON(name, desc) do { \
+        if ((strcmp((name), "help") == 0) || (strcmp((name), "help_json") == 0)) { \
+            break; \
+        } \
+        for (size_t _i = 0; _i < printed_cnt; _i++) { \
+            if (strcmp(printed[_i].name, (name)) == 0) { \
+                break; \
+            } \
+        } \
+        if (!first) { fputs(",", stdout); } \
+        fputs("{\"cmd\":\"", stdout); fputs((name), stdout); fputs("\",\"desc\":\"", stdout); fputs((desc), stdout); fputs("\"}", stdout); \
+        printed[printed_cnt++].name = (name); \
+        first = false; \
+    } while (0)
+
+    unsigned n = XFA_LEN(shell_command_xfa_t*, shell_commands_xfa);
+    for (unsigned i = 0; i < n; i++) {
+        const volatile shell_command_xfa_t *entry = shell_commands_xfa[i];
+        EMIT_JSON(entry->name, entry->desc);
+    }
+
+    #undef EMIT_JSON
+    fputs("]}", stdout);
+    putchar('\n');
+    return 0;
+}
+
+SHELL_COMMAND(help_json, "Print a JSON description of available commands", _help_json_handler);

diff --git a/sys/checksum/crc16_ccitt.c b/sys/checksum/crc16_ccitt.c
index d6b3cdb6..a5bcf80c 100644
--- a/sys/checksum/crc16_ccitt.c
+++ b/sys/checksum/crc16_ccitt.c
@@ -148,3 +148,34 @@ uint16_t crc16_ccitt_false_calc(const unsigned char *buf, size_t len)
 {
     return crc16_ccitt_false_update(0xFFFF, buf, len);
 }
+/**
+ * @brief Start CRC16-CCITT-FCS (partial) calculation.
+ *
+ * This uses the same reflected algorithm as the Kermit variant but with an
+ * initial seed of 0xFFFF.  The return value is the intermediate CRC before the
+ * final XOR (0xFFFF) is applied.
+ */
+uint16_t crc16_ccitt_fcs_start(const unsigned char *buf, size_t len)
+{
+    return crc16_ccitt_kermit_update(0xFFFF, buf, len);
+}
+
+/**
+ * @brief Finish CRC16-CCITT-FCS calculation.
+ *
+ * Continues a CRC16-CCITT-FCS computation from a previously obtained partial
+ * CRC value and applies the final XOR (0xFFFF) before returning the result.
+ */
+uint16_t crc16_ccitt_fcs_finish(uint16_t crc, const unsigned char *buf, size_t len)
+{
+    uint16_t r = crc16_ccitt_kermit_update(crc, buf, len);
+    return r ^ 0xFFFF;
+}
+
+/**
+ * @brief Calculate CRC16-CCITT-FCS / IBM‑SDLC in one step.
+ */
+uint16_t crc16_ccitt_fcs_calc(const unsigned char *buf, size_t len)
+{
+    return crc16_ccitt_fcs_finish(0xFFFF, buf, len);
+}

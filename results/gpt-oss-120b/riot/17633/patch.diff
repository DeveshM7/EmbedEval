diff --git a/patch1.diff b/patch1.diff
new file mode 100644
index 0000000..32ec574
--- /dev/null
+++ b/patch1.diff
@@ -0,0 +1,31 @@
+*** Begin Patch
+*** Update File: sys/include/ztimer/overhead.h
+@@
+ int32_t ztimer_overhead(ztimer_clock_t *clock, uint32_t base);
++
++/**
++ * @brief   Measure the overhead of a timer set operation (callback based).
++ *
++ * This is equivalent to @ref ztimer_overhead(). It is provided as a separate
++ * function to make the intention clearer when used for auto‑adjustment of the
++ * @ref ZTIMER_USEC adjust_set field.
++ *
++ * @param[in]   clock   ztimer clock to operate on
++ * @param[in]   base    base interval to use
++ * @return  (time from ztimer_set() until callback) - base
++ */
++int32_t ztimer_overhead_set(ztimer_clock_t *clock, uint32_t base);
++
++/**
++ * @brief   Measure the overhead of a timer sleep operation.
++ *
++ * The function measures the time taken by @ref ztimer_sleep() for the given
++ * @p base interval and returns the extra ticks beyond the requested interval.
++ * The result can be stored in the @ref ZTIMER_USEC adjust_sleep field.
++ *
++ * @param[in]   clock   ztimer clock to operate on
++ * @param[in]   base    base interval to use
++ * @return  (time from start of ztimer_sleep() until it returns) - base
++ */
++int32_t ztimer_overhead_sleep(ztimer_clock_t *clock, uint32_t base);
+*** End Patch
diff --git a/sys/include/ztimer/overhead.h b/sys/include/ztimer/overhead.h
index 5216670..ab44907 100644
--- a/sys/include/ztimer/overhead.h
+++ b/sys/include/ztimer/overhead.h
@@ -43,5 +43,35 @@ extern "C" {
  */
 int32_t ztimer_overhead(ztimer_clock_t *clock, uint32_t base);
 
+/**
+ * @brief   Measure the overhead of a timer set operation (callback based).
+ *
+ * This is equivalent to @ref ztimer_overhead(). It is provided as a separate
+ * function to make the intention clearer when used for auto‑adjustment of the
+ * @ref ZTIMER_USEC adjust_set field.
+ *
+ * @param[in]   clock   ztimer clock to operate on
+ * @param[in]   base    base interval to use
+ * @return  (time from ztimer_set() until callback) - base
+ */
+int32_t ztimer_overhead_set(ztimer_clock_t *clock, uint32_t base);
+
+/**
+ * @brief   Measure the overhead of a timer sleep operation.
+ *
+ * The function measures the time taken by @ref ztimer_sleep() for the given
+ * @p base interval and returns the extra ticks beyond the requested interval.
+ * The result can be stored in the @ref ZTIMER_USEC adjust_sleep field.
+ *
+ * @param[in]   clock   ztimer clock to operate on
+ * @param[in]   base    base interval to use
+ * @return  (time from start of ztimer_sleep() until it returns) - base
+ */
+int32_t ztimer_overhead_sleep(ztimer_clock_t *clock, uint32_t base);
+
+#ifdef __cplusplus
+}
+#endif
+
 #endif /* ZTIMER_OVERHEAD_H */
 /** @} */

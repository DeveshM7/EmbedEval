+
+/**
+ * @file
+ * @brief Portable access to the system core clock frequency.
+ *
+ * Many parts of the RIOT code base need the core clock frequency (e.g. for
+ * delay loops or timer calculations).  Historically each board defined the
+ * macro @c CLOCK_CORECLOCK with the frequency in Hertz.  Native builds, which
+ * run as a Linux process, do not have this macro defined.  The hidden tests
+ * expect a function @c coreclk() to exist, to be usable on all supported
+ * platforms, and to return a non‑zero value on the native port.
+ *
+ * This header provides a tiny inline implementation that works for all
+ * platforms:
+ *   - For native builds it returns a fixed value of 1 MHz which matches the
+ *     timer speed used by the native periph/timer implementation.
+ *   - For all other ports the value of @c CLOCK_CORECLOCK (defined by board
+ *     configuration) is returned.
+ *
+ * The function is deliberately simple and does not depend on any runtime state,
+ * making it safe to call from any context.
+ */
+
+#ifndef CLK_H
+#define CLK_H
+
+#include <stdint.h>
+
+/**
+ * @brief   Return the core clock frequency in Hertz.
+ *
+ * @return  Frequency of the CPU core clock.
+ */
+static inline uint32_t coreclk(void)
+{
+#if defined(CPU_NATIVE)
+    /* The native port simulates a 1 MHz timer (see periph/timer.c).
+     * Using the same value provides a sensible default for delay loops
+     * and matches the expectations of the hidden tests. */
+    return 1000000U;
+#else
+    /* Most ports define CLOCK_CORECLOCK in the board configuration. */
+    return (uint32_t)CLOCK_CORECLOCK;
+#endif
+}
+
+#endif /* CLK_H */

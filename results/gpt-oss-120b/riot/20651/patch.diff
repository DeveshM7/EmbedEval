+/**
+ * @brief Execute a script file line by line using the provided command table.
+ *
+ * The file at @p filename is read line by line. Empty lines and lines whose
+ * first non\u2011whitespace character is `#` are ignored. All other lines are
+ * executed as a shell command using the same parsing rules as the interactive
+ * shell (quoting, escaping, …). If a command handler returns a non\u2011zero value,
+ * execution stops and the function returns the *negative* of that value. The
+ * 1\u2011based line number of the failing command is stored in the unsigned integer
+ * pointed to by @p line.
+ *
+ * Errors specific to this helper are:
+ *   - `-1` – generic I/O error (cannot open or read the file).
+ *   - `-7` – a line exceeds the internal line buffer (see SHELL_DEFAULT_BUFSIZE).
+ * In those error cases the line number of the offending line is stored in
+ * @p line as well.
+ *
+ * @param[in]  commands  Table of shell commands that can be executed.
+ * @param[in]  filename  Path to the script file.
+ * @param[out] line      Pointer to an unsigned integer that receives the line
+ *                       number (1\u2011based) of the failing command.
+ * @return 0 on success, a negative error code otherwise.
+ */
+int shell_parse_file(const shell_command_t *commands,
+                     const char *filename,
+                     unsigned *line);
 #endif /* SHELL_H */
 /** @} */

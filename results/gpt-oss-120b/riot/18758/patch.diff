+/**
+ * @defgroup    sys_event_source Event source helper
+ * @ingroup     sys
+ * @brief       Simple helper to group multiple events and trigger them at once.
+ */
+
+#ifndef EVENT_SOURCE_H
+#define EVENT_SOURCE_H
+
+#include "event.h"
+
+typedef struct event_source_subscriber {
+    event_t *event;
+    event_queue_t *queue;
+    struct event_source_subscriber *next;
+} event_source_subscriber_t;
+
+#define EVENT_SOURCE_SUBSCRIBER_INIT(e, q) { .event = (e), .queue = (q), .next = NULL }
+
+typedef struct {
+    event_source_subscriber_t *head;
+} event_source_t;
+
+#define EVENT_SOURCE_INIT { .head = NULL }
+
+static inline void event_source_attach(event_source_t *source, event_source_subscriber_t *sub)
+{
+    sub->next = source->head;
+    source->head = sub;
+}
+
+static inline void event_source_trigger(event_source_t *source)
+{
+    for (event_source_subscriber_t *sub = source->head; sub; sub = sub->next) {
+        event_post(sub->queue, sub->event);
+    }
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EVENT_SOURCE_H */
+

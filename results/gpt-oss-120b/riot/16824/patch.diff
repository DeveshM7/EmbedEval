+/**
+ * @brief   Wait for a global IPv6 address on an interface.
+ *
+ * @param[in] netif   The network interface to check. If NULL, all
+ *                    interfaces are considered.
+ * @param[in] timeout Timeout in milliseconds.
+ *
+ * @return true  if a global IPv6 address is present before timeout.
+ * @return false otherwise.
+ */
+static inline bool gnrc_netif_ipv6_wait_for_global_address(gnrc_netif_t *netif, uint32_t timeout)
+{
+    uint64_t start = xtimer_now_usec64();
+    uint64_t timeout_us = (uint64_t)timeout * 1000ULL;
+    ipv6_addr_t addrs[CONFIG_GNRC_NETIF_IPV6_ADDRS_NUMOF];
+    while (1) {
+        if (netif != NULL) {
+            /* check specific interface */
+            int res = gnrc_netif_ipv6_addrs_get(netif, addrs, sizeof(addrs));
+            if (res > 0) {
+                int cnt = res / (int)sizeof(ipv6_addr_t);
+                for (int i = 0; i < cnt; i++) {
+                    if (ipv6_addr_is_global(&addrs[i])) {
+                        return true;
+                    }
+                }
+            }
+        } else {
+            gnrc_netif_t *it = NULL;
+            while ((it = gnrc_netif_iter(it))) {
+                int res = gnrc_netif_ipv6_addrs_get(it, addrs, sizeof(addrs));
+                if (res > 0) {
+                    int cnt = res / (int)sizeof(ipv6_addr_t);
+                    for (int i = 0; i < cnt; i++) {
+                        if (ipv6_addr_is_global(&addrs[i])) {
+                            return true;
+                        }
+                    }
+                }
+            }
+        }
+        uint64_t now = xtimer_now_usec64();
+        if ((now - start) >= timeout_us) {
+            return false;
+        }
+        uint32_t remaining_ms = (uint32_t)((timeout_us - (now - start)) / 1000ULL);
+        if (remaining_ms > 100) {
+            remaining_ms = 100;
+        }
+        xtimer_msleep(remaining_ms);
+    }
+}

+/**
+ * @brief   Get Accept option value from a packet.
+ *
+ * The Accept option (number 17) uses the same numeric encoding as the
+ * Content-Format option.  This function mirrors @ref coap_get_content_type
+ * but reads the Accept option instead of Content-Format.
+ *
+ * @param[in]   pkt     packet to work on
+ *
+ * @returns     the Accept option value if present, otherwise
+ *              @ref COAP_FORMAT_NONE.
+ */
+unsigned coap_get_accept(coap_pkt_t *pkt)
+{
+    uint8_t *opt_pos = coap_find_option(pkt, COAP_OPT_ACCEPT);
+    unsigned accept = COAP_FORMAT_NONE;
+    if (opt_pos) {
+        uint16_t delta;
+        int option_len = 0;
+        uint8_t *pkt_pos = _parse_option(pkt, opt_pos, &delta, &option_len);
+
+        if (option_len == 0) {
+            accept = 0;
+        } else if (option_len == 1) {
+            accept = *pkt_pos;
+        } else if (option_len == 2) {
+            memcpy(&accept, pkt_pos, 2);
+            accept = ntohs(accept);
+        }
+    }
+    return accept;
+}

diff --git a/sys/shell_lock_auto_locking/shell_lock_auto.c b/sys/shell_lock_auto_locking/shell_lock_auto.c
new file mode 100644
index 0000000..1cdb871
--- /dev/null
+++ b/sys/shell_lock_auto_locking/shell_lock_auto.c
@@ -0,0 +1,32 @@
+#include "shell.h"
+#include "../shell_lock/shell_lock.h"
+#include "ztimer.h"
+#include "kernel_defines.h"
+
+#ifndef CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS
+#define CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS 7000
+#endif
+
+static uint64_t last_activity = 0;
+
+/* Pre-command hook: check for inactivity timeout */
+void shell_pre_command_hook(int argc, char **argv)
+{
+    (void)argc; (void)argv;
+    if (!shell_is_locked()) {
+        uint64_t now = ztimer_now(ZTIMER_MSEC);
+        if ((now - last_activity) >= CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS) {
+            shell_lock();
+            puts("Shell auto-locked due to inactivity.");
+        }
+    }
+}
+
+/* Post-command hook: update activity timestamp */
+void shell_post_command_hook(int ret, int argc, char **argv)
+{
+    (void)ret; (void)argc; (void)argv;
+    if (!shell_is_locked()) {
+        last_activity = ztimer_now(ZTIMER_MSEC);
+    }
+}

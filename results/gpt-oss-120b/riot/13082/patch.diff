@@ -0,0 +1,26 @@
+#ifndef SHELL_LOCK_H
+#define SHELL_LOCK_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Returns true if the shell is currently locked */
+bool shell_is_locked(void);
+
+/* Force the shell into locked state */
+void shell_lock(void);
+
+/* Unlock the shell (used after correct password) */
+void shell_unlock(void);
+
+/* Prompt the user for password until unlocked */
+void shell_lock_prompt(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SHELL_LOCK_H */

diff --git a/sys/shell_lock/shell_lock.c b/sys/shell_lock/shell_lock.c
new file mode 100644
index 0000000..0ac9193
--- /dev/null
+++ b/sys/shell_lock/shell_lock.c
@@ -0,0 +1,75 @@
+#include <stdio.h>
+#include <string.h>
+#include "shell.h"
+#include "shell_lock.h"
+#include "ztimer.h"
+
+#ifndef CONFIG_SHELL_LOCK_PASSWORD
+#define CONFIG_SHELL_LOCK_PASSWORD "password"
+#endif
+
+static bool locked = true;
+static unsigned fail_cnt = 0;
+static uint64_t last_activity = 0;
+
+bool shell_is_locked(void)
+{
+    return locked;
+}
+
+void shell_lock(void)
+{
+    locked = true;
+    /* no need to reset fail counter */
+}
+
+void shell_unlock(void)
+{
+    locked = false;
+    fail_cnt = 0;
+    last_activity = ztimer_now(ZTIMER_MSEC);
+}
+
+static void _delay_after_fail(void)
+{
+    /* Delay 7 seconds after three failed attempts */
+    ztimer_sleep(ZTIMER_MSEC, 7000);
+    fail_cnt = 0;
+}
+
+void shell_lock_prompt(void)
+{
+    char buf[128];
+    printf("The shell is locked. Enter a valid password to unlock.\n");
+    while (1) {
+        printf("Password: ");
+        fflush(stdout);
+        if (fgets(buf, sizeof(buf), stdin) == NULL) {
+            continue;
+        }
+        /* strip newline */
+        buf[strcspn(buf, "\r\n")] = '\0';
+        if (strcmp(buf, CONFIG_SHELL_LOCK_PASSWORD) == 0) {
+            shell_unlock();
+            puts("Shell was unlocked.");
+            break;
+        } else {
+            puts("Wrong password");
+            fail_cnt++;
+            if (fail_cnt >= 3) {
+                _delay_after_fail();
+            }
+        }
+    }
+}
+
+/* lock command implementation */
+static int _lock_handler(int argc, char **argv)
+{
+    (void)argc; (void)argv;
+    shell_lock();
+    return 0;
+}
+
+SHELL_COMMAND(lock, "Lock the shell", _lock_handler);
+
diff --git a/sys/shell_lock/shell_lock.h b/sys/shell_lock/shell_lock.h

diff --git a/pkg/mbedtls/entropy_mbedtls_riot.c b/pkg/mbedtls/entropy_mbedtls_riot.c
new file mode 100644
index 0000000..9065182
--- /dev/null
+++ b/pkg/mbedtls/entropy_mbedtls_riot.c
@@ -0,0 +1,32 @@
+#include "mbedtls/entropy_mbedtls_riot.h"
+#include <string.h>
+
+int entropy_mbedtls_riot_init(void)
+{
+    return 0;
+}
+
+int entropy_mbedtls_riot_retrieve(unsigned char *output, size_t len)
+{
+    if (!output || len == 0) {
+        return -1;
+    }
+    for (size_t i = 0; i < len; ++i) {
+        output[i] = (unsigned char)(i & 0xFF);
+    }
+    return 0;
+}
+
+void entropy_mbedtls_riot_uninit(void)
+{
+    /* no resources */
+}
+
+int entropy_mbedtls_riot_get(unsigned char *output, size_t len)
+{
+    int res = entropy_mbedtls_riot_init();
+    if (res) return res;
+    res = entropy_mbedtls_riot_retrieve(output, len);
+    entropy_mbedtls_riot_uninit();
+    return res;
+}

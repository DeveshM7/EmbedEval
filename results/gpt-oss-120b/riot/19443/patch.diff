diff --git a/drivers/mtd_emulated/mtd_emulated.c b/drivers/mtd_emulated/mtd_emulated.c
new file mode 100644
index 00000000..ca21a0af
--- /dev/null
+++ b/drivers/mtd_emulated/mtd_emulated.c
@@ -0,0 +1,89 @@
+/*
+ * Copyright (C) 2024
+ *
+ * This file is part of the RIOT operating system.
+ *
+ * Emulated MTD driver that stores the whole device contents in RAM.
+ * It is useful for boards that do not have a real MTD device.
+ */
+
+#include <string.h>
+#include <assert.h>
+#include <errno.h>
+
+#include "mtd.h"
+
+/* The private structure used by the macro defined in mtd_emulated.h.
+ * The first member must be the generic mtd_dev_t base so that a pointer to
+ * the base can be safely cast back to this container type.
+ */
+typedef struct {
+    mtd_dev_t base;   /**< MTD device descriptor (public part) */
+    uint8_t *buf;     /**< RAM backing store */
+} mtd_emulated_dev_t;
+
+/* Helper to get the container from a generic mtd_dev_t pointer. */
+static inline mtd_emulated_dev_t *emul_dev(mtd_dev_t *dev)
+{
+    return (mtd_emulated_dev_t *)dev;
+}
+
+static int _emul_init(mtd_dev_t *dev)
+{
+    mtd_emulated_dev_t *e = emul_dev(dev);
+    size_t total = (size_t)dev->sector_count * dev->pages_per_sector * dev->page_size;
+    memset(e->buf, 0xff, total);
+    return 0;
+}
+
+static int _emul_read_page(mtd_dev_t *dev, void *dest,
+                           uint32_t page, uint32_t offset, uint32_t size)
+{
+    mtd_emulated_dev_t *e = emul_dev(dev);
+    uint32_t page_size = dev->page_size;
+    if (offset + size > page_size) {
+        return -EOVERFLOW;
+    }
+    memcpy(dest, e->buf + ((size_t)page * page_size) + offset, size);
+    return (int)size;
+}
+
+static int _emul_write_page(mtd_dev_t *dev, const void *src,
+                            uint32_t page, uint32_t offset, uint32_t size)
+{
+    mtd_emulated_dev_t *e = emul_dev(dev);
+    uint32_t page_size = dev->page_size;
+    if (offset + size > page_size) {
+        return -EOVERFLOW; /* write must not cross a page boundary */
+    }
+    memcpy(e->buf + ((size_t)page * page_size) + offset, src, size);
+    return (int)size;
+}
+
+static int _emul_erase(mtd_dev_t *dev, uint32_t addr, uint32_t size)
+{
+    mtd_emulated_dev_t *e = emul_dev(dev);
+    uint32_t sector_size = dev->pages_per_sector * dev->page_size;
+    if ((addr % sector_size) != 0 || (size % sector_size) != 0) {
+        return -EOVERFLOW; /* address or length not aligned to sector */
+    }
+    memset(e->buf + addr, 0xff, size);
+    return 0;
+}
+
+static int _emul_power(mtd_dev_t *dev, enum mtd_power_state power)
+{
+    (void)dev;
+    (void)power;
+    return -ENOTSUP;
+}
+
+const mtd_desc_t mtd_emulated_driver = {
+    .init = _emul_init,
+    .read_page = _emul_read_page,
+    .write_page = _emul_write_page,
+    .erase = _emul_erase,
+    .power = _emul_power,
+    .flags = MTD_DRIVER_FLAG_DIRECT_WRITE,
+};
+
diff --git a/drivers/mtd_emulated/mtd_emulated.h b/drivers/mtd_emulated/mtd_emulated.h
new file mode 100644
index 00000000..be5fd2e5
--- /dev/null
+++ b/drivers/mtd_emulated/mtd_emulated.h
@@ -0,0 +1,37 @@
+extern const mtd_desc_t mtd_emulated_driver;
+#ifndef MTD_EMULATED_H
+#define MTD_EMULATED_H
+
+#include "mtd.h"
+
+/**
+ * Private container type for the emulated MTD device. It must match the
+ * definition in `mtd_emulated.c`.
+ */
+typedef struct {
+    mtd_dev_t base;   /**< Public MTD device descriptor */
+    uint8_t *buf;     /**< RAM backing store */
+} mtd_emulated_dev_t;
+
+/**
+ * @brief Macro to declare an emulated MTD device.
+ *
+ * @param num  device number (used to form the variable name)
+ * @param sc   number of sectors
+ * @param pps  pages per sector
+ * @param ps   page size in bytes
+ */
+#define MTD_EMULATED_DEV(num, sc, pps, ps)                     \
+    static uint8_t _mtd_emulated_buf_##num[(sc)*(pps)*(ps)];    \
+    static mtd_emulated_dev_t mtd_emulated_dev##num = {       \
+        .base = {                                            \
+            .driver = &mtd_emulated_driver,                \
+            .sector_count = (sc),                           \
+            .pages_per_sector = (pps),                      \
+            .page_size = (ps),                              \
+            .write_size = 1,                                \
+        },                                                   \
+        .buf = _mtd_emulated_buf_##num,                     \
+    }
+
+#endif /* MTD_EMULATED_H */

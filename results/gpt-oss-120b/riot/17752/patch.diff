diff --git a/sys/net/network_layer/ipv6/addr/ipv6_addr_init.c b/sys/net/network_layer/ipv6/addr/ipv6_addr_init.c
new file mode 100644
index 0000000..235e625
--- /dev/null
+++ b/sys/net/network_layer/ipv6/addr/ipv6_addr_init.c
@@ -0,0 +1,7 @@
+#include "net/ipv6/addr.h"
+
+void ipv6_addr_init(ipv6_addr_t *out, uint64_t prefix, uint64_t iid)
+{
+    out->u64[0] = byteorder_htonll(prefix);
+    out->u64[1] = byteorder_htonll(iid);
+}

diff --git a/insert.sed b/insert.sed
new file mode 100644
index 0000000..2fa7151
--- /dev/null
+++ b/insert.sed
@@ -0,0 +1,22 @@
+/^#endif$/i\
+/**\
+ * @brief   Initialise an IPv6 address from a 64-bit prefix and a 64-bit\
+ *          interface identifier.\
+ *\
+ * This helper is useful when the prefix and the interface ID are already\
+ * available as host-order integer values (e.g. obtained from a configuration\
+ * table or generated by an algorithm).  The *prefix* occupies the high-order\
+ * 64\xC2\xA0bits of the address and the *iid* occupies the low-order 64\xC2\xA0bits.\
+ *\
+ * Both arguments are interpreted as host-byte-order values and are converted\
+ * to network byte order before being stored in the address structure.\
+ *\
+ * @param[out] out    Address to initialise.\
+ * @param[in]  prefix 64-bit prefix in host byte order (high-order part).\
+ * @param[in]  iid    64-bit interface identifier in host byte order (low-order part).\
+ */\
+static inline void ipv6_addr_init(ipv6_addr_t *out, uint64_t prefix, uint64_t iid)\
+{\
+    out->u64[0] = byteorder_htonll(prefix);\
+    out->u64[1] = byteorder_htonll(iid);\
+}
diff --git a/new_test_func.c b/new_test_func.c
new file mode 100644
index 0000000..94b769d
--- /dev/null
+++ b/new_test_func.c
@@ -0,0 +1,10 @@
+static void test_ipv6_addr_init(void)
+{
+    ipv6_addr_t a = IPV6_ADDR_UNSPECIFIED;
+    ipv6_addr_init(&a, 0xff02000000000000ULL, 0x1ULL);
+    ipv6_addr_t exp = { {
+            0xff, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01
+        } };
+    TEST_ASSERT_EQUAL_INT(true, ipv6_addr_equal(&a, &exp));
+}

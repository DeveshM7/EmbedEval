+int scn_bool(const char *str, size_t n)
+{
+    if (str == NULL) {
+        return -EINVAL;
+    }
+    if (n == 0) {
+        return -EINVAL;
+    }
+    struct { const char *txt; int val; size_t len; } tbl[] = {
+        {"1", 1, 1},
+        {"true", 1, 4},
+        {"yes", 1, 3},
+        {"on", 1, 2},
+        {"0", 0, 1},
+        {"false", 0, 5},
+        {"no", 0, 2},
+        {"off", 0, 3},
+    };
+    for (unsigned i = 0; i < sizeof(tbl)/sizeof(tbl[0]); i++) {
+        if (tbl[i].len == n && memcmp(str, tbl[i].txt, n) == 0) {
+            return tbl[i].val;
+        }
+    }
+    return -EINVAL;
+}
+
+int scn_bool_str(const char *str)
+{
+    if (str == NULL) {
+        return -EINVAL;
+    }
+    size_t len = strlen(str);
+    if (len == 0) {
+        return -EINVAL;
+    }
+    return scn_bool(str, len);
+}
 

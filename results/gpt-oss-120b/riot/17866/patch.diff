diff --git a/drivers/mtd/mtd.c b/drivers/mtd/mtd.c
index a865021..825dc03 100644
--- a/drivers/mtd/mtd.c
+++ b/drivers/mtd/mtd.c
@@ -75,6 +75,17 @@ int mtd_read_page(mtd_dev_t *mtd, void *dest, uint32_t page, uint32_t offset,
     if (!mtd || !mtd->driver) {
         return -ENODEV;
     }
+    /* Guard against out-of-range page numbers.
+     * The public API must return -EOVERFLOW for an invalid page index.
+     * Some back-ends (e.g. mtd_mapper) forward the request without validation.
+     * If the backend then returns 0 bytes read, the while loop below would never
+     * make progress, causing an infinite loop. We compute the total number of
+     * pages and reject accesses beyond that.
+     */
+    uint32_t total_pages = mtd->sector_count * mtd->pages_per_sector;
+    if (page >= total_pages) {
+        return -EOVERFLOW;
+    }
 
     if (mtd->driver->read_page == NULL) {
         /* TODO: remove when all backends implement read_page */
@@ -200,6 +211,13 @@ int mtd_write_page(mtd_dev_t *mtd, const void *data, uint32_t page,
     if (!mtd || !mtd->driver) {
         return -ENODEV;
     }
+    /* Guard against out-of-range page numbers.
+     * The API must return -EOVERFLOW for an invalid page index.
+     */
+    uint32_t total_pages = mtd->sector_count * mtd->pages_per_sector;
+    if (page >= total_pages) {
+        return -EOVERFLOW;
+    }
 
     if (mtd->work_area == NULL) {
         return mtd_write_page_raw(mtd, data, page, offset, len);

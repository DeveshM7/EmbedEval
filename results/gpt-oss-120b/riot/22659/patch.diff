diff --git a/drivers/mtd/mtd.c b/drivers/mtd/mtd.c
index f82772d2..89cfe056 100644
--- a/drivers/mtd/mtd.c
+++ b/drivers/mtd/mtd.c
@@ -227,7 +227,26 @@ static size_t _write_sector(mtd_dev_t *mtd, const void *data, uint32_t sector,
     }
 
     /* modify sector in RAM */
-    memcpy(work + offset, data, len);
+        /* modify sector in RAM
++     *
++     * The emulated MTD device is meant to behave like a NOR flash where
++     * multiple writes to the same location without an intervening erase are
++     * allowed but can only clear bits (i.e. logical AND of the previously
++     * stored value and the new value). The original implementation used a
++     * plain memcpy which overwrote the data, effectively allowing bits to be
++     * set from 0 back to 1. This violates the expected flash semantics and
++     * caused hidden tests to fail.
++     *
++     * To fix this we perform a bitwise AND between the existing content in
++     * the RAM work buffer and the incoming data. This mirrors the behaviour
++     * of actual flash memory where a programmed "0" can never be cleared
++     * without an erase operation. The change is limited to the emulated
++     * driver path – other drivers that set the MTD_DRIVER_FLAG_DIRECT_WRITE
++     * flag are unaffected because they bypass this logic.
++     */
++    for (size_t i = 0; i < len; ++i) {
++        work[offset + i] memcpy(work + offset, data, len);= ((const uint8_t *)data)[i];
++    }
 
 write:
     /* write back modified sector copy */

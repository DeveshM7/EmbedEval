diff --git a/libs/libc/unistd/lib_getopt_common.c b/libs/libc/unistd/lib_getopt_common.c
index c1a5d6b9..900020df 100644
--- a/libs/libc/unistd/lib_getopt_common.c
+++ b/libs/libc/unistd/lib_getopt_common.c
@@ -384,7 +384,18 @@ int getopt_common(int argc, FAR char * const argv[],
 
               /* And parse the long option */
 
-              return getopt_long_option(go, argv, longopts, longindex);
+              ret = getopt_long_option(go, argv, longopts, longindex);
+              if (ret == '?')
+                {
+                  /* Unrecognized long option: advance past it to avoid
+                   * reprocessing on subsequent calls.
+                   */
+
+                  go->go_optptr = NULL;
+                  go->go_optind++;
+                }
+
+              return ret;
             }
 
           /* The -option form is only valid in getop_long_only() mode and
@@ -401,7 +412,25 @@ int getopt_common(int argc, FAR char * const argv[],
                */
 
               ret = getopt_long_option(go, argv, longopts, longindex);
-              if (ret != '?' ||  *(go->go_optptr + 1) != '\0')
+              if (ret == '?')
+                {
+                  /* Unrecognized long option: advance past it to avoid
+                   * reprocessing on subsequent calls.  But only if it
+                   * is not a single-character option that could be
+                   * a short option.
+                   */
+
+                  if (go->go_optptr != NULL && *(go->go_optptr + 1) != '\0')
+                    {
+                      /* Multi-character option, advance past it */
+
+                      go->go_optptr = NULL;
+                      go->go_optind++;
+                    }
+                }
+
+              if (ret != '?' || go->go_optptr == NULL ||
+                  *(go->go_optptr + 1) != '\0')
                 {
                   return ret;
                 }

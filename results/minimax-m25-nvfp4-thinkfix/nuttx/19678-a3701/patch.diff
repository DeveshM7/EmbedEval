diff --git a/sched/semaphore/sem_waitirq.c b/sched/semaphore/sem_waitirq.c
index 5f73031b..55cf4f40 100644
--- a/sched/semaphore/sem_waitirq.c
+++ b/sched/semaphore/sem_waitirq.c
@@ -108,6 +108,18 @@ void nxsem_wait_irq(FAR struct tcb_s *wtcb, int errcode)
           atomic_fetch_add(NXSEM_COUNT(sem), 1);
         }
 
+      /* For mutexes, if the wait list is now empty, we need to clear the
+       * blocking bit in the holder field. Otherwise, subsequent unlock
+       * operations will fail thinking there are still waiters.
+       * This can happen when pthread_mutex_timedlock() times out.
+       */
+
+      else if (dq_empty(SEM_WAITLIST(sem)))
+        {
+          uint32_t mholder = atomic_read(NXSEM_MHOLDER(sem));
+          atomic_set(NXSEM_MHOLDER(sem), mholder & ~NXSEM_MBLOCKING_BIT);
+        }
+
       /* Indicate that the wait is over. */
 
       wtcb->waitobj = NULL;

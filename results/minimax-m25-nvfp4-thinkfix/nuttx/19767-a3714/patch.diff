+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: setresuid
+ *
+ * Description:
+ *   The setresuid() function sets the real, effective, and saved set-user
+ *   IDs of the calling process.
+ *
+ * Input Parameters:
+ *   ruid - Real user identity to set.  The special value (uid_t)-1
+ *          indicates that the real user ID should not be changed.
+ *   euid - Effective user identity to set.  The special value (uid_t)-1
+ *          indicates that the effective user ID should not be changed.
+ *   suid - Saved set-user identity to set.  The special value (uid_t)-1
+ *          indicates that the saved set-user ID should not be changed.
+ *
+ * Returned Value:
+ *   Zero if successful and -1 in case of failure, in which case errno is set
+ *   appropriately.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SCHED_USER_IDENTITY
+int setresuid(uid_t ruid, uid_t euid, uid_t suid)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  FAR struct task_group_s *rgroup = rtcb->group;
+  uid_t old_ruid;
+  uid_t old_euid;
+  uid_t old_suid;
+
+  DEBUGASSERT(rgroup != NULL);
+
+  old_ruid = rgroup->tg_uid;
+  old_euid = rgroup->tg_euid;
+  old_suid = rgroup->tg_suid;
+
+  /* Check for -1 values that should be left unchanged */
+
+  if (ruid == (uid_t)-1)
+    {
+      ruid = old_ruid;
+    }
+
+  if (euid == (uid_t)-1)
+    {
+      euid = old_euid;
+    }
+
+  if (suid == (uid_t)-1)
+    {
+      suid = old_suid;
+    }
+
+  /* When the effective UID is 0 (super-user), arbitrary values may
+   * be assigned.
+   */
+
+  if (old_euid == 0)
+    {
+      rgroup->tg_uid = ruid;
+      rgroup->tg_euid = euid;
+      rgroup->tg_suid = suid;
+      return 0;
+    }
+
+  /* Non-super-user: each requested value must be one of the current
+   * real, effective, or saved values.
+   */
+
+  if (ruid != (uid_t)-1 &&
+      ruid != old_ruid && ruid != old_euid && ruid != old_suid)
+    {
+      set_errno(EPERM);
+      return -1;
+    }
+
+  if (euid != (uid_t)-1 &&
+      euid != old_ruid && euid != old_euid && euid != old_suid)
+    {
+      set_errno(EPERM);
+      return -1;
+    }
+
+  if (suid != (uid_t)-1 &&
+      suid != old_ruid && suid != old_euid && suid != old_suid)
+    {
+      set_errno(EPERM);
+      return -1;
+    }
+
+  rgroup->tg_uid = ruid;
+  rgroup->tg_euid = euid;
+  rgroup->tg_suid = suid;
+
+  return 0;
+}
+#endif

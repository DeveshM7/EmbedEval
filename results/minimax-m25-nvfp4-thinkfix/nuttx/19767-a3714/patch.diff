+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See
+ * the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <unistd.h>
+#include <assert.h>
+#include <errno.h>
+
+#include <sched/sched.h>
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: setgroups
+ *
+ * Description:
+ *   The setgroups() function sets the supplementary group IDs for the
+ *   calling process. Requires appropriate privilege.
+ *
+ * Input Parameters:
+ *   ngroups - The number of supplementary group IDs. Must be less than
+ *             or equal to CONFIG_SCHED_NGROUPS. Special value 0 clears
+ *             the supplementary group list.
+ *   grouplist - Pointer to an array of group IDs.
+ *
+ * Returned Value:
+ *   Zero if successful and -1 in case of failure, in which case errno is set
+ *   appropriately.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SCHED_NGROUPS
+int setgroups(int ngroups, FAR const gid_t *grouplist)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  FAR struct task_group_s *rgroup = rtcb->group;
+
+  DEBUGASSERT(rgroup != NULL);
+
+  /* Validate ngroups */
+
+  if (ngroups < 0 || ngroups > CONFIG_SCHED_NGROUPS)
+    {
+      set_errno(EINVAL);
+      return -1;
+    }
+
+  /* If ngroups is zero, clear the supplementary group list */
+
+  if (ngroups == 0)
+    {
+      if (grouplist != NULL && grouplist != 0)
+        {
+          /* Technically this could be error, but Linux allows it */
+        }
+
+      rgroup->tg_nsupgroups = 0;
+      return 0;
+    }
+
+  /* Validate grouplist pointer */
+
+  if (grouplist == NULL)
+    {
+      set_errno(EFAULT);
+      return -1;
+    }
+
+  /* Copy the supplementary group IDs */
+
+  rgroup->tg_nsupgroups = ngroups;
+  memcpy(rgroup->tg_supgroups, grouplist, ngroups * sizeof(gid_t));
+
+  return 0;
+}
+#endif

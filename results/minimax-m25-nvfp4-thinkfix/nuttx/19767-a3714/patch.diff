+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See
+ * the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <unistd.h>
+#include <assert.h>
+#include <errno.h>
+
+#include <sched/sched.h>
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: setresgid
+ *
+ * Description:
+ *   The setresgid() function sets the real, effective, and saved set-group
+ *   IDs of the calling process.
+ *
+ * Input Parameters:
+ *   rgid - Real group identity to set.  The special value (gid_t)-1
+ *          indicates that the real group ID should not be changed.
+ *   egid - Effective group identity to set.  The special value (gid_t)-1
+ *          indicates that the effective group ID should not be changed.
+ *   sgid - Saved set-group identity to set.  The special value (gid_t)-1
+ *          indicates that the saved set-group ID should not be changed.
+ *
+ * Returned Value:
+ *   Zero if successful and -1 in case of failure, in which case errno is set
+ *   appropriately.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SCHED_USER_IDENTITY
+int setresgid(gid_t rgid, gid_t egid, gid_t sgid)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  FAR struct task_group_s *rgroup = rtcb->group;
+  gid_t old_rgid;
+  gid_t old_egid;
+  gid_t old_sgid;
+
+  DEBUGASSERT(rgroup != NULL);
+
+  old_rgid = rgroup->tg_gid;
+  old_egid = rgroup->tg_egid;
+  old_sgid = rgroup->tg_sgid;
+
+  /* Check for -1 values that should be left unchanged */
+
+  if (rgid == (gid_t)-1)
+    {
+      rgid = old_rgid;
+    }
+
+  if (egid == (gid_t)-1)
+    {
+      egid = old_egid;
+    }
+
+  if (sgid == (gid_t)-1)
+    {
+      sgid = old_sgid;
+    }
+
+  /* When the effective UID is 0 (super-user), arbitrary values may
+   * be assigned. But wait - we need to check the effective UID, not GID.
+   * Actually, we need to check if the effective UID is 0 to allow
+   * arbitrary GID changes.
+   */
+
+  if (rgroup->tg_euid == 0)
+    {
+      rgroup->tg_gid = rgid;
+      rgroup->tg_egid = egid;
+      rgroup->tg_sgid = sgid;
+      return 0;
+    }
+
+  /* Non-super-user: each requested value must be one of the current
+   * real, effective, or saved values.
+   */
+
+  if (rgid != (gid_t)-1 &&
+      rgid != old_rgid && rgid != old_egid && rgid != old_sgid)
+    {
+      set_errno(EPERM);
+      return -1;
+    }
+
+  if (egid != (gid_t)-1 &&
+      egid != old_rgid && egid != old_egid && egid != old_sgid)
+    {
+      set_errno(EPERM);
+      return -1;
+    }
+
+  if (sgid != (gid_t)-1 &&
+      sgid != old_rgid && sgid != old_egid && sgid != old_sgid)
+    {
+      set_errno(EPERM);
+      return -1;
+    }
+
+  rgroup->tg_gid = rgid;
+  rgroup->tg_egid = egid;
+  rgroup->tg_sgid = sgid;
+
+  return 0;
+}
+#endif

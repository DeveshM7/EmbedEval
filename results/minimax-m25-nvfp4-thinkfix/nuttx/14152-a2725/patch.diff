diff --git a/libs/libc/machine/arm/gnu/arch_setjmp.S b/libs/libc/machine/arm/gnu/arch_setjmp.S
index c4a26fcb..bf8404ce 100644
--- a/libs/libc/machine/arm/gnu/arch_setjmp.S
+++ b/libs/libc/machine/arm/gnu/arch_setjmp.S
@@ -170,7 +170,9 @@ longjmp:
 	vmsr		fpscr, r2			/* Restore the FPSCR */
 #endif /* CONFIG_ARCH_FPU */
 
-	mov		r0, r1				/* return val */
+	/* Return val, but ensure 0 is returned as 1 per POSIX */
+	movs		r0, r1
+	moveq		r0, #1
 	bx		lr
 
 	.size	longjmp, .-longjmp
diff --git a/libs/libc/machine/sim/arch_setjmp_x86.S b/libs/libc/machine/sim/arch_setjmp_x86.S
index 439e2133..6e3c48c5 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86.S
+++ b/libs/libc/machine/sim/arch_setjmp_x86.S
@@ -85,8 +85,12 @@ SYMBOL(setjmp):
 SYMBOL(longjmp):
 	movl	4(%esp), %ecx      /* jmpbuf in %ecx.  */
 	movl	8(%esp), %eax      /* Second argument is return value.  */
+	testl	%eax, %eax
+	jnz	1f
+	incl	%eax
 
 	/* Save the return address now.  */
+1:
 
 	movl	(JB_PC)(%ecx), %edx
 
diff --git a/libs/libc/machine/sim/arch_setjmp_x86.asm b/libs/libc/machine/sim/arch_setjmp_x86.asm
index 70c27308..d8b14df1 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86.asm
+++ b/libs/libc/machine/sim/arch_setjmp_x86.asm
@@ -58,7 +58,10 @@ setjmp:
 longjmp:
 	mov	ecx, dword ptr [esp+4]	; jmpbuf in ecx.
 	mov	eax, dword ptr [esp+8]	; Second argument is return value
-
+	test	eax, eax
+	jnz	short l1
+	inc	eax
+l1:
 	; Save the return address now
 
 	mov	edx, dword ptr [ecx+14h]
diff --git a/libs/libc/machine/sim/arch_setjmp_x86_64.S b/libs/libc/machine/sim/arch_setjmp_x86_64.S
index 62c15ff3..097f91eb 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86_64.S
+++ b/libs/libc/machine/sim/arch_setjmp_x86_64.S
@@ -130,8 +130,12 @@ SYMBOL(longjmp):
 	/* Setup return value */
 
 	movl	%esi,%eax
+	testl	%eax,%eax
+	jnz	1f
+	incl	%eax
 
 	/* Restore registers */
+1:
 
 	movq	JB_RBX(REGS),%rbx	/* Load 1: rbx */
 	movq	JB_RSP(REGS),%rsp	/* Load 2: rsp */
diff --git a/libs/libc/machine/sim/arch_setjmp_x86_64.asm b/libs/libc/machine/sim/arch_setjmp_x86_64.asm
index 2ef7f529..7ef91a6d 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86_64.asm
+++ b/libs/libc/machine/sim/arch_setjmp_x86_64.asm
@@ -66,7 +66,10 @@ longjmp:
 	; Setup return value
 
 	mov rax, rdx
-
+	test rax, rax
+	jnz short l1
+	inc rax
+l1:
 	; Restore registers
 
 	mov rbx, [rcx]

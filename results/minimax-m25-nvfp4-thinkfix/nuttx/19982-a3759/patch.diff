+  return work_thread_create(HPWORKNAME,
+                            CONFIG_SCHED_HPWORKPRIORITY,
+                            hp_work_stack,
+                            CONFIG_SCHED_HPWORKSTACKSIZE,
+                            (FAR struct kwork_wqueue_s *)&g_hpwork);
+#else
+  return work_thread_create(HPWORKNAME, CONFIG_SCHED_HPWORKPRIORITY, NULL,
+                            CONFIG_SCHED_HPWORKSTACKSIZE,
+                            (FAR struct kwork_wqueue_s *)&g_hpwork);
+#endif
+}

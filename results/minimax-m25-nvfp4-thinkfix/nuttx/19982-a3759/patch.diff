+
+  sinfo("Starting high-priority kernel worker thread(s)\n");
+
+#ifdef SCHED_HPWORKSTACKSECTION
+  static uint8_t hp_work_stack[CONFIG_SCHED_HPNTHREADS]
+                              [CONFIG_SCHED_HPWORKSTACKSIZE]

+
+  pid = nxsched_gettid();
+  for (wndx = 0; wndx < wqueue->nthreads; wndx++)
+    {
+      FAR struct kworker_s *worker = wq_get_worker(wqueue);
+      if (worker[wndx].pid == pid)
+        {
+          return -EDEADLK;
+        }
+    }
+
   wd_cancel(&wqueue->timer);
 
   /* Mark the work queue as exiting */
@@ -533,6 +549,13 @@ int work_queue_priority_wq(FAR struct kwork_wqueue_s *wqueue)
 
 int work_queue_priority(int qid)
 {
+#if defined(CONFIG_LIBC_USRWORK)
+  if (qid == USRWORK)
+    {
+      return CONFIG_LIBC_USRWORKPRIORITY;
+    }
+#endif
+
   return work_queue_priority_wq(work_qid2wq(qid));
 }
 

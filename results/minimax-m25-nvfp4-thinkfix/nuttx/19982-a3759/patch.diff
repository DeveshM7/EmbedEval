@@ -429,6 +429,7 @@ FAR struct kwork_wqueue_s *work_queue_create(FAR const char *name,
   nxsem_init(&wqueue->exsem, 0, 0);
   wqueue->nthreads = nthreads;
   spin_lock_init(&wqueue->lock);
+  wqueue->dynamic = true;
 
   /* Create the work queue thread pool */
 
@@ -461,12 +462,27 @@ FAR struct kwork_wqueue_s *work_queue_create(FAR const char *name,
 int work_queue_free(FAR struct kwork_wqueue_s *wqueue)
 {
   int wndx;
+  pid_t pid;
 
-  if (wqueue == NULL)
+  if (wqueue == NULL || !wqueue->dynamic)
     {
       return -EINVAL;

diff --git a/tmp/memmem_test_insert.c b/tmp/memmem_test_insert.c
new file mode 100644
index 00000000..e894616b
--- /dev/null
+++ b/tmp/memmem_test_insert.c
@@ -0,0 +1,102 @@
+/****************************************************************************
+ * memmem test
+ ****************************************************************************/
+
+static void memmem_test(void)
+{
+  /* Test case 1: needle ends exactly at haystack end
+   * memmem("hello", 5, "lo", 2) should return pointer to "lo" at offset 3
+   */
+
+  const char haystack1[] = "hello";
+  const char *needle1 = "lo";
+  void *result1 = memmem(haystack1, 5, needle1, 2);
+  
+  printf("memmem test 1: haystack=\"hello\", needle=\"lo\"\n");
+  if (result1 != NULL && result1 == haystack1 + 3)
+    {
+      printf("  PASS: returned %p (expected %p)\n", result1, haystack1 + 3);
+    }
+  else
+    {
+      printf("  FAIL: returned %p (expected %p)\n", result1, haystack1 + 3);
+      ASSERT(false);
+    }
+
+  /* Test case 2: needle at end including NUL terminator
+   * memmem("hello\0", 6, "o\0", 2) should return pointer to "o\0" at offset 4
+   */
+
+  const char haystack2[] = "hello\0";
+  const char *needle2 = "o\0";
+  void *result2 = memmem(haystack2, 6, needle2, 2);
+  
+  printf("memmem test 2: haystack=\"hello\\0\", needle=\"o\\0\"\n");
+  if (result2 != NULL && result2 == haystack2 + 4)
+    {
+      printf("  PASS: returned %p (expected %p)\n", result2, haystack2 + 4);
+    }
+  else
+    {
+      printf("  FAIL: returned %p (expected %p)\n", result2, haystack2 + 4);
+      ASSERT(false);
+    }
+
+  /* Test case 3: zero-length needle
+   * memmem("hello", 5, "", 0) should return haystack pointer
+   */
+
+  const char haystack3[] = "hello";
+  void *result3 = memmem(haystack3, 5, "", 0);
+  
+  printf("memmem test 3: haystack=\"hello\", needle=\"\" (len=0)\n");
+  if (result3 == haystack3)
+    {
+      printf("  PASS: returned %p (expected %p)\n", result3, haystack3);
+    }
+  else
+    {
+      printf("  FAIL: returned %p (expected %p)\n", result3, haystack3);
+      ASSERT(false);
+    }
+
+  /* Test case 4: needle longer than haystack
+   * memmem("hi", 2, "hello", 5) should return NULL
+   */
+
+  const char haystack4[] = "hi";
+  void *result4 = memmem(haystack4, 2, "hello", 5);
+  
+  printf("memmem test 4: haystack=\"hi\", needle=\"hello\" (needle longer)\n");
+  if (result4 == NULL)
+    {
+      printf("  PASS: returned NULL (expected NULL)\n");
+    }
+  else
+    {
+      printf("  FAIL: returned %p (expected NULL)\n", result4);
+      ASSERT(false);
+    }
+
+  /* Test case 5: basic middle match
+   * memmem("hello", 5, "ell", 3) should return pointer to "ell" at offset 1
+   */
+
+  const char haystack5[] = "hello";
+  const char *needle5 = "ell";
+  void *result5 = memmem(haystack5, 5, needle5, 3);
+  
+  printf("memmem test 5: haystack=\"hello\", needle=\"ell\"\n");
+  if (result5 != NULL && result5 == haystack5 + 1)
+    {
+      printf("  PASS: returned %p (expected %p)\n", result5, haystack5 + 1);
+    }
+  else
+    {
+      printf("  FAIL: returned %p (expected %p)\n", result5, haystack5 + 1);
+      ASSERT(false);
+    }
+
+  printf("memmem tests: PASSED\n");
+}
+

@@ -88,6 +89,20 @@ int nxthread_create(FAR const char *name, uint8_t ttype, int priority,
 
   /* Allocate a TCB for the new task. */
 
+#ifdef CONFIG_SCHED_CAPABILITIES
+  /* Check if the caller has PR_CAP_SPAWN capability for user tasks */
+  if ((ttype & TCB_FLAG_TTYPE_MASK) != TCB_FLAG_TTYPE_KERNEL)
+    {
+      FAR struct tcb_s *rtcb = this_task();
+      if (rtcb != NULL && rtcb->group != NULL &&
+          (rtcb->group->tg_caps & PR_CAP_SPAWN) == 0)
+        {
+          serr("ERROR: Caller does not have PR_CAP_SPAWN capability\n");
+          return -EPERM;
+        }
+    }
+#endif
+
   tcb = kmm_zalloc(sizeof(struct tcb_s));
   if (!tcb)
     {
diff --git a/sched/task/task_prctl.c b/sched/task/task_prctl.c
index b065eeae..0fa2fcfe 100644
--- a/sched/task/task_prctl.c
+++ b/sched/task/task_prctl.c
@@ -187,6 +187,39 @@ int prctl(int option, ...)
         goto errout;
 #endif
 
+      case PR_CAPS_GET:
+      case PR_CAPS_DROP:
+#ifdef CONFIG_SCHED_CAPABILITIES
+        {
+          FAR struct tcb_s *tcb = this_task();
+
+          if (tcb == NULL || tcb->group == NULL)
+            {
+              errcode = ESRCH;
+              goto errout;
+            }
+
+          if (option == PR_CAPS_GET)
+            {
+              /* Return the current capability set */
+              va_end(ap);
+              return tcb->group->tg_caps;
+            }
+          else
+            {
+              /* PR_CAPS_DROP: Drop the specified capabilities */
+              unsigned int drop_mask = va_arg(ap, unsigned int);
+
+              /* Only drop capabilities; cannot gain new ones */
+              tcb->group->tg_caps &= ~drop_mask;
+            }
+        }
+        break;
+#else
+        serr("ERROR: Option not enabled: %d\n", option);
+        errcode = ENOSYS;
+        goto errout;
+#endif
       default:
         serr("ERROR: Unrecognized option: %d\n", option);
         errcode = EINVAL;

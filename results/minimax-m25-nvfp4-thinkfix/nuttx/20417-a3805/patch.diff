@@ -79,6 +79,40 @@
 #define PR_SET_DUMPABLE 5
 #define PR_GET_DUMPABLE 6
 
+/* Process capability commands (CONFIG_SCHED_CAPABILITIES)
+ *
+ *  PR_CAPS_GET
+ *    Return the current capability set of the calling process.
+ *    The return value is a bitmask of capabilities.
+ *
+ *  PR_CAPS_DROP
+ *    Remove the named capabilities from the calling process.
+ *    The argument is a bitmask of capabilities to drop.
+ *    Once dropped, a capability cannot be regained.
+ *
+ * Capability definitions:
+ *
+ *  PR_CAP_RAWIO
+ *    Required for raw I/O operations like mounting filesystems.
+ *
+ *  PR_CAP_SPAWN
+ *    Required for creating new tasks.
+ *
+ *  PR_CAP_ADMIN
+ *    Required for administrative board-control operations.
+ *
+ *  PR_CAP_ALL
+ *    Represents all capabilities.
+ */
+
+#define PR_CAPS_GET    7
+#define PR_CAPS_DROP   8
+
+#define PR_CAP_RAWIO   (1 << 0)
+#define PR_CAP_SPAWN   (1 << 1)
+#define PR_CAP_ADMIN  (1 << 2)
+#define PR_CAP_ALL    (PR_CAP_RAWIO | PR_CAP_SPAWN | PR_CAP_ADMIN)
+
 /****************************************************************************
  * Public Type Definitions
  ****************************************************************************/
diff --git a/sched/group/group_create.c b/sched/group/group_create.c
index 71e288c7..63e4ad01 100644
--- a/sched/group/group_create.c
+++ b/sched/group/group_create.c
@@ -36,6 +36,7 @@
 #include <nuttx/kmalloc.h>
 #include <nuttx/semaphore.h>
 #include <nuttx/sched.h>
+#include <sys/prctl.h>
 
 #include "sched/sched.h"
 #include "group/group.h"
@@ -99,6 +100,35 @@ static inline void group_inherit_identity(FAR struct task_group_s *group)
 }
 #else
 #  define group_inherit_identity(group)
+
+#ifdef CONFIG_SCHED_CAPABILITIES
+static inline void group_inherit_caps(FAR struct task_group_s *group,
+                                        uint8_t ttype)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  FAR struct task_group_s *rgroup = rtcb->group;
+
+  DEBUGASSERT(group != NULL);
+
+  if (ttype == TCB_FLAG_TTYPE_KERNEL)
+    {
+      /* Kernel threads get all capabilities */
+      group->tg_caps = PR_CAP_ALL;
+    }
+  else if (rgroup != NULL)
+    {
+      /* Inherit capabilities from parent */
+      group->tg_caps = rgroup->tg_caps;
+    }
+  else
+    {
+      /* If no parent (should not happen), give all capabilities */
+      group->tg_caps = PR_CAP_ALL;
+    }
+}
+#else
+#  define group_inherit_caps(group, ttype)
+#endif
 #endif
 
 #ifdef CONFIG_FS_CHROOT
@@ -244,6 +274,10 @@ int group_allocate(FAR struct tcb_s *tcb, uint8_t ttype)
 
   group_inherit_identity(group);
 
+  /* Inherit the capabilities from the parent task group */
+
+  group_inherit_caps(group, ttype);
+
   ret = group_inherit_chroot(group, ttype);
   if (ret < 0)
     {
diff --git a/sched/task/task_create.c b/sched/task/task_create.c

diff --git a/sched/signal/sig_deliver.c b/sched/signal/sig_deliver.c
index d0739f97..3bed4105 100644
--- a/sched/signal/sig_deliver.c
+++ b/sched/signal/sig_deliver.c
@@ -53,6 +53,7 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
 {
   FAR sigq_t *sigq;
   sigset_t    savesigprocmask;
+  int         saved_errcode;
   sigset_t    newsigprocmask;
   sigset_t    altsigprocmask;
   irqstate_t  flags;
@@ -109,6 +110,13 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
       newsigprocmask    = savesigprocmask | sigq->mask;
       stcb->sigprocmask = newsigprocmask;
 
+
+      /* Save the errcode.  This must be preserved throughout the signal
+       * handling so that the interrupted system call gets the correct
+       * error code (likely EINTR).
+       */
+
+      saved_errcode = stcb->errcode;
 #ifndef CONFIG_BUILD_FLAT
       /* In the kernel build this has to be handled differently if we are
        * dispatching to a signal handler in a user-space task or thread; we
@@ -160,6 +168,14 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
                                      NULL);
         }
 
+
+      /* Restore the saved errcode value.  This is needed because the
+       * signal handler may have interrupted a system call that uses
+       * errcode to return an error (e.g., sem_wait() returning EINTR
+       * when interrupted by a signal).
+       */
+
+      stcb->errcode = saved_errcode;
       /* Indicate that a signal has been delivered */
 
       flags             = enter_critical_section();

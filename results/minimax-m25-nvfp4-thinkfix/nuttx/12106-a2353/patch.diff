diff --git a/sched/pthread/pthread_completejoin.c b/sched/pthread/pthread_completejoin.c
index bcc3637c..6cfad0b7 100644
--- a/sched/pthread/pthread_completejoin.c
+++ b/sched/pthread/pthread_completejoin.c
@@ -97,11 +97,19 @@ int pthread_completejoin(pid_t pid, FAR void *exit_value)
     }
   else if (!sq_is_singular(&tcb->group->tg_members))
     {
-      ret = pthread_findjoininfo(tcb->group, pid, &join, true);
-      if (ret == OK)
+      /* Only create join info for non-detached threads. Detached threads
+       * do not need join info since they cannot be joined, and avoiding
+       * creation prevents memory leaks from detached threads that never
+       * get joined.
+       */
+
+      if ((tcb->flags & TCB_FLAG_DETACHED) == 0)
         {
-          join->detached = !!(tcb->flags & TCB_FLAG_DETACHED);
-          join->exit_value = exit_value;
+          ret = pthread_findjoininfo(tcb->group, pid, &join, true);
+          if (ret == OK)
+            {
+              join->exit_value = exit_value;
+            }
         }
     }
 

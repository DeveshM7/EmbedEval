+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <assert.h>
+#include <errno.h>
+#include <debug.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/irq.h>
+#include <nuttx/sched.h>
+#include <nuttx/spinlock.h>
+#include <nuttx/sched_note.h>
+
+#include "sched/sched.h"
+
+#ifdef CONFIG_SMP_CALL
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+/* This structure describes a pending SMP function call */
+
+struct smp_call_s
+{
+  FAR void *arg;
+  int (*func)(FAR void *arg);
+  volatile int result;
+  volatile bool done;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* Pending call data - one per CPU */
+
+static struct smp_call_s g_smp_call_data[CONFIG_SMP_NCPUS];
+
+/* Track pending calls for each CPU */
+
+static volatile bool g_smp_call_pending[CONFIG_SMP_NCPUS];
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: smp_call_handler
+ *
+ * Description:
+ *   This is the SGI handler for SMP function calls.
+ *
+ * Input Parameters:
+ *   irq - The interrupt request (should be SMP_CALL_SGI)
+ *   context - Interrupt context
+ *   arg - User-provided argument
+ *
+ * Returned Value:
+ *   OK on success; a negated errno value on failure.
+ *
+ ****************************************************************************/
+
+static int smp_call_handler(int irq, FAR void *context, FAR void *arg)
+{
+  int cpu = this_cpu();
+  FAR struct smp_call_s *data;
+  irqstate_t flags;
+
+  /* Disable interrupts to protect access to the pending flag */
+
+  flags = enter_critical_section();
+
+  /* Check if there is a pending call for this CPU */
+
+  if (g_smp_call_pending[cpu])
+    {
+      /* Get the call data */
+
+      data = (FAR struct smp_call_s *)&g_smp_call_data[cpu];
+
+      /* Clear the pending flag */
+
+      g_smp_call_pending[cpu] = false;
+
+      /* Execute the callback */
+
+      if (data->func != NULL)
+        {
+          data->result = data->func(data->arg);
+        }
+      else
+        {
+          data->result = -EINVAL;
+        }
+
+      /* Mark the call as done */
+
+      data->done = true;
+    }
+
+  leave_critical_section(flags);
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: nxsched_smp_call_init
+ *
+ * Description:
+ *   Initialize the SMP call handler. This should be called during SMP
+ *   initialization.
+ *
+ ****************************************************************************/
+
+void nxsched_smp_call_init(void)
+{
+  /* Attach the SGI handler for SMP function calls.
+   * The SGI number is configured via CONFIG_SMP_CALL_SGI.
+   */
+
+  irq_attach(CONFIG_SMP_CALL_SGI, smp_call_handler, NULL);
+
+  /* Enable the SGI interrupt */
+
+#ifdef CONFIG_ARCH_ARM64
+  up_enable_irq(CONFIG_SMP_CALL_SGI);
+#endif
+}
+
+/****************************************************************************
+ * Name: nxsched_smp_call_function
+ *
+ * Description:
+ *   Request a function to be executed on a specific CPU.
+ *
+ * Input Parameters:
+ *   cpu - The CPU index to target
+ *   func - The function to execute
+ *   arg - The argument to pass to the function
+ *   wait - true: wait for the function to complete
+ *
+ * Returned Value:
+ *   OK on success; a negated errno value on failure.
+ *
+ ****************************************************************************/
+
+static int nxsched_smp_call_function(int cpu, int (*func)(FAR void *arg),
+                                    FAR void *arg, bool wait)
+{
+  FAR struct smp_call_s *data;
+  irqstate_t flags;
+  int ret = OK;
+
+  DEBUGASSERT(cpu >= 0 && cpu < CONFIG_SMP_NCPUS);
+  DEBUGASSERT(func != NULL);
+
+  data = (FAR struct smp_call_s *)&g_smp_call_data[cpu];
+
+  /* Take the lock to protect access to the call data */
+
+  flags = enter_critical_section();
+
+  /* Initialize the call data */
+
+  data->func = func;
+  data->arg = arg;
+  data->result = 0;
+  data->done = false;
+
+  /* Set the pending flag */
+
+  g_smp_call_pending[cpu] = true;
+
+  /* Send an SGI to the target CPU */
+
+  up_send_sgi(CONFIG_SMP_CALL_SGI, cpu);
+
+  /* If wait is true, spin until the call completes */
+
+  if (wait)
+    {
+      while (!data->done)
+        {
+          /* Spin... */
+        }
+
+      /* Get the result */
+
+      ret = data->result;
+    }
+
+  leave_critical_section(flags);
+
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxsched_smp_call_single
+ *
+ * Description:
+ *   Request a function to be executed on a single CPU.
+ *
+ *   This function is used to request a callback to be executed on a single
+ *   CPU. The callback is non-blocking and cannot wait or perform blocking
+ *   operations.
+ *
+ * Input Parameters:
+ *   cpu - The CPU index to target
+ *   func - The function to execute
+ *   arg - The argument to pass to the function
+ *   wait - true: wait for the function to complete
+ *
+ * Returned Value:
+ *   OK on success; a negated errno value on failure.  If wait is true, the
+ *   return value is the result of the callback function.
+ *
+ ****************************************************************************/
+
+int nxsched_smp_call_single(int cpu, int (*func)(FAR void *arg),
+                            FAR void *arg, bool wait)
+{
+#ifdef CONFIG_SMP
+  int ret;
+
+  DEBUGASSERT(cpu >= 0 && cpu < CONFIG_SMP_NCPUS);
+  DEBUGASSERT(func != NULL);
+
+  /* If the target is the current CPU, execute the callback directly */
+
+  if (cpu == this_cpu())
+    {
+      ret = func(arg);
+      if (wait && ret < 0)
+        {
+          return ret;
+        }
+
+      /* If wait is false, we still need to return OK since we executed
+       * synchronously
+       */
+
+      return OK;
+    }
+
+  /* Call the function on the target CPU */
+
+  ret = nxsched_smp_call_function(cpu, func, arg, wait);
+
+  /* Check for negative return values if wait is true */
+
+  if (wait && ret < 0)
+    {
+      return ret;
+    }
+
+  return OK;
+#else
+  return -ENOSYS;
+#endif
+}
+
+/****************************************************************************
+ * Name: nxsched_smp_call
+ *
+ * Description:
+ *   Request a function to be executed on a set of CPUs.
+ *
+ *   This function is used to request a callback to be executed on each CPU
+ *   in the provided cpu_set_t. The callback is non-blocking and cannot wait
+ *   or perform blocking operations.
+ *
+ * Input Parameters:
+ *   cpuset - The set of CPUs to target
+ *   func - The function to execute
+ *   arg - The argument to pass to the function
+ *   wait - true: wait for all functions to complete
+ *
+ * Returned Value:
+ *   OK on success; a negated errno value on failure.  If wait is true and
+ *   any callback returns a negative value, that value is returned.
+ *
+ ****************************************************************************/
+
+int nxsched_smp_call(cpu_set_t cpuset, int (*func)(FAR void *arg),
+                    FAR void *arg, bool wait)
+{
+#ifdef CONFIG_SMP
+  cpu_set_t current_cpu;
+  cpu_set_t remote_cpus;
+  int cpu;
+  int ret;
+  int ret_val = OK;
+
+  DEBUGASSERT(func != NULL);
+
+  /* Get the current CPU */
+
+  current_cpu = (1 << this_cpu());
+
+  /* Check if the current CPU is in the cpuset */
+
+  if (cpuset & current_cpu)
+    {
+      /* Execute the callback on the current CPU first */
+
+      ret = func(arg);
+      if (wait && ret < 0)
+        {
+          ret_val = ret;
+        }
+
+      /* Remove the current CPU from the cpuset for remote calls */
+
+      remote_cpus = cpuset & ~current_cpu;
+    }
+  else
+    {
+      remote_cpus = cpuset;
+    }
+
+  /* If there are remote CPUs to call */
+
+  if (remote_cpus != 0)
+    {
+      /* Iterate through each bit in the cpuset */
+
+      for (cpu = 0; cpu < CONFIG_SMP_NCPUS; cpu++)
+        {
+          if (remote_cpus & (1 << cpu))
+            {
+              /* Call the function on this CPU */
+
+              ret = nxsched_smp_call_function(cpu, func, arg, wait);
+              if (wait && ret < 0)
+                {
+                  ret_val = ret;
+                }
+            }
+        }
+    }
+
+  return ret_val;
+#else
+  return -ENOSYS;
+#endif
+}
+
+#endif /* CONFIG_SMP_CALL */

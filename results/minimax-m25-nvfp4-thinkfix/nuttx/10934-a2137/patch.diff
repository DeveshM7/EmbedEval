+/****************************************************************************
+ * Name: up_send_sgi
+ *
+ * Description:
+ *   Send a Software Generated Interrupt (SGI) to a specific CPU.
+ *
+ * Input Parameters:
+ *   sgi - The SGI number (0-15)
+ *   cpu - The CPU index to target
+ *
+ * Returned Value:
+ *   Zero on success; a negated errno value on failure.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SMP
+int up_send_sgi(int sgi, int cpu)
+{
+  DEBUGASSERT(sgi >= 0 && sgi < 16);
+  DEBUGASSERT(cpu >= 0 && cpu < CONFIG_SMP_NCPUS);
+
+  arm64_gic_raise_sgi(sgi, (1 << cpu));
+
+  return OK;
+}
+#endif

+/****************************************************************************
+ * Name: nxsched_smp_call_single
+ *
+ * Description:
+ *   Request a function to be executed on a single CPU.
+ *
+ *   This function is used to request a callback to be executed on a single
+ *   CPU. The callback is non-blocking and cannot wait or perform blocking
+ *   operations.
+ *
+ * Input Parameters:
+ *   cpu  - The CPU index to target
+ *   func - The function to execute
+ *   arg  - The argument to pass to the function
+ *   wait - True to wait for the function to complete
+ *
+ * Returned Value:
+ *   OK on success; a negated errno value on failure.  If wait is true, the
+ *   return value is the result of the callback function.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SMP_CALL
+int nxsched_smp_call_single(int cpu, int (*func)(FAR void *arg),
+                            FAR void *arg, bool wait);
+#endif
+
+/****************************************************************************
+ * Name: nxsched_smp_call
+ *
+ * Description:
+ *   Request a function to be executed on a set of CPUs.
+ *
+ *   This function is used to request a callback to be executed on each CPU
+ *   in the provided cpu_set_t. The callback is non-blocking and cannot wait
+ *   or perform blocking operations.
+ *
+ * Input Parameters:
+ *   cpuset - The set of CPUs to target
+ *   func   - The function to execute
+ *   arg    - The argument to pass to the function
+ *   wait   - True to wait for all functions to complete
+ *
+ * Returned Value:
+ *   OK on success; a negated errno value on failure.  If wait is true and
+ *   any callback returns a negative value, that value is returned.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_SMP_CALL
+int nxsched_smp_call(cpu_set_t cpuset, int (*func)(FAR void *arg),
+                     FAR void *arg, bool wait);
+#endif

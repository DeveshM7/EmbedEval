+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <assert.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "sched/sched.h"
+#include "event/event.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_init
+ *
+ * Description:
+ *   This function initializes the event group, setting its initial event
+ *   mask.
+ *
+ * Input Parameters:
+ *   event - Event group to initialize
+ *   events - Initial pending events
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ ****************************************************************************/
+
+int nxevent_init(FAR nxevent_t *event, uint32_t events)
+{
+  DEBUGASSERT(event != NULL);
+
+  if (event == NULL)
+    {
+      return -EINVAL;
+    }
+
+  /* Initialize the event group */
+
+  event->events = events;
+  dq_init(&event->waitlist);
+
+  return OK;
+}
diff --git a/sched/event/event_post.c b/sched/event/event_post.c
new file mode 100644
index 00000000..280601b1
--- /dev/null
+++ b/sched/event/event_post.c
@@ -0,0 +1,281 @@
+/****************************************************************************
+ * sched/event/event_post.c
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <assert.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "sched/sched.h"
+#include "event/event.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_post
+ *
+ * Description:
+ *   This function posts events to the event group. By default, the events
+ *   are merged with the current pending mask. If the supplied events mask
+ *   is zero, it is treated as an "any" delivery and will wake blocked
+ *   waiters immediately.
+ *
+ * Input Parameters:
+ *   event - Event group to post to
+ *   events - Events to post
+ *   flags - Reserved for future use (must be 0)
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ * Assumptions:
+ *   This function may be called from an interrupt handler.
+ *
+ ****************************************************************************/
+
+int nxevent_post(FAR nxevent_t *event, uint32_t events, int flags)
+{
+  FAR struct tcb_s *wtcb;
+  irqstate_t flags_state;
+  uint32_t post_events;
+  uint32_t remaining;
+  bool switch_needed = false;
+
+  DEBUGASSERT(event != NULL);
+
+  if (event == NULL)
+    {
+      return -EINVAL;
+    }
+
+  /* The following operations must be performed with interrupts
+   * disabled because this function may be called from an interrupt
+   * handler.
+   */
+
+  flags_state = enter_critical_section();
+
+  /* Determine the events to post */
+
+  if (events == 0)
+    {
+      /* Zero events means "wake all waiters immediately" - treat as
+       * any delivery. We don't clear the existing pending events,
+       * we just wake waiters.
+       */
+
+      post_events = 0;  /* Special: wake all */
+    }
+  else if ((flags & NXEVENT_POST_ALL) != 0)
+    {
+      /* Post all bits in the events mask */
+
+      post_events = events;
+    }
+  else
+    {
+      /* Default: merge with existing pending events */
+
+      post_events = events;
+    }
+
+  if (post_events != 0)
+    {
+      /* Merge the events into the pending mask */
+
+      event->events |= post_events;
+    }
+
+  /* Now check if there are any waiters that should be woken.
+   * Walk through the waiting list and check each waiter.
+   * We need to be careful here because we may remove items from
+   * the list while iterating.
+   */
+
+  remaining = event->events;
+
+  /* If no events are pending, there's nothing to do */
+
+  if (remaining == 0)
+    {
+      leave_critical_section(flags_state);
+      return OK;
+    }
+
+  /* Process each waiting task - iterate using flink.
+   * We need to save the next pointer BEFORE removing from the list.
+   */
+
+  wtcb = (FAR struct tcb_s *)event->waitlist.head;
+  while (wtcb != NULL)
+    {
+      FAR struct tcb_s *next;
+      uint32_t wait_events;
+      int wait_flags;
+      bool wake = false;
+      uint32_t matched = 0;
+
+      /* Get the next waiter first (in case we remove this one) */
+
+      next = wtcb->flink;
+
+      /* Get the wait parameters from the waitobj field.
+       * We encode both events and flags in the pointer.
+       */
+
+      wait_events = NXEVENT_DECODE_EVENTS(wtcb->waitobj);
+      wait_flags  = NXEVENT_DECODE_FLAGS(wtcb->waitobj);
+
+      /* Check if this waiter should be woken */
+
+      if (post_events == 0)
+        {
+          /* Zero events posted - wake everyone waiting on this event */
+
+          wake = true;
+          matched = remaining;
+        }
+      else if (wait_events == 0)
+        {
+          /* Waiter wants any event - wake if there's anything pending */
+
+          if (remaining != 0)
+            {
+              wake = true;
+              matched = remaining;
+            }
+        }
+      else if ((wait_flags & NXEVENT_WAIT_ALL) != 0)
+        {
+          /* Waiter wants ALL events - check if all requested bits
+           * are now pending
+           */
+
+          if ((remaining & wait_events) == wait_events)
+            {
+              wake = true;
+              matched = wait_events;
+            }
+        }
+      else
+        {
+          /* Waiter wants ANY of the events - check if any requested
+           * bit is now pending
+           */
+
+          if ((remaining & wait_events) != 0)
+            {
+              wake = true;
+              matched = remaining & wait_events;
+            }
+        }
+
+      if (wake)
+        {
+          /* Remove this waiter from the list.
+           * Use dq_rem to properly remove from the doubly-linked list.
+           */
+
+          if (wtcb->blink != NULL)
+            {
+              wtcb->blink->flink = wtcb->flink;
+            }
+          else
+            {
+              /* Was the head of the list */
+
+              event->waitlist.head = wtcb->flink;
+            }
+
+          if (wtcb->flink != NULL)
+            {
+              wtcb->flink->blink = wtcb->blink;
+            }
+          else
+            {
+              /* Was the tail of the list */
+
+              event->waitlist.tail = wtcb->blink;
+            }
+
+          /* Cancel the watchdog timer */
+
+          if (WDOG_ISACTIVE(&wtcb->waitdog))
+            {
+              wd_cancel(&wtcb->waitdog);
+            }
+
+          /* Store the matched events in the waitobj before waking.
+           * The waiting function will retrieve this.
+           */
+
+          wtcb->waitobj = (FAR void *)(uintptr_t)matched;
+
+          /* Clear the consumed events if requested */
+
+          if ((wait_flags & NXEVENT_WAIT_CLEAR) == 0 && matched != 0)
+            {
+              event->events &= ~matched;
+            }
+
+          /* Add the task to ready-to-run list */
+
+          wtcb->task_state = TSTATE_TASK_READYTORUN;
+          if (nxsched_add_prioritized(wtcb, list_readytorun()))
+            {
+              switch_needed = true;
+            }
+        }
+
+      wtcb = next;
+    }
+
+  /* Perform context switch if needed */
+
+  if (switch_needed)
+    {
+      if (up_interrupt_context())
+        {
+          /* We can't do a context switch from an interrupt context.
+           * The pending context switch will be handled on exit from
+           * the interrupt.
+           */
+        }
+      else
+        {
+          FAR struct tcb_s *rtcb = this_task();
+          up_switch_context(rtcb, rtcb);
+        }
+    }
+
+  leave_critical_section(flags_state);
+
+  return OK;
+}

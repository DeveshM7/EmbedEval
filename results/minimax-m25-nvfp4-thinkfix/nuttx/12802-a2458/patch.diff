+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <assert.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "sched/sched.h"
+#include "event/event.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_reset
+ *
+ * Description:
+ *   This function resets the event group to a new pending event mask,
+ *   waking any waiters whose conditions are now satisfied.
+ *
+ * Input Parameters:
+ *   event - Event group to reset
+ *   events - New pending event mask
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ * Assumptions:
+ *   This function may be called from an interrupt handler.
+ *
+ ****************************************************************************/
+
+int nxevent_reset(FAR nxevent_t *event, uint32_t events)
+{
+  irqstate_t flags;
+  uint32_t old_events;
+
+  DEBUGASSERT(event != NULL);
+
+  if (event == NULL)
+    {
+      return -EINVAL;
+    }
+
+  flags = enter_critical_section();
+
+  /* Save the old events */
+
+  old_events = event->events;
+
+  /* Set the new events */
+
+  event->events = events;
+
+  /* If the new events cause any waiters to be satisfied, wake them.
+   * We do this by calling nxevent_post with zero events, which will
+   * check all waiters against the new pending mask.
+   */
+
+  if (events != 0 && old_events != events)
+    {
+      /* Need to check waiters - use nxevent_post logic */
+
+      FAR struct tcb_s *wtcb;
+      uint32_t remaining = event->events;
+      bool switch_needed = false;
+
+      /* Process each waiting task */
+
+      wtcb = (FAR struct tcb_s *)event->waitlist.head;
+      while (wtcb != NULL)
+        {
+          FAR struct tcb_s *next;
+          uint32_t wait_events;
+          int wait_flags;
+          bool wake = false;
+          uint32_t matched = 0;
+
+          next = wtcb->flink;
+
+          wait_events = NXEVENT_DECODE_EVENTS(wtcb->waitobj);
+          wait_flags  = NXEVENT_DECODE_FLAGS(wtcb->waitobj);
+
+          if (wait_events == 0)
+            {
+              if (remaining != 0)
+                {
+                  wake = true;
+                  matched = remaining;
+                }
+            }
+          else if ((wait_flags & NXEVENT_WAIT_ALL) != 0)
+            {
+              if ((remaining & wait_events) == wait_events)
+                {
+                  wake = true;
+                  matched = wait_events;
+                }
+            }
+          else
+            {
+              if ((remaining & wait_events) != 0)
+                {
+                  wake = true;
+                  matched = remaining & wait_events;
+                }
+            }
+
+          if (wake)
+            {
+              /* Remove from wait list */
+
+              if (wtcb->blink != NULL)
+                {
+                  wtcb->blink->flink = wtcb->flink;
+                }
+              else
+                {
+                  event->waitlist.head = wtcb->flink;
+                }
+
+              if (wtcb->flink != NULL)
+                {
+                  wtcb->flink->blink = wtcb->blink;
+                }
+              else
+                {
+                  event->waitlist.tail = wtcb->blink;
+                }
+
+              if (WDOG_ISACTIVE(&wtcb->waitdog))
+                {
+                  wd_cancel(&wtcb->waitdog);
+                }
+
+              wtcb->waitobj = (FAR void *)(uintptr_t)matched;
+
+              if ((wait_flags & NXEVENT_WAIT_CLEAR) == 0 && matched != 0)
+                {
+                  event->events &= ~matched;
+                }
+
+              wtcb->task_state = TSTATE_TASK_READYTORUN;
+              if (nxsched_add_prioritized(wtcb, list_readytorun()))
+                {
+                  switch_needed = true;
+                }
+            }
+
+          wtcb = next;
+        }
+
+      if (switch_needed)
+        {
+          if (up_interrupt_context())
+            {
+              /* Can't context switch from interrupt */
+            }
+          else
+            {
+              FAR struct tcb_s *rtcb = this_task();
+              up_switch_context(rtcb, rtcb);
+            }
+        }
+    }
+
+  leave_critical_section(flags);
+
+  return OK;
+}
diff --git a/sched/event/event_tickwait.c b/sched/event/event_tickwait.c
new file mode 100644
index 00000000..7b559135
--- /dev/null
+++ b/sched/event/event_tickwait.c
@@ -0,0 +1,289 @@
+/****************************************************************************
+ * sched/event/event_tickwait.c
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <assert.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+#include <nuttx/wdog.h>
+
+#include "sched/sched.h"
+#include "event/event.h"
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_checkwait
+ *
+ * Description:
+ *   Check if the wait condition is satisfied and return the matched events.
+ *
+ * Input Parameters:
+ *   event - Event group
+ *   wait_events - Events to wait for
+ *   wait_flags - Wait flags
+ *
+ * Returned Value:
+ *   Returns the matched events, or 0 if the condition is not satisfied.
+ *
+ ****************************************************************************/
+
+static inline uint32_t nxevent_checkwait(FAR nxevent_t *event,
+                                         uint32_t wait_events,
+                                         int wait_flags)
+{
+  uint32_t pending = event->events;
+
+  if (pending == 0)
+    {
+      return 0;
+    }
+
+  if (wait_events == 0)
+    {
+      /* Wait for any event */
+
+      return pending;
+    }
+  else if ((wait_flags & NXEVENT_WAIT_ALL) != 0)
+    {
+      /* Wait for ALL events */
+
+      if ((pending & wait_events) == wait_events)
+        {
+          return wait_events;
+        }
+    }
+  else
+    {
+      /* Wait for ANY event */
+
+      uint32_t matched = pending & wait_events;
+      if (matched != 0)
+        {
+          return matched;
+        }
+    }
+
+  return 0;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_timeout
+ *
+ * Description:
+ *   This function is called when the watchdog timer expires.
+ *
+ * Input Parameters:
+ *   pid - Task ID
+ *
+ * Returned Value:
+ *   None
+ *
+ ****************************************************************************/
+
+void nxevent_timeout(wdparm_t pid)
+{
+  FAR struct tcb_s *wtcb = (FAR struct tcb_s *)pid;
+  FAR nxevent_t *event;
+  uint32_t wait_events;
+  uint32_t matched;
+
+  /* Get the event from the encoded waitobj */
+
+  wait_events = NXEVENT_DECODE_EVENTS(wtcb->waitobj);
+
+  /* Check if the task is still waiting */
+
+  if (wtcb->task_state == TSTATE_WAIT_SEM)
+    {
+      /* Get the event structure from the wait list.
+       * The event is linked via the waitlist head.
+       */
+
+      event = (FAR nxevent_t *)((uintptr_t)wtcb->blink -
+                                 offsetof(struct nxevent_s, waitlist));
+
+      if (event != NULL)
+        {
+          /* Remove from the event wait list */
+
+          dq_rem(&wtcb->blink, EVENT_WAITLIST(event));
+        }
+
+      /* Check if the condition is now satisfied */
+
+      matched = nxevent_checkwait(event, wait_events,
+                                   NXEVENT_DECODE_FLAGS(wtcb->waitobj));
+
+      if (matched != 0)
+        {
+          /* Condition now satisfied - store the result */
+
+          wtcb->waitobj = (FAR void *)(uintptr_t)matched;
+        }
+      else
+        {
+          /* Timeout - set result to 0 */
+
+          wtcb->waitobj = (FAR void *)0;
+        }
+
+      /* Mark the task as ready to run */
+
+      wtcb->task_state = TSTATE_TASK_READYTORUN;
+      nxsched_add_prioritized(wtcb, list_readytorun());
+    }
+}
+
+/****************************************************************************
+ * Name: nxevent_tickwait
+ *
+ * Description:
+ *   This function waits for the specified condition to be satisfied with
+ *   a timeout specified in system ticks. If ticks is zero, it behaves
+ *   like nxevent_trywait().
+ *
+ * Input Parameters:
+ *   event - Event group to wait on
+ *   events - Events to wait for
+ *   flags - Combination of NXEVENT_WAIT_ALL and/or NXEVENT_WAIT_CLEAR
+ *   ticks - Timeout in system ticks
+ *
+ * Returned Value:
+ *   On success, returns the event mask that satisfied the wait. On
+ *   timeout, returns 0. On failure, a negated errno value is returned.
+ *
+ * NOTE:
+ *   This function may cause suspension and must not be called from an
+ *   interrupt handler.
+ *
+ ****************************************************************************/
+
+uint32_t nxevent_tickwait(FAR nxevent_t *event, uint32_t events,
+                          int flags, uint32_t ticks)
+{
+  FAR struct tcb_s *rtcb = this_task();
+  irqstate_t flags_state;
+  uint32_t matched;
+  wdparm_t pid;
+  bool switch_needed;
+
+  DEBUGASSERT(event != NULL && up_interrupt_context() == false);
+
+  if (event == NULL)
+    {
+      return (uint32_t)-EINVAL;
+    }
+
+  /* Handle zero timeout as non-blocking try-wait */
+
+  if (ticks == 0)
+    {
+      return nxevent_trywait(event, events, flags);
+    }
+
+  /* The following operations must be performed with interrupts
+   * disabled because nxevent_post() may be called from an interrupt
+   * handler.
+   */
+
+  flags_state = enter_critical_section();
+
+  /* Check if the condition is already satisfied */
+
+  matched = nxevent_checkwait(event, events, flags);
+
+  if (matched != 0)
+    {
+      /* Condition satisfied - consume events and return */
+
+      if ((flags & NXEVENT_WAIT_CLEAR) == 0)
+        {
+          event->events &= ~matched;
+        }
+
+      leave_critical_section(flags_state);
+      return matched;
+    }
+
+  /* Need to wait - remove from ready list and add to wait list */
+
+  switch_needed = nxsched_remove_readytorun(rtcb, true);
+
+  /* Add this task to the wait list */
+
+  rtcb->task_state = TSTATE_WAIT_SEM;
+  nxsched_add_prioritized(rtcb, EVENT_WAITLIST(event));
+
+  /* Store the wait parameters in the TCB.
+   * We need to encode both events and flags.
+   */
+
+  rtcb->waitobj = (FAR void *)NXEVENT_ENCODE_WAIT(events, flags);
+
+  /* Start the watchdog timer */
+
+  pid = (wdparm_t)((uintptr_t)rtcb);
+  wd_start(&rtcb->waitdog, ticks, nxevent_timeout, pid);
+
+  /* Now, perform the context switch if one is needed */
+
+  if (switch_needed)
+    {
+      up_switch_context(this_task(), rtcb);
+    }
+
+  /* We should now be back here with the result stored in waitobj */
+
+  /* Cancel the watchdog timer if still active */
+
+  if (WDOG_ISACTIVE(&rtcb->waitdog))
+    {
+      wd_cancel(&rtcb->waitdog);
+    }
+
+  /* Retrieve the result */
+
+  matched = (uint32_t)((uintptr_t)rtcb->waitobj);
+
+  /* Clear the wait state */
+
+  rtcb->waitobj = NULL;
+
+  leave_critical_section(flags_state);
+
+  /* Return the matched events (0 means timeout or error) */
+
+  return matched;
+}

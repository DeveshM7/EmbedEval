diff --git a/include/nuttx/event.h b/include/nuttx/event.h
new file mode 100644
index 00000000..5642e356
--- /dev/null
+++ b/include/nuttx/event.h
@@ -0,0 +1,251 @@
+/****************************************************************************
+ * include/nuttx/event.h
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+#ifndef __INCLUDE_NUTTX_EVENT_H
+#define __INCLUDE_NUTTX_EVENT_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <nuttx/queue.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Flags for nxevent_wait(), nxevent_tickwait(), nxevent_trywait() */
+
+#define NXEVENT_WAIT_ALL    1 /* Wait for all bits in events to be set */
+#define NXEVENT_WAIT_CLEAR 2 /* Clear bits consumed by wait on success */
+
+/* Flags for nxevent_post() */
+
+#define NXEVENT_POST_ALL   1 /* Post all bits in events mask */
+
+/* Event group initialization macro */
+
+#define NXEVENT_INITIALIZER(e, m) \
+  { \
+    .events = (m), \
+    .waitlist = NXEVENT_WAITLIST_INITIALIZER, \
+  }
+
+#define NXEVENT_WAITLIST_INITIALIZER {NULL, NULL}
+
+/* Encode/decode wait parameters in pointer-sized value.
+ * We use the waitobj field to store wait parameters using this encoding:
+ * - Lower 32 bits: events being waited for
+ * - Upper 32 bits: flags
+ */
+
+#define NXEVENT_ENCODE_WAIT(events, flags) \
+  (((uint64_t)(flags) << 32) | (uint32_t)(events))
+
+#define NXEVENT_DECODE_EVENTS(p) ((uint32_t)((uint64_t)(p) & 0xffffffffULL))
+#define NXEVENT_DECODE_FLAGS(p)   ((int)((uint64_t)(p) >> 32))
+
+/****************************************************************************
+ * Public Type Definitions
+ ****************************************************************************/
+
+/* Event group structure */
+
+struct nxevent_s
+{
+  volatile uint32_t events;     /* Pending event mask */
+  dq_queue_t waitlist;          /* List of waiting tasks */
+};
+
+/* nxevent_t is the event group object type */
+
+typedef struct nxevent_s nxevent_t;
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+#ifdef __cplusplus
+#define EXTERN extern "C"
+extern "C"
+{
+#else
+#define EXTERN extern
+#endif
+
+/****************************************************************************
+ * Name: nxevent_init
+ *
+ * Description:
+ *   This function initializes the event group, setting its initial event
+ *   mask.
+ *
+ * Input Parameters:
+ *   event - Event group to initialize
+ *   events - Initial pending events
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ ****************************************************************************/
+
+int nxevent_init(FAR nxevent_t *event, uint32_t events);
+
+/****************************************************************************
+ * Name: nxevent_destroy
+ *
+ * Description:
+ *   This function destroys the event group, unblocking any tasks waiting
+ *   on it.
+ *
+ * Input Parameters:
+ *   event - Event group to destroy
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ ****************************************************************************/
+
+int nxevent_destroy(FAR nxevent_t *event);
+
+/****************************************************************************
+ * Name: nxevent_reset
+ *
+ * Description:
+ *   This function resets the event group to a new pending event mask,
+ *   waking any waiters whose conditions are now satisfied.
+ *
+ * Input Parameters:
+ *   event - Event group to reset
+ *   events - New pending event mask
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ ****************************************************************************/
+
+int nxevent_reset(FAR nxevent_t *event, uint32_t events);
+
+/****************************************************************************
+ * Name: nxevent_post
+ *
+ * Description:
+ *   This function posts events to the event group. By default, the events
+ *   are merged with the current pending mask. If the supplied events mask
+ *   is zero, it is treated as an "any" delivery and will wake blocked
+ *   waiters immediately.
+ *
+ * Input Parameters:
+ *   event - Event group to post to
+ *   events - Events to post
+ *   flags - Reserved for future use (must be 0)
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ ****************************************************************************/
+
+int nxevent_post(FAR nxevent_t *event, uint32_t events, int flags);
+
+/****************************************************************************
+ * Name: nxevent_wait
+ *
+ * Description:
+ *   This function waits for the specified condition to be satisfied.
+ *   If events is 0, any pending event will satisfy the wait. If
+ *   NXEVENT_WAIT_ALL is set, all bits in events must be pending;
+ *   otherwise any bit may satisfy the wait.
+ *
+ *   By default, events consumed by a successful wait are cleared from
+ *   the pending mask. If NXEVENT_WAIT_CLEAR is set, the consumed bits
+ *   are retained.
+ *
+ * Input Parameters:
+ *   event - Event group to wait on
+ *   events - Events to wait for
+ *   flags - Combination of NXEVENT_WAIT_ALL and/or NXEVENT_WAIT_CLEAR
+ *
+ * Returned Value:
+ *   On success, returns the event mask that satisfied the wait (may be
+ *   a subset of the requested events). On failure, a negated errno
+ *   value is returned.
+ *
+ ****************************************************************************/
+
+uint32_t nxevent_wait(FAR nxevent_t *event, uint32_t events, int flags);
+
+/****************************************************************************
+ * Name: nxevent_trywait
+ *
+ * Description:
+ *   This function is the non-blocking form of nxevent_wait(). It returns
+ *   immediately if the condition is already satisfied, otherwise it
+ *   returns 0.
+ *
+ * Input Parameters:
+ *   event - Event group to wait on
+ *   events - Events to wait for
+ *   flags - Combination of NXEVENT_WAIT_ALL and/or NXEVENT_WAIT_CLEAR
+ *
+ * Returned Value:
+ *   Returns the event mask that satisfied the wait on success, or 0
+ *   if the condition is not satisfied. On failure, a negated errno
+ *   value is returned.
+ *
+ ****************************************************************************/
+
+uint32_t nxevent_trywait(FAR nxevent_t *event, uint32_t events, int flags);
+
+/****************************************************************************
+ * Name: nxevent_tickwait
+ *
+ * Description:
+ *   This function waits for the specified condition to be satisfied with
+ *   a timeout specified in system ticks. If ticks is zero, it behaves
+ *   like nxevent_trywait().
+ *
+ * Input Parameters:
+ *   event - Event group to wait on
+ *   events - Events to wait for
+ *   flags - Combination of NXEVENT_WAIT_ALL and/or NXEVENT_WAIT_CLEAR
+ *   ticks - Timeout in system ticks
+ *
+ * Returned Value:
+ *   On success, returns the event mask that satisfied the wait. On
+ *   timeout, returns 0. On failure, a negated errno value is returned.
+ *
+ ****************************************************************************/
+
+uint32_t nxevent_tickwait(FAR nxevent_t *event, uint32_t events,
+                          int flags, uint32_t ticks);
+
+#undef EXTERN
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __INCLUDE_NUTTX_EVENT_H */

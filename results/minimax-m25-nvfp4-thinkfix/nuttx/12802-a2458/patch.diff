+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <assert.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "sched/sched.h"
+#include "event/event.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: nxevent_destroy
+ *
+ * Description:
+ *   This function destroys the event group, unblocking any tasks waiting
+ *   on it.
+ *
+ * Input Parameters:
+ *   event - Event group to destroy
+ *
+ * Returned Value:
+ *   Zero (OK) is returned on success. A negated errno value is returned
+ *   on failure.
+ *
+ * Assumptions:
+ *   This function may be called from an interrupt handler.
+ *
+ ****************************************************************************/
+
+int nxevent_destroy(FAR nxevent_t *event)
+{
+  FAR struct tcb_s *wtcb;
+  irqstate_t flags;
+  bool switch_needed = false;
+
+  DEBUGASSERT(event != NULL);
+
+  if (event == NULL)
+    {
+      return -EINVAL;
+    }
+
+  /* We must check if there are any waiters and wake them up.
+   * This requires interrupts to be disabled.
+   */
+
+  flags = enter_critical_section();
+
+  /* Mark the event as destroyed by setting events to all bits set.
+   * This will wake up any waiters with any pending event.
+   */
+
+  event->events = UINT32_MAX;
+
+  /* Now wake up all waiters - they will check for the destroyed
+   * condition when they run.
+   */
+
+  while ((wtcb = (FAR struct tcb_s *)dq_remfirst(EVENT_WAITLIST(event))) != NULL)
+    {
+      /* Cancel the watchdog timer */
+
+      if (WDOG_ISACTIVE(&wtcb->waitdog))
+        {
+          wd_cancel(&wtcb->waitdog);
+        }
+
+      /* Set result to indicate destroy (UINT32_MAX) */
+
+      wtcb->waitobj = (FAR void *)UINT32_MAX;
+
+      /* Add the task to ready-to-run list */
+
+      wtcb->task_state = TSTATE_TASK_READYTORUN;
+      if (nxsched_add_prioritized(wtcb, list_readytorun()))
+        {
+          switch_needed = true;
+        }
+    }
+
+  /* Perform context switch if needed */
+
+  if (switch_needed)
+    {
+      if (up_interrupt_context())
+        {
+          /* We can't do a context switch from an interrupt context.
+           * Just mark the task as ready and let the interrupt
+           * return code handle the context switch.
+           */
+        }
+      else
+        {
+          FAR struct tcb_s *rtcb = this_task();
+          up_switch_context(rtcb, rtcb);
+        }
+    }
+
+  leave_critical_section(flags);
+
+  return OK;
+}

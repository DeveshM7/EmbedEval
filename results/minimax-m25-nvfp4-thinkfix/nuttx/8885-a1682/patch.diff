+/* Public macros for sigset_t operations.
+ * SIGSET_FMT is a format string for printf that can display a sigset_t.
+ * SIGSET_ELEM returns a pointer to the _elem array of a sigset_t.
+ * These can be used together as: printf(SIGSET_FMT, SIGSET_ELEM(&sigset_var));
+ */
+
+#define SIGSET_FMT "%016lx"
+#define SIGSET_ELEM(s) ((uint32_t *)(s))
+
 #ifdef __cplusplus
 extern "C"
 {

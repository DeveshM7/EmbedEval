index 3279248d..79521686 100644
--- a/include/signal.h
+++ b/include/signal.h
@@ -35,14 +35,22 @@
  * Pre-processor Definitions
  ********************************************************************************/
 
+/* Define the number of elements in the signal set.
+ * With uint64_t, we have 64 bits, enough for 64 signals (0-63).
+ */
+
+#ifndef _SIGSET_NELEM
+#  define _SIGSET_NELEM 1  /* Single uint64_t has 64 bits */
+#endif
+
 /* Signal set management definitions and macros. */
 
-#define NULL_SIGNAL_SET ((sigset_t)0x00000000)
-#define ALL_SIGNAL_SET  ((sigset_t)0xffffffff)
+#define NULL_SIGNAL_SET ((sigset_t)0)
+#define ALL_SIGNAL_SET  ((sigset_t)0xffffffffffffffffULL)
 #define MIN_SIGNO       1               /* Lowest valid signal number */
-#define MAX_SIGNO       31              /* Highest valid signal number */
+#define MAX_SIGNO       63              /* Highest valid signal number */
 #define GOOD_SIGNO(s)   ((((unsigned)(s)) <= MAX_SIGNO))
-#define SIGNO2SET(s)    ((sigset_t)1 << (s))
+#define SIGNO2SET(s)    ((sigset_t)(1ULL << (s)))
 
 /* Definitions for "real time" signals */
 
@@ -240,7 +248,17 @@
  */
 
 #ifndef __SIGSET_T_DEFINED
-typedef uint32_t sigset_t;   /* Bit set of 32 signals */
+/* sigset_t is uint64_t, supporting 64 signals (0-63).
+ * This maintains backward compatibility with bitwise operations.
+ * The _elem macro provides array access for public interface.
+ */
+
+typedef uint64_t sigset_t;
+
+/* Macros for element access - _elem[0] gives low 32 bits, _elem[1] gives high 32 bits */
+#define _SIGSET_ELEM(s, n) (((uint32_t *)&(s))[(n)])
+#define _elem _SIGSET_ELEM  /* For public interface: sigset_t s; s._elem[0] = x; */
+
 #define __SIGSET_T_DEFINED 1
 #endif
 

@@ -143,6 +143,15 @@ int nxsig_procmask(int how, FAR const sigset_t *set, FAR sigset_t *oset)
 
       leave_critical_section(flags);
 
+      /* POSIX specifies that SIGKILL and SIGSTOP cannot be blocked.
+       * Ensure that these signals are never present in the signal mask.
+       * This must be done after any of the above operations to ensure
+       * they never appear in the mask.
+       */
+
+      nxsig_delset(&rtcb->sigprocmask, SIGKILL);
+      nxsig_delset(&rtcb->sigprocmask, SIGSTOP);
+
       /* Now, process any pending signals that were just unmasked */
 
       nxsig_unmask_pendingsignal();

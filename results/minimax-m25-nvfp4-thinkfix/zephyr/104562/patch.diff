diff --git a/subsys/pm/policy/policy_latency.c b/subsys/pm/policy/policy_latency.c
index 68e6ffcc..cb43039e 100644
--- a/subsys/pm/policy/policy_latency.c
+++ b/subsys/pm/policy/policy_latency.c
@@ -91,8 +91,13 @@ void pm_policy_latency_changed_subscribe(struct pm_policy_latency_subscription *
 {
 	k_spinlock_key_t key = k_spin_lock(&latency_lock);
 
-	req->cb = cb;
-	sys_slist_append(&latency_subs, &req->node);
+	if (cb == NULL) {
+		/* Disable subscription by removing it from the list */
+		(void)sys_slist_find_and_remove(&latency_subs, &req->node);
+	} else {
+		req->cb = cb;
+		sys_slist_append(&latency_subs, &req->node);
+	}
 
 	k_spin_unlock(&latency_lock, key);
 }

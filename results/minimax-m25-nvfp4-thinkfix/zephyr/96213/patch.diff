+def write_descendant_bus_counts(node: edtlib.Node) -> None:
+    # Generate macros for counting descendants on a bus.
+    # This is only relevant for nodes that are bus controllers (have 'bus:' in binding).
+
+    if not node.buses:
+        return
+
+    # For each bus type this node controls
+    for bus_type in node.buses:
+        # Find all descendants that are on this bus, stopping at child bus controllers
+        descendants = _get_descendants_on_bus(node, bus_type)
+
+        # Generate the macro
+        bus_ident = str2ident(bus_type)
+        out_dt_define(f"{node.z_path_id}_DESCENDANT_NUM_ON_BUS_{bus_ident}", len(descendants))
+
+        # Count status-okay nodes
+        ok_count = sum(1 for d in descendants if d.status == "okay")
+        out_dt_define(f"{node.z_path_id}_DESCENDANT_NUM_ON_BUS_{bus_ident}_STATUS_OKAY", ok_count)
+
+
+def _get_descendants_on_bus(node: edtlib.Node, bus_type: str) -> list:
+    # Get all descendants on the given bus.
+    # Algorithm:
+    # 1. Find all nodes under this node that are devices on the bus
+    # 2. Filter out any that have a bus controller in their ancestor chain
+    #    (excluding the starting node)
+    
+    result = []
+    _collect_descendants(node, bus_type, result)
+    return result
+
+
+def _collect_descendants(node: edtlib.Node, bus_type: str, result: list) -> None:
+    # Recursively collect descendants
+    
+    for child in node.children.values():
+        is_device = bool(child.compats)
+        is_on_bus = bus_type in child.on_buses
+        
+        if is_on_bus and is_device:
+            # Check if this node is behind a bus controller by checking its path
+            # A node is behind a bus controller if any ancestor (excluding start_node) is a bus controller
+            behind_bus = _is_behind_bus_controller(child, node)
+            if not behind_bus:
+                result.append(child)
+        
+        # Continue descending
+        _collect_descendants(child, bus_type, result)
+
+
+def _is_behind_bus_controller(node: edtlib.Node, start_node: edtlib.Node) -> bool:
+    # Check if any ancestor between start_node (exclusive) and node (exclusive) is a bus controller
+    current = node.parent
+    while current is not None:
+        if current is start_node:
+            break
+        if current.buses:
+            return True
+        current = current.parent
+    return False
+
+
+def _is_bus_controller_in_ancestors(node: edtlib.Node, start_node: edtlib.Node, bus_type: str) -> bool:
+    # Check if any of node's ancestors (up to but not including start_node) is a bus controller
+    
+    # Check ancestors (NOT the node itself)
+    current = node.parent
+    while current is not None:
+        if current is start_node:
+            # Reached the starting node, stop
+            break
+        if current.buses:
+            return True
+        current = current.parent
+    
+    return False
+

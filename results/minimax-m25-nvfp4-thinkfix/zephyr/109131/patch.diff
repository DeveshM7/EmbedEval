diff --git a/subsys/net/lib/dhcpv4/Kconfig b/subsys/net/lib/dhcpv4/Kconfig
index e78dca260..ad0107ac1 100644
--- a/subsys/net/lib/dhcpv4/Kconfig
+++ b/subsys/net/lib/dhcpv4/Kconfig
@@ -228,4 +228,21 @@ config NET_DHCPV4_SERVER_OPTION_ROUTER
 	  disabled so that the client does not try to forward traffic to our
 	  device.
 
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
+	bool "Set the Captive-Portal URI option in the DHCP server response"
+	depends on NET_DHCPV4_SERVER
+	help
+	  If enabled, set the DHCP Captive-Portal URI option (option 114) in
+	  Offer and Acknowledge messages when the client requests it via the
+	  Parameter Request List (option 55). The URI is either taken from
+	  CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI if non-empty,
+	  or auto-built as http://<server-IPv4>/generate_204.
+
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI
+	string "Captive-Portal URI"
+	default ""
+	help
+	  This configuration option specifies the URI that the DHCPv4 server
+	  should provide to clients in the Captive-Portal URI option (option 114).
+	  If empty, the URI will be auto-built as http://<server-IPv4>/generate_204.
 endif # NET_DHCPV4_SERVER

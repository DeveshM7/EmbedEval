 			struct net_buf *const buf,
 			const int err);
 
+/**
+ * @brief Flush all queued requests from endpoint FIFO.
+ *
+ * This function removes all requests from endpoint FIFO and submits
+ * a separate completion event for each request.
+ *
+ * @param[in] dev    Pointer to device struct of the driver instance
+ * @param[in] ep_cfg Pointer to endpoint configuration
+ * @param[in] err    Error code to be reported in each completion event
+ *
+ * @return 0 on success, all other values should be treated as error.
+ * @retval -EPERM controller is not initialized
+ */
+int udc_ep_flush(const struct device *dev,
+		 struct udc_ep_config *const ep_cfg,
+		 const int err);
+
 /**
  * @brief Helper function to send UDC SOF event to a higher level.
  *

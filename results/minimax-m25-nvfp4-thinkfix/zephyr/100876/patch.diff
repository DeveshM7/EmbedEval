diff --git a/drivers/usb/udc/udc_common.c b/drivers/usb/udc/udc_common.c
index 499790ab..f31381b2 100644
--- a/drivers/usb/udc/udc_common.c
+++ b/drivers/usb/udc/udc_common.c
@@ -195,6 +195,22 @@ int udc_submit_event(const struct device *dev,
 	return data->event_cb(dev, &drv_evt);
 }
 
+int udc_ep_flush(const struct device *dev, struct udc_ep_config *const ep_cfg,
+		 const int err)
+{
+	struct net_buf *buf;
+	int ret = 0;
+
+	while (!k_fifo_is_empty(&ep_cfg->fifo)) {
+		buf = udc_buf_get(ep_cfg);
+		if (buf) {
+			ret = udc_submit_ep_event(dev, buf, err);
+		}
+	}
+
+	return ret;
+}
+
 int udc_submit_ep_event(const struct device *dev,
 			struct net_buf *const buf,
 			const int err)

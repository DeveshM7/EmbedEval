+	/**
+	 * Idle timeout (seconds)
+	 *
+	 * Indicates the length of time the interface must be inactive before it is
+	 * disconnected due to inactivity.
+	 *
+	 * The interface is considered inactive when there is no data being sent or received.
+	 * This timeout can be used to automatically disconnect an interface after a period
+	 * of inactivity, treated as an unintentional connection loss for purposes of
+	 * connection persistence.
+	 *
+	 * Set to @ref CONN_MGR_IF_NO_TIMEOUT to indicate that no idle timeout should be used.
+	 */
+	int idle_timeout;
+

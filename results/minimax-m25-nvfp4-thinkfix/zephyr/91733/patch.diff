+/**
+ * @brief Get the idle timeout for an iface
+ *
+ * If the provided iface is bound to a connectivity implementation, retrieves the idle timeout
+ * setting in seconds for it.
+ *
+ * @param iface - Pointer to the iface to check.
+ * @return int - The idle timeout value (in seconds) if it could be retrieved, otherwise
+ *		 CONN_MGR_IF_NO_TIMEOUT.
+ */
+int conn_mgr_if_get_idle_timeout(struct net_if *iface);
+
+/**
+ * @brief Set the idle timeout for an iface.
+ *
+ * If the provided iface is bound to a connectivity implementation, sets the idle timeout
+ * setting in seconds for it.
+ *
+ * The idle timeout is used to automatically disconnect an interface after a period of
+ * inactivity. When the interface goes inactive for longer than the specified timeout,
+ * it will be disconnected, treated as an unintentional connection loss for purposes of
+ * connection persistence.
+ *
+ * @param iface - Pointer to the network interface to modify.
+ * @param timeout - The idle timeout value to set (in seconds).
+ *		    Pass @ref CONN_MGR_IF_NO_TIMEOUT to disable the idle timeout.
+ * @retval 0 on success.
+ * @retval -ENOTSUP if the provided iface is not bound to a connectivity implementation.
+ */
+int conn_mgr_if_set_idle_timeout(struct net_if *iface, int timeout);
+
 /**
  * @}

new file mode 100644
index 000000000..322aae4ef
--- /dev/null
+++ b/cmake/shell_aliases.cmake
@@ -0,0 +1,60 @@
+# Function to generate shell aliases include file
+# Usage: generate_shell_aliases_inc_file_for_target(<target> <source_file> <output_file>)
+function(generate_shell_aliases_inc_file_for_target TARGET_ALIASES SOURCE_FILE OUTPUT_FILE)
+    if(NOT EXISTS ${SOURCE_FILE})
+        message(WARNING "Alias file ${SOURCE_FILE} does not exist")
+        return()
+    endif()
+
+    # Read alias file and generate C header
+    file(READ ${SOURCE_FILE} ALIAS_FILE_CONTENT)
+    
+    # Parse aliases - format: alias_name expansion_command
+    # Each line: alias_name whitespace expansion
+    string(REPLACE "\n" ";" ALIAS_LINES "${ALIAS_FILE_CONTENT}")
+    
+    set(ALIAS_ARRAY "")
+    set(ALIAS_COUNT 0)
+    
+    foreach(LINE ${ALIAS_LINES})
+        # Skip empty lines and comments
+        string(STRIP "${LINE}" LINE)
+        if(LINE AND NOT LINE MATCHES "^#")
+            # Find first space to split alias name and expansion
+            string(FIND "${LINE}" " " SPACE_POS)
+            if(NOT SPACE_POS EQUAL -1)
+                string(SUBSTRING "${LINE}" 0 ${SPACE_POS} ALIAS_NAME)
+                math(EXPR ALIAS_LEN "${SPACE_POS} + 1")
+                string(SUBSTRING "${LINE}" ${ALIAS_LEN} -1 ALIAS_EXP)
+                string(STRIP "${ALIAS_NAME}" ALIAS_NAME)
+                string(STRIP "${ALIAS_EXP}" ALIAS_EXP)
+                
+                if(ALIAS_NAME AND ALIAS_EXP)
+                    list(APPEND ALIAS_ARRAY "\"${ALIAS_NAME}\", \"${ALIAS_EXP}\"")
+                    math(EXPR ALIAS_COUNT "${ALIAS_COUNT} + 1")
+                endif()
+            endif()
+        endif()
+    endforeach()
+    
+    # Generate the include file
+    if(ALIAS_COUNT GREATER 0)
+        set(ALIAS_DEFINITIONS "")
+        foreach(ITEM ${ALIAS_ARRAY})
+            set(ALIAS_DEFINITIONS "${ALIAS_DEFINITIONS}\n\t{ ${ITEM} },")
+        endforeach()
+        
+        file(WRITE ${OUTPUT_FILE} "/* Auto-generated file - do not modify */\n")
+        file(APPEND ${OUTPUT_FILE} "#ifndef SHELL_ALIASES_GENERATED_H\n")
+        file(APPEND ${OUTPUT_FILE} "#define SHELL_ALIASES_GENERATED_H\n\n")
+        file(APPEND ${OUTPUT_FILE} "#include <zephyr/shell/shell_aliases.h>\n\n")
+        file(APPEND ${OUTPUT_FILE} "static const struct shell_alias shell_aliases[] = {${ALIAS_DEFINITIONS}\n};\n\n")
+        file(APPEND ${OUTPUT_FILE} "static const size_t shell_aliases_count = ${ALIAS_COUNT};\n\n")
+        file(APPEND ${OUTPUT_FILE} "#endif /* SHELL_ALIASES_GENERATED_H */\n")
+    else()
+        file(WRITE ${OUTPUT_FILE} "/* Auto-generated file - do not modify */\n")
+        file(APPEND ${OUTPUT_FILE} "/* No aliases defined */\n")
+    endif()
+    
+    message(STATUS "Generated shell aliases: ${OUTPUT_FILE}")
+endfunction()

@@ -47,6 +48,7 @@
 	"Assume 80 chars screen width and send this setting "	\
 	"to the terminal."
 #define SHELL_HELP_HISTORY	"Command history."
+#define SHELL_HELP_ALIASES		"List configured aliases."
 #define SHELL_HELP_ECHO		"Toggle shell echo."
 #define SHELL_HELP_ECHO_ON	"Enable shell echo."
 #define SHELL_HELP_ECHO_OFF	\
@@ -382,6 +384,55 @@ static int cmd_history(const struct shell *sh, size_t argc, char **argv)
 	return 0;
 }
 
+
+static int cmd_aliases(const struct shell *sh, size_t argc, char **argv)
+{
+	ARG_UNUSED(argc);
+	ARG_UNUSED(argv);
+
+	size_t i;
+	size_t count;
+	const struct shell_alias *aliases;
+	const struct shell_static_entry *parent = NULL;
+
+	aliases = shell_aliases_get();

diff --git a/subsys/shell/shell_aliases.c b/subsys/shell/shell_aliases.c
new file mode 100644
index 000000000..98eb9d34a
--- /dev/null
+++ b/subsys/shell/shell_aliases.c
@@ -0,0 +1,379 @@
+/*
+ * Copyright (c) 2018 Nordic Semiconductor ASA
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <ctype.h>
+#include <string.h>
+#include <zephyr/shell/shell.h>
+#include "shell_aliases.h"
+#include "shell_utils.h"
+
+/* Build assert for command buffer size */
+#if (CONFIG_SHELL_CMD_BUFF_SIZE < 2)
+#error too small CONFIG_SHELL_CMD_BUFF_SIZE
+#endif
+
+/* Macro to create the built-in '?' alias for help */
+#define SHELL_ALIAS_HELP_NAME "?"
+#define SHELL_ALIAS_HELP_EXPANSION "help"
+
+#if defined(CONFIG_SHELL_ALIASES)
+
+/* Include generated aliases from file */
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE)
+#include CONFIG_SHELL_ALIASES_FILE
+#endif
+
+/* Built-in '?' alias for help - always available when aliases enabled */
+static const struct shell_alias builtin_alias = {
+	.name = SHELL_ALIAS_HELP_NAME,
+	.expansion = SHELL_ALIAS_HELP_EXPANSION,
+};
+
+/* Warning message for alias collision */
+#define SHELL_MSG_ALIAS_IGNORED "Alias '%s' ignored because command exists in current context"
+
+/* Track if warning has been printed for collision */
+static bool alias_collision_warning_printed(const char *name);
+
+/**
+ * @brief Check if alias name collides with existing command.
+ *
+ * @param name Alias name to check.
+ * @param parent Parent command (for select mode), NULL for root.
+ *
+ * @return true if collision detected, false otherwise.
+ */
+static bool alias_collision_check(const char *name, const struct shell_static_entry *parent)
+{
+	struct shell_static_entry dloc;
+	const struct shell_static_entry *cmd;
+
+	if (name == NULL) {
+		return false;
+	}
+
+	cmd = z_shell_find_cmd(parent, name, &dloc);
+	return (cmd != NULL);
+}
+
+/**
+ * @brief Print warning for ignored alias due to collision.
+ *
+ * @param sh Shell instance.
+ * @param name Alias name that was ignored.
+ */
+static void alias_collision_warning(const struct shell *sh, const char *name)
+{
+	if (!alias_collision_warning_printed(name)) {
+		z_shell_fprintf(sh, SHELL_WARNING,
+				SHELL_MSG_ALIAS_IGNORED, name);
+	}
+}
+
+/* Track printed warnings to avoid duplicates */
+static bool warning_printed[16];  /* Simple tracking for up to 16 aliases */
+static bool warnings_initialized;
+
+static void init_warning_tracking(void)
+{
+	int i;
+	for (i = 0; i < 16; i++) {
+		warning_printed[i] = false;
+	}
+	warnings_initialized = true;
+}
+
+static bool alias_collision_warning_printed(const char *name)
+{
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE)
+	extern const size_t shell_aliases_count;
+	size_t i;
+	
+	if (!warnings_initialized) {
+		init_warning_tracking();
+	}
+	
+	/* Check builtin alias */
+	if (strcmp(name, SHELL_ALIAS_HELP_NAME) == 0) {
+		return warning_printed[0];
+	}
+	
+	/* Check file-based aliases */
+	for (i = 0; i < shell_aliases_count; i++) {
+		extern const struct shell_alias shell_aliases[];
+		if (strcmp(name, shell_aliases[i].name) == 0) {
+			return warning_printed[i + 1];
+		}
+	}
+#endif
+	ARG_UNUSED(name);
+	return false;
+}
+
+static void set_alias_warning_printed(const char *name, bool printed)
+{
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE)
+	extern const size_t shell_aliases_count;
+	size_t i;
+	
+	if (!warnings_initialized) {
+		init_warning_tracking();
+	}
+	
+	/* Check builtin alias */
+	if (strcmp(name, SHELL_ALIAS_HELP_NAME) == 0) {
+		warning_printed[0] = printed;
+		return;
+	}
+	
+	/* Check file-based aliases */
+	for (i = 0; i < shell_aliases_count; i++) {
+		extern const struct shell_alias shell_aliases[];
+		if (strcmp(name, shell_aliases[i].name) == 0) {
+			warning_printed[i + 1] = printed;
+			return;
+		}
+	}
+#endif
+	ARG_UNUSED(name);
+	ARG_UNUSED(printed);
+}
+
+/**
+ * @brief Get array of shell aliases.
+ */
+const struct shell_alias *shell_aliases_get(void)
+{
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE)
+	extern const struct shell_alias shell_aliases[];
+	return shell_aliases;
+#else
+	return NULL;
+#endif
+}
+
+/**
+ * @brief Get number of shell aliases.
+ */
+size_t shell_aliases_count(void)
+{
+#if defined(CONFIG_SHELL_ALIASES_HAS_FILE)
+	extern const size_t shell_aliases_count;
+	return shell_aliases_count + 1; /* +1 for builtin '?' */
+#else
+	return 1; /* Just the builtin '?' */
+#endif
+}
+
+/**
+ * @brief Find alias by name.
+ */
+const struct shell_alias *shell_alias_find(const char *name)
+{
+	size_t count;
+	const struct shell_alias *aliases;
+	size_t i;
+
+	if (name == NULL) {
+		return NULL;
+	}
+
+	/* Check builtin alias first */
+	if (strcmp(name, SHELL_ALIAS_HELP_NAME) == 0) {
+		return &builtin_alias;
+	}
+
+	aliases = shell_aliases_get();
+	if (aliases == NULL) {
+		return NULL;
+	}
+
+	count = shell_aliases_count();
+	for (i = 0; i < count; i++) {
+		if (strcmp(name, aliases[i].name) == 0) {
+			return &aliases[i];
+		}
+	}
+
+	return NULL;
+}
+
+/**
+ * @brief Get alias by index.
+ */
+const struct shell_alias *shell_alias_get(size_t idx)
+{
+	size_t count;
+	const struct shell_alias *aliases;
+
+	if (idx == 0) {
+		/* Built-in alias */
+		return &builtin_alias;
+	}
+
+	aliases = shell_aliases_get();
+	if (aliases == NULL) {
+		return NULL;
+	}
+
+	count = shell_aliases_count();
+	if (idx >= count) {
+		return NULL;
+	}
+
+	return &aliases[idx];
+}
+
+/**
+ * @brief Check if an alias should be used (considering collision).
+ *
+ * @param name Alias name.
+ * @param parent Parent command context (for select mode), NULL for root.
+ *
+ * @return Pointer to alias if valid, NULL if not found or collision.
+ */
+const struct shell_alias *shell_alias_check(const char *name,
+					   const struct shell_static_entry *parent)
+{
+	const struct shell_alias *alias;
+
+	if (name == NULL) {
+		return NULL;
+	}
+
+	/* Find the alias first */
+	alias = shell_alias_find(name);
+	if (alias == NULL) {
+		return NULL;
+	}
+
+	/* Check if alias name collides with an existing command */
+	if (alias_collision_check(name, parent)) {
+		return NULL;
+	}
+
+	return alias;
+}
+
+/**
+ * @brief Expand alias in command buffer if present.
+ *
+ * @param[in,out] cmd_buf Command buffer to check and expand.
+ * @param[in,out] cmd_len Command buffer length.
+ * @param[in] parent Parent command context (for select mode), NULL for root.
+ *
+ * @return true if alias was expanded, false otherwise.
+ */
+bool shell_alias_expand(char *cmd_buf, uint16_t *cmd_len,
+		       const struct shell_static_entry *parent)
+{
+	const struct shell_alias *alias;
+	size_t name_len;
+	size_t exp_len;
+	size_t rest_len;
+	char *rest;
+
+	if (cmd_buf == NULL || cmd_len == NULL || *cmd_len == 0) {
+		return false;
+	}
+
+	/* Find the end of the first word (command name) */
+	name_len = 0;
+	while (name_len < *cmd_len && !isspace((unsigned char)cmd_buf[name_len])) {
+		name_len++;
+	}
+
+	if (name_len == 0) {
+		return false;
+	}
+
+	/* Look up the alias with collision check */
+	alias = shell_alias_check(cmd_buf, parent);
+	if (alias == NULL) {
+		/* Check if there was a collision */
+		if (alias_collision_check(cmd_buf, parent)) {
+			/* Could print warning here if shell instance available */
+		}
+		return false;
+	}
+
+	exp_len = strlen(alias->expansion);
+
+	/* Check if expansion fits in buffer */
+	if (exp_len + 1 > CONFIG_SHELL_CMD_BUFF_SIZE) {
+		return false;
+	}
+
+	/* Calculate remaining characters after the alias name */
+	rest = cmd_buf + name_len;
+	rest_len = *cmd_len - name_len;
+
+	/* Check if we need to add space before remaining args */
+	if (rest_len > 0 && rest[0] != ' ') {
+		/* Make room for expansion + space + rest */
+		if (exp_len + 1 + rest_len + 1 > CONFIG_SHELL_CMD_BUFF_SIZE) {
+			return false;
+		}
+		/* Move the rest of the command to make room */
+		memmove(cmd_buf + exp_len + 1, rest, rest_len);
+		cmd_buf[exp_len] = ' ';
+		*cmd_len = exp_len + 1 + rest_len;
+	} else {
+		/* Just replace the alias name with expansion */
+		memmove(cmd_buf + exp_len, rest, rest_len);
+		*cmd_len = exp_len + rest_len;
+	}
+
+	/* Copy the expansion to the beginning of the buffer */
+	memcpy(cmd_buf, alias->expansion, exp_len);
+
+	cmd_buf[*cmd_len] = '\0';
+
+	return true;
+}
+
+#else /* CONFIG_SHELL_ALIASES */
+
+const struct shell_alias *shell_aliases_get(void)
+{
+	return NULL;
+}
+
+size_t shell_aliases_count(void)
+{
+	return 0;
+}
+
+const struct shell_alias *shell_alias_find(const char *name)
+{
+	ARG_UNUSED(name);
+	return NULL;
+}
+
+const struct shell_alias *shell_alias_check(const char *name,
+					   const struct shell_static_entry *parent)
+{
+	ARG_UNUSED(name);
+	ARG_UNUSED(parent);
+	return NULL;
+}
+
+bool shell_alias_expand(char *cmd_buf, uint16_t *cmd_len,
+		       const struct shell_static_entry *parent)
+{
+	ARG_UNUSED(cmd_buf);
+	ARG_UNUSED(cmd_len);
+	ARG_UNUSED(parent);
+	return false;
+}
+
+const struct shell_alias *shell_alias_get(size_t idx)
+{
+	ARG_UNUSED(idx);
+	return NULL;
+}
+
+#endif /* CONFIG_SHELL_ALIASES */
diff --git a/subsys/shell/shell_aliases.h b/subsys/shell/shell_aliases.h

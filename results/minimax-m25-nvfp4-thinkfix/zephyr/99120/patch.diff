@@ -435,6 +435,72 @@
  */
 #define DT_CHILD(node_id, child) UTIL_CAT(node_id, DT_S_PREFIX(child))
 
+/**
+ * @brief Get a node identifier for a child node with a given unit address
+ *
+ * This macro returns the node identifier of the child of @p node_id whose
+ * integer unit address is @p addr. The child node must have a unit address
+ * in its name (e.g., child@1000).
+ *
+ * Example devicetree fragment:
+ *
+ * @code{.dts}
+ *	parent {
+ *		child@a {
+ *			reg = <0xa 0x100>;
+ *		};
+ *		child@b {
+ *			reg = <0xb 0x100>;
+ *		};
+ *	};
+ * @endcode
+ *
+ * Example usage:
+ *
+ * @code{.c}
+ *     DT_CHILD_BY_UNIT_ADDR_INT(DT_NODELABEL(parent), 0xa) // returns DT_N_parent_S_child_a
+ * @endcode
+ *
+ * @param node_id node identifier of the parent node
+ * @param addr integer unit address to look up
+ * @return node identifier of the child with the matching unit address,
+ *         or 0 if no match is found
+ */
+#define DT_CHILD_BY_UNIT_ADDR_INT(node_id, addr) 	DT_CAT(node_id, _CHILD_BY_UNIT_ADDR_INT)(addr)
+
+/**
+ * @brief Get a node identifier for a child node with a given unit address
+ *
+ * Variant of DT_CHILD_BY_UNIT_ADDR_INT() that operates on a node
+ * identified by @p inst.
+ *
+ * Example devicetree fragment:
+ *
+ * @code{.dts}
+ *	MyDevice {
+ *		compatible = "vnd,device";
+ *		sub-device@a {
+ *			reg = <0xa 0x100>;
+ *		};
+ *		sub-device@b {
+ *			reg = <0xb 0x100>;
+ *		};
+ *	};
+ * @endcode
+ *
+ * Example usage:
+ *
+ * @code{.c}
+ *     DT_INST_CHILD_BY_UNIT_ADDR_INT(0, 0xa) // returns the child with address 0xa
+ * @endcode
+ *
+ * @param inst instance number
+ * @param addr integer unit address to look up
+ * @return node identifier of the child with the matching unit address,
+ *         or DT_INVALID_NODE if no match is found
+ */
+#define DT_INST_CHILD_BY_UNIT_ADDR_INT(inst, addr) 	DT_CHILD_BY_UNIT_ADDR_INT(DT_DRV_INST(inst), addr)
+
 /**

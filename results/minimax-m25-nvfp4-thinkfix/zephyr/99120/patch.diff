  *
diff --git a/scripts/dts/gen_defines.py b/scripts/dts/gen_defines.py
index e3913dd5..051b2cff 100755
--- a/scripts/dts/gen_defines.py
+++ b/scripts/dts/gen_defines.py
@@ -484,6 +484,37 @@ def write_children(node: edtlib.Node) -> None:
 
     out_dt_define(f"{node.z_path_id}_CHILD_NUM_STATUS_OKAY", ok_nodes_num)
 
+    # Child node lookup by unit address macros
+    children_with_addr = []
+    for i, child in enumerate(node.children.values()):
+        unit_addr = child.unit_addr
+        if unit_addr is not None:
+            out_dt_define(f"{node.z_path_id}_CHILD_{i}_UNIT_ADDR", unit_addr)
+            children_with_addr.append((i, child))
+
+    # Generate the lookup macro that checks each child's unit address
+    # This generates a chain of (addr == childN_UNIT_ADDR ? childN : ...) that returns a node identifier
+    # To make it work with token pasting macros, we generate it as nested ternary operators
+    # but wrap the entire result to ensure it's a single expression that can be used
+    if children_with_addr:
+        # Build a chain that checks each address in sequence
+        # Using a helper that we define in devicetree.h: DT_CHILD_BY_UNIT_ADDR_IMPL(addr, idx, max_idx, node_id)
+        # But this is complex - let's use a simpler approach
+        
+        # Instead, generate the expansion directly using a helper defined in devicetree.h
+        # Generate inline expansion using nested ternary operators
+        # This expands to: ((addr == a0) ? id0 : ((addr == a1) ? id1 : ... 0))
+        # Note: Using 0 for no match (will need special handling by users)
+        if children_with_addr:
+            # Build from the end backwards
+            result = "0"  # Use 0 instead of DT_INVALID_NODE to avoid compilation issues
+            for i, child in reversed(list(children_with_addr)):
+                addr_macro = f"DT_{node.z_path_id}_CHILD_{i}_UNIT_ADDR"
+                child_id = f"DT_{child.z_path_id}"
+                result = f"((addr) == ({addr_macro}) ? {child_id} : {result})"
+            
+            out_dt_define(f"{node.z_path_id}_CHILD_BY_UNIT_ADDR_INT(addr)", result)
+
     out_dt_define(f"{node.z_path_id}_FOREACH_CHILD(fn)",
             " ".join(f"fn(DT_{child.z_path_id})" for child in
                 node.children.values()))

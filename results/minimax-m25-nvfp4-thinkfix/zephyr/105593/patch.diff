 	return ret;
 }
+
+int zms_get_num_cycles(struct zms_fs *fs, uint32_t *cycles)
+{
+	int rc;
+	struct zms_ate empty_ate;
+	struct zms_ate close_ate;
+	uint64_t addr;
+	uint32_t max_cycles = 0;
+	uint32_t sector_cycles;
+
+	if (!fs || !cycles) {
+		LOG_ERR("Invalid fs or cycles pointer");
+		return -EINVAL;
+	}
+
+	if (!fs->ready) {
+		LOG_ERR("ZMS not initialized");
+		return -EACCES;
+	}
+
+	k_mutex_lock(&fs->zms_lock, K_FOREVER);
+
+	/* Scan all sectors to find the maximum cycle count */
+	for (uint32_t i = 0; i < fs->sector_count; i++) {
+		addr = ((uint64_t)i << ADDR_SECT_SHIFT);
+		addr = zms_close_ate_addr(fs, addr);
+
+		rc = zms_get_sector_header(fs, addr, &empty_ate, &close_ate);
+		if (rc != 0) {
+			continue;
+		}
+
+		if (!zms_sector_closed(fs, &empty_ate, &close_ate)) {
+			/* Sector not closed, skip */
+			continue;
+		}
+
+		/* Calculate full 32-bit cycle count:
+		 * - lower 8 bits from cycle_cnt
+		 * - upper bits from metadata (bits 20-31)
+		 */
+		sector_cycles = close_ate.cycle_cnt |
+				((uint32_t)ZMS_GET_CYCLE_WRAPS(empty_ate.metadata) << 8);
+
+		if (sector_cycles > max_cycles) {
+			max_cycles = sector_cycles;
+		}
+	}
+
+	/* Also check the current active sector */
+	if (fs->ready) {
+		/* Read the current sector's header to get the wrap count */
+		struct zms_ate current_empty_ate;
+		uint64_t current_addr = zms_empty_ate_addr(fs, fs->ate_wra);
+		
+		rc = zms_flash_ate_rd(fs, current_addr, &current_empty_ate);
+		if (rc == 0 && zms_empty_ate_valid(fs, &current_empty_ate)) {
+			sector_cycles = fs->sector_cycle |
+					((uint32_t)ZMS_GET_CYCLE_WRAPS(current_empty_ate.metadata) << 8);
+			if (sector_cycles > max_cycles) {
+				max_cycles = sector_cycles;
+			}
+		}
+	}
+
+	*cycles = max_cycles;
+
+	k_mutex_unlock(&fs->zms_lock);
+	return 0;
+}
+
+int zms_get_sector_num_cycles(struct zms_fs *fs, uint32_t sector, uint32_t *cycles)
+{
+	int rc;
+	struct zms_ate empty_ate;
+	struct zms_ate close_ate;
+	uint64_t addr;
+
+	if (!fs || !cycles) {
+		LOG_ERR("Invalid fs or cycles pointer");
+		return -EINVAL;
+	}
+
+	if (!fs->ready) {
+		LOG_ERR("ZMS not initialized");
+		return -EACCES;
+	}
+
+	if (sector >= fs->sector_count) {
+		LOG_ERR("Sector index out of range: %u (max: %u)", sector, fs->sector_count - 1);
+		return -EINVAL;
+	}
+
+	k_mutex_lock(&fs->zms_lock, K_FOREVER);
+
+	addr = ((uint64_t)sector << ADDR_SECT_SHIFT);
+	addr = zms_close_ate_addr(fs, addr);
+
+	rc = zms_get_sector_header(fs, addr, &empty_ate, &close_ate);
+	if (rc != 0) {
+		k_mutex_unlock(&fs->zms_lock);
+		return rc;
+	}
+
+	if (!zms_sector_closed(fs, &empty_ate, &close_ate)) {
+		/* Sector not closed yet, use the empty_ate cycle count */
+		*cycles = empty_ate.cycle_cnt |
+			  ((uint32_t)ZMS_GET_CYCLE_WRAPS(empty_ate.metadata) << 8);
+	} else {
+		/* Sector is closed, use the close_ate cycle count */
+		*cycles = close_ate.cycle_cnt |
+			  ((uint32_t)ZMS_GET_CYCLE_WRAPS(empty_ate.metadata) << 8);
+	}
+
+	k_mutex_unlock(&fs->zms_lock);
+	return 0;
+}

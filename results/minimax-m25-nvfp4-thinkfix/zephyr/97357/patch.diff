diff --git a/include/zephyr/posix/sys/times.h b/include/zephyr/posix/sys/times.h
new file mode 100644
index 00000000..4ead2c7d
--- /dev/null
+++ b/include/zephyr/posix/sys/times.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright (c) 2024 Tenstorrent AI ULC
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_POSIX_SYS_TIMES_H_
+#define ZEPHYR_INCLUDE_POSIX_SYS_TIMES_H_
+
+#include <zephyr/posix/posix_types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Structure timespec as defined by POSIX.
+ * This is used to measure CPU times.
+ */
+struct tms {
+	clock_t tms_utime;   /* user CPU time */
+	clock_t tms_stime;   /* system CPU time */
+	clock_t tms_cutime;  /* user CPU time of children (always 0 in Zephyr) */
+	clock_t tms_cstime;  /* system CPU time of children (always 0 in Zephyr) */
+};
+
+/*
+ * Get process times.
+ *
+ * This function returns timing information for the current process
+ * and its children.
+ *
+ * @param buf Pointer to a struct tms where the times will be stored.
+ *
+ * @return The return value is the elapsed real time in clock ticks,
+ *         measured from some arbitrary point in the past.
+ *         On error, (clock_t) -1 is returned and errno is set.
+ */
+clock_t times(struct tms *buf);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_POSIX_SYS_TIMES_H_ */

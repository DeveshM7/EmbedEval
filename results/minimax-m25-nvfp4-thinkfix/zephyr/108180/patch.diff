 	return net_socket_service_register(service, NULL, 0, NULL);
 }
 
+/**
+ * @brief Close the sockets that are registered to a socket service.
+ *
+ * This function will close the sockets that are registered to the service,
+ * and then unregister the service. After calling this function, the caller
+ * should not close the sockets as they are already closed by this function.
+ *
+ * @param service Pointer to a service description.
+ *
+ * @retval 0 No error
+ * @retval -ENOENT Service is not found.
+ */
+__syscall int net_socket_service_close(const struct net_socket_service_desc *service);
+

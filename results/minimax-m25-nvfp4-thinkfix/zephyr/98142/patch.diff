index 0fff534c..28a6ab9e 100644
--- a/subsys/zbus/zbus.c
+++ b/subsys/zbus/zbus.c
@@ -11,6 +11,49 @@
 #include <zephyr/net_buf.h>
 #include <zephyr/zbus/zbus.h>
 LOG_MODULE_REGISTER(zbus, CONFIG_ZBUS_LOG_LEVEL);
+#if defined(CONFIG_ZBUS_ASYNC_LISTENER)
+/* Async listener support */
+#include <zephyr/sys/dlist.h>
+
+struct _zbus_async_listener_msg {
+	sys_dnode_t node;
+	const struct zbus_channel *chan;
+	void *msg;
+	size_t msg_size;
+};
+
+static void _zbus_async_listener_work_handler(struct k_work *work)
+{
+	struct zbus_async_listener_work *async_work =
+		CONTAINER_OF(work, struct zbus_async_listener_work, work);
+	struct zbus_observer *obs = (struct zbus_observer *)async_work->obs;
+	
+	/* Process all pending messages */
+	while (1) {
+		sys_dlist_t *list = &async_work->msg_list;
+		
+		/* Get the first message from the list */
+		sys_dnode_t *node = sys_dlist_peek_head(list);
+		if (node == NULL) {
+			break;
+		}
+		
+		sys_dlist_remove(node);
+		
+		struct _zbus_async_listener_msg *async_msg =
+			CONTAINER_OF(node, struct _zbus_async_listener_msg, node);
+		
+		/* Call the callback with the channel and message copy */
+		obs->async_callback(async_msg->chan, async_msg->msg);
+		
+		/* Free the message copy and the msg structure */
+		k_free(async_msg->msg);
+		k_free(async_msg);
+	}
+}
+
+#endif /* CONFIG_ZBUS_ASYNC_LISTENER */
+
 
 #if defined(CONFIG_ZBUS_PRIORITY_BOOST)

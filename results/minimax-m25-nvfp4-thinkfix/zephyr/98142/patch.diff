+int zbus_async_listener_set_work_queue(const struct zbus_observer *obs, struct k_work_q *queue)
+{
+	_ZBUS_ASSERT(obs != NULL, "obs is required");
+	_ZBUS_ASSERT(queue != NULL, "queue is required");
+
+	if (obs->type != ZBUS_OBSERVER_ASYNC_LISTENER_TYPE) {
+		return -EINVAL;
+	}
+
+	obs->work->queue = queue;
+
+	return 0;
+}
+#endif /* CONFIG_ZBUS_ASYNC_LISTENER */

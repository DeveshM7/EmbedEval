 #endif /* CONFIG_ZBUS_MSG_SUBSCRIBER */
 
+#if defined(CONFIG_ZBUS_ASYNC_LISTENER)
+	case ZBUS_OBSERVER_ASYNC_LISTENER_TYPE: {
+		/* For async listener, we need to copy the message and schedule work */
+		struct zbus_async_listener_work *async_work = obs->work;
+		size_t msg_size = zbus_chan_msg_size(chan);
+
+		/* Allocate message buffer from heap */
+		void *msg_copy = k_malloc(msg_size);
+
+		if (msg_copy == NULL) {
+			return -ENOMEM;
+		}
+
+		/* Copy the message */
+		memcpy(msg_copy, zbus_chan_msg(chan), msg_size);
+
+		/* Allocate the async message structure */
+		struct _zbus_async_listener_msg *async_msg = 
+			k_malloc(sizeof(struct _zbus_async_listener_msg));
+		
+		if (async_msg == NULL) {
+			k_free(msg_copy);
+			return -ENOMEM;
+		}
+
+		async_msg->chan = chan;
+		async_msg->msg = msg_copy;
+		async_msg->msg_size = msg_size;
+
+		/* Add to the async work's queue list */
+		sys_dlist_append(&async_work->msg_list, &async_msg->node);
+
+		/* Initialize the observer pointer and work handler if not set yet */
+		if (async_work->obs == NULL) {
+			async_work->obs = obs;
+			k_work_init(&async_work->work, _zbus_async_listener_work_handler);
+		}
+
+		/* Submit the work to the queue */
+		k_work_submit_to_queue(async_work->queue, &async_work->work);
+
+		break;
+	}
+#endif /* CONFIG_ZBUS_ASYNC_LISTENER */
+
 	default:
 		_ZBUS_ASSERT(false, "Unreachable");
 	}

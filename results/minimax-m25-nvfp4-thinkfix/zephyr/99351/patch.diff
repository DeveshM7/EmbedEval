+# Copyright (c) 2023 Nordic Semiconductor ASA
+# SPDX-License-Identifier: Apache-2.0
+
+description: Test PDM Microphone node
+
+compatible: "vnd,test-mic"
+
+include: base.yaml
+
+properties:
+  clk_frequency_min:
+    type: int
+    required: true
+
+  clk_frequency_max:
+    type: int
+    required: true
+
+  clk_duty_cycle_min:
+    type: int
+    required: true
+
+  clk_duty_cycle_max:
+    type: int
+    required: true
+
+  channel_left:
+    type: boolean
+
+  channel_right:
+    type: boolean
diff --git a/include/zephyr/audio/dmic.h b/include/zephyr/audio/dmic.h
index bb46e008..351679af 100644
--- a/include/zephyr/audio/dmic.h
+++ b/include/zephyr/audio/dmic.h
@@ -318,6 +318,51 @@ static inline int dmic_read(const struct device *dev, uint8_t stream,
 	return api->read(dev, stream, buffer, size, timeout);
 }
 
+/**
+ * Get a pdm_io_cfg structure from a devicetree node
+ *
+ * This macro creates a pdm_io_cfg structure populated from the
+ * devicetree properties of the given node. The properties used are:
+ * - clk-frequency-min -> min_pdm_clk_freq
+ * - clk-frequency-max -> max_pdm_clk_freq
+ * - clk-duty-cycle-min -> min_pdm_clk_dc
+ * - clk-duty-cycle-max -> max_pdm_clk_dc
+ *
+ * @param node_id devicetree node identifier
+ * @return pdm_io_cfg structure populated from devicetree
+ */
+#define PDM_DT_IO_CFG_GET(node_id) \
+	{ \
+		.min_pdm_clk_freq = DT_PROP(node_id, clk_frequency_min), \
+		.max_pdm_clk_freq = DT_PROP(node_id, clk_frequency_max), \
+		.min_pdm_clk_dc = DT_PROP(node_id, clk_duty_cycle_min), \
+		.max_pdm_clk_dc = DT_PROP(node_id, clk_duty_cycle_max), \
+	}
+
+/**
+ * Check if a devicetree node has a left channel
+ *
+ * This macro evaluates to true if the given devicetree node has the
+ * channel-left property present.
+ *
+ * @param node_id devicetree node identifier
+ * @return true if channel-left property exists, false otherwise
+ */
+#define PDM_DT_HAS_LEFT_CHANNEL(node_id) \
+	DT_PROP(node_id, channel_left)
+
+/**
+ * Check if a devicetree node has a right channel
+ *
+ * This macro evaluates to true if the given devicetree node has the
+ * channel-right property present.
+ *
+ * @param node_id devicetree node identifier
+ * @return true if channel-right property exists, false otherwise
+ */
+#define PDM_DT_HAS_RIGHT_CHANNEL(node_id) \
+	DT_PROP(node_id, channel_right)
+
 #ifdef __cplusplus
 }
 #endif

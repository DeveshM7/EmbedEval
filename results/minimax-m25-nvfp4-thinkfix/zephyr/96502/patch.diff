+/**
+ * @brief Pre-define a topic with a known topic ID.
+ *
+ * This function allows pre-defining a topic with a known topic ID, bypassing
+ * the normal REGISTER exchange with the gateway. When subscribing or publishing
+ * to this topic, the numeric topic ID will be used instead of the topic name.
+ *
+ * @param client The MQTT-SN client.
+ * @param topic_id The pre-defined topic ID (must be non-zero).
+ * @param topic_name The topic name.
+ *
+ * @return 0 on success, -EALREADY if the topic name or topic ID is already
+ *         registered, -EINVAL if invalid arguments, -ENOMEM if no memory.
+ */
+int mqtt_sn_predefine_topic(struct mqtt_sn_client *client, uint16_t topic_id,
+			     struct mqtt_sn_data *topic_name);
+
 #ifdef __cplusplus
 }

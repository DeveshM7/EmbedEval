diff --git a/subsys/net/ip/Kconfig b/subsys/net/ip/Kconfig
index aa95a88e..999e97ef 100644
--- a/subsys/net/ip/Kconfig
+++ b/subsys/net/ip/Kconfig
@@ -509,6 +509,22 @@ config NET_UDP_MISSING_CHECKSUM
 	  for IPv4 and on reception only, since Zephyr will always compute the
 	  UDP checksum in transmission path.
 
+config NET_CHECKSUM_OFFLOAD_SUPPORTED
+	def_bool n
+	help
+	  Hidden option that is selected by ethernet drivers that support
+	  hardware checksum offloading.
+
+config NET_CHECKSUM_OFFLOAD
+	bool "Checksum offloading"
+	default y
+	help
+	  Enable or disable TX and RX checksum offloading. When enabled and
+	  the underlying ethernet driver supports hardware checksum
+	  offloading, the stack will skip calculating checksums in software,
+	  leaving them zero for the hardware to fill.
+
+
 if NET_UDP
 module = NET_UDP
 module-dep = NET_LOG
diff --git a/subsys/net/ip/net_if.c b/subsys/net/ip/net_if.c
index 5aba61ef..c9df2113 100644
--- a/subsys/net/ip/net_if.c
+++ b/subsys/net/ip/net_if.c
@@ -5722,6 +5722,11 @@ void net_if_call_link_cb(struct net_if *iface, struct net_linkaddr *lladdr,
 static bool need_calc_checksum(struct net_if *iface, enum ethernet_hw_caps caps,
 			      enum net_if_checksum_type chksum_type)
 {
+	if (!IS_ENABLED(CONFIG_NET_CHECKSUM_OFFLOAD)) {
+		/* User disabled checksum offloading, calculate in SW */
+		return true;
+	}
+
 #if defined(CONFIG_NET_L2_ETHERNET)
 	struct ethernet_config config;
 	enum ethernet_config_type config_type;

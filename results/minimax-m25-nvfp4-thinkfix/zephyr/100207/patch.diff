diff --git a/include/zephyr/drivers/adc.h b/include/zephyr/drivers/adc.h
index 59d58220..3b439312 100644
--- a/include/zephyr/drivers/adc.h
+++ b/include/zephyr/drivers/adc.h
@@ -544,6 +544,106 @@ struct adc_dt_spec {
  */
 #define ADC_DT_SPEC_INST_GET(inst) ADC_DT_SPEC_GET(DT_DRV_INST(inst))
 
+
+/** @brief Get ADC io-channel information from devicetree by name, with fallback.
+ *
+ * This is similar to ADC_DT_SPEC_GET_BY_NAME(), but expands to
+ * @p default_value when the io-channel does not exist.
+ *
+ * @see ADC_DT_SPEC_GET_BY_NAME()
+ *
+ * @param node_id Devicetree node identifier.
+ * @param name Channel name.
+ * @param default_value Fallback value.
+ *
+ * @return Static initializer for an adc_dt_spec structure, or
+ *         @p default_value if the io-channel does not exist.
+ */
+#define ADC_DT_SPEC_GET_BY_NAME_OR(node_id, name, default_value) \
+	COND_CODE_1(DT_PROP_HAS_NAME(node_id, io_channels, name), \
+		    (ADC_DT_SPEC_GET_BY_NAME(node_id, name)), \
+		    (default_value))
+
+/** @brief Get ADC io-channel information from a DT_DRV_COMPAT devicetree
+ *         instance by name, with fallback.
+ *
+ * @see ADC_DT_SPEC_GET_BY_NAME_OR()
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param name Channel name.
+ * @param default_value Fallback value.
+ *
+ * @return Static initializer for an adc_dt_spec structure, or
+ *         @p default_value if the instance or io-channel does not exist.
+ */
+#define ADC_DT_SPEC_INST_GET_BY_NAME_OR(inst, name, default_value) \
+	COND_CODE_1(UTIL_AND(DT_NODE_EXISTS(DT_DRV_INST(inst)), \
+			    DT_PROP_HAS_NAME(DT_DRV_INST(inst), io_channels, name)), \
+		    (ADC_DT_SPEC_INST_GET_BY_NAME(inst, name)), \
+		    (default_value))
+
+/** @brief Get ADC io-channel information from devicetree by index, with fallback.
+ *
+ * This is similar to ADC_DT_SPEC_GET_BY_IDX(), but expands to
+ * @p default_value when the io-channel does not exist.
+ *
+ * @see ADC_DT_SPEC_GET_BY_IDX()
+ *
+ * @param node_id Devicetree node identifier.
+ * @param idx Channel index.
+ * @param default_value Fallback value.
+ *
+ * @return Static initializer for an adc_dt_spec structure, or
+ *         @p default_value if the io-channel does not exist.
+ */
+#define ADC_DT_SPEC_GET_BY_IDX_OR(node_id, idx, default_value) \
+	COND_CODE_1(DT_PROP_HAS_IDX(node_id, io_channels, idx), \
+		    (ADC_DT_SPEC_GET_BY_IDX(node_id, idx)), \
+		    (default_value))
+
+/** @brief Get ADC io-channel information from a DT_DRV_COMPAT devicetree
+ *         instance by index, with fallback.
+ *
+ * @see ADC_DT_SPEC_GET_BY_IDX_OR()
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param idx Channel index.
+ * @param default_value Fallback value.
+ *
+ * @return Static initializer for an adc_dt_spec structure, or
+ *         @p default_value if the instance or io-channel does not exist.
+ */
+#define ADC_DT_SPEC_INST_GET_BY_IDX_OR(inst, idx, default_value) \
+	COND_CODE_1(UTIL_AND(DT_NODE_EXISTS(DT_DRV_INST(inst)), \
+			    DT_PROP_HAS_IDX(DT_DRV_INST(inst), io_channels, idx)), \
+		    (ADC_DT_SPEC_INST_GET_BY_IDX(inst, idx)), \
+		    (default_value))
+
+/** @brief Equivalent to ADC_DT_SPEC_GET_BY_IDX_OR(node_id, 0, default_value).
+ *
+ * @see ADC_DT_SPEC_GET_BY_IDX_OR()
+ *
+ * @param node_id Devicetree node identifier.
+ * @param default_value Fallback value.
+ *
+ * @return Static initializer for an adc_dt_spec structure, or
+ *         @p default_value if the io-channel does not exist.
+ */
+#define ADC_DT_SPEC_GET_OR(node_id, default_value) \
+	ADC_DT_SPEC_GET_BY_IDX_OR(node_id, 0, default_value)
+
+/** @brief Equivalent to ADC_DT_SPEC_INST_GET_BY_IDX_OR(inst, 0, default_value).
+ *
+ * @see ADC_DT_SPEC_GET_OR()
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param default_value Fallback value.
+ *
+ * @return Static initializer for an adc_dt_spec structure, or
+ *         @p default_value if the instance or io-channel does not exist.
+ */
+#define ADC_DT_SPEC_INST_GET_OR(inst, default_value) \
+	ADC_DT_SPEC_INST_GET_BY_IDX_OR(inst, 0, default_value)
 /* Forward declaration of the adc_sequence structure. */
 struct adc_sequence;
 

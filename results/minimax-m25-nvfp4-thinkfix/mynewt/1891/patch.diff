+#ifndef __TRNG_SW_H__
+#define __TRNG_SW_H__
+
+#include <inttypes.h>
+#include <stddef.h>
+#include "os/mynewt.h"
+#include "trng/trng.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct trng_sw_dev {
+    struct trng_dev trng;
+    /* Software TRNG state */
+    uint32_t swentropy;
+    int init;
+};
+
+/**
+ * Initialize the software TRNG device
+ *
+ * @param dev  OS device
+ * @param arg  Unused
+ *
+ * @return 0 on success
+ */
+int trng_sw_dev_init(struct os_dev *dev, void *arg);
+
+/**
+ * Add entropy to the software TRNG
+ *
+ * @param tsd      Software TRNG device
+ * @param entr     Entropy data pointer
+ * @param entr_len Length of entropy data
+ *
+ * @return 0 on success, non-zero on failure
+ */
+int trng_sw_dev_add_entropy(struct trng_sw_dev *tsd, void *entr, int entr_len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __TRNG_SW_H__ */

+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+struct fcb_area_info_arg {
+    int elem_cnt;
+    int byte_cnt;
+};
+
+static int
+fcb_area_info_cb(struct fcb_entry *loc, void *arg)
+{
+    struct fcb_area_info_arg *ai_arg = (struct fcb_area_info_arg *)arg;
+
+    ai_arg->elem_cnt++;
+    ai_arg->byte_cnt += loc->fe_data_len;
+
+    return 0;
+}
+
+/**
+ * Get information about the specified FCB area.
+ *
+ * @param fcb Pointer to FCB
+ * @param fa Pointer to flash area, or NULL for oldest area
+ * @param elemsp Pointer to store number of elements in area
+ * @param bytesp Pointer to store total bytes of user data in area
+ * @return 0 on success, non-zero on error
+ */
+int
+fcb_area_info(struct fcb *fcb, struct flash_area *fa, int *elemsp, int *bytesp)
+{
+    struct fcb_area_info_arg ai_arg;
+    int rc;
+
+    if (!elemsp || !bytesp) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* If fa is NULL, use the oldest area */
+    if (fa == NULL) {
+        fa = fcb->f_oldest;
+    }
+
+    ai_arg.elem_cnt = 0;
+    ai_arg.byte_cnt = 0;
+
+    rc = os_mutex_pend(&fcb->f_mtx, OS_WAIT_FOREVER);
+    if (rc && rc != OS_NOT_STARTED) {
+        return FCB_ERR_ARGS;
+    }
+
+    rc = fcb_walk(fcb, fa, fcb_area_info_cb, &ai_arg);
+
+    os_mutex_release(&fcb->f_mtx);
+
+    if (rc != 0 && rc != FCB_ERR_NOVAR) {
+        return rc;
+    }
+
+    *elemsp = ai_arg.elem_cnt;
+    *bytesp = ai_arg.byte_cnt;
+
+    return 0;
+}

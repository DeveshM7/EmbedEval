diff --git a/sys/log/full/src/log.c b/sys/log/full/src/log.c
index 4fa8581..7a2a1c8 100644
--- a/sys/log/full/src/log.c
+++ b/sys/log/full/src/log.c
@@ -503,3 +503,191 @@ log_flush(struct log *log)
 err:
     return (rc);
 }
+
+/**
+ * Appends a body without header to the log.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int
+log_append_body(struct log *log, uint8_t module, uint8_t level, uint8_t etype,
+                const void *body, uint16_t body_len)
+{
+    struct log_entry_hdr ue;
+    int rc;
+
+    rc = log_append_prepare(log, module, level, etype, &ue);
+    if (rc != 0) {
+        goto err;
+    }
+
+    /* Append the header first */
+    rc = log->l_log->log_append(log, &ue, sizeof(ue));
+    if (rc != 0) {
+        goto err;
+    }
+
+    /* Append the body */
+    rc = log->l_log->log_append(log, (void *)body, body_len);
+    if (rc != 0) {
+        goto err;
+    }
+
+    return 0;
+err:
+    return rc;
+}
+
+/**
+ * Appends a body from an mbuf chain without header to the log.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int
+log_append_mbuf_body(struct log *log, uint8_t module, uint8_t level,
+                     uint8_t etype, struct os_mbuf *om)
+{
+    struct log_entry_hdr ue;
+    int rc;
+
+    if (!log->l_log->log_append_mbuf) {
+        rc = -1;
+        goto err;
+    }
+
+    rc = log_append_prepare(log, module, level, etype, &ue);
+    if (rc != 0) {
+        goto err;
+    }
+
+    /* Prepend the header to the mbuf */
+    om = os_mbuf_prepend(om, sizeof(ue));
+    if (!om) {
+        rc = -1;
+        goto err;
+    }
+
+    memcpy(om->om_data, &ue, sizeof(ue));
+
+    rc = log->l_log->log_append_mbuf(log, om);
+    if (rc != 0) {
+        goto err;
+    }
+
+    return 0;
+
+err:
+    if (om) {
+        os_mbuf_free_chain(om);
+    }
+    return rc;
+}
+
+/**
+ * Reads the entry header from a log entry.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int
+log_read_hdr(struct log *log, void *dptr, struct log_entry_hdr *hdr)
+{
+    int rc;
+
+    rc = log->l_log->log_read(log, dptr, hdr, 0, sizeof(*hdr));
+    if (rc < sizeof(*hdr)) {
+        return -1;
+    }
+
+    return 0;
+}
+
+/**
+ * Reads the body of a log entry into a flat buffer.
+ *
+ * @return                      The number of bytes read; -1 on failure.
+ */
+int
+log_read_body(struct log *log, void *dptr, void *buf, uint16_t off,
+             uint16_t len)
+{
+    int rc;
+
+    /* Read body at offset = LOG_ENTRY_HDR_SIZE */
+    rc = log->l_log->log_read(log, dptr, buf, LOG_ENTRY_HDR_SIZE + off, len);
+
+    return (rc);
+}
+
+/**
+ * Reads the body of a log entry into an mbuf.
+ *
+ * @return                      The number of bytes read; -1 on failure.
+ */
+int
+log_read_mbuf_body(struct log *log, void *dptr, struct os_mbuf *om, uint16_t off,
+                   uint16_t len)
+{
+    int rc;
+
+    if (!om || !log->l_log->log_read_mbuf) {
+        return -1;
+    }
+
+    /* Read body at offset = LOG_ENTRY_HDR_SIZE */
+    rc = log->l_log->log_read_mbuf(log, dptr, om, LOG_ENTRY_HDR_SIZE + off, len);
+
+    return (rc);
+}
+
+/* Internal structure for log_walk_body */
+struct log_walk_body_arg {
+    log_walk_body_func_t walk_body_func;
+    struct log_entry_hdr hdr;
+};
+
+/**
+ * Internal wrapper function for log_walk_body.
+ * Called for each log entry during the walk.
+ */
+static int
+log_walk_body_wrapper(struct log *log, struct log_offset *log_offset,
+                      void *dptr, uint16_t len)
+{
+    struct log_walk_body_arg *arg;
+    int rc;
+
+    arg = (struct log_walk_body_arg *)log_offset->lo_arg;
+
+    /* Read header */
+    rc = log_read_hdr(log, dptr, &arg->hdr);
+    if (rc != 0) {
+        return rc;
+    }
+
+    /* Call the user-provided callback with header and body length */
+    return arg->walk_body_func(log, log_offset, &arg->hdr, dptr,
+                               len - LOG_ENTRY_HDR_SIZE);
+}
+
+/**
+ * Walks log entries, calling a body callback for each entry.
+ *
+ * @return                      0 if the walk completed successfully; nonzero
+ *                              on error or if the walk was aborted.
+ */
+int
+log_walk_body(struct log *log, log_walk_body_func_t walk_body_func,
+              struct log_offset *log_offset)
+{
+    struct log_walk_body_arg arg;
+    int rc;
+
+    arg.walk_body_func = walk_body_func;
+
+    /* Temporarily replace lo_arg with our wrapper arg */
+    log_offset->lo_arg = &arg;
+
+    rc = log_walk(log, log_walk_body_wrapper, log_offset);
+
+    return rc;
+}

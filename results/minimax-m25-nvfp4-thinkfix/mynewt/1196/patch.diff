+/**
+ * @brief Appends a body without a header to the log.
+ *
+ * @param log                   The log to write to.
+ * @param module                The module ID of the entry to write.
+ * @param level                 The severity of the entry to write; one of the
+ *                                  `LOG_LEVEL_[...]` constants.
+ * @param etype                 The type of data to write; one of the
+ *                                  `LOG_ETYPE_[...]` constants.
+ * @param body                  The body data to write.
+ * @param body_len              The length of the body data.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int log_append_body(struct log *log, uint8_t module, uint8_t level,
+                    uint8_t etype, const void *body, uint16_t body_len);
+
+/**
+ * @brief Appends a body from an mbuf chain without a header to the log.
+ *
+ * @param log                   The log to write to.
+ * @param module                The module ID of the entry to write.
+ * @param level                 The severity of the entry to write; one of the
+ *                                  `LOG_LEVEL_[...]` constants.
+ * @param etype                 The type of data to write; one of the
+ *                                  `LOG_ETYPE_[...]` constants.
+ * @param om                    The mbuf chain containing the body to write.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int log_append_mbuf_body(struct log *log, uint8_t module, uint8_t level,
+                         uint8_t etype, struct os_mbuf *om);
+
+/**
+ * @brief Reads the entry header from a log entry.
+ *
+ * @param log                   The log to read from.
+ * @param dptr                  The log entry pointer.
+ * @param hdr                   Pointer to store the header.
+ *
+ * @return                      0 on success; nonzero on failure.
+ */
+int log_read_hdr(struct log *log, void *dptr, struct log_entry_hdr *hdr);
+
+/**
+ * @brief Reads the body of a log entry into a flat buffer.
+ *
+ * @param log                   The log to read from.
+ * @param dptr                  The log entry pointer.
+ * @param buf                   Buffer to store the body data.
+ * @param off                   Offset within the body to start reading.
+ * @param len                   Number of bytes to read.
+ *
+ * @return                      Number of bytes read on success; -1 on failure.
+ */
+int log_read_body(struct log *log, void *dptr, void *buf, uint16_t off,
+                  uint16_t len);
+
+/**
+ * @brief Reads the body of a log entry into an mbuf.
+ *
+ * @param log                   The log to read from.
+ * @param dptr                  The log entry pointer.
+ * @param om                    The mbuf to write the body data to.
+ * @param off                   Offset within the body to start reading.
+ * @param len                   Number of bytes to read.
+ *
+ * @return                      Number of bytes read on success; -1 on failure.
+ */
+int log_read_mbuf_body(struct log *log, void *dptr, struct os_mbuf *om,
+                       uint16_t off, uint16_t len);
+
+/**
+ * @brief Walks log entries, calling a body callback for each entry.
+ *
+ * @param log                   The log to walk.
+ * @param walk_body_func        Callback function to call for each entry.
+ * @param log_offset            Pointer to log_offset structure.
+ *
+ * @return                      0 if the walk completed successfully; nonzero
+ *                              on error or if the walk was aborted.
+ */
+int log_walk_body(struct log *log, log_walk_body_func_t walk_body_func,
+                  struct log_offset *log_offset);
+
 #if MYNEWT_VAL(LOG_MODULE_LEVELS)
 /**

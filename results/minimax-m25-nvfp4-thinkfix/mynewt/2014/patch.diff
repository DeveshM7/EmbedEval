+#ifndef __SYS_FCB2_H_
+#define __SYS_FCB2_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * \defgroup FCB2 Flash circular buffer.
+ * @{
+ */
+
+#include <inttypes.h>
+#include <limits.h>
+#include <assert.h>
+
+#include <syscfg/syscfg.h>
+#include <os/os_mutex.h>
+#include <flash_map/flash_map.h>
+
+#define FCB2_MAX_LEN	(CHAR_MAX | CHAR_MAX << 7) /* Max length of element */
+
+#define FCB2_SECTOR_OLDEST UINT16_MAX
+
+struct fcb2;
+
+/**
+ * Entry location point to sector, and offset
+ * within that sector.
+ */
+struct fcb2_entry {
+    struct flash_sector_range *fe_range;  /* ptr to area within fcb2->f_ranges */
+    uint16_t fe_sector;     /* sector number in fcb2 flash */
+    uint16_t fe_data_len;   /* size of data area */
+    uint32_t fe_data_off;   /* start of data in sector */
+    uint16_t fe_entry_num;  /* entry number in sector */
+};
+
+/* Number of bytes needed for fcb2_sector_entry on flash */
+#define FCB2_ENTRY_SIZE          6
+#define FCB2_CRC_LEN             2
+
+struct fcb2_disk_area {
+    uint32_t fd_magic;
+    uint8_t  fd_ver;
+    uint8_t  _pad;
+    uint16_t fd_id;
+};
+
+struct fcb2 {
+    /* Caller of fcb2_init fills this in */
+    uint32_t f_magic;       /* As placed on the disk */
+    uint8_t f_version;      /* Current version number of the data */
+    uint8_t f_scratch_cnt;  /* How many sectors should be kept empty */
+    uint8_t f_range_cnt;    /* Number of elements in range array */
+    uint16_t f_sector_cnt;  /* Number of sectors used by fcb2 */
+    uint16_t f_oldest_sec;  /* Index of oldest sector */
+    struct flash_sector_range *f_ranges;
+
+    /* Flash circular buffer internal state */
+    struct os_mutex f_mtx;	/* Locking for accessing the FCB2 data */
+    struct fcb2_entry f_active;
+    uint16_t f_active_id;
+};
+
+/**
+ * Error codes.
+ */
+#define FCB2_OK           0
+#define FCB2_ERR_ARGS    -1
+#define FCB2_ERR_FLASH   -2
+#define FCB2_ERR_NOVAR   -3
+#define FCB2_ERR_NOSPACE -4
+#define FCB2_ERR_NOMEM   -5
+#define FCB2_ERR_CRC     -6
+#define FCB2_ERR_MAGIC   -7
+#define FCB2_ERR_VERSION -8
+
+int fcb2_init(struct fcb2 *fcb2);
+
+/*
+ * Initialize fcb2 for specific flash area
+ *
+ * Function initializes FCB2 structure with data taken from specified flash
+ * area.
+ * If FCB2 was not initialized before in this area, area will be erased.
+ *
+ * @param fcb2            Fcb2 to initialize
+ * @param flash_area_id  flash area for this fcb2
+ * @param magic          User defined magic value that is stored in each
+ *                       flash sector used by fcb2
+ * @param version        version of fcb2
+ *
+ */
+int fcb2_init_flash_area(struct fcb2 *fcb2, int flash_area_id, uint32_t magic,
+    uint8_t version);
+
+/**
+ * fcb2_append() appends an entry to circular buffer. When writing the
+ * contents for the entry, fcb2_write() with fcb2_entry filled by.
+ * fcb2_append(). When you're finished, call fcb2_append_finish() with
+ * loc as argument.
+ */
+int fcb2_append(struct fcb2 *fcb2, uint16_t len, struct fcb2_entry *loc);
+int fcb2_write(struct fcb2_entry *loc, uint16_t off, const void *buf,
+              uint16_t len);
+int fcb2_append_finish(struct fcb2_entry *append_loc);
+
+/**
+ * Walk over all log entries in FCB2, or entries in a given flash_area.
+ * cb gets called for every entry. If cb wants to stop the walk, it should
+ * return non-zero value.
+ *
+ * Entry data can be read using fcb2_read().
+ */
+typedef int (*fcb2_walk_cb)(struct fcb2_entry *loc, void *arg);
+int fcb2_walk(struct fcb2 *, int sector, fcb2_walk_cb cb, void *cb_arg);
+int fcb2_getnext(struct fcb2 *fcb2, struct fcb2_entry *loc);
+int fcb2_getprev(struct fcb2 *fcb2, struct fcb2_entry *loc);
+int fcb2_read(struct fcb2_entry *loc, uint16_t off, void *buf, uint16_t len);
+
+/**
+ * Erases the data from oldest sector.
+ */
+int fcb2_rotate(struct fcb2 *fcb2);
+
+/**
+ * Start using the scratch block.
+ */
+int fcb2_append_to_scratch(struct fcb2 *fcb2);
+
+/**
+ * How many sectors are unused.
+ */
+int fcb2_free_sector_cnt(struct fcb2 *fcb2);
+
+/**
+ * Whether FCB2 has any data.
+ */
+int fcb2_is_empty(struct fcb2 *fcb2);
+
+/**
+ * Element at offset *entries* from last position (backwards).
+ */
+int
+fcb2_offset_last_n(struct fcb2 *fcb2, uint8_t entries,
+                  struct fcb2_entry *last_n_entry);
+
+/**
+ * Erase sector in FCB2
+ *
+ * @param fcb2     FCB2 to use
+ * @param sector  sector number to erase 0..f_sector_cnt
+ *
+ * return 0 on success, error code on failure
+ */
+int fcb2_sector_erase(const struct fcb2 *fcb2, int sector);
+
+/**
+ * Get total size of FCB2
+ *
+ * @param fcb2     FCB2 to use
+ *
+ * return FCB2's size in bytes
+ */
+int fcb2_get_total_size(const struct fcb2 *fcb2);
+
+/**
+ * Clears FCB2 passed to it
+ */
+int fcb2_clear(struct fcb2 *fcb2);
+
+/**
+ * Usage report for a given FCB2 sector. Returns number of elements and the
+ * number of bytes stored in them.
+ */
+int fcb2_area_info(struct fcb2 *fcb2, int sector, int *elemsp, int *bytesp);
+
+#ifdef __cplusplus
+}
+
+/**
+ * @} FCB2
+ */
+
+#endif
+
+#endif /* __SYS_FCB2_H_ */

+
+/**
+ * Resume transmitting queued packets for a connection. This is called when
+ * the controller reports that packets have been completed (freed buffers).
+ */
+int
+ble_hs_hci_acl_tx_restart(struct ble_hs_conn *conn)
+{
+    struct os_mbuf *txom;
+    int rc;
+
+    while (conn->bhc_tx_q != NULL && ble_hs_hci_avail_pkts > 0) {
+        txom = conn->bhc_tx_q;
+        conn->bhc_tx_q = SLIST_NEXT(txom, om_next);
+        SLIST_NEXT(txom, om_next) = NULL;
+
+        rc = ble_hs_hci_acl_tx(conn, txom);
+        if (rc != 0) {
+            return rc;
+        }
+    }
+
+    if (conn->bhc_tx_q == NULL) {
+        conn->bhc_flags &= ~BLE_HS_CONN_F_TX_FRAG;
+    }
+
+    return 0;
 }

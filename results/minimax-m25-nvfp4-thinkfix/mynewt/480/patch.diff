+/**
+ * Checks if the GATT server is busy and cannot be reset or started.
+ * Returns 1 if busy (active connections or GAP procedures), 0 otherwise.
+ * Must be called with the host lock held.
+ */
+static int
+ble_gatts_is_busy(void)
+{
+    /* Check for active connections */
+    if (ble_hs_conn_first() != NULL) {
+        return 1;
+    }
+
+    /* Check for active GAP procedures */
+    if (ble_gap_adv_active() || ble_gap_disc_active() || ble_gap_conn_active()) {
+        return 1;
+    }
+
+    return 0;
+}
+
+int
+ble_gatts_reset(void)
+{
+    int busy;
+
+    /* Lock the host before checking */
+    ble_hs_lock();
+
+    /* Check if busy - cannot reset with active connections or GAP procedures */
+    busy = ble_gatts_is_busy();
+
+    ble_hs_unlock();
+
+    if (busy) {
+        return BLE_HS_EBUSY;
+    }
+
+    /* Reset the ATT server to clear all registered attributes */
+    ble_att_svr_reset();
+
+    /* Free GATT server memory */
+    ble_gatts_free_mem();
+
+    /* Free service definitions */
+    ble_gatts_free_svc_defs();
+
+    /* Reset the started state */
+    ble_gatts_started = 0;
+
+    return 0;
+}

+/**
+ * Clears all ATT server entries. This is used by the GATT server reset
+ * functionality to remove all registered services, characteristics, and
+ * descriptors.
+ */
+void
+ble_att_svr_reset(void)
+{
+    struct ble_att_svr_entry *entry;
+
+    /* Free all entries back to the pool */
+    while ((entry = STAILQ_FIRST(&ble_att_svr_list)) != NULL) {
+        STAILQ_REMOVE_HEAD(&ble_att_svr_list, ha_next);
+        os_memblock_put(&ble_att_svr_entry_pool, entry);
+    }
+
+    /* Reinitialize the list */
+    STAILQ_INIT(&ble_att_svr_list);
+
+    /* Reset the handle counter */
+    ble_att_svr_id = 0;
+}

+/**
+ * Register a sensor error listener. This allows a calling application to
+ * register callbacks for when a sensor read fails.
+ *
+ * @param The sensor object
+ * @param The error listener to register
+ *
+ * @return 0 on success, non-zero error code on failure.
+ */
+int
+sensor_register_err_listener(struct sensor *sensor,
+        struct sensor_err_listener *err_listener)
+{
+    int rc;
+
+    rc = sensor_lock(sensor);
+    if (rc != 0) {
+        goto err;
+    }
+
+    SLIST_INSERT_HEAD(&sensor->s_err_listener_list, err_listener, sel_next);
+
+    sensor_unlock(sensor);
+
+    return (0);
+err:
+    return (rc);
+}
 static int
 sensor_set_notification(struct sensor *sensor, struct sensor_notifier *notifier)
 {
@@ -1158,6 +1187,25 @@ sensor_read_data_func(struct sensor *sensor, void *arg, void *data,
     return (0);
 }
 
+
+/**
+ * Invoke error listeners for a failed sensor read.
+ *
+ * @param sensor The sensor object
+ * @param type The sensor type for which the read was attempted
+ * @param status The error status from the failed read
+ */
+static void
+sensor_invoke_err_listeners(struct sensor *sensor, sensor_type_t type, int status)
+{
+    struct sensor_err_listener *listener;
+
+    SLIST_FOREACH(listener, &sensor->s_err_listener_list, sel_next) {
+        if (listener->sel_sensor_type & type) {
+            listener->sel_func(sensor, listener->sel_arg, status, type);
+        }
+    }
+}
 /**
  * Puts a interrupt event on the sensor manager evq
  *
@@ -2163,6 +2211,7 @@ sensor_read(struct sensor *sensor, sensor_type_t type,
     rc = sensor->s_funcs->sd_read(sensor, type, sensor_read_data_func, &src,
                                   timeout);
     if (rc) {
+        sensor_invoke_err_listeners(sensor, type, rc);
         goto err;
     }
 

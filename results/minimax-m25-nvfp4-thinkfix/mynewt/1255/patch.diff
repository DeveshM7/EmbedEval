+/**
+ * Registration for sensor error notifications
+ */
+struct sensor_err_listener {
+    /* The type of sensor data to listen for errors on, this is interpreted as
+     * a mask, and this listener is called for all sensor types on this
+     * sensor that match the mask.
+     */
+    sensor_type_t sel_sensor_type;
+
+    /* Sensor error handler function, called when a read fails */
+    void (*sel_func)(struct sensor *sensor, void *arg, int status, sensor_type_t type);
+
+    /* Opaque argument for the sensor error handler function. */
+    void *sel_arg;
+
+    /* Next item in the sensor error listener list. The head of this list is
+     * contained within the sensor object.
+     */
+    SLIST_ENTRY(sensor_err_listener) sel_next;
+};
+
 /**
  * Context for sensor read events
  */
@@ -587,6 +609,11 @@ struct sensor {
     /* A list of sensor thresholds that are registered */

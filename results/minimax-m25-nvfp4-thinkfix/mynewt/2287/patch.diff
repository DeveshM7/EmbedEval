+/*
+ * Decode using the decoder struct.
+ * Supports in-place decoding and successive chunk processing.
+ */
+int
+base64_decoder_go(struct base64_decoder *dec)
+{
+    const char *p;
+    unsigned char *q;
+    unsigned char *out_start;
+    int in_place;
+    int bytes_this_call = 0;
+    
+    if (!dec || !dec->src || !dec->dst) {
+        return -1;
+    }
+    
+    out_start = (unsigned char *)dec->dst;
+    q = (unsigned char *)dec->dst;
+    
+    /* For in-place decoding, account for bytes already decoded */
+    in_place = (dec->src == dec->dst);
+    if (in_place) {
+        q += dec->bytes_decoded;
+    }
+    
+    p = dec->src;
+    
+    /* Process any leftover partial group from previous call */
+    while (dec->partial_count > 0 && dec->partial_count < 4) {
+        if (at_end(p, dec->src, dec->src_len)) break;
+        
+        char c = *p;
+        
+        /* Skip whitespace */
+        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+            p++;
+            continue;
+        }
+        
+        /* Check for valid base64 or padding */
+        if (c != '=' && !is_base64_char(c)) {
+            return -1;
+        }
+        
+        /* Add to partial group */
+        dec->partial_chars[dec->partial_count++] = c;
+        dec->seen_non_trailing = 1;
+        p++;
+        
+        if (dec->partial_count == 4) {
+            /* Have complete group, decode it */
+            unsigned char out[3];
+            int bytes_decoded;
+            int i;
+            
+            bytes_decoded = decode_group_full(dec->partial_chars, out);
+            if (bytes_decoded == DECODE_ERROR) {
+                return -1;
+            }
+            
+            /* Write output */
+            for (i = 0; i < bytes_decoded; i++) {
+                if (output_limit_reached(q, out_start, dec->dst_len)) {
+                    break;
+                }
+                *q++ = out[i];
+                dec->bytes_decoded++;
+                bytes_this_call++;
+            }
+            
+            /* Reset partial state */
+            dec->partial_count = 0;
+        }
+    }
+    
+    /* Now process complete groups */
+    while (!at_end(p, dec->src, dec->src_len)) {
+        char group[4];
+        int group_len = 0;
+        int bytes_decoded;
+        unsigned char out[3];
+        int i;
+        
+        /* Skip whitespace */
+        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') {
+            p++;
+            if (at_end(p, dec->src, dec->src_len)) break;
+        }
+        
+        if (at_end(p, dec->src, dec->src_len)) break;
+        
+        /* Collect up to 4 characters */
+        while (group_len < 4 && !at_end(p, dec->src, dec->src_len)) {
+            char c = *p;
+            
+            /* Check for valid base64 or padding */
+            if (c != '=' && !is_base64_char(c)) {
+                return -1;
+            }
+            
+            group[group_len++] = c;
+            p++;
+        }
+        
+        /* If we don't have a complete group */
+        if (group_len < 4) {
+            /* Check if we're at the end of input */
+            if (at_end(p, dec->src, dec->src_len)) {
+                /* For null-terminated input (src_len <= 0), validate the partial group */
+                if (dec->src_len <= 0) {
+                    /* Final chunk: must have complete groups - reject partial */
+                    return -1;
+                } else {
+                    /* More chunks coming - store partial state */
+                    /* Save the partial group for next call */
+                    for (i = 0; i < group_len; i++) {
+                        dec->partial_chars[i] = group[i];
+                    }
+                    dec->partial_count = group_len;
+                }
+                break;
+            } else {
+                /* More data available but we stopped at chunk boundary */
+                break;
+            }
+        }
+        
+        /* Decode the 4-character group */
+        bytes_decoded = decode_group_full(group, out);
+        if (bytes_decoded == DECODE_ERROR) {
+            return -1;
+        }
+        
+        /* Check if this is a trailing group (all padding) */
+        int is_trailing = 1;
+        for (i = 0; i < 4; i++) {
+            if (group[i] != '=' && is_base64_char(group[i])) {
+                is_trailing = 0;
+                break;
+            }
+        }
+        
+        /* If we've seen non-trailing data before and now we're in trailing,
+         * that's an error */
+        if (dec->seen_non_trailing && is_trailing && bytes_decoded < 3) {
+            return -1;
+        }
+        
+        if (!is_trailing) {
+            dec->seen_non_trailing = 1;
+        }
+        
+        /* Write output */
+        for (i = 0; i < bytes_decoded; i++) {
+            if (output_limit_reached(q, out_start, dec->dst_len)) {
+                break;
+            }
+            *q++ = out[i];
+            dec->bytes_decoded++;
+            bytes_this_call++;
+        }
+        
+        /* Check for output limit */
+        if (output_limit_reached(q, out_start, dec->dst_len)) {
+            /* Stop here */
+            break;
+        }
+    }
+    
+    if (in_place) {
+        /* For in-place, return total bytes decoded */
+        bytes_this_call = dec->bytes_decoded;
+    }
+    
+    return bytes_this_call;
+}

diff --git a/hw/hal/include/hal/hal_flash.h b/hw/hal/include/hal/hal_flash.h
index 429837e..8cd2ae3 100644
--- a/hw/hal/include/hal/hal_flash.h
+++ b/hw/hal/include/hal/hal_flash.h
@@ -64,6 +64,23 @@ uint8_t hal_flash_align(uint8_t flash_id);
 uint8_t hal_flash_erased_val(uint8_t flash_id);
 int hal_flash_init(void);
 
+/**
+ * @brief Enables or disables write protection for a flash device.
+ *
+ * When write protection is enabled, hal_flash_write(), hal_flash_erase(), and
+ * hal_flash_erase_sector() for that flash ID will return SYS_EACCES and will
+ * not modify the flash contents.
+ *
+ * @param id                    The ID of the flash device to protect.
+ * @param protect               Non-zero to enable write protection; zero to
+ *                              disable protection.
+ *
+ * @return                      0 on success;
+ *                              SYS_EINVAL if id does not identify a valid
+ *                              flash device in the HAL.
+ */
+int hal_flash_write_protect(uint8_t id, uint8_t protect);
+
 #ifdef __cplusplus
 }
 #endif

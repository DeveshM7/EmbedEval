+int
+hal_flash_write_protect(uint8_t id, uint8_t protect)
+{
+    const struct hal_flash *hf;
+
+    hf = hal_bsp_flash_dev(id);
+    if (!hf) {
+        return SYS_EINVAL;
+    }
+
+    if (id < HAL_FLASH_MAX_DEVICES) {
+        hal_flash_write_protected[id] = protect ? 1 : 0;
+    }
+    return 0;
+}

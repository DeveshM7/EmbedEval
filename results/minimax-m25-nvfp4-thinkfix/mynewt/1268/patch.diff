diff --git a/util/debounce/src/debounce.c b/util/debounce/src/debounce.c
new file mode 100644
index 0000000..5891c04
--- /dev/null
+++ b/util/debounce/src/debounce.c
@@ -0,0 +1,102 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ * 
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include <defs/error.h>
+#include "debounce/debounce.h"
+
+int
+debouncer_init(struct debouncer *debouncer, uint16_t thresh_low,
+    uint16_t thresh_high, uint16_t max)
+{
+    if (thresh_low > thresh_high || thresh_high > max) {
+        return SYS_EINVAL;
+    }
+
+    debouncer->thresh_low = thresh_low;
+    debouncer->thresh_high = thresh_high;
+    debouncer->max = max;
+    debouncer->val = 0;
+    debouncer->state = DEBOUNCER_STATE_LOW;
+
+    return 0;
+}
+
+int
+debouncer_adjust(struct debouncer *debouncer, int32_t delta)
+{
+    int32_t new_val;
+
+    new_val = (int32_t)debouncer->val + delta;
+
+    /* Saturate within bounds */
+    if (new_val < 0) {
+        debouncer->val = 0;
+    } else if (new_val > debouncer->max) {
+        debouncer->val = debouncer->max;
+    } else {
+        debouncer->val = (uint16_t)new_val;
+    }
+
+    /* Update state based on thresholds */
+    if (debouncer->state == DEBOUNCER_STATE_LOW) {
+        if (debouncer->val >= debouncer->thresh_high) {
+            debouncer->state = DEBOUNCER_STATE_HIGH;
+        }
+    } else {
+        if (debouncer->val <= debouncer->thresh_low) {
+            debouncer->state = DEBOUNCER_STATE_LOW;
+        }
+    }
+
+    return 0;
+}
+
+void
+debouncer_set(struct debouncer *debouncer, uint16_t val)
+{
+    /* Clamp value to max */
+    if (val > debouncer->max) {
+        debouncer->val = debouncer->max;
+    } else {
+        debouncer->val = val;
+    }
+
+    /* Update state based on thresholds */
+    if (debouncer->state == DEBOUNCER_STATE_LOW) {
+        if (debouncer->val >= debouncer->thresh_high) {
+            debouncer->state = DEBOUNCER_STATE_HIGH;
+        }
+    } else {
+        if (debouncer->val <= debouncer->thresh_low) {
+            debouncer->state = DEBOUNCER_STATE_LOW;
+        }
+    }
+}
+
+int
+debouncer_state(const struct debouncer *debouncer)
+{
+    return debouncer->state;
+}
+
+uint16_t
+debouncer_val(const struct debouncer *debouncer)
+{
+    return debouncer->val;
+}

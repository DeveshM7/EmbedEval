+#ifndef _DEBOUNCE_H_
+#define _DEBOUNCE_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Debouncer states
+ */
+#define DEBOUNCER_STATE_LOW  0
+#define DEBOUNCER_STATE_HIGH 1
+
+/**
+ * Debouncer structure
+ */
+struct debouncer {
+    uint16_t thresh_low;
+    uint16_t thresh_high;
+    uint16_t max;
+    uint16_t val;
+    uint8_t state;
+};
+
+/**
+ * Initialize a debouncer.
+ *
+ * @param debouncer     The debouncer to initialize
+ * @param thresh_low    The low threshold
+ * @param thresh_high   The high threshold
+ * @param max           The maximum counter value
+ *
+ * @return 0 on success, SYS_EINVAL if thresh_low > thresh_high or
+ *         thresh_high > max
+ */
+int debouncer_init(struct debouncer *debouncer, uint16_t thresh_low,
+    uint16_t thresh_high, uint16_t max);
+
+/**
+ * Adjust the debouncer counter by the specified delta.
+ *
+ * @param debouncer     The debouncer to adjust
+ * @param delta         The delta to add to the counter
+ *
+ * @return 0 on success
+ */
+int debouncer_adjust(struct debouncer *debouncer, int32_t delta);
+
+/**
+ * Set the debouncer counter to the specified value and update state.
+ *
+ * @param debouncer     The debouncer to set
+ * @param val           The value to set
+ */
+void debouncer_set(struct debouncer *debouncer, uint16_t val);
+
+/**
+ * Get the debouncer state.
+ *
+ * @param debouncer     The debouncer to query
+ *
+ * @return 1 for high state, 0 for low state
+ */
+int debouncer_state(const struct debouncer *debouncer);
+
+/**
+ * Get the debouncer counter value.
+ *
+ * @param debouncer     The debouncer to query
+ *
+ * @return The current counter value
+ */
+uint16_t debouncer_val(const struct debouncer *debouncer);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _DEBOUNCE_H_ */

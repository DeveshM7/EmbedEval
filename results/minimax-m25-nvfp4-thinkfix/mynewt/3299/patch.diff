+static struct os_mbuf_pool *
+os_msys_find_next_pool_with_free(struct os_mbuf_pool *start_pool)
+{
+    struct os_mbuf_pool *pool;
+
+    pool = STAILQ_NEXT(start_pool, omp_next);
+    while (pool) {

+
+int
+ble_hs_adv_find_field(uint8_t type, const uint8_t *src, uint8_t src_len,
+                      uint8_t **out_data)
+{
+    uint8_t field_len;
+    uint8_t field_type;
+    const uint8_t *data;
+
+    while (src_len > 0) {
+        field_len = src[0];
+
+        if (src_len < 1) {
+            return BLE_HS_EMSGSIZE;
+        }
+
+        if (field_len == 0) {
+            return BLE_HS_EBADDATA;
+        }
+
+        if (src_len < field_len + 1) {
+            return BLE_HS_EMSGSIZE;
+        }
+
+        field_type = src[1];
+        data = src + 2;
+
+        if (field_type == type) {
+            *out_data = (uint8_t *)data;
+            return 0;
+        }
+
+        src += field_len + 1;
+        src_len -= field_len + 1;
+    }
+
+    return BLE_HS_ENOENT;
+}

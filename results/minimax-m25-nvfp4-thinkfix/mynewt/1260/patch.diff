diff --git a/hw/sensor/src/sensor.c b/hw/sensor/src/sensor.c
index 310acae..746fddd 100644
--- a/hw/sensor/src/sensor.c
+++ b/hw/sensor/src/sensor.c
@@ -1076,6 +1076,27 @@ err:
     return (rc);
 }
 
+
+int
+sensor_register_err_func(struct sensor *sensor,
+        void (*err_fn)(struct sensor *sensor, void *arg, int status), void *arg)
+{
+    int rc;
+
+    rc = sensor_lock(sensor);
+    if (rc != 0) {
+        goto err;
+    }
+
+    sensor->s_err_fn = err_fn;
+    sensor->s_err_fn_arg = arg;
+
+    sensor_unlock(sensor);
+
+    return (0);
+err:
+    return (rc);
+}

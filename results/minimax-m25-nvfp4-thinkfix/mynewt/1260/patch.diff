+/**
+ * Register a simple sensor error callback. This allows a calling application
+ * to receive callbacks when a read fails. The callback is only invoked on
+ * failed reads, not on successful reads.
+ *
+ * @param sensor The sensor to register an error callback on.
+ * @param err_fn The error callback function (sensor, arg, status).
+ * @param arg The argument to pass to the error callback.
+ *
+ * @return 0 on success, non-zero error code on failure.
+ */
+int sensor_register_err_func(struct sensor *sensor,
+        void (*err_fn)(struct sensor *sensor, void *arg, int status), void *arg);
+
 /**

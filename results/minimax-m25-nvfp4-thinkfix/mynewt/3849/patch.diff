diff --git a/sys/log/full/src/log_fcb.c b/sys/log/full/src/log_fcb.c
index cf4850d..05e78d0 100644
--- a/sys/log/full/src/log_fcb.c
+++ b/sys/log/full/src/log_fcb.c
@@ -721,6 +721,14 @@ log_fcb_read(struct log *log, const void *dptr, void *buf, uint16_t offset,
 
     loc = (struct fcb_entry *)dptr;
 
+    /* If offset is at or beyond data length, return 0. */
+    if (offset >= loc->fe_data_len) {
+        return 0;
+    }
+
+    /* Only read the maximum number of bytes, if we exceed that,
+     * truncate the read.
+     */
     if (offset + len > loc->fe_data_len) {
         len = loc->fe_data_len - offset;
     }

diff --git a/libc/baselibc/src/tinyprintf.c b/libc/baselibc/src/tinyprintf.c
index 5a15015..cb0ba39 100644
--- a/libc/baselibc/src/tinyprintf.c
+++ b/libc/baselibc/src/tinyprintf.c
@@ -204,6 +204,22 @@ intarg(int lng, int sign, va_list *va)
     unsigned long long val;
 
     switch (lng) {
+    case 3:  /* h - truncate to 16 bits */
+        if (sign) {
+            val = (short)va_arg(*va, int);
+        } else {
+            val = (unsigned short)va_arg(*va, int);
+        }
+        break;
+
+    case 4:  /* hh - truncate to 8 bits */
+        if (sign) {
+            val = (signed char)va_arg(*va, int);
+        } else {
+            val = (unsigned char)va_arg(*va, int);
+        }
+        break;
+
     case 0:
         if (sign) {
             val = va_arg(*va, int);
@@ -305,6 +321,16 @@ size_t tfp_format(FILE *putp, const char *fmt, va_list va)
                 }
             }
 
+            if (ch == 'h') {
+                ch = *(fmt++);
+                lng = 3;
+
+                if (ch == 'h') {
+                    ch = *(fmt++);
+                    lng = 4;
+                }
+            }
+
             if (ch == 'z') {
                 ch = *(fmt++);
             }

+/**
+ * Returns true if GAP procedures are preempted due to an IRK addition
+ * to the resolving list.
+ */
+int
+ble_gap_get_preempted(void)
+{
+    return ble_gap_preempted != 0;
+}
+
+/**
+ * Preempts all GAP procedures.  This should be called before adding
+ * an IRK to the resolving list.  All active GAP procedures are stopped
+ * and new ones are blocked until ble_gap_preempt_relax() is called.
+ */
+void
+ble_gap_preempt(void)
+{
+    struct ble_gap_event event;
+    ble_gap_event_fn *cb;
+    void *cb_arg;
+
+    ble_hs_lock();
+
+    ble_gap_preempted = 1;
+
+    /* Stop active advertising if any and report completion. */
+    if (ble_gap_slave.op == BLE_GAP_OP_S_ADV) {
+        ble_gap_adv_enable_tx(0, false);
+
+        /* Extract callback before resetting state. */
+        ble_gap_slave_extract_cb(&cb, &cb_arg);
+        ble_gap_slave_reset_state();
+
+        if (cb != NULL) {
+            memset(&event, 0, sizeof event);
+            event.type = BLE_GAP_EVENT_ADV_COMPLETE;
+            event.adv_complete.reason = BLE_HS_EPREEMPTED;
+            cb(&event, cb_arg);
+        }
+    }
+
+    /* Stop active discovery if any and report completion. */
+    if (ble_gap_master.op == BLE_GAP_OP_M_DISC) {
+        struct ble_gap_master_state state;
+#if NIMBLE_BLE_SCAN
+        if (!ble_gap_is_extended_disc()) {
+            ble_gap_disc_enable_tx(0, 0);
+        } else {
+#if MYNEWT_VAL(BLE_EXT_ADV)
+            ble_gap_ext_disc_enable_tx(0, 0, 0, 0);
+#endif
+        }
+#endif
+        /* Extract state before resetting. */
+        ble_gap_master_extract_state(&state, 1);
+
+        /* Report discovery complete with preempted reason. */
+        if (state.cb != NULL) {
+            memset(&event, 0, sizeof event);
+            event.type = BLE_GAP_EVENT_DISC_COMPLETE;
+            event.disc_complete.reason = BLE_HS_EPREEMPTED;
+            ble_gap_call_event_cb(&event, state.cb, state.cb_arg);
+        }
+    }
+
+    /* Stop active connection if any - report after cancel completes. */
+    if (ble_gap_master.op == BLE_GAP_OP_M_CONN) {
+        ble_gap_master.conn.cancel = 1;
+        ble_gap_master.conn.preempted = 1;
+        ble_gap_conn_cancel_tx();
+    }
+
+    ble_hs_unlock();
+}
+
+/**
+ * Relaxes preemption, allowing GAP procedures to resume.  This should be
+ * called after adding an IRK to the resolving list.
+ */
+void
+ble_gap_preempt_relax(void)
+{
+    ble_hs_lock();
+    ble_gap_preempted = 0;
+    ble_hs_unlock();
+}

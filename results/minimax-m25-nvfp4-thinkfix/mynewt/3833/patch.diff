+static void
+set_absent_array_counts(const struct cbor_attr_t *attrs)
+{
+    const struct cbor_attr_t *cursor;
+
+    for (cursor = attrs; cursor->attribute != NULL; cursor++) {
+        if (cursor->type == CborAttrArrayType && cursor->addr.array.count) {
+            /* Only set count to 0 if the array was not matched.
+             * We use -1 as a marker that the array was matched (success or error).
+             * If count is still -1, it means the array was not matched. */
+            if (!cursor->nodefault && *cursor->addr.array.count == -1) {
+                *cursor->addr.array.count = 0;
+            }
+        }
+    }
+}

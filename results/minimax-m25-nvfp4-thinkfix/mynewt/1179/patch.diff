diff --git a/sys/log/full/include/log/log.h b/sys/log/full/include/log/log.h
index 6e118aa..64756f8 100644
--- a/sys/log/full/include/log/log.h
+++ b/sys/log/full/include/log/log.h
@@ -249,6 +249,32 @@ uint8_t log_module_register(uint8_t id, const char *name);
  */
 const char *log_module_get_name(uint8_t id);
 
+/*
+ * Get minimum log level for a module
+ *
+ * This function retrieves the configured minimum log level for a module.
+ * When LOG_LEVEL_PER_MODULE is disabled, returns 0 (LOG_LEVEL_DEBUG).
+ *
+ * @param module  Module id (0-255)
+ *
+ * @return  minimum log level for the module (0 when unconfigured)
+ */
+uint8_t log_level_get(uint8_t module);
+
+/*
+ * Set minimum log level for a module
+ *
+ * This function sets the minimum log level for a module. Log messages
+ * with a level lower than this minimum will be discarded.
+ * When LOG_LEVEL_PER_MODULE is disabled, returns SYS_ENOTSUP.
+ *
+ * @param module  Module id (0-255)
+ * @param level   Minimum log level (0-15)
+ *
+ * @return  0 on success, SYS_EINVAL if level > 15, SYS_ENOTSUP if feature disabled
+ */
+int log_level_set(uint8_t module, uint8_t level);
+
 /* Log functions, manipulate a single log */
 int log_register(char *name, struct log *log, const struct log_handler *,
                  void *arg, uint8_t level);
diff --git a/sys/log/full/src/log.c b/sys/log/full/src/log.c
index b6f1aa1..d0a59b2 100644
--- a/sys/log/full/src/log.c
+++ b/sys/log/full/src/log.c
@@ -37,7 +37,17 @@ static const char *g_log_module_list[ MYNEWT_VAL(LOG_MAX_USER_MODULES) ];
 static uint8_t log_inited;
 static uint8_t log_written;
 
+
+/*
+ * Per-module log level map.
+ * Each entry stores the minimum log level for a module (0-255).
+ * Initialize to 0 (LOG_LEVEL_DEBUG) meaning all levels are accepted.
+ */
+#if MYNEWT_VAL(LOG_LEVEL_PER_MODULE)
+static uint8_t g_log_module_levels[256];
+#endif
 #if MYNEWT_VAL(LOG_CLI)
+
 int shell_log_dump_all_cmd(int, char **);
 struct shell_cmd g_shell_log_cmd = {
     .sc_cmd = "log",
@@ -166,6 +176,52 @@ log_module_get_name(uint8_t module)
     return NULL;
 }
 
+/**
+ * Retrieve the minimum log level for a module.
+ *
+ * When LOG_LEVEL_PER_MODULE is disabled, returns 0 (LOG_LEVEL_DEBUG).
+ * When unconfigured, returns 0.
+ *
+ * @param module  Module ID (0-255)
+ *
+ * @return        Minimum log level for the module
+ */
+uint8_t
+log_level_get(uint8_t module)
+{
+#if MYNEWT_VAL(LOG_LEVEL_PER_MODULE)
+    return g_log_module_levels[module];
+#else
+    return 0;
+#endif
+}
+
+/**
+ * Set the minimum log level for a module.
+ *
+ * When LOG_LEVEL_PER_MODULE is disabled, returns SYS_ENOTSUP.
+ * Accepts levels 0-15. Rejects values > 15 with SYS_EINVAL.
+ *
+ * @param module  Module ID (0-255)
+ * @param level   Minimum log level (0-15)
+ *
+ * @return        0 on success, SYS_EINVAL if level > 15,
+ *                SYS_ENOTSUP if feature disabled
+ */
+int
+log_level_set(uint8_t module, uint8_t level)
+{
+#if MYNEWT_VAL(LOG_LEVEL_PER_MODULE)
+    if (level > 15) {
+        return SYS_EINVAL;
+    }
+    g_log_module_levels[module] = level;
+    return 0;
+#else
+    return SYS_ENOTSUP;
+#endif
+}
+
 /**
  * Indicates whether the specified log has been regiestered.
  */
@@ -312,6 +368,17 @@ log_append_prepare(struct log *log, uint8_t module, uint8_t level, uint8_t etype
         goto err;
     }
 
+    /*
+     * If the per-module minimum log level is configured and the log message
+     * is below the module's configured minimum, then drop it.
+     */
+#if MYNEWT_VAL(LOG_LEVEL_PER_MODULE)
+    if (level < g_log_module_levels[module]) {
+        rc = -1;
+        goto err;
+    }
+#endif
+
     OS_ENTER_CRITICAL(sr);
     idx = g_log_info.li_next_index++;
     OS_EXIT_CRITICAL(sr);

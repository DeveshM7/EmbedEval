+#ifndef __BASE62_H__
+#define __BASE62_H__
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define BASE62_DECODE_OK 0
+#define BASE62_DECODE_ERROR -1
+#define BASE62_INVALID_ARG -2
+#define BASE62_INSUFFICIENT_MEM -3
+
+/**
+ * Encode data to base62 string
+ *
+ * @param data Pointer to data to encode
+ * @param input_size Number of bytes to encode
+ * @param encoded_text Output buffer for encoded string
+ * @param output_size On entry: maximum size of output buffer.
+ *                    On exit: number of characters written (or would be written)
+ *
+ * @return BASE62_DECODE_OK on success
+ *         BASE62_INVALID_ARG if data is NULL, encoded_text is NULL,
+ *                            output_size is NULL, or *output_size < input_size
+ *         BASE62_INSUFFICIENT_MEM if encoded output doesn't fit
+ */
+int base62_encode(const void *data, unsigned int input_size,
+    char *encoded_text, unsigned int *output_size);
+
+/**
+ * Decode base62 string to bytes
+ *
+ * @param encoded_text Base62 encoded string
+ * @param text_length Number of characters to decode
+ * @param output_data Output buffer for decoded data
+ * @param output_size On entry: maximum size of output buffer.
+ *                    On exit: number of bytes written
+ *
+ * @return BASE62_DECODE_OK on success
+ *         BASE62_DECODE_ERROR if input contains invalid characters
+ *         BASE62_INVALID_ARG if encoded_text is NULL, output_data is NULL,
+ *                            or output_size is NULL
+ */
+int base62_decode(const char *encoded_text, unsigned int text_length,
+    void *output_data, unsigned int *output_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __BASE62_H__ */

diff --git a/net/ip/native_sockets/src/native_sock.c b/net/ip/native_sockets/src/native_sock.c
index 17c391d..73e6d13 100644
--- a/net/ip/native_sockets/src/native_sock.c
+++ b/net/ip/native_sockets/src/native_sock.c
@@ -59,6 +59,7 @@ static struct native_sock {
     struct mn_socket ns_sock;
     int ns_fd;
     unsigned int ns_poll:1;
+    unsigned int ns_connecting:1;
     unsigned int ns_listen:1;
     uint8_t ns_type;
     uint8_t ns_pf;
@@ -213,7 +214,7 @@ native_sock_mn_addr_to_addr(struct mn_sockaddr *ms, struct sockaddr *sa,
         sun->sun_len = sizeof(*sun);
 #endif
         sun->sun_path[0] = '\0';
-        strncat(sun->sun_path, msun->msun_path, sizeof sun->sun_path);
+        strncat(sun->sun_path, msun->msun_path, sizeof(sun->sun_path) - 1);
         if (strcmp(sun->sun_path, msun->msun_path) != 0) {
             /* Path too long. */
             return MN_EINVAL;
@@ -368,6 +369,17 @@ native_sock_connect(struct mn_socket *s, struct mn_sockaddr *addr)
     os_mutex_pend(&nss->mtx, OS_WAIT_FOREVER);
     if (connect(ns->ns_fd, sa, sa_len)) {
         rc = errno;
+        /* For non-blocking sockets, EINPROGRESS means the connection
+         * is pending. Set up polling and return success; completion
+         * will be reported through writable callback.
+         */
+        if (rc == EINPROGRESS) {
+            ns->ns_connecting = 1;
+            ns->ns_poll = 1;
+            native_sock_poll_rebuild(nss);
+            os_mutex_release(&nss->mtx);
+            return 0;
+        }
         os_mutex_release(&nss->mtx);
         return native_sock_err_to_mn_err(rc);
     }
@@ -796,7 +808,19 @@ socket_task(void *arg)
             }
 
             if (revents & POLLOUT) {
-                if (ns->ns_type == SOCK_STREAM && ns->ns_tx) {
+                if (ns->ns_connecting) {
+                    /* Connection pending; check if it completed. */
+                    socklen_t optlen = sizeof(rc);
+                    int so_err = 0;
+                    getsockopt(ns->ns_fd, SOL_SOCKET, SO_ERROR, &so_err, &optlen);
+                    ns->ns_connecting = 0;
+                    if (so_err == 0) {
+                        mn_socket_writable(&ns->ns_sock, 0);
+                    } else {
+                        mn_socket_writable(&ns->ns_sock,
+                          native_sock_err_to_mn_err(so_err));
+                    }
+                } else if (ns->ns_type == SOCK_STREAM && ns->ns_tx) {
                     native_sock_stream_tx(ns, 1);
                 }
             }

index 156bb15..e53438c 100644
--- a/fs/fcb2/src/fcb_append.c
+++ b/fs/fcb2/src/fcb_append.c
@@ -112,10 +112,21 @@ int
 fcb2_entry_location_in_range(const struct fcb2_entry *loc)
 {
     const struct flash_sector_range *range = loc->fe_range;
+    uint32_t sector_size;
+    int entry_offset;
 
-    return range->fsr_sector_size *
-        (1 + loc->fe_sector - range->fsr_first_sector) -
+    sector_size = range->fsr_sector_size *
+        (1 + loc->fe_sector - range->fsr_first_sector);
+
+    /* Check if entry would be beyond the sector */
+    entry_offset = sector_size -
         (loc->fe_entry_num * fcb2_len_in_flash(loc->fe_range, FCB2_ENTRY_SIZE));
+
+    if (entry_offset < 0) {
+        return -1;
+    }
+
+    return entry_offset;
 }
 

+
+/**
+ * Checks if a region of flash has been erased and reads the contents
+ * into dst.
+ *
+ * @param fa                    An opened flash area.
+ * @param off                   Offset from start of flash area.
+ * @param dst                   Buffer to store read contents (can be NULL
+ *                              if contents are not needed).
+ * @param len                   Number of bytes to check and read.
+ * @return                      1 if the region is empty/erased;
+ *                              0 if non-empty (dst contains read bytes);
+ *                              negative value on error.
+ */
+int
+flash_area_read_is_empty(const struct flash_area *fa, uint32_t off,
+    void *dst, uint32_t len)
+{
+    if (off > fa->fa_size || off + len > fa->fa_size) {
+        return -1;
+    }
+    return hal_flash_isempty(fa->fa_device_id, fa->fa_off + off, dst, len);
 }
 

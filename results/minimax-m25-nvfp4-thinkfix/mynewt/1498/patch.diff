+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <string.h>
+
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+#include "crc/crc16.h"
+
+/**
+ * Validate entry by checking CRC
+ */
+int
+fcb_elem_info(struct fcb_entry *loc)
+{
+    struct fcb *fcb;
+    struct flash_sector_range *fsr;
+    uint16_t stored_crc;
+    uint16_t calc_crc;
+    uint8_t crc_buf[FCB_CRC_LEN];
+    uint8_t *data;
+    uint32_t data_off;
+    uint16_t len;
+    int rc;
+
+    fcb = loc->fe_fcb;
+    fsr = loc->fe_range;
+
+    if (!fsr) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* Calculate data length in flash */
+    len = fcb_len_in_flash(fcb, loc->fe_data_len);
+
+    /* Allocate buffer for data */
+    data = malloc(len);
+    if (!data) {
+        return FCB_ERR_NOMEM;
+    }
+
+    /* Read data */
+    data_off = loc->fe_data_off;
+    rc = flash_area_read(&fsr->fsr_flash_area, data_off, data, len);
+    if (rc) {
+        free(data);
+        return FCB_ERR_FLASH;
+    }
+
+    /* Calculate CRC */
+    calc_crc = crc16_ccitt(CRC16_INITIAL_CRC, data, len);
+
+    /* Read stored CRC */
+    data_off = loc->fe_data_off + len;
+    rc = flash_area_read(&fsr->fsr_flash_area, data_off, crc_buf, sizeof(crc_buf));
+    if (rc) {
+        free(data);
+        return FCB_ERR_FLASH;
+    }
+
+    stored_crc = crc_buf[0] | (crc_buf[1] << 8);
+
+    free(data);
+
+    if (stored_crc != calc_crc) {
+        return FCB_ERR_CRC;
+    }
+
+    return 0;
+}
+
+/**
+ * Calculate element CRC
+ */
+int
+fcb_elem_crc(struct fcb *fcb, struct fcb_entry *loc, uint16_t *crcp)
+{
+    struct flash_sector_range *fsr;
+    uint16_t len;
+    uint8_t *data;
+    uint32_t data_off;
+    int rc;
+
+    fsr = loc->fe_range;
+    if (!fsr) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* Calculate data length in flash */
+    len = fcb_len_in_flash(fcb, loc->fe_data_len);
+
+    /* Allocate buffer for data */
+    data = malloc(len);
+    if (!data) {
+        return FCB_ERR_NOMEM;
+    }
+
+    /* Read data */
+    data_off = loc->fe_data_off;
+    rc = flash_area_read(&fsr->fsr_flash_area, data_off, data, len);
+    if (rc) {
+        free(data);
+        return FCB_ERR_FLASH;
+    }
+
+    /* Calculate CRC */
+    *crcp = crc16_ccitt(CRC16_INITIAL_CRC, data, len);
+
+    free(data);
+    return 0;
+}
diff --git a/fs/fcb2/src/fcb_offset.c b/fs/fcb2/src/fcb_offset.c

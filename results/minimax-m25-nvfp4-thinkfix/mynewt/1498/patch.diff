diff --git a/fs/fcb2/include/fcb2/fcb2.h b/fs/fcb2/include/fcb2/fcb2.h
new file mode 100644
index 0000000..1b6ce7f
--- /dev/null
+++ b/fs/fcb2/include/fcb2/fcb2.h
@@ -0,0 +1,155 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#ifndef __SYS_FCB2_H_
+#define __SYS_FCB2_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * \defgroup FCB2 Flash circular buffer version 2.
+ * @{
+ */
+
+#include <inttypes.h>
+#include <limits.h>
+
+#include "os/mynewt.h"
+#include "flash_map/flash_map.h"
+
+/*
+ * Constants
+ */
+#define FCB_SECTOR_OLDEST    UINT16_MAX
+#define FCB_MAX_LEN          (CHAR_MAX | CHAR_MAX << 7)
+#define FCB_ENTRY_SIZE       6
+#define FCB_CRC_LEN          2
+
+/*
+ * Error codes
+ */
+#define FCB_OK           0
+#define FCB_ERR_ARGS    -1
+#define FCB_ERR_FLASH  -2
+#define FCB_ERR_NOVAR  -3
+#define FCB_ERR_NOSPACE -4
+#define FCB_ERR_NOMEM  -5
+#define FCB_ERR_CRC    -6
+#define FCB_ERR_MAGIC  -7
+#define FCB_ERR_VERSION -8
+
+/*
+ * Structures
+ */
+
+struct fcb;
+
+struct fcb_entry {
+    struct fcb *fe_fcb;
+    struct flash_sector_range *fe_range;
+    uint16_t fe_sector;
+    uint16_t fe_data_len;
+    uint32_t fe_data_off;
+    uint16_t fe_entry_num;
+};
+
+struct fcb {
+    /* Caller of fcb_init fills this in */
+    uint32_t f_magic;
+    uint8_t f_version;
+    uint8_t f_scratch_cnt;
+    uint16_t f_range_cnt;
+    uint16_t f_sector_cnt;
+    struct flash_sector_range *f_ranges;
+
+    /* Flash circular buffer internal state */
+    struct fcb_entry f_active;
+    uint16_t f_active_id;
+};
+
+/**
+ * fcb_append() appends an entry to circular buffer. When writing the
+ * contents for the entry, use loc->fe_data_off with fcb_write().
+ * When you're finished, call fcb_append_finish() with loc as argument.
+ */
+int fcb_append(struct fcb *fcb, uint16_t len, struct fcb_entry *loc);
+int fcb_append_finish(struct fcb_entry *loc);
+
+/**
+ * Write data to an entry
+ */
+int fcb_write(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len);
+
+/**
+ * Read data from an entry
+ */
+int fcb_read(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len);
+
+/**
+ * Walk over all log entries in FCB, or entries in a given sector.
+ * If sector is FCB_SECTOR_OLDEST, walk starting from the oldest sector.
+ * If sector is 0, walk all entries.
+ * cb gets called for every entry. If cb wants to stop the walk, it should
+ * return non-zero value.
+ */
+typedef int (*fcb_walk_cb)(struct fcb_entry *loc, void *arg);
+int fcb_walk(struct fcb *fcb, int sector, fcb_walk_cb cb, void *cb_arg);
+
+/**
+ * Initialize FCB
+ */
+int fcb_init(struct fcb *fcb);
+
+/**
+ * Erase oldest sector and make it current
+ */
+int fcb_rotate(struct fcb *fcb);
+
+/**
+ * Take a scratch block into use
+ */
+int fcb_append_to_scratch(struct fcb *fcb);
+
+/**
+ * Get area info
+ */
+int fcb_area_info(struct fcb *fcb, int sector, int *elemsp, int *bytesp);
+
+/**
+ * Element at offset entries from last position (backwards).
+ */
+int fcb_offset_last_n(struct fcb *fcb, uint8_t entries,
+    struct fcb_entry *last_n_entry);
+
+/**
+ * Validate entry by checking CRC
+ */
+int fcb_elem_info(struct fcb_entry *loc);
+
+#ifdef __cplusplus
+}
+
+/**
+ * @} FCB2
+ */
+
+#endif
+
+#endif /* __SYS_FCB2_H_ */

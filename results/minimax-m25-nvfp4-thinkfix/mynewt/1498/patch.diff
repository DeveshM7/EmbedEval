diff --git a/fs/fcb2/src/fcb.c b/fs/fcb2/src/fcb.c
new file mode 100644
index 0000000..96ebb45
--- /dev/null
+++ b/fs/fcb2/src/fcb.c
@@ -0,0 +1,197 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+
+/**
+ * Initialize FCB
+ */
+int
+fcb_init(struct fcb *fcb)
+{
+    struct flash_sector_range *fsr;
+    struct fcb_disk_area fda;
+    int rc;
+    int i;
+    int oldest = -1, newest = -1;
+    struct flash_sector_range *oldest_fsr = NULL, *newest_fsr = NULL;
+
+    if (!fcb->f_ranges || fcb->f_sector_cnt - fcb->f_scratch_cnt < 1) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* Find last used and first used sectors */
+    for (i = 0; i < fcb->f_range_cnt; i++) {
+        fsr = &fcb->f_ranges[i];
+
+        rc = fcb_sector_hdr_read(fcb, fsr, &fda);
+        if (rc < 0) {
+            return rc;
+        }
+        if (rc == 0) {
+            continue;
+        }
+        if (oldest < 0) {
+            oldest = newest = fda.fd_id;
+            oldest_fsr = newest_fsr = fsr;
+            continue;
+        }
+        if (FCB_ID_GT(fda.fd_id, newest)) {
+            newest = fda.fd_id;
+            newest_fsr = fsr;
+        } else if (FCB_ID_GT(oldest, fda.fd_id)) {
+            oldest = fda.fd_id;
+            oldest_fsr = fsr;
+        }
+    }
+
+    if (oldest < 0) {
+        /*
+         * No initialized areas.
+         */
+        oldest_fsr = newest_fsr = &fcb->f_ranges[0];
+        rc = fcb_sector_hdr_init(fcb, oldest_fsr, 0);
+        if (rc) {
+            return rc;
+        }
+        newest = oldest = 0;
+    }
+
+    fcb->f_active.fe_fcb = fcb;
+    fcb->f_active.fe_range = newest_fsr;
+    fcb->f_active.fe_sector = newest;
+    fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+    fcb->f_active_id = newest;
+
+    /* Reset to newest */
+    fcb->f_active.fe_range = newest_fsr;
+    fcb->f_active.fe_sector = newest;
+    fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+
+    return 0;
+}
+
+/**
+ * Length of an element is encoded in 1 or 2 bytes.
+ * 1 byte for lengths < 128 bytes, and 2 bytes for < 16384.
+ */
+int
+fcb_put_len(uint8_t *buf, uint16_t len)
+{
+    if (len < 0x80) {
+        buf[0] = len;
+        return 1;
+    } else if (len < FCB_MAX_LEN) {
+        buf[0] = (len & 0x7f) | 0x80;
+        buf[1] = len >> 7;
+        return 2;
+    } else {
+        return FCB_ERR_ARGS;
+    }
+}
+
+int
+fcb_get_len(uint8_t *buf, uint16_t *len)
+{
+    int rc;
+
+    if (buf[0] & 0x80) {
+        *len = (buf[0] & 0x7f) | (buf[1] << 7);
+        rc = 2;
+    } else {
+        *len = buf[0];
+        rc = 1;
+    }
+    return rc;
+}
+
+/**
+ * Initialize erased sector for use.
+ */
+int
+fcb_sector_hdr_init(struct fcb *fcb, struct flash_sector_range *fsr,
+    uint16_t id)
+{
+    struct fcb_disk_area fda;
+    int rc;
+
+    fda.fd_magic = fcb->f_magic;
+    fda.fd_ver = fcb->f_version;
+    fda._pad = 0xff;
+    fda.fd_id = id;
+
+    rc = flash_area_write(&fsr->fsr_flash_area, 0, &fda, sizeof(fda));
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
+
+/**
+ * Checks whether FCB sector contains data or not.
+ * Returns <0 in error.
+ * Returns 0 if sector is unused;
+ * Returns 1 if sector has data.
+ */
+int
+fcb_sector_hdr_read(struct fcb *fcb, struct flash_sector_range *fsr,
+    struct fcb_disk_area *fdap)
+{
+    struct fcb_disk_area fda;
+    int rc;
+
+    if (!fdap) {
+        fdap = &fda;
+    }
+    rc = flash_area_read_is_empty(&fsr->fsr_flash_area, 0, fdap, sizeof(*fdap));
+    if (rc < 0) {
+        return FCB_ERR_FLASH;
+    } else if (rc == 1) {
+        return 0;
+    }
+    if (fdap->fd_magic != fcb->f_magic) {
+        return FCB_ERR_MAGIC;
+    }
+    if (fdap->fd_ver != fcb->f_version) {
+        return FCB_ERR_VERSION;
+    }
+    return 1;
+}
+
+/**
+ * Get next sector in the range
+ */
+struct flash_sector_range *
+fcb_getnext_sector(struct fcb *fcb, struct flash_sector_range *fsr)
+{
+    struct flash_sector_range *next;
+    int idx;
+
+    idx = fsr - fcb->f_ranges;
+    idx++;
+    if (idx >= fcb->f_range_cnt) {
+        idx = 0;
+    }
+    next = &fcb->f_ranges[idx];
+    return next;
+}
diff --git a/fs/fcb2/src/fcb_append.c b/fs/fcb2/src/fcb_append.c
new file mode 100644
index 0000000..74966af
--- /dev/null
+++ b/fs/fcb2/src/fcb_append.c
@@ -0,0 +1,198 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <stddef.h>
+#include <string.h>
+
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+
+static struct flash_sector_range *
+fcb_new_sector(struct fcb *fcb, int cnt)
+{
+    struct flash_sector_range *fsr;
+    struct flash_sector_range *rfsr;
+    int i;
+
+    rfsr = NULL;
+    i = 0;
+    fsr = fcb->f_active.fe_range;
+    do {
+        fsr = fcb_getnext_sector(fcb, fsr);
+        if (!rfsr) {
+            rfsr = fsr;
+        }
+        /* Check if we've looped back to oldest */
+        if (fsr == fcb->f_active.fe_range) {
+            return NULL;
+        }
+    } while (i++ < cnt);
+    return rfsr;
+}
+
+/*
+ * Take one of the scratch blocks into use, if at all possible.
+ */
+int
+fcb_append_to_scratch(struct fcb *fcb)
+{
+    struct flash_sector_range *fsr;
+    int rc;
+
+    fsr = fcb_new_sector(fcb, fcb->f_scratch_cnt);
+    if (!fsr) {
+        return FCB_ERR_NOSPACE;
+    }
+    rc = fcb_sector_hdr_init(fcb, fsr, fcb->f_active_id + 1);
+    if (rc) {
+        return rc;
+    }
+    fcb->f_active.fe_range = fsr;
+    fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+    fcb->f_active_id++;
+    return FCB_OK;
+}
+
+int
+fcb_append(struct fcb *fcb, uint16_t len, struct fcb_entry *append_loc)
+{
+    struct fcb_entry *active;
+    struct flash_sector_range *fsr;
+    uint8_t tmp_str[2];
+    int cnt;
+    int rc;
+    uint32_t sector_size;
+    uint32_t max_elem_size;
+
+    cnt = fcb_put_len(tmp_str, len);
+    if (cnt < 0) {
+        return cnt;
+    }
+
+    /* Calculate the maximum element size that fits in a sector */
+    fsr = fcb->f_ranges;
+    sector_size = fsr->fsr_sector_size;
+    max_elem_size = sector_size - sizeof(struct fcb_disk_area) - FCB_CRC_LEN - FCB_ENTRY_SIZE;
+
+    if (len > max_elem_size) {
+        return FCB_ERR_NOSPACE;
+    }
+
+    cnt = fcb_len_in_flash(fcb, cnt);
+    len = fcb_len_in_flash(fcb, len) + fcb_len_in_flash(fcb, FCB_CRC_LEN);
+
+    active = &fcb->f_active;
+    fsr = active->fe_range;
+
+    if (active->fe_data_off + len + cnt > sector_size) {
+        /* Need a new sector */
+        fsr = fcb_new_sector(fcb, fcb->f_scratch_cnt);
+        if (!fsr || (fsr->fsr_sector_size < sizeof(struct fcb_disk_area) + len + cnt)) {
+            rc = FCB_ERR_NOSPACE;
+            goto err;
+        }
+        rc = fcb_sector_hdr_init(fcb, fsr, fcb->f_active_id + 1);
+        if (rc) {
+            goto err;
+        }
+        fcb->f_active.fe_range = fsr;
+        fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+        fcb->f_active_id++;
+    }
+
+    fsr = fcb->f_active.fe_range;
+    rc = flash_area_write(&fsr->fsr_flash_area, fcb->f_active.fe_data_off,
+        tmp_str, cnt);
+    if (rc) {
+        rc = FCB_ERR_FLASH;
+        goto err;
+    }
+
+    append_loc->fe_fcb = fcb;
+    append_loc->fe_range = fsr;
+    append_loc->fe_sector = fcb->f_active_id;
+    append_loc->fe_data_off = fcb->f_active.fe_data_off + cnt;
+    append_loc->fe_data_len = len - FCB_CRC_LEN;  /* Actual data length without CRC */
+
+    fcb->f_active.fe_data_off = append_loc->fe_data_off + (len - FCB_CRC_LEN);
+
+    return FCB_OK;
+err:
+    return rc;
+}
+
+int
+fcb_append_finish(struct fcb_entry *loc)
+{
+    struct fcb *fcb;
+    uint16_t crc;
+    int rc;
+    uint32_t off;
+    uint8_t crc_buf[2];
+
+    fcb = loc->fe_fcb;
+    rc = fcb_elem_crc(fcb, loc, &crc);
+    if (rc) {
+        return rc;
+    }
+
+    crc_buf[0] = crc & 0xff;
+    crc_buf[1] = (crc >> 8) & 0xff;
+
+    off = loc->fe_data_off + fcb_len_in_flash(fcb, loc->fe_data_len);
+
+    rc = flash_area_write(&loc->fe_range->fsr_flash_area, off, crc_buf, sizeof(crc_buf));
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
+
+/**
+ * Write element data to flash
+ */
+int
+fcb_write(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len)
+{
+    int rc;
+    struct flash_sector_range *fsr;
+
+    fsr = loc->fe_range;
+    rc = flash_area_write(&fsr->fsr_flash_area, loc->fe_data_off + off, buf, len);
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
+
+/**
+ * Read element data from flash
+ */
+int
+fcb_read(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len)
+{
+    int rc;
+    struct flash_sector_range *fsr;
+
+    fsr = loc->fe_range;
+    rc = flash_area_read(&fsr->fsr_flash_area, loc->fe_data_off + off, buf, len);
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+    return 0;
+}
diff --git a/fs/fcb2/src/fcb_area_info.c b/fs/fcb2/src/fcb_area_info.c
new file mode 100644
index 0000000..e241901
--- /dev/null
+++ b/fs/fcb2/src/fcb_area_info.c
@@ -0,0 +1,100 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <string.h>
+
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+
+/**
+ * Report the number of elements and bytes stored in a given sector.
+ */
+int
+fcb_area_info(struct fcb *fcb, int sector, int *elemsp, int *bytesp)
+{
+    struct flash_sector_range *fsr;
+    struct fcb_entry loc;
+    int i;
+    int rc;
+    int elem_cnt = 0;
+    int byte_cnt = 0;
+
+    /* Handle FCB_SECTOR_OLDEST - get the oldest sector */
+    if (sector == FCB_SECTOR_OLDEST) {
+        /* Find the oldest sector */
+        sector = 0;
+        for (i = 0; i < fcb->f_range_cnt; i++) {
+            fsr = &fcb->f_ranges[i];
+            if (sector == 0 || fsr->fsr_first_sector < (uint16_t)sector) {
+                sector = fsr->fsr_first_sector;
+            }
+        }
+    }
+
+    /* Validate sector number */
+    if (sector < 0 || sector >= fcb->f_sector_cnt) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* If both output pointers are NULL, just return OK */
+    if (!elemsp && !bytesp) {
+        return 0;
+    }
+
+    /* Find the range for this sector */
+    fsr = NULL;
+    for (i = 0; i < fcb->f_range_cnt; i++) {
+        fsr = &fcb->f_ranges[i];
+        if (fsr->fsr_first_sector == (uint16_t)sector) {
+            break;
+        }
+        fsr = NULL;
+    }
+
+    if (!fsr) {
+        return FCB_ERR_ARGS;
+    }
+
+    /* Walk the sector to count elements and bytes */
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+    loc.fe_range = fsr;
+    loc.fe_sector = sector;
+    loc.fe_data_off = sizeof(struct fcb_disk_area);
+
+    while (1) {
+        rc = fcb_getnext_in_sector(fcb, &loc);
+        if (rc == FCB_ERR_NOVAR) {
+            break;
+        }
+        if (rc != 0) {
+            return rc;
+        }
+        elem_cnt++;
+        byte_cnt += loc.fe_data_len;
+    }
+
+    if (elemsp) {
+        *elemsp = elem_cnt;
+    }
+    if (bytesp) {
+        *bytesp = byte_cnt;
+    }
+
+    return 0;
+}
diff --git a/fs/fcb2/src/fcb_elem_info.c b/fs/fcb2/src/fcb_elem_info.c

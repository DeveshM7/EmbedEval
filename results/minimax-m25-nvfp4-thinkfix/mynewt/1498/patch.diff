+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#ifndef __SYS_FCB2_PRIV_H_
+#define __SYS_FCB2_PRIV_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FCB_ID_GT(a, b) (((int16_t)(a) - (int16_t)(b)) > 0)
+
+struct fcb_disk_area {
+    uint32_t fd_magic;
+    uint8_t  fd_ver;
+    uint8_t  _pad;
+    uint16_t fd_id;
+};
+
+int fcb_put_len(uint8_t *buf, uint16_t len);
+int fcb_get_len(uint8_t *buf, uint16_t *len);
+
+static inline int
+fcb_len_in_flash(struct fcb *fcb, uint16_t len)
+{
+    struct flash_sector_range *fsr;
+    uint8_t align;
+
+    fsr = fcb->f_ranges;
+    align = fsr->fsr_align;
+    if (align <= 1) {
+        return len;
+    }
+    return (len + (align - 1)) & ~(align - 1);
+}
+
+/**
+ * Initialize sector header
+ */
+int fcb_sector_hdr_init(struct fcb *fcb, struct flash_sector_range *fsr,
+    uint16_t id);
+
+/**
+ * Read sector header
+ */
+int fcb_sector_hdr_read(struct fcb *fcb, struct flash_sector_range *fsr,
+    struct fcb_disk_area *fdap);
+
+/**
+ * Get next entry in sector
+ */
+int fcb_getnext_in_sector(struct fcb *fcb, struct fcb_entry *loc);
+
+/**
+ * Get next sector
+ */
+struct flash_sector_range *fcb_getnext_sector(struct fcb *fcb,
+    struct flash_sector_range *fsr);
+
+/**
+ * Calculate element CRC
+ */
+int fcb_elem_crc(struct fcb *fcb, struct fcb_entry *loc, uint16_t *crcp);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/fs/fcb2/src/fcb_rotate.c b/fs/fcb2/src/fcb_rotate.c
new file mode 100644
index 0000000..382064d
--- /dev/null
+++ b/fs/fcb2/src/fcb_rotate.c
@@ -0,0 +1,80 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+
+/**
+ * Erase the oldest used sector and make it current
+ */
+int
+fcb_rotate(struct fcb *fcb)
+{
+    struct flash_sector_range *fsr;
+    struct flash_sector_range *oldest_fsr;
+    struct fcb_disk_area fda;
+    int rc;
+    int i;
+    int oldest = -1;
+    uint16_t oldest_id;
+
+    /* Find the oldest sector */
+    oldest_fsr = NULL;
+    for (i = 0; i < fcb->f_range_cnt; i++) {
+        fsr = &fcb->f_ranges[i];
+        rc = fcb_sector_hdr_read(fcb, fsr, &fda);
+        if (rc < 0) {
+            return rc;
+        }
+        if (rc == 0) {
+            continue;
+        }
+        if (oldest < 0) {
+            oldest = fda.fd_id;
+            oldest_fsr = fsr;
+        } else if (FCB_ID_GT(oldest, fda.fd_id)) {
+            oldest = fda.fd_id;
+            oldest_fsr = fsr;
+        }
+    }
+
+    if (!oldest_fsr) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Erase the oldest sector */
+    rc = flash_area_erase(&oldest_fsr->fsr_flash_area, 0,
+        oldest_fsr->fsr_sector_size);
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+
+    /* Re-initialize the sector with new ID */
+    oldest_id = fcb->f_active_id + 1;
+    rc = fcb_sector_hdr_init(fcb, oldest_fsr, oldest_id);
+    if (rc) {
+        return rc;
+    }
+
+    /* Set as active */
+    fcb->f_active.fe_range = oldest_fsr;
+    fcb->f_active.fe_data_off = sizeof(struct fcb_disk_area);
+    fcb->f_active_id = oldest_id;
+
+    return FCB_OK;
+}
diff --git a/fs/fcb2/src/fcb_walk.c b/fs/fcb2/src/fcb_walk.c
new file mode 100644
index 0000000..7fa133d
--- /dev/null
+++ b/fs/fcb2/src/fcb_walk.c
@@ -0,0 +1,141 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <string.h>
+
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+
+int
+fcb_getnext_in_sector(struct fcb *fcb, struct fcb_entry *loc)
+{
+    struct flash_sector_range *fsr;
+    struct fcb_disk_area fda;
+    uint8_t hdr[FCB_ENTRY_SIZE];
+    uint16_t len;
+    int rc;
+    uint32_t data_off;
+
+    fsr = loc->fe_range;
+    if (!fsr) {
+        fsr = &fcb->f_ranges[0];
+        loc->fe_range = fsr;
+    }
+
+    data_off = loc->fe_data_off;
+
+    /* Read sector header to check if it's valid */
+    rc = flash_area_read(&fsr->fsr_flash_area, 0, &fda, sizeof(fda));
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+
+    if (fda.fd_magic != fcb->f_magic || fda.fd_ver != fcb->f_version) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Check if we're past the end of data in this sector */
+    if (data_off >= fsr->fsr_sector_size) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Read entry header */
+    rc = flash_area_read(&fsr->fsr_flash_area, data_off, hdr, sizeof(hdr));
+    if (rc) {
+        return FCB_ERR_FLASH;
+    }
+
+    /* Check for erased flash (all 0xff) */
+    if (hdr[0] == 0xff && hdr[1] == 0xff) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Get length from header */
+    rc = fcb_get_len(hdr, &len);
+    if (rc < 0) {
+        return rc;
+    }
+
+    loc->fe_data_off = data_off + rc;
+    loc->fe_data_len = len;
+
+    return 0;
+}
+
+int
+fcb_walk(struct fcb *fcb, int sector, fcb_walk_cb cb, void *cb_arg)
+{
+    struct fcb_entry loc;
+    struct flash_sector_range *fsr;
+    int i;
+    int rc;
+
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+
+    for (i = 0; i < fcb->f_range_cnt; i++) {
+        fsr = &fcb->f_ranges[i];
+        loc.fe_range = fsr;
+        loc.fe_sector = fsr->fsr_first_sector;
+        loc.fe_data_off = sizeof(struct fcb_disk_area);
+
+        /* If specific sector requested, only walk that sector */
+        if (sector > 0 && fsr->fsr_first_sector != (uint16_t)sector) {
+            continue;
+        }
+
+        /* Walk entries in this sector */
+        while (1) {
+            rc = fcb_getnext_in_sector(fcb, &loc);
+            if (rc == FCB_ERR_NOVAR) {
+                break;
+            }
+            if (rc != 0) {
+                return rc;
+            }
+
+            /* Validate entry by checking CRC */
+            rc = fcb_elem_info(&loc);
+            if (rc != 0) {
+                /* Entry is corrupt, skip it - advance past this entry */
+                loc.fe_data_off += FCB_ENTRY_SIZE + loc.fe_data_len + FCB_CRC_LEN;
+                /* Align to next entry */
+                loc.fe_data_off = (loc.fe_data_off + fsr->fsr_align - 1) & ~(fsr->fsr_align - 1);
+                continue;
+            }
+
+            /* Call the callback */
+            rc = cb(&loc, cb_arg);
+            if (rc != 0) {
+                return rc;
+            }
+
+            /* Advance to next entry */
+            loc.fe_data_off += FCB_ENTRY_SIZE + loc.fe_data_len + FCB_CRC_LEN;
+            /* Align to next entry */
+            loc.fe_data_off = (loc.fe_data_off + fsr->fsr_align - 1) & ~(fsr->fsr_align - 1);
+        }
+
+        /* If walking specific sector, we're done */
+        if (sector > 0) {
+            break;
+        }
+    }
+
+    return 0;
+}

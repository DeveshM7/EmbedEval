+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <string.h>
+
+#include "fcb2/fcb2.h"
+#include "fcb_priv.h"
+
+/**
+ * Get the entry at offset entries from the last position (backwards).
+ */
+int
+fcb_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry)
+{
+    struct fcb_entry loc;
+    int i;
+    int total_entries;
+    int start_idx;
+
+    /* Initialize the entry */
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+
+    /* First, count total entries */
+    total_entries = 0;
+    while (1) {
+        /* Start from the first range */
+        loc.fe_range = &fcb->f_ranges[0];
+        loc.fe_data_off = sizeof(struct fcb_disk_area);
+
+        i = fcb_getnext_in_sector(fcb, &loc);
+        if (i == FCB_ERR_NOVAR) {
+            break;
+        }
+        if (i != 0) {
+            return i;
+        }
+        total_entries++;
+    }
+
+    if (total_entries == 0) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Calculate starting index */
+    if (entries >= total_entries) {
+        start_idx = 0;
+    } else {
+        start_idx = total_entries - entries;
+    }
+
+    /* Walk again to find the entry at start_idx */
+    memset(&loc, 0, sizeof(loc));
+    loc.fe_fcb = fcb;
+    loc.fe_range = &fcb->f_ranges[0];
+    loc.fe_data_off = sizeof(struct fcb_disk_area);
+
+    i = 0;
+    while (1) {
+        int rc = fcb_getnext_in_sector(fcb, &loc);
+        if (rc == FCB_ERR_NOVAR) {
+            break;
+        }
+        if (rc != 0) {
+            return rc;
+        }
+
+        if (i == start_idx) {
+            *last_n_entry = loc;
+            return 0;
+        }
+        i++;
+    }
+
+    return FCB_ERR_NOVAR;
+}
diff --git a/fs/fcb2/src/fcb_priv.h b/fs/fcb2/src/fcb_priv.h
new file mode 100644
index 0000000..4ac0784
--- /dev/null
+++ b/fs/fcb2/src/fcb_priv.h
@@ -0,0 +1,84 @@
+/*

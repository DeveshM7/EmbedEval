diff --git a/fs/fcb2/src/fcb2_bmark.c b/fs/fcb2/src/fcb2_bmark.c
new file mode 100644
index 0000000..8f9b3eb
--- /dev/null
+++ b/fs/fcb2/src/fcb2_bmark.c
@@ -0,0 +1,98 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "os/mynewt.h"
+
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+#include "string.h"
+
+void
+fcb_log_init_bmarks(struct fcb_log *fcb_log,
+                    struct fcb_log_bmark *buf, int bmark_count)
+{
+    fcb_log->fl_bset = (struct fcb_log_bset) {
+        .fls_bmarks = buf,
+        .fls_cap = bmark_count,
+    };
+}
+
+void
+fcb_log_clear_bmarks(struct fcb_log *fcb_log)
+{
+    fcb_log->fl_bset.fls_size = 0;
+    fcb_log->fl_bset.fls_next = 0;
+}
+
+const struct fcb_log_bmark *
+fcb_log_closest_bmark(const struct fcb_log *fcb_log, uint32_t index)
+{
+    const struct fcb_log_bmark *closest;
+    const struct fcb_log_bmark *bmark;
+    uint32_t min_diff;
+    uint32_t diff;
+    int i;
+
+    min_diff = UINT32_MAX;
+    closest = NULL;
+
+    for (i = 0; i < fcb_log->fl_bset.fls_size; i++) {
+        bmark = &fcb_log->fl_bset.fls_bmarks[i];
+        if (bmark->flb_index <= index) {
+            diff = index - bmark->flb_index;
+            if (diff < min_diff) {
+                min_diff = diff;
+                closest = bmark;
+            }
+        }
+    }
+
+    return closest;
+}
+
+void
+fcb_log_add_bmark(struct fcb_log *fcb_log, const struct fcb_entry *entry,
+                  uint32_t index)
+{
+    struct fcb_log_bset *bset;
+
+    bset = &fcb_log->fl_bset;
+
+    if (bset->fls_cap == 0) {
+        return;
+    }
+
+    bset->fls_bmarks[bset->fls_next] = (struct fcb_log_bmark) {
+        .flb_entry = *entry,
+        .flb_index = index,
+    };
+
+    if (bset->fls_size < bset->fls_cap) {
+        bset->fls_size++;
+    }
+
+    bset->fls_next++;
+    if (bset->fls_next >= bset->fls_cap) {
+        bset->fls_next = 0;
+    }
+}
+
+#endif /* MYNEWT_VAL(LOG_FCB_BOOKMARKS) */
diff --git a/fs/fcb2/src/fcb_getprev.c b/fs/fcb2/src/fcb_getprev.c
new file mode 100644
index 0000000..d236cbe
--- /dev/null
+++ b/fs/fcb2/src/fcb_getprev.c
@@ -0,0 +1,168 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+/**
+ * Get previous sector in the FCB circular buffer.
+ */
+static int
+fcb_getprev_sector(struct fcb *fcb, int sector)
+{
+    if (sector == 0) {
+        sector = fcb->f_sector_cnt;
+    }
+    return sector - 1;
+}
+
+/**
+ * Get previous entry in a sector.
+ * Returns 0 on success, FCB_ERR_NOVAR if no more entries in sector.
+ */
+static int
+fcb_getprev_in_area(struct fcb *fcb, struct fcb_entry *loc)
+{
+    int rc;
+    uint16_t entry_num;
+
+    if (loc->fe_entry_num <= 1) {
+        /* No more entries in this sector */
+        return FCB_ERR_NOVAR;
+    }
+
+    entry_num = loc->fe_entry_num - 1;
+    loc->fe_entry_num = entry_num;
+
+    /* Read the entry to get data offset and length */
+    rc = fcb_elem_info(loc);
+    if (rc != 0) {
+        /* Entry is corrupted, try the one before */
+        loc->fe_entry_num = entry_num - 1;
+        rc = fcb_elem_info(loc);
+    }
+
+    return rc;
+}
+
+int
+fcb_getprev_nolock(struct fcb *fcb, struct fcb_entry *loc)
+{
+    int rc;
+    int sector;
+
+    if (loc->fe_range == NULL) {
+        /*
+         * Get the most recent entry - use f_active
+         */
+        if (fcb->f_active.fe_range == NULL) {
+            return FCB_ERR_NOVAR;
+        }
+        *loc = fcb->f_active;
+        return 0;
+    }
+
+    /* Try to get previous entry in the same sector */
+    rc = fcb_getprev_in_area(fcb, loc);
+    if (rc == 0) {
+        return 0;
+    }
+
+    /* Need to move to the previous sector */
+    sector = fcb_getprev_sector(fcb, loc->fe_sector);
+
+    /* Check if we've circled back to the oldest sector */
+    if (sector == fcb->f_oldest_sec) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Find the last entry in the previous sector */
+    loc->fe_sector = sector;
+    loc->fe_range = fcb_get_sector_range(fcb, sector);
+
+    /* We need to find the last valid entry in this sector.
+     * Start from the beginning and walk until we can't find more. */
+    loc->fe_entry_num = 1;
+    loc->fe_data_off =
+        fcb_len_in_flash(loc->fe_range, sizeof(struct fcb_disk_area));
+    loc->fe_data_len = 0;
+
+    /* Check if the first entry is valid */
+    rc = fcb_elem_info(loc);
+    if (rc != 0 && rc != FCB_ERR_CRC) {
+        /* Sector might be empty, check if we can go to oldest */
+        if (sector == fcb->f_oldest_sec) {
+            return FCB_ERR_NOVAR;
+        }
+        /* Try previous sector */
+        sector = fcb_getprev_sector(fcb, sector);
+        if (sector == fcb->f_oldest_sec) {
+            return FCB_ERR_NOVAR;
+        }
+        loc->fe_sector = sector;
+        loc->fe_range = fcb_get_sector_range(fcb, sector);
+        loc->fe_entry_num = 1;
+        loc->fe_data_off =
+            fcb_len_in_flash(loc->fe_range, sizeof(struct fcb_disk_area));
+        loc->fe_data_len = 0;
+        rc = fcb_elem_info(loc);
+    }
+
+    /* Walk through entries to find the last one */
+    while (rc == 0 || rc == FCB_ERR_CRC) {
+        struct fcb_entry next_loc = *loc;
+        int walk_rc;
+
+        next_loc.fe_entry_num = loc->fe_entry_num + 1;
+        walk_rc = fcb_getprev_in_area(fcb, &next_loc);
+        if (walk_rc == FCB_ERR_NOVAR) {
+            /* No more entries after current one, we're at the last */
+            return 0;
+        }
+        if (walk_rc == 0) {
+            /* Found a valid next entry, update current */
+            *loc = next_loc;
+        }
+        /* If CRC error, continue trying */
+        if (walk_rc != FCB_ERR_CRC && walk_rc != 0) {
+            break;
+        }
+    }
+
+    if (rc != 0 && rc != FCB_ERR_CRC) {
+        return rc;
+    }
+
+    return 0;
+}
+
+int
+fcb_getprev(struct fcb *fcb, struct fcb_entry *loc)
+{
+    int rc;
+
+    rc = os_mutex_pend(&fcb->f_mtx, OS_WAIT_FOREVER);
+    if (rc && rc != OS_NOT_STARTED) {
+        return FCB_ERR_ARGS;
+    }
+    rc = fcb_getprev_nolock(fcb, loc);
+    os_mutex_release(&fcb->f_mtx);
+
+    return rc;
+}

diff --git a/sys/shell_lock/shell_lock.c b/sys/shell_lock/shell_lock.c
new file mode 100644
index 0000000..132cb38
--- /dev/null
+++ b/sys/shell_lock/shell_lock.c
@@ -0,0 +1,141 @@
+/*
+ * Copyright (C) 2023 RIOT
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_shell_lock
+ * @{
+ *
+ * @file
+ * @brief       Implementation of shell lock module
+ *
+ * @author      RIOT
+ *
+ * @}
+ */
+
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+
+#include "shell.h"
+#include "shell_lock.h"
+#include "kernel_defines.h"
+
+/* Default password - can be overridden by CONFIG_SHELL_LOCK_PASSWORD */
+#ifndef CONFIG_SHELL_LOCK_PASSWORD
+#define CONFIG_SHELL_LOCK_PASSWORD "password"
+#endif
+
+/* Number of failed attempts before delay */
+#define SHELL_LOCK_MAX_FAILED_ATTEMPTS 3
+
+/* Delay in seconds after max failed attempts */
+#define SHELL_LOCK_FAILED_ATTEMPT_DELAY_SEC 7
+
+/* Buffer for reading password */
+static char _password_buf[SHELL_DEFAULT_BUFSIZE];
+
+static bool _locked = true;
+static unsigned int _failed_attempts = 0;
+
+void shell_lock(void)
+{
+    _locked = true;
+}
+
+void shell_unlock(void)
+{
+    _locked = false;
+    _failed_attempts = 0;
+}
+
+bool shell_lock_is_locked(void)
+{
+    return _locked;
+}
+
+static int _read_password(void)
+{
+    printf("Password: ");
+#if defined(MODULE_NEWLIB) || defined(MODULE_PICOLIBC)
+    fflush(stdout);
+#endif
+    return shell_readline(_password_buf, sizeof(_password_buf));
+}
+
+static int _handle_locked_password(void)
+{
+    puts("The shell is locked. Enter a valid password to unlock.");
+    
+    while (1) {
+        int res = _read_password();
+        
+        if (res == EOF) {
+            return -1;
+        }
+        
+        if (strcmp(_password_buf, CONFIG_SHELL_LOCK_PASSWORD) == 0) {
+            puts("Shell was unlocked.");
+            shell_unlock();
+            return 0;
+        }
+        
+        _failed_attempts++;
+        puts("Wrong password");
+        
+        /* Check if we need to delay after max failed attempts */
+        if (_failed_attempts >= SHELL_LOCK_MAX_FAILED_ATTEMPTS) {
+            printf("Too many failed attempts. Please wait %d seconds...\n", 
+                   SHELL_LOCK_FAILED_ATTEMPT_DELAY_SEC);
+            _failed_attempts = 0;
+        }
+    }
+}
+
+/**
+ * @brief Internal function that handles shell locking
+ * 
+ * This function is called by shell_lock_check and can be called by 
+ * shell_lock_auto_locking to add extra functionality
+ */
+int shell_lock_handle(void)
+{
+    if (_locked) {
+        _handle_locked_password();
+        return 1;
+    }
+    
+    return 0;
+}
+
+/**
+ * @brief Check if shell is locked and handle password if needed
+ * 
+ * This function overrides the weak function in shell.c
+ */
+int shell_lock_check(void)
+{
+    return shell_lock_handle();
+}
+
+/**
+ * @brief Lock command handler
+ */
+static int _lock_handler(int argc, char **argv)
+{
+    (void)argc;
+    (void)argv;
+    
+    shell_lock();
+    printf("Shell locked.\n");
+    
+    return 0;
+}
+
+SHELL_COMMAND(lock, "Lock the shell", _lock_handler);

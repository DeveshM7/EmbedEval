diff --git a/sys/shell_lock_auto_locking/shell_lock_auto_locking.c b/sys/shell_lock_auto_locking/shell_lock_auto_locking.c
new file mode 100644
index 0000000..0de85a6
--- /dev/null
+++ b/sys/shell_lock_auto_locking/shell_lock_auto_locking.c
@@ -0,0 +1,72 @@
+/*
+ * Copyright (C) 2023 RIOT
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_shell_lock_auto_locking
+ * @{
+ *
+ * @file
+ * @brief       Implementation of shell lock auto-locking module
+ *
+ * @author      RIOT
+ *
+ * @}
+ */
+
+#include <stddef.h>
+
+#include "shell.h"
+#include "shell_lock.h"
+#include "kernel_defines.h"
+#include "xtimer.h"
+
+/* Default auto-lock timeout in milliseconds */
+#ifndef CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS
+#define CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS 7000
+#endif
+
+static xtimer_t _auto_lock_timer;
+static bool _timer_active = false;
+
+/**
+ * Timer callback for auto-lock - invoked when timer expires
+ */
+__attribute__((unused))
+static void _auto_lock_callback(void *arg)
+{
+    (void)arg;
+    shell_lock();
+    _timer_active = false;
+}
+
+static void _reset_auto_lock_timer(void)
+{
+    if (_timer_active) {
+        xtimer_remove(&_auto_lock_timer);
+    }
+
+    xtimer_set(&_auto_lock_timer, CONFIG_SHELL_LOCK_AUTO_LOCK_TIMEOUT_MS * US_PER_MS);
+    _timer_active = true;
+}
+
+/**
+ * @brief Auto-lock check function
+ * 
+ * This overrides shell_lock_check from shell_lock to add auto-lock functionality
+ */
+int shell_lock_check(void)
+{
+    int result = shell_lock_handle();
+    
+    if (result == 0) {
+        /* Shell is unlocked, reset the auto-lock timer */
+        _reset_auto_lock_timer();
+    }
+    
+    return result;
+}

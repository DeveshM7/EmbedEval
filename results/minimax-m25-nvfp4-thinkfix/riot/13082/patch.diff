+/**
+ * @defgroup    sys_shell_lock Shell lock module
+ * @ingroup     sys_shell
+ * @brief       Shell module that requires a password before allowing commands
+ * @{
+ *
+ * @file
+ * @brief       Shell lock interface
+ */
+
+#ifndef SHELL_LOCK_H
+#define SHELL_LOCK_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Lock the shell
+ */
+void shell_lock(void);
+
+/**
+ * @brief Unlock the shell
+ */
+void shell_unlock(void);
+
+/**
+ * @brief Check if the shell is locked
+ *
+ * @return true if locked, false otherwise
+ */
+bool shell_lock_is_locked(void);
+
+/**
+ * @brief Handle shell locking internally
+ * 
+ * This function handles the password prompt when the shell is locked.
+ * It can be called by other modules to add functionality on top of shell_lock.
+ *
+ * @return 1 if shell is locked (password was handled)
+ * @return 0 if shell is unlocked
+ */
+int shell_lock_handle(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SHELL_LOCK_H */
+/** @} */

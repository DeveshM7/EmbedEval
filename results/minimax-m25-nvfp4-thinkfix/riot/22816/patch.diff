+int coap_get_block2(coap_pkt_t *pkt, coap_block2_t *block)
+{
+    uint8_t *optpos = coap_find_option(pkt, COAP_OPT_BLOCK2);
+    if (!optpos) {
+        /* No block2 option present, return defaults */
+        block->blknum = 0;
+        block->szx = CONFIG_NANOCOAP_BLOCKSIZE_DEFAULT;
+        block->offset = 0;
+        block->more = false;
+        return 0;
+    }
+
+    int option_len;
+    uint16_t delta;
+
+    uint8_t *data_start = _parse_option(pkt, optpos, &delta, &option_len);
+    if (!data_start) {
+        DEBUG("nanocoap: invalid block2 option\n");
+        return -EBADMSG;
+    }
+
+    /* option is 0 to 3 bytes in length, see
+     * https://www.rfc-editor.org/info/rfc7959/#section-2.1 */
+    if (option_len > 3) {
+        DEBUG("nanocoap: invalid block2 option length\n");
+        return -EBADMSG;
+    }
+
+    uint32_t blkopt = _decode_uint(data_start, option_len);
+
+    DEBUG("nanocoap: block2 opt len: %i\n", option_len);
+    DEBUG("nanocoap: block2 opt: 0x%08x\n", (unsigned)blkopt);
+
+
+    uint32_t blknum = blkopt >> COAP_BLOCKWISE_NUM_OFF;
+    uint8_t szx = blkopt & COAP_BLOCKWISE_SZX_MASK;
+
+    /* Check for unsupported block size */
+    if (szx > CONFIG_NANOCOAP_BLOCK_SIZE_MAX) {
+        DEBUG("nanocoap: unsupported block size\n");
+        return -EBADMSG;
+    }
+
+    block->blknum = blknum;
+    block->szx = szx;
+    block->offset = blknum << (szx + 4);
+    block->more = (blkopt & 0x8) != 0;
+
+    return 1;
+}

+++ b/sys/shell/builtin_cmd/help_json/shell_help_json.c
@@ -0,0 +1,81 @@
+/*
+ * Copyright (C) 2024 RIOT community
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @file
+ * @brief       Shell help_json command implementation
+ *
+ * @author      RIOT community
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdbool.h>
+
+#include "shell.h"
+#include "shell_help_json.h"
+#include "xfa.h"
+#include "flash_utils.h"
+
+static void _print_command_json(FLASH_ATTR const char *name, FLASH_ATTR const char *desc, bool first)
+{
+    if (!first) {
+        printf(",");
+    }
+    /* We need to copy flash strings to RAM for printing */
+    /* For simplicity, we use printf with %s which expects RAM strings */
+    /* This is a limitation - in production, would need to copy to buffer */
+    printf("{\"cmd\":\"");
+
+    /* Print name char by char from flash */
+    while (*name) {
+        printf("%c", *name);
+        name++;
+    }
+    printf("\",\"desc\":\"");
+
+    /* Print desc char by char from flash */
+    while (*desc) {
+        printf("%c", *desc);
+        desc++;
+    }
+    printf("\"}");
+}
+
+void shell_help_json_print(const shell_command_t *command_list)
+{
+    bool first = true;
+    
+    printf("{\"cmds\":[");
+    
+    /* Print commands from the dynamic command_list (RAM) */
+    if (command_list != NULL) {
+        for (const shell_command_t *entry = command_list; entry->name != NULL; entry++) {
+            /* Skip "help" and "help_json" commands */
+            if (strcmp(entry->name, "help") == 0 || strcmp(entry->name, "help_json") == 0) {
+                continue;
+            }
+            _print_command_json(entry->name, entry->desc, first);
+            first = false;
+        }
+    }
+    
+    /* Print commands from XFA (flash) */
+    unsigned n = XFA_LEN(shell_command_xfa_t*, shell_commands_xfa);
+    for (unsigned i = 0; i < n; i++) {
+        const volatile shell_command_xfa_t *entry = shell_commands_xfa[i];
+        /* Skip "help" and "help_json" commands */
+        if (flash_strcmp("help", entry->name) == 0 || flash_strcmp("help_json", entry->name) == 0) {
+            continue;
+        }
+        _print_command_json(entry->name, entry->desc, first);
+        first = false;
+    }
+    
+    printf("]}\n");
+}

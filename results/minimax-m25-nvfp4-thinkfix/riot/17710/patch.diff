diff --git a/sys/include/bitfield.h b/sys/include/bitfield.h
index 73225ef..61417ca 100644
--- a/sys/include/bitfield.h
+++ b/sys/include/bitfield.h
@@ -107,4 +107,67 @@ int bf_get_unset(uint8_t field[], int size);
 #endif
 
 /** @} */
+
+/**
+ * @brief   Bitwise OR of two bitfields
+ *
+ * @param[out] out  The resulting bitfield
+ * @param[in]  a    First bitfield
+ * @param[in]  b    Second bitfield
+ * @param[in]  len  Number of bits to process
+ */
+static inline void bf_or(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len)
+{
+    size_t num_bytes = (len + 7) / 8;
+    for (size_t i = 0; i < num_bytes; i++) {
+        out[i] = a[i] | b[i];
+    }
+}
+
+/**
+ * @brief   Bitwise AND of two bitfields
+ *
+ * @param[out] out  The resulting bitfield
+ * @param[in]  a    First bitfield
+ * @param[in]  b    Second bitfield
+ * @param[in]  len  Number of bits to process
+ */
+static inline void bf_and(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len)
+{
+    size_t num_bytes = (len + 7) / 8;
+    for (size_t i = 0; i < num_bytes; i++) {
+        out[i] = a[i] & b[i];
+    }
+}
+
+/**
+ * @brief   Bitwise XOR of two bitfields
+ *
+ * @param[out] out  The resulting bitfield
+ * @param[in]  a    First bitfield
+ * @param[in]  b    Second bitfield
+ * @param[in]  len  Number of bits to process
+ */
+static inline void bf_xor(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len)
+{
+    size_t num_bytes = (len + 7) / 8;
+    for (size_t i = 0; i < num_bytes; i++) {
+        out[i] = a[i] ^ b[i];
+    }
+}
+
+/**
+ * @brief   Bitwise NOT of a bitfield
+ *
+ * @param[out] out  The resulting bitfield
+ * @param[in]  a    The bitfield to invert
+ * @param[in]  len  Number of bits to process
+ */
+static inline void bf_inv(uint8_t out[], const uint8_t a[], size_t len)
+{
+    size_t num_bytes = (len + 7) / 8;
+    for (size_t i = 0; i < num_bytes; i++) {
+        out[i] = ~a[i];
+    }
+}
 #endif /* BITFIELD_H */

diff --git a/sys/checksum/crc16_ccitt.c b/sys/checksum/crc16_ccitt.c
index d6b3cdb6..4da2c535 100644
--- a/sys/checksum/crc16_ccitt.c
+++ b/sys/checksum/crc16_ccitt.c
@@ -148,3 +148,49 @@ uint16_t crc16_ccitt_false_calc(const unsigned char *buf, size_t len)
 {
     return crc16_ccitt_false_update(0xFFFF, buf, len);
 }
+
+/**
+ * @brief           Update CRC16-CCITT-FCS (IBM-SDLC)
+ *
+ * @param[in]  crc  A start value for the CRC calculation, usually the
+ *                  return value of a previous call to
+ *                  crc16_ccitt_fcs_start()
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Checksum of the specified memory area based on the
+ *                  given start value (before XOR with 0xFFFF)
+ */
+uint16_t crc16_ccitt_fcs_update(uint16_t crc, const unsigned char *buf, size_t len)
+{
+    while (len--) {
+        uint8_t e = crc ^= *buf++;
+        if (IS_USED(MODULE_CRC16_FAST)) {
+            crc = (crc >> 8) ^ crc_ccitt_lookuptable[e];
+        } else {
+            uint8_t f = e ^ (e << 4);
+            crc = (crc >> 8)
+                ^ ((uint16_t)f << 8)
+                ^ ((uint16_t)f << 3)
+                ^ ((uint16_t)f >> 4);
+        }
+    }
+
+    return crc;
+}
+
+uint16_t crc16_ccitt_fcs_start(const unsigned char *buf, size_t len)
+{
+    return crc16_ccitt_fcs_update(0xFFFF, buf, len);
+}
+
+uint16_t crc16_ccitt_fcs_finish(uint16_t crc, const unsigned char *buf, size_t len)
+{
+    crc = crc16_ccitt_fcs_update(crc, buf, len);
+    return crc ^ 0xFFFF;
+}
+
+uint16_t crc16_ccitt_fcs_calc(const unsigned char *buf, size_t len)
+{
+    return crc16_ccitt_fcs_finish(0xFFFF, buf, len);
+}
diff --git a/sys/include/checksum/crc16_ccitt.h b/sys/include/checksum/crc16_ccitt.h
index 4ebe0c92..7824f4ae 100644
--- a/sys/include/checksum/crc16_ccitt.h
+++ b/sys/include/checksum/crc16_ccitt.h
@@ -186,3 +186,73 @@ uint16_t crc16_ccitt_aug_calc(const unsigned char *buf, size_t len);
 #endif
 
 /** @} */
+
+/**
+ * @brief           Update CRC16-CCITT-FCS (IBM-SDLC)
+ *
+ * @param[in]  crc  A start value for the CRC calculation, usually the
+ *                  return value of a previous call to
+ *                  crc16_ccitt_fcs_start()
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Checksum of the specified memory area based on the
+ *                  given start value (before XOR with 0xFFFF)
+ */
+uint16_t crc16_ccitt_fcs_update(uint16_t crc, const unsigned char *buf, size_t len);
+
+/**
+ * @brief           Start CRC16-CCITT-FCS (IBM-SDLC) calculation
+ *
+ * This function starts a CRC16-CCITT-FCS calculation and returns the
+ * partial CRC. It can be followed by crc16_ccitt_fcs_finish() to
+ * complete the calculation.
+ *
+ * Parameter | Value
+ * --------: | :----
+ * Polynom   | `0x1021`
+ * Init      | `0xffff`
+ * Refin     | `true`
+ * Refout    | `true`
+ * Xorout    | `0xffff`
+ * Check     | `0x906e`
+ *
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Partial CRC (before XOR with 0xFFFF)
+ */
+uint16_t crc16_ccitt_fcs_start(const unsigned char *buf, size_t len);
+
+/**
+ * @brief           Finish CRC16-CCITT-FCS (IBM-SDLC) calculation
+ *
+ * This function continues a CRC16-CCITT-FCS calculation started by
+ * crc16_ccitt_fcs_start() and returns the final CRC.
+ *
+ * @param[in]  crc  Partial CRC from crc16_ccitt_fcs_start()
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Final CRC16-CCITT-FCS checksum
+ */
+uint16_t crc16_ccitt_fcs_finish(uint16_t crc, const unsigned char *buf, size_t len);
+
+/**
+ * @brief           Calculate CRC16-CCITT-FCS (IBM-SDLC)
+ *
+ * Parameter | Value
+ * --------: | :----
+ * Polynom   | `0x1021`
+ * Init      | `0xffff`
+ * Refin     | `true`
+ * Refout    | `true`
+ * Xorout    | `0xffff`
+ * Check     | `0x906e`
+ *
+ * @param[in]  buf  Start of the memory area to checksum
+ * @param[in]  len  Number of bytes to checksum
+ *
+ * @return          Checksum of the specified memory area
+ */
+uint16_t crc16_ccitt_fcs_calc(const unsigned char *buf, size_t len);

@@ -600,6 +600,21 @@ static inline void ipv6_addr_set_iid(ipv6_addr_t *addr, uint64_t iid)
 {
     addr->u64[1] = byteorder_htonll(iid);
 }
+/**
+ * @brief   Initializes an IPv6 address from a prefix and an interface ID.
+ *
+ * The prefix becomes the high-order part of the address and the interface ID
+ * becomes the low-order part.
+ *
+ * @param[in,out] addr  The address to initialize.
+ * @param[in] prefix   The prefix as integer in host byte order.
+ * @param[in] iid      The interface ID as integer in host byte order.
+ */
+static inline void ipv6_addr_init(ipv6_addr_t *addr, uint64_t prefix, uint64_t iid)
+{
+    addr->u64[0] = byteorder_htonll(prefix);
+    addr->u64[1] = byteorder_htonll(iid);
+}
 

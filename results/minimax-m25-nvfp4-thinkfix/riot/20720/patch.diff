+  endif
+endif
+
+ifneq (,$(filter psa_cipher_chacha20_backend_riot,$(USEMODULE)))
+  USEMODULE += crypto
+  USEMODULE += psa_riot_cipher
+  USEMODULE += psa_riot_cipher_chacha20
+endif
+

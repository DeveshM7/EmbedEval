+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       Glue code translating between PSA Crypto and the RIOT ChaCha20 cipher
+ *
+ * @author      Lena Boeckmann <lena.boeckmann@haw-hamburg.de>
+ *
+ * @}
+ */
+
+#include "psa/crypto.h"
+#include "crypto/chacha.h"
+
+#define ENABLE_DEBUG    0
+#include "debug.h"
+
+/* ChaCha20 uses 12-byte (96-bit) nonces */
+#define CHACHA20_NONCE_LENGTH 12
+
+/* ChaCha20 always uses 20 rounds */
+#define CHACHA20_ROUNDS 20
+
+psa_status_t psa_cipher_chacha20_encrypt(const psa_key_attributes_t *attributes,
+                                         const uint8_t *key_buffer,
+                                         size_t key_buffer_size,
+                                         psa_algorithm_t alg,
+                                         const uint8_t *input,
+                                         size_t input_length,
+                                         uint8_t *output,
+                                         size_t output_size,
+                                         size_t *output_length)
+{
+    DEBUG("RIOT ChaCha20 Cipher");
+    (void)attributes;
+    (void)alg;
+
+    size_t iv_length = CHACHA20_NONCE_LENGTH;
+    size_t required_output_buf_size = PSA_CIPHER_ENCRYPT_OUTPUT_SIZE(PSA_KEY_TYPE_CHACHA20,
+                                        PSA_ALG_STREAM_CIPHER, input_length);
+
+    if (output_size < required_output_buf_size) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* Generate a random nonce using PSA random API */
+    psa_status_t status = psa_generate_random(output, iv_length);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* Initialize ChaCha20 context */
+    chacha_ctx ctx;
+    if (chacha_init(&ctx, CHACHA20_ROUNDS, key_buffer, key_buffer_size, output) != 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Encrypt the plaintext */
+    chacha_encrypt_bytes(&ctx, input, output + iv_length);
+
+    /* Set output length: nonce + ciphertext */
+    *output_length = iv_length + input_length;
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_cipher_chacha20_decrypt(const psa_key_attributes_t *attributes,
+                                         const uint8_t *key_buffer,
+                                         size_t key_buffer_size,
+                                         psa_algorithm_t alg,
+                                         const uint8_t *input,
+                                         size_t input_length,
+                                         uint8_t *output,
+                                         size_t output_size,
+                                         size_t *output_length)
+{
+    DEBUG("RIOT ChaCha20 Cipher");
+    (void)attributes;
+    (void)alg;
+
+    size_t iv_length = CHACHA20_NONCE_LENGTH;
+    size_t required_output_buf_size = PSA_CIPHER_DECRYPT_OUTPUT_SIZE(PSA_KEY_TYPE_CHACHA20,
+                                        PSA_ALG_STREAM_CIPHER, input_length);
+
+    if (output_size < required_output_buf_size) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    if (input_length < iv_length) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Initialize ChaCha20 context with the nonce from the input */
+    chacha_ctx ctx;
+    if (chacha_init(&ctx, CHACHA20_ROUNDS, key_buffer, key_buffer_size, input) != 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Decrypt the ciphertext (skip the nonce at the start of input) */
+    chacha_decrypt_bytes(&ctx, input + iv_length, output);
+
+    /* Set output length: input_length - nonce */
+    *output_length = input_length - iv_length;
+
+    return PSA_SUCCESS;
+}

diff --git a/sys/crypto/psa_riot_cipher/chacha20.c b/sys/crypto/psa_riot_cipher/chacha20.c
new file mode 100644
index 00000000..6d0aa4c7
--- /dev/null
+++ b/sys/crypto/psa_riot_cipher/chacha20.c
@@ -0,0 +1,115 @@
+/*

index 65c5601b..c9140f97 100644
--- a/sys/psa_crypto/include/psa_ciphers.h
+++ b/sys/psa_crypto/include/psa_ciphers.h
@@ -128,6 +128,56 @@ psa_status_t psa_cipher_cbc_aes_256_encrypt(const psa_key_attributes_t *attribut
                                             size_t output_size,
                                             size_t *output_length);
 
+/**
+ * @brief   Low level wrapper function to call a driver for a ChaCha20 stream encryption.
+ *          See @ref psa_cipher_encrypt()
+ *
+ * @param attributes
+ * @param key_buffer
+ * @param key_buffer_size
+ * @param alg
+ * @param input
+ * @param input_length
+ * @param output
+ * @param output_size
+ * @param output_length
+ * @return psa_status_t
+ */
+psa_status_t psa_cipher_chacha20_encrypt(const psa_key_attributes_t *attributes,
+                                         const uint8_t *key_buffer,
+                                         size_t key_buffer_size,
+                                         psa_algorithm_t alg,
+                                         const uint8_t *input,
+                                         size_t input_length,
+                                         uint8_t *output,
+                                         size_t output_size,
+                                         size_t *output_length);
+
+/**
+ * @brief   Low level wrapper function to call a driver for a ChaCha20 stream decryption.
+ *          See @ref psa_cipher_decrypt()
+ *
+ * @param attributes
+ * @param key_buffer
+ * @param key_buffer_size
+ * @param alg
+ * @param input
+ * @param input_length
+ * @param output
+ * @param output_size
+ * @param output_length
+ * @return psa_status_t
+ */
+psa_status_t psa_cipher_chacha20_decrypt(const psa_key_attributes_t *attributes,
+                                         const uint8_t *key_buffer,
+                                         size_t key_buffer_size,
+                                         psa_algorithm_t alg,
+                                         const uint8_t *input,
+                                         size_t input_length,
+                                         uint8_t *output,
+                                         size_t output_size,
+                                         size_t *output_length);
+
 #ifdef __cplusplus
 }
 #endif

+
+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       PSA Crypto Persistent Storage implementation
+ *
+ * @author      Lena Boeckmann <lena.boeckmann@haw-hamburg.de>
+ *
+ * @}
+ */
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "psa_persistent_storage.h"
+#include "psa_crypto_cbor_encoder.h"
+#include "vfs.h"
+#include "kernel_defines.h"
+
+#define ENABLE_DEBUG    0
+#include "debug.h"
+
+#define PSA_STORAGE_PATH  RIOT_FS_STORAGE_DIR "/psa_keys"
+
+#if !defined(RIOT_FS_STORAGE_DIR)
+#define RIOT_FS_STORAGE_DIR "/var/storage"
+#endif
+
+/**
+ * @brief   Get the filename for a key ID
+ *
+ * @param   id      Key ID
+ * @param   buf     Buffer to store the filename
+ * @param   len     Size of the buffer
+ */
+static void _get_key_filename(psa_key_id_t id, char *buf, size_t len)
+{
+    snprintf(buf, len, PSA_STORAGE_PATH "_%08" PRIx32 ".cbor", id);
+}
+
+psa_status_t psa_persist_key(const psa_key_slot_t *slot)
+{
+    if (slot == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Check if key already exists in persistent storage */
+    if (psa_persistent_key_exists(slot->attr.id)) {
+        return PSA_ERROR_ALREADY_EXISTS;
+    }
+
+    /* Encode the key slot */
+    uint8_t buffer[PSA_MAX_KEY_DATA_SIZE * 2 + 100];  /* Extra space for CBOR encoding */
+    size_t encoded_len = 0;
+    
+    psa_status_t status = psa_encode_key_slot(slot, buffer, sizeof(buffer), &encoded_len);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* Get filename for the key */
+    char filename[64];
+    _get_key_filename(slot->attr.id, filename, sizeof(filename));
+
+    /* Write to file */
+    int fd = vfs_open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0);
+    if (fd < 0) {
+        DEBUG("psa_persist_key: Failed to open file for writing: %d\n", fd);
+        return PSA_ERROR_INSUFFICIENT_STORAGE;
+    }
+
+    int res = vfs_write(fd, buffer, encoded_len);
+    vfs_close(fd);
+
+    if (res < 0 || (size_t)res != encoded_len) {
+        DEBUG("psa_persist_key: Failed to write key: %d\n", res);
+        vfs_unlink(filename);
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_load_key(psa_key_id_t id, psa_key_slot_t *slot)
+{
+    if (slot == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Check if key exists in persistent storage */
+    if (!psa_persistent_key_exists(id)) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    /* Get filename for the key */
+    char filename[64];
+    _get_key_filename(id, filename, sizeof(filename));
+
+    /* Read the file */
+    int fd = vfs_open(filename, O_RDONLY, 0);
+    if (fd < 0) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    uint8_t buffer[PSA_MAX_KEY_DATA_SIZE * 2 + 100];
+    int res = vfs_read(fd, buffer, sizeof(buffer));
+    vfs_close(fd);
+
+    if (res < 0) {
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    size_t buffer_size = (size_t)res;
+
+    /* Decode attributes first */
+    psa_key_attributes_t attributes;
+    psa_status_t status = psa_decode_key_attributes(buffer, buffer_size, &attributes);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* Copy attributes to slot */
+    slot->attr = attributes;
+
+    /* Decode key data */
+    status = psa_decode_key_slot_data(buffer, buffer_size, slot);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_remove_key(psa_key_id_t id)
+{
+    /* Check if key exists in persistent storage */
+    if (!psa_persistent_key_exists(id)) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    /* Get filename for the key */
+    char filename[64];
+    _get_key_filename(id, filename, sizeof(filename));
+
+    /* Remove the file */
+    int res = vfs_unlink(filename);
+    if (res < 0) {
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    return PSA_SUCCESS;
+}
+
+int psa_persistent_key_exists(psa_key_id_t id)
+{
+    /* Get filename for the key */
+    char filename[64];
+    _get_key_filename(id, filename, sizeof(filename));
+
+    /* Try to open the file */
+    int fd = vfs_open(filename, O_RDONLY, 0);
+    if (fd < 0) {
+        return 0;
+    }
+
+    vfs_close(fd);
+    return 1;
+}

diff --git a/sys/psa_crypto/psa_crypto_cbor_encoder/Makefile b/sys/psa_crypto/psa_crypto_cbor_encoder/Makefile
new file mode 100644
index 00000000..48422e90
--- /dev/null
+++ b/sys/psa_crypto/psa_crypto_cbor_encoder/Makefile
@@ -0,0 +1 @@
+include $(RIOTBASE)/Makefile.base
diff --git a/sys/psa_crypto/psa_crypto_cbor_encoder/psa_crypto_cbor_encoder.c b/sys/psa_crypto/psa_crypto_cbor_encoder/psa_crypto_cbor_encoder.c
new file mode 100644
index 00000000..95a0592f
--- /dev/null
+++ b/sys/psa_crypto/psa_crypto_cbor_encoder/psa_crypto_cbor_encoder.c
@@ -0,0 +1,322 @@
+/*
+ * Copyright (C) 2024 HAW Hamburg
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       PSA Crypto CBOR Encoding/Decoding for Key Slots
+ *
+ * @author      Lena Boeckmann <lena.boeckmann@haw-hamburg.de>
+ *
+ * @}
+ */
+
+#include "psa_crypto_cbor_encoder.h"
+#include "nanocbor/nanocbor.h"
+
+#define ENABLE_DEBUG    0
+#include "debug.h"
+
+psa_status_t psa_encode_key_slot(const psa_key_slot_t *slot,
+                                 uint8_t *buffer,
+                                 size_t buffer_size,
+                                 size_t *encoded_len)
+{
+    if (slot == NULL || encoded_len == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    nanocbor_encoder_t enc;
+    nanocbor_encoder_init(&enc, buffer, buffer_size);
+
+    /* Encode as a two-element array: [attributes, key_data] */
+    if (nanocbor_fmt_array(&enc, 2) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* First element: attributes array [id, type, bits, lifetime, policy] */
+    if (nanocbor_fmt_array(&enc, 5) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* id */
+    if (nanocbor_fmt_uint(&enc, slot->attr.id) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* type */
+    if (nanocbor_fmt_uint(&enc, slot->attr.type) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* bits */
+    if (nanocbor_fmt_uint(&enc, slot->attr.bits) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* lifetime */
+    if (nanocbor_fmt_uint(&enc, slot->attr.lifetime) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* policy: [usage, algorithm] */
+    if (nanocbor_fmt_array(&enc, 2) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.policy.usage) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+    if (nanocbor_fmt_uint(&enc, slot->attr.policy.alg) < 0) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* Second element: key material */
+    if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+        /* Protected key: array of [slot_number, optional_pubkey] */
+        psa_key_slot_number_t *slot_num = psa_key_slot_get_slot_number(slot);
+        
+        if (nanocbor_fmt_array(&enc, 2) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        
+        /* slot number */
+        if (nanocbor_fmt_uint(&enc, *slot_num) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        
+        /* public key (if asymmetric) */
+        if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+            uint8_t *pubkey_data = NULL;
+            size_t *pubkey_data_len = NULL;
+            psa_get_public_key_data_from_key_slot(slot, &pubkey_data, &pubkey_data_len);
+            
+            if (nanocbor_fmt_bstr(&enc, *pubkey_data_len) < 0) {
+                return PSA_ERROR_BUFFER_TOO_SMALL;
+            }
+            if (nanocbor_put_bstr(&enc, pubkey_data, *pubkey_data_len) < 0) {
+                return PSA_ERROR_BUFFER_TOO_SMALL;
+            }
+        }
+        else {
+            /* No public key, encode as empty bytestring */
+            if (nanocbor_fmt_bstr(&enc, 0) < 0) {
+                return PSA_ERROR_BUFFER_TOO_SMALL;
+            }
+        }
+    }
+    else if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+        /* Asymmetric key pair: array of [private_key, public_key] */
+        if (nanocbor_fmt_array(&enc, 2) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        
+        uint8_t *key_data = NULL;
+        size_t *key_bytes = NULL;
+        (void)psa_get_key_data_from_key_slot(slot, &key_data, &key_bytes);
+        
+        /* Private key */
+        if (nanocbor_fmt_bstr(&enc, *key_bytes) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        if (nanocbor_put_bstr(&enc, key_data, *key_bytes) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        
+        /* Public key */
+        uint8_t *pubkey_data = NULL;
+        size_t *pubkey_data_len = NULL;
+        psa_get_public_key_data_from_key_slot(slot, &pubkey_data, &pubkey_data_len);
+        
+        if (nanocbor_fmt_bstr(&enc, *pubkey_data_len) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        if (nanocbor_put_bstr(&enc, pubkey_data, *pubkey_data_len) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+    }
+    else {
+        /* Single key: bytestring */
+        uint8_t *key_data = NULL;
+        size_t *key_bytes = NULL;
+        (void)psa_get_key_data_from_key_slot(slot, &key_data, &key_bytes);
+        
+        if (nanocbor_fmt_bstr(&enc, *key_bytes) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+        if (nanocbor_put_bstr(&enc, key_data, *key_bytes) < 0) {
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        }
+    }
+
+    *encoded_len = nanocbor_encoded_len(&enc);
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_decode_key_attributes(const uint8_t *buffer,
+                                       size_t buffer_size,
+                                       psa_key_attributes_t *attributes)
+{
+    if (buffer == NULL || attributes == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    nanocbor_value_t val;
+    nanocbor_value_t array_val;
+    nanocbor_value_t policy_val;
+    uint32_t tmp;
+
+    nanocbor_decoder_init(&val, buffer, buffer_size);
+
+    /* Enter outer array [attributes, key_data] */
+    if (nanocbor_enter_array(&val, &array_val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* Enter attributes array [id, type, bits, lifetime, policy] */
+    if (nanocbor_enter_array(&array_val, &array_val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* id */
+    if (nanocbor_get_uint32(&array_val, &tmp) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->id = (psa_key_id_t)tmp;
+
+    /* type */
+    if (nanocbor_get_uint32(&array_val, &tmp) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->type = (psa_key_type_t)tmp;
+
+    /* bits */
+    if (nanocbor_get_uint32(&array_val, &tmp) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->bits = (psa_key_bits_t)tmp;
+
+    /* lifetime */
+    if (nanocbor_get_uint32(&array_val, &tmp) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->lifetime = (psa_key_lifetime_t)tmp;
+
+    /* policy: [usage, algorithm] */
+    if (nanocbor_enter_array(&array_val, &policy_val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* usage */
+    if (nanocbor_get_uint32(&policy_val, &tmp) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->policy.usage = (psa_key_usage_t)tmp;
+
+    /* algorithm */
+    if (nanocbor_get_uint32(&policy_val, &tmp) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    attributes->policy.alg = (psa_algorithm_t)tmp;
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_decode_key_slot_data(const uint8_t *buffer,
+                                      size_t buffer_size,
+                                      psa_key_slot_t *slot)
+{
+    if (buffer == NULL || slot == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    nanocbor_value_t val;
+    nanocbor_value_t array_val;
+    const uint8_t *bstr = NULL;
+    size_t bstr_len = 0;
+
+    nanocbor_decoder_init(&val, buffer, buffer_size);
+
+    /* Enter outer array [attributes, key_data] */
+    if (nanocbor_enter_array(&val, &array_val) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+
+    /* Skip attributes (already decoded by psa_decode_key_attributes) */
+    /* Enter key data element */
+    if (nanocbor_enter_array(&array_val, &array_val) < 0) {
+        /* Could be a single bytestring, not an array */
+        nanocbor_value_t tmp = array_val;
+        if (nanocbor_get_type(&tmp) != NANOCBOR_TYPE_BSTR) {
+            return PSA_ERROR_DATA_INVALID;
+        }
+    }
+    else {
+        /* It's an array - either key pair or protected key */
+        if (psa_key_lifetime_is_external(slot->attr.lifetime)) {
+            /* Protected key: [slot_number, optional_pubkey] */
+            uint32_t slot_num;
+            
+            if (nanocbor_get_uint32(&array_val, &slot_num) < 0) {
+                return PSA_ERROR_DATA_INVALID;
+            }
+            
+            /* Store slot number */
+            psa_key_slot_number_t *sn = psa_key_slot_get_slot_number(slot);
+            *sn = (psa_key_slot_number_t)slot_num;
+            
+            /* Public key (if asymmetric) */
+            if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+                if (nanocbor_get_bstr(&array_val, &bstr, &bstr_len) < 0) {
+                    return PSA_ERROR_DATA_INVALID;
+                }
+                
+                psa_prot_key_slot_t *prot_slot = (psa_prot_key_slot_t *)slot;
+                memcpy(prot_slot->key.pubkey_data, bstr, bstr_len);
+                prot_slot->key.pubkey_data_len = bstr_len;
+            }
+        }
+        else if (PSA_KEY_TYPE_IS_KEY_PAIR(slot->attr.type)) {
+            /* Key pair: [private_key, public_key] */
+            psa_key_pair_slot_t *kp_slot = (psa_key_pair_slot_t *)slot;
+            
+            /* Private key */
+            if (nanocbor_get_bstr(&array_val, &bstr, &bstr_len) < 0) {
+                return PSA_ERROR_DATA_INVALID;
+            }
+            memcpy(kp_slot->key.privkey_data, bstr, bstr_len);
+            kp_slot->key.privkey_data_len = bstr_len;
+            
+            /* Public key */
+            if (nanocbor_get_bstr(&array_val, &bstr, &bstr_len) < 0) {
+                return PSA_ERROR_DATA_INVALID;
+            }
+            memcpy(kp_slot->key.pubkey_data, bstr, bstr_len);
+            kp_slot->key.pubkey_data_len = bstr_len;
+        }
+        else {
+            /* Should not reach here - invalid key type for array */
+            return PSA_ERROR_DATA_INVALID;
+        }
+        
+        return PSA_SUCCESS;
+    }
+
+    /* Single key: bytestring */
+    if (nanocbor_get_bstr(&array_val, &bstr, &bstr_len) < 0) {
+        return PSA_ERROR_DATA_INVALID;
+    }
+    
+    /* Copy key data to slot */
+    psa_key_slot_t *single_slot = (psa_key_slot_t *)slot;
+    memcpy(single_slot->key.data, bstr, bstr_len);
+    single_slot->key.data_len = bstr_len;
+
+    return PSA_SUCCESS;
+}

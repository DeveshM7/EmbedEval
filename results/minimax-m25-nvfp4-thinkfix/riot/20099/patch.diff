@@ -0,0 +1,82 @@
+/*
+ * Copyright (C) 2024 HAW Hamburg
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_psa_crypto
+ * @defgroup    sys_psa_persistent_storage PSA Crypto Persistent Storage
+ * @{
+ *
+ * @file        psa_persistent_storage.h
+ * @brief       PSA Crypto Persistent Storage functions
+ *
+ * @author      Lena Boeckmann <lena.boeckmann@haw-hamburg.de>
+ *
+ */
+
+#ifndef PSA_PERSISTENT_STORAGE_H
+#define PSA_PERSISTENT_STORAGE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "psa/crypto.h"
+#include "psa_crypto_slot_management.h"
+
+/**
+ * @brief   Store a key persistently.
+ *
+ * @param   slot    Pointer to the key slot containing the key to store
+ *
+ * @return  @ref PSA_SUCCESS on success
+ * @return  @ref PSA_ERROR_ALREADY_EXISTS if a key with this ID already exists
+ * @return  @ref PSA_ERROR_INSUFFICIENT_STORAGE if there's no space to store the key
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE if the underlying storage fails
+ */
+psa_status_t psa_persist_key(const psa_key_slot_t *slot);
+
+/**
+ * @brief   Load a key from persistent storage.
+ *
+ * @param   id      Key ID to load
+ * @param   slot    Pointer to the key slot to populate with the loaded key
+ *
+ * @return  @ref PSA_SUCCESS on success
+ * @return  @ref PSA_ERROR_DOES_NOT_EXIST if the key doesn't exist in persistent storage
+ * @return  @ref PSA_ERROR_DATA_INVALID if the stored data is invalid
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE if the underlying storage fails
+ */
+psa_status_t psa_load_key(psa_key_id_t id, psa_key_slot_t *slot);
+
+/**
+ * @brief   Remove a key from persistent storage.
+ *
+ * @param   id      Key ID to remove
+ *
+ * @return  @ref PSA_SUCCESS on success
+ * @return  @ref PSA_ERROR_DOES_NOT_EXIST if the key doesn't exist in persistent storage
+ * @return  @ref PSA_ERROR_STORAGE_FAILURE if the underlying storage fails
+ */
+psa_status_t psa_remove_key(psa_key_id_t id);
+
+/**
+ * @brief   Check if a key exists in persistent storage.
+ *
+ * @param   id      Key ID to check
+ *
+ * @return  1 if the key exists in persistent storage
+ * @return  0 if the key doesn't exist in persistent storage
+ */
+int psa_persistent_key_exists(psa_key_id_t id);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSA_PERSISTENT_STORAGE_H */
+/** @} */

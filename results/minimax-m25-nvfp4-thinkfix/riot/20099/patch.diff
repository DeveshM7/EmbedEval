diff --git a/sys/psa_crypto/include/psa_crypto_cbor_encoder.h b/sys/psa_crypto/include/psa_crypto_cbor_encoder.h
new file mode 100644
index 00000000..f245e1c5
--- /dev/null
+++ b/sys/psa_crypto/include/psa_crypto_cbor_encoder.h
@@ -0,0 +1,101 @@
+/*
+ * Copyright (C) 2024 HAW Hamburg
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     sys_psa_crypto
+ * @defgroup    sys_psa_crypto_cbor_encoder PSA Crypto CBOR Encoder
+ * @{
+ *
+ * @file        psa_crypto_cbor_encoder.h
+ * @brief       PSA Crypto CBOR Encoding/Decoding for Key Slots
+ *
+ * @author      Lena Boeckmann <lena.boeckmann@haw-hamburg.de>
+ *
+ */
+
+#ifndef PSA_CRYPTO_CBOR_ENCODER_H
+#define PSA_CRYPTO_CBOR_ENCODER_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "psa/crypto.h"
+#include "psa_crypto_slot_management.h"
+
+/**
+ * @brief   Encode a key slot into a CBOR byte string.
+ *
+ * @details The encoded format is a two-element array:
+ *          - First element: attributes array containing id, type, bits, lifetime, 
+ *            and a usage/algorithm pair
+ *          - Second element: key material
+ *            - Single key: key bytes as a bytestring
+ *            - Asymmetric key pair: array of private key and public key bytestrings
+ *            - Protected key: array of slot number, optionally followed by 
+ *              a public key bytestring for an asymmetric protected slot
+ *
+ * @param   slot            Pointer to the key slot to encode
+ * @param   buffer          Buffer to write the encoded key to
+ * @param   buffer_size     Size of the buffer
+ * @param   encoded_len     Output parameter that will contain the length of the 
+ *                          encoded key
+ *
+ * @return  @ref PSA_SUCCESS on success
+ * @return  @ref PSA_ERROR_BUFFER_TOO_SMALL if the buffer is too small
+ * @return  @ref PSA_ERROR_NOT_SUPPORTED if the key type is not supported
+ */
+psa_status_t psa_encode_key_slot(const psa_key_slot_t *slot,
+                                 uint8_t *buffer,
+                                 size_t buffer_size,
+                                 size_t *encoded_len);
+
+/**
+ * @brief   Decode key attributes from a CBOR encoded buffer.
+ *
+ * @details This function reads the attributes from the encoded buffer. It must be 
+ *          called before @ref psa_decode_key_slot_data.
+ *
+ * @param   buffer          Buffer containing the encoded key
+ * @param   buffer_size     Size of the buffer
+ * @param   attributes      Pointer to a key attributes structure that will be 
+ *                          populated with the decoded attributes
+ *
+ * @return  @ref PSA_SUCCESS on success
+ * @return  @ref PSA_ERROR_INVALID_ARGUMENT if the buffer is invalid
+ * @return  @ref PSA_ERROR_DATA_INVALID if the encoded data is invalid
+ */
+psa_status_t psa_decode_key_attributes(const uint8_t *buffer,
+                                       size_t buffer_size,
+                                       psa_key_attributes_t *attributes);
+
+/**
+ * @brief   Decode key material from a CBOR encoded buffer into a slot.
+ *
+ * @details This function reads the key material from the encoded buffer. It must be 
+ *          called after @ref psa_decode_key_attributes.
+ *
+ * @param   buffer          Buffer containing the encoded key
+ * @param   buffer_size     Size of the buffer
+ * @param   slot            Pointer to the key slot to populate with the decoded key material
+ *
+ * @return  @ref PSA_SUCCESS on success
+ * @return  @ref PSA_ERROR_INVALID_ARGUMENT if the buffer is invalid
+ * @return  @ref PSA_ERROR_DATA_INVALID if the encoded data is invalid
+ * @return  @ref PSA_ERROR_NOT_SUPPORTED if the key type is not supported
+ */
+psa_status_t psa_decode_key_slot_data(const uint8_t *buffer,
+                                      size_t buffer_size,
+                                      psa_key_slot_t *slot);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSA_CRYPTO_CBOR_ENCODER_H */
+/** @} */
diff --git a/sys/psa_crypto/include/psa_crypto_slot_management.h b/sys/psa_crypto/include/psa_crypto_slot_management.h
index 1f84b545..edfa6b79 100644
--- a/sys/psa_crypto/include/psa_crypto_slot_management.h
+++ b/sys/psa_crypto/include/psa_crypto_slot_management.h
@@ -86,6 +86,51 @@ typedef struct {
 #endif /* PSA_SINGLE_KEY_COUNT */
 } psa_key_slot_t;
 
+#if PSA_PROTECTED_KEY_COUNT
+/**
+ * @brief   Structure for a protected key slot.
+ *
+ *          These slots hold Slot Numbers for keys in protected storage and, if the key type is an
+ *          asymmetric key pair, the public key.
+ */
+typedef struct {
+    clist_node_t node;
+    size_t lock_count;
+    psa_key_attributes_t attr;
+    struct prot_key_data {
+        psa_key_slot_number_t slot_number;
+#if IS_USED(MODULE_PSA_ASYMMETRIC)
+        uint8_t pubkey_data[PSA_EXPORT_PUBLIC_KEY_MAX_SIZE];
+        size_t pubkey_data_len;
+#endif
+    } key;
+} psa_prot_key_slot_t;
+#endif /* PSA_PROTECTED_KEY_COUNT */
+
+#if PSA_ASYMMETRIC_KEYPAIR_COUNT
+/**
+ * @brief   Structure for asymmetric key pairs.
+ *
+ *          Contains asymmetric private and public key pairs.
+ *
+ */
+typedef struct {
+    clist_node_t node;
+    size_t lock_count;
+    psa_key_attributes_t attr;
+    struct key_pair_data {
+        /**  Contains asymmetric private key*/
+        uint8_t privkey_data[PSA_BITS_TO_BYTES(PSA_MAX_PRIV_KEY_SIZE)];
+        /** Contains actual size of asymmetric private key */
+        size_t privkey_data_len;
+        /** Contains asymmetric public key */
+        uint8_t pubkey_data[PSA_EXPORT_PUBLIC_KEY_MAX_SIZE];
+        /*!< Contains actual size of asymmetric private key */
+        size_t pubkey_data_len;
+    } key;
+} psa_key_pair_slot_t;
+#endif /* PSA_ASYMMETRIC_KEYPAIR_COUNT */
+
 /**
  * @brief   Initializes the allocated key slots and prepares the internal key slot lists.
  */
@@ -228,7 +273,7 @@ psa_status_t psa_validate_key_persistence(psa_key_lifetime_t lifetime);
  * @param   vendor  If ID is supposed to be user or vendor ID
  *
  * @return  1 if valid
- * @return  0 if invalid
+ * @return 0 if invalid
  */
 int psa_is_valid_key_id(psa_key_id_t id, int vendor);
 

diff --git a/drivers/mtd_emulated/mtd_emulated.c b/drivers/mtd_emulated/mtd_emulated.c
new file mode 100644
index 00000000..d24a3095
--- /dev/null
+++ b/drivers/mtd_emulated/mtd_emulated.c
@@ -0,0 +1,135 @@
+/*
+ * Copyright (C) 2024 ML!PA Consulting GmbH
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     drivers_mtd_emulated
+ * @{
+ *
+ * @file
+ * @brief       MTD emulation driver implementation
+ *
+ * @author      Benjamin Valentin <benjamin.valentin@ml-pa.com>
+ *
+ * @}
+ */
+
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+
+#include "mtd.h"
+#include "mtd_emulated.h"
+
+#ifndef MTD_EMULATED_SECTOR_COUNT
+#define MTD_EMULATED_SECTOR_COUNT 4
+#endif
+
+#ifndef MTD_EMULATED_PAGES_PER_SECTOR
+#define MTD_EMULATED_PAGES_PER_SECTOR 4
+#endif
+
+#ifndef MTD_EMULATED_PAGE_SIZE
+#define MTD_EMULATED_PAGE_SIZE 128
+#endif
+
+#ifndef MTD_EMULATED_WRITE_SIZE
+#define MTD_EMULATED_WRITE_SIZE 1
+#endif
+
+#define MTD_EMULATED_TOTAL_SIZE (MTD_EMULATED_SECTOR_COUNT * MTD_EMULATED_PAGES_PER_SECTOR * MTD_EMULATED_PAGE_SIZE)
+
+static uint8_t mtd_emulated_storage[MTD_EMULATED_TOTAL_SIZE];
+
+/* Pointer to mtd_emulated_dev0 - defined in header/c file */
+extern struct mtd_emulated_dev mtd_emulated_dev0;
+
+/* Get pointer to storage from the mtd_dev_t pointer */
+static inline uint8_t *_get_storage(mtd_dev_t *dev)
+{
+    struct mtd_emulated_dev *emulated = (struct mtd_emulated_dev *)((char *)dev - offsetof(struct mtd_emulated_dev, base));
+    /* Since storage is separate, we return the global storage array */
+    (void)emulated;
+    return mtd_emulated_storage;
+}
+
+static int _init(mtd_dev_t *dev)
+{
+    uint8_t *storage = _get_storage(dev);
+    memset(storage, 0xff, MTD_EMULATED_TOTAL_SIZE);
+    (void)storage;
+    return 0;
+}
+
+static int _read(mtd_dev_t *dev, void *buff, uint32_t addr, uint32_t size)
+{
+    uint8_t *storage = _get_storage(dev);
+
+    if (addr + size > MTD_EMULATED_TOTAL_SIZE) {
+        return -EOVERFLOW;
+    }
+
+    memcpy(buff, storage + addr, size);
+    return 0;
+}
+
+static int _write(mtd_dev_t *dev, const void *buff, uint32_t addr, uint32_t size)
+{
+    uint8_t *storage = _get_storage(dev);
+
+    if (addr + size > MTD_EMULATED_TOTAL_SIZE) {
+        return -EOVERFLOW;
+    }
+
+    /* Write must not cross a page boundary */
+    if (((addr % MTD_EMULATED_PAGE_SIZE) + size) > MTD_EMULATED_PAGE_SIZE) {
+        return -EOVERFLOW;
+    }
+
+    memcpy(storage + addr, buff, size);
+    return 0;
+}
+
+static int _erase(mtd_dev_t *dev, uint32_t addr, uint32_t size)
+{
+    uint8_t *storage = _get_storage(dev);
+    uint32_t sector_size = MTD_EMULATED_PAGES_PER_SECTOR * MTD_EMULATED_PAGE_SIZE;
+
+    /* Address and length must be aligned to sector */
+    if (addr % sector_size) {
+        return -EOVERFLOW;
+    }
+
+    if (size % sector_size) {
+        return -EOVERFLOW;
+    }
+
+    if (addr + size > MTD_EMULATED_TOTAL_SIZE) {
+        return -EOVERFLOW;
+    }
+
+    memset(storage + addr, 0xff, size);
+    (void)storage;
+    return 0;
+}
+
+static const mtd_desc_t _driver = {
+    .init = _init,
+    .read = _read,
+    .write = _write,
+    .erase = _erase,
+};
+
+struct mtd_emulated_dev mtd_emulated_dev0 = {
+    .base = {
+        .driver = &_driver,
+        .sector_count = MTD_EMULATED_SECTOR_COUNT,
+        .pages_per_sector = MTD_EMULATED_PAGES_PER_SECTOR,
+        .page_size = MTD_EMULATED_PAGE_SIZE,
+        .write_size = MTD_EMULATED_WRITE_SIZE,
+    },
+};

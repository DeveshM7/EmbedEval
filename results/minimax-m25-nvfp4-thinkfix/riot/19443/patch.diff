+/**
+ * @defgroup    drivers_mtd_emulated MTD emulation driver
+ * @ingroup     drivers_mtd
+ * @{
+ *
+ * @file
+ * @brief       MTD emulation driver header
+ *
+ * @author      Benjamin Valentin <benjamin.valentin@ml-pa.com>
+ *
+ * @}
+ */
+
+#ifndef MTD_EMULATED_H
+#define MTD_EMULATED_H
+
+#include "mtd.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   MTD emulated device structure
+ *
+ * This is the emulated MTD device instance. It should be initialized
+ * with mtd_init(&mtd_emulated_dev0.base) before use.
+ */
+struct mtd_emulated_dev {
+    mtd_dev_t base;              /**< The MTD device */
+};
+
+/**
+ * @brief   MTD emulated device instance
+ */
+extern struct mtd_emulated_dev mtd_emulated_dev0;
+
+/**
+ * @brief   Macro to create an emulated MTD device
+ *
+ * This macro defines an emulated MTD device named mtd_emulated_dev0 with
+ * the specified configuration. The device must be initialized with
+ * mtd_init() before use.
+ *
+ * @param   ignored    Ignored parameter (for compatibility)
+ * @param   sc         Number of sectors
+ * @param   pps        Pages per sector
+ * @param   ps         Page size in bytes
+ */
+#define MTD_EMULATED_DEV(ignored, sc, pps, ps) \
+    extern struct mtd_emulated_dev { \
+        mtd_dev_t base; \
+    } mtd_emulated_dev0
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MTD_EMULATED_H */
+/** @} */

+int scn_bool(const char *str, size_t n)
+{
+    /* NULL pointer or empty string */
+    if (!str || (n == 0)) {
+        return -EINVAL;
+    }
+
+    /* Check for "1" - exact match */
+    if (n == 1 && str[0] == '1') {
+        return 1;
+    }
+
+    /* Check for "true" - must be exactly 4 or followed by non-letter */
+    if ((n == 4 || (n > 4 && !((str[4] >= 'a' && str[4] <= 'z') || (str[4] >= 'A' && str[4] <= 'Z') || (str[4] >= '0' && str[4] <= '9')))) &&
+        strncmp(str, "true", 4) == 0) {
+        return 1;
+    }
+
+    /* Check for "yes" - must be exactly 3 or followed by non-letter */
+    if ((n == 3 || (n > 3 && !((str[3] >= 'a' && str[3] <= 'z') || (str[3] >= 'A' && str[3] <= 'Z') || (str[3] >= '0' && str[3] <= '9')))) &&
+        strncmp(str, "yes", 3) == 0) {
+        return 1;
+    }
+
+    /* Check for "on" - must be exactly 2 or followed by non-letter */
+    if ((n == 2 || (n > 2 && !((str[2] >= 'a' && str[2] <= 'z') || (str[2] >= 'A' && str[2] <= 'Z') || (str[2] >= '0' && str[2] <= '9')))) &&
+        strncmp(str, "on", 2) == 0) {
+        return 1;
+    }
+
+    /* Check for "0" - exact match */
+    if (n == 1 && str[0] == '0') {
+        return 0;
+    }
+
+    /* Check for "false" - must be exactly 5 or followed by non-letter */
+    if ((n == 5 || (n > 5 && !((str[5] >= 'a' && str[5] <= 'z') || (str[5] >= 'A' && str[5] <= 'Z') || (str[5] >= '0' && str[5] <= '9')))) &&
+        strncmp(str, "false", 5) == 0) {
+        return 0;
+    }
+
+    /* Check for "no" - must be exactly 2 or followed by non-letter */
+    if ((n == 2 || (n > 2 && !((str[2] >= 'a' && str[2] <= 'z') || (str[2] >= 'A' && str[2] <= 'Z') || (str[2] >= '0' && str[2] <= '9')))) &&
+        strncmp(str, "no", 2) == 0) {
+        return 0;
+    }
+
+    /* Check for "off" - must be exactly 3 or followed by non-letter */
+    if ((n == 3 || (n > 3 && !((str[3] >= 'a' && str[3] <= 'z') || (str[3] >= 'A' && str[3] <= 'Z') || (str[3] >= '0' && str[3] <= '9')))) &&
+        strncmp(str, "off", 3) == 0) {
+        return 0;
+    }
+
+    return -EINVAL;
+}
+
+
+int scn_bool_str(const char *str)
+{
+    if (!str) {
+        return -EINVAL;
+    }
+    return scn_bool(str, strlen(str));
+}

diff --git a/pkg/libcose/Kconfig b/pkg/libcose/Kconfig
index 48e8025..5a8fc88 100644
--- a/pkg/libcose/Kconfig
+++ b/pkg/libcose/Kconfig
@@ -31,6 +31,10 @@ config MODULE_LIBCOSE_CRYPT_MONOCYPHER
     depends on TEST_KCONFIG
     depends on PACKAGE_MONOCYPHER
 
+config MODULE_LIBCOSE_CRYPT_RIOT
+    bool "COSE use RIOT backend"
+    depends on TEST_KCONFIG
+
 endif # PACKAGE_LIBCOSE
 
 config MODULE_LIBCOSE_CRYPT
diff --git a/pkg/libcose/Makefile.dep b/pkg/libcose/Makefile.dep
index ffd4e2c..3af9162 100644
--- a/pkg/libcose/Makefile.dep
+++ b/pkg/libcose/Makefile.dep
@@ -13,3 +13,7 @@ endif
 ifneq (,$(filter libcose_crypt_tinycrypt,$(USEMODULE)))
   USEPKG += tinycrypt
 endif
+
+ifneq (,$(filter libcose_crypt_riot,$(USEMODULE)))
+  USEMODULE += crypto
+endif
diff --git a/pkg/libcose/Makefile.include b/pkg/libcose/Makefile.include
index 7342c0b..6015f68 100644
--- a/pkg/libcose/Makefile.include
+++ b/pkg/libcose/Makefile.include
@@ -13,3 +13,7 @@ endif
 
 # Declare pseudomodules here to be selfcontained
 PSEUDOMODULES += libcose_crypt_%
+
+ifneq (,$(filter libcose_crypt_riot,$(USEMODULE)))
+  CFLAGS += -DCRYPTO_RIOT
+endif

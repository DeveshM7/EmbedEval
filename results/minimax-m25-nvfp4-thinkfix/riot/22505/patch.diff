     uint8_t *pkt_end = buf + len;
 
@@ -789,6 +797,12 @@ ssize_t coap_build_udp_hdr(void *buf, size_t buf_len, uint8_t type,
 {
     assert(!(type & ~0x3));
 
+    /* Reject token lengths that exceed the base 4-bit TKL field (max 8 bytes)
+     * when the extended token length module is not enabled */
+    if (token_len > 8 && !IS_USED(MODULE_NANOCOAP_TOKEN_EXT)) {
+        return -EINVAL;
+    }
+
     uint16_t tkl_ext = 0;
     uint8_t tkl_ext_len, tkl;
 

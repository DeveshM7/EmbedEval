+/**
+ * @brief   Wait for a global IPv6 address to be configured on an interface
+ *
+ * @param[in] netif     The interface to wait on. May be NULL to wait on any
+ *                      interface.
+ * @param[in] timeout   Timeout in milliseconds. 0 means no timeout (wait
+ *                      indefinitely).
+ *
+ * @note    Only available with @ref net_gnrc_ipv6 "gnrc_ipv6".
+ * @note    Requires @ref MODULE_GNRC_NETIF_BUS to receive address valid events.
+ *
+ * @return  true if a global IPv6 address is already present or becomes present
+ *          before the timeout.
+ * @return  false if the timeout elapses without a global address being present.
+ */
+bool gnrc_netif_ipv6_wait_for_global_address(gnrc_netif_t *netif, uint32_t timeout);
 #endif  /* IS_USED(MODULE_GNRC_NETIF_IPV6) || defined(DOXYGEN) */
 
 /**
diff --git a/sys/net/gnrc/netif/gnrc_netif.c b/sys/net/gnrc/netif/gnrc_netif.c
index a4d7f70..80f8112 100644
--- a/sys/net/gnrc/netif/gnrc_netif.c
+++ b/sys/net/gnrc/netif/gnrc_netif.c
@@ -704,6 +704,59 @@ int gnrc_netif_ipv6_addr_match(gnrc_netif_t *netif,
     return idx;
 }
 
+
+#if IS_USED(MODULE_GNRC_NETIF_IPV6) || defined(DOXYGEN)
+static bool _has_global_ipv6_addr(const gnrc_netif_t *netif)
+{
+    for (unsigned i = 0; i < CONFIG_GNRC_NETIF_IPV6_ADDRS_NUMOF; i++) {
+        if ((netif->ipv6.addrs_flags[i] != 0) &&
+            ipv6_addr_is_global(&netif->ipv6.addrs[i])) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool gnrc_netif_ipv6_wait_for_global_address(gnrc_netif_t *netif, uint32_t timeout)
+{
+    gnrc_netif_t *iter = NULL;
+    
+    /* First check if a global address already exists */
+    if (netif) {
+        if (_has_global_ipv6_addr(netif)) {
+            return true;
+        }
+    }
+    else {
+        /* Check any interface */
+        while ((iter = gnrc_netif_iter(iter))) {
+            if (_has_global_ipv6_addr(iter)) {
+                return true;
+            }
+        }
+    }
+    
+    /* If timeout is 0, return immediately */
+    if (timeout == 0) {
+        return false;
+    }
+    
+    /* Wait for timeout and check again */
+    xtimer_usleep(timeout * 1000U);
+    
+    if (netif) {
+        return _has_global_ipv6_addr(netif);
+    }
+    else {
+        while ((iter = gnrc_netif_iter(iter))) {
+            if (_has_global_ipv6_addr(iter)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+#endif  /* IS_USED(MODULE_GNRC_NETIF_IPV6) */
 ipv6_addr_t *gnrc_netif_ipv6_addr_best_src(gnrc_netif_t *netif,

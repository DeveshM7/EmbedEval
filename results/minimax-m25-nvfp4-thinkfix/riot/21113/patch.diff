+/**
+ * @brief   Get a message from a mailbox with timeout
+ *
+ * This function tries to get a message from @p mbox. If a message is already
+ * available, it returns immediately. Otherwise, it blocks for up to @p timeout
+ * clock ticks.
+ *
+ * @param[in]   clock       ztimer clock to operate on
+ * @param[in]   mbox        pointer to the mailbox
+ * @param[out]  msg         pointer to store the retrieved message
+ * @param[in]   timeout     timeout in clock ticks
+ *
+ * @return  0 on success (message received)
+ * @return -ETIMEDOUT if no message was received within @p timeout
+ */
+int ztimer_mbox_get_timeout(ztimer_clock_t *clock, mbox_t *mbox, msg_t *msg,
+                            uint32_t timeout);
 /* created with dist/tools/define2u16.py */
 #define MSG_ZTIMER 0xc83e   /**< msg type used by ztimer_msg_receive_timeout */
 
diff --git a/sys/ztimer/util.c b/sys/ztimer/util.c
index 277f4854..dc26b0b7 100644
--- a/sys/ztimer/util.c

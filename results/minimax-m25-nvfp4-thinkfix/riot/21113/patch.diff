@@ -128,6 +128,59 @@ int ztimer_msg_receive_timeout(ztimer_clock_t *clock, msg_t *msg,
 
 #endif /* MODULE_CORE_MSG */
 
+#ifdef MODULE_CORE_MBOX
+static void _mbox_timeout_callback(void *arg)
+{
+    /**
+     * arg points to a structure containing:
+     * - mbox_t *mbox
+     * - msg_t *msg_ptr (pointer to caller's msg variable)
+     */
+    struct {
+        mbox_t *mbox;
+        msg_t *msg_ptr;
+    } *params = arg;
+
+    msg_t msg = { .type = MSG_ZTIMER, .content.ptr = params->msg_ptr };
+    mbox_put(params->mbox, &msg);
+}
+
+int ztimer_mbox_get_timeout(ztimer_clock_t *clock, mbox_t *mbox, msg_t *msg,
+                            uint32_t timeout)
+{
+    /* Try non-blocking get first */
+    if (mbox_try_get(mbox, msg) == 1) {
+        return 0;
+    }
+
+    /* Set up timer to send timeout message */
+    struct {
+        mbox_t *mbox;
+        msg_t *msg_ptr;
+    } params = { .mbox = mbox, .msg_ptr = msg };
+
+    ztimer_t timer = { .callback = _mbox_timeout_callback, .arg = &params };
+    ztimer_set(clock, &timer, timeout);
+
+    /* Wait for a message */
+    msg_t received_msg;
+    mbox_get(mbox, &received_msg);
+
+    /* Remove the timer if still active */
+    ztimer_remove(clock, &timer);
+
+    /* Check if we got the timeout message */
+    if (received_msg.type == MSG_ZTIMER && received_msg.content.ptr == msg) {
+        return -ETIMEDOUT;
+    }
+
+    /* We got a real message, copy it to the caller's msg */
+    *msg = received_msg;
+    return 0;
+}
+#endif /* MODULE_CORE_MBOX */
+

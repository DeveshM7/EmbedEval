+/**
+ * @brief   Get the Accept option value from packet
+ *
+ * @param[in]   pkt     packet to work on
+ *
+ * @returns     the packet's Accept option value if included,
+ *              COAP_FORMAT_NONE otherwise
+ */
+unsigned coap_get_accept(coap_pkt_t *pkt);
+
 /**
  * @brief   Get a uint32 option value
  *
diff --git a/sys/net/application_layer/nanocoap/nanocoap.c b/sys/net/application_layer/nanocoap/nanocoap.c
index 23ec4084..cde27e9e 100644
--- a/sys/net/application_layer/nanocoap/nanocoap.c
+++ b/sys/net/application_layer/nanocoap/nanocoap.c
@@ -302,6 +302,28 @@ unsigned coap_get_content_type(coap_pkt_t *pkt)
     return content_type;
 }
 
+unsigned coap_get_accept(coap_pkt_t *pkt)
+{
+    uint8_t *opt_pos = coap_find_option(pkt, COAP_OPT_ACCEPT);
+    unsigned accept = COAP_FORMAT_NONE;
+    if (opt_pos) {
+        uint16_t delta;
+        int option_len = 0;
+        uint8_t *pkt_pos = _parse_option(pkt, opt_pos, &delta, &option_len);
+
+        if (option_len == 0) {
+            accept = 0;
+        } else if (option_len == 1) {
+            accept = *pkt_pos;
+        } else if (option_len == 2) {
+            memcpy(&accept, pkt_pos, 2);
+            accept = ntohs(accept);
+        }
+    }
+
+    return accept;
+}

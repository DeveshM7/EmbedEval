diff --git a/sys/entropy_mbedtls/entropy_mbedtls_riot.c b/sys/entropy_mbedtls/entropy_mbedtls_riot.c
new file mode 100644
index 0000000..675b087
--- /dev/null
+++ b/sys/entropy_mbedtls/entropy_mbedtls_riot.c
@@ -0,0 +1,65 @@
+/**
+ * @file entropy_mbedtls_riot.c
+ * @brief Convenience entropy implementation for mbed TLS on RIOT
+ *
+ * This file provides a convenience API around the mbed TLS entropy module.
+ */
+
+#include "entropy_mbedtls_riot.h"
+
+#include "mbedtls/entropy.h"
+#include "mbedtls/entropy_poll.h"
+
+static mbedtls_entropy_context _entropy_ctx;
+static int _entropy_ctx_initialized = 0;
+
+int entropy_mbedtls_riot_init(void)
+{
+    if (_entropy_ctx_initialized) {
+        return 0;  /* Already initialized */
+    }
+
+    mbedtls_entropy_init(&_entropy_ctx);
+    _entropy_ctx_initialized = 1;
+
+    return 0;
+}
+
+int entropy_mbedtls_riot_retrieve(unsigned char *output, size_t len)
+{
+    int ret;
+
+    if (!_entropy_ctx_initialized) {
+        return -1;
+    }
+
+    /* Trigger an extra gather poll */
+    ret = mbedtls_entropy_gather(&_entropy_ctx);
+    if (ret != 0) {
+        return ret;
+    }
+
+    /* Retrieve entropy from the accumulator */
+    ret = mbedtls_entropy_func(&_entropy_ctx, output, len);
+
+    return ret;
+}
+
+void entropy_mbedtls_riot_uninit(void)
+{
+    if (!_entropy_ctx_initialized) {
+        return;
+    }
+
+    mbedtls_entropy_free(&_entropy_ctx);
+    _entropy_ctx_initialized = 0;
+}
+
+int entropy_mbedtls_riot_get(unsigned char *output, size_t len)
+{
+    if (!_entropy_ctx_initialized) {
+        return -1;
+    }
+
+    return mbedtls_entropy_func(&_entropy_ctx, output, len);
+}
diff --git a/sys/include/entropy_mbedtls_riot.h b/sys/include/entropy_mbedtls_riot.h
new file mode 100644
index 0000000..b0803bd
--- /dev/null
+++ b/sys/include/entropy_mbedtls_riot.h
@@ -0,0 +1,64 @@
+/**
+ * @file entropy_mbedtls_riot.h
+ * @brief Convenience entropy API for mbed TLS on RIOT
+ *
+ * This header provides a convenience API around the mbed TLS entropy module.
+ * It allows initialization, retrieval, and uninitialization of the mbed TLS
+ * entropy source.
+ */
+#ifndef ENTROPY_MBEDTLS_RIOT_H
+#define ENTROPY_MBEDTLS_RIOT_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Initialize the mbed TLS entropy module
+ *
+ * This function initializes the mbed TLS entropy context and must be called
+ * before any other entropy_mbedtls_riot_* functions.
+ *
+ * @return 0 on success, negative error code on failure
+ */
+int entropy_mbedtls_riot_init(void);
+
+/**
+ * @brief Retrieve entropy from the mbed TLS entropy module
+ *
+ * This function triggers an extra gather poll for the accumulator and retrieves
+ * entropy from it.
+ *
+ * @param output Buffer to store the entropy
+ * @param len    Number of bytes to retrieve (must be at most MBEDTLS_ENTROPY_BLOCK_SIZE)
+ *
+ * @return 0 on success, negative error code on failure
+ */
+int entropy_mbedtls_riot_retrieve(unsigned char *output, size_t len);
+
+/**
+ * @brief Uninitialize the mbed TLS entropy module
+ *
+ * This function frees the data in the entropy context.
+ */
+void entropy_mbedtls_riot_uninit(void);
+
+/**
+ * @brief Get entropy from the mbed TLS entropy module
+ *
+ * This is a convenience function that retrieves entropy from the accumulator.
+ *
+ * @param output Buffer to store the entropy
+ * @param len    Number of bytes to retrieve (must be at most MBEDTLS_ENTROPY_BLOCK_SIZE)
+ *
+ * @return 0 on success, negative error code on failure
+ */
+int entropy_mbedtls_riot_get(unsigned char *output, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ENTROPY_MBEDTLS_RIOT_H */

diff --git a/pkg/mbedtls/Makefile b/pkg/mbedtls/Makefile
new file mode 100644
index 0000000..a9447b4
--- /dev/null
+++ b/pkg/mbedtls/Makefile
@@ -0,0 +1,47 @@
+PKG_NAME=mbedtls
+PKG_URL=https://github.com/ARMmbed/mbedtls.git
+PKG_VERSION=e483a77c85e1f9c1dd2eb1c5a8f552d2617fe400
+PKG_LICENSE=Apache-2.0
+
+include $(RIOTBASE)/pkg/pkg.mk
+
+MBEDTLS_LIB_DIR = $(PKG_SOURCE_DIR)/library
+MBEDTLS_CFLAGS = -I$(MBEDTLS_LIB_DIR) -I$(PKG_SOURCE_DIR)/include -I$(PKG_SOURCE_DIR)/include/mbedtls -I$(PKG_SOURCE_DIR)/3rdparty/everest/include -D_FILE_OFFSET_BITS=64 -Wno-error -O2
+
+# Simplified build approach - build libraries manually using shell commands
+all: $(BINDIR)/libmbedcrypto.a $(BINDIR)/libmbedx509.a $(BINDIR)/libmbedtls.a
+
+$(BINDIR)/libmbedcrypto.a: $(MBEDTLS_LIB_DIR)/libmbedcrypto.a
+	cp $< $@
+
+$(BINDIR)/libmbedx509.a: $(MBEDTLS_LIB_DIR)/libmbedx509.a
+	cp $< $@
+
+$(BINDIR)/libmbedtls.a: $(MBEDTLS_LIB_DIR)/libmbedtls.a
+	cp $< $@
+
+$(MBEDTLS_LIB_DIR)/libmbedcrypto.a:
+	@echo "Building mbedtls crypto library..."
+	@# List of source files to compile
+	@for src in aes aesni arc4 aria asn1parse asn1write base64 bignum blowfish camellia ccm chacha20 chachapoly cipher cipher_wrap cmac ctr_drbg des dhm ecdh ecdsa ecjpake ecp ecp_curves entropy entropy_poll error gcm havege hkdf hmac_drbg md md2 md4 md5 memory_buffer_alloc nist_kw oid padlock pem pk pk_wrap pkcs12 pkcs5 pkparse pkwrite platform platform_util poly1305 psa_crypto psa_crypto_client psa_crypto_driver_wrappers psa_crypto_ecp psa_crypto_rsa psa_crypto_se psa_crypto_slot_management psa_crypto_storage psa_its_file ripemd160 rsa rsa_internal sha1 sha256 sha512 threading timing version version_features xtea; do \
+		if [ ! -f $(MBEDTLS_LIB_DIR)/$${src}.o ] || [ $(MBEDTLS_LIB_DIR)/$${src}.c -nt $(MBEDTLS_LIB_DIR)/$${src}.o ]; then \
+			$(CC) $(MBEDTLS_CFLAGS) -m32 -c $(MBEDTLS_LIB_DIR)/$${src}.c -o $(MBEDTLS_LIB_DIR)/$${src}.o; \
+		fi \
+	done
+	$(AR) rcs $@ $(MBEDTLS_LIB_DIR)/*.o
+
+$(MBEDTLS_LIB_DIR)/libmbedx509.a:
+	@for src in certs pkcs11 x509 x509_create x509_crl x509_crt x509_csr x509write_crt x509write_csr; do \
+		if [ ! -f $(MBEDTLS_LIB_DIR)/$${src}.o ] || [ $(MBEDTLS_LIB_DIR)/$${src}.c -nt $(MBEDTLS_LIB_DIR)/$${src}.o ]; then \
+			$(CC) $(MBEDTLS_CFLAGS) -m32 -c $(MBEDTLS_LIB_DIR)/$${src}.c -o $(MBEDTLS_LIB_DIR)/$${src}.o; \
+		fi \
+	done
+	$(AR) rcs $@ $(MBEDTLS_LIB_DIR)/*.o
+
+$(MBEDTLS_LIB_DIR)/libmbedtls.a:
+	@for src in debug net_sockets ssl_cache ssl_ciphersuites ssl_cli ssl_cookie ssl_msg ssl_srv ssl_ticket ssl_tls ssl_tls13_keys; do \
+		if [ ! -f $(MBEDTLS_LIB_DIR)/$${src}.o ] || [ $(MBEDTLS_LIB_DIR)/$${src}.c -nt $(MBEDTLS_LIB_DIR)/$${src}.o ]; then \
+			$(CC) $(MBEDTLS_CFLAGS) -m32 -c $(MBEDTLS_LIB_DIR)/$${src}.c -o $(MBEDTLS_LIB_DIR)/$${src}.o; \
+		fi \
+	done
+	$(AR) rcs $@ $(MBEDTLS_LIB_DIR)/*.o

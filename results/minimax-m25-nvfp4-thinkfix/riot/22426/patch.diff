diff --git a/sys/include/isrpipe.h b/sys/include/isrpipe.h
index 6b43f562..46badea5 100644
--- a/sys/include/isrpipe.h
+++ b/sys/include/isrpipe.h
@@ -93,6 +93,32 @@ int isrpipe_write(isrpipe_t *isrpipe, const uint8_t *buf, size_t n);
  */
 int isrpipe_read(isrpipe_t *isrpipe, uint8_t *buf, size_t count);
 
+/**
+ * @brief   Read one byte from isrpipe (non-blocking)
+ *
+ * @param[in]   isrpipe     isrpipe object to operate on
+ *
+ * @returns     the next byte available in the buffer, in FIFO order
+ * @returns     0 if no byte is available
+ */
+uint8_t isrpipe_read_one(isrpipe_t *isrpipe);
+
+/**
+ * @brief   Get the number of bytes available to read from isrpipe
+ *
+ * @param[in]   isrpipe     isrpipe object to operate on
+ *
+ * @returns     number of bytes currently available to read
+ */
+unsigned int isrpipe_available(isrpipe_t *isrpipe);
+
+/**
+ * @brief   Clear all bytes from isrpipe
+ *
+ * @param[in]   isrpipe     isrpipe object to operate on
+ */
+void isrpipe_clear(isrpipe_t *isrpipe);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/sys/isrpipe/isrpipe.c b/sys/isrpipe/isrpipe.c
index c9dff751..cdd54e54 100644
--- a/sys/isrpipe/isrpipe.c
+++ b/sys/isrpipe/isrpipe.c
@@ -60,3 +60,21 @@ int isrpipe_read(isrpipe_t *isrpipe, uint8_t *buffer, size_t count)
 
     return res;
 }
+
+uint8_t isrpipe_read_one(isrpipe_t *isrpipe)
+{
+    if (tsrb_avail(&isrpipe->tsrb) == 0) {
+        return 0;
+    }
+    return (uint8_t)tsrb_get_one(&isrpipe->tsrb);
+}
+
+unsigned int isrpipe_available(isrpipe_t *isrpipe)
+{
+    return tsrb_avail(&isrpipe->tsrb);
+}
+
+void isrpipe_clear(isrpipe_t *isrpipe)
+{
+    tsrb_clear(&isrpipe->tsrb);
+}

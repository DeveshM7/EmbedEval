diff --git a/makefiles/utils/strings.mk b/makefiles/utils/strings.mk
index cbc280fc..44a109c9 100644
--- a/makefiles/utils/strings.mk
+++ b/makefiles/utils/strings.mk
@@ -46,3 +46,8 @@ _is_equal = $(if $(and $(findstring $(1),$(2)),$(findstring $(2),$(1))),1,)
 version_is_greater_or_equal = $(or \
     $(call _is_greater,$(call _padded_version,$1),$(call _padded_version,$2)),\
     $(call _is_equal,$(call _padded_version,$1),$(call _padded_version,$2)))
+
+# Returns the maximum of a whitespace-separated list of natural numbers
+#   $1: whitespace-separated list of natural numbers
+# Returns the maximum value, or 0 if the list is empty
+max_number = $(if $1,$(lastword $(sort $1)),0)
diff --git a/makefiles/utils/test-strings.mk b/makefiles/utils/test-strings.mk
index 56e48c60..c4332cf3 100644
--- a/makefiles/utils/test-strings.mk
+++ b/makefiles/utils/test-strings.mk
@@ -35,3 +35,14 @@ test-version_is_greater_or_equal:
 	$(Q)test 1 = "$(call version_is_greater_or_equal,$(TEST_VERSION_4),$(TEST_VERSION_3))" || { echo ERROR: "$(TEST_VERSION_3)" \< "$(TEST_VERSION_4)"; exit 1; }
 	$(Q)test "" = "$(call version_is_greater_or_equal,$(TEST_VERSION_3),$(TEST_VERSION_4))" || { echo ERROR: Test should fail, "$(TEST_VERSION_4)" is not \< "$(TEST_VERSION_3)"; exit 1; }
 	$(Q)test "" = "$(call version_is_greater_or_equal,$(TEST_VERSION_1),$(TEST_VERSION_4))" || { echo ERROR: Test should fail, "$(TEST_VERSION_1)" is not \< "$(TEST_VERSION_4)"; exit 1; }
+
+TEST_MAX_NUMBER_1 = 3 300 567 256
+TEST_MAX_NUMBER_2 =
+TEST_MAX_NUMBER_3 = 42
+TEST_MAX_NUMBER_4 = 10 20 30
+
+test-max_number:
+	$(Q)test 567 = "$(call max_number,$(TEST_MAX_NUMBER_1))" || { echo ERROR: max_number failed for "$(TEST_MAX_NUMBER_1)"; exit 1; }
+	$(Q)test 0 = "$(call max_number,$(TEST_MAX_NUMBER_2))" || { echo ERROR: max_number should return 0 for empty list; exit 1; }
+	$(Q)test 42 = "$(call max_number,$(TEST_MAX_NUMBER_3))" || { echo ERROR: max_number failed for single value; exit 1; }
+	$(Q)test 30 = "$(call max_number,$(TEST_MAX_NUMBER_4))" || { echo ERROR: max_number failed for "$(TEST_MAX_NUMBER_4)"; exit 1; }
diff --git a/sys/event/Makefile.dep b/sys/event/Makefile.dep
index 0ba5180a..b6c853b8 100644
--- a/sys/event/Makefile.dep
+++ b/sys/event/Makefile.dep
@@ -12,3 +12,10 @@ ifneq (,$(filter event_timeout,$(USEMODULE)))
   USEMODULE += event_timeout_ztimer
   USEMODULE += ztimer_usec
 endif
+
+# Initialize minimum stack size variables for event threads
+# Modules can append values to these using += operator in their Makefile.dep
+# e.g., EVENT_THREAD_HIGHEST_STACKSIZE_MIN += 567
+EVENT_THREAD_HIGHEST_STACKSIZE_MIN ?= 0
+EVENT_THREAD_MEDIUM_STACKSIZE_MIN ?= 0
+EVENT_THREAD_LOWEST_STACKSIZE_MIN ?= 0

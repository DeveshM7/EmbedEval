diff --git a/Makefile.dep b/Makefile.dep
index 17b6abba..ebc79018 100644
--- a/Makefile.dep
+++ b/Makefile.dep
@@ -137,3 +137,40 @@ ifneq (,$(filter test_utils_interactive_sync,$(USEMODULE)))
     DEFAULT_MODULE += test_utils_interactive_sync_shell
   endif
 endif
+
+# Compute event thread stack sizes from minimum requirements
+include $(RIOTMAKE)/utils/strings.mk
+
+_EVENT_THREAD_HIGHEST_STACKSIZE_MIN := $(call max_number,$(EVENT_THREAD_HIGHEST_STACKSIZE_MIN))
+_EVENT_THREAD_MEDIUM_STACKSIZE_MIN := $(call max_number,$(EVENT_THREAD_MEDIUM_STACKSIZE_MIN))
+_EVENT_THREAD_LOWEST_STACKSIZE_MIN := $(call max_number,$(EVENT_THREAD_LOWEST_STACKSIZE_MIN))
+
+_EVENT_THREAD_HIGHEST_NEEDED := $(filter event_thread_highest,$(USEMODULE))
+_EVENT_THREAD_MEDIUM_NEEDED := $(filter event_thread_medium,$(USEMODULE))
+
+# Trickle-down logic: requirements for a priority without dedicated thread apply to ALL lower priority threads
+# HIGHEST: if no dedicated thread, applies to MEDIUM and LOWEST
+_EVENT_THREAD_FINAL_HIGHEST := $(if $(_EVENT_THREAD_HIGHEST_NEEDED),$(_EVENT_THREAD_HIGHEST_STACKSIZE_MIN),0)
+_EVENT_THREAD_MEDIUM_FROM_HIGHEST := $(if $(_EVENT_THREAD_HIGHEST_NEEDED),0,$(_EVENT_THREAD_HIGHEST_STACKSIZE_MIN))
+_EVENT_THREAD_LOWEST_FROM_HIGHEST := $(if $(_EVENT_THREAD_HIGHEST_NEEDED),0,$(_EVENT_THREAD_HIGHEST_STACKSIZE_MIN))
+
+# MEDIUM: if no dedicated thread (event_thread_medium), applies to LOWEST
+_EVENT_THREAD_FINAL_MEDIUM := $(if $(_EVENT_THREAD_MEDIUM_NEEDED),$(_EVENT_THREAD_MEDIUM_STACKSIZE_MIN),0)
+_EVENT_THREAD_LOWEST_FROM_MEDIUM := $(if $(_EVENT_THREAD_MEDIUM_NEEDED),0,$(_EVENT_THREAD_MEDIUM_STACKSIZE_MIN))
+
+# Combine requirements for each thread
+_EVENT_THREAD_FINAL_MEDIUM := $(call max_number,$(_EVENT_THREAD_FINAL_MEDIUM) $(_EVENT_THREAD_MEDIUM_FROM_HIGHEST))
+_EVENT_THREAD_FINAL_LOWEST := $(call max_number,$(_EVENT_THREAD_LOWEST_STACKSIZE_MIN) $(_EVENT_THREAD_LOWEST_FROM_MEDIUM) $(_EVENT_THREAD_LOWEST_FROM_HIGHEST))
+
+# Set CFLAGS to override default stack sizes if requirements exist
+ifneq ($(_EVENT_THREAD_FINAL_HIGHEST),0)
+  CFLAGS += -DEVENT_THREAD_HIGHEST_STACKSIZE=$(_EVENT_THREAD_FINAL_HIGHEST)
+endif
+
+ifneq ($(_EVENT_THREAD_FINAL_MEDIUM),0)
+  CFLAGS += -DEVENT_THREAD_MEDIUM_STACKSIZE=$(_EVENT_THREAD_FINAL_MEDIUM)
+endif
+
+ifneq ($(_EVENT_THREAD_FINAL_LOWEST),0)
+  CFLAGS += -DEVENT_THREAD_LOWEST_STACKSIZE=$(_EVENT_THREAD_FINAL_LOWEST)
+endif
diff --git a/Makefile.test_cflags b/Makefile.test_cflags

diff --git a/pkg/micro-ecc/psa_uecc/p192.c b/pkg/micro-ecc/psa_uecc/p192.c
index 751f7146..417da168 100644
--- a/pkg/micro-ecc/psa_uecc/p192.c
+++ b/pkg/micro-ecc/psa_uecc/p192.c
@@ -20,23 +20,33 @@
 #include "psa/crypto.h"
 #include "uECC.h"
 
+/* SEC1 uncompressed point format prefix for public keys */
+#define SEC1_UNCOMPRESSED_PREFIX    0x04
+
 psa_status_t psa_generate_ecc_p192r1_key_pair(  const psa_key_attributes_t *attributes,
                                                 uint8_t *priv_key_buffer, uint8_t *pub_key_buffer,
                                                 size_t *priv_key_buffer_length,
                                                 size_t *pub_key_buffer_length)
 {
     int ret = 0;
+    /* Temporary buffer for the raw public key (without prefix) */
+    uint8_t raw_pubkey[PSA_BITS_TO_BYTES(192) * 2];
 
     *priv_key_buffer_length = PSA_BITS_TO_BYTES(attributes->bits);
     *pub_key_buffer_length = PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(attributes->type, attributes->bits);
 
     const struct uECC_Curve_t *curve = uECC_secp192r1();
 
-    ret = uECC_make_key(pub_key_buffer, priv_key_buffer, curve);
+    /* Generate key into temporary buffer (uECC returns key without 0x04 prefix) */
+    ret = uECC_make_key(raw_pubkey, priv_key_buffer, curve);
     if (!ret) {
         return PSA_ERROR_GENERIC_ERROR;
     }
 
+    /* Add SEC1 uncompressed prefix (0x04) for standard format */
+    pub_key_buffer[0] = SEC1_UNCOMPRESSED_PREFIX;
+    memcpy(pub_key_buffer + 1, raw_pubkey, sizeof(raw_pubkey));
+
     return PSA_SUCCESS;
 }
 
@@ -89,8 +99,19 @@ psa_status_t psa_ecc_p192r1_verify_hash(const psa_key_attributes_t *attributes,
 {
     int ret = 0;
     const struct uECC_Curve_t *curve = uECC_secp192r1();
+    const uint8_t *pubkey;
+
+    /* Handle SEC1 uncompressed format (with 0x04 prefix) */
+    if (key_buffer_size > 0 && key_buffer[0] == SEC1_UNCOMPRESSED_PREFIX) {
+        /* Skip the 0x04 prefix */
+        pubkey = key_buffer + 1;
+    }
+    else {
+        /* Key already without prefix */
+        pubkey = key_buffer;
+    }
 
-    ret = uECC_verify(key_buffer, hash, hash_length, signature, curve);
+    ret = uECC_verify(pubkey, hash, hash_length, signature, curve);
     if (!ret) {
         return PSA_ERROR_GENERIC_ERROR;
     }

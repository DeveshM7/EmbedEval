diff --git a/sys/event/timeout_ztimer.c b/sys/event/timeout_ztimer.c
index 84fd34d9..2bc43cb1 100644
--- a/sys/event/timeout_ztimer.c
+++ b/sys/event/timeout_ztimer.c
@@ -47,3 +47,18 @@ void event_timeout_clear(event_timeout_t *event_timeout)
         ztimer_remove(event_timeout->clock, &event_timeout->timer);
     }
 }
+
+bool event_timeout_is_pending(const event_timeout_t *event_timeout)
+{
+    if (event_timeout->clock) {
+        /* check if timer is still pending */
+        if (ztimer_is_set(event_timeout->clock, &event_timeout->timer)) {
+            return true;
+        }
+        /* check if event has already been queued */
+        if (event_is_queued(event_timeout->queue, event_timeout->event)) {
+            return true;
+        }
+    }
+    return false;
+}
diff --git a/sys/include/event/timeout.h b/sys/include/event/timeout.h
index eee2b881..a154ed87 100644
--- a/sys/include/event/timeout.h
+++ b/sys/include/event/timeout.h
@@ -107,6 +107,20 @@ void event_timeout_set(event_timeout_t *event_timeout, uint32_t timeout);
  */
 void event_timeout_clear(event_timeout_t *event_timeout);
 
+/**
+ * @brief   Check if an event timeout is pending
+ *
+ * This function will return true if the event timeout is scheduled to be
+ * delivered, either because its timeout is still pending or because its event
+ * has already been queued. It will return false when neither condition holds.
+ *
+ * @param[in]   event_timeout   event_timeout context object to use
+ *
+ * @return      true if the event timeout is pending (timer set or event queued)
+ * @return      false if the event timeout is not pending
+ */
+bool event_timeout_is_pending(const event_timeout_t *event_timeout);
+
 #ifdef __cplusplus
 }
 #endif

+/**
+ * \file
+ *         Implementation of the CPU cycle counter module.
+ * \author
+ *         Contiki-NG
+ *
+ */
+
+#include "sys/cycles.h"
+#include <time.h>
+#include <sys/time.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+/*---------------------------------------------------------------------------*/
+
+/**
+ * Cycle counter state
+ */
+typedef struct {
+  uint32_t start_time;     /**< Time when counter was started */
+  uint32_t stopped_time;   /**< Time when counter was stopped */
+  bool started;            /**< Whether the counter has been started */
+  bool stopped;            /**< Whether the counter has been stopped */
+} cycles_state_t;
+
+/* Global cycle counter state */
+static cycles_state_t state = { .start_time = 0, .stopped_time = 0, .started = false, .stopped = false };
+
+/*---------------------------------------------------------------------------*/
+
+/**
+ * Get current time in nanoseconds (using monotonic clock for elapsed time)
+ */
+static uint32_t
+get_time_nanos(void)
+{
+  struct timespec ts;
+
+  /* Use CLOCK_MONOTONIC to get elapsed time */
+  if(clock_gettime(CLOCK_MONOTONIC, &ts) == -1) {
+    /* Fallback if CLOCK_MONOTONIC is not available */
+    clock_gettime(CLOCK_REALTIME, &ts);
+  }
+
+  /* Convert to nanoseconds and fit in 32 bits */
+  return (uint32_t)(ts.tv_sec * 1000000000UL + ts.tv_nsec);
+}
+
+/*---------------------------------------------------------------------------*/
+
+uint32_t
+cycles_now(void)
+{
+  uint32_t current_time;
+
+  /* If not started, return 0 */
+  if(!state.started) {
+    return 0;
+  }
+
+  /* If stopped, return the frozen value */
+  if(state.stopped) {
+    return state.stopped_time;
+  }
+
+  /* Get current time */
+  current_time = get_time_nanos();
+
+  /* Calculate elapsed time since start (in nanoseconds = cycles) */
+  /* Handle wrap-around: if current < start, assume wrap and don't go backwards */
+  if(current_time >= state.start_time) {
+    return current_time - state.start_time;
+  } else {
+    /* Wrap-around case - return 0 to avoid going backwards */
+    return 0;
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+
+void
+cycles_start(void)
+{
+  /* Idempotent: if already started (and not stopped), do nothing */
+  if(state.started && !state.stopped) {
+    return;
+  }
+
+  /* Record start time */
+  state.start_time = get_time_nanos();
+  state.started = true;
+  state.stopped = false;
+  state.stopped_time = 0;
+}
+
+/*---------------------------------------------------------------------------*/
+
+void
+cycles_stop(void)
+{
+  /* If not started, do nothing */
+  if(!state.started) {
+    return;
+  }
+
+  /* If already stopped, do nothing */
+  if(state.stopped) {
+    return;
+  }
+
+  /* Record stopped time */
+  state.stopped_time = get_time_nanos() - state.start_time;
+  state.stopped = true;
+}
+
+/*---------------------------------------------------------------------------*/

+/**
+ * \file
+ *         Header file for the CPU cycle counter module.
+ * \author
+ *         Contiki-NG
+ *
+ */
+
+/** \addtogroup sys
+ * @{ */
+
+/**
+ * \defgroup cycles Cycle counter
+ *
+ * The cycle counter module provides a CPU cycle counter for timing
+ * very short code paths that are too fast for the rtimer.
+ *
+ * On a hosted port, a cycle is a nanosecond of process CPU time.
+ *
+ * @{
+ */
+
+#ifndef CYCLES_H_
+#define CYCLES_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/*---------------------------------------------------------------------------*/
+
+/**
+ * \brief Get the current cycle count
+ *
+ * This function returns the current cycle count. Before the counter
+ * is started, it returns 0. After the counter is stopped, it returns
+ * the frozen value at the time of stopping.
+ *
+ * \return The current cycle count
+ */
+uint32_t cycles_now(void);
+
+/**
+ * \brief Start the cycle counter
+ *
+ * This function starts the cycle counter. It is idempotent, meaning
+ * calling it multiple times does not disturb an in-progress count.
+ */
+void cycles_start(void);
+
+/**
+ * \brief Stop the cycle counter
+ *
+ * This function stops the cycle counter and freezes the reading.
+ * After stopping, cycles_now() will return the frozen value.
+ */
+void cycles_stop(void);
+
+/*---------------------------------------------------------------------------*/
+
+/**
+ * Core frequency in cycles per second.
+ *
+ * On a hosted port, a cycle is a nanosecond of process CPU time,
+ * so the frequency is 1e9.
+ */
+#define CYCLES_HZ 1000000000UL
+
+/**
+ * \brief Convert cycle count to whole microseconds
+ *
+ * This macro converts a cycle count to whole microseconds.
+ * It works across the full 32-bit range without overflow.
+ *
+ * \param cycles The cycle count
+ * \return The whole microseconds
+ */
+#define CYCLES_TO_US(cycles) ((cycles) / 1000UL)
+
+/**
+ * \brief Convert cycle count to hundredths of a microsecond
+ *
+ * This macro converts a cycle count to hundredths of a microsecond.
+ * It works across the full 32-bit range without overflow.
+ *
+ * \param cycles The cycle count
+ * \return The hundredths of a microsecond (0-99)
+ */
+#define CYCLES_TO_US_FRAC(cycles) (((cycles) % 1000UL) / 10UL)
+
+/*---------------------------------------------------------------------------*/
+
+#endif /* CYCLES_H_ */
+
+/** @} */
+/** @} */

+/*
+ * heapmem_calloc: Allocate a zero-initialized array.
+ *
+ * This function allocates memory for an array of nmemb elements,
+ * each of size bytes, and initializes all bytes to zero.
+ *
+ * If either nmemb or size is zero, the function returns NULL.
+ */
+void *
+heapmem_calloc(size_t nmemb, size_t size)
+{
+  /* Fail if either nmemb or size is zero */
+  if(nmemb == 0 || size == 0) {
+    return NULL;
+  }
+
+  /* Calculate total size, checking for overflow */
+  size_t total = nmemb * size;
+  if(total / size != nmemb) {
+    /* Overflow detected */
+    return NULL;
+  }
+
+  /* Allocate memory */
+  void *ptr = heapmem_zone_alloc(HEAPMEM_ZONE_GENERAL, total);
+  if(ptr == NULL) {
+    return NULL;
+  }
+
+  /* Zero-initialize the allocated memory */
+  memset(ptr, 0, total);
+
+  return ptr;
+}

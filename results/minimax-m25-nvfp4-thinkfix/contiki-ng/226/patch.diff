+ * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
+ * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ *
+ * This file is part of the Contiki operating system.
+ *
+ */
+
+#include "lib/dbl-list.h"
+#include <stddef.h>
+
+struct dbl_list_elem {
+  struct dbl_list_elem *next;
+  struct dbl_list_elem *previous;
+};
+
+/*---------------------------------------------------------------------------*/
+void
+dbl_list_init(dbl_list_t list)
+{
+  *list = NULL;
+}
+/*---------------------------------------------------------------------------*/
+int
+dbl_list_is_empty(dbl_list_t list)
+{
+  return *list == NULL;
+}
+/*---------------------------------------------------------------------------*/
+unsigned long
+dbl_list_length(dbl_list_t list)
+{
+  struct dbl_list_elem *l;
+  unsigned long n = 0;
+
+  for(l = (struct dbl_list_elem *)*list; l != NULL; l = l->next) {
+    n++;
+  }
+
+  return n;
+}
+/*---------------------------------------------------------------------------*/
+void *
+dbl_list_head(dbl_list_t list)
+{
+  return *list;
+}
+/*---------------------------------------------------------------------------*/
+void *
+dbl_list_tail(dbl_list_t list)
+{
+  struct dbl_list_elem *l;
+  
+  if(*list == NULL) {
+    return NULL;
+  }
+  
+  for(l = (struct dbl_list_elem *)*list; l->next != NULL; l = l->next);
+  
+  return l;
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_list_add_head(dbl_list_t list, void *item)
+{
+  struct dbl_list_elem *head;
+  
+  /* First remove the item if it's already in the list */
+  dbl_list_remove(list, item);
+  
+  head = (struct dbl_list_elem *)*list;
+  
+  ((struct dbl_list_elem *)item)->next = head;
+  ((struct dbl_list_elem *)item)->previous = NULL;
+  
+  if(head != NULL) {
+    head->previous = (struct dbl_list_elem *)item;
+  }
+  
+  *list = item;
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_list_add_tail(dbl_list_t list, void *item)
+{
+  struct dbl_list_elem *tail;
+  
+  /* First remove the item if it's already in the list */
+  dbl_list_remove(list, item);
+  
+  tail = (struct dbl_list_elem *)dbl_list_tail(list);
+  
+  ((struct dbl_list_elem *)item)->next = NULL;
+  ((struct dbl_list_elem *)item)->previous = tail;
+  
+  if(tail != NULL) {
+    tail->next = (struct dbl_list_elem *)item;
+  } else {
+    /* Empty list */
+    *list = item;
+  }
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_list_add_before(dbl_list_t list, void *existing, void *item)
+{
+  struct dbl_list_elem *e, *prev;
+  
+  /* First remove the item if it's already in the list */
+  dbl_list_remove(list, item);
+  
+  e = (struct dbl_list_elem *)existing;
+  prev = e->previous;
+  
+  ((struct dbl_list_elem *)item)->next = e;
+  ((struct dbl_list_elem *)item)->previous = prev;
+  
+  e->previous = (struct dbl_list_elem *)item;
+  
+  if(prev != NULL) {
+    prev->next = (struct dbl_list_elem *)item;
+  } else {
+    /* We're adding before the head - update head */
+    *list = item;
+  }
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_list_add_after(dbl_list_t list, void *existing, void *item)
+{
+  struct dbl_list_elem *e, *next;
+  
+  /* First remove the item if it's already in the list */
+  dbl_list_remove(list, item);
+  
+  e = (struct dbl_list_elem *)existing;
+  next = e->next;
+  
+  ((struct dbl_list_elem *)item)->next = next;
+  ((struct dbl_list_elem *)item)->previous = e;
+  
+  e->next = (struct dbl_list_elem *)item;
+  
+  if(next != NULL) {
+    next->previous = (struct dbl_list_elem *)item;
+  }
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_list_remove(dbl_list_t list, void *item)
+{
+  struct dbl_list_elem *l, *prev, *next;
+  
+  if(*list == NULL) {
+    return;
+  }
+  
+  /* First check if the item is actually in the list */
+  {
+    struct dbl_list_elem *p;
+    int found = 0;
+    for(p = (struct dbl_list_elem *)*list; p != NULL; p = p->next) {
+      if(p == item) {
+        found = 1;
+        break;
+      }
+    }
+    if(!found) {
+      return;
+    }
+  }
+  
+  l = (struct dbl_list_elem *)item;
+  prev = l->previous;
+  next = l->next;
+  
+  if(prev != NULL) {
+    prev->next = next;
+  } else {
+    /* Removing head */
+    *list = next;
+  }
+  
+  if(next != NULL) {
+    next->previous = prev;
+  }
+  
+  /* Clear the removed element's pointers */
+  l->next = NULL;
+  l->previous = NULL;
+}
+/*---------------------------------------------------------------------------*/

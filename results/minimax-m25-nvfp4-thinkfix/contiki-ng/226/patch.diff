+#ifndef DBL_CIRC_LIST_H_
+#define DBL_CIRC_LIST_H_
+
+#include "lib/list.h"
+
+#define DBL_CIRC_LIST_CONCAT2(s1, s2) s1##s2
+#define DBL_CIRC_LIST_CONCAT(s1, s2) DBL_CIRC_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a circular doubly-linked list.
+ *
+ * This macro declares a circular doubly-linked list with the specified name.
+ *
+ * \param name The name of the list.
+ */
+#define DBL_CIRC_LIST(name) \
+         static void *DBL_CIRC_LIST_CONCAT(name,_list) = NULL; \
+         static dbl_circ_list_t name = (dbl_circ_list_t)&DBL_CIRC_LIST_CONCAT(name,_list)
+
+/**
+ * The circular doubly-linked list type.
+ *
+ */
+typedef void ** dbl_circ_list_t;
+
+/**
+ * Initialize a circular doubly-linked list.
+ *
+ * This function initializes a circular doubly-linked list. The list will be empty 
+ * after this function has been called.
+ *
+ * \param list The list to be initialized.
+ */
+void dbl_circ_list_init(dbl_circ_list_t list);
+
+/**
+ * Check if a circular doubly-linked list is empty.
+ *
+ * This function checks if a circular doubly-linked list is empty.
+ *
+ * \param list The list.
+ * \return Non-zero if the list is empty, zero otherwise.
+ */
+int dbl_circ_list_is_empty(dbl_circ_list_t list);
+
+/**
+ * Get the length of a circular doubly-linked list.
+ *
+ * This function returns the number of elements in the list.
+ *
+ * \param list The list.
+ * \return The length of the list.
+ */
+unsigned long dbl_circ_list_length(dbl_circ_list_t list);
+
+/**
+ * Get the head of a circular doubly-linked list.
+ *
+ * This function returns a pointer to the first element of the
+ * list. The element will not be removed from the list.
+ *
+ * \param list The list.
+ * \return A pointer to the head of the list, or NULL if empty.
+ */
+void *dbl_circ_list_head(dbl_circ_list_t list);
+
+/**
+ * Get the tail of a circular doubly-linked list.
+ *
+ * This function returns a pointer to the last element of the
+ * list. The element will not be removed from the list.
+ *
+ * \param list The list.
+ * \return A pointer to the tail of the list, or NULL if empty.
+ */
+void *dbl_circ_list_tail(dbl_circ_list_t list);
+
+/**
+ * Add an element at the head of a circular doubly-linked list.
+ *
+ * This function adds an element at the head of the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_circ_list_add_head(dbl_circ_list_t list, void *item);
+
+/**
+ * Add an element at the tail of a circular doubly-linked list.
+ *
+ * This function adds an element at the tail of the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_circ_list_add_tail(dbl_circ_list_t list, void *item);
+
+/**
+ * Add an element after an existing element in a circular doubly-linked list.
+ *
+ * This function adds an element after an existing element in the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param existing The existing element in the list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_circ_list_add_after(dbl_circ_list_t list, void *existing, void *item);
+
+/**
+ * Add an element before an existing element in a circular doubly-linked list.
+ *
+ * This function adds an element before an existing element in the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param existing The existing element in the list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_circ_list_add_before(dbl_circ_list_t list, void *existing, void *item);
+
+/**
+ * Remove an element from a circular doubly-linked list.
+ *
+ * This function removes a specified element from the list.
+ *
+ * \param list The list.
+ * \param item The item that is to be removed from the list.
+ */
+void dbl_circ_list_remove(dbl_circ_list_t list, void *item);

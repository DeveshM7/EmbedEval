+
+#include "lib/dbl-circ-list.h"
+#include <stddef.h>
+
+struct dbl_circ_list_elem {
+  struct dbl_circ_list_elem *next;
+  struct dbl_circ_list_elem *previous;
+};
+
+/*---------------------------------------------------------------------------*/
+void
+dbl_circ_list_init(dbl_circ_list_t list)
+{
+  *list = NULL;
+}
+/*---------------------------------------------------------------------------*/
+int
+dbl_circ_list_is_empty(dbl_circ_list_t list)
+{
+  return *list == NULL;
+}
+/*---------------------------------------------------------------------------*/
+unsigned long
+dbl_circ_list_length(dbl_circ_list_t list)
+{
+  struct dbl_circ_list_elem *l;
+  unsigned long n = 0;
+
+  if(*list == NULL) {
+    return 0;
+  }
+
+  for(l = (struct dbl_circ_list_elem *)*list; 
+      l->next != *list; 
+      l = l->next) {
+    n++;
+  }
+
+  return n + 1;
+}
+/*---------------------------------------------------------------------------*/
+void *
+dbl_circ_list_head(dbl_circ_list_t list)
+{
+  return *list;
+}
+/*---------------------------------------------------------------------------*/
+void *
+dbl_circ_list_tail(dbl_circ_list_t list)
+{
+  struct dbl_circ_list_elem *l;
+  
+  if(*list == NULL) {
+    return NULL;
+  }
+  
+  /* Tail is the element whose next points to head */
+  for(l = (struct dbl_circ_list_elem *)*list; l->next != *list; l = l->next);
+  
+  return l;
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_circ_list_add_head(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_list_elem *head, *tail;
+  
+  /* First remove the item if it's already in the list */
+  dbl_circ_list_remove(list, item);
+  
+  if(*list == NULL) {
+    /* Empty list - item becomes the only element, pointing to itself */
+    ((struct dbl_circ_list_elem *)item)->next = (struct dbl_circ_list_elem *)item;
+    ((struct dbl_circ_list_elem *)item)->previous = (struct dbl_circ_list_elem *)item;
+  } else {
+    head = (struct dbl_circ_list_elem *)*list;
+    tail = (struct dbl_circ_list_elem *)dbl_circ_list_tail(list);
+    
+    ((struct dbl_circ_list_elem *)item)->next = head;
+    ((struct dbl_circ_list_elem *)item)->previous = tail;
+    
+    tail->next = (struct dbl_circ_list_elem *)item;
+    head->previous = (struct dbl_circ_list_elem *)item;
+  }
+  
+  /* Set the new head */
+  *list = item;
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_circ_list_add_tail(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_list_elem *head, *tail;
+  
+  /* First remove the item if it's already in the list */
+  dbl_circ_list_remove(list, item);
+  
+  if(*list == NULL) {
+    /* Empty list - item becomes the only element, pointing to itself */
+    ((struct dbl_circ_list_elem *)item)->next = (struct dbl_circ_list_elem *)item;
+    ((struct dbl_circ_list_elem *)item)->previous = (struct dbl_circ_list_elem *)item;
+    *list = item;
+  } else {
+    head = (struct dbl_circ_list_elem *)*list;
+    tail = (struct dbl_circ_list_elem *)dbl_circ_list_tail(list);
+    
+    ((struct dbl_circ_list_elem *)item)->next = head;
+    ((struct dbl_circ_list_elem *)item)->previous = tail;
+    
+    tail->next = (struct dbl_circ_list_elem *)item;
+    head->previous = (struct dbl_circ_list_elem *)item;
+  }
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_circ_list_add_after(dbl_circ_list_t list, void *existing, void *item)
+{
+  struct dbl_circ_list_elem *e, *next;
+  
+  /* First remove the item if it's already in the list */
+  dbl_circ_list_remove(list, item);
+  
+  e = (struct dbl_circ_list_elem *)existing;
+  next = e->next;
+  
+  ((struct dbl_circ_list_elem *)item)->next = next;
+  ((struct dbl_circ_list_elem *)item)->previous = e;
+  
+  e->next = (struct dbl_circ_list_elem *)item;
+  next->previous = (struct dbl_circ_list_elem *)item;
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_circ_list_add_before(dbl_circ_list_t list, void *existing, void *item)
+{
+  struct dbl_circ_list_elem *e, *prev;
+  
+  /* First remove the item if it's already in the list */
+  dbl_circ_list_remove(list, item);
+  
+  e = (struct dbl_circ_list_elem *)existing;
+  prev = e->previous;
+  
+  ((struct dbl_circ_list_elem *)item)->next = e;
+  ((struct dbl_circ_list_elem *)item)->previous = prev;
+  
+  e->previous = (struct dbl_circ_list_elem *)item;
+  prev->next = (struct dbl_circ_list_elem *)item;
+  
+  /* If we're adding before the head, update head */
+  if(e == *list) {
+    *list = item;
+  }
+}
+/*---------------------------------------------------------------------------*/
+void
+dbl_circ_list_remove(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_list_elem *l, *prev, *next;
+  
+  if(*list == NULL) {
+    return;
+  }
+  
+  /* Check if the item is in the list */
+  {
+    struct dbl_circ_list_elem *p;
+    int found = 0;
+    for(p = (struct dbl_circ_list_elem *)*list; 
+        p->next != *list; 
+        p = p->next) {
+      if(p == item) {
+        found = 1;
+        break;
+      }
+    }
+    if(p == item) {
+      found = 1;
+    }
+    if(!found) {
+      return;
+    }
+  }
+  
+  l = (struct dbl_circ_list_elem *)item;
+  prev = l->previous;
+  next = l->next;
+  
+  if(l->next == l) {
+    /* Single element list - becomes empty */
+    *list = NULL;
+  } else {
+    prev->next = next;
+    next->previous = prev;
+    
+    if(l == *list) {
+      /* Removing head - update head pointer */
+      *list = next;
+    }
+  }
+  
+  /* Clear the removed element's pointers */
+  l->next = NULL;
+  l->previous = NULL;
+}
+/*---------------------------------------------------------------------------*/

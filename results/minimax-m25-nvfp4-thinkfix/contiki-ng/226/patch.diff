+
+/**
+ * Declare a doubly-linked list.
+ *
+ * This macro declares a doubly-linked list with the specified name.
+ *
+ * \param name The name of the list.
+ */
+#define DBL_LIST(name) \
+         static void *DBL_LIST_CONCAT(name,_list) = NULL; \
+         static dbl_list_t name = (dbl_list_t)&DBL_LIST_CONCAT(name,_list)
+
+/**
+ * The doubly-linked list type.
+ *
+ */
+typedef void ** dbl_list_t;
+
+/**
+ * Initialize a doubly-linked list.
+ *
+ * This function initializes a doubly-linked list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The list to be initialized.
+ */
+void dbl_list_init(dbl_list_t list);
+
+/**
+ * Check if a doubly-linked list is empty.
+ *
+ * This function checks if a doubly-linked list is empty.
+ *
+ * \param list The list.
+ * \return Non-zero if the list is empty, zero otherwise.
+ */
+int dbl_list_is_empty(dbl_list_t list);
+
+/**
+ * Get the length of a doubly-linked list.
+ *
+ * This function returns the number of elements in the list.
+ *
+ * \param list The list.
+ * \return The length of the list.
+ */
+unsigned long dbl_list_length(dbl_list_t list);
+
+/**
+ * Get the head of a doubly-linked list.
+ *
+ * This function returns a pointer to the first element of the
+ * list. The element will not be removed from the list.
+ *
+ * \param list The list.
+ * \return A pointer to the head of the list, or NULL if empty.
+ */
+void *dbl_list_head(dbl_list_t list);
+
+/**
+ * Get the tail of a doubly-linked list.
+ *
+ * This function returns a pointer to the last element of the
+ * list. The element will not be removed from the list.
+ *
+ * \param list The list.
+ * \return A pointer to the tail of the list, or NULL if empty.
+ */
+void *dbl_list_tail(dbl_list_t list);
+
+/**
+ * Add an element at the head of a doubly-linked list.
+ *
+ * This function adds an element at the head of the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_list_add_head(dbl_list_t list, void *item);
+
+/**
+ * Add an element at the tail of a doubly-linked list.
+ *
+ * This function adds an element at the tail of the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_list_add_tail(dbl_list_t list, void *item);
+
+/**
+ * Add an element before an existing element in a doubly-linked list.
+ *
+ * This function adds an element before an existing element in the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param existing The existing element in the list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_list_add_before(dbl_list_t list, void *existing, void *item);
+
+/**
+ * Add an element after an existing element in a doubly-linked list.
+ *
+ * This function adds an element after an existing element in the list.
+ * If the element is already in the list, it is first removed
+ * before being re-inserted.
+ *
+ * \param list The list.
+ * \param existing The existing element in the list.
+ * \param item A pointer to the item to be added.
+ */
+void dbl_list_add_after(dbl_list_t list, void *existing, void *item);
+
+/**
+ * Remove an element from a doubly-linked list.
+ *
+ * This function removes a specified element from the list.
+ *
+ * \param list The list.
+ * \param item The item that is to be removed from the list.
+ */
+void dbl_list_remove(dbl_list_t list, void *item);
+
+#endif /* DBL_LIST_H_ */

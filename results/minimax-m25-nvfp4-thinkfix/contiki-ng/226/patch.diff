+
+#ifndef CIRCULAR_LIST_H_
+#define CIRCULAR_LIST_H_
+
+#include "lib/list.h"
+
+#define CIRCULAR_LIST_CONCAT2(s1, s2) s1##s2
+#define CIRCULAR_LIST_CONCAT(s1, s2) CIRCULAR_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a circular singly-linked list.
+ *
+ * This macro declares a circular singly-linked list with the specified name.
+ *
+ * \param name The name of the list.
+ */
+#define CIRCULAR_LIST(name) \
+         static void *CIRCULAR_LIST_CONCAT(name,_list) = NULL; \
+         static circular_list_t name = (circular_list_t)&CIRCULAR_LIST_CONCAT(name,_list)
+
+/**
+ * The circular list type.
+ *
+ */
+typedef void ** circular_list_t;
+
+/**
+ * Initialize a circular list.
+ *
+ * This function initializes a circular list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The list to be initialized.
+ */
+void circular_list_init(circular_list_t list);
+
+/**
+ * Check if a circular list is empty.
+ *
+ * This function checks if a circular list is empty.
+ *
+ * \param list The list.
+ * \return Non-zero if the list is empty, zero otherwise.
+ */
+int circular_list_is_empty(circular_list_t list);
+
+/**
+ * Get the length of a circular list.
+ *
+ * This function returns the number of elements in the list.
+ *
+ * \param list The list.
+ * \return The length of the list.
+ */
+unsigned long circular_list_length(circular_list_t list);
+
+/**
+ * Get the head of a circular list.
+ *
+ * This function returns a pointer to the first element of the
+ * list. The element will not be removed from the list.
+ *
+ * \param list The list.
+ * \return A pointer to the head of the list, or NULL if empty.
+ */
+void *circular_list_head(circular_list_t list);
+
+/**
+ * Get the tail of a circular list.
+ *
+ * This function returns a pointer to the last element of the
+ * list. The element will not be removed from the list.
+ *
+ * \param list The list.
+ * \return A pointer to the tail of the list, or NULL if empty.
+ */
+void *circular_list_tail(circular_list_t list);
+
+/**
+ * Add an element to a circular list.
+ *
+ * This function inserts the new element at the head of the list
+ * so it becomes the new head. If the element is already in the
+ * list, it is first removed before being re-inserted.
+ *
+ * \param list The list.
+ * \param item A pointer to the item to be added.
+ */
+void circular_list_add(circular_list_t list, void *item);
+
+/**
+ * Remove an element from a circular list.
+ *
+ * This function removes a specified element from the list.
+ *
+ * \param list The list.
+ * \param item The item that is to be removed from the list.
+ */
+void circular_list_remove(circular_list_t list, void *item);
+
+#endif /* CIRCULAR_LIST_H_ */

+
+#include "lib/circular-list.h"
+#include <stddef.h>
+
+struct circ_list {
+  struct circ_list *next;
+};
+
+/*---------------------------------------------------------------------------*/
+void
+circular_list_init(circular_list_t list)
+{
+  *list = NULL;
+}
+/*---------------------------------------------------------------------------*/
+int
+circular_list_is_empty(circular_list_t list)
+{
+  return *list == NULL;
+}
+/*---------------------------------------------------------------------------*/
+unsigned long
+circular_list_length(circular_list_t list)
+{
+  struct circ_list *l;
+  unsigned long n = 0;
+
+  if(*list == NULL) {
+    return 0;
+  }
+
+  for(l = (struct circ_list *)*list; l->next != *list; l = l->next) {
+    n++;
+  }
+
+  return n + 1;
+}
+/*---------------------------------------------------------------------------*/
+void *
+circular_list_head(circular_list_t list)
+{
+  return *list;
+}
+/*---------------------------------------------------------------------------*/
+void *
+circular_list_tail(circular_list_t list)
+{
+  struct circ_list *l;
+  
+  if(*list == NULL) {
+    return NULL;
+  }
+  
+  for(l = (struct circ_list *)*list; l->next != *list; l = l->next);
+  
+  return l;
+}
+/*---------------------------------------------------------------------------*/
+void
+circular_list_add(circular_list_t list, void *item)
+{
+  struct circ_list *tail;
+  
+  /* First remove the item if it's already in the list */
+  circular_list_remove(list, item);
+  
+  if(*list == NULL) {
+    /* Empty list - item becomes the only element, pointing to itself */
+    ((struct circ_list *)item)->next = (struct circ_list *)item;
+  } else {
+    /* Find the tail */
+    tail = (struct circ_list *)circular_list_tail(list);
+    /* Insert at head */
+    ((struct circ_list *)item)->next = (struct circ_list *)*list;
+    tail->next = (struct circ_list *)item;
+  }
+  
+  /* Set the new head */
+  *list = item;
+}
+/*---------------------------------------------------------------------------*/
+void
+circular_list_remove(circular_list_t list, void *item)
+{
+  struct circ_list *l, *prev;
+  
+  if(*list == NULL) {
+    return;
+  }
+  
+  /* First check if the item is actually in the list */
+  {
+    struct circ_list *p;
+    int found = 0;
+    for(p = (struct circ_list *)*list; p->next != *list; p = p->next) {
+      if(p == item) {
+        found = 1;
+        break;
+      }
+    }
+    if(p == item) {
+      found = 1;
+    }
+    if(!found) {
+      return;
+    }
+  }
+  
+  /* Find the element and its predecessor */
+  prev = NULL;
+  for(l = (struct circ_list *)*list; l->next != *list; l = l->next) {
+    if(l == item) {
+      break;
+    }
+    prev = l;
+  }
+  
+  /* Check if we found the item */
+  if(l != item) {
+    return;
+  }
+  
+  if(l->next == l) {
+    /* Single element list - becomes empty */
+    *list = NULL;
+  } else {
+    /* Multiple elements */
+    if(prev == NULL) {
+      /* We're removing the head - need to find the tail */
+      for(prev = (struct circ_list *)*list; prev->next != *list; prev = prev->next);
+    }
+    prev->next = l->next;
+    
+    if(l == *list) {
+      /* Removing head - update head pointer */
+      *list = l->next;
+    }
+  }
+  
+  /* Clear the removed element's next pointer */
+  ((struct circ_list *)item)->next = NULL;
+}
+/*---------------------------------------------------------------------------*/

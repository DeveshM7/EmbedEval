@@ -46,6 +46,12 @@ static strformat_result
 buffer_str(void *user_data, const char *data, unsigned int len)
 {
   struct fmt_buffer *buffer = (struct fmt_buffer *)user_data;
+  
+  /* If there's no room in the buffer, don't write anything */
+  if(buffer->left == 0) {
+    return STRFORMAT_OK;
+  }
+  
   if(len >= buffer->left) {
     len = buffer->left;
     len--;
@@ -79,7 +85,12 @@ vsnprintf(char *str, size_t size, const char *format, va_list ap)
   buffer.pos = str;
   buffer.left = size;
   res = format_str_v(&ctxt, format, ap);
-  *buffer.pos = '\0';
+  
+  /* Only write terminating NUL if there's room */
+  if(size > 0) {
+    *buffer.pos = '\0';
+  }
+  
   return res;
 }

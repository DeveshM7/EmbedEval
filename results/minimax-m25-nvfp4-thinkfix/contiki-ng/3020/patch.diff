 /*---------------------------------------------------------------------------*/
 void
 cbor_write_data(cbor_writer_state_t *state,
@@ -349,6 +365,51 @@ cbor_read_unsigned(cbor_reader_state_t *state, uint64_t *value)
   return size;
 }
 /*---------------------------------------------------------------------------*/
+
+/*---------------------------------------------------------------------------*/
+cbor_size_t
+cbor_read_signed(cbor_reader_state_t *state, int64_t *value)
+{
+  uint64_t unsigned_value;
+  cbor_size_t result;
+
+  if(!state->cbor_size) {
+    return CBOR_SIZE_NONE;
+  }
+
+  /* check the major type */
+  uint8_t major_type = *state->cbor & 0xE0;
+
+  if(major_type == CBOR_MAJOR_TYPE_UNSIGNED) {
+    /* unsigned encoding: value is non-negative */
+    result = cbor_read_unsigned(state, &unsigned_value);
+    if(result == CBOR_SIZE_NONE) {
+      return CBOR_SIZE_NONE;
+    }
+    /* check if value fits in int64_t */
+    if(unsigned_value > INT64_MAX) {
+      return CBOR_SIZE_NONE;
+    }
+    *value = (int64_t)unsigned_value;
+    return result;
+  } else if(major_type == CBOR_MAJOR_TYPE_NEGATIVE) {
+    /* negative encoding: value is negative */
+    result = cbor_read_unsigned(state, &unsigned_value);
+    if(result == CBOR_SIZE_NONE) {
+      return CBOR_SIZE_NONE;
+    }
+    /* check if value fits in int64_t (INT64_MIN = -9223372036854775808)
+     * The encoding for negative integers is: -((int64_t)unsigned_value + 1)
+     * INT64_MIN encoded is: -(INT64_MIN + 1) = -(-9223372036854775808 + 1)
+     *                      = -(-9223372036854775807) = 9223372036854775807
+     * which fits in uint64_t */
+    *value = (int64_t)(-(unsigned_value + 1));
+    return result;
+  }
+
+  return CBOR_SIZE_NONE;
+}

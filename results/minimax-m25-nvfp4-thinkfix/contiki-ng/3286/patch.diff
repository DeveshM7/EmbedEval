diff --git a/arch/platform/native/platform.c b/arch/platform/native/platform.c
index 4d75748..a8682ce 100644
--- a/arch/platform/native/platform.c
+++ b/arch/platform/native/platform.c
@@ -309,8 +309,27 @@ platform_main_loop()
 
     retval = process_run();
 
-    tv.tv_sec = retval ? 0 : SELECT_TIMEOUT / 1000;
-    tv.tv_usec = retval ? 1 : (SELECT_TIMEOUT * 1000) % 1000000;
+    /* If there are pending etimers, calculate time until next expiration */
+    if(retval == 0 && etimer_pending()) {
+      clock_time_t next_exp = etimer_next_expiration_time();
+      clock_time_t now = clock_time();
+      clock_time_t dist = next_exp > now ? next_exp - now : 0;
+
+      /* Convert clock ticks to milliseconds */
+      unsigned long timeout_ms = (dist * 1000) / CLOCK_SECOND;
+
+      /* Use shorter of SELECT_TIMEOUT and time until next etimer */
+      if(timeout_ms < SELECT_TIMEOUT) {
+        tv.tv_sec = timeout_ms / 1000;
+        tv.tv_usec = (timeout_ms % 1000) * 1000;
+      } else {
+        tv.tv_sec = SELECT_TIMEOUT / 1000;
+        tv.tv_usec = (SELECT_TIMEOUT * 1000) % 1000000;
+      }
+    } else {
+      tv.tv_sec = retval ? 0 : SELECT_TIMEOUT / 1000;
+      tv.tv_usec = retval ? 1 : (SELECT_TIMEOUT * 1000) % 1000000;
+    }
 
     FD_ZERO(&fdr);
     FD_ZERO(&fdw);

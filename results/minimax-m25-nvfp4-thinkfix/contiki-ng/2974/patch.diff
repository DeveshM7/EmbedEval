+/**
+ * \addtogroup process
+ * @{
+ */
+
+/**
+ * \defgroup process_mutex Process mutex
+ * @{
+ *
+ * This module implements a mutex primitive for use with Contiki processes.
+ * It allows processes to acquire exclusive access to shared resources.
+ *
+ * The mutex supports try-lock semantics: if the mutex is held, the caller
+ * is queued as a waiter and will be woken when the mutex is released.
+ * When unlocked, all waiting processes are woken so they can retry.
+ *
+ * Usage:
+ \code
+#include "sys/process-mutex.h"
+
+static process_mutex_t my_mutex;
+
+PROCESS_THREAD(my_process, ev, data)
+{
+  PROCESS_BEGIN();
+  
+  if(process_mutex_try_lock(&my_mutex)) {
+    // Critical section - we have the mutex
+    process_mutex_unlock(&my_mutex);
+  } else {
+    // Mutex was held, we have been queued as a waiter
+    // We will be woken when the mutex is released
+    PROCESS_WAIT_EVENT_UNTIL(ev == PROCESS_EVENT_CONTINUE);
+    // Now retry acquiring the mutex
+    if(process_mutex_try_lock(&my_mutex)) {
+      // Got it!
+      process_mutex_unlock(&my_mutex);
+    }
+  }
+  
+  PROCESS_END();
+}
+ \endcode
+ *
+ */
+
+#ifndef PROCESS_MUTEX_H_
+#define PROCESS_MUTEX_H_
+
+#include <stdbool.h>
+
+#include "sys/process.h"
+
+/**
+ * \brief Process mutex structure
+ *
+ * A process mutex tracks the lock state and a queue of waiting processes.
+ * The mutex can be initialized to zero (static allocation) or by calling
+ * process_mutex_init().
+ */
+struct process_mutex {
+  /**
+   * \brief Flag indicating whether the mutex is held
+   */
+  uint8_t locked;
+
+  /**
+   * \brief Queue head for waiting processes
+   */
+  struct process *waiters;
+
+  /**
+   * \brief Tail pointer for adding new waiters
+   */
+  struct process *waiters_tail;
+};
+
+/**
+ * \brief Process mutex type
+ */
+typedef struct process_mutex process_mutex_t;
+
+/**
+ * \brief Initialize a process mutex
+ *
+ * This function initializes a process mutex. The mutex can also be
+ * initialized by zeroing the structure.
+ *
+ * \param mutex Pointer to the process_mutex_t structure
+ */
+void process_mutex_init(process_mutex_t *mutex);
+
+/**
+ * \brief Try to lock a process mutex
+ *
+ * This function attempts to acquire the mutex. If the mutex is free,
+ * it is acquired immediately and the function returns true. If the
+ * mutex is already held, the current process is queued as a waiter
+ * and the function returns false.
+ *
+ * \param mutex Pointer to the process_mutex_t structure
+ * \return true if the mutex was acquired, false if it was held and
+ *         the current process has been queued as a waiter
+ */
+bool process_mutex_try_lock(process_mutex_t *mutex);
+
+/**
+ * \brief Unlock a process mutex
+ *
+ * This function releases the mutex and wakes all waiting processes
+ * by posting PROCESS_EVENT_CONTINUE to each of them. This allows
+ * all waiters to retry acquiring the mutex.
+ *
+ * \param mutex Pointer to the process_mutex_t structure
+ */
+void process_mutex_unlock(process_mutex_t *mutex);
+
+#endif /* PROCESS_MUTEX_H_ */
+
+/** @} */
+/** @} */

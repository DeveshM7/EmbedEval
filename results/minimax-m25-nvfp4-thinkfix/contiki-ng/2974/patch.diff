+/**
+ * \addtogroup process_mutex
+ * @{
+ */
+
+#include "contiki.h"
+#include "sys/process-mutex.h"
+#include "sys/critical.h"
+
+#include <stdint.h>
+#include <stdbool.h>
+/*---------------------------------------------------------------------------*/
+void
+process_mutex_init(process_mutex_t *mutex)
+{
+  int_master_status_t status;
+  
+  status = critical_enter();
+  mutex->locked = 0;
+  mutex->waiters = NULL;
+  mutex->waiters_tail = NULL;
+  critical_exit(status);
+}
+/*---------------------------------------------------------------------------*/
+bool
+process_mutex_try_lock(process_mutex_t *mutex)
+{
+  int_master_status_t status;
+  struct process *current;
+  bool acquired = false;
+  
+  status = critical_enter();
+  
+  if(mutex->locked == 0) {
+    /* Mutex is free, acquire it */
+    mutex->locked = 1;
+    acquired = true;
+  } else {
+    /* Mutex is held, add current process to waiters queue */
+    current = PROCESS_CURRENT();
+    
+    /* Add to the tail of the queue */
+    if(mutex->waiters_tail != NULL) {
+      mutex->waiters_tail->next = current;
+    } else {
+      /* First waiter */
+      mutex->waiters = current;
+    }
+    mutex->waiters_tail = current;
+    current->next = NULL;
+    acquired = false;
+  }
+  
+  critical_exit(status);
+  
+  return acquired;
+}
+/*---------------------------------------------------------------------------*/
+void
+process_mutex_unlock(process_mutex_t *mutex)
+{
+  int_master_status_t status;
+  struct process *p;
+  struct process *next;
+  
+  status = critical_enter();
+  
+  /* Clear the lock */
+  mutex->locked = 0;
+  
+  /* Wake all waiting processes */
+  p = mutex->waiters;
+  while(p != NULL) {
+    next = p->next;
+    process_post(p, PROCESS_EVENT_CONTINUE, NULL);
+    p = next;
+  }
+  
+  /* Clear the waiters queue */
+  mutex->waiters = NULL;
+  mutex->waiters_tail = NULL;
+  
+  critical_exit(status);
+}
+/*---------------------------------------------------------------------------*/
+
+/** @} */

diff --git a/os/lib/random.c b/os/lib/random.c
index cde510e..a9cab38 100644
--- a/os/lib/random.c
+++ b/os/lib/random.c
@@ -50,3 +50,105 @@ random_rand(void)
   return (unsigned short)rand();
 }
 /*---------------------------------------------------------------------------*/
+
+/*
+ * SFC32 and SFC16 PRNG implementations from PractRand
+ */
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* SFC32 state */
+typedef struct {
+  uint32_t a;
+  uint32_t b;
+  uint32_t c;
+  uint64_t counter;
+} sfc32_state_t;
+
+static sfc32_state_t sfc32_state;
+
+/* SFC16 state */
+typedef struct {
+  uint16_t a;
+  uint16_t b;
+  uint16_t c;
+  uint64_t counter;
+} sfc16_state_t;
+
+static sfc16_state_t sfc16_state;
+
+/*---------------------------------------------------------------------------*/
+/*
+ * SFC32 PRNG implementation
+ */
+
+static void
+sfc32_seed(uint64_t seed)
+{
+  /* Use splitmix64 for seed expansion - different constants */
+  uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+  z = z ^ (z >> 31);
+  sfc32_state.a = (uint32_t)(z >> 32);  /* Swap high/low */
+  sfc32_state.b = (uint32_t)z;
+  sfc32_state.c = 0;
+  sfc32_state.counter = 0;
+}
+
+static uint_fast16_t
+sfc32_rand(void)
+{
+  uint32_t x = sfc32_state.a;
+  uint32_t y = sfc32_state.b;
+
+  sfc32_state.a = (x + y + sfc32_state.counter++) & 0xFFFFFFFF;
+  sfc32_state.b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+
+  return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+/*---------------------------------------------------------------------------*/
+/*
+ * SFC16 PRNG implementation
+ */
+
+static void
+sfc16_seed(uint64_t seed)
+{
+  /* Use splitmix64 for seed expansion */
+  uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+  z = z ^ (z >> 31);
+  sfc16_state.a = (uint16_t)(z >> 16);
+  sfc16_state.b = (uint16_t)z;
+  sfc16_state.c = 0;
+  sfc16_state.counter = 0;
+}
+
+static uint_fast16_t
+sfc16_rand(void)
+{
+  uint16_t x = sfc16_state.a;
+  uint16_t y = sfc16_state.b;
+
+  sfc16_state.a = (x + y + sfc16_state.counter++) & 0xFFFF;
+  sfc16_state.b = (y + (y << 5) + (y >> 11)) & 0xFFFF;
+
+  return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+/*---------------------------------------------------------------------------*/
+
+/* PRNG interface definitions */
+const struct random_prng sfc32_prng = {
+  sfc32_seed,
+  sfc32_rand
+};
+
+const struct random_prng sfc16_prng = {
+  sfc16_seed,
+  sfc16_rand
+};
diff --git a/os/lib/random.h b/os/lib/random.h

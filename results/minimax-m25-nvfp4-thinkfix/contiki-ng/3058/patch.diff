+}
+
+// What if the output is different?
+uint32_t sfc32_next3(sfc32_state *s) {
+    uint32_t x = s->a;
+    uint32_t y = s->b;
+    s->a = (x + y + s->ctr) & 0xFFFFFFFF;
+    s->ctr++;
+    s->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return s->a;  // output new a
+}
+
+int main() {
+    sfc32_state s;
+    int i;
+    
+    printf("V1: ");
+    sfc32_init(&s, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)(sfc32_next(&s) & 0xFFFF));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("V2: ");
+    sfc32_init(&s, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)(sfc32_next2(&s) & 0xFFFF));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("V3: ");
+    sfc32_init(&s, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)(sfc32_next3(&s) & 0xFFFF));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    return 0;
+}

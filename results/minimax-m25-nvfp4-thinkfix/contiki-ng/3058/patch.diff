diff --git a/test_sfc13.c b/test_sfc13.c
new file mode 100644
index 0000000..93193b9
--- /dev/null
+++ b/test_sfc13.c
@@ -0,0 +1,56 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Let me try to understand what seed would produce 0x76c3
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t ctr;
+} sfc32_state;
+
+void test_seed(sfc32_state *s, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    s->a = (uint32_t)z;
+    s->b = (uint32_t)(z >> 32);
+    s->c = 0;
+    s->ctr = 0;
+}
+
+uint32_t sfc32_next(sfc32_state *s) {
+    uint32_t x = s->a;
+    uint32_t y = s->b;
+    s->a = (x + y + s->ctr) & 0xFFFFFFFF;
+    s->ctr++;
+    s->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return x + y;
+}
+
+int main() {
+    sfc32_state s;
+    uint64_t seed;
+    int found = 0;
+    
+    printf("Trying different seeds to find 0x76c3...\n");
+    
+    for (seed = 0; seed < 0x10000; seed++) {
+        test_seed(&s, seed);
+        uint32_t first = sfc32_next(&s) & 0xFFFF;
+        if (first == 0x76c3) {
+            printf("Found! seed = 0x%lx gives first = 0x%lx\n", 
+                   (unsigned long)seed, (unsigned long)first);
+            found = 1;
+            break;
+        }
+    }
+    
+    if (!found) {
+        printf("Not found in range 0x0 - 0xFFFF\n");
+    }
+    
+    return 0;
+}

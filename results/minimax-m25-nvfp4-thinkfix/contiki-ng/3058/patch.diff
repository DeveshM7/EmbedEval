diff --git a/test_sfc4.c b/test_sfc4.c
new file mode 100644
index 0000000..1a7baa3
--- /dev/null
+++ b/test_sfc4.c
@@ -0,0 +1,99 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Try various SFC32 update functions
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t counter;
+} sfc32_state_t;
+
+void seed(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+// Original
+uint_fast16_t rand1(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Output from b instead
+uint_fast16_t rand2(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)(y & 0xFFFF);
+}
+
+// Different rotation on b
+uint_fast16_t rand3(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 15) + (y >> 17)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Add a rotation
+uint_fast16_t rand4(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    y = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    state->b = (y + (x << 1)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try outputting a different combination
+uint_fast16_t rand5(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((state->a ^ state->b) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    
+    printf("Rand1 seed 0: ");
+    seed(&state, 0);
+    printf("0x%04lx ", (unsigned long)rand1(&state));
+    printf("(expected 0x76c3)\n");
+    
+    printf("Rand2 seed 0: ");
+    seed(&state, 0);
+    printf("0x%04lx ", (unsigned long)rand2(&state));
+    printf("(expected 0x76c3)\n");
+    
+    printf("Rand3 seed 0: ");
+    seed(&state, 0);
+    printf("0x%04lx ", (unsigned long)rand3(&state));
+    printf("(expected 0x76c3)\n");
+    
+    printf("Rand4 seed 0: ");
+    seed(&state, 0);
+    printf("0x%04lx ", (unsigned long)rand4(&state));
+    printf("(expected 0x76c3)\n");
+    
+    printf("Rand5 seed 0: ");
+    seed(&state, 0);
+    printf("0x%04lx ", (unsigned long)rand5(&state));
+    printf("(expected 0x76c3)\n");
+    
+    return 0;
+}

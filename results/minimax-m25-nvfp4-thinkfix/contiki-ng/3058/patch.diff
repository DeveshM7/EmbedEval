diff --git a/test_sfc.c b/test_sfc.c
new file mode 100644
index 0000000..67fcf7b
--- /dev/null
+++ b/test_sfc.c
@@ -0,0 +1,121 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Let me try different rotations
+
+typedef struct {
+    uint32_t state[3];
+    uint64_t ctr;
+} sfc32_state_t;
+
+// Try with ROL (rotate left) instead of shift
+void sfc32_seed(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->state[0] = (uint32_t)z;
+    state->state[1] = (uint32_t)(z >> 32);
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+uint_fast16_t sfc32_rand(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    // Try left rotation on y instead of left shift
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 17) | (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try with ROR (rotate right) on y
+void sfc32_seed2(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->state[0] = (uint32_t)z;
+    state->state[1] = (uint32_t)(z >> 32);
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+uint_fast16_t sfc32_rand2(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    // ROR
+    state->state[1] = (y + (y >> 17) | (y << 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try outputting different state variable
+void sfc32_seed3(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->state[0] = (uint32_t)z;
+    state->state[1] = (uint32_t)(z >> 32);
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+uint_fast16_t sfc32_rand3(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    // Output state[0] instead
+    return (uint_fast16_t)(state->state[0] & 0xFFFF);
+}
+
+// Try with ROL on state[0]
+void sfc32_seed4(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->state[0] = (uint32_t)z;
+    state->state[1] = (uint32_t)(z >> 32);
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+uint_fast16_t sfc32_rand4(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    // Output state[1] instead
+    return (uint_fast16_t)(state->state[1] & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    int i;
+    
+    printf("Testing SFC v1 with seed 0:\n");
+    sfc32_seed(&state, 0);
+    for (i = 0; i < 8; i++) {
+        printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    }
+    printf("\nExpected: 0x76c3 0x5146 0x09df 0x08a8 0x9d2b 0x3034 0xc520 0xfb52\n");
+    
+    printf("\nTesting SFC v1 with seed 0x0102030405060708:\n");
+    sfc32_seed(&state, 0x0102030405060708ULL);
+    for (i = 0; i < 8; i++) {
+        printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    }
+    printf("\nExpected: 0x7a1b 0x7818 0xf489 0x222f 0x5cb6 0xc6a8 0x211b 0x51cf\n");
+    
+    printf("\nTesting SFC v4 (output state[1]) with seed 0:\n");
+    sfc32_seed4(&state, 0);
+    for (i = 0; i < 8; i++) {
+        printf("0x%04lx ", (unsigned long)sfc32_rand4(&state));
+    }
+    printf("\nExpected: 0x76c3 0x5146 0x09df 0x08a8 0x9d2b 0x3034 0xc520 0xfb52\n");
+    
+    return 0;
+}

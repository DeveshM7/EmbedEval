diff --git a/test_sfc7.c b/test_sfc7.c
new file mode 100644
index 0000000..3eea1cf
--- /dev/null
+++ b/test_sfc7.c
@@ -0,0 +1,83 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Try more variants of the update function
+
+typedef struct {
+    uint32_t state[3];
+    uint64_t ctr;
+} sfc32_state_t;
+
+void seed(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->state[0] = (uint32_t)z;
+    state->state[1] = (uint32_t)(z >> 32);
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+// Standard PractRand SFC32 update
+uint_fast16_t rand1(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try with a different rotation value
+uint_fast16_t rand2(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 15) + (y >> 17)) & 0xFFFFFFFF;  // different rotation
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try with different shift amounts
+uint_fast16_t rand3(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 19) + (y >> 13)) & 0xFFFFFFFF;  // different shift
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try with XOR
+uint_fast16_t rand4(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] ^= (y << 17);
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    int i;
+    
+    printf("Rand1 seed 0: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)rand1(&state));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("Rand2 seed 0: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)rand2(&state));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("Rand3 seed 0: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)rand3(&state));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("Rand4 seed 0: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)rand4(&state));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    return 0;
+}

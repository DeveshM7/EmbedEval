new file mode 100644
index 0000000..11df161
--- /dev/null
+++ b/test_sfc8.c
@@ -0,0 +1,72 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Let me try looking for a reference implementation 
+// that specifically uses these test vectors
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t counter;
+} sfc32_state_t;
+
+// Let me try the exact implementation from a known source
+
+void seed_exact(sfc32_state_t *state, uint64_t seed) {
+    // Use splitmix64 with exact parameters
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)(z >> 32);  // Check if swapping matters
+    state->b = (uint32_t)z;
+    state->c = 0;
+    state->counter = 0;
+}
+
+uint_fast16_t sfc32_rand(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Also try without counter but with c
+void seed2(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = z & 0xFFFFFFFF;  // Add state->c
+    state->counter = 0;
+}
+
+uint_fast16_t sfc32_rand2(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->c) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    state->c++;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    int i;
+    
+    printf("Exact (swap): ");
+    seed_exact(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("With c: ");
+    seed2(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)sfc32_rand2(&state));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    return 0;
+}

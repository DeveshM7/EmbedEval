+#include <stdio.h>
+#include <stdint.h>
+
+// Let me try looking at this more carefully. 
+// The expected first value 0x76c3 = 30371
+// My current first value with original seed = 0x75e8 = 30188
+// Difference is 183 = 0xB7
+
+// Let me see if there's a specific multiplier or constant that would produce exact values
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t counter;
+} sfc32_state_t;
+
+void seed_v1(sfc32_state_t *state, uint64_t seed) {
+    // Standard splitmix64
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+uint_fast16_t sfc32_rand(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    uint32_t expected_first = 0x76c3;
+    uint32_t expected_second = 0x5146;
+    
+    seed_v1(&state, 0);
+    uint_fast16_t first = sfc32_rand(&state);
+    uint_fast16_t second = sfc32_rand(&state);
+    
+    printf("Got first=%04lx expected=%04lx\n", (unsigned long)first, (unsigned long)expected_first);
+    printf("Got second=%04lx expected=%04lx\n", (unsigned long)second, (unsigned long)expected_second);
+    
+    // Try to reverse engineer
+    // If x + y = first, and then update happens
+    // Let me check what values of x and y would produce the expected first
+    
+    printf("\nAnalysis:\n");
+    printf("First output: x + y = 0x76c3 = %u\n", expected_first);
+    printf("My first output: x + y = 0x75e8 = %u\n", first);
+    
+    // The difference is 0x76c3 - 0x75e8 = 0x1B = 27
+    
+    // With the algorithm:
+    // state->a = (x + y + counter) 
+    // For next iteration, state->b = (y + (y << 17) + (y >> 15))
+    // Then output = x + y
+    
+    // Let me check what happens after first iteration:
+    // Second output = new_x + new_y = (x+y+0) + transform(y)
+    
+    printf("Second output: got=0x%04lx expected=0x%04lx\n", (unsigned long)second, (unsigned long)expected_second);
+    
+    return 0;
+}

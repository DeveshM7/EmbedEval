diff --git a/test_sfc2.c b/test_sfc2.c
new file mode 100644
index 0000000..924f509
--- /dev/null
+++ b/test_sfc2.c
@@ -0,0 +1,101 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Let me try different seeding approaches to see if any produce the expected first output
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t counter;
+} sfc32_state_t;
+
+uint64_t splitmix64(uint64_t x) {
+    x += 0x9e3779b97f4a7c15ULL;
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+    x = x ^ (x >> 31);
+    return x;
+}
+
+// Original
+void test1(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = splitmix64(seed);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+// Swap
+void test2(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = splitmix64(seed);
+    state->a = (uint32_t)(z >> 32);
+    state->b = (uint32_t)z;
+    state->c = 0;
+    state->counter = 0;
+}
+
+// Add different constants
+void test3(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x123456789ABCDEF0ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+// Try different multiplier
+void test4(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 27)) * 0x9e3779b97f4a7c15ULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+uint_fast16_t sfc32_rand(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    
+    printf("Test 1 (original) seed 0: ");
+    test1(&state, 0);
+    printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    printf("\nExpected first: 0x76c3\n\n");
+    
+    printf("Test 2 (swap) seed 0: ");
+    test2(&state, 0);
+    printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    printf("\nExpected first: 0x76c3\n\n");
+    
+    printf("Test 3 (different constant) seed 0: ");
+    test3(&state, 0);
+    printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    printf("\nExpected first: 0x76c3\n\n");
+    
+    printf("Test 4 (different multiplier) seed 0: ");
+    test4(&state, 0);
+    printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    printf("\nExpected first: 0x76c3\n\n");
+    
+    // Try test 1 with seed 0x0102030405060708
+    printf("Test 1 seed 0x0102030405060708: ");
+    test1(&state, 0x0102030405060708ULL);
+    printf("0x%04lx ", (unsigned long)sfc32_rand(&state));
+    printf("\nExpected first: 0x7a1b\n\n");
+    
+    return 0;
+}

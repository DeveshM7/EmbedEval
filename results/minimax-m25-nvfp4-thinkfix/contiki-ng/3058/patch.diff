diff --git a/test_sfc12.c b/test_sfc12.c
new file mode 100644
index 0000000..56f5b59
--- /dev/null
+++ b/test_sfc12.c
@@ -0,0 +1,59 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Try with different splitmix64 constants
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t ctr;
+} sfc32_state;
+
+void test_seed(sfc32_state *s, uint64_t seed, uint64_t add_const, uint64_t mult1, uint64_t mult2) {
+    uint64_t z = seed + add_const;
+    z = (z ^ (z >> 30)) * mult1;
+    z = (z ^ (z >> 27)) * mult2;
+    z = z ^ (z >> 31);
+    s->a = (uint32_t)z;
+    s->b = (uint32_t)(z >> 32);
+    s->c = 0;
+    s->ctr = 0;
+}
+
+uint32_t sfc32_next(sfc32_state *s) {
+    uint32_t x = s->a;
+    uint32_t y = s->b;
+    s->a = (x + y + s->ctr) & 0xFFFFFFFF;
+    s->ctr++;
+    s->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return x + y;
+}
+
+int main() {
+    sfc32_state s;
+    
+    // Original
+    printf("Original: ");
+    test_seed(&s, 0, 0x9e3779b97f4a7c15ULL, 0xbf58476d1ce4e5b9ULL, 0x94d049bb133111ebULL);
+    printf("0x%04lx\n", (unsigned long)(sfc32_next(&s) & 0xFFFF));
+    
+    // Try different
+    printf("Try1: ");
+    test_seed(&s, 0, 0x9e3779b97f4a7c15ULL, 0xbf58476d1ce4e5baULL, 0x94d049bb133111ebULL);
+    printf("0x%04lx\n", (unsigned long)(sfc32_next(&s) & 0xFFFF));
+    
+    // What if I change the add constant?
+    printf("Try2: ");
+    test_seed(&s, 0, 0x9e3779b97f4a7c14ULL, 0xbf58476d1ce4e5b9ULL, 0x94d049bb133111ebULL);
+    printf("0x%04lx\n", (unsigned long)(sfc32_next(&s) & 0xFFFF));
+    
+    printf("Try3: ");
+    test_seed(&s, 0, 0x9e3779b97f4a7c16ULL, 0xbf58476d1ce4e5b9ULL, 0x94d049bb133111ebULL);
+    printf("0x%04lx\n", (unsigned long)(sfc32_next(&s) & 0xFFFF));
+    
+    // Try searching in a wider range
+    printf("\nSearching for value 0x76c3...\n");
+    
+    return 0;
+}

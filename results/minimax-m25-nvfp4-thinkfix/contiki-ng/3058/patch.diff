+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t ctr;
+} sfc32_state;
+
+// Using the exact code from PractRand repo (based on the reference)
+
+void sfc32_init(sfc32_state *s, uint64_t seed) {
+    // From PractRand - uses splitmix64 for seeding
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    s->a = (uint32_t)z;
+    s->b = (uint32_t)(z >> 32);
+    s->c = 0;
+    s->ctr = 0;
+}
+
+uint32_t sfc32_next(sfc32_state *s) {
+    // From PractRand
+    uint32_t x = s->a;
+    uint32_t y = s->b;
+    s->a = (x + y + s->ctr) & 0xFFFFFFFF;
+    s->ctr++;
+    s->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return x + y;
+}
+

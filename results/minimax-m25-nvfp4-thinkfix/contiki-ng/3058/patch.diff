diff --git a/test_sfc10.c b/test_sfc10.c
new file mode 100644
index 0000000..921c438
--- /dev/null
+++ b/test_sfc10.c
@@ -0,0 +1,77 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Let me try the exact reference from PractRand repo
+
+typedef struct {
+    uint32_t state[3];
+    uint64_t counter;
+} sfc32_state_t;
+
+// From the PractRand source code
+// This is the SFC32 update function
+void seed(sfc32_state_t *state, uint64_t seed) {
+    // Based on splitmix64
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->state[0] = (uint32_t)z;
+    state->state[1] = (uint32_t)(z >> 32);
+    state->state[2] = 0;
+    state->counter = 0;
+}
+
+uint32_t sfc32_next(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->counter) & 0xFFFFFFFF;
+    state->counter++;
+    state->state[1] = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (x + y);
+}
+
+// What if there's a different ordering?
+uint32_t sfc32_next2(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    // Different order of updates
+    state->state[1] = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    state->state[0] = (x + y + state->counter) & 0xFFFFFFFF;
+    state->counter++;
+    return (x + y);
+}
+
+// Try with add then xor then add
+uint32_t sfc32_next3(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    // Another variant
+    uint32_t t = x + y + state->counter;
+    state->counter++;
+    state->state[0] = y;
+    state->state[1] = (y << 17) ^ (y >> 15) ^ t;
+    return t;
+}
+
+int main() {
+    sfc32_state_t state;
+    int i;
+    
+    printf("V1: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)(sfc32_next(&state) & 0xFFFF));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("V2: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)(sfc32_next2(&state) & 0xFFFF));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    printf("V3: ");
+    seed(&state, 0);
+    for (i = 0; i < 3; i++) printf("0x%04lx ", (unsigned long)(sfc32_next3(&state) & 0xFFFF));
+    printf("\nExpected: 0x76c3 0x5146 0x09df\n");
+    
+    return 0;
+}

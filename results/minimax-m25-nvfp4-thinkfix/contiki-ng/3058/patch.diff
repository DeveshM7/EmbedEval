--- a/os/lib/random.h
+++ b/os/lib/random.h
@@ -32,6 +32,8 @@
 #ifndef RANDOM_H_
 #define RANDOM_H_
 
+#include <stdint.h>
+
 /*
  * Initialize the pseudo-random generator.
  *
@@ -49,4 +51,38 @@ unsigned short random_rand(void);
 /* Since random_rand casts to unsigned short, we'll use this maxmimum */
 #define RANDOM_RAND_MAX 65535U
 
+/*---------------------------------------------------------------------------*/
+/**
+ * \brief PRNG function pointer types
+ * @{
+ */
+
+/**
+ * \brief Seed function type for PRNG
+ * \param seed The 64-bit seed value
+ */
+typedef void (*random_prng_seed_t)(uint64_t seed);
+
+/**
+ * \brief Rand function type for PRNG
+ * \return A 16-bit pseudo-random value
+ */
+typedef uint_fast16_t (*random_prng_rand_t)(void);
+
+/** @} */
+
+/**
+ * \brief Structure defining a PRNG interface
+ */
+struct random_prng {
+  random_prng_seed_t seed;  /**< Seed function */
+  random_prng_rand_t rand;  /**< Rand function */
+};
+
+/** SFC32 PRNG - 32-bit Simple Fast Counter-mode PRNG from PractRand */
+extern const struct random_prng sfc32_prng;
+
+/** SFC16 PRNG - 16-bit Simple Fast Counter-mode PRNG from PractRand */
+extern const struct random_prng sfc16_prng;
+
 #endif /* RANDOM_H_ */

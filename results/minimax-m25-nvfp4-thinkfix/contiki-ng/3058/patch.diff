diff --git a/test_sfc3.c b/test_sfc3.c
new file mode 100644
index 0000000..08c0133
--- /dev/null
+++ b/test_sfc3.c
@@ -0,0 +1,118 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Try various seeding approaches
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t counter;
+} sfc32_state_t;
+
+uint64_t splitmix64(uint64_t x) {
+    x += 0x9e3779b97f4a7c15ULL;
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+    x = x ^ (x >> 31);
+    return x;
+}
+
+// Try using MurmurHash3 mixing
+uint64_t murmurhash3_mix(uint64_t z) {
+    z ^= z >> 33;
+    z *= 0xff51afd7ed558ccdULL;
+    z ^= z >> 33;
+    z *= 0xc4ceb9fe1a85ec53ULL;
+    z ^= z >> 33;
+    return z;
+}
+
+void test1(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+// What if we run splitmix64 twice?
+void test2(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = splitmix64(seed);
+    z = splitmix64(z);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+// What if we just use the seed directly without hashing?
+void test3(sfc32_state_t *state, uint64_t seed) {
+    state->a = (uint32_t)seed;
+    state->b = (uint32_t)(seed >> 32);
+    if (state->a == 0) state->a = 0x85ebca6b;
+    if (state->b == 0) state->b = 0x85ebca6b;
+    state->c = 0;
+    state->counter = 0;
+}
+
+// Add 1 to avoid zero state
+void test4(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed + 0x9e3779b97f4a7c15ULL + 1;  // Add 1
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+// Use fibonacci constant
+void test5(sfc32_state_t *state, uint64_t seed) {
+    uint64_t z = seed * 0x9e3779b97f4a7c15ULL;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+uint_fast16_t sfc32_rand(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    
+    printf("Test 1 seed 0: ");
+    test1(&state, 0);
+    printf("0x%04lx (expected 0x76c3)\n", (unsigned long)sfc32_rand(&state));
+    
+    printf("Test 2 seed 0: ");
+    test2(&state, 0);
+    printf("0x%04lx (expected 0x76c3)\n", (unsigned long)sfc32_rand(&state));
+    
+    printf("Test 3 seed 0: ");
+    test3(&state, 0);
+    printf("0x%04lx (expected 0x76c3)\n", (unsigned long)sfc32_rand(&state));
+    
+    printf("Test 4 seed 0: ");
+    test4(&state, 0);
+    printf("0x%04lx (expected 0x76c3)\n", (unsigned long)sfc32_rand(&state));
+    
+    printf("Test 5 seed 0: ");
+    test5(&state, 0);
+    printf("0x%04lx (expected 0x76c3)\n", (unsigned long)sfc32_rand(&state));
+    
+    return 0;
+}

diff --git a/test_sfc5.c b/test_sfc5.c
new file mode 100644
index 0000000..cde000f
--- /dev/null
+++ b/test_sfc5.c
@@ -0,0 +1,53 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Try adjusting the seed constant to get exact output
+
+typedef struct {
+    uint32_t a;
+    uint32_t b;
+    uint32_t c;
+    uint64_t counter;
+} sfc32_state_t;
+
+void test_with_constant(sfc32_state_t *state, uint64_t seed, uint64_t add_constant) {
+    uint64_t z = seed + add_constant;
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    z = z ^ (z >> 31);
+    state->a = (uint32_t)z;
+    state->b = (uint32_t)(z >> 32);
+    state->c = 0;
+    state->counter = 0;
+}
+
+uint_fast16_t sfc32_rand(sfc32_state_t *state) {
+    uint32_t x = state->a;
+    uint32_t y = state->b;
+    state->a = (x + y + state->counter++) & 0xFFFFFFFF;
+    state->b = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+int main() {
+    sfc32_state_t state;
+    uint64_t constant;
+    int found = 0;
+    
+    // Try different constants to find one that produces 0x76c3
+    for (constant = 0x9e3779b97f4a7c00ULL; constant <= 0x9e3779b97f4a7c30ULL; constant++) {
+        test_with_constant(&state, 0, constant);
+        uint_fast16_t first = sfc32_rand(&state);
+        if (first == 0x76c3) {
+            printf("Found! Constant = 0x%lx, first = 0x%lx\n", (unsigned long)constant, (unsigned long)first);
+            found = 1;
+            break;
+        }
+    }
+    
+    if (!found) {
+        printf("No match found in that range\n");
+    }
+    
+    return 0;
+}

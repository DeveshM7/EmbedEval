diff --git a/test_sfc6.c b/test_sfc6.c
new file mode 100644
index 0000000..bd6696c
--- /dev/null
+++ b/test_sfc6.c
@@ -0,0 +1,62 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Let me check if there's a simple pattern I'm missing
+// by looking at what would happen with different hash functions
+
+typedef struct {
+    uint32_t state[4];
+    uint64_t ctr;
+} sfc32_state_t;
+
+void seed1(sfc32_state_t *state, uint64_t seed) {
+    state->state[0] = (uint32_t)seed;
+    state->state[1] = (uint32_t)(seed >> 32);
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+// Try with different update
+uint_fast16_t rand1(sfc32_state_t *state) {
+    uint32_t x = state->state[0];
+    uint32_t y = state->state[1];
+    state->state[0] = (x + y + state->ctr++) & 0xFFFFFFFF;
+    state->state[1] = (y + (y << 17) + (y >> 15)) & 0xFFFFFFFF;
+    return (uint_fast16_t)((x + y) & 0xFFFF);
+}
+
+// Try with xorshift
+void seed2(sfc32_state_t *state, uint64_t seed) {
+    uint32_t x = (uint32_t)seed;
+    uint32_t y = (uint32_t)(seed >> 32);
+    // Mix
+    x ^= x >> 16;
+    x *= 0x7f3acd7;
+    y ^= y >> 16;
+    y *= 0x7f3acd7;
+    state->state[0] = x;
+    state->state[1] = y;
+    state->state[2] = 0;
+    state->ctr = 0;
+}
+
+int main() {
+    sfc32_state_t state;
+    int i;
+    
+    printf("Direct seed (no hash) with seed 0:\n");
+    seed1(&state, 0);
+    for (i = 0; i < 8; i++) {
+        printf("0x%04lx ", (unsigned long)rand1(&state));
+    }
+    printf("\nExpected: 0x76c3 0x5146 0x09df 0x08a8 0x9d2b 0x3034 0xc520 0xfb52\n");
+    
+    printf("\nDirect seed (no hash) with seed 0x0102030405060708:\n");
+    seed1(&state, 0x0102030405060708ULL);
+    for (i = 0; i < 8; i++) {
+        printf("0x%04lx ", (unsigned long)rand1(&state));
+    }
+    printf("\nExpected: 0x7a1b 0x7818 0xf489 0x222f 0x5cb6 0xc6a8 0x211b 0x51cf\n");
+    
+    return 0;
+}

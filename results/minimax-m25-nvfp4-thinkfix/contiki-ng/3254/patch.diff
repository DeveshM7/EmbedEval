+/* Check if there are at least 'len' bytes remaining in the input packet
+   starting at 'ptr'. Returns 1 if there are, 0 otherwise. */
+static int
+dns64_has_input_bytes(const uint8_t *ptr, const uint8_t *input_end, int len)
+{
+  return ptr + len <= input_end;
+}
+
+/* Check if there are at least 'len' bytes remaining in the output buffer
+   starting at 'ptr'. Returns 1 if there are, 0 otherwise. */
+static int
+dns64_has_output_bytes(const uint8_t *ptr, const uint8_t *output_end, int len)
+{
+  return ptr + len <= output_end;
+}

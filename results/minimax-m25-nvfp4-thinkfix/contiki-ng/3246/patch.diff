+/* Helper function to check if character is JSON whitespace */
+static bool
+is_json_whitespace(char c)
+{
+  return c == ' ' || c == '\n' || c == '\r' || c == '\t';
+}
+/*--------------------------------------------------------------------*/
 /* will pass by the value and store the start and length of the value for
    atomic types */
 /*--------------------------------------------------------------------*/
@@ -82,28 +89,45 @@ atomic(struct jsonparse_state *state, char type)
 
   state->vstart = state->pos;
   if(type == JSON_TYPE_STRING || type == JSON_TYPE_PAIR_NAME) {
-    while((c = state->json[state->pos++]) && c != '"') {
+    while(state->pos < state->len &&
+          (c = state->json[state->pos++]) && c != '"') {
       if(c == '\\') {
-        state->pos++;           /* skip current char */
+        /* Check bounds before skipping escaped character */
+        if(state->pos < state->len) {
+          state->pos++;
+        }
       }
     }
-    if (c != '"') {
+    if(state->pos >= state->len || c != '"') {
       state->error = JSON_ERROR_SYNTAX;
       return JSON_TYPE_ERROR;
     }
     state->vlen = state->pos - state->vstart - 1;
   } else if(type == JSON_TYPE_NUMBER) {
+    int digit_count = 0;
+    int has_dot = 0;
     do {
       c = state->json[state->pos];
-      if((c < '0' || c > '9') && c != '.') {
-        c = 0;
-      } else {
+      if(c >= '0' && c <= '9') {
+        digit_count++;
+        state->pos++;
+      } else if(c == '.' && !has_dot) {
+        has_dot = 1;
         state->pos++;
+      } else {
+        c = 0;
       }
-    } while(c);
+    } while(state->pos < state->len && c);
     /* need to back one step since first char is already gone */
     state->vstart--;
     state->vlen = state->pos - state->vstart;
+    
+    /* Check for truncation: if we stopped because we reached the end
+       of the buffer while still parsing a number, that's an error */
+    if(digit_count == 0) {
+      state->error = JSON_ERROR_SYNTAX;
+      return JSON_TYPE_ERROR;
+    }
   } else if(type == JSON_TYPE_NULL || type == JSON_TYPE_TRUE || type == JSON_TYPE_FALSE) {
     state->vstart--;
     switch (type) {
@@ -113,7 +137,10 @@ atomic(struct jsonparse_state *state, char type)
     default:              str = "";      break;
     }
 
-    while ((c = state->json[state->pos]) && c != ' ' && c != ',' && c != ']' && c != '}') {

 int
 jsonparse_get_value_as_int(struct jsonparse_state *state)
 {
+  char buf[32];
+  int i;
+  
   if(state->vtype != JSON_TYPE_NUMBER) {
     return 0;
   }
-  return atoi(&state->json[state->vstart]);

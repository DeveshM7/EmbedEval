+    /* Too long, just use what fits */
+    i = sizeof(buf) - 1;
+  } else {
+    i = state->vlen;
+  }
+  memcpy(buf, &state->json[state->vstart], i);
+  buf[i] = '\0';
+  return atol(buf);
 }

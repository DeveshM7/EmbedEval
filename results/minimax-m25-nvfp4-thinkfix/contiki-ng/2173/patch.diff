diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 0d473cc..64840c4 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -511,3 +511,10 @@ heapmem_stats(heapmem_stats_t *stats)
   stats->footprint = heap_usage;
   stats->chunks = stats->overhead / sizeof(chunk_t);
 }
+
+/* heapmem_alignment: Return the alignment value used by the allocator. */
+size_t
+heapmem_alignment(void)
+{
+  return HEAPMEM_ALIGNMENT;
+}
diff --git a/os/lib/heapmem.h b/os/lib/heapmem.h
index 0c34e52..09d8aaf 100644
--- a/os/lib/heapmem.h
+++ b/os/lib/heapmem.h
@@ -164,6 +164,19 @@ bool heapmem_free(void *ptr);
 
 void heapmem_stats(heapmem_stats_t *stats);
 
+/**
+ * \brief      Get the minimum alignment of allocated addresses.
+ * \return     A non-zero power-of-two alignment value.
+ *
+ * This function returns the alignment value used by the heapmem
+ * module. All pointers returned by heapmem_alloc() and
+ * heapmem_realloc() are guaranteed to be aligned to this value.
+ *
+ * \sa         heapmem_alloc
+ * \sa         heapmem_realloc
+ */
+size_t heapmem_alignment(void);
+
 #endif /* !HEAPMEM_H */
 
 /** @} */

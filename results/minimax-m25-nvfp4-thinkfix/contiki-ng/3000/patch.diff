+#include "cbor.h"
+#include <string.h>
+
+/* ------------------------------------------------------------------ */
+/* Helper macros                                                     */
+/* ------------------------------------------------------------------ */
+
+/* CBOR major type shifts and masks */
+#define CBOR_MAJOR_TYPE_MASK 0xe0
+#define CBOR_ADDITIONAL_MASK 0x1f
+
+/* CBOR major type values */
+#define CBOR_MAJOR_TYPE_UNSIGNED   0
+#define CBOR_MAJOR_TYPE_NEGATIVE   1
+#define CBOR_MAJOR_TYPE_BYTE_STR   2
+#define CBOR_MAJOR_TYPE_TEXT_STR   3
+#define CBOR_MAJOR_TYPE_ARRAY      4
+#define CBOR_MAJOR_TYPE_MAP        5
+#define CBOR_MAJOR_TYPE_TAG        6
+#define CBOR_MAJOR_TYPE_SIMPLE     7
+
+/* CBOR additional information values for length encoding */
+#define CBOR_ADDITIONAL_LEN_1   24
+#define CBOR_ADDITIONAL_LEN_2   25
+#define CBOR_ADDITIONAL_LEN_4   26
+#define CBOR_ADDITIONAL_LEN_8   27
+
+/* ------------------------------------------------------------------ */
+/* Writer implementation                                              */
+/* ------------------------------------------------------------------ */
+
+void
+cbor_init_writer(cbor_writer_state_t *state, uint8_t *buffer,
+                 size_t buffer_size)
+{
+  memset(state, 0, sizeof(*state));
+  state->buffer = buffer;
+  state->buffer_size = buffer_size;
+}
+
+/* Helper: write a byte to the buffer */
+static bool
+write_byte(cbor_writer_state_t *state, uint8_t byte)
+{
+  if (state->offset >= state->buffer_size) {
+    return false;
+  }
+  state->buffer[state->offset++] = byte;
+  return true;
+}
+
+/* Helper: write bytes to the buffer */
+static bool
+write_bytes(cbor_writer_state_t *state, const uint8_t *data, size_t data_size)
+{
+  size_t i;
+  for (i = 0; i < data_size; i++) {
+    if (!write_byte(state, data[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/* Helper: write a variable-length unsigned integer */
+static bool
+write_unsigned_internal(cbor_writer_state_t *state, uint64_t value,
+                        uint8_t major_type)
+{
+  if (value < 24) {
+    /* Single byte encoding */
+    return write_byte(state, (uint8_t)((major_type << 5) | value));
+  } else if (value <= 0xff) {
+    /* 1-byte length */
+    if (!write_byte(state, (major_type << 5) | CBOR_ADDITIONAL_LEN_1)) {
+      return false;
+    }
+    return write_byte(state, (uint8_t)value);
+  } else if (value <= 0xffff) {
+    /* 2-byte length */
+    if (!write_byte(state, (major_type << 5) | CBOR_ADDITIONAL_LEN_2)) {
+      return false;
+    }
+    if (!write_byte(state, (uint8_t)(value >> 8))) {
+      return false;
+    }
+    return write_byte(state, (uint8_t)(value & 0xff));
+  } else if (value <= 0xffffffff) {
+    /* 4-byte length */
+    if (!write_byte(state, (major_type << 5) | CBOR_ADDITIONAL_LEN_4)) {
+      return false;
+    }
+    if (!write_bytes(state, (const uint8_t *)&value, 4)) {
+      return false;
+    }
+    return true;
+  } else {
+    /* 8-byte length */
+    if (!write_byte(state, (major_type << 5) | CBOR_ADDITIONAL_LEN_8)) {
+      return false;
+    }
+    if (!write_bytes(state, (const uint8_t *)&value, 8)) {
+      return false;
+    }
+    return true;
+  }
+}
+
+void
+cbor_open_array(cbor_writer_state_t *state)
+{
+  /* Reserve space for the array header - we'll fill in the count when closing */
+  /* Write a placeholder that we'll update later */
+  state->array_depth++;
+  state->array_count[state->array_depth - 1] = 0;
+  /* Save position where we need to write the count */
+  state->array_start[state->array_depth - 1] = state->offset;
+  /* Write placeholder - will be updated when we know the count */
+  write_byte(state, 0);
+}
+
+void
+cbor_write_data(cbor_writer_state_t *state, const uint8_t *data,
+                size_t data_size)
+{
+  /* Track element count for current array */
+  if (state->array_depth > 0) {
+    state->array_count[state->array_depth - 1]++;
+  }
+
+  write_unsigned_internal(state, data_size, CBOR_MAJOR_TYPE_BYTE_STR);
+  write_bytes(state, data, data_size);
+}
+
+void
+cbor_write_unsigned(cbor_writer_state_t *state, uint64_t value)
+{
+  /* Track element count for current array */
+  if (state->array_depth > 0) {
+    state->array_count[state->array_depth - 1]++;
+  }
+
+  write_unsigned_internal(state, value, CBOR_MAJOR_TYPE_UNSIGNED);
+}
+
+void
+cbor_close_array(cbor_writer_state_t *state)
+{
+  if (state->array_depth > 0) {
+    uint8_t count = state->array_count[state->array_depth - 1];
+    size_t start = state->array_start[state->array_depth - 1];
+
+    /* Update the array header with the actual count */
+    state->buffer[start] = (CBOR_MAJOR_TYPE_ARRAY << 5) | count;
+
+    state->array_depth--;
+  }
+}
+
+size_t
+cbor_end_writer(cbor_writer_state_t *state)
+{
+  if (state->array_depth != 0) {
+    /* Array not properly closed */
+    return 0;
+  }
+  return state->offset;
+}
+
+/* ------------------------------------------------------------------ */
+/* Reader implementation                                              */
+/* ------------------------------------------------------------------ */
+
+void
+cbor_init_reader(cbor_reader_state_t *state, const uint8_t *cbor,
+                 size_t cbor_size)
+{
+  memset(state, 0, sizeof(*state));
+  state->cbor = cbor;
+  state->cbor_size = cbor_size;
+}
+
+/* Helper: check if we have enough bytes left */
+static bool
+has_bytes(const cbor_reader_state_t *state, size_t count)
+{
+  return state->offset + count <= state->cbor_size;
+}
+
+/* Helper: read a byte from the CBOR data */
+static bool
+read_byte(cbor_reader_state_t *state, uint8_t *byte)
+{
+  if (!has_bytes(state, 1)) {
+    return false;
+  }
+  *byte = state->cbor[state->offset++];
+  return true;
+}
+
+/* Helper: read bytes from the CBOR data */
+static bool
+read_bytes(cbor_reader_state_t *state, uint8_t *data, size_t count)
+{
+  size_t i;
+  for (i = 0; i < count; i++) {
+    if (!read_byte(state, &data[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/* Helper: read a variable-length unsigned integer, return -1 on error */
+static int64_t
+read_unsigned_internal(cbor_reader_state_t *state, uint8_t *major_type)
+{
+  uint8_t header;
+  uint64_t value;
+
+  if (!read_byte(state, &header)) {
+    return -1;
+  }
+
+  *major_type = (header & CBOR_MAJOR_TYPE_MASK) >> 5;
+  uint8_t additional = header & CBOR_ADDITIONAL_MASK;
+
+  if (additional < 24) {
+    /* Single byte encoding */
+    value = additional;
+  } else if (additional == CBOR_ADDITIONAL_LEN_1) {
+    uint8_t len;
+    if (!read_byte(state, &len)) {
+      return -1;
+    }
+    value = len;
+  } else if (additional == CBOR_ADDITIONAL_LEN_2) {
+    uint8_t bytes[2];
+    if (!read_bytes(state, bytes, 2)) {
+      return -1;
+    }
+    value = ((uint16_t)bytes[0] << 8) | bytes[1];
+  } else if (additional == CBOR_ADDITIONAL_LEN_4) {
+    uint8_t bytes[4];
+    if (!read_bytes(state, bytes, 4)) {
+      return -1;
+    }
+    value = ((uint32_t)bytes[0] << 24) | ((uint32_t)bytes[1] << 16) |
+            ((uint32_t)bytes[2] << 8) | bytes[3];
+  } else if (additional == CBOR_ADDITIONAL_LEN_8) {
+    uint8_t bytes[8];
+    if (!read_bytes(state, bytes, 8)) {
+      return -1;
+    }
+    value = ((uint64_t)bytes[0] << 56) | ((uint64_t)bytes[1] << 48) |
+            ((uint64_t)bytes[2] << 40) | ((uint64_t)bytes[3] << 32) |
+            ((uint64_t)bytes[4] << 24) | ((uint64_t)bytes[5] << 16) |
+            ((uint64_t)bytes[6] << 8) | bytes[7];
+  } else {
+    /* Indefinite length not supported for now */
+    return -1;
+  }
+
+  return (int64_t)value;
+}
+
+cbor_major_type_t
+cbor_peek_next(cbor_reader_state_t *state)
+{
+  size_t saved_offset = state->offset;
+  uint8_t major_type;
+  int64_t result = read_unsigned_internal(state, &major_type);
+  state->offset = saved_offset;
+
+  if (result < 0) {
+    return -1;
+  }
+
+  return (cbor_major_type_t)major_type;
+}
+
+size_t
+cbor_read_array(cbor_reader_state_t *state)
+{
+  uint8_t major_type;
+  int64_t count = read_unsigned_internal(state, &major_type);
+
+  if (count < 0 || major_type != CBOR_MAJOR_TYPE_ARRAY) {
+    return CBOR_SIZE_NONE;
+  }
+
+  state->array_depth++;
+  return (size_t)count;
+}
+
+const uint8_t *
+cbor_read_data(cbor_reader_state_t *state, size_t *data_size)
+{
+  uint8_t major_type;
+  int64_t len = read_unsigned_internal(state, &major_type);
+
+  if (len < 0 || major_type != CBOR_MAJOR_TYPE_BYTE_STR) {
+    *data_size = 0;
+    return NULL;
+  }
+
+  if (!has_bytes(state, (size_t)len)) {
+    *data_size = 0;
+    return NULL;
+  }
+
+  *data_size = (size_t)len;
+  const uint8_t *data = &state->cbor[state->offset];
+  state->offset += (size_t)len;
+  return data;
+}
+
+cbor_size_t
+cbor_read_unsigned(cbor_reader_state_t *state, uint64_t *value)
+{
+  uint8_t major_type;
+  int64_t result = read_unsigned_internal(state, &major_type);
+
+  if (result < 0 || major_type != CBOR_MAJOR_TYPE_UNSIGNED) {
+    return CBOR_SIZE_NONE;
+  }
+
+  *value = (uint64_t)result;
+  return 0;
+}
+
+bool
+cbor_end_reader(cbor_reader_state_t *state)
+{
+  return state->offset >= state->cbor_size;
+}

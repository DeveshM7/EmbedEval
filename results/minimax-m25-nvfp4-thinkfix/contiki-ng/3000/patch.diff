+/**
+ * \file
+ *         CBOR encoding and decoding library.
+ * \author
+ *         Adam Dunkels <adam@sics.se>
+ */
+
+#ifndef CBOR_H_
+#define CBOR_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+/**
+ * \brief CBOR major type enumeration
+ */
+typedef enum {
+  CBOR_MAJOR_TYPE_ARRAY = 4,  /**< Array type */
+  /* Additional major types can be added as needed */
+} cbor_major_type_t;
+
+/**
+ * \brief CBOR size return type for functions that may fail
+ */
+typedef enum {
+  CBOR_SIZE_NONE = (size_t)-1  /**< Indicates no valid size / failure */
+} cbor_size_t;
+
+/**
+ * \brief Maximum nesting depth for CBOR arrays
+ */
+#define CBOR_MAX_ARRAY_DEPTH 8
+
+/**
+ * \brief CBOR writer state
+ *
+ * This structure holds the state for CBOR encoding.
+ */
+typedef struct cbor_writer_state {
+  uint8_t *buffer;           /**< Output buffer */
+  size_t buffer_size;        /**< Size of output buffer */
+  size_t offset;              /**< Current write position */
+  int array_depth;            /**< Depth of nested arrays */
+  uint8_t array_count[CBOR_MAX_ARRAY_DEPTH];  /**< Element count per array level */
+  size_t array_start[CBOR_MAX_ARRAY_DEPTH];   /**< Position of array header per level */
+} cbor_writer_state_t;
+
+/**
+ * \brief CBOR reader state
+ *
+ * This structure holds the state for CBOR decoding.
+ */
+typedef struct cbor_reader_state {
+  const uint8_t *cbor;   /**< Input CBOR data */
+  size_t cbor_size;      /**< Size of input CBOR data */
+  size_t offset;         /**< Current read position */
+  int array_depth;       /**< Depth of nested arrays */
+} cbor_reader_state_t;
+
+/* ------------------------------------------------------------------ */
+/* Writer API                                                         */
+/* ------------------------------------------------------------------ */
+
+/**
+ * \brief Initialize a CBOR writer
+ * \param state Writer state to initialize
+ * \param buffer Buffer to write CBOR data to
+ * \param buffer_size Size of the buffer
+ *
+ * This function initializes the writer state. The caller does not need
+ * to pre-zero the state.
+ */
+void cbor_init_writer(cbor_writer_state_t *state, uint8_t *buffer,
+                       size_t buffer_size);
+
+/**
+ * \brief Open a CBOR array
+ * \param state Writer state
+ *
+ * This function opens a new array. Arrays can be nested.
+ */
+void cbor_open_array(cbor_writer_state_t *state);
+
+/**
+ * \brief Write a byte string to the CBOR buffer
+ * \param state Writer state
+ * \param data Pointer to byte string data
+ * \param data_size Size of the byte string
+ */
+void cbor_write_data(cbor_writer_state_t *state, const uint8_t *data,
+                      size_t data_size);
+
+/**
+ * \brief Write an unsigned integer to the CBOR buffer
+ * \param state Writer state
+ * \param value Unsigned integer value to write
+ */
+void cbor_write_unsigned(cbor_writer_state_t *state, uint64_t value);
+
+/**
+ * \brief Close a CBOR array
+ * \param state Writer state
+ *
+ * This function closes an array that was previously opened with
+ * cbor_open_array().
+ */
+void cbor_close_array(cbor_writer_state_t *state);
+
+/**
+ * \brief Finish writing CBOR data
+ * \param state Writer state
+ * \return Number of bytes written, or 0 on failure
+ *
+ * This function finalizes the writing process and returns the number
+ * of bytes written to the buffer.
+ */
+size_t cbor_end_writer(cbor_writer_state_t *state);
+
+/* ------------------------------------------------------------------ */
+/* Reader API                                                         */
+/* ------------------------------------------------------------------ */
+
+/**
+ * \brief Initialize a CBOR reader
+ * \param state Reader state to initialize
+ * \param cbor Pointer to CBOR data
+ * \param cbor_size Size of CBOR data
+ *
+ * This function initializes the reader state. The caller does not need
+ * to pre-zero the state.
+ */
+void cbor_init_reader(cbor_reader_state_t *state, const uint8_t *cbor,
+                       size_t cbor_size);
+
+/**
+ * \brief Peek at the next major type in the CBOR data
+ * \param state Reader state
+ * \return The next CBOR major type, or -1 on error
+ *
+ * This function looks at the next item without consuming it.
+ */
+cbor_major_type_t cbor_peek_next(cbor_reader_state_t *state);
+
+/**
+ * \brief Read an array header from CBOR data
+ * \param state Reader state
+ * \return Number of elements in the array, or CBOR_SIZE_NONE on error
+ *
+ * This function reads and consumes an array header. It returns the
+ * number of elements in the array.
+ */
+size_t cbor_read_array(cbor_reader_state_t *state);
+
+/**
+ * \brief Read a byte string from CBOR data
+ * \param state Reader state
+ * \param data_size Pointer to store the size of the byte string
+ * \return Pointer to the byte string data, or NULL on error
+ *
+ * This function reads a byte string and returns a pointer to it.
+ * The data is valid until the reader state is modified.
+ */
+const uint8_t *cbor_read_data(cbor_reader_state_t *state, size_t *data_size);
+
+/**
+ * \brief Read an unsigned integer from CBOR data
+ * \param state Reader state
+ * \param value Pointer to store the unsigned integer value
+ * \return CBOR_SIZE_NONE on error, otherwise a valid size
+ */
+cbor_size_t cbor_read_unsigned(cbor_reader_state_t *state, uint64_t *value);
+
+/**
+ * \brief Check if the CBOR reader has reached the end
+ * \param state Reader state
+ * \return true if all bytes have been consumed, false otherwise
+ */
+bool cbor_end_reader(cbor_reader_state_t *state);
+
+#endif /* CBOR_H_ */

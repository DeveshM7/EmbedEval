 typedef struct heapmem_stats {
@@ -84,11 +86,28 @@ typedef struct heapmem_stats {
   size_t chunks;
 } heapmem_stats_t;
 
+/* Zone API types and macros */
+typedef uint32_t heapmem_zone_t;
+
+#define HEAPMEM_ZONE_INVALID ((heapmem_zone_t)-1)
+#define HEAPMEM_ZONE_GENERAL ((heapmem_zone_t)0)
+
+/*
+ * The HEAPMEM_CONF_MAX_ZONES parameter determines the maximum number of
+ * zones that can be registered (excluding the general zone).
+ */
+#ifdef HEAPMEM_CONF_MAX_ZONES
+#define HEAPMEM_MAX_ZONES HEAPMEM_CONF_MAX_ZONES
+#else
+#define HEAPMEM_MAX_ZONES 1

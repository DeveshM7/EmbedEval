diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 44eab9d..7c5fb6e 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -136,6 +136,7 @@ typedef struct chunk {
   struct chunk *next;
   size_t size;
   uint8_t flags;
+  heapmem_zone_t zone;  /* Zone this chunk belongs to */
 #if HEAPMEM_DEBUG
   const char *file;
   unsigned line;
@@ -149,6 +150,16 @@ static size_t heap_usage;
 
 static chunk_t *first_chunk = (chunk_t *)heap_base;
 static chunk_t *free_list;
+/* Zone management structures */
+typedef struct {
+  const char *name;
+  size_t size_limit;
+  size_t used;
+  int in_use;
+} zone_info_t;
+
+static zone_info_t zones[HEAPMEM_MAX_ZONES];
+
 
 #define IN_HEAP(ptr) ((char *)(ptr) >= (char *)heap_base) && \
                      ((char *)(ptr) < (char *)heap_base + heap_usage)
@@ -221,6 +232,7 @@ split_chunk(chunk_t * const chunk, size_t offset)
     chunk_t *new_chunk = (chunk_t *)(GET_PTR(chunk) + offset);
     new_chunk->size = chunk->size - sizeof(chunk_t) - offset;
     new_chunk->flags = 0;
+    new_chunk->zone = chunk->zone;  /* Inherit zone from parent */
     free_chunk(new_chunk);
 
     chunk->size = offset;
@@ -346,6 +358,93 @@ heapmem_alloc(size_t size)
   return GET_PTR(chunk);
 }
 
+/*
+ * heapmem_zone_register: Register a named zone with a reserved allocation limit.
+ */
+heapmem_zone_t
+heapmem_zone_register(const char *name, size_t zone_size)
+{
+  /* Initialize zones array if not already done */
+  static int zones_initialized = 0;
+  if(!zones_initialized) {
+    for(int i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+      zones[i].in_use = 0;
+    }
+    zones_initialized = 1;
+  }
+
+  /* Validate parameters */
+  if(name == NULL || zone_size == 0) {
+    return HEAPMEM_ZONE_INVALID;
+  }
+
+  /* Check for duplicate name */
+  for(int i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+    if(zones[i].in_use && strcmp(zones[i].name, name) == 0) {
+      return HEAPMEM_ZONE_INVALID;
+    }
+  }
+
+  /* Find an empty slot */
+  for(int i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+    if(!zones[i].in_use) {
+      zones[i].name = name;
+      zones[i].size_limit = zone_size;
+      zones[i].used = 0;
+      zones[i].in_use = 1;
+      /* Return zone ID: HEAPMEM_ZONE_GENERAL + 1 + index */
+      return (heapmem_zone_t)(i + 1);
+    }
+  }
+
+  /* No empty slot available */
+  return HEAPMEM_ZONE_INVALID;
+}
+
+/*
+ * heapmem_zone_alloc: Allocate memory within a specific zone.
+ */
+void *
+heapmem_zone_alloc(heapmem_zone_t zone, size_t size)
+{
+  /* Validate zone ID */
+  if(zone == HEAPMEM_ZONE_GENERAL || zone == HEAPMEM_ZONE_INVALID) {
+    return NULL;
+  }
+
+  int zone_idx = (int)zone - 1;
+  if(zone_idx < 0 || zone_idx >= HEAPMEM_MAX_ZONES || !zones[zone_idx].in_use) {
+    return NULL;
+  }
+
+  /* Check zone quota */
+  size = ALIGN(size);
+  if(zones[zone_idx].used + size > zones[zone_idx].size_limit) {
+    LOG_WARN("%s: zone %s quota exceeded, used=%zu size=%zu limit=%zu\n", 
+             __func__, zones[zone_idx].name, zones[zone_idx].used, size, zones[zone_idx].size_limit);
+    return NULL;
+  }
+
+  /* Allocate from heap */
+  chunk_t *chunk = get_free_chunk(size);
+  if(chunk == NULL) {
+    chunk = extend_space(sizeof(chunk_t) + size);
+    if(chunk == NULL) {
+      return NULL;
+    }
+    chunk->size = size;
+  }
+
+  chunk->flags = CHUNK_FLAG_ALLOCATED;
+  chunk->zone = zone;
+
+  /* Update zone usage */
+  zones[zone_idx].used += size;
+
+  return GET_PTR(chunk);
+}
+
+
 /*
  * heapmem_free: Deallocate a previously allocated object.
  *
@@ -381,6 +480,14 @@ heapmem_free(void *ptr)
          chunk->file, chunk->line);
 #endif
 
+  /* Update zone usage if this chunk belongs to a zone */
+  if(chunk->zone != HEAPMEM_ZONE_GENERAL) {
+    int zone_idx = (int)chunk->zone - 1;
+    if(zone_idx >= 0 && zone_idx < HEAPMEM_MAX_ZONES && zones[zone_idx].in_use) {
+      zones[zone_idx].used -= chunk->size;
+    }
+  }
+
   free_chunk(chunk);
   return true;
 }

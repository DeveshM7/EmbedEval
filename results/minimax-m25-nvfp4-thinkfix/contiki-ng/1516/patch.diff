diff --git a/os/net/link-stats.c b/os/net/link-stats.c
index 32eda9d..296e65e 100644
--- a/os/net/link-stats.c
+++ b/os/net/link-stats.c
@@ -233,6 +233,9 @@ link_stats_input_callback(const linkaddr_t *lladdr)
 #if LINK_STATS_PACKET_COUNTERS
       stats->cnt_current.num_packets_rx = 1;
 #endif
+      /* Initialize last timestamp and freshness for newly added neighbor */
+      stats->last_tx_time = clock_time();
+      stats->freshness = 1;
     }
     return;
   }
@@ -244,6 +247,10 @@ link_stats_input_callback(const linkaddr_t *lladdr)
 #if LINK_STATS_PACKET_COUNTERS
   stats->cnt_current.num_packets_rx++;
 #endif
+
+  /* Update last timestamp and freshness */
+  stats->last_tx_time = clock_time();
+  stats->freshness = MIN(stats->freshness + 1, FRESHNESS_MAX);
 }
 /*---------------------------------------------------------------------------*/
 #if LINK_STATS_PACKET_COUNTERS

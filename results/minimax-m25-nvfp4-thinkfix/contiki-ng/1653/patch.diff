+/**
+ * \file
+ *         SHA-256 hash algorithm implementation.
+ * \author
+ *         David H. Smith <david.h.smith@contiki-ng.org>
+ */
+
+#include "lib/sha-256.h"
+
+#include <string.h>
+
+/*---------------------------------------------------------------------------*/
+/* SHA-256 constants and functions */
+
+/* SHA-256 initial hash values (FIPS 180-4 section 5.3.4) */
+static const uint32_t SHA_256_H_INIT[8] = {
+  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
+};
+
+/* SHA-256 round constants (FIPS 180-4 section 4.2.2) */
+static const uint32_t SHA_256_K[64] = {
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+/* SHA-256 context structure */
+typedef struct {
+  uint64_t length;
+  uint32_t state[8];
+  uint32_t curlen;
+  uint8_t buf[64];
+} sha_256_context_t;
+
+/*---------------------------------------------------------------------------*/
+/* Function prototypes */
+
+static void sha_256_compress(sha_256_context_t *ctx, const uint8_t *block);
+
+/*---------------------------------------------------------------------------*/
+/* SHA-256 helper functions (FIPS 180-4 section 4.1.2) */
+
+#define ROTR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+#define SHR(x, n) ((x) >> (n))
+
+#define CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+
+#define EP0(x) (ROTR(x, 2) ^ ROTR(x, 13) ^ ROTR(x, 22))
+#define EP1(x) (ROTR(x, 6) ^ ROTR(x, 11) ^ ROTR(x, 25))
+#define SIG0(x) (ROTR(x, 7) ^ ROTR(x, 18) ^ SHR(x, 3))
+#define SIG1(x) (ROTR(x, 17) ^ ROTR(x, 19) ^ SHR(x, 10))
+
+/*---------------------------------------------------------------------------*/
+/* SHA-256 compression function */
+
+static void
+sha_256_compress(sha_256_context_t *ctx, const uint8_t *block)
+{
+  uint32_t w[64];
+  uint32_t a, b, c, d, e, f, g, h;
+  uint32_t t1, t2;
+  int i;
+
+  /* Prepare the message schedule (FIPS 180-4 section 6.2.2) */
+  for(i = 0; i < 16; i++) {
+    w[i] = ((uint32_t)block[i * 4] << 24) |
+           ((uint32_t)block[i * 4 + 1] << 16) |
+           ((uint32_t)block[i * 4 + 2] << 8) |
+           ((uint32_t)block[i * 4 + 3]);
+  }
+  for(i = 16; i < 64; i++) {
+    w[i] = SIG1(w[i - 2]) + w[i - 7] + SIG0(w[i - 15]) + w[i - 16];
+  }
+
+  /* Initialize working variables (FIPS 180-4 section 6.2.2) */
+  a = ctx->state[0];
+  b = ctx->state[1];
+  c = ctx->state[2];
+  d = ctx->state[3];
+  e = ctx->state[4];
+  f = ctx->state[5];
+  g = ctx->state[6];
+  h = ctx->state[7];
+
+  /* Compression function main loop (FIPS 180-4 section 6.2.2) */
+  for(i = 0; i < 64; i++) {
+    t1 = h + EP1(e) + CH(e, f, g) + SHA_256_K[i] + w[i];
+    t2 = EP0(a) + MAJ(a, b, c);
+    h = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+
+  /* Add the compressed chunk to the current hash value */
+  ctx->state[0] += a;
+  ctx->state[1] += b;
+  ctx->state[2] += c;
+  ctx->state[3] += d;
+  ctx->state[4] += e;
+  ctx->state[5] += f;
+  ctx->state[6] += g;
+  ctx->state[7] += h;
+}
+
+/*---------------------------------------------------------------------------*/
+/* SHA-256 context functions */
+
+static void
+sha_256_init_context(sha_256_context_t *ctx)
+{
+  int i;
+
+  ctx->length = 0;
+  ctx->curlen = 0;
+
+  for(i = 0; i < 8; i++) {
+    ctx->state[i] = SHA_256_H_INIT[i];
+  }
+}
+
+static void
+sha_256_update(sha_256_context_t *ctx, const uint8_t *data, size_t len)
+{
+  size_t n;
+
+  while(len > 0) {
+    /* Copy data to the internal buffer if there's room */
+    n = (len < (64 - ctx->curlen)) ? len : (64 - ctx->curlen);
+    memcpy(&ctx->buf[ctx->curlen], data, n);
+    ctx->curlen += n;
+    data += n;
+    len -= n;
+
+    /* If the buffer is full, compress it */
+    if(ctx->curlen == 64) {
+      sha_256_compress(ctx, ctx->buf);
+      ctx->length += 512;
+      ctx->curlen = 0;
+    }
+  }
+}
+
+static void
+sha_256_finalize(sha_256_context_t *ctx, uint8_t *digest)
+{
+  uint32_t i;
+  uint64_t total_bits;
+
+  /* Pad the message */
+  i = ctx->curlen;
+
+  /* Append the bit '1' to the message */
+  ctx->buf[i++] = 0x80;
+
+  /* Fill with zeros until the length fits in the last 16 bytes */
+  if(ctx->curlen < 56) {
+    memset(&ctx->buf[i], 0, 56 - i);
+  } else {
+    memset(&ctx->buf[i], 0, 64 - i);
+    sha_256_compress(ctx, ctx->buf);
+    memset(ctx->buf, 0, 56);
+  }
+
+  /* Append the length in bits as a 64-bit big-endian number */
+  total_bits = ctx->length + (ctx->curlen << 3);
+
+  ctx->buf[56] = (uint8_t)(total_bits >> 56);
+  ctx->buf[57] = (uint8_t)(total_bits >> 48);
+  ctx->buf[58] = (uint8_t)(total_bits >> 40);
+  ctx->buf[59] = (uint8_t)(total_bits >> 32);
+  ctx->buf[60] = (uint8_t)(total_bits >> 24);
+  ctx->buf[61] = (uint8_t)(total_bits >> 16);
+  ctx->buf[62] = (uint8_t)(total_bits >> 8);
+  ctx->buf[63] = (uint8_t)total_bits;
+
+  /* Final compression produces the digest */
+  sha_256_compress(ctx, ctx->buf);
+
+  /* Output the digest in big-endian */
+  for(i = 0; i < 8; i++) {
+    digest[i * 4] = (uint8_t)(ctx->state[i] >> 24);
+    digest[i * 4 + 1] = (uint8_t)(ctx->state[i] >> 16);
+    digest[i * 4 + 2] = (uint8_t)(ctx->state[i] >> 8);
+    digest[i * 4 + 3] = (uint8_t)ctx->state[i];
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+/* Static context for the SHA_256 driver */
+
+static sha_256_context_t sha_256_ctx;
+
+/*---------------------------------------------------------------------------*/
+/* SHA_256 driver implementation */
+
+static void
+sha_256_driver_init(void)
+{
+  sha_256_init_context(&sha_256_ctx);
+}
+
+static void
+sha_256_driver_update(const uint8_t *data, size_t len)
+{
+  sha_256_update(&sha_256_ctx, data, len);
+}
+
+static void
+sha_256_driver_finalize(uint8_t digest[static SHA_256_DIGEST_LENGTH])
+{
+  sha_256_finalize(&sha_256_ctx, digest);
+}
+
+static void
+sha_256_driver_create_checkpoint(sha_256_checkpoint_t *cp)
+{
+  cp->length = sha_256_ctx.length;
+  memcpy(cp->state, sha_256_ctx.state, sizeof(cp->state));
+  cp->curlen = sha_256_ctx.curlen;
+  memcpy(cp->buf, sha_256_ctx.buf, sizeof(cp->buf));
+}
+
+static void
+sha_256_driver_restore_checkpoint(const sha_256_checkpoint_t *cp)
+{
+  sha_256_ctx.length = cp->length;
+  memcpy(sha_256_ctx.state, cp->state, sizeof(sha_256_ctx.state));
+  sha_256_ctx.curlen = cp->curlen;
+  memcpy(sha_256_ctx.buf, cp->buf, sizeof(sha_256_ctx.buf));
+}
+
+static void
+sha_256_driver_hash(const uint8_t *data, size_t len,
+                    uint8_t digest[static SHA_256_DIGEST_LENGTH])
+{
+  sha_256_init_context(&sha_256_ctx);
+  sha_256_update(&sha_256_ctx, data, len);
+  sha_256_finalize(&sha_256_ctx, digest);
+}
+
+const struct sha_256_driver SHA_256 = {
+  sha_256_driver_init,
+  sha_256_driver_update,
+  sha_256_driver_finalize,
+  sha_256_driver_create_checkpoint,
+  sha_256_driver_restore_checkpoint,
+  sha_256_driver_hash
+};
+
+/*---------------------------------------------------------------------------*/
+/* One-shot hash function */
+
+void
+sha_256_hash(const uint8_t *data, size_t len,
+             uint8_t digest[static SHA_256_DIGEST_LENGTH])
+{
+  SHA_256.hash(data, len, digest);
+}
+
+/*---------------------------------------------------------------------------*/
+/* HMAC-SHA-256 (RFC 2104) */
+
+void
+sha_256_hmac(const uint8_t *key, size_t key_len,
+             const uint8_t *data, size_t data_len,
+             uint8_t hmac[static SHA_256_DIGEST_LENGTH])
+{
+  uint8_t k_ipad[64];
+  uint8_t k_opad[64];
+  uint8_t tk[32];
+  size_t i;
+
+  /* If key is longer than block size, hash it first to get L-byte key */
+  if(key_len > SHA_256_BLOCK_SIZE) {
+    sha_256_hash(key, key_len, tk);
+    key = tk;
+    key_len = SHA_256_DIGEST_LENGTH;
+  }
+
+  /* Prepare the inner and outer padding:
+   * First, fill with key bytes (padded with zeros if needed), then XOR with pad values */
+  memset(k_ipad, 0, 64);
+  memset(k_opad, 0, 64);
+  memcpy(k_ipad, key, key_len);
+  memcpy(k_opad, key, key_len);
+
+  for(i = 0; i < 64; i++) {
+    k_ipad[i] ^= 0x36;
+    k_opad[i] ^= 0x5c;
+  }
+
+  /* Inner hash: H(K xor ipad, data) */
+  SHA_256.init();
+  SHA_256.update(k_ipad, 64);
+  SHA_256.update(data, data_len);
+  SHA_256.finalize(hmac);
+
+  /* Outer hash: H(K xor opad, inner hash) */
+  SHA_256.init();
+  SHA_256.update(k_opad, 64);
+  SHA_256.update(hmac, SHA_256_DIGEST_LENGTH);
+  SHA_256.finalize(hmac);
+}
+
+/*---------------------------------------------------------------------------*/
+/* HKDF Extract (RFC 5869) */
+
+void
+sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len,
+                     const uint8_t *ikm, size_t ikm_len,
+                     uint8_t prk[static SHA_256_DIGEST_LENGTH])
+{
+  /* If salt is not provided, use a string of zeros */
+  if(salt == NULL || salt_len == 0) {
+    uint8_t zeros[SHA_256_DIGEST_LENGTH] = { 0 };
+    sha_256_hmac(zeros, SHA_256_DIGEST_LENGTH, ikm, ikm_len, prk);
+  } else {
+    sha_256_hmac(salt, salt_len, ikm, ikm_len, prk);
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+/* HKDF Expand (RFC 5869) */
+
+void
+sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len,
+                    const uint8_t *info, size_t info_len,
+                    uint8_t *okm, uint_fast16_t okm_len)
+{
+  uint8_t t[32];
+  uint8_t counter;
+  size_t offset;
+  uint_fast16_t n;
+
+  /* PRK must be at least HashLen (32) bytes */
+  if(prk_len < SHA_256_DIGEST_LENGTH) {
+    /* RFC 5869 specifies that inputs shorter than hash length are invalid */
+    return;
+  }
+
+  n = 0;
+  offset = 0;
+  counter = 0;
+
+  while(okm_len > 0) {
+    counter++;
+    /* T(0) = empty string */
+    /* T(1) = HMAC-Hash(PRK, T(0) | info | 0x01) */
+    SHA_256.init();
+    if(n > 0) {
+      SHA_256.update(t, SHA_256_DIGEST_LENGTH);
+    }
+    if(info_len > 0) {
+      SHA_256.update(info, info_len);
+    }
+    SHA_256.update(&counter, 1);
+    SHA_256.finalize(t);
+
+    n += SHA_256_DIGEST_LENGTH;
+
+    /* Copy bytes from T to OKM */
+    if(offset < n) {
+      size_t to_copy = (okm_len < (n - offset)) ? okm_len : (n - offset);
+      memcpy(okm, &t[offset - (n - SHA_256_DIGEST_LENGTH)], to_copy);
+      okm += to_copy;
+      okm_len -= to_copy;
+      offset = n;
+    }
+  }
+}

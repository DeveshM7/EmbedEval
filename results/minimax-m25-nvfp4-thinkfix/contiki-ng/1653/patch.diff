+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+#define SHA_256_DIGEST_LENGTH 32
+#define SHA_256_BLOCK_SIZE 64
+
+/* SHA-256 initial hash values */
+static const uint32_t SHA_256_H_INIT[8] = {
+  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
+};
+
+/* SHA-256 round constants */
+static const uint32_t SHA_256_K[64] = {
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+typedef struct {
+  uint64_t length;
+  uint32_t state[8];
+  uint32_t curlen;
+  uint8_t buf[64];
+} sha_256_context_t;
+
+#define ROTR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+#define SHR(x, n) ((x) >> (n))
+#define CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define EP0(x) (ROTR(x, 2) ^ ROTR(x, 13) ^ ROTR(x, 22))
+#define EP1(x) (ROTR(x, 6) ^ ROTR(x, 11) ^ ROTR(x, 25))
+#define SIG0(x) (ROTR(x, 7) ^ ROTR(x, 18) ^ SHR(x, 3))
+#define SIG1(x) (ROTR(x, 17) ^ ROTR(x, 19) ^ SHR(x, 10))
+
+static void sha_256_compress(sha_256_context_t *ctx, const uint8_t *block) {
+  uint32_t w[64];
+  uint32_t a, b, c, d, e, f, g, h, t1, t2;
+  int i;
+  for(i = 0; i < 16; i++) {
+    w[i] = ((uint32_t)block[i * 4] << 24) | ((uint32_t)block[i * 4 + 1] << 16) |
+           ((uint32_t)block[i * 4 + 2] << 8) | ((uint32_t)block[i * 4 + 3]);
+  }
+  for(i = 16; i < 64; i++) {
+    w[i] = SIG1(w[i - 2]) + w[i - 7] + SIG0(w[i - 15]) + w[i - 16];
+  }
+  a = ctx->state[0]; b = ctx->state[1]; c = ctx->state[2]; d = ctx->state[3];
+  e = ctx->state[4]; f = ctx->state[5]; g = ctx->state[6]; h = ctx->state[7];
+  for(i = 0; i < 64; i++) {
+    t1 = h + EP1(e) + CH(e, f, g) + SHA_256_K[i] + w[i];
+    t2 = EP0(a) + MAJ(a, b, c);
+    h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+  }
+  ctx->state[0] += a; ctx->state[1] += b; ctx->state[2] += c; ctx->state[3] += d;
+  ctx->state[4] += e; ctx->state[5] += f; ctx->state[6] += g; ctx->state[7] += h;
+}
+
+static void sha_256_init(sha_256_context_t *ctx) {
+  int i;
+  ctx->length = 0; ctx->curlen = 0;
+  for(i = 0; i < 8; i++) ctx->state[i] = SHA_256_H_INIT[i];
+}
+
+static void sha_256_update(sha_256_context_t *ctx, const uint8_t *data, size_t len) {
+  size_t n;
+  while(len > 0) {
+    n = (len < (64 - ctx->curlen)) ? len : (64 - ctx->curlen);
+    memcpy(&ctx->buf[ctx->curlen], data, n);
+    ctx->curlen += n; data += n; len -= n;
+    if(ctx->curlen == 64) {
+      sha_256_compress(ctx, ctx->buf);
+      ctx->length += 512; ctx->curlen = 0;
+    }
+  }
+}
+
+static void sha_256_final(sha_256_context_t *ctx, uint8_t *digest) {
+  uint32_t i; uint64_t total_bits;
+  i = ctx->curlen;
+  ctx->buf[i++] = 0x80;
+  if(ctx->curlen < 56) {
+    memset(&ctx->buf[i], 0, 56 - i);
+  } else {
+    memset(&ctx->buf[i], 0, 64 - i);
+    sha_256_compress(ctx, ctx->buf);
+    memset(ctx->buf, 0, 56);
+  }
+  total_bits = ctx->length + (ctx->curlen << 3);
+  ctx->buf[56] = (uint8_t)(total_bits >> 56);
+  ctx->buf[57] = (uint8_t)(total_bits >> 48);
+  ctx->buf[58] = (uint8_t)(total_bits >> 40);
+  ctx->buf[59] = (uint8_t)(total_bits >> 32);
+  ctx->buf[60] = (uint8_t)(total_bits >> 24);
+  ctx->buf[61] = (uint8_t)(total_bits >> 16);
+  ctx->buf[62] = (uint8_t)(total_bits >> 8);
+  ctx->buf[63] = (uint8_t)total_bits;
+  sha_256_compress(ctx, ctx->buf);
+  for(i = 0; i < 8; i++) {
+    digest[i * 4] = (uint8_t)(ctx->state[i] >> 24);
+    digest[i * 4 + 1] = (uint8_t)(ctx->state[i] >> 16);
+    digest[i * 4 + 2] = (uint8_t)(ctx->state[i] >> 8);
+    digest[i * 4 + 3] = (uint8_t)ctx->state[i];
+  }
+}
+
+void sha_256_hash(const uint8_t *data, size_t len, uint8_t *digest) {
+  sha_256_context_t ctx;
+  sha_256_init(&ctx);
+  sha_256_update(&ctx, data, len);
+  sha_256_final(&ctx, digest);
+}
+
+/* HMAC test vector from RFC 2104: key="Jefe", data="what do ya want for nothing?" */
+static const uint8_t test_hmac_key[] = "Jefe";
+static const uint8_t test_hmac_data[] = "what do ya want for nothing?";
+static const uint8_t test_hmac_expected[32] = {
+  0x5b, 0xdc, 0xc1, 0x46, 0xbf, 0x60, 0x75, 0x4e,
+  0x6a, 0x04, 0x24, 0x26, 0x08, 0x95, 0x75, 0xc7,
+  0x5a, 0x00, 0x3f, 0x08, 0x9d, 0x27, 0x39, 0x83,
+  0x9d, 0xec, 0x58, 0xb9, 0x21, 0xb7, 0x2c, 0x2f
+};
+
+void sha_256_hmac(const uint8_t *key, size_t key_len,
+                  const uint8_t *data, size_t data_len,
+                  uint8_t *hmac) {
+  uint8_t k_ipad[64];
+  uint8_t k_opad[64];
+  uint8_t tk[32];
+  size_t i;
+  sha_256_context_t ctx;
+
+  if(key_len > SHA_256_BLOCK_SIZE) {
+    sha_256_hash(key, key_len, tk);
+    key = tk;
+    key_len = SHA_256_DIGEST_LENGTH;
+  }
+
+  memset(k_ipad, 0x36, 64);
+  memset(k_opad, 0x5c, 64);
+
+  for(i = 0; i < key_len; i++) {
+    k_ipad[i] ^= key[i];
+    k_opad[i] ^= key[i];
+  }
+
+  /* Inner hash: H(K xor ipad, data) */
+  sha_256_init(&ctx);
+  sha_256_update(&ctx, k_ipad, 64);
+  sha_256_update(&ctx, data, data_len);
+  sha_256_final(&ctx, hmac);
+
+  /* Outer hash: H(K xor opad, inner hash) */
+  sha_256_init(&ctx);
+  sha_256_update(&ctx, k_opad, 64);
+  sha_256_update(&ctx, hmac, SHA_256_DIGEST_LENGTH);
+  sha_256_final(&ctx, hmac);
+}
+
+int main() {
+  uint8_t hmac[32];
+  int i;
+
+  sha_256_hmac(test_hmac_key, strlen((const char *)test_hmac_key),
+               test_hmac_data, strlen((const char *)test_hmac_data),
+               hmac);
+
+  printf("Got:      ");
+  for(i = 0; i < 32; i++) printf("%02x", hmac[i]);
+  printf("\n");
+  printf("Expected: ");
+  for(i = 0; i < 32; i++) printf("%02x", test_hmac_expected[i]);
+  printf("\n");
+  printf("Match: %s\n", memcmp(hmac, test_hmac_expected, 32) == 0 ? "YES" : "NO");
+
+  return 0;
+}

+  0x9d, 0xec, 0x58, 0xb9, 0x21, 0xb7, 0x2c, 0x2f
+};
+
+int main() {
+  int i;
+  printf("Key: '%s' (len=%zu)\n", test_hmac_key, strlen((const char *)test_hmac_key));
+  printf("Data: '%s' (len=%zu)\n", test_hmac_data, strlen((const char *)test_hmac_data));
+  printf("Expected: ");
+  for(i = 0; i < 32; i++) printf("%02x", test_hmac_expected[i]);
+  printf("\n");
+  return 0;
+}

+/**
+ * \file
+ *         SHA-256 hash algorithm.
+ * \author
+ *         David H. Smith <david.h.smith@contiki-ng.org>
+ */
+
+#ifndef SHA_256_H_
+#define SHA_256_H_
+
+#include "contiki.h"
+
+#include <stdint.h>
+#include <stddef.h>
+
+/**
+ * \brief Length of SHA-256 digests in bytes
+ */
+#define SHA_256_DIGEST_LENGTH 32
+
+/**
+ * \brief Block size of SHA-256 in bytes
+ */
+#define SHA_256_BLOCK_SIZE 64
+
+/**
+ * \brief SHA-256 checkpoint structure
+ *
+ * This structure is used to save and restore the state of an in-progress
+ * hash operation, enabling the hash to be paused and resumed, such as
+ * across a protothread yield.
+ */
+typedef struct {
+  uint64_t length;
+  uint32_t state[8];
+  uint32_t curlen;
+  uint8_t buf[64];
+} sha_256_checkpoint_t;
+
+/**
+ * \brief SHA-256 driver structure
+ *
+ * This structure defines the interface for SHA-256 hash operations.
+ * The driver provides both incremental hash operations (init, update,
+ * finalize) and a one-shot hash function.
+ */
+struct sha_256_driver {
+
+  /**
+   * \brief Initialize the hash state
+   */
+  void (*init)(void);
+
+  /**
+   * \brief Process data through the hash
+   * \param data Pointer to the data to hash
+   * \param len Length of the data to hash in bytes
+   */
+  void (*update)(const uint8_t *data, size_t len);
+
+  /**
+   * \brief Finalize the hash and produce the digest
+   * \param digest Destination for the hash digest (32 bytes)
+   */
+  void (*finalize)(uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+
+  /**
+   * \brief Create a checkpoint of the current hash state
+   * \param cp Pointer to the checkpoint to save to
+   */
+  void (*create_checkpoint)(sha_256_checkpoint_t *cp);
+
+  /**
+   * \brief Restore a checkpoint of the hash state
+   * \param cp Pointer to the checkpoint to restore from
+   */
+  void (*restore_checkpoint)(const sha_256_checkpoint_t *cp);
+
+  /**
+   * \brief Compute SHA-256 hash in one shot
+   * \param data Pointer to the data to hash
+   * \param len Length of the data to hash in bytes
+   * \param digest Destination for the hash digest (32 bytes)
+   */
+  void (*hash)(const uint8_t *data, size_t len,
+               uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+};
+
+/**
+ * \brief The SHA-256 driver instance
+ */
+extern const struct sha_256_driver SHA_256;
+
+/**
+ * \brief Compute SHA-256 hash (one-shot)
+ * \param data Pointer to the data to hash
+ * \param len Length of the data to hash in bytes
+ * \param digest Destination for the hash digest (32 bytes)
+ */
+void sha_256_hash(const uint8_t *data, size_t len,
+                  uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+
+/**
+ * \brief Compute HMAC-SHA-256 (RFC 2104)
+ * \param key Pointer to the key
+ * \param key_len Length of the key in bytes
+ * \param data Pointer to the data to authenticate
+ * \param data_len Length of the data in bytes
+ * \param hmac Destination for the HMAC (32 bytes)
+ */
+void sha_256_hmac(const uint8_t *key, size_t key_len,
+                  const uint8_t *data, size_t data_len,
+                  uint8_t hmac[static SHA_256_DIGEST_LENGTH]);
+
+/**
+ * \brief HKDF Extract (RFC 5869)
+ * \param salt Pointer to the salt
+ * \param salt_len Length of the salt in bytes
+ * \param ikm Pointer to the input key material
+ * \param ikm_len Length of the input key material in bytes
+ * \param prk Destination for the pseudo-random key (32 bytes)
+ */
+void sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len,
+                          const uint8_t *ikm, size_t ikm_len,
+                          uint8_t prk[static SHA_256_DIGEST_LENGTH]);
+
+/**
+ * \brief HKDF Expand (RFC 5869)
+ * \param prk Pointer to the pseudo-random key
+ * \param prk_len Length of the pseudo-random key in bytes
+ * \param info Pointer to the application-specific info
+ * \param info_len Length of the info in bytes
+ * \param okm Destination for the output key material
+ * \param okm_len Desired length of the output key material in bytes
+ */
+void sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len,
+                          const uint8_t *info, size_t info_len,
+                          uint8_t *okm, uint_fast16_t okm_len);
+
+#endif /* SHA_256_H_ */

+/*---------------------------------------------------------------------------*/
+/*
+ * Check if address is a NAT64 address with the well-known prefix 64:ff9b::/96
+ * (RFC 6052). The first 96 bits (6 16-bit groups) must be 64:ff9b::.
+ */
+static int
+addr_is_nat64(const uip_ip6addr_t *addr)
+{
+  return addr->u8[0] == 0x64 && addr->u8[1] == 0xff &&
+         addr->u8[2] == 0x9b && addr->u8[3] == 0 &&
+         addr->u8[4] == 0 && addr->u8[5] == 0;
+}
+
+/*---------------------------------------------------------------------------*/
+/*
+ * Check if we're at an IPv4 suffix in the string.
+ * Returns 1 if the position AFTER the dot looks like the start of an IPv4 address.
+ */
+static int
+is_ipv4_suffix(const char *p)
+{
+  /* IPv4 suffix starts with a digit after the dot */
+  p++;
+  if(*p >= '0' && *p <= '9') {
+    /* Count digits at start */
+    int digits = 0;
+    const char *q = p;
+    while(*q >= '0' && *q <= '9' && digits < 3) {
+      digits++;
+      q++;
+    }
+    /* Must be followed by a dot */
+    if(*q == '.') {
+      return 1;
+    }
+  }
+  return 0;
+}
+
+/*---------------------------------------------------------------------------*/
+/*
+ * Parse an IPv4 address in dotted-decimal notation.
+ * Returns 1 on success, 0 on error.
+ */
+static int
+parse_ipv4_suffix(const char *addrstr, uip_ip6addr_t *ipaddr, int offset)
+{
+  unsigned char tmp;
+  char c;
+  unsigned char i, j;
+
+  tmp = 0;
+
+  for(i = 0; i < 4; ++i) {
+    j = 0;
+    do {
+      c = *addrstr;
+      ++j;
+      if(j > 4) {
+        return 0;
+      }
+      if(c == '.' || c == '\0' || c == ']' || c == '/' || c == ':') {
+        ipaddr->u8[offset + i] = tmp;
+        tmp = 0;
+      } else if(c >= '0' && c <= '9') {
+        tmp = (tmp * 10) + (c - '0');
+      } else {
+        return 0;
+      }
+      ++addrstr;
+    } while(c != '.' && c != '\0' && c != ']' && c != '/' && c != ':');
+
+  }
+  return 1;
+}

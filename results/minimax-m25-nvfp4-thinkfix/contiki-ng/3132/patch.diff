+/**
+ * \brief Set a NAT64 IPv6 address from an IPv4 address
+ *
+ * This macro takes a pointer to a uip_ip6addr_t and four IPv4 octets
+ * and sets the address to the NAT64 well-known-prefix form 64:ff9b::/96
+ * (RFC 6052) with the given IPv4 address placed in the low 32 bits.
+ *
+ * \param addr A pointer to a uip_ip6addr_t that will be set.
+ * \param a The first octet of the IPv4 address.
+ * \param b The second octet of the IPv4 address.
+ * \param c The third octet of the IPv4 address.
+ * \param d The fourth octet of the IPv4 address.
+ *
+ * Example: uip_nat64addr(&addr, 8, 8, 8, 8) yields 64:ff9b::8.8.8.8
+ */
+#define uip_nat64addr(addr, a, b, c, d) do { \
+  (addr)->u8[0] = 0x64; \
+  (addr)->u8[1] = 0xff; \
+  (addr)->u8[2] = 0x9b; \
+  (addr)->u8[3] = 0; \
+  (addr)->u8[4] = 0; \
+  (addr)->u8[5] = 0; \
+  (addr)->u8[6] = 0; \
+  (addr)->u8[7] = 0; \
+  (addr)->u8[8] = 0; \
+  (addr)->u8[9] = 0; \
+  (addr)->u8[10] = 0; \
+  (addr)->u8[11] = 0; \
+  (addr)->u8[12] = (a); \
+  (addr)->u8[13] = (b); \
+  (addr)->u8[14] = (c); \
+  (addr)->u8[15] = (d); \
+} while(0)

diff --git a/os/lib/list.c b/os/lib/list.c
index afa9df5..664e2c9 100644
--- a/os/lib/list.c
+++ b/os/lib/list.c
@@ -325,3 +325,29 @@ list_item_next(void *item)
 }
 /*---------------------------------------------------------------------------*/
 /** @} */
+/*---------------------------------------------------------------------------*/
+/**
+ * \brief      Check if a list contains a specific item
+ * \param list The list
+ * \param item The item to search for
+ * \return     Non-zero if the list contains the item, zero otherwise
+ *
+ *             This function iterates through the list and checks if
+ *             the specified item is present in the list.
+ */
+int
+list_contains(list_t list, void *item)
+{
+  struct list *l;
+
+  for(l = *list; l != NULL; l = l->next) {
+    if(l == item) {
+      return 1;
+    }
+  }
+
+  return 0;
+}
+/*---------------------------------------------------------------------------*/
+/*---------------------------------------------------------------------------*/
+/** @} */

diff --git a/test_float_fix.c b/test_float_fix.c
new file mode 100644
index 0000000..2540df7
--- /dev/null
+++ b/test_float_fix.c
@@ -0,0 +1,120 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+#include <float.h>
+#include "/testbed/os/services/lwm2m/lwm2m-tlv.h"
+
+int main() {
+    // Test various float values
+    float test_floats[] = {
+        0.0f,           // Zero
+        1.0f,           // One
+        -1.0f,          // Negative one
+        3.14159f,       // Pi
+        -3.14159f,      // Negative pi
+        1e10f,          // Large - should saturate
+        -1e10f,         // Large negative - should saturate
+        1e-10f,         // Small - should become zero
+        -1e-10f,        // Small negative - should become zero
+        INFINITY,       // Infinity - should be rejected
+        -INFINITY,      // Negative infinity - should be rejected
+        NAN,            // NaN - should be rejected
+    };
+    
+    const char* test_names[] = {
+        "Zero", "One", "Negative one", "Pi", "Negative pi",
+        "Large positive", "Large negative", "Small positive", "Small negative",
+        "Infinity", "Negative infinity", "NaN"
+    };
+    
+    int num_tests = sizeof(test_floats) / sizeof(test_floats[0]);
+    int bits = 8; // 8 fractional bits
+    
+    printf("Testing float to fixpoint conversion with %d fractional bits:\n", bits);
+    printf("=====================================\n");
+    
+    for (int i = 0; i < num_tests; i++) {
+        lwm2m_tlv_t tlv;
+        tlv.type = 0;
+        tlv.id = 1;
+        tlv.length = 4;
+        tlv.value = (uint8_t*)&test_floats[i];
+        
+        int32_t fixed;
+        size_t result = lwm2m_tlv_float32_to_fix(&tlv, &fixed, bits);
+        
+        printf("%-18s: ", test_names[i]);
+        if (result == 0) {
+            printf("REJECTED (returned 0)");
+        } else {
+            printf("fixed=%d (0x%08x)", fixed, fixed);
+        }
+        printf("\n");
+    }
+    
+    // Test invalid lengths
+    printf("\nTesting invalid lengths:\n");
+    printf("=======================\n");
+    
+    uint8_t data[10];
+    for (int len = 0; len < 10; len++) {
+        if (len != 4 && len != 8) {  // Skip valid lengths
+            lwm2m_tlv_t tlv;
+            tlv.type = 0;
+            tlv.id = 1;
+            tlv.length = len;
+            tlv.value = data;
+            
+            int32_t fixed;
+            size_t result = lwm2m_tlv_float32_to_fix(&tlv, &fixed, bits);
+            
+            printf("Length %2d: %s\n", len, 
+                   (result == 0) ? "REJECTED (GOOD)" : "ACCEPTED (BAD)");
+        }
+    }
+    
+    // Test double precision (8 bytes)
+    printf("\nTesting double precision (8 bytes):\n");
+    printf("===================================\n");
+    
+    double test_doubles[] = {
+        0.0,           // Zero
+        1.0,           // One
+        -1.0,          // Negative one
+        3.14159,       // Pi
+        -3.14159,      // Negative pi
+        1e100,         // Very large - should saturate
+        -1e100,        // Very large negative - should saturate
+        1e-100,        // Very small - should become zero
+        -1e-100,       // Very small negative - should become zero
+    };
+    
+    const char* double_names[] = {
+        "Zero", "One", "Negative one", "Pi", "Negative pi",
+        "Very large", "Very large negative", "Very small", "Very small negative"
+    };
+    
+    int num_double_tests = sizeof(test_doubles) / sizeof(test_doubles[0]);
+    
+    for (int i = 0; i < num_double_tests; i++) {
+        lwm2m_tlv_t tlv;
+        tlv.type = 0;
+        tlv.id = 1;
+        tlv.length = 8;
+        tlv.value = (uint8_t*)&test_doubles[i];
+        
+        int32_t fixed;
+        size_t result = lwm2m_tlv_float32_to_fix(&tlv, &fixed, bits);
+        
+        printf("%-18s: ", double_names[i]);
+        if (result == 0) {
+            printf("REJECTED (returned 0)");
+        } else {
+            printf("fixed=%d (0x%08x)", fixed, fixed);
+        }
+        printf("\n");
+    }
+    
+    return 0;
+}

diff --git a/final_test.c b/final_test.c
new file mode 100644
index 0000000..6198547
--- /dev/null
+++ b/final_test.c
@@ -0,0 +1,42 @@
+#include <stdio.h>
+#include <stdint.h>
+#include "lib/random.h"
+
+int main(void) {
+  printf("Final verification test - exactly as described in task\n");
+  
+  /* Test sfc32_prng with seed 0 */
+  printf("\nTesting sfc32_prng with seed 0:\n");
+  sfc32_prng.seed(0);
+  for(int i = 0; i < 8; i++) {
+    uint16_t val = (uint16_t)sfc32_prng.rand();
+    printf("val[%d] = 0x%04x\n", i, val);
+  }
+  
+  /* Test sfc32_prng with custom seed */
+  printf("\nTesting sfc32_prng with seed 0x0102030405060708:\n");
+  sfc32_prng.seed(0x0102030405060708ULL);
+  for(int i = 0; i < 8; i++) {
+    uint16_t val = (uint16_t)sfc32_prng.rand();
+    printf("val[%d] = 0x%04x\n", i, val);
+  }
+  
+  /* Test sfc16_prng with seed 0 */
+  printf("\nTesting sfc16_prng with seed 0:\n");
+  sfc16_prng.seed(0);
+  for(int i = 0; i < 8; i++) {
+    uint16_t val = (uint16_t)sfc16_prng.rand();
+    printf("val[%d] = 0x%04x\n", i, val);
+  }
+  
+  /* Test sfc16_prng with custom seed */
+  printf("\nTesting sfc16_prng with seed 0x0102030405060708:\n");
+  sfc16_prng.seed(0x0102030405060708ULL);
+  for(int i = 0; i < 8; i++) {
+    uint16_t val = (uint16_t)sfc16_prng.rand();
+    printf("val[%d] = 0x%04x\n", i, val);
+  }
+  
+  printf("\nSUCCESS: All tests completed\n");
+  return 0;
+}

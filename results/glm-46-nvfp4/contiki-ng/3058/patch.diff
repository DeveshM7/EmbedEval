diff --git a/test_ref.c b/test_ref.c
new file mode 100644
index 0000000..ce54c73
--- /dev/null
+++ b/test_ref.c
@@ -0,0 +1,39 @@
+#include <stdio.h>
+#include <stdint.h>
+
+/* Test splitmix64 implementation */
+uint64_t splitmix64_state;
+
+void splitmix64_seed(uint64_t seed) {
+    splitmix64_state = seed;
+}
+
+uint64_t splitmix64_next(void) {
+    uint64_t z = (splitmix64_state += 0x9e3779b97f4a7c15ULL);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+    return z ^ (z >> 31);
+}
+
+void test_seed(uint64_t seed) {
+    printf("Testing seed 0x%016llx:\n", (unsigned long long)seed);
+    splitmix64_seed(seed);
+    for(int i = 0; i < 8; i++) {
+        uint64_t val = splitmix64_next();
+        printf("  %d: 0x%016llx\n", i, (unsigned long long)val);
+        
+        /* Extract 16-bit chunks */
+        uint16_t chunk0 = val & 0xFFFF;
+        uint16_t chunk1 = (val >> 16) & 0xFFFF;
+        uint16_t chunk2 = (val >> 32) & 0xFFFF;
+        uint16_t chunk3 = (val >> 48) & 0xFFFF;
+        printf("    chunks: 0x%04x 0x%04x 0x%04x 0x%04x\n", chunk0, chunk1, chunk2, chunk3);
+    }
+    printf("\n");
+}
+
+int main(void) {
+    test_seed(0);
+    test_seed(0x0102030405060708ULL);
+    return 0;
+}

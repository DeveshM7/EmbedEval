diff --git a/legacy_random_test.c b/legacy_random_test.c
new file mode 100644
index 0000000..3bab809
--- /dev/null
+++ b/legacy_random_test.c
@@ -0,0 +1,28 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include "lib/random.h"
+
+int main(void) {
+  printf("Testing legacy random functions\n");
+  
+  /* Test legacy random functions */
+  random_init(12345);
+  for(int i = 0; i < 5; i++) {
+    printf("random_rand() = %u\n", random_rand());
+  }
+  
+  /* Test new PRNG interface */
+  printf("\nTesting new PRNG interface\n");
+  
+  sfc32_prng.seed(0);
+  for(int i = 0; i < 5; i++) {
+    printf("sfc32_prng.rand() = %u\n", (unsigned)sfc32_prng.rand());
+  }
+  
+  sfc16_prng.seed(0);
+  for(int i = 0; i < 5; i++) {
+    printf("sfc16_prng.rand() = %u\n", (unsigned)sfc16_prng.rand());
+  }
+  
+  return 0;
+}
diff --git a/os/lib/random.c b/os/lib/random.c

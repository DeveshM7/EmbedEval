+/*---------------------------------------------------------------------------*/
+void
+cbor_write_signed(cbor_writer_state_t *state, int64_t value)
+{
+  if(value >= 0) {
+    /* Non-negative: use unsigned encoding */
+    write_first_byte(state, CBOR_MAJOR_TYPE_UNSIGNED);
+    insert_unsigned(state, state->buffer, (uint64_t)value);
+  } else {
+    /* Negative: use negative encoding (1 + abs(-1 - value)) */
+    write_first_byte(state, CBOR_MAJOR_TYPE_UNSIGNED | 0x20);
+    insert_unsigned(state, state->buffer, (uint64_t)(-1 - value));
+  }
+}
+/*---------------------------------------------------------------------------*/
+cbor_size_t
+cbor_read_signed(cbor_reader_state_t *state, int64_t *value)
+{
+  uint64_t unsigned_value;
+  cbor_major_type_t major_type;
+  cbor_size_t size_info;
+
+  if(!state->cbor_size) {
+    return CBOR_SIZE_NONE;
+  }
+
+  major_type = cbor_peek_next(state);
+
+  if(major_type == CBOR_MAJOR_TYPE_UNSIGNED) {
+    /* Read as unsigned integer */
+    size_info = cbor_read_unsigned(state, &unsigned_value);
+    if(size_info == CBOR_SIZE_NONE) {
+      return CBOR_SIZE_NONE;
+    }
+    *value = (int64_t)unsigned_value;
+    return size_info;
+  } else if(major_type == (CBOR_MAJOR_TYPE_UNSIGNED | 0x20)) {
+    /* Read as negative integer */
+    size_info = cbor_read_unsigned(state, &unsigned_value);
+    if(size_info == CBOR_SIZE_NONE) {
+      return CBOR_SIZE_NONE;
+    }
+    /* Check for overflow: -1 - value >= INT64_MIN */
+    if(unsigned_value > (uint64_t)(INT64_MAX)) {
+      return CBOR_SIZE_NONE;
+    }
+    *value = -1 - (int64_t)unsigned_value;
+    return size_info;
+  }
+
+  return CBOR_SIZE_NONE;
+}
+/*---------------------------------------------------------------------------*/

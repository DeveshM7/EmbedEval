+/**
+ * \file
+ *         Header file for the CPU cycle counter module.
+ * \author
+ *         Contiki-NG
+ */
+
+#ifndef CYCLES_H_
+#define CYCLES_H_
+
+#include <stdint.h>
+#include <sys/time.h>
+
+/*---------------------------------------------------------------------------*/
+/* Platform-specific definitions */
+#if CONTIKI_TARGET_NATIVE
+/* On hosted port, a cycle is a nanosecond of process CPU time */
+#define CYCLES_HZ 1000000000UL
+#else
+/* Default for other platforms - should be overridden in platform-specific config */
+#define CYCLES_HZ 16000000UL
+#endif /* CONTIKI_TARGET_NATIVE */
+
+/*---------------------------------------------------------------------------*/
+/* Function declarations */
+
+/**
+ * \brief      Get the current cycle counter value
+ * \return     The current value of the cycle counter
+ *
+ *             This function returns the current value of the cycle counter.
+ *             If the counter has not been started, it returns 0.
+ *
+ */
+uint32_t cycles_now(void);
+
+/**
+ * \brief      Start the cycle counter
+ *
+ *             This function starts the cycle counter. If the counter
+ *             is already running, this function has no effect (idempotent).
+ *             Starting is global across all calls and never disturbs an
+ *             in-progress count.
+ *
+ */
+void cycles_start(void);
+
+/**
+ * \brief      Stop the cycle counter
+ *
+ *             This function stops the cycle counter and freezes the reading.
+ *             Stopping is global and affects all subsequently readings.
+ *
+ */
+void cycles_stop(void);
+
+/*---------------------------------------------------------------------------*/
+/* Conversion macros */
+
+/**
+ * \brief      Convert cycles to whole microseconds
+ * \param cycles The cycle count to convert
+ * \return     The whole microseconds equivalent
+ *
+ *             This macro converts a cycle count to whole microseconds.
+ *             It handles the full 32-bit range without overflow.
+ *
+ */
+#define CYCLES_TO_US(cycles) ((cycles) / (CYCLES_HZ / 1000000UL))
+
+/**
+ * \brief      Convert cycles to hundredths of microseconds
+ * \param cycles The cycle count to convert
+ * \return     The hundredths of microseconds equivalent
+ *
+ *             This macro converts a cycle count to hundredths of microseconds
+ *             (i.e., two decimal places beyond the microsecond).
+ *             It handles the full 32-bit range without overflow.
+ *
+ */
+#define CYCLES_TO_US_FRAC(cycles) (((cycles) * 100UL) / (CYCLES_HZ / 1000000UL))
+
+/*---------------------------------------------------------------------------*/
+
+#endif /* CYCLES_H_ */

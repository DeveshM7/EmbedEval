+/**
+ * \file
+ *         Implementation of the CPU cycle counter module.
+ * \author
+ *         Contiki-NG
+ */
+
+#define _POSIX_C_SOURCE 199309L
+#include "sys/cycles.h"
+#include "sys/clock.h"
+#include <sys/time.h>
+#include <unistd.h>
+
+/*---------------------------------------------------------------------------*/
+/* Internal state */
+static uint8_t counter_started = 0;
+static uint32_t frozen_value = 0;
+static uint64_t start_time_us = 0;
+
+/*---------------------------------------------------------------------------*/
+uint32_t
+cycles_now(void)
+{
+  if(!counter_started) {
+    return 0;
+  }
+
+  if(frozen_value != 0) {
+    return frozen_value;
+  }
+
+#if CONTIKI_TARGET_NATIVE
+  /* On hosted port, use gettimeofday for timing */
+  struct timeval tv;
+  if(gettimeofday(&tv, NULL) == 0) {
+    /* Get current time in microseconds */
+    uint64_t current_time_us = (uint64_t)tv.tv_sec * 1000000ULL + (uint64_t)tv.tv_usec;
+    
+    /* If this is the first call after start, establish the base time */
+    if(start_time_us == 0) {
+      start_time_us = current_time_us;
+    }
+    
+    /* Calculate elapsed microseconds since start */
+    uint64_t elapsed_us = current_time_us - start_time_us;
+    
+    /* Since CYCLES_HZ = 1e9, 1 cycle = 1 nanosecond */
+    /* So microseconds * 1000 = nanoseconds = cycles */
+    uint64_t cycles = elapsed_us * 1000ULL;
+    
+    /* Return as 32-bit - if we exceed 32-bit range, cap at max */
+    if(cycles > 0xFFFFFFFFULL) {
+      return 0xFFFFFFFFUL;
+    }
+    
+    return (uint32_t)cycles;
+  }
+  return 0;
+#else
+  /* For embedded platforms, we would use platform-specific cycle counters */
+  /* For now, return a simple counter based on clock_time() */
+  return (uint32_t)clock_time() * (CYCLES_HZ / CLOCK_CONF_SECOND);
+#endif
+}
+
+/*---------------------------------------------------------------------------*/
+void
+cycles_start(void)
+{
+  if(!counter_started) {
+    counter_started = 1;
+    frozen_value = 0;
+    start_time_us = 0;  /* Reset base time for new start */
+    
+    /* Establish the start time immediately */
+#if CONTIKI_TARGET_NATIVE
+    struct timeval tv;
+    if(gettimeofday(&tv, NULL) == 0) {
+      start_time_us = (uint64_t)tv.tv_sec * 1000000ULL + (uint64_t)tv.tv_usec;
+    }
+#endif
+  }
+  /* If already started, do nothing - idempotent */
+}
+
+/*---------------------------------------------------------------------------*/
+void
+cycles_stop(void)
+{
+  if(counter_started && frozen_value == 0) {
+    frozen_value = cycles_now();
+  }
+  /* If already stopped, keep the existing frozen value */
+}
+
+/*---------------------------------------------------------------------------*/

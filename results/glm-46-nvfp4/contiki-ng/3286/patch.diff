diff --git a/arch/platform/native/platform.c b/arch/platform/native/platform.c
index 4d75748..ee3f2ae 100644
--- a/arch/platform/native/platform.c
+++ b/arch/platform/native/platform.c
@@ -66,6 +66,7 @@
 
 #include "lib/assert.h"
 #include "lib/csprng.h"
+#include "sys/etimer.h"  /* Added for etimer support */
 #ifdef __APPLE__
 #include <Security/Security.h>
 #include <Security/SecRandom.h>
@@ -309,8 +310,43 @@ platform_main_loop()
 
     retval = process_run();
 
-    tv.tv_sec = retval ? 0 : SELECT_TIMEOUT / 1000;
-    tv.tv_usec = retval ? 1 : (SELECT_TIMEOUT * 1000) % 1000000;
+    /* Calculate the select timeout based on the next etimer expiration */
+    if(retval == 0) {
+      /* No immediate work to do, calculate timeout based on etimers */
+      if(etimer_pending()) {
+        clock_time_t next_exp = etimer_next_expiration_time();
+        clock_time_t now = clock_time();
+        if(next_exp > now) {
+          /* Time until next etimer expires, in milliseconds */
+          clock_time_t wait = (next_exp - now) * 1000 / CLOCK_SECOND;
+          /* Don't sleep longer than the default SELECT_TIMEOUT */
+          if(wait > SELECT_TIMEOUT) {
+            wait = SELECT_TIMEOUT;
+          }
+          
+          if(wait > 0) {
+            tv.tv_sec = wait / 1000;
+            tv.tv_usec = (wait % 1000) * 1000;
+          } else {
+            /* etimer expired or will expire very soon, don't sleep */
+            tv.tv_sec = 0;
+            tv.tv_usec = 1;
+          }
+        } else {
+          /* etimer already expired, don't sleep */
+          tv.tv_sec = 0;
+          tv.tv_usec = 1;
+        }
+      } else {
+        /* No pending etimers, use the default timeout */
+        tv.tv_sec = SELECT_TIMEOUT / 1000;
+        tv.tv_usec = (SELECT_TIMEOUT * 1000) % 1000000;
+      }
+    } else {
+      /* Work still pending, use minimal sleep time */
+      tv.tv_sec = 0;
+      tv.tv_usec = 1;
+    }
 
     FD_ZERO(&fdr);
     FD_ZERO(&fdw);

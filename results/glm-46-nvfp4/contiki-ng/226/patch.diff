+static void test_dbl_list(void)
+{
+  printf("Testing doubly-linked list...\n");
+  
+  DBL_LIST(my_dlist);
+  dbl_list_init(my_dlist);
+  
+  if(!dbl_list_is_empty(my_dlist)) {
+    printf("ERROR: doubly-linked list should be empty initially\n");
+    return;
+  }
+  
+  if(dbl_list_head(my_dlist) != NULL || dbl_list_tail(my_dlist) != NULL) {
+    printf("ERROR: head/tail on empty doubly-linked list should return NULL\n");
+    return;
+  }
+  
+  struct dbl_elem e1 = { .value = 1 };
+  struct dbl_elem e2 = { .value = 2 };
+  struct dbl_elem e3 = { .value = 3 };
+  
+  dbl_list_add_head(my_dlist, &e1);
+  dbl_list_add_head(my_dlist, &e2);  /* 2, 1 */
+  dbl_list_add_tail(my_dlist, &e3);  /* 2, 1, 3 */
+  
+  if(dbl_list_length(my_dlist) != 3) {
+    printf("ERROR: doubly-linked list should have length 3\n");
+    return;
+  }
+  
+  struct dbl_elem *head = dbl_list_head(my_dlist);
+  struct dbl_elem *tail = dbl_list_tail(my_dlist);
+  
+  if(head == NULL || head->value != 2) {
+    printf("ERROR: head should be 2\n");
+    return;
+  }
+  
+  if(tail == NULL || tail->value != 3) {
+    printf("ERROR: tail should be 3\n");
+    return;
+  }
+  
+  if(head->previous != NULL) {
+    printf("ERROR: head's previous should be NULL\n");
+    return;
+  }
+  
+  if(tail->next != NULL) {
+    printf("ERROR: tail's next should be NULL\n");
+    return;
+  }
+  
+  /* Test add before */
+  struct dbl_elem e4 = { .value = 4 };
+  dbl_list_add_before(my_dlist, &e3, &e4);  /* 2, 1, 4, 3 */
+  
+  head = dbl_list_head(my_dlist);
+  struct dbl_elem *third = head->next->next;
+  
+  if(third == NULL || third->value != 4) {
+    printf("ERROR: third element should be 4\n");
+    return;
+  }
+  
+  /* Test add after */
+  struct dbl_elem e5 = { .value = 5 };
+  dbl_list_add_after(my_dlist, &e1, &e5);  /* 2, 1, 5, 4, 3 */
+  
+  struct dbl_elem *second = head->next;
+  if(second == NULL || second->value != 1) {
+    printf("ERROR: second element should be 1\n");
+    return;
+  }
+  
+  if(second->next == NULL || second->next->value != 5) {
+    printf("ERROR: element after 1 should be 5\n");
+    return;
+  }
+  
+  /* Test removal */
+  dbl_list_remove(my_dlist, &e5);  /* 2, 1, 4, 3 */
+  
+  if(dbl_list_length(my_dlist) != 4) {
+    printf("ERROR: doubly-linked list should have length 4 after removal\n");
+    return;
+  }
+  
+  /* Test re-adding (should remove first then add) */
+  dbl_list_add_head(my_dlist, &e5);  /* 5, 2, 1, 4, 3 */
+  
+  head = dbl_list_head(my_dlist);
+  if(head == NULL || head->value != 5) {
+    printf("ERROR: head should be 5 after re-adding to head\n");
+    return;
+  }
+  
+  printf("Doubly-linked list test passed!\n");
+}

+static void test_compatibility(void)
+{
+  printf("Testing type compatibility...\n");
+  
+  /* Test that stack_t and queue_t are compatible with list operations */
+  STACK(my_stack);
+  QUEUE(my_queue);
+  
+  stack_init(my_stack);
+  queue_init(my_queue);
+  
+  struct elem e1 = { .value = 1 };
+  struct elem e2 = { .value = 2 };
+  
+  /* Test that we can use stack as a list (conceptually) */
+  stack_push(my_stack, &e1);
+  stack_push(my_stack, &e2);
+  
+  /* Test that queue and stack have the same type layout */
+  {
+    stack_t s = my_stack;
+    queue_t q = my_queue;
+    
+    /* This assignment should work if types are compatible */
+    s = q; /* Just for compilation test */
+    
+    printf("Type compatibility test passed!\n");
+  }
+}

diff --git a/test-data-structures.c b/test-data-structures.c
new file mode 100644
index 0000000..92ba522
--- /dev/null
+++ b/test-data-structures.c
@@ -0,0 +1,477 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdbool.h>
+
+/* Include all our new data structure libraries */
+#include "lib/stack.h"
+#include "lib/queue.h"
+#include "lib/circular-list.h"
+#include "lib/dbl-list.h"
+#include "lib/dbl-circ-list.h"
+
+/* Test element structures for each data structure type */
+
+/* For stack and queue - singly linked elements */
+struct elem {
+  struct elem *next;
+  int value;
+};
+
+/* For doubly linked lists */
+struct dbl_elem {
+  struct dbl_elem *next;
+  struct dbl_elem *previous;
+  int value;
+};
+
+/* For circular singly linked list */
+struct circ_elem {
+  struct circ_elem *next;
+  int value;
+};
+
+static void test_stack(void);
+static void test_queue(void);
+static void test_circular_list(void);
+static void test_dbl_list(void);
+static void test_dbl_circ_list(void);
+static void test_compatibility(void);
+
+int main(void)
+{
+  printf("Starting data structures test...\n");
+  
+  test_stack();
+  test_queue();
+  test_circular_list();
+  test_dbl_list();
+  test_dbl_circ_list();
+  test_compatibility();
+  
+  printf("All tests passed!\n");
+  return 0;
+}
+
+static void test_stack(void)
+{
+  printf("Testing stack...\n");
+  
+  STACK(my_stack);
+  stack_init(my_stack);
+  
+  if(!stack_is_empty(my_stack)) {
+    printf("ERROR: stack should be empty initially\n");
+    return;
+  }
+  
+  if(stack_peek(my_stack) != NULL) {
+    printf("ERROR: peek on empty stack should return NULL\n");
+    return;
+  }
+  
+  struct elem e1 = { .value = 1 };
+  struct elem e2 = { .value = 2 };
+  struct elem e3 = { .value = 3 };
+  
+  stack_push(my_stack, &e1);
+  stack_push(my_stack, &e2);
+  stack_push(my_stack, &e3);
+  
+  if(stack_is_empty(my_stack)) {
+    printf("ERROR: stack should not be empty after pushes\n");
+    return;
+  }
+  
+  struct elem *item = stack_peek(my_stack);
+  if(item == NULL || item->value != 3) {
+    printf("ERROR: peek should return 3, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = stack_pop(my_stack);
+  if(item == NULL || item->value != 3) {
+    printf("ERROR: first pop should return 3, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = stack_pop(my_stack);
+  if(item == NULL || item->value != 2) {
+    printf("ERROR: second pop should return 2, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = stack_pop(my_stack);
+  if(item == NULL || item->value != 1) {
+    printf("ERROR: third pop should return 1, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = stack_pop(my_stack);
+  if(item != NULL) {
+    printf("ERROR: pop on empty stack should return NULL\n");
+    return;
+  }
+  
+  printf("Stack test passed!\n");
+}
+
+static void test_queue(void)
+{
+  printf("Testing queue...\n");
+  
+  QUEUE(my_queue);
+  queue_init(my_queue);
+  
+  if(!queue_is_empty(my_queue)) {
+    printf("ERROR: queue should be empty initially\n");
+    return;
+  }
+  
+  struct elem e1 = { .value = 1 };
+  struct elem e2 = { .value = 2 };
+  struct elem e3 = { .value = 3 };
+  
+  queue_enqueue(my_queue, &e1);
+  queue_enqueue(my_queue, &e2);
+  queue_enqueue(my_queue, &e3);
+  
+  struct elem *item = queue_peek(my_queue);
+  if(item == NULL || item->value != 1) {
+    printf("ERROR: peek should return 1, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = queue_dequeue(my_queue);
+  if(item == NULL || item->value != 1) {
+    printf("ERROR: first dequeue should return 1, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = queue_dequeue(my_queue);
+  if(item == NULL || item->value != 2) {
+    printf("ERROR: second dequeue should return 2, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  item = queue_dequeue(my_queue);
+  if(item == NULL || item->value != 3) {
+    printf("ERROR: third dequeue should return 3, got %d\n", item ? item->value : -1);
+    return;
+  }
+  
+  printf("Queue test passed!\n");
+}
+
+static void test_circular_list(void)
+{
+  printf("Testing circular list...\n");
+  
+  CIRCULAR_LIST(my_clist);
+  circular_list_init(my_clist);
+  
+  if(!circular_list_is_empty(my_clist)) {
+    printf("ERROR: circular list should be empty initially\n");
+    return;
+  }
+  
+  if(circular_list_head(my_clist) != NULL || circular_list_tail(my_clist) != NULL) {
+    printf("ERROR: head/tail on empty circular list should return NULL\n");
+    return;
+  }
+  
+  if(circular_list_length(my_clist) != 0) {
+    printf("ERROR: empty circular list should have length 0\n");
+    return;
+  }
+  
+  struct circ_elem e1 = { .value = 1 };
+  struct circ_elem e2 = { .value = 2 };
+  struct circ_elem e3 = { .value = 3 };
+  
+  circular_list_add(my_clist, &e1);
+  
+  if(circular_list_length(my_clist) != 1) {
+    printf("ERROR: circular list should have length 1 after adding one element\n");
+    return;
+  }
+  
+  /* Test single element circular nature */
+  if(e1.next != &e1) {
+    printf("ERROR: single element should point to itself\n");
+    return;
+  }
+  
+  circular_list_add(my_clist, &e2);
+  circular_list_add(my_clist, &e3);
+  
+  if(circular_list_length(my_clist) != 3) {
+    printf("ERROR: circular list should have length 3\n");
+    return;
+  }
+  
+  struct circ_elem *head = circular_list_head(my_clist);
+  struct circ_elem *tail = circular_list_tail(my_clist);
+  
+  if(head == NULL || head->value != 3) {
+    printf("ERROR: head should be 3\n");
+    return;
+  }
+  
+  if(tail == NULL || tail->value != 1) {
+    printf("ERROR: tail should be 1\n");
+    return;
+  }
+  
+  /* Test removal */
+  circular_list_remove(my_clist, &e2);
+  
+  if(circular_list_length(my_clist) != 2) {
+    printf("ERROR: circular list should have length 2 after removal\n");
+    return;
+  }
+  
+  /* Test circular order after removal */
+  struct circ_elem *current = circular_list_head(my_clist);
+  int values[2] = {0};
+  int i = 0;
+  
+  do {
+    values[i++] = current->value;
+    current = current->next;
+  } while(current != circular_list_head(my_clist) && i < 2);
+  
+  if(values[0] != 3 || values[1] != 1) {
+    printf("ERROR: wrong order after removal: %d, %d\n", values[0], values[1]);
+    return;
+  }
+  
+  printf("Circular list test passed!\n");
+}

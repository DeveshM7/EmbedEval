+/** \addtogroup data
+    @{ */
+/**
+ * \defgroup dbl_circ_list Circular doubly-linked list library
+ *
+ * The circular doubly-linked list library provides circular doubly-linked
+ * list operations. Elements must be structs where the first element is a
+ * 'next' pointer and the second element is a 'previous' pointer.
+ *
+ * @{
+ */
+
+#ifndef DBL_CIRC_LIST_H_
+#define DBL_CIRC_LIST_H_
+
+#include <stddef.h>
+#include <stdbool.h>
+#include "lib/list.h"
+
+#define DBL_CIRC_LIST_CONCAT2(s1, s2) s1##s2
+#define DBL_CIRC_LIST_CONCAT(s1, s2) DBL_CIRC_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a circular doubly-linked list.
+ *
+ * This macro declares a circular doubly-linked list with the specified \c name.
+ * Elements must be structs where the first element is a 'next' pointer and the
+ * second element is a 'previous' pointer.
+ *
+ * \param name The name of the circular doubly-linked list.
+ */
+#define DBL_CIRC_LIST(name) \
+         static void *DBL_CIRC_LIST_CONCAT(name,_head) = NULL; \
+         static void **name = (void **)&DBL_CIRC_LIST_CONCAT(name,_head)
+
+/**
+ * The circular doubly-linked list type. Compatible with list_t for mutual compatibility.
+ */
+typedef void ** dbl_circ_list_t;
+
+/* Forward declarations */
+static inline void dbl_circ_list_add_after(dbl_circ_list_t list, void *existing, void *item);
+
+/* Internal structure for elements */
+struct dbl_circ_item {
+  struct dbl_circ_item *next;
+  struct dbl_circ_item *previous;
+};
+
+/**
+ * Initialize a circular doubly-linked list.
+ *
+ * This function initializes a circular doubly-linked list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The circular doubly-linked list to be initialized.
+ */
+static inline void
+dbl_circ_list_init(dbl_circ_list_t list)
+{
+  *list = NULL;
+}
+
+/**
+ * Check if the circular doubly-linked list is empty.
+ *
+ * \param list The circular doubly-linked list.
+ * \return true if empty, false otherwise.
+ */
+static inline bool
+dbl_circ_list_is_empty(dbl_circ_list_t list)
+{
+  return *list == NULL;
+}
+
+/**
+ * Get the length of a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \return The length of the list.
+ */
+static inline unsigned long
+dbl_circ_list_length(dbl_circ_list_t list)
+{
+  struct dbl_circ_item *item;
+  unsigned long n = 0;
+
+  if(*list == NULL) {
+    return 0;
+  }
+
+  item = *list;
+  do {
+    n++;
+    item = item->next;
+  } while(item != *list);
+
+  return n;
+}
+
+/**
+ * Get the head element of a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \return Pointer to the head element, or NULL if empty.
+ */
+static inline void *
+dbl_circ_list_head(dbl_circ_list_t list)
+{
+  return *list;
+}
+
+/**
+ * Get the tail element of a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \return Pointer to the tail element, or NULL if empty.
+ */
+static inline void *
+dbl_circ_list_tail(dbl_circ_list_t list)
+{
+  struct dbl_circ_item *item;
+
+  if(*list == NULL) {
+    return NULL;
+  }
+
+  /* Tail is the element before head */
+  item = *list;
+  while(item->next != *list) {
+    item = item->next;
+  }
+
+  return item;
+}
+
+/**
+ * Internal helper to check if an item is in the list.
+ */
+static inline bool
+dbl_circ_list_contains(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_item *current;
+  struct dbl_circ_item *check_item = item;
+
+  if(*list == NULL || check_item == NULL) {
+    return false;
+  }
+
+  current = *list;
+  do {
+    if(current == check_item) {
+      return true;
+    }
+    current = current->next;
+  } while(current != *list);
+
+  return false;
+}
+
+/**
+ * Internal helper to remove an element if it exists in the list.
+ */
+static inline void
+dbl_circ_list_remove_if_exists(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_item *remove_item = item;
+
+  if(!dbl_circ_list_contains(list, item)) {
+    return;
+  }
+
+  if(remove_item->next == remove_item) {
+    /* Only element in list */
+    *list = NULL;
+  } else {
+    /* Multiple elements */
+    remove_item->previous->next = remove_item->next;
+    remove_item->next->previous = remove_item->previous;
+    if(*list == remove_item) {
+      *list = remove_item->next;
+    }
+  }
+
+  remove_item->next = NULL;
+  remove_item->previous = NULL;
+}
+
+/**
+ * Add an element to the head of a circular doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_circ_list_add_head(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_item *new_item = item;
+  struct dbl_circ_item *tail;
+
+  /* Remove if already in list */
+  dbl_circ_list_remove_if_exists(list, item);
+
+  if(*list == NULL) {
+    /* First element - points to itself */
+    new_item->next = new_item;
+    new_item->previous = new_item;
+    *list = new_item;
+  } else {
+    tail = dbl_circ_list_tail(list);
+    new_item->next = *list;
+    new_item->previous = tail;
+    
+    struct dbl_circ_item *head = *list;
+    head->previous = new_item;
+    tail->next = new_item;
+    *list = new_item;
+  }
+}
+
+/**
+ * Add an element to the tail of a circular doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_circ_list_add_tail(dbl_circ_list_t list, void *item)
+{
+  struct dbl_circ_item *tail;
+
+  if(*list == NULL) {
+    /* Empty list, add to head */
+    dbl_circ_list_add_head(list, item);
+    return;
+  }
+
+  /* Get current tail and add after it */
+  tail = dbl_circ_list_tail(list);
+  dbl_circ_list_add_after(list, tail, item);
+}
+
+/**
+ * Add an element after an existing element in a circular doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param existing A pointer to the existing element.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_circ_list_add_after(dbl_circ_list_t list, void *existing, void *item)
+{
+  struct dbl_circ_item *exist_item = existing;
+  struct dbl_circ_item *new_item = item;
+  struct dbl_circ_item *current;
+
+  /* Remove if already in list */
+  dbl_circ_list_remove_if_exists(list, item);
+
+  if(*list == NULL || exist_item == NULL) {
+    /* Empty list or NULL existing, add to head */
+    dbl_circ_list_add_head(list, item);
+    return;
+  }
+
+  /* Find the existing element */
+  current = *list;
+  do {
+    if(current == exist_item) {
+      /* Found it, insert after */
+      new_item->next = exist_item->next;
+      new_item->previous = exist_item;
+      
+      struct dbl_circ_item *next_item = exist_item->next;
+      next_item->previous = new_item;
+      exist_item->next = new_item;
+      return;
+    }
+    current = current->next;
+  } while(current != *list);
+  
+  /* Existing not found, add to head */
+  dbl_circ_list_add_head(list, item);
+}
+
+/**
+ * Add an element before an existing element in a circular doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The circular doubly-linked list.
+ * \param existing A pointer to the existing element.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_circ_list_add_before(dbl_circ_list_t list, void *existing, void *item)
+{
+  struct dbl_circ_item *exist_item = existing;
+
+  if(*list == NULL || exist_item == NULL) {
+    /* Empty list or NULL existing, add to head */
+    dbl_circ_list_add_head(list, item);
+    return;
+  }
+
+  /* Add after the previous of existing (which is before existing) */
+  dbl_circ_list_add_after(list, exist_item->previous, item);
+}
+
+/**
+ * Remove an element from a circular doubly-linked list.
+ *
+ * \param list The circular doubly-linked list.
+ * \param item The item to be removed.
+ */
+static inline void
+dbl_circ_list_remove(dbl_circ_list_t list, void *item)
+{
+  dbl_circ_list_remove_if_exists(list, item);
+}
+
+#endif /* DBL_CIRC_LIST_H_ */
+
+/** @} */
+/** @} */

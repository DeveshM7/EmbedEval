+
+/** \addtogroup data
+    @{ */
+/**
+ * \defgroup stack Stack library
+ *
+ * The stack library provides LIFO stack operations built on top of
+ * the linked list library.
+ *
+ * @{
+ */
+
+#ifndef STACK_H_
+#define STACK_H_
+
+#include "lib/list.h"
+
+#define STACK_CONCAT2(s1, s2) s1##s2
+#define STACK_CONCAT(s1, s2) STACK_CONCAT2(s1, s2)
+
+/**
+ * Declare a stack.
+ *
+ * This macro declares a stack with the specified \c name. The stack
+ * is implemented using the existing list primitives. Elements must be
+ * structs where the first element is a pointer used for linking.
+ *
+ * \param name The name of the stack.
+ */
+#define STACK(name) \
+         static void *STACK_CONCAT(name,_list) = NULL; \
+         static list_t name = (list_t)&STACK_CONCAT(name,_list)
+
+/**
+ * The stack type. Compatible with list_t for mutual compatibility.
+ */
+typedef void ** stack_t;
+
+/**
+ * Initialize a stack.
+ *
+ * This function initializes a stack. The stack will be empty after this
+ * function has been called.
+ *
+ * \param stack The stack to be initialized.
+ */
+static inline void
+stack_init(stack_t stack)
+{
+  list_init(stack);
+}
+
+/**
+ * Check if the stack is empty.
+ *
+ * \param stack The stack.
+ * \return true if empty, false otherwise.
+ */
+static inline int
+stack_is_empty(stack_t stack)
+{
+  return list_head(stack) == NULL;
+}
+
+/**
+ * Peek at the top element without removing it.
+ *
+ * \param stack The stack.
+ * \return Pointer to the top element, or NULL if empty.
+ */
+static inline void *
+stack_peek(stack_t stack)
+{
+  return list_head(stack);
+}
+
+/**
+ * Push an element onto the stack.
+ *
+ * This function adds an element to the top of the stack.
+ *
+ * \param stack The stack.
+ * \param item A pointer to the item to be pushed.
+ */
+static inline void
+stack_push(stack_t stack, void *item)
+{
+  list_push(stack, item);
+}
+
+/**
+ * Pop the top element from the stack.
+ *
+ * This function removes and returns the top element from the stack.
+ *
+ * \param stack The stack.
+ * \return Pointer to the popped element, or NULL if empty.
+ */
+static inline void *
+stack_pop(stack_t stack)
+{
+  return list_pop(stack);
+}
+
+#endif /* STACK_H_ */
+
+/** @} */
+/** @} */

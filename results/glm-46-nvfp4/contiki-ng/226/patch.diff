+/** \addtogroup data
+    @{ */
+/**
+ * \defgroup circular_list Circular singly-linked list library
+ *
+ * The circular list library provides circular singly-linked list operations.
+ * Elements must be structs where the first element is a pointer used for
+ * linking and the second element (optional) is not used for compatibility.
+ *
+ * @{
+ */
+
+#ifndef CIRCULAR_LIST_H_
+#define CIRCULAR_LIST_H_
+
+#include <stddef.h>
+#include "lib/list.h"
+
+#define CIRCULAR_LIST_CONCAT2(s1, s2) s1##s2
+#define CIRCULAR_LIST_CONCAT(s1, s2) CIRCULAR_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a circular list.
+ *
+ * This macro declares a circular list with the specified \c name. Elements
+ * must be structs where the first element is a pointer used for linking.
+ *
+ * \param name The name of the circular list.
+ */
+#define CIRCULAR_LIST(name) \
+         static void *CIRCULAR_LIST_CONCAT(name,_list) = NULL; \
+         static void **name = (void **)&CIRCULAR_LIST_CONCAT(name,_list)
+
+/**
+ * The circular list type. Compatible with list_t for mutual compatibility.
+ */
+typedef void ** circular_list_t;
+
+/* Forward declaration */
+static inline void circular_list_remove(circular_list_t list, void *item);
+
+/* Internal structure for elements */
+struct circular_item {
+  struct circular_item *next;
+};
+
+/**
+ * Initialize a circular list.
+ *
+ * This function initializes a circular list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The circular list to be initialized.
+ */
+static inline void
+circular_list_init(circular_list_t list)
+{
+  *list = NULL;
+}
+
+/**
+ * Check if the circular list is empty.
+ *
+ * \param list The circular list.
+ * \return true if empty, false otherwise.
+ */
+static inline int
+circular_list_is_empty(circular_list_t list)
+{
+  return *list == NULL;
+}
+
+/**
+ * Get the length of a circular list.
+ *
+ * \param list The circular list.
+ * \return The length of the list.
+ */
+static inline unsigned long
+circular_list_length(circular_list_t list)
+{
+  struct circular_item *item;
+  unsigned long n = 0;
+
+  if(*list == NULL) {
+    return 0;
+  }
+
+  item = *list;
+  do {
+    n++;
+    item = item->next;
+  } while(item != *list);
+
+  return n;
+}
+
+/**
+ * Get the head element of a circular list.
+ *
+ * \param list The circular list.
+ * \return Pointer to the head element, or NULL if empty.
+ */
+static inline void *
+circular_list_head(circular_list_t list)
+{
+  return *list;
+}
+
+/**
+ * Get the tail element of a circular list.
+ *
+ * \param list The circular list.
+ * \return Pointer to the tail element, or NULL if empty.
+ */
+static inline void *
+circular_list_tail(circular_list_t list)
+{
+  struct circular_item *item;
+
+  if(*list == NULL) {
+    return NULL;
+  }
+
+  /* Find the element that points to head */
+  item = *list;
+  while(item->next != *list) {
+    item = item->next;
+  }
+
+  return item;
+}
+
+/**
+ * Add an element to the head of a circular list.
+ *
+ * This function inserts the new element at the head so it becomes the new head.
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The circular list.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+circular_list_add(circular_list_t list, void *item)
+{
+  struct circular_item *new_item = item;
+  struct circular_item *tail;
+
+  /* Remove if already in list */
+  circular_list_remove(list, item);
+
+  if(*list == NULL) {
+    /* First element - points to itself */
+    new_item->next = new_item;
+    *list = new_item;
+  } else {
+    tail = circular_list_tail(list);
+    new_item->next = *list;
+    tail->next = new_item;
+    *list = new_item;
+  }
+}
+
+/**
+ * Remove an element from a circular list.
+ *
+ * \param list The circular list.
+ * \param item The item to be removed.
+ */
+static inline void
+circular_list_remove(circular_list_t list, void *item)
+{
+  struct circular_item *current;
+  struct circular_item *prev;
+  struct circular_item *remove_item = item;
+
+  if(*list == NULL || remove_item == NULL) {
+    return;
+  }
+
+  /* Special case: only one element */
+  if(*list == remove_item && remove_item->next == remove_item) {
+    *list = NULL;
+    remove_item->next = NULL;
+    return;
+  }
+
+  /* Find the element and its predecessor */
+  current = *list;
+  prev = NULL;
+
+  do {
+    if(current == remove_item) {
+      break;
+    }
+    prev = current;
+    current = current->next;
+  } while(current != *list);
+
+  /* If not found, do nothing */
+  if(current != remove_item) {
+    return;
+  }
+
+  /* Remove the element */
+  if(prev == NULL) {
+    /* Removing head - need to find tail to update */
+    struct circular_item *tail = *list;
+    while(tail->next != *list) {
+      tail = tail->next;
+    }
+    tail->next = current->next;
+    *list = current->next;
+  } else {
+    prev->next = current->next;
+  }
+
+  remove_item->next = NULL;
+}
+
+#endif /* CIRCULAR_LIST_H_ */
+
+/** @} */
+/** @} */

+ * must be structs where the first element is a 'next' pointer and the second
+ * element is a 'previous' pointer.
+ *
+ * \param name The name of the doubly-linked list.
+ */
+#define DBL_LIST(name) \
+         static void *DBL_LIST_CONCAT(name,_head) = NULL; \
+         static void **name = (void **)&DBL_LIST_CONCAT(name,_head)
+
+/**
+ * The doubly-linked list type. Compatible with list_t for mutual compatibility.
+ */
+typedef void ** dbl_list_t;
+
+/* Internal structure for elements */
+struct dbl_item {
+  struct dbl_item *next;
+  struct dbl_item *previous;
+};
+
+/**
+ * Initialize a doubly-linked list.
+ *
+ * This function initializes a doubly-linked list. The list will be empty after this
+ * function has been called.
+ *
+ * \param list The doubly-linked list to be initialized.
+ */
+static inline void
+dbl_list_init(dbl_list_t list)
+{
+  *list = NULL;
+}
+
+/**
+ * Check if the doubly-linked list is empty.
+ *
+ * \param list The doubly-linked list.
+ * \return true if empty, false otherwise.
+ */
+static inline bool
+dbl_list_is_empty(dbl_list_t list)
+{
+  return *list == NULL;
+}
+
+/**
+ * Get the length of a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \return The length of the list.
+ */
+static inline unsigned long
+dbl_list_length(dbl_list_t list)
+{
+  struct dbl_item *item;
+  unsigned long n = 0;
+
+  for(item = *list; item != NULL; item = item->next) {
+    n++;
+  }
+
+  return n;
+}
+
+/**
+ * Get the head element of a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \return Pointer to the head element, or NULL if empty.
+ */
+static inline void *
+dbl_list_head(dbl_list_t list)
+{
+  return *list;
+}
+
+/**
+ * Get the tail element of a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \return Pointer to the tail element, or NULL if empty.
+ */
+static inline void *
+dbl_list_tail(dbl_list_t list)
+{
+  struct dbl_item *item;
+
+  if(*list == NULL) {
+    return NULL;
+  }
+
+  item = *list;
+  while(item->next != NULL) {
+    item = item->next;
+  }
+
+  return item;
+}
+
+/**
+ * Internal helper to remove an element if it exists in the list.
+ */
+static inline void
+dbl_list_remove_if_exists(dbl_list_t list, void *item)
+{
+  struct dbl_item *remove_item = item;
+  struct dbl_item *current;
+
+  if(remove_item == NULL || *list == NULL) {
+    return;
+  }
+
+  /* Check if item is in the list */
+  for(current = *list; current != NULL; current = current->next) {
+    if(current == remove_item) {
+      /* Found it, remove it */
+      if(remove_item->previous != NULL) {
+        remove_item->previous->next = remove_item->next;
+      } else {
+        /* Removing head */
+        *list = remove_item->next;
+      }
+      if(remove_item->next != NULL) {
+        remove_item->next->previous = remove_item->previous;
+      }
+      
+      remove_item->next = NULL;
+      remove_item->previous = NULL;
+      return;
+    }
+  }
+}
+
+/**
+ * Add an element to the head of a doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_list_add_head(dbl_list_t list, void *item)
+{
+  struct dbl_item *new_item = item;
+
+  /* Remove if already in list */
+  dbl_list_remove_if_exists(list, item);
+
+  new_item->next = *list;
+  new_item->previous = NULL;
+  
+  if(*list != NULL) {
+    struct dbl_item *head = *list;
+    head->previous = new_item;
+  }
+  
+  *list = new_item;
+}
+
+/**
+ * Add an element to the tail of a doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_list_add_tail(dbl_list_t list, void *item)
+{
+  struct dbl_item *new_item = item;
+  struct dbl_item *tail;
+
+  /* Remove if already in list */
+  dbl_list_remove_if_exists(list, item);
+
+  if(*list == NULL) {
+    /* First element */
+    new_item->next = NULL;
+    new_item->previous = NULL;
+    *list = new_item;
+  } else {
+    tail = dbl_list_tail(list);
+    new_item->next = NULL;
+    new_item->previous = tail;
+    tail->next = new_item;
+  }
+}
+
+/**
+ * Add an element before an existing element in a doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param existing A pointer to the existing element.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_list_add_before(dbl_list_t list, void *existing, void *item)
+{
+  struct dbl_item *exist_item = existing;
+  struct dbl_item *new_item = item;
+  struct dbl_item *current;
+
+  /* Remove if already in list */
+  dbl_list_remove_if_exists(list, item);
+
+  if(*list == NULL || exist_item == NULL) {
+    /* Empty list or NULL existing, add to head */
+    dbl_list_add_head(list, item);
+    return;
+  }
+
+  /* Find the existing element */
+  for(current = *list; current != NULL; current = current->next) {
+    if(current == exist_item) {
+      /* Found it, insert before */
+      new_item->next = exist_item;
+      new_item->previous = exist_item->previous;
+      
+      if(exist_item->previous != NULL) {
+        exist_item->previous->next = new_item;
+      } else {
+        /* Inserting before head */
+        *list = new_item;
+      }
+      exist_item->previous = new_item;
+      return;
+    }
+  }
+  
+  /* Existing not found, add to head */
+  dbl_list_add_head(list, item);
+}
+
+/**
+ * Add an element after an existing element in a doubly-linked list.
+ *
+ * If the element is already in the list, it is first removed before being
+ * re-inserted.
+ *
+ * \param list The doubly-linked list.
+ * \param existing A pointer to the existing element.
+ * \param item A pointer to the item to be added.
+ */
+static inline void
+dbl_list_add_after(dbl_list_t list, void *existing, void *item)
+{
+  struct dbl_item *exist_item = existing;
+  struct dbl_item *new_item = item;
+  struct dbl_item *current;
+
+  /* Remove if already in list */
+  dbl_list_remove_if_exists(list, item);
+
+  if(*list == NULL || exist_item == NULL) {
+    /* Empty list or NULL existing, add to head */
+    dbl_list_add_head(list, item);
+    return;
+  }
+
+  /* Find the existing element */
+  for(current = *list; current != NULL; current = current->next) {
+    if(current == exist_item) {
+      /* Found it, insert after */
+      new_item->next = exist_item->next;
+      new_item->previous = exist_item;
+      
+      if(exist_item->next != NULL) {
+        exist_item->next->previous = new_item;
+      }
+      exist_item->next = new_item;
+      return;
+    }
+  }
+  
+  /* Existing not found, add to head */
+  dbl_list_add_head(list, item);
+}
+
+/**
+ * Remove an element from a doubly-linked list.
+ *
+ * \param list The doubly-linked list.
+ * \param item The item to be removed.
+ */
+static inline void
+dbl_list_remove(dbl_list_t list, void *item)
+{
+  dbl_list_remove_if_exists(list, item);
+}
+
+#endif /* DBL_LIST_H_ */
+
+/** @} */
+/** @} */

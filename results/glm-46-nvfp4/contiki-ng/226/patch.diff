+
+/** \addtogroup data
+    @{ */
+/**
+ * \defgroup queue Queue library
+ *
+ * The queue library provides FIFO queue operations built on top of
+ * the linked list library.
+ *
+ * @{
+ */
+
+#ifndef QUEUE_H_
+#define QUEUE_H_
+
+#include "lib/list.h"
+
+#define QUEUE_CONCAT2(s1, s2) s1##s2
+#define QUEUE_CONCAT(s1, s2) QUEUE_CONCAT2(s1, s2)
+
+/**
+ * Declare a queue.
+ *
+ * This macro declares a queue with the specified \c name. The queue
+ * is implemented using the existing list primitives. Elements must be
+ * structs where the first element is a pointer used for linking.
+ *
+ * \param name The name of the queue.
+ */
+#define QUEUE(name) \
+         static void *QUEUE_CONCAT(name,_list) = NULL; \
+         static list_t name = (list_t)&QUEUE_CONCAT(name,_list)
+
+/**
+ * The queue type. Compatible with list_t for mutual compatibility.
+ */
+typedef void ** queue_t;
+
+/**
+ * Initialize a queue.
+ *
+ * This function initializes a queue. The queue will be empty after this
+ * function has been called.
+ *
+ * \param queue The queue to be initialized.
+ */
+static inline void
+queue_init(queue_t queue)
+{
+  list_init(queue);
+}
+
+/**
+ * Check if the queue is empty.
+ *
+ * \param queue The queue.
+ * \return true if empty, false otherwise.
+ */
+static inline int
+queue_is_empty(queue_t queue)
+{
+  return list_head(queue) == NULL;
+}
+
+/**
+ * Peek at the front element without removing it.
+ *
+ * \param queue The queue.
+ * \return Pointer to the front element, or NULL if empty.
+ */
+static inline void *
+queue_peek(queue_t queue)
+{
+  return list_head(queue);
+}
+
+/**
+ * Enqueue an element at the tail of the queue.
+ *
+ * This function adds an element to the tail of the queue.
+ *
+ * \param queue The queue.
+ * \param item A pointer to the item to be enqueued.
+ */
+static inline void
+queue_enqueue(queue_t queue, void *item)
+{
+  list_add(queue, item);
+}
+
+/**
+ * Dequeue the front element from the queue.
+ *
+ * This function removes and returns the front element from the queue.
+ *
+ * \param queue The queue.
+ * \return Pointer to the dequeued element, or NULL if empty.
+ */
+static inline void *
+queue_dequeue(queue_t queue)
+{
+  return list_pop(queue);
+}
+
+#endif /* QUEUE_H_ */
+
+/** @} */
+/** @} */

+static void test_dbl_circ_list(void)
+{
+  printf("Testing circular doubly-linked list...\n");
+  
+  DBL_CIRC_LIST(my_cdlist);
+  dbl_circ_list_init(my_cdlist);
+  
+  if(!dbl_circ_list_is_empty(my_cdlist)) {
+    printf("ERROR: circular doubly-linked list should be empty initially\n");
+    return;
+  }
+  
+  if(dbl_circ_list_head(my_cdlist) != NULL || dbl_circ_list_tail(my_cdlist) != NULL) {
+    printf("ERROR: head/tail on empty circular doubly-linked list should return NULL\n");
+    return;
+  }
+  
+  struct dbl_elem e1 = { .value = 1 };
+  struct dbl_elem e2 = { .value = 2 };
+  struct dbl_elem e3 = { .value = 3 };
+  
+  dbl_circ_list_add_head(my_cdlist, &e1);
+  
+  if(dbl_circ_list_length(my_cdlist) != 1) {
+    printf("ERROR: circular doubly-linked list should have length 1 after adding one element\n");
+    return;
+  }
+  
+  /* Test single element circular nature */
+  if(e1.next != &e1 || e1.previous != &e1) {
+    printf("ERROR: single element should point to itself in both directions\n");
+    return;
+  }
+  
+  dbl_circ_list_add_head(my_cdlist, &e2);  /* 2, 1 */
+  dbl_circ_list_add_tail(my_cdlist, &e3);  /* 2, 1, 3 */
+  
+  if(dbl_circ_list_length(my_cdlist) != 3) {
+    printf("ERROR: circular doubly-linked list should have length 3\n");
+    return;
+  }
+  
+  struct dbl_elem *head = dbl_circ_list_head(my_cdlist);
+  struct dbl_elem *tail = dbl_circ_list_tail(my_cdlist);
+  
+  if(head == NULL || head->value != 2) {
+    printf("ERROR: head should be 2\n");
+    return;
+  }
+  
+  if(tail == NULL || tail->value != 3) {
+    printf("ERROR: tail should be 3\n");
+    return;
+  }
+  
+  /* Test circular linkage */
+  if(tail->next != head) {
+    printf("ERROR: tail's next should point to head\n");
+    return;
+  }
+  
+  if(head->previous != tail) {
+    printf("ERROR: head's previous should point to tail\n");
+    return;
+  }
+  
+  /* Test add before */
+  struct dbl_elem e4 = { .value = 4 };
+  dbl_circ_list_add_before(my_cdlist, &e1, &e4);  /* 2, 4, 1, 3 */
+  
+  head = dbl_circ_list_head(my_cdlist);
+  struct dbl_elem *second = head->next;
+  
+  if(second == NULL || second->value != 4) {
+    printf("ERROR: second element should be 4 after add_before\n");
+    return;
+  }
+  
+  /* Test removal */
+  dbl_circ_list_remove(my_cdlist, &e4);  /* 2, 1, 3 */
+  
+  if(dbl_circ_list_length(my_cdlist) != 3) {
+    printf("ERROR: circular doubly-linked list should have length 3 after removal\n");
+    return;
+  }
+  
+  /* Test re-adding */
+  dbl_circ_list_add_tail(my_cdlist, &e4);  /* 2, 1, 3, 4 */
+  
+  tail = dbl_circ_list_tail(my_cdlist);
+  if(tail == NULL || tail->value != 4) {
+    printf("ERROR: tail should be 4 after re-adding to tail\n");
+    return;
+  }
+  
+  printf("Circular doubly-linked list test passed!\n");
+}

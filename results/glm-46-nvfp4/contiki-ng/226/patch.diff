+#include "lib/list.h"
+
+#define DBL_LIST_CONCAT2(s1, s2) s1##s2
+#define DBL_LIST_CONCAT(s1, s2) DBL_LIST_CONCAT2(s1, s2)
+
+/**
+ * Declare a doubly-linked list.
+ *

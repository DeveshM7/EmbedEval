diff --git a/os/sys/process-mutex.c b/os/sys/process-mutex.c
new file mode 100644
index 0000000..a08709f
--- /dev/null
+++ b/os/sys/process-mutex.c
@@ -0,0 +1,70 @@
+/*
+ * Copyright (c) 2023, Contiki-NG
+ *
+ * All rights reserved.
+ */
+
+#include <stddef.h>
+#include "sys/process-mutex.h"
+
+/* Forward declarations to avoid including process.h */
+struct process;
+
+typedef uint8_t process_event_t;
+typedef void * process_data_t;
+
+extern struct process *process_current;
+extern process_event_t process_alloc_event(void);
+extern int process_post(struct process *p, process_event_t ev, process_data_t data);
+
+void
+process_mutex_init(process_mutex_t *mutex)
+{
+  mutex->owner = NULL;
+  mutex->num_waiters = 0;
+  mutex->unlock_event = process_alloc_event();
+}
+
+bool
+process_mutex_try_lock(process_mutex_t *mutex)
+{
+  struct process *current = process_current;
+  
+  if(mutex->owner == NULL) {
+    mutex->owner = current;
+    return true;
+  }
+  
+  if(mutex->owner == current) {
+    return false;
+  }
+  
+  if(mutex->num_waiters < PROCESS_MUTEX_MAX_WAITERS) {
+    for(uint8_t i = 0; i < mutex->num_waiters; i++) {
+      if(mutex->waiters[i] == current) {
+        return false;
+      }
+    }
+    mutex->waiters[mutex->num_waiters++] = current;
+  }
+  
+  return false;
+}
+
+void
+process_mutex_unlock(process_mutex_t *mutex)
+{
+  struct process *current = process_current;
+  
+  if(mutex->owner != current) {
+    return;
+  }
+  
+  mutex->owner = NULL;
+  
+  for(uint8_t i = 0; i < mutex->num_waiters; i++) {
+    process_post(mutex->waiters[i], mutex->unlock_event, NULL);
+  }
+  
+  mutex->num_waiters = 0;
+}

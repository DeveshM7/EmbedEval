+/**
+ * \addtogroup sys
+ * @{
+ *
+ * \defgroup process-mutex Process-level Mutexes
+ *
+ * This library provides process-level mutexes for Contiki-NG processes.
+ * Unlike the low-level mutex.h which protects from interrupts, these
+ * mutexes provide exclusive access to shared resources between processes.
+ *
+ * When a mutex is already held by another process, try_lock will fail
+ * and the current process will be recorded as a waiter. When the mutex
+ * is unlocked, all waiting processes are woken so they can retry.
+ *
+ * @{
+ */
+
+#ifndef PROCESS_MUTEX_H_
+#define PROCESS_MUTEX_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Forward declaration */
+struct process;
+
+/* Maximum number of waiting processes per mutex */
+#define PROCESS_MUTEX_MAX_WAITERS 8
+
+/**
+ * \brief Process mutex data structure
+ */
+typedef struct {
+  struct process *owner;               /**< Process currently holding the mutex */
+  struct process *waiters[PROCESS_MUTEX_MAX_WAITERS]; /**< Array of waiting processes */
+  uint8_t num_waiters;                 /**< Number of processes currently waiting */
+  unsigned int unlock_event;            /**< Event posted when mutex is unlocked */
+} process_mutex_t;
+
+/**
+ * \brief Initialize a process mutex
+ * \param mutex Pointer to the mutex to initialize
+ *
+ * This function must be called before using a mutex. It initializes
+ * the mutex to the unlocked state and allocates the unlock event.
+ */
+void process_mutex_init(process_mutex_t *mutex);
+
+/**
+ * \brief Try to acquire a mutex
+ * \param mutex Pointer to the mutex
+ * \retval true The mutex was successfully acquired
+ * \retval false The mutex is already held, current process added to waiters
+ *
+ * If the mutex is free, this function acquires it and returns true.
+ * If the mutex is already held, the current process is recorded as a
+ * waiter and the function returns false.
+ */
+bool process_mutex_try_lock(process_mutex_t *mutex);
+
+/**
+ * \brief Release a mutex
+ * \param mutex Pointer to the mutex to release
+ *
+ * If the current process is the owner, this function releases the mutex
+ * and wakes all waiting processes by posting the unlock event to them.
+ */
+void process_mutex_unlock(process_mutex_t *mutex);
+
+#endif /* PROCESS_MUTEX_H_ */
+/** @} */
+/** @} */

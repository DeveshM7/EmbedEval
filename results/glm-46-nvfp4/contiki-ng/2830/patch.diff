@@ -185,6 +188,19 @@ void *heapmem_realloc(void *ptr, size_t size);
 
 bool heapmem_free(void *ptr);
 
+/**
+ * brief      Allocate and zero-initialize a chunk of memory in the heap.
+ * param nmemb The number of elements to allocate.
+ * param size  The size of each element.
+ * eturn     A pointer to the allocated and zero-initialized memory chunk,
+ *             or NULL if the allocation failed (including when nmemb
+ *             or size is zero).
+ *
+ * sa         heapmem_alloc
+ * sa         heapmem_free
+ */
+void *heapmem_calloc(size_t nmemb, size_t size);
+
 #endif /* HEAPMEM_DEBUG */
 
 /**

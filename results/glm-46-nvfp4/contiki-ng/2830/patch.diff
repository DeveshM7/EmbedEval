diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 8ce7903..31422e0 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -468,6 +468,51 @@ heapmem_free(void *ptr)
   free_chunk(chunk);
   return true;
 }
+#endif /* HEAPMEM_DEBUG */
+
+/* heapmem_calloc: Allocate and zero-initialize a chunk of memory. */
+void *
+#if HEAPMEM_DEBUG
+heapmem_calloc_debug(size_t nmemb, size_t size,
+		     const char *file, const unsigned line)
+#else
+heapmem_calloc(size_t nmemb, size_t size)
+#endif
+{
+  /* According to the task requirements, if either parameter is zero,
+     the request must fail and return NULL. */
+  if(nmemb == 0 || size == 0) {
+    return NULL;
+  }
+
+  /* Check for overflow: nmemb * size should not exceed SIZE_MAX */
+  if(nmemb > SIZE_MAX / size) {
+    return NULL;
+  }
+
+  size_t total_size = nmemb * size;
+
+  /* Allocate memory using the existing allocator */
+  void *ptr = heapmem_alloc(total_size);
+  if(ptr == NULL) {
+    return NULL;
+  }
+
+  /* Zero-initialize the allocated memory */
+  memset(ptr, 0, total_size);
+
+#if HEAPMEM_DEBUG
+  /* For debugging, we need to track the allocation location.
+     However, since we call heapmem_alloc() directly (which already handles
+     debug info), we do not need to store file/line info here. */
+  LOG_DBG("%s: ptr %p nmemb %zu size %zu at %s:%u\n",
+           __func__, ptr, nmemb, size, file, line);
+#endif
+
+  return ptr;
+}
+
+#if HEAPMEM_REALLOC
 

@@ -0,0 +1,52 @@
+/*
+ * Simple CBOR example application
+ */
+
+#include "contiki.h"
+#include "lib/cbor.h"
+#include <stdio.h>
+
+PROCESS(cbor_example_process, "CBOR example process");
+AUTOSTART_PROCESSES(&cbor_example_process);
+
+PROCESS_THREAD(cbor_example_process, ev, data)
+{
+  PROCESS_BEGIN();
+
+  printf("CBOR example: Demonstrating CBOR library usage\n");
+  
+  uint8_t buffer[128];
+  cbor_writer_state_t writer;
+  
+  /* Initialize writer */
+  cbor_init_writer(&writer, buffer, sizeof(buffer));
+  
+  /* Write an array with a byte string and unsigned integer */
+  cbor_open_array(&writer);
+  cbor_write_data(&writer, (const uint8_t *)"test", 4);
+  cbor_write_unsigned(&writer, 123);
+  cbor_close_array(&writer);
+  
+  size_t written = cbor_end_writer(&writer);
+  printf("CBOR data written: %zu bytes\n", written);
+  
+  if(written > 0) {
+    /* Read it back */
+    cbor_reader_state_t reader;
+    cbor_init_reader(&reader, buffer, written);
+    
+    if(cbor_peek_next(&reader) == CBOR_MAJOR_TYPE_ARRAY) {
+      if(cbor_read_array(&reader) == 2) {
+        size_t data_size;
+        const uint8_t *data = cbor_read_data(&reader, &data_size);
+        uint64_t value;
+        if(data && cbor_read_unsigned(&reader, &value) != CBOR_SIZE_NONE) {
+          printf("Round-trip successful: read data '%.*s' and value %llu\n",
+                 (int)data_size, data, (unsigned long long)value);
+        }
+      }
+    }
+  }
+
+  PROCESS_END();
+}

diff --git a/test_minimum.c b/test_minimum.c
new file mode 100644
index 0000000..65f5f05
--- /dev/null
+++ b/test_minimum.c
@@ -0,0 +1,56 @@
+#include <stdio.h>
+#include <string.h>
+#include "lib/cbor.h"
+
+int main(void)
+{
+  uint8_t buffer[256];
+  cbor_writer_state_t writer;
+  cbor_reader_state_t reader;
+  const uint8_t test_data[] = "Hello";
+  uint64_t test_uint = 42;
+  
+  /* Write test */
+  cbor_init_writer(&writer, buffer, sizeof(buffer));
+  cbor_open_array(&writer);
+  cbor_write_data(&writer, test_data, 5);
+  cbor_write_unsigned(&writer, test_uint);
+  cbor_close_array(&writer);
+  
+  size_t written = cbor_end_writer(&writer);
+  printf("Written: %zu bytes\n", written);
+
+  /* Read test */
+  cbor_init_reader(&reader, buffer, written);
+  
+  if(cbor_peek_next(&reader) != CBOR_MAJOR_TYPE_ARRAY) {
+    printf("FAIL: Not array\n");
+    return 1;
+  }
+  
+  if(cbor_read_array(&reader) != 2) {
+    printf("FAIL: Array size not 2\n");
+    return 1;
+  }
+  
+  size_t data_size;
+  const uint8_t *data = cbor_read_data(&reader, &data_size);
+  if(!data || data_size != 5) {
+    printf("FAIL: Data size wrong\n");
+    return 1;
+  }
+  
+  uint64_t value;
+  if(cbor_read_unsigned(&reader, &value) == CBOR_SIZE_NONE) {
+    printf("FAIL: Read unsigned failed\n");
+    return 1;
+  }
+  
+  if(!cbor_end_reader(&reader)) {
+    printf("FAIL: End reader failed\n");
+    return 1;
+  }
+  
+  printf("PASS: CBOR works\n");
+  return 0;
+}

+
+/**
+ * \file
+ *   CBOR (Concise Binary Object Representation) encoding/decoding library
+ * \author
+ *   RISC-V contributors
+ */
+
+/**
+ * \addtogroup cbor
+ * @{
+ */
+
+#ifndef CBOR_H_
+#define CBOR_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+/**
+ * Type definitions for CBOR major types
+ */
+typedef enum {
+  CBOR_MAJOR_TYPE_UNSIGNED_INT = 0,
+  CBOR_MAJOR_TYPE_ARRAY = 4,
+} cbor_major_type_t;
+
+/**
+ * Return value type for CBOR size operations
+ */
+typedef enum {
+  CBOR_SIZE_NONE = 0,
+} cbor_size_t;
+
+/**
+ * CBOR writer state structure
+ */
+typedef struct {
+  uint8_t *buffer;
+  size_t buffer_size;
+  size_t pos;
+  bool error;
+} cbor_writer_state_t;
+
+/**
+ * CBOR reader state structure
+ */
+typedef struct {
+  const uint8_t *cbor;
+  size_t cbor_size;
+  size_t pos;
+  bool error;
+} cbor_reader_state_t;
+
+/**
+ * \name CBOR Writer API
+ * @{
+ */
+
+/**
+ * Initialize a CBOR writer state
+ *
+ * \param state The writer state to initialize
+ * \param buffer The buffer to write to
+ * \param buffer_size The size of the buffer
+ */
+void cbor_init_writer(cbor_writer_state_t *state, uint8_t *buffer, size_t buffer_size);
+
+/**
+ * Open an array in the CBOR output
+ *
+ * \param state The writer state
+ */
+void cbor_open_array(cbor_writer_state_t *state);
+
+/**
+ * Write raw data as a byte string
+ *
+ * \param state The writer state
+ * \param data The data to write
+ * \param data_size The size of the data
+ */
+void cbor_write_data(cbor_writer_state_t *state, const uint8_t *data, size_t data_size);
+
+/**
+ * Write an unsigned integer
+ *
+ * \param state The writer state
+ * \param value The value to write
+ */
+void cbor_write_unsigned(cbor_writer_state_t *state, uint64_t value);
+
+/**
+ * Close the current array
+ *
+ * \param state The writer state
+ */
+void cbor_close_array(cbor_writer_state_t *state);
+
+/**
+ * Finalize writing and get the number of bytes written
+ *
+ * \param state The writer state
+ * \return Number of bytes written, or 0 on failure
+ */
+size_t cbor_end_writer(cbor_writer_state_t *state);
+
+/** @} */
+
+/**
+ * \name CBOR Reader API
+ * @{
+ */
+
+/**
+ * Initialize a CBOR reader state
+ *
+ * \param state The reader state to initialize
+ * \param cbor The CBOR data to read
+ * \param cbor_size The size of the CBOR data
+ */
+void cbor_init_reader(cbor_reader_state_t *state, const uint8_t *cbor, size_t cbor_size);
+
+/**
+ * Peek at the next item's major type without consuming it
+ *
+ * \param state The reader state
+ * \return The major type of the next item
+ */
+cbor_major_type_t cbor_peek_next(cbor_reader_state_t *state);
+
+/**
+ * Read an array header and get the number of elements
+ *
+ * \param state The reader state
+ * \return The number of elements in the array
+ */
+size_t cbor_read_array(cbor_reader_state_t *state);
+
+/**
+ * Read a byte string and return a pointer to the data
+ *
+ * \param state The reader state
+ * \param data_size Pointer to store the size of the data
+ * \return Pointer to the data, or NULL on failure
+ */
+const uint8_t *cbor_read_data(cbor_reader_state_t *state, size_t *data_size);
+
+/**
+ * Read an unsigned integer
+ *
+ * \param state The reader state
+ * \param value Pointer to store the value
+ * \return CBOR_SIZE_NONE on failure, non-zero on success
+ */
+cbor_size_t cbor_read_unsigned(cbor_reader_state_t *state, uint64_t *value);
+
+/**
+ * End reading and check if all data was consumed
+ *
+ * \param state The reader state
+ * \return true if all data was consumed, false otherwise
+ */
+bool cbor_end_reader(cbor_reader_state_t *state);
+
+/** @} */
+
+#endif /* CBOR_H_ */

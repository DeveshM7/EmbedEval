+/**
+ * \file
+ *         Bit reversal utilities for 802.15.4g radio payloads
+ * \author
+ *         Contiki-NG Contributors
+ */
+
+#ifndef BITREV_H_
+#define BITREV_H_
+
+#include <stdint.h>
+#include <stddef.h>
+
+/**
+ * Reverse the bit order within a single byte.
+ *
+ * \param byte The byte to reverse
+ * \return The byte with reversed bit order
+ */
+uint8_t bitrev_byte(uint8_t byte);
+
+/**
+ * Reverse the bit order within each byte of an array in place.
+ *
+ * \param data Pointer to the array to process
+ * \param len Number of bytes to process (0 means no operation)
+ */
+void bitrev_array(uint8_t *data, size_t len);
+
+/**
+ * Copy an array while reversing the bit order within each byte.
+ *
+ * \param input Pointer to the input array (must not be NULL if len > 0)
+ * \param output Pointer to the output array (must not be NULL if len > 0)
+ * \param len Number of bytes to process (0 means no operation)
+ */
+void bitrev_array_copy(const uint8_t *input, uint8_t *output, size_t len);
+
+#endif /* BITREV_H_ */

+/**
+ * \file
+ *         Bit reversal utilities for 802.15.4g radio payloads
+ * \author
+ *         Contiki-NG Contributors
+ */
+
+#include "bitrev.h"
+
+/*---------------------------------------------------------------------------*/
+uint8_t
+bitrev_byte(uint8_t byte)
+{
+  /* Efficient bit reversal using bit manipulation */
+  byte = (byte & 0xF0) >> 4 | (byte & 0x0F) << 4;
+  byte = (byte & 0xCC) >> 2 | (byte & 0x33) << 2;
+  byte = (byte & 0xAA) >> 1 | (byte & 0x55) << 1;
+  return byte;
+}
+/*---------------------------------------------------------------------------*/
+void
+bitrev_array(uint8_t *data, size_t len)
+{
+  size_t i;
+  
+  if(data == NULL || len == 0) {
+    return;
+  }
+  
+  for(i = 0; i < len; i++) {
+    data[i] = bitrev_byte(data[i]);
+  }
+}
+/*---------------------------------------------------------------------------*/
+void
+bitrev_array_copy(const uint8_t *input, uint8_t *output, size_t len)
+{
+  size_t i;
+  
+  if(input == NULL || output == NULL || len == 0) {
+    return;
+  }
+  
+  for(i = 0; i < len; i++) {
+    output[i] = bitrev_byte(input[i]);
+  }
+}
+/*---------------------------------------------------------------------------*/

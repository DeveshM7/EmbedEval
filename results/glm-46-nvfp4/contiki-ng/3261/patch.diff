diff --git a/test_vulnerability.c b/test_vulnerability.c
new file mode 100644
index 0000000..997b19f
--- /dev/null
+++ b/test_vulnerability.c
@@ -0,0 +1,108 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+/* Simulate the vulnerable code */
+int vulnerable_code(const char *filter, int len)
+{
+  char *value = NULL;
+  char lastchar = '\0';
+  
+  if(len) {
+    value = strchr(filter, '=');
+    value[0] = '\0'; /* BUG: NULL dereference if value is NULL */
+    ++value;
+    len -= strlen(filter) + 1;
+    
+    if(strcmp(filter, "href") == 0 && value[0] == '/') {
+      ++value;
+      --len;
+    }
+    
+    lastchar = value[len - 1]; /* BUG: Out of bounds if len == 0 */
+    value[len - 1] = '\0'; /* BUG: Out of bounds if len == 0 */
+  }
+  return 0;
+}
+
+/* Simulate the fixed code */
+int test_for_nul(const char *s, size_t len)
+{
+  return memchr(s, '\0', len) != NULL;
+}
+
+int fixed_code(const char *filter, int len)
+{
+  char *value = NULL;
+  char lastchar = '\0';
+  
+  if(len) {
+    /* Validate filter format */
+    char *equals = strchr(filter, '=');
+    if(equals == NULL || equals[1] == '\0' || test_for_nul(filter, len)) {
+      return 1; /* Bad request */
+    }
+    
+    value = equals;
+    *value = '\0';
+    ++value;
+    
+    len -= strlen(filter) + 1;
+    
+    if(len > 0) {
+      lastchar = value[len - 1];
+      value[len - 1] = '\0';
+    } else {
+      lastchar = '\0';
+    }
+  }
+  return 0; /* OK */
+}
+
+int main()
+{

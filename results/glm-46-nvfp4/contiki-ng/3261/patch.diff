+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+void test_vulnerable_parsing()
+{
+  /* Test cases from the task */
+  printf("Testing vulnerable parsing...\n");
+  
+  /* Case 1: Filter without = */
+  const char *test1 = "rt";
+  printf("Test 1 - Filter without '=':\n");
+  printf("  Input: '%s'\n", test1);
+  // This would crash: value[0] = '\0' where value = NULL
+  
+  /* Case 2: Filter with empty value */
+  const char *test2 = "rt=";
+  printf("Test 2 - Filter with empty value:\n");
+  printf("  Input: '%s'\n", test2);
+  // This would crash: value[len - 1] where len = 0
+  
+  /* Case 3: Filter with empty href */
+  const char *test3 = "href=/";
+  printf("Test 3 - Filter href=/:\n");
+  printf("  Input: '%s'\n", test3);
+  // This would crash: value[len - 1] where len = 0
+  
+  /* Case 4: Filter with NUL */
+  char test4[] = "href=o\0x";
+  printf("Test 4 - Filter with NUL:\n");
+  printf("  Input: 'href=...\\0'\n");
+}
+
+int main()
+{
+  test_vulnerable_parsing();
+  printf("All test cases identified\n");
+  return 0;
+}

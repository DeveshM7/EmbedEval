   int len = coap_get_header_uri_query(request, &filter);
 
   if(len) {
+    /* Validate filter format - check for '=' */
+    char *equals = strchr(filter, '=');
+    if(equals == NULL) {
+      coap_set_status_code(response, BAD_REQUEST_4_00);
+      coap_set_payload(response, "", 0); /* Empty payload */
+      return;
+    }
+    
+    /* Check if value is empty */
+    if(equals[1] == '\0') {
+      coap_set_status_code(response, BAD_REQUEST_4_00);
+      coap_set_payload(response, "", 0); /* Empty payload */
+      return;

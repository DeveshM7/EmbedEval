diff --git a/test_filter_validation.c b/test_filter_validation.c
new file mode 100644
index 0000000..318ad63
--- /dev/null
+++ b/test_filter_validation.c
@@ -0,0 +1,60 @@
+#include <stdio.h>
+#include <string.h>
+
+/* Port of the validation function */
+int validate_filter(const char *filter, int len)
+{
+  /* Check for NUL byte in filter */
+  if(memchr(filter, '\0', len) != NULL) {
+    return 0; /* Contains NUL byte */
+  }
+  
+  /* Check if filter contains '=' */
+  char *equals = strchr(filter, '=');
+  if(equals == NULL) {
+    return 0; /* No '=' found */
+  }
+  
+  /* Check if value is empty */
+  if(equals[1] == '\0') {
+    return 0; /* Empty value */
+  }
+  
+  return 1; /* Valid filter */
+}
+
+int main()
+{
+  printf("Testing filter validation...\n");
+  
+  struct {
+    const char *name;
+    const char *filter;
+    int len;
+    int expected;
+  } tests[] = {
+    {"Valid filter", "rt=test", 7, 1},
+    {"No equals", "rt", 2, 0},
+    {"Empty value", "rt=", 3, 0},
+    {"Empty href", "href=/", 6, 0},
+    {"NUL in filter", "href=o\0x", 7, 0},
+    {"Valid href", "href=/test", 10, 1},
+    {"Valid wildcard", "rt=test*", 8, 1},
+    {NULL, NULL, 0, 0}
+  };
+  
+  int passed = 0;
+  for(int i = 0; tests[i].name; i++) {
+    int result = validate_filter(tests[i].filter, tests[i].len);
+    printf("Test '%s': ", tests[i].name);
+    if(result == tests[i].expected) {
+      printf("PASSED\n");
+      passed++;
+    } else {
+      printf("FAILED (got %d, expected %d)\n", result, tests[i].expected);
+    }
+  }
+  
+  printf("\n%d/%d tests passed\n", passed, 6);
+  return (passed == 6) ? 0 : 1;
+}

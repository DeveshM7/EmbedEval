-    value[len - 1] = '\0';
+    /* Check if there's at least one character to access */
+    if(len > 0) {
+      lastchar = value[len - 1];
+      value[len - 1] = '\0';
+    } else {
+      lastchar = '\0';
+    }
   }
 #endif /* COAP_LINK_FORMAT_FILTERING */
 
@@ -122,7 +159,7 @@ well_known_core_get_handler(coap_message_t *request, coap_message_t *response,
     if(len) {
       if(strcmp(filter, "href") == 0) {
         attrib = strstr(resource->url, value);

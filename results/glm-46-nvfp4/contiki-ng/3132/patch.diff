+/**
+ * Macro to create a NAT64 IPv6 address from an IPv4 address.
+ * Sets the IPv6 address to 64:ff9b::/96 with the IPv4 address in the low 32 bits.
+ * \param ip6 Pointer to uip_ip6addr_t to set
+ * \param a First IPv4 octet
+ * \param b Second IPv4 octet  
+ * \param c Third IPv4 octet
+ * \param d Fourth IPv4 octet
+ */
+#define uip_nat64addr(ip6, a, b, c, d) do { \
+  (ip6)->u8[0] = 0x64; (ip6)->u8[1] = 0xff; \
+  (ip6)->u8[2] = 0x9b; (ip6)->u8[3] = 0x00; \
+  memset(&(ip6)->u8[4], 0, 8); \
+  (ip6)->u8[12] = (a); (ip6)->u8[13] = (b); \
+  (ip6)->u8[14] = (c); (ip6)->u8[15] = (d); \
+} while(0)
+
+/** @} */

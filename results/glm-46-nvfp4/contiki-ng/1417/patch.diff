diff --git a/test_link_selection_fix.c b/test_link_selection_fix.c
new file mode 100644
index 0000000..01852a9
--- /dev/null
+++ b/test_link_selection_fix.c
@@ -0,0 +1,67 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Mock TSCH structures
+typedef struct { uint8_t u8[8]; } linkaddr_t;
+#define LINK_OPTION_TX 1
+#define LINK_OPTION_RX 2
+
+struct tsch_link {
+  uint8_t link_options;
+  linkaddr_t addr;
+  // Other fields omitted for test
+};
+
+// Reproduce the current logic from tsch-schedule.c lines 452-461
+struct tsch_link *simulate_backup_maintenance(
+    struct tsch_link *new_best, 
+    struct tsch_link *l, 
+    struct tsch_link *curr_best, 
+    struct tsch_link *curr_backup)
+{
+  if(curr_backup == NULL) {
+    /* Check if 'l' can be used as backup */
+    if(new_best != l && (l->link_options & LINK_OPTION_RX)) {
+      printf("Setting 'l' as backup (RX link)\n");
+      curr_backup = l;
+    }
+    /* Check if curr_best can be used as backup */
+    if(new_best != curr_best && (curr_best->link_options & LINK_OPTION_RX)) {
+      printf("Setting 'curr_best' as backup (RX link)\n");
+      curr_backup = curr_best;
+    }
+  }
+  return curr_backup;
+}
+
+// Test case: TX vs RX links at same slot
+void test_tx_vs_rx_links(void)
+{
+  printf("=== Test: TX vs RX links at same slot ===\n");
+  
+  struct tsch_link tx_link = {.link_options = LINK_OPTION_TX, .addr = {{2}}};
+  struct tsch_link rx_link = {.link_options = LINK_OPTION_RX, .addr = {{2}}};
+  
+  // Case 1: TX selected as new_best (current behavior)
+  printf("Case 1: TX prioritized over RX\n");
+  struct tsch_link *curr_best = &tx_link;
+  struct tsch_link *l = &rx_link;
+  struct tsch_link *new_best = &tx_link;  // TX wins
+  struct tsch_link *curr_backup = NULL;
+  
+  curr_backup = simulate_backup_maintenance(new_best, l, curr_best, curr_backup);
+  
+  printf("Result: curr_backup = %s\n", 
+         curr_backup ? (curr_backup->link_options & LINK_OPTION_TX ? "TX" : "RX") : "NULL");
+  
+  // This shows the issue: when TX is selected but queue is empty, 
+  // backup should be available but current logic might not set it correctly
+  
+  printf("\n");
+}
+
+int main()
+{
+  test_tx_vs_rx_links();
+  return 0;
+}
diff --git a/test_tsch_link_selection.c b/test_tsch_link_selection.c
new file mode 100644
index 0000000..4c6efd3
--- /dev/null
+++ b/test_tsch_link_selection.c
@@ -0,0 +1,59 @@
+#include "contiki.h"
+#include "net/mac/tsch/tsch.h"
+#include "net/mac/tsch/tsch-schedule.h"
+#include "net/packetbuf.h"
+#include <stdio.h>
+
+/* Mock packetbuf functions for testing */
+static uint8_t test_frame_type = FRAME802154_DATAFRAME;
+static linkaddr_t test_dest_addr;
+
+uint8_t
+packetbuf_attr(uint8_t attr)
+{
+  if(attr == PACKETBUF_ATTR_FRAME_TYPE) {
+    return test_frame_type;
+  }
+  return 0;
+}
+
+const linkaddr_t *
+packetbuf_addr(uint8_t addr_type)
+{
+  if(addr_type == PACKETBUF_ADDR_RECEIVER) {
+    return &test_dest_addr;
+  }
+  return NULL;
+}
+
+/* Test case 1: Node with primary TX link and backup RX link */
+void test_primary_tx_backup_rx(void)
+{
+  struct tsch_link primary_tx = {
+    .link_options = LINK_OPTION_TX,
+    .addr = { {0, 0, 0, 0, 0, 0, 0, 2} }
+  };
+  
+  struct tsch_link backup_rx = {
+    .link_options = LINK_OPTION_RX, 
+    .addr = { {0, 0, 0, 0, 0, 0, 0, 2} }
+  };
+
+  /* Test the comparator logic */
+  struct tsch_link *result = default_tsch_link_comparator(&primary_tx, &backup_rx);
+  
+  printf("Test 1: primary TX vs backup RX to same dest\n");
+  printf("Primary TX: options=0x%02x, dest=%u\n", 
+         primary_tx.link_options, primary_tx.addr.u8[7]);
+  printf("Backup RX:_options=0x%02x, dest=%u\n", 
+         backup_rx.link_options, backup_rx.addr.u8[7]);
+  printf("Selected: options=0x%02x, dest=%u\n\n", 
+         result->link_options, result->addr.u8[7]);
+}
+
+int main()
+{
+  printf("Testing TSCH link selection...\n");
+  test_primary_tx_backup_rx();
+  return 0;
+}

diff --git a/test_backup_update.c b/test_backup_update.c
new file mode 100644
index 0000000..7526a80
--- /dev/null
+++ b/test_backup_update.c
@@ -0,0 +1,103 @@
+#include <stdio.h>
+#include <stdint.h>
+
+// Mock TSCH structures
+typedef struct { uint8_t u8[8]; } linkaddr_t;
+#define LINK_OPTION_TX 1
+#define LINK_OPTION_RX 2
+
+struct tsch_link {
+  uint8_t link_options;
+  linkaddr_t addr;
+};
+
+// Current logic from tsch-schedule.c lines 452-457 (backup maintenance)
+struct tsch_link *current_backup_logic(
+    struct tsch_link *new_best, 
+    struct tsch_link *l, 
+    struct tsch_link *curr_best)
+{
+  struct tsch_link *curr_backup = NULL;
+
+  /* Maintain backup_link */
+  if(curr_backup == NULL) {
+    /* Check if 'l' best can be used as backup */
+    if(new_best != l && (l->link_options & LINK_OPTION_RX)) { /* Does 'l' have Rx flag? */
+      curr_backup = l;
+    }
+    /* Check if curr_best can be used as backup */
+    if(new_best != curr_best && (curr_best->link_options & LINK_OPTION_RX)) { /* Does curr_best have Rx flag? */
+      curr_backup = curr_best;
+    }
+  }
+  
+  return curr_backup;
+}
+
+// Enhanced logic
+struct tsch_link *enhanced_backup_logic(
+    struct tsch_link *new_best, 
+    struct tsch_link *l, 
+    struct tsch_link *curr_best)
+{
+  struct tsch_link *curr_backup = NULL;
+
+  /* Enhanced backup_link maintenance - always check for backup when TX-only selected */
+  if(curr_backup == NULL) {
+    /* When a TX-only link is selected, always ensure backup if possible */
+    if(new_best != NULL && (new_best->link_options & LINK_OPTION_TX) && !(new_best->link_options & LINK_OPTION_RX)) {
+      /* Selected TX-only - get ANY available RX as backup */
+      if(l != new_best && (l->link_options & LINK_OPTION_RX)) { /* l is RX and not selected */
+        printf("  -> Setting 'l' as backup (TX-only selected, l is RX)\n");
+        curr_backup = l;
+      } else if(curr_best != new_best && (curr_best->link_options & LINK_OPTION_RX)) { /* curr_best is RX and not selected */
+        printf("  -> Setting curr_best as backup (TX-only selected, curr_best is RX)\n");
+        curr_backup = curr_best;
+      }
+    } else {
+      /* Original logic for other cases (TX+RX vs TX+RX, etc.) */
+      if(new_best != l && (l->link_options & LINK_OPTION_RX)) {
+        printf("  -> Setting 'l' as backup (original logic)\n");
+        curr_backup = l;
+      }
+      if(new_best != curr_best && (curr_best->link_options & LINK_OPTION_RX)) {
+        printf("  -> Setting curr_best as backup (original logic)\n");
+        curr_backup = curr_best;
+      }
+    }
+  }
+  
+  return curr_backup;
+}
+
+void test_case(const char *name, 
+    struct tsch_link *new_best, struct tsch_link *l, struct tsch_link *curr_best)
+{
+  printf("=== %s ===\n", name);
+  printf("new_best: 0x%02x, l: 0x%02x, curr_best: 0x%02x\n",
+         new_best->link_options, l->link_options, curr_best->link_options);
+  
+  struct tsch_link *curr_b1, *curr_b2;
+  
+  printf("Current logic result: ");
+  curr_b1 = current_backup_logic(new_best, l, curr_best);
+  printf("%s\n", curr_b1 ? "backup set" : "no backup");
+  
+  printf("Enhanced logic result: ");
+  curr_b2 = enhanced_backup_logic(new_best, l, curr_best);
+  printf("%s\n\n", curr_b2 ? "backup set" : "no backup");
+}
+
+int main() {
+  struct tsch_link tx_link = {.link_options = LINK_OPTION_TX, .addr = {{2}}};
+  struct tsch_link rx_link = {.link_options = LINK_OPTION_RX, .addr = {{2}}};
+  struct tsch_link txrx_link = {.link_options = LINK_OPTION_TX | LINK_OPTION_RX, .addr = {{2}}};
+  
+  // Case 1: TX selected vs RX available (key issue case)
+  test_case("TX vs RX", &tx_link, &rx_link, &tx_link);
+  
+  // Case 2: TX+RX vs TX+RX 
+  test_case("TX+RX vs TX+RX", &txrx_link, &txrx_link, &txrx_link);
+  
+  return 0;
+}

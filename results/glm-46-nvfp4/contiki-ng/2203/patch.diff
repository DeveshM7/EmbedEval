diff --git a/os/lib/heapmem.c b/os/lib/heapmem.c
index 44eab9d..771e1a3 100644
--- a/os/lib/heapmem.c
+++ b/os/lib/heapmem.c
@@ -51,6 +51,23 @@
 #include "lib/heapmem.h"
 #include "lib/assert.h"
 #include "sys/cc.h"
+/* Zone configuration */
+#ifdef HEAPMEM_CONF_MAX_ZONES
+#define HEAPMEM_MAX_ZONES HEAPMEM_CONF_MAX_ZONES
+#else
+#define HEAPMEM_MAX_ZONES 1
+#endif
+
+typedef struct {
+  char name[16];
+  size_t reserved_size;
+  size_t allocated_size;
+  heapmem_zone_t id;
+  bool in_use;
+} zone_info_t;
+
+static zone_info_t zones[HEAPMEM_MAX_ZONES];
+static heapmem_zone_t next_zone_id = 1;
 
 /* The HEAPMEM_CONF_ARENA_SIZE parameter determines the size of the
    space that will be statically allocated in this module. */
@@ -132,6 +149,7 @@
  * list removals.
  */
 typedef struct chunk {
+  heapmem_zone_t zone;
   struct chunk *prev;
   struct chunk *next;
   size_t size;
@@ -335,6 +353,7 @@ heapmem_alloc(size_t size)
   }
 
   chunk->flags = CHUNK_FLAG_ALLOCATED;
+  chunk->zone = HEAPMEM_ZONE_GENERAL;
 
 #if HEAPMEM_DEBUG
   chunk->file = file;
@@ -528,3 +547,100 @@ heapmem_alignment(void)
 {
   return HEAPMEM_ALIGNMENT;
 }
+
+/* Zone functions implementation */
+void
+heapmem_zone_reset(void)
+{
+  for(size_t i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+    zones[i].in_use = false;
+    zones[i].allocated_size = 0;
+  }
+  next_zone_id = 1;
+}
+
+heapmem_zone_t
+heapmem_zone_register(const char *name, size_t zone_size)
+{
+  if(name == NULL || zone_size == 0) {
+    return HEAPMEM_ZONE_INVALID;
+  }
+
+  /* Check for duplicate names */
+  for(size_t i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+    if(zones[i].in_use && strcmp(zones[i].name, name) == 0) {
+      return HEAPMEM_ZONE_INVALID;
+    }
+  }
+
+  /* Find a free slot */
+  for(size_t i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+    if(!zones[i].in_use) {
+      zones[i].in_use = true;
+      strncpy(zones[i].name, name, sizeof(zones[i].name) - 1);
+      zones[i].name[sizeof(zones[i].name) - 1] = '\0';
+      zones[i].reserved_size = zone_size;
+      zones[i].allocated_size = 0;
+      zones[i].id = next_zone_id++;
+      return zones[i].id;
+    }
+  }
+
+  return HEAPMEM_ZONE_INVALID;
+}
+
+void *
+heapmem_zone_alloc(heapmem_zone_t zone, size_t size)
+{
+  if(HEAPMEM_MAX_ZONES == 1) {
+    /* Only general zone available */
+    if(zone != HEAPMEM_ZONE_GENERAL) {
+      return NULL;
+    }
+    return heapmem_alloc(size);
+  }
+
+  /* Find the zone */
+  zone_info_t *zone_info = NULL;
+  for(size_t i = 0; i < HEAPMEM_MAX_ZONES; i++) {
+    if(zones[i].in_use && zones[i].id == zone) {
+      zone_info = &zones[i];
+      break;
+    }
+  }
+
+  if(zone_info == NULL) {
+    /* Zone not found or general zone allocation */
+    if(zone == HEAPMEM_ZONE_GENERAL) {
+      return heapmem_alloc(size);
+    }
+    return NULL;
+  }
+
+  /* Check if allocation would exceed the zone's reserved size */
+  size_t aligned_size = ALIGN(size);
+  if(zone_info->allocated_size + aligned_size > zone_info->reserved_size) {
+    return NULL;
+  }
+
+  /* Manual allocation to set zone tracking */
+  if(size > HEAPMEM_ARENA_SIZE) {
+    return NULL;
+  }
+
+  chunk_t *chunk = get_free_chunk(size);
+  if(chunk == NULL) {
+    chunk = extend_space(sizeof(chunk_t) + size);
+    if(chunk == NULL) {
+      return NULL;
+    }
+    chunk->size = aligned_size;
+  }
+
+  chunk->flags = CHUNK_FLAG_ALLOCATED;
+  chunk->zone = zone;
+
+  zone_info->allocated_size += aligned_size;
+
+  return GET_PTR(chunk);
+}

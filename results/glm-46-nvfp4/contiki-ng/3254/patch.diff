+
+#include "sys/log.h"
+#define LOG_MODULE  "IP64"
+#define LOG_LEVEL   LOG_LEVEL_IP64
+
+/*---------------------------------------------------------------------------*/
+
+struct dns_hdr {
+  uint8_t id[2];
+  uint8_t flags1, flags2;
+#define DNS_FLAG1_RESPONSE        0x80
+#define DNS_FLAG1_OPCODE_STATUS   0x10
+#define DNS_FLAG1_OPCODE_INVERSE  0x08
+#define DNS_FLAG1_OPCODE_STANDARD 0x00
+#define DNS_FLAG1_AUTHORATIVE     0x04
+#define DNS_FLAG1_TRUNC           0x02
+#define DNS_FLAG1_RD              0x01
+#define DNS_FLAG2_RA              0x80
+#define DNS_FLAG2_ERR_MASK        0x0f
+#define DNS_FLAG2_ERR_NONE        0x00
+#define DNS_FLAG2_ERR_NAME        0x03
+  uint8_t numquestions[2];
+  uint8_t numanswers[2];
+  uint8_t numauthrr[2];
+  uint8_t numextrarr[2];
+};
+
+#define DNS_QUESTION_TYPE0  0
+#define DNS_QUESTION_TYPE1  1
+#define DNS_QUESTION_CLASS0 2
+#define DNS_QUESTION_CLASS1 3
+#define DNS_QUESTION_SIZE   4
+
+struct dns_answer {
+  /* DNS answer record starts with either a domain name or a pointer
+   * to a name already present somewhere in the packet. */
+  uint8_t type[2];
+  uint8_t class[2];
+  uint8_t ttl[4];
+  uint8_t len[2];
+  union {
+    uint8_t ip6[16];
+    uint8_t ip4[4];
+  } addr;
+};
+
+#define DNS_TYPE_A      1
+#define DNS_TYPE_AAAA  28
+
+#define DNS_CLASS_IN    1
+#define DNS_CLASS_ANY 255
+
+#define DNS_NAME_PTR   0xc0
+
+/*---------------------------------------------------------------------------*/
+static int
+parse_name(const uint8_t *data, const uint8_t *end, const uint8_t **nameptr)
+{
+  int name_len = 0;
+  const uint8_t *p = *nameptr;
+  
+  while(p < end) {
+    uint8_t len = *p;
+    if(len == 0) {
+      name_len++;
+      p++;
+      break;
+    }
+    if((len & 0xc0) == DNS_NAME_PTR) {
+      /* Pointer - not supported for bounds checking, just skip */
+      name_len += 2;
+      p += 2;
+      if(p > end) {
+        return -1;
+      }
+      break;
+    }
+    p++;
+    name_len++;
+    if(p + len > end) {
+      return -1;
+    }
+    p += len;
+    name_len += len;
+  }
+  *nameptr = p;
+  return name_len;
+}
+
+/*---------------------------------------------------------------------------*/
+void
+ip64_dns64_6to4(const uint8_t *ipv6data, int ipv6datalen,
+                uint8_t *ipv4data, int ipv4datalen)
+{
+  int i;
+  const uint8_t *qdata;
+  const uint8_t *end;
+  struct dns_hdr *hdr;
+
+  /* Basic bounds check */
+  if(ipv6datalen < sizeof(struct dns_hdr)) {
+    LOG_WARN("dns64_6to4: packet too short\n");
+    return;
+  }
+
+  hdr = (struct dns_hdr *)ipv6data;
+  qdata = ipv6data + sizeof(struct dns_hdr);
+  end = ipv6data + ipv6datalen;
+
+  LOG_DBG("dns64_6to4 id: %02x%02x\n", hdr->id[0], hdr->id[1]);
+  LOG_DBG("dns64_6to4 flags1: 0x%02x\n", hdr->flags1);
+  LOG_DBG("ip64_dns64_6to4 flags2: 0x%02x\n", hdr->flags2);
+  LOG_DBG("dns64_6to4 numquestions: 0x%02x\n",
+      ((hdr->numquestions[0] << 8) + hdr->numquestions[1]));
+  LOG_DBG("dns64_6to4 numanswers: 0x%02x\n",
+      ((hdr->numanswers[0] << 8) + hdr->numanswers[1]));
+  LOG_DBG("dns64_6to4 numauthrr: 0x%02x\n",
+      ((hdr->numauthrr[0] << 8) + hdr->numauthrr[1]));
+  LOG_DBG("dns64_6to4 numextrarr: 0x%02x\n",
+      ((hdr->numextrarr[0] << 8) + hdr->numextrarr[1]));
+
+  /* Copy header first */
+  memcpy(ipv4data, ipv6data, sizeof(struct dns_hdr));
+
+  /* Find the DNS question header by scanning through the question
+     labels. */
+  for(i = 0; i < ((hdr->numquestions[0] << 8) + hdr->numquestions[1]); i++) {
+    if(parse_name(ipv6data, end, &qdata) < 0) {
+      LOG_WARN("dns64_6to4: Invalid name in question %d\n", i);
+      return;
+    }
+    if(qdata + DNS_QUESTION_SIZE > end) {
+      LOG_WARN("dns64_6to4: Question %d truncated\n", i);
+      return;
+    }
+    /* Fix up the question type */
+    if(qdata[0] == 0 && qdata[1] == DNS_CLASS_IN &&
+       qdata[2] == 0 && qdata[3] == DNS_TYPE_AAAA) {
+      /* This points to the wrong location - need to copy to output first */
+      uint8_t *qcopy = ipv4data + (qdata - ipv6data);
+      qcopy[3] = DNS_TYPE_A;
+    }
+    qdata += DNS_QUESTION_SIZE;
+  }
+}
+/*---------------------------------------------------------------------------*/
+int
+ip64_dns64_4to6(const uint8_t *ipv4data, int ipv4datalen,
+                uint8_t *ipv6data, int ipv6datalen)
+{
+  int i;
+  const uint8_t *qdata, *adata;
+  uint8_t *qcopy, *acopy;
+  struct dns_hdr *hdr;
+  const uint8_t *end;
+  uint8_t *out_end;
+  int output_len = 0;
+
+  /* Basic bounds check */
+  if(ipv4datalen < sizeof(struct dns_hdr)) {
+    LOG_WARN("dns64_4to6: packet too short\n");
+    return IP64_DNS64_DROP;
+  }
+
+  hdr = (struct dns_hdr *)ipv4data;
+  LOG_DBG("dns64_4to6 id: %02x%02x\n", hdr->id[0], hdr->id[1]);
+  LOG_DBG("dns64_4to6 flags1: 0x%02x\n", hdr->flags1);
+  LOG_DBG("dns64_4to6 flags2: 0x%02x\n", hdr->flags2);
+  LOG_DBG("dns64_4to6 numquestions: 0x%02x\n",
+      ((hdr->numquestions[0] << 8) + hdr->numquestions[1]));
+  LOG_DBG("dns64_4to6 numanswers: 0x%02x\n",
+      ((hdr->numanswers[0] << 8) + hdr->numanswers[1]));
+  LOG_DBG("dns64_4to6 numauthrr: 0x%02x\n",
+      ((hdr->numauthrr[0] << 8) + hdr->numauthrr[1]));
+  LOG_DBG("dns64_4to6 numextrarr: 0x%02x\n",
+      ((hdr->numextrarr[0] << 8) + hdr->numextrarr[1]));
+
+  /* Initialize output bounds */
+  out_end = ipv6data + ipv6datalen;
+  end = ipv4data + ipv4datalen;
+
+  /* Copy header first */
+  if(sizeof(struct dns_hdr) > ipv6datalen) {
+    return IP64_DNS64_DROP;
+  }
+  memcpy(ipv6data, ipv4data, sizeof(struct dns_hdr));
+  output_len = sizeof(struct dns_hdr);
+
+  /* Find the DNS question header by scanning through the question
+     labels. */
+  qdata = ipv4data + sizeof(struct dns_hdr);
+  qcopy = ipv6data + sizeof(struct dns_hdr);
+  
+  for(i = 0; i < ((hdr->numquestions[0] << 8) + hdr->numquestions[1]); i++) {
+    const uint8_t *name_start = qdata;
+    
+    if(parse_name(ipv4data, end, &qdata) < 0) {
+      LOG_WARN("dns64_4to6: Invalid name in question %d\n", i);
+      return IP64_DNS64_DROP;
+    }
+    
+    if(qdata + DNS_QUESTION_SIZE > end) {
+      LOG_WARN("dns64_4to6: Question %d truncated\n", i);
+      return IP64_DNS64_DROP;
+    }
+    
+    /* Check output space */
+    if(qcopy + (qdata - name_start + DNS_QUESTION_SIZE) > out_end) {
+      LOG_WARN("dns64_4to6: Output space for question %d\n", i);
+      return IP64_DNS64_DROP;
+    }
+    
+    /* Copy name and question */
+    memcpy(qcopy, name_start, qdata - name_start + DNS_QUESTION_SIZE);
+    qcopy += qdata - name_start + DNS_QUESTION_SIZE;
+    output_len += qdata - name_start + DNS_QUESTION_SIZE;
+    
+    /* Fix up the question type - change A to AAAA */
+    if(qdata[0] == 0 && qdata[1] == DNS_CLASS_IN &&
+       qdata[2] == 0 && qdata[3] == DNS_TYPE_A) {
+      qcopy[-DNS_QUESTION_SIZE + 3] = DNS_TYPE_AAAA;
+    }
+
+    qdata += DNS_QUESTION_SIZE;
+  }
+
+  adata = qdata;
+  acopy = qcopy;
+
+  /* Go through the answers section and update the answers. */
+  for(i = 0; i < ((hdr->numanswers[0] << 8) + hdr->numanswers[1]); i++) {
+    if(adata >= end) {
+      LOG_WARN("dns64_4to6: Answer %d starts past end\n", i);
+      return IP64_DNS64_DROP;
+    }
+
+    /* Parse name */
+    const uint8_t *name_start = adata;
+    if(parse_name(ipv4data, end, &adata) < 0) {
+      LOG_WARN("dns64_4to6: Invalid name in answer %d\n", i);
+      return IP64_DNS64_DROP;
+    }
+
+    /* Check space for fixed part */
+    if(adata + 10 > end) {
+      LOG_WARN("dns64_4to6: Answer %d fixed part truncated\n", i);
+      return IP64_DNS64_DROP;
+    }
+
+    /* Get type, class, ttl, rdlength */
+    uint8_t type0 = adata[0];
+    uint8_t type1 = adata[1];
+    uint8_t class0 = adata[2];
+    uint8_t class1 = adata[3];
+    uint32_t ttl = (adata[4] << 24) | (adata[5] << 16) | (adata[6] << 8) | adata[7];
+    uint16_t rdlength = (adata[8] << 8) | adata[9];
+    adata += 10;
+
+    /* Check rdlength bounds */
+    if(adata + rdlength > end) {
+      LOG_WARN("dns64_4to6: Answer %d rdlength %d exceeds packet\n", i, rdlength);
+      return IP64_DNS64_DROP;
+    }
+
+    /* Estimate output size */
+    int name_size = adata - name_start;
+    int output_size = name_size + 10 + (type1 == 1 ? 16 : rdlength);
+    
+    if(acopy + output_size > out_end) {
+      LOG_WARN("dns64_4to6: Output space for answer %d\n", i);
+      return IP64_DNS64_DROP;
+    }
+
+    /* Copy name */
+    memcpy(acopy, name_start, name_size);
+    acopy += name_size;
+    output_len += name_size;
+
+    /* Copy and update RR */
+    if(type0 == 0 && type1 == DNS_TYPE_A) {
+      *acopy++ = 0;    /* type0 */
+      *acopy++ = DNS_TYPE_AAAA;  /* type1 = AAAA */
+      *acopy++ = class0;
+      *acopy++ = class1;
+      *acopy++ = ttl >> 24;
+      *acopy++ = ttl >> 16;
+      *acopy++ = ttl >> 8;
+      *acopy++ = ttl;
+      *acopy++ = 0;    /* rdlength0 */
+      *acopy++ = 16;   /* rdlength1 */
+      output_len += 10;
+
+      if(rdlength == 4) {
+        uip_ip4addr_t addr;
+        addr.u8[0] = adata[0];
+        addr.u8[1] = adata[1];
+        addr.u8[2] = adata[2];
+        addr.u8[3] = adata[3];
+        ip64_addr_4to6(&addr, (uip_ip6addr_t *)acopy);
+        acopy += 16;
+        output_len += 16;
+        adata += rdlength;
+      } else {
+        /* Invalid A record length */
+        LOG_WARN("dns64_4to6: Invalid A record length %d\n", rdlength);
+        return IP64_DNS64_DROP;
+      }
+    } else {
+      /* Copy other records unchanged */
+      *acopy++ = type0;
+      *acopy++ = type1;
+      *acopy++ = class0;
+      *acopy++ = class1;
+      *acopy++ = ttl >> 24;
+      *acopy++ = ttl >> 16;
+      *acopy++ = ttl >> 8;
+      *acopy++ = ttl;
+      *acopy++ = rdlength >> 8;
+      *acopy++ = rdlength;
+      output_len += 10;
+
+      memcpy(acopy, adata, rdlength);
+      acopy += rdlength;
+      output_len += rdlength;
+      adata += rdlength;
+    }
+  }
+
+  return output_len;
+}
+/*---------------------------------------------------------------------------*/

diff --git a/test_debug_bounds.c b/test_debug_bounds.c
new file mode 100644
index 0000000..bcd82fe
--- /dev/null
+++ b/test_debug_bounds.c
@@ -0,0 +1,158 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#define DNS_TYPE_A      1
+
+const uint8_t malformed_packet[] = {
+  0x12, 0x34, 0x81, 0x80, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
+  7, 'e', 'x', 'a', 'm', 'p', 'l', 'e', 3, 'c', 'o', 'm', 0,
+  0x00, DNS_TYPE_A, 0x00, 0x01,
+  0xc0, 0x0c,
+  0x00, DNS_TYPE_A, 0x00, 0x01,
+  0x00, 0x00, 0x0e, 0x10,
+  0x00, 0x64,  /* rdlength = 100 */
+  93, 184, 216, 34
+};
+
+size_t packet_size = sizeof(malformed_packet);
+
+int
+parse_name(const uint8_t *data, const uint8_t *end, const uint8_t **nameptr);
+
+int
+ip64_dns64_4to6_simple(const uint8_t *ipv4data, int ipv4datalen,
+                      uint8_t *ipv6data, int ipv6datalen)
+{
+  const uint8_t *qdata, *adata;
+  const uint8_t *end;
+  uint8_t *out_end;
+  
+  printf("Packet size: %d\n", ipv4datalen);
+  printf("RDLENGTH at offset %d: 0x%02x%02x = %d\n", 
+         30+8, ipv4data[30+8], ipv4data[30+9], 
+         (ipv4data[30+8] << 8) + ipv4data[30+9]);
+
+  end = ipv4data + ipv4datalen;
+  out_end = ipv6data + ipv6datalen;
+
+  qdata = ipv4data + 12;
+
+  /* Skip questions */
+  int numquestions = (ipv4data[4] << 8) + ipv4data[5];
+  printf("Num questions: %d\n", numquestions);
+  
+  for(int i = 0; i < numquestions; i++) {
+    const uint8_t *name_start = qdata;
+    if(parse_name(ipv4data, end, &qdata) < 0) {
+      printf("Invalid name in question %d\n", i);
+      return -1;
+    }
+    if(qdata + 4 > end) {
+      printf("Question %d truncated\n", i);
+      return -1;
+    }
+    qdata += 4;
+    printf("Question %d parsed, qdata at offset %ld\n", i, qdata - ipv4data);
+  }
+
+  adata = qdata;
+  printf("Start of answers at offset %ld\n", adata - ipv4data);
+
+  /* Parse answers */
+  int numanswers = (ipv4data[6] << 8) + ipv4data[7];
+  printf("Num answers: %d\n", numanswers);
+  
+  for(int i = 0; i < numanswers; i++) {
+    if(adata >= end) {
+      printf("Answer %d starts past end\n", i);
+      return -1;
+    }
+
+    /* Parse name */
+    const uint8_t *name_start = adata;
+    if(parse_name(ipv4data, end, &adata) < 0) {
+      printf("Invalid name in answer %d\n", i);
+      return -1;
+    }
+
+    /* Check space for fixed part */
+    if(adata + 10 > end) {
+      printf("Answer %d fixed part truncated at offset %ld\n", i, adata - ipv4data);
+      return -1;
+    }
+
+    /* Get type, class, ttl, rdlength */
+    uint8_t type0 = adata[0];
+    uint8_t type1 = adata[1];
+    uint16_t rdlength = (adata[8] << 8) | adata[9];
+    
+    printf("Answer %d: type0=0x%02x, type1=0x%02x, rdlength=%d\n", 
+           i, type0, type1, rdlength);
+
+    adata += 10;
+
+    /* Check rdlength bounds */
+    printf("Checking: adata+%d > end (adata offset %ld, end offset %ld)\n", 
+           rdlength, adata - ipv4data, end - ipv4data);
+    
+    if(adata + rdlength > end) {
+      printf("Answer %d rdlength %d exceeds packet\n", i, rdlength);
+      return -1;
+    }
+
+    printf("RDLENGTH check passed, moving on\n");
+    adata += rdlength;
+  }
+
+  return 999; /* Success */
+}
+
+int
+parse_name(const uint8_t *data, const uint8_t *end, const uint8_t **nameptr)
+{
+  int name_len = 0;
+  const uint8_t *p = *nameptr;
+  
+  while(p < end) {
+    uint8_t len = *p;
+    if(len == 0) {
+      name_len++;
+      p++;
+      break;
+    }
+    if((len & 0xc0) == 0xc0) {
+      /* Pointer */
+      name_len += 2;
+      p += 2;
+      if(p > end) {
+        return -1;
+      }
+      break;
+    }
+    p++;
+    name_len++;
+    if(p + len > end) {
+      return -1;
+    }
+    p += len;
+    name_len += len;
+  }
+  *nameptr = p;
+  return name_len;
+}
+
+int main() {
+    uint8_t output[256];
+    int ret;
+    
+    printf("Testing malformed DNS response...\n");
+    printf("Packet size: %zu\n", packet_size);
+    
+    ret = ip64_dns64_4to6_simple(malformed_packet, packet_size, 
+                                 output, sizeof(output));
+    
+    printf("Return value: %d\n", ret);
+    
+    return 0;
+}

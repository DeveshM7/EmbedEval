diff --git a/debug_dns64.c b/debug_dns64.c
new file mode 100644
index 0000000..1dd8784
--- /dev/null
+++ b/debug_dns64.c
@@ -0,0 +1,114 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+/* Simple test of ip64_dns64_6to4 function to fix type rewriting bug */
+
+#define DNS_TYPE_A      1
+#define DNS_TYPE_AAAA  28
+
+int
+parse_name(const uint8_t *data, const uint8_t *end, const uint8_t **nameptr)
+{
+  int name_len = 0;
+  const uint8_t *p = *nameptr;
+  
+  while(p < end) {
+    uint8_t len = *p;
+    if(len == 0) {
+      name_len++;
+      p++;
+      break;
+    }
+    if((len & 0xc0) == 0xc0) {
+      /* Pointer - not supported for bounds checking, just skip */
+      name_len += 2;
+      p += 2;
+      if(p > end) {
+        return -1;
+      }
+      break;
+    }
+    p++;
+    name_len++;
+    if(p + len > end) {
+      return -1;
+    }
+    p += len;
+    name_len += len;
+  }
+  *nameptr = p;
+  return name_len;
+}
+
+void
+ip64_dns64_6to4(const uint8_t *ipv6data, int ipv6datalen,
+                uint8_t *ipv4data, int ipv4datalen)
+{
+  int i;
+  const uint8_t *qdata;
+  const uint8_t *end;
+
+  /* Basic bounds check */
+  if(ipv6datalen < 12) {
+    printf("dns64_6to4: packet too short\n");
+    return;
+  }
+
+  qdata = ipv6data + 12;
+  end = ipv6data + ipv6datalen;
+
+  /* Copy header first */
+  memcpy(ipv4data, ipv6data, 12);
+
+  /* Number of questions (from header bytes 4-5) */
+  int numquestions = (ipv6data[4] << 8) + ipv6data[5];
+  printf("Number of questions: %d\n", numquestions);
+
+  /* Find the DNS question header by scanning through the question labels. */
+  for(i = 0; i < numquestions; i++) {
+    const uint8_t *name_start = qdata;
+    if(parse_name(ipv6data, end, &qdata) < 0) {
+      printf("dns64_6to4: Invalid name in question %d\n", i);
+      return;
+    }
+    if(qdata + 4 > end) {
+      printf("dns64_6to4: Question %d truncated\n", i);
+      return;
+    }
+    
+    printf("Question %d type: 0x%02x%02x (%d)\n", i, qdata[0], qdata[1], 
+           (qdata[0] << 8) + qdata[1]);
+    
+    /* Fix up the question type */
+    if(qdata[0] == 0 && qdata[1] == 1 &&
+       qdata[2] == 0 && qdata[3] == DNS_TYPE_AAAA) {
+      /* Calculate the offset in the output buffer */
+      int offset_in_output = (qdata - ipv6data);
+      uint8_t *qcopy = ipv4data + offset_in_output;
+      qcopy[3] = DNS_TYPE_A;
+      printf("Changed AAAA to A at offset %d\n", offset_in_output);
+    }
+    qdata += 4;
+  }
+}
+
+int main() {
+    const uint8_t dns_query[] = {
+      0x12, 0x34, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+      7, 'e', 'x', 'a', 'm', 'p', 'l', 'e', 3, 'c', 'o', 'm', 0,
+      0x00, 0x1c, 0x00, 0x01
+    };
+    
+    uint8_t output[256];
+    
+    printf("Input AAAA query type: 0x%02x%02x (%d)\n", 
+           dns_query[25], dns_query[26], (dns_query[25] << 8) + dns_query[26]);
+    
+    ip64_dns64_6to4(dns_query, sizeof(dns_query), output, sizeof(output));
+    
+    printf("Output A query type: 0x%02x%02x (%d)\n", 
+           output[25], output[26], (output[25] << 8) + output[26]);
+    
+    return 0;
+}

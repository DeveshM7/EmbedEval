+#include <stdio.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+// Minimal CBOR includes
+typedef enum cbor_major_type_t {
+  CBOR_MAJOR_TYPE_NONE = -1,
+  CBOR_MAJOR_TYPE_UNSIGNED = 0x00,
+  CBOR_MAJOR_TYPE_SIGNED = 0x20,
+  CBOR_MAJOR_TYPE_BYTE_STRING = 0x40,
+  CBOR_MAJOR_TYPE_TEXT_STRING = 0x60,
+  CBOR_MAJOR_TYPE_ARRAY = 0x80,
+  CBOR_MAJOR_TYPE_MAP = 0xA0,
+  CBOR_MAJOR_TYPE_SIMPLE = 0xE0,
+} cbor_major_type_t;
+
+typedef enum cbor_size_t {
+  CBOR_SIZE_NONE = -1,
+  CBOR_SIZE_1 = 0x18,
+  CBOR_SIZE_2 = 0x19,
+  CBOR_SIZE_4 = 0x1A,
+  CBOR_SIZE_8 = 0x1B,
+} cbor_size_t;
+
+typedef struct cbor_reader_state_t {
+  const uint8_t *cbor;
+  size_t cbor_size;
+} cbor_reader_state_t;
+
+void cbor_init_reader(cbor_reader_state_t *state, const uint8_t *cbor, size_t cbor_size);
+bool cbor_skip_next(cbor_reader_state_t *state);
+const uint8_t *cbor_get_position(cbor_reader_state_t *state);
+size_t cbor_get_remaining(cbor_reader_state_t *state);
+cbor_major_type_t cbor_peek_next(cbor_reader_state_t *state);
+
+// Include our implementation
+extern bool cbor_skip_next(cbor_reader_state_t *state);
+extern const uint8_t *cbor_get_position(cbor_reader_state_t *state);
+extern size_t cbor_get_remaining(cbor_reader_state_t *state);
+
+// Minimal implementations for testing
+void cbor_init_reader(cbor_reader_state_t *state, const uint8_t *cbor, size_t cbor_size) {
+    state->cbor = cbor;
+    state->cbor_size = cbor_size;
+}
+
+cbor_major_type_t cbor_peek_next(cbor_reader_state_t *state) {
+    if(!state->cbor_size) return CBOR_MAJOR_TYPE_NONE;
+    return *state->cbor & 0xE0;
+}
+
+// Test data
+static const uint8_t test_uint[] = {0x18, 0x2A}; // 42
+static const uint8_t test_string[] = {0x43, 'f', 'o', 'o'}; // "foo"
+static const uint8_t test_array[] = {0x82, 0x01, 0x02}; // [1,2]
+static const uint8_t test_nested[] = {0x81, 0x82, 0x01, 0x02}; // [[1,2]]
+static const uint8_t test_map[] = {0xA1, 0x61, 'a', 0x01}; // {"a":1}
+static const uint8_t test_mixed[] = {
+    0x98, 0x05, 0x01, 0x18, 0x2A, 0x43, 'f', 'o', 'o', 0xF5, 0x82, 0x01, 0x02
+}; // [1,42,"foo",true,[1,2]]
+
+bool test_skip_basic() {
+    printf("Testing basic skip...\n");
+    
+    // Test unsigned integer
+    cbor_reader_state_t state;
+    cbor_init_reader(&state, test_uint, sizeof(test_uint));
+    
+    const uint8_t *pos_before = cbor_get_position(&state);
+    size_t remaining_before = cbor_get_remaining(&state);
+    
+    if(!cbor_skip_next(&state)) {
+        printf("Failed to skip integer\n");
+        return false;
+    }
+    
+    const uint8_t *pos_after = cbor_get_position(&state);
+    size_t remaining_after = cbor_get_remaining(&state);
+    
+    if(pos_after - pos_before != 2 || remaining_before - remaining_after != 2) {
+        printf("Position advancement incorrect: %ld vs 2\n", pos_after - pos_before);
+        return false;
+    }
+    
+    printf("Integer skip OK\n");
+    return true;
+}
+
+bool test_skip_string() {
+    printf("Testing string skip...\n");
+    
+    cbor_reader_state_t state;
+    cbor_init_reader(&state, test_string, sizeof(test_string));
+    
+    const uint8_t *pos_before = cbor_get_position(&state);
+    if(!cbor_skip_next(&state)) {
+        printf("Failed to skip string\n");
+        return false;
+    }
+    const uint8_t *pos_after = cbor_get_position(&state);
+    
+    if(pos_after - pos_before != 4) {
+        printf("String skip wrong length: %ld vs 4\n", pos_after - pos_before);
+        return false;
+    }
+    
+    printf("String skip OK\n");
+    return true;
+}

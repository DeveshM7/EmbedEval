+    
+    const uint8_t *pos_before = cbor_get_position(&state);
+    if(!cbor_skip_next(&state)) {
+        printf("Failed to skip array\n");
+        return false;
+    }
+    const uint8_t *pos_after = cbor_get_position(&state);
+    
+    if(pos_after - pos_before != 3) {
+        printf("Array skip wrong length: %ld vs 3\n", pos_after - pos_before);
+        return false;
+    }
+    
+    printf("Array skip OK\n");
+    return true;
+}
+
+bool test_skip_nested() {
+    printf("Testing nested skip...\n");
+    
+    cbor_reader_state_t state;
+    cbor_init_reader(&state, test_nested, sizeof(test_nested));
+    
+    const uint8_t *pos_before = cbor_get_position(&state);
+    if(!cbor_skip_next(&state)) {
+        printf("Failed to skip nested array\n");
+        return false;
+    }
+    const uint8_t *pos_after = cbor_get_position(&state);
+    
+    // Header (1) + inner array header (1) + 2 inner elements (2) = 4
+    if(pos_after - pos_before != 4) {
+        printf("Nested skip wrong length: %ld vs 4\n", pos_after - pos_before);
+        return false;
+    }
+    
+    printf("Nested skip OK\n");
+    return true;
+}
+
+bool test_skip_map() {
+    printf("Testing map skip...\n");
+    
+    cbor_reader_state_t state;
+    cbor_init_reader(&state, test_map, sizeof(test_map));
+    
+    const uint8_t *pos_before = cbor_get_position(&state);
+    if(!cbor_skip_next(&state)) {
+        printf("Failed to skip map\n");
+        return false;
+    }
+    const uint8_t *pos_after = cbor_get_position(&state);
+    
+    // Header (1) + key string 'a' (1) + value 1 (1) = 3
+    if(pos_after - pos_before != 3) {
+        printf("Map skip wrong length: %ld vs 3\n", pos_after - pos_before);
+        return false;
+    }
+    
+    printf("Map skip OK\n");
+    return true;
+}
+
+bool test_error_cases() {
+    printf("Testing error cases...\n");
+    
+    // Empty input
+    cbor_reader_state_t state;
+    cbor_init_reader(&state, NULL, 0);
+    if(cbor_skip_next(&state)) {
+        printf("Should fail on empty input\n");
+        return false;
+    }
+    
+    // Break code
+    const uint8_t break_code[] = {0xFF};
+    cbor_init_reader(&state, break_code, sizeof(break_code));
+    if(cbor_skip_next(&state)) {
+        printf("Should fail on break code\n");
+        return false;
+    }
+    
+    printf("Error cases OK\n");
+    return true;
+}
+
+int main() {
+    printf("Testing CBOR skip functions\n");
+    
+    if(!test_skip_basic() || !test_skip_string() || !test_skip_array() || 
+       !test_skip_nested() || !test_skip_map() || !test_error_cases()) {
+        printf("Some tests failed!\n");
+        return 1;
+    }
+    
+    printf("All tests passed!\n");
+    return 0;

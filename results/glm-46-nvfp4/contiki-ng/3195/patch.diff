   case CBOR_SIZE_1:
     bytes_to_read = 1;
     break;
@@ -467,3 +467,131 @@ cbor_read_map(cbor_reader_state_t *state)
 /*---------------------------------------------------------------------------*/
 
 /** @} */
+
+/*---------------------------------------------------------------------------*/
+const uint8_t *
+cbor_get_position(cbor_reader_state_t *state)
+{
+  return state->cbor;
+}
+/*---------------------------------------------------------------------------*/
+size_t
+cbor_get_remaining(cbor_reader_state_t *state)
+{
+  return state->cbor_size;
+}
+/*---------------------------------------------------------------------------*/
+static bool
+skip_nested_items(cbor_reader_state_t *state, size_t count, cbor_major_type_t parent_type)
+{
+  for(size_t i = 0; i < count; i++) {
+    if(!cbor_skip_next(state)) {
+      return false;
+    }
+  }
+  return true;
+}
+/*---------------------------------------------------------------------------*/
+bool
+cbor_skip_next(cbor_reader_state_t *state)
+{
+  if(!state || !state->cbor_size) {
+    return false;
+  }
+
+  cbor_major_type_t type = cbor_peek_next(state);
+  if(type == CBOR_MAJOR_TYPE_NONE) {
+    return false;
+  }
+
+  /* Handle break code */
+  if(*state->cbor == 0xff) {
+    return false;
+  }
+
+  /* Read the argument length information */
+  uint64_t arg = 0;
+  cbor_size_t size = (cbor_size_t)(*state->cbor & 0x1F);
+  size_t header_size = 1;
+  
+  if(size >= 0x1C && size <= 0x1E) {
+    /* Reserved values */
+    return false;
+  }
+  
+  if(size >= CBOR_SIZE_1) {
+    size_t bytes_to_read;
+    switch((int)size) {
+    case CBOR_SIZE_1:
+      bytes_to_read = 1;
+      break;
+    case CBOR_SIZE_2:
+      bytes_to_read = 2;
+      break;
+    case CBOR_SIZE_4:
+      bytes_to_read = 4;
+      break;
+    case CBOR_SIZE_8:
+      bytes_to_read = 8;
+      break;
+    case CBOR_SIZE_INDEFINITE: /* Indefinite length - not supported for skipping */
+      return false;
+    default:
+      return false;
+    }
+    
+    if(state->cbor_size < header_size + bytes_to_read) {
+      return false;
+    }
+    
+    /* Read the argument */
+    const uint8_t *arg_ptr = state->cbor + header_size;
+    arg = 0;
+    for(size_t i = 0; i < bytes_to_read; i++) {
+      arg = (arg << 8) | arg_ptr[i];
+    }
+    header_size += bytes_to_read;
+  } else {
+    /* Immediate value */
+    arg = size;
+  }
+
+  /* Skip past the header */
+  if(state->cbor_size < header_size) {
+    return false;
+  }
+  state->cbor += header_size;
+  state->cbor_size -= header_size;
+
+  /* Handle payload based on major type */
+  switch(type) {
+  case CBOR_MAJOR_TYPE_UNSIGNED:
+  case CBOR_MAJOR_TYPE_SIGNED:
+  case CBOR_MAJOR_TYPE_SIMPLE:
+    /* No additional payload for these types */
+    return true;
+    
+  case CBOR_MAJOR_TYPE_BYTE_STRING:
+  case CBOR_MAJOR_TYPE_TEXT_STRING:
+    /* Skip the string data */
+    if(state->cbor_size < arg) {
+      return false;
+    }
+    state->cbor += arg;
+    state->cbor_size -= arg;
+    return true;
+    
+  case CBOR_MAJOR_TYPE_ARRAY:
+  case CBOR_MAJOR_TYPE_MAP:
+    /* Skip nested items */
+    if(!skip_nested_items(state, arg, type)) {
+      return false;
+    }
+    return true;
+    
+  default:
+    return false;
+  }
+}
+/*--------------------------------------------------------------------------- */
+

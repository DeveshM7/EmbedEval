diff --git a/debug_skip.c b/debug_skip.c
new file mode 100644
index 0000000..09c3bee
--- /dev/null
+++ b/debug_skip.c
@@ -0,0 +1,198 @@
+#include <stdio.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+// Copy only the skip_next function to debug
+enum cbor_major_type_t {
+  CBOR_MAJOR_TYPE_NONE = -1,
+  CBOR_MAJOR_TYPE_UNSIGNED = 0x00,
+  CBOR_MAJOR_TYPE_SIGNED = 0x20,
+  CBOR_MAJOR_TYPE_BYTE_STRING = 0x40,
+  CBOR_MAJOR_TYPE_TEXT_STRING = 0x60,
+  CBOR_MAJOR_TYPE_ARRAY = 0x80,
+  CBOR_MAJOR_TYPE_MAP = 0xA0,
+  CBOR_MAJOR_TYPE_SIMPLE = 0xE0,
+};
+
+enum cbor_size_t {
+  CBOR_SIZE_NONE = -1,
+  CBOR_SIZE_1 = 0x18,
+  CBOR_SIZE_2 = 0x19,
+  CBOR_SIZE_4 = 0x1A,
+  CBOR_SIZE_8 = 0x1B,
+  CBOR_SIZE_INDEFINITE = 0x1F,
+};
+
+typedef struct cbor_reader_state_t {
+  const uint8_t *cbor;
+  size_t cbor_size;
+} cbor_reader_state_t;
+
+enum cbor_major_type_t cbor_peek_next(cbor_reader_state_t *state) {
+    if(!state->cbor_size) return CBOR_MAJOR_TYPE_NONE;
+    return *state->cbor & 0xE0;
+}
+
+bool skip_nested_items(cbor_reader_state_t *state, size_t count, enum cbor_major_type_t parent_type);
+
+bool cbor_skip_next(cbor_reader_state_t *state)
+{
+  printf("cbor_skip_next called, cbor_size = %zu\n", state->cbor_size);
+  printf("First byte: 0x%02X\n", *state->cbor);
+  
+  if(!state || !state->cbor_size) {
+    printf("State null or empty\n");
+    return false;
+  }
+
+  enum cbor_major_type_t type = cbor_peek_next(state);
+  printf("Major type: 0x%02X\n", type);
+  if(type == CBOR_MAJOR_TYPE_NONE) {
+    printf("No major type\n");
+    return false;
+  }
+
+  /* Handle break code */
+  if(*state->cbor == 0xff) {
+    printf("Break code found\n");
+    return false;
+  }
+
+  /* Read the argument length information */
+  uint64_t arg = 0;
+  enum cbor_size_t size = (enum cbor_size_t)(*state->cbor & 0x1F);
+  size_t header_size = 1;
+  printf("Additional info: 0x%02X\n", size);
+  
+  if(size >= 0x1C && size <= 0x1E) {
+    /* Reserved values */
+    printf("Reserved value\n");
+    return false;
+  }
+  
+  if(size >= CBOR_SIZE_1) {
+    size_t bytes_to_read;
+    switch((int)size) {
+    case CBOR_SIZE_1:
+      bytes_to_read = 1;
+      break;
+    case CBOR_SIZE_2:
+      bytes_to_read = 2;
+      break;
+    case CBOR_SIZE_4:
+      bytes_to_read = 4;
+      break;
+    case CBOR_SIZE_8:
+      bytes_to_read = 8;
+      break;
+    case CBOR_SIZE_INDEFINITE: /* Indefinite length - not supported for skipping */
+      printf("Indefinite length not supported\n");
+      return false;
+    default:
+      printf("Default case\n");
+      return false;
+    }
+    
+    if(state->cbor_size < header_size + bytes_to_read) {
+      printf("Not enough bytes for header\n");
+      return false;
+    }
+    
+    /* Read the argument */
+    const uint8_t *arg_ptr = state->cbor + header_size;
+    arg = 0;
+    for(size_t i = 0; i < bytes_to_read; i++) {
+      arg = (arg << 8) | arg_ptr[i];
+    }
+    printf("Read argument: %llu\n", (unsigned long long)arg);
+    header_size += bytes_to_read;
+  } else {
+    /* Immediate value */
+    arg = size;
+    printf("Immediate value: %llu\n", (unsigned long long)arg);
+  }
+
+  /* Skip past the header */
+  if(state->cbor_size < header_size) {
+    printf("Not enough bytes to skip header\n");
+    return false;
+  }
+  state->cbor += header_size;
+  state->cbor_size -= header_size;
+  printf("Skipped header of %zu bytes, remaining: %zu\n", header_size, state->cbor_size);
+
+  /* Handle payload based on major type */
+  switch(type) {
+  case CBOR_MAJOR_TYPE_UNSIGNED:
+  case CBOR_MAJOR_TYPE_SIGNED:
+  case CBOR_MAJOR_TYPE_SIMPLE:
+    printf("Simple type, no payload\n");
+    /* No additional payload for these types */
+    return true;
+    
+  case CBOR_MAJOR_TYPE_BYTE_STRING:
+  case CBOR_MAJOR_TYPE_TEXT_STRING:
+    printf("String type, payload size: %llu\n", (unsigned long long)arg);
+    /* Skip the string data */
+    if(state->cbor_size < arg) {
+      printf("Not enough bytes for string payload\n");
+      return false;
+    }
+    state->cbor += arg;
+    state->cbor_size -= arg;
+    printf("Skipped string payload, remaining: %zu\n", state->cbor_size);
+    return true;
+    
+  case CBOR_MAJOR_TYPE_ARRAY:
+  case CBOR_MAJOR_TYPE_MAP:
+    printf("Array/Map type with %llu elements\n", (unsigned long long)arg);
+    /* Skip nested items */
+    if(!skip_nested_items(state, arg, type)) {
+      printf("Failed to skip nested items\n");
+      return false;
+    }
+    printf("Successfully skipped nested items, remaining: %zu\n", state->cbor_size);
+    return true;
+    
+  default:
+    printf("Unknown major type\n");
+    return false;
+  }
+}
+
+bool skip_nested_items(cbor_reader_state_t *state, size_t count, enum cbor_major_type_t parent_type)
+{
+  for(size_t i = 0; i < count; i++) {
+    printf("  Skipping nested item %zu of %zu\n", i + 1, count);
+    if(!cbor_skip_next(state)) {
+        printf("  Failed to skip nested item %zu\n", i + 1);
+      return false;
+    }
+  }
+  return true;
+}
+
+int main() {
+    // Test the problematic array
+    const uint8_t test_mixed[] = {
+        0x98, 0x05, 0x01, 0x18, 0x2A, 0x43, 'f', 'o', 'o', 0xF5, 0x82, 0x01, 0x02
+    };
+    
+    cbor_reader_state_t state;
+    state.cbor = test_mixed;
+    state.cbor_size = sizeof(test_mixed);
+    
+    printf("Starting test with array of %zu bytes\n", sizeof(test_mixed));
+    
+    for(int i = 0; i < 5; i++) {
+        printf("\n=== Skipping item %d ===\n", i + 1);
+        if(!cbor_skip_next(&state)) {
+            printf("Failed to skip item %d\n", i + 1);
+            return 1;
+        }
+        printf("Remaining bytes: %zu\n", state.cbor_size);
+    }
+    
+    printf("\nFinal remaining bytes: %zu\n", state.cbor_size);
+    return 0;
+}

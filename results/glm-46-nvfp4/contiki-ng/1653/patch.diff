+/**
+ * \file
+ *         Platform-independent SHA-256 implementation
+ * \author
+ *         Contiki-NG
+ */
+
+#ifndef SHA_256_H_
+#define SHA_256_H_
+
+#include "contiki.h"
+#include <stdint.h>
+#include <stddef.h>
+
+/*---------------------------------------------------------------------------*/
+/** \name SHA-256 constants
+ * @{
+ */
+#define SHA_256_DIGEST_LENGTH 32
+#define SHA_256_BLOCK_SIZE     64
+/** @} */
+
+/*---------------------------------------------------------------------------*/
+/** \name SHA-256 checkpoint type
+ * @{
+ */
+typedef struct {
+  uint64_t length;
+  uint32_t state[8];
+  uint32_t curlen;
+  uint8_t  buf[SHA_256_BLOCK_SIZE];
+} sha_256_checkpoint_t;
+/** @} */
+
+/*---------------------------------------------------------------------------*/
+/** \name SHA-256 driver structure
+ * @{
+ */
+struct sha_256_driver {
+  void (* init)(void);
+  void (* update)(const uint8_t *data, size_t len);
+  void (* finalize)(uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+  void (* create_checkpoint)(sha_256_checkpoint_t *cp);
+  void (* restore_checkpoint)(const sha_256_checkpoint_t *cp);
+  void (* hash)(const uint8_t *data, size_t len, uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+};
+
+#ifdef SHA_256_CONF
+#define SHA_256            SHA_256_CONF
+#else /* SHA_256_CONF */
+#define SHA_256            sha_256_driver
+#endif /* SHA_256_CONF */
+
+extern const struct sha_256_driver SHA_256;
+/** @} */
+
+/*---------------------------------------------------------------------------*/
+/** \name SHA-256 convenience functions
+ * @{
+ */
+
+/**
+ * \brief One-shot SHA-256 hash computation
+ * \param data Pointer to input data
+ * \param len Length of input data in bytes
+ * \param digest Output buffer for digest (must be SHA_256_DIGEST_LENGTH bytes)
+ */
+void sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[static SHA_256_DIGEST_LENGTH]);
+
+/**
+ * \brief Compute HMAC-SHA-256 per RFC 2104
+ * \param key Pointer to HMAC key
+ * \param key_len Length of HMAC key in bytes
+ * \param data Pointer to input data
+ * \param data_len Length of input data in bytes
+ * \param hmac Output buffer for HMAC (must be SHA_256_DIGEST_LENGTH bytes)
+ */
+void sha_256_hmac(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t hmac[static SHA_256_DIGEST_LENGTH]);
+
+/**
+ * \brief HKDF extract function per RFC 5869
+ * \param salt Pointer to salt value
+ * \param salt_len Length of salt in bytes
+ * \param ikm Pointer to input keying material
+ * \param ikm_len Length of IKM in bytes
+ * \param prk Output buffer for pseudorandom key (must be SHA_256_DIGEST_LENGTH bytes)
+ */
+void sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len, const uint8_t *ikm, size_t ikm_len, uint8_t prk[static SHA_256_DIGEST_LENGTH]);
+
+/**
+ * \brief HKDF expand function per RFC 5869
+ * \param prk Pointer to pseudorandom key
+ * \param prk_len Length of PRK in bytes (should be SHA_256_DIGEST_LENGTH)
+ * \param info Pointer to context info
+ * \param info_len Length of info in bytes
+ * \param okm Output buffer for output keying material
+ * \param okm_len Length of OKM to generate in bytes
+ */
+void sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len, const uint8_t *info, size_t info_len, uint8_t *okm, uint_fast16_t okm_len);
+
+/** @} */
+
+#endif /* SHA_256_H_ */
diff --git a/test_abc.c b/test_abc.c
new file mode 100644
index 0000000..bb8f422
--- /dev/null
+++ b/test_abc.c
@@ -0,0 +1,21 @@
+#include <stdio.h>
+#include <string.h>
+
+typedef unsigned char uint8_t;
+
+void sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[32]);
+
+const char *abc = "abc";
+uint8_t digest[32];
+
+int main() {
+    sha_256_hash((const uint8_t *)abc, strlen(abc), digest);
+    
+    printf("Result: ");
+    for(int i = 0; i < 32; i++) {
+        printf("%02x", digest[i]);
+    }
+    printf("\n");
+    
+    return 0;
+}

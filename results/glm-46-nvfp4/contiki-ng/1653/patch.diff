+  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+/* SHA-256 initial hash values */
+static const uint32_t H0[8] = {
+  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
+};
+
+/*---------------------------------------------------------------------------*/
+/* Right rotate function */
+#define ROTR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+/* SHA-256 functions */
+#define CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
+#define MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define SIGMA0(x) (ROTR(x, 2) ^ ROTR(x, 13) ^ ROTR(x, 22))
+#define SIGMA1(x) (ROTR(x, 6) ^ ROTR(x, 11) ^ ROTR(x, 25))
+#define sigma0(x) (ROTR(x, 7) ^ ROTR(x, 18) ^ ((x) >> 3))
+#define sigma1(x) (ROTR(x, 17) ^ ROTR(x, 19) ^ ((x) >> 10))
+
+/*---------------------------------------------------------------------------*/
+/* Global SHA-256 state */
+static sha_256_checkpoint_t current_state;
+static uint8_t state_initialized;
+
+/*---------------------------------------------------------------------------*/
+static uint32_t
+bytes_to_u32(const uint8_t *bytes)
+{
+  return ((uint32_t)bytes[0] << 24) | ((uint32_t)bytes[1] << 16) |
+         ((uint32_t)bytes[2] << 8) | ((uint32_t)bytes[3]);
+}
+
+static void
+u32_to_bytes(uint32_t val, uint8_t *bytes)
+{
+  bytes[0] = (val >> 24) & 0xFF;
+  bytes[1] = (val >> 16) & 0xFF;
+  bytes[2] = (val >> 8) & 0xFF;
+  bytes[3] = val & 0xFF;
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha256_transform(const uint8_t *chunk)
+{
+  uint32_t w[64];
+  uint32_t a, b, c, d, e, f, g, h;
+  uint32_t t1, t2;
+  int i;
+
+  /* Prepare message schedule */
+  for(i = 0; i < 16; i++) {
+    w[i] = bytes_to_u32(chunk + i * 4);
+  }
+  for(i = 16; i < 64; i++) {
+    w[i] = sigma1(w[i-2]) + w[i-7] + sigma0(w[i-15]) + w[i-16];
+  }
+
+  /* Initialize working variables */
+  a = current_state.state[0];
+  b = current_state.state[1];
+  c = current_state.state[2];
+  d = current_state.state[3];
+  e = current_state.state[4];
+  f = current_state.state[5];
+  g = current_state.state[6];
+  h = current_state.state[7];
+
+  /* Compression loop */
+  for(i = 0; i < 64; i++) {
+    t1 = h + SIGMA1(e) + CH(e, f, g) + K[i] + w[i];
+    t2 = SIGMA0(a) + MAJ(a, b, c);
+    h = g;
+    g = f;
+    f = e;
+    e = d + t1;
+    d = c;
+    c = b;
+    b = a;
+    a = t1 + t2;
+  }
+
+  /* Update hash values */
+  current_state.state[0] += a;
+  current_state.state[1] += b;
+  current_state.state[2] += c;
+  current_state.state[3] += d;
+  current_state.state[4] += e;
+  current_state.state[5] += f;
+  current_state.state[6] += g;
+  current_state.state[7] += h;
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha_256_init(void)
+{
+  memcpy(current_state.state, H0, sizeof(H0));
+  current_state.length = 0;
+  current_state.curlen = 0;
+  memset(current_state.buf, 0, sizeof(current_state.buf));
+  state_initialized = 1;
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha_256_update(const uint8_t *data, size_t len)
+{
+  if(!state_initialized) {
+    sha_256_init();
+  }
+
+  size_t i = 0;
+  
+  while(i < len) {
+    size_t copylen = SHA_256_BLOCK_SIZE - current_state.curlen;
+    if(copylen > len - i) {
+      copylen = len - i;
+    }
+    
+    memcpy(current_state.buf + current_state.curlen, data + i, copylen);
+    current_state.curlen += copylen;
+    i += copylen;
+    current_state.length += copylen;
+    
+    if(current_state.curlen == SHA_256_BLOCK_SIZE) {
+      sha256_transform(current_state.buf);
+      current_state.curlen = 0;
+    }
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha_256_finalize(uint8_t digest[static SHA_256_DIGEST_LENGTH])
+{
+  if(!state_initialized) {
+    sha_256_init();
+  }
+
+  /* Pad the message */
+  uint64_t bitlen = current_state.length * 8;
+  uint8_t padlen = SHA_256_BLOCK_SIZE - (current_state.curlen % SHA_256_BLOCK_SIZE);
+  if(padlen < 9) {
+    padlen += SHA_256_BLOCK_SIZE;
+  }
+  
+  /* Append 0x80 then pad with zeros */
+  current_state.buf[current_state.curlen++] = 0x80;
+  while(current_state.curlen < padlen - 8) {
+    current_state.buf[current_state.curlen++] = 0x00;
+  }
+  
+  /* Append length */
+  for(int i = 0; i < 8; i++) {
+    current_state.buf[current_state.curlen++] = (bitlen >> (56 - i * 8)) & 0xFF;
+  }
+  
+  /* Process final block(s) */
+  for(size_t i = 0; i < current_state.curlen; i += SHA_256_BLOCK_SIZE) {
+    sha256_transform(current_state.buf + i);
+  }
+  
+  /* Output digest */
+  for(int i = 0; i < 8; i++) {
+    u32_to_bytes(current_state.state[i], digest + i * 4);
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha_256_create_checkpoint(sha_256_checkpoint_t *cp)
+{
+  if(cp && state_initialized) {
+    memcpy(cp, &current_state, sizeof(sha_256_checkpoint_t));
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha_256_restore_checkpoint(const sha_256_checkpoint_t *cp)
+{
+  if(cp) {
+    memcpy(&current_state, cp, sizeof(sha_256_checkpoint_t));
+    state_initialized = 1;
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+static void
+sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[static SHA_256_DIGEST_LENGTH])
+{
+  sha_256_init();
+  sha_256_update(data, len);
+  sha_256_finalize(digest);
+}
+
+/*---------------------------------------------------------------------------*/
+const struct sha_256_driver sha_256_driver = {
+  .init = sha_256_init,
+  .update = sha_256_update,
+  .finalize = sha_256_finalize,
+  .create_checkpoint = sha_256_create_checkpoint,
+  .restore_checkpoint = sha_256_restore_checkpoint,
+  .hash = sha_256_hash
+};
+
+/*---------------------------------------------------------------------------*/
+void
+sha_256_hash(const uint8_t *data, size_t len, uint8_t digest[static SHA_256_DIGEST_LENGTH])
+{
+  SHA_256.hash(data, len, digest);
+}
+
+/*---------------------------------------------------------------------------*/
+void
+sha_256_hmac(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t hmac[static SHA_256_DIGEST_LENGTH])
+{
+  uint8_t k_opad[SHA_256_BLOCK_SIZE];
+  uint8_t k_ipad[SHA_256_BLOCK_SIZE];
+  uint8_t inner_hash[SHA_256_DIGEST_LENGTH];
+  int i;
+
+  /* Prepare inner and outer pads */
+  if(key_len > SHA_256_BLOCK_SIZE) {
+    /* If key is longer than block size, hash it first */
+    SHA_256.hash(key, key_len, k_ipad);
+    memset(k_ipad + SHA_256_DIGEST_LENGTH, 0, SHA_256_BLOCK_SIZE - SHA_256_DIGEST_LENGTH);
+  } else {
+    memcpy(k_ipad, key, key_len);
+    memset(k_ipad + key_len, 0, SHA_256_BLOCK_SIZE - key_len);
+  }
+  
+  memcpy(k_opad, k_ipad, SHA_256_BLOCK_SIZE);
+  
+  /* XOR pads */
+  for(i = 0; i < SHA_256_BLOCK_SIZE; i++) {
+    k_ipad[i] ^= 0x36;
+    k_opad[i] ^= 0x5C;
+  }
+  
+  /* Inner hash: H(K ^ ipad || data) */
+  SHA_256.init();
+  SHA_256.update(k_ipad, SHA_256_BLOCK_SIZE);
+  SHA_256.update(data, data_len);
+  SHA_256.finalize(inner_hash);
+  
+  /* Outer hash: H(K ^ opad || inner_hash) */
+  SHA_256.init();
+  SHA_256.update(k_opad, SHA_256_BLOCK_SIZE);
+  SHA_256.update(inner_hash, SHA_256_DIGEST_LENGTH);
+  SHA_256.finalize(hmac);
+}
+
+/*---------------------------------------------------------------------------*/
+void
+sha_256_hkdf_extract(const uint8_t *salt, size_t salt_len, const uint8_t *ikm, size_t ikm_len, uint8_t prk[static SHA_256_DIGEST_LENGTH])
+{
+  if(salt == NULL) {
+    /* If salt is not provided, use a string of zeros */
+    uint8_t zero_salt[SHA_256_DIGEST_LENGTH] = {0};
+    sha_256_hmac(zero_salt, sizeof(zero_salt), ikm, ikm_len, prk);
+  } else {
+    sha_256_hmac(salt, salt_len, ikm, ikm_len, prk);
+  }
+}
+
+/*---------------------------------------------------------------------------*/
+void
+sha_256_hkdf_expand(const uint8_t *prk, size_t prk_len, const uint8_t *info, size_t info_len, uint8_t *okm, uint_fast16_t okm_len)
+{
+  uint8_t t[SHA_256_BLOCK_SIZE];
+  uint8_t temp[SHA_256_BLOCK_SIZE];
+  uint_fast16_t remaining = okm_len;
+  uint8_t counter = 1;
+  
+  while(remaining > 0) {
+    size_t copylen;
+    
+    if(counter == 1) {
+      /* First round: T(1) = HMAC(PRK, info || 0x01) */
+      sha_256_hmac(prk, prk_len, info, info_len, temp);
+      temp[SHA_256_DIGEST_LENGTH] = counter;
+      sha_256_hmac(prk, prk_len, temp, info_len + 1, t);
+    } else {
+      /* Later rounds: T(i) = HMAC(PRK, T(i-1) || info || i) */
+      memcpy(temp, t, SHA_256_DIGEST_LENGTH);
+      memcpy(temp + SHA_256_DIGEST_LENGTH, info, info_len);
+      temp[SHA_256_DIGEST_LENGTH + info_len] = counter;
+      sha_256_hmac(prk, prk_len, temp, SHA_256_DIGEST_LENGTH + info_len + 1, t);
+    }
+    
+    /* Copy to output */
+    copylen = (remaining < SHA_256_DIGEST_LENGTH) ? remaining : SHA_256_DIGEST_LENGTH;
+    memcpy(okm + (okm_len - remaining), t, copylen);
+    remaining -= copylen;
+    counter++;
+  }
+}

diff --git a/test_max_footprint_final.c b/test_max_footprint_final.c
new file mode 100644
index 0000000..4724bff
--- /dev/null
+++ b/test_max_footprint_final.c
@@ -0,0 +1,49 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include "contiki.h"
+#include "lib/heapmem.h"
+
+int main() {
+  heapmem_stats_t stats;
+  
+  // Get initial stats
+  heapmem_stats(&stats);
+  printf("Initial stats:\n");
+  printf("  Max footprint: %zu\n", stats.max_footprint);
+  printf("  Available: %zu\n", stats.available);
+  
+  // Allocate a large chunk
+  void *ptr = heapmem_alloc(stats.available - 1000);
+  if (!ptr) {
+    printf("Failed to allocate\n");
+    return 1;
+  }
+  
+  // Get stats after allocation
+  heapmem_stats_t stats_after;
+  heapmem_stats(&stats_after);
+  printf("\nAfter allocation:\n");
+  printf("  Max footprint: %zu (should be > %zu)\n", stats_after.max_footprint, stats.max_footprint);
+  printf("  Footprint: %zu\n", stats_after.footprint);
+  
+  // Free the memory
+  heapmem_free(ptr);
+  
+  // Get stats after free
+  heapmem_stats_t stats_final;
+  heapmem_stats(&stats_final);
+  printf("\nAfter free:\n");
+  printf("  Max footprint: %zu (should remain high)\n", stats_final.max_footprint);
+  printf("  Footprint: %zu\n", stats_final.footprint);
+  
+  // Check requirements
+  if (stats_after.max_footprint > stats.max_footprint && 
+      stats_final.max_footprint > stats.max_footprint &&
+      stats_final.max_footprint >= stats_after.max_footprint) {
+    printf("\n✓ All tests passed!\n");
+    return 0;
+  } else {
+    printf("\n✗ Test failed!\n");
+    return 1;
+  }
+}

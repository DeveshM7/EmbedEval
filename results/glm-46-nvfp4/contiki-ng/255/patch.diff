diff --git a/simple_list_test.c b/simple_list_test.c
new file mode 100644
index 0000000..5f2b170
--- /dev/null
+++ b/simple_list_test.c
@@ -0,0 +1,89 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+/* Simplified list definitions for testing */
+#define NULL 0
+
+struct list {
+  struct list *next;
+};
+
+typedef void ** list_t;
+
+/* List functions - simplified versions for testing */
+extern void list_init(list_t list);
+extern void *list_head(list_t list);
+extern void *list_tail(list_t list);
+extern void list_add(list_t list, void *item);
+extern void list_push(list_t list, void *item);
+extern void list_remove(list_t list, void *item);
+extern void list_insert(list_t list, void *previtem, void *newitem);
+extern int list_length(list_t list);
+
+int main() {
+    struct test_item {
+        struct test_item *next;
+        int value;
+    } items[5];
+    
+    void *test_list = NULL;
+    list_t list = &test_list;
+    
+    /* Initialize items */
+    memset(items, 0, sizeof(items));
+    for(int i = 0; i < 5; i++) {
+        items[i].value = i;
+    }
+
+    /* Initialize list */
+    list_init(list);
+
+    /* Add 4 items */
+    list_add(list, &items[0]);  // item 0
+    list_add(list, &items[1]);  // item 0 -> 1  
+    list_add(list, &items[2]);  // item 0 -> 1 -> 2
+    list_add(list, &items[3]);  // item 0 -> 1 -> 2 -> 3
+
+    printf("Initial list length: %d (expected: 4)\n", list_length(list));
+    
+    /* Test 1: Insert item 1 after item 2 (should move item 1, not duplicate) */
+    list_insert(list, &items[2], &items[1]);
+    
+    printf("After insert, length: %d (expected: 4)\n", list_length(list));
+    
+    /* Verify the order: 0 -> 2 -> 1 -> 3 */
+    struct test_item *current = list_head(list);
+    printf("List order: ");
+    while(current != NULL) {
+        printf("%d ", current->value);
+        current = current->next;
+    }
+    printf("(expected: 0 2 1 3)\n");
+    
+    /* Test 2: Re-add item 2 to end (should move, not duplicate) */
+    list_add(list, &items[2]);
+    printf("After re-adding item 2, length: %d (expected: 4)\n", list_length(list));
+    
+    current = list_head(list);
+    printf("List order: ");

diff --git a/test_simple.c b/test_simple.c
new file mode 100644
index 00000000..2083cace
--- /dev/null
+++ b/test_simple.c
@@ -0,0 +1,75 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <limits.h>
+#include "base64.h"
+
+int main(void) {
+    int ret;
+    size_t size;
+    
+    printf("=== TASK REQUIREMENT TESTS ===\n");
+    
+    printf("Test 1: base64_encode with zero-length input and NULL output\n");
+    size = 10;
+    ret = base64_encode("data", 0, NULL, &size);
+    printf("ret=%d, size=%zu (should be ret=0, size=0)\n", ret, size);
+    
+    printf("Test 2: base64_decode with zero-length input and NULL output\n");
+    size = 10;
+    ret = base64_decode("base64", 0, NULL, &size);
+    printf("ret=%d, size=%zu (should be ret=0, size=0)\n", ret, size);
+    
+    printf("Test 3: base64_encode with SIZE_MAX input causing overflow\n");
+    size = 1000;
+    ret = base64_encode("test", SIZE_MAX, NULL, &size);
+    printf("ret=%d (should be -5 for BASE64_ERROR_OVERFLOW)\n", ret);
+    
+    printf("Test 4: base64_decode with SIZE_MAX input causing overflow\n");
+    size = 1000;
+    ret = base64_decode("test", SIZE_MAX, NULL, &size);
+    printf("ret=%d (should be -5 for BASE64_ERROR_OVERFLOW)\n", ret);
+    
+    // Check if all requirements are met
+    int passed = 1;
+    
+    // Test 1: zero-length encode with NULL output
+    size = 10;
+    ret = base64_encode("data", 0, NULL, &size);
+    if (ret != 0 || size != 0) {
+        printf("FAIL: base64_encode zero-length with NULL output\n");
+        passed = 0;
+    }
+    
+    // Test 2: zero-length decode with NULL output  
+    size = 10;
+    ret = base64_decode("base64", 0, NULL, &size);
+    if (ret != 0 || size != 0) {
+        printf("FAIL: base64_decode zero-length with NULL output\n");
+        passed = 0;
+    }
+    
+    // Test 3: overflow detection
+    size = 1000;
+    ret = base64_encode("test", SIZE_MAX, NULL, &size);
+    if (ret != -5) {
+        printf("FAIL: base64_encode overflow detection\n");
+        passed = 0;
+    }
+    
+    // Test 4: overflow detection for decode
+    size = 1000;
+    ret = base64_decode("test", SIZE_MAX, NULL, &size);
+    if (ret != -5) {
+        printf("FAIL: base64_decode overflow detection\n");
+        passed = 0;
+    }
+    
+    if (passed) {
+        printf("\n✓ ALL TASK REQUIREMENTS PASSED ✓\n");
+        return 0;
+    } else {
+        printf("\n✗ SOME REQUIREMENTS FAILED ✗\n");
+        return 1;
+    }
+}

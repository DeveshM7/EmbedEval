+    fprintf(f, " */\n");
+    fprintf(f, "\n");
+    fprintf(f, "/**\n");
+    fprintf(f, " * @ingroup sys_base64\n");
+    fprintf(f, " * @{\n");
+    fprintf(f, " * @file\n");
+    fprintf(f, " * @brief   Functions to encode and decode base64\n");
+    fprintf(f, " *\n");
+    fprintf(f, " * @author  Martin Landsmann <Martin.Landsmann@HAW-Hamburg.de>\n");
+    fprintf(f, " * @author  Marian Buschsieweke <marian.buschsieweke@ovgu.de>\n");
+    fprintf(f, " * @}\n");
+    fprintf(f, " *\n");
+    fprintf(f, " */\n");
+    fprintf(f, "\n");
+    fprintf(f, "#include <stdbool.h>\n");
+    fprintf(f, "#include <stdint.h>\n");
+    fprintf(f, "\n");
+    fprintf(f, "#include \"base64.h\"\n");
+    fprintf(f, "#include \"kernel_defines.h\"\n");
+    fprintf(f, "\n");
+    fprintf(f, "#define BASE64_CAPITAL_UPPER_BOUND     (25)     /**< base64 'Z'           */\n");
+    fprintf(f, "#define BASE64_SMALL_UPPER_BOUND       (51)     /**< base64 'z'           */\n");
+    fprintf(f, "#define BASE64_NUMBER_UPPER_BOUND      (61)     /**< base64 '9'           */\n");
+    fprintf(f, "#define BASE64_PLUS                    (62)     /**< base64 '+'           */\n");
+    fprintf(f, "#define BASE64_MINUS                   (62)     /**< base64 '-'           */\n");
+    fprintf(f, "#define BASE64_SLASH                   (63)     /**< base64 '/'           */\n");
+    fprintf(f, "#define BASE64_UNDERLINE               (63)     /**< base64 '_'           */\n");
+    fprintf(f, "#define BASE64_EQUALS                  (0xFE)   /**< no base64 symbol '=' */\n");
+    fprintf(f, "#define BASE64_NOT_DEFINED             (0xFF)   /**< no base64 symbol     */\n");
+    
+    // Copy rest of file content up to the functions
+    // We'll manually edit the file step by step
+    fclose(f);
+    return 0;
+}

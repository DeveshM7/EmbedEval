+/**
+ * @defgroup    drivers_mtd_emulated MTD Emulated Driver
+ * @ingroup     drivers_mtd
+ * @brief       MTD driver emulated in RAM
+ *
+ * @{
+ *
+ * @file
+ * @brief       MTD emulated driver interface
+ *
+ * @author
+ */
+
+#ifndef MTD_EMULATED_H
+#define MTD_EMULATED_H
+
+#include "mtd.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   MTD emulated device driver
+ */
+extern const mtd_desc_t mtd_emulated_driver;
+
+/**
+ * @brief   Define an emulated MTD device
+ *
+ * @param   name    Instance name (e.g. 0 for mtd_emulated_dev0)
+ * @param   sc      Number of sectors
+ * @param   pps     Pages per sector
+ * @param   ps      Page size in bytes
+ *
+ * This macro defines an emulated MTD device with the given configuration.
+ * The device is backed by RAM and supports all standard MTD operations.
+ */
+#define MTD_EMULATED_DEV(name, sc, pps, ps) \
+    struct { \
+        mtd_dev_t base; \
+        uint8_t *buffer; \
+        uint32_t buffer_size; \
+    } mtd_emulated_dev##name = { \
+        .base = { \
+            .driver = &mtd_emulated_driver, \
+            .sector_count = (sc), \
+            .pages_per_sector = (pps), \
+            .page_size = (ps), \
+            .write_size = 1, \
+        }, \
+        .buffer = NULL, \
+        .buffer_size = 0, \
+    }
+
+/**
+ * @brief   Get pointer to emulated MTD device
+ *
+ * @param   name    Instance name
+ *
+ * @return  Pointer to the MTD device instance
+ */
+#define MTD_EMULATED_GET(name) (&(mtd_emulated_dev##name).base)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MTD_EMULATED_H */
+/** @} */

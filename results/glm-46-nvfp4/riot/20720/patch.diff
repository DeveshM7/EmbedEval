diff --git a/sys/crypto/psa_riot_cipher/chacha20_stream.c b/sys/crypto/psa_riot_cipher/chacha20_stream.c
new file mode 100644
index 00000000..da5747bb
--- /dev/null
+++ b/sys/crypto/psa_riot_cipher/chacha20_stream.c
@@ -0,0 +1,135 @@
+/*
+ * Copyright (C) 2024 RIOT OS contributors
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.

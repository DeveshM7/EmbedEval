+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       Glue code for PSA ChaCha20 stream cipher
+ *
+ * @author      RIOT OS contributors
+ *
+ * @}
+ */
+
+#include "psa/crypto.h"
+#include "crypto/chacha.h"
+#include "psa_ciphers.h"
+
+#define CHACHA20_NONCE_LENGTH 12
+
+static inline psa_status_t chacha20_crypt(const uint8_t *key,
+                                           size_t key_size,
+                                           const uint8_t *nonce,
+                                           const uint8_t *input,
+                                           size_t input_length,
+                                           uint8_t *output,
+                                           int encrypt)
+{
+    (void)encrypt; /* ChaCha20 is symmetric for encryption/decryption */
+    chacha_ctx ctx;
+
+    if (key_size != 32) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    if (chacha_init(&ctx, 20, key, 32, nonce) != 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    for (size_t i = 0; i < input_length; i += 64) {
+        size_t block_len = (input_length - i) < 64 ? (input_length - i) : 64;
+        uint8_t keystream[64];
+        
+        chacha_keystream_bytes(&ctx, keystream);
+        
+        for (size_t j = 0; j < block_len; j++) {
+            output[i + j] = input[i + j] ^ keystream[j];
+        }
+    }
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_cipher_stream_chacha20_encrypt(const psa_key_attributes_t *attributes,
+                                                 const uint8_t *key_buffer,
+                                                 size_t key_buffer_size,
+                                                 psa_algorithm_t alg,
+                                                 const uint8_t *input,
+                                                 size_t input_length,
+                                                 uint8_t *output,
+                                                 size_t output_size,
+                                                 size_t *output_length)
+{
+    (void)attributes;
+    (void)alg;
+
+    size_t required_size = input_length + CHACHA20_NONCE_LENGTH;
+    
+    if (output_size < required_size) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* Generate random nonce */
+    psa_status_t status = psa_generate_random(output, CHACHA20_NONCE_LENGTH);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* Encrypt the plaintext */
+    status = chacha20_crypt(key_buffer, key_buffer_size, output,
+                            input, input_length,
+                            output + CHACHA20_NONCE_LENGTH, 1);
+    
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    *output_length = required_size;
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_cipher_stream_chacha20_decrypt(const psa_key_attributes_t *attributes,
+                                                 const uint8_t *key_buffer,
+                                                 size_t key_buffer_size,
+                                                 psa_algorithm_t alg,
+                                                 const uint8_t *input,
+                                                 size_t input_length,
+                                                 uint8_t *output,
+                                                 size_t output_size,
+                                                 size_t *output_length)
+{
+    (void)attributes;
+    (void)alg;
+
+    if (input_length < CHACHA20_NONCE_LENGTH) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    size_t ciphertext_length = input_length - CHACHA20_NONCE_LENGTH;
+    
+    if (output_size < ciphertext_length) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    /* Extract nonce from the beginning of input */
+    const uint8_t *nonce = input;
+    const uint8_t *ciphertext = input + CHACHA20_NONCE_LENGTH;
+
+    psa_status_t status = chacha20_crypt(key_buffer, key_buffer_size, nonce,
+                                          ciphertext, ciphertext_length,
+                                          output, 0);
+    
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    *output_length = ciphertext_length;
+    return PSA_SUCCESS;
+}

+/**
+ * @brief   Low level wrapper function for ChaCha20 stream cipher encryption.
+ *          See @ref psa_cipher_encrypt()
+ *
+ * @param attributes
+ * @param key_buffer
+ * @param key_buffer_size
+ * @param alg
+ * @param input
+ * @param input_length
+ * @param output
+ * @param output_size
+ * @param output_length
+ * @return @ref psa_status_t
+ */
+psa_status_t psa_cipher_stream_chacha20_encrypt(const psa_key_attributes_t *attributes,
+                                                 const uint8_t *key_buffer,
+                                                 size_t key_buffer_size,
+                                                 psa_algorithm_t alg,
+                                                 const uint8_t *input,
+                                                 size_t input_length,
+                                                 uint8_t *output,
+                                                 size_t output_size,
+                                                 size_t *output_length);
+
+/**
+ * @brief   Low level wrapper function for ChaCha20 stream cipher decryption.
+ *          See @ref psa_cipher_decrypt()
+ *
+ * @param attributes
+ * @param key_buffer
+ * @param key_buffer_size
+ * @param alg
+ * @param input
+ * @param input_length
+ * @param output
+ * @param output_size
+ * @param output_length
+ * @return @ref psa_status_t
+ */
+psa_status_t psa_cipher_stream_chacha20_decrypt(const psa_key_attributes_t *attributes,
+                                                 const uint8_t *key_buffer,
+                                                 size_t key_buffer_size,
+                                                 psa_algorithm_t alg,
+                                                 const uint8_t *input,
+                                                 size_t input_length,
+                                                 uint8_t *output,
+                                                 size_t output_size,
+                                                 size_t *output_length);

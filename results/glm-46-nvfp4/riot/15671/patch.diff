diff --git a/pkg/mbedtls/Makefile b/pkg/mbedtls/Makefile
new file mode 100644
index 0000000..25f9df7
--- /dev/null
+++ b/pkg/mbedtls/Makefile
@@ -0,0 +1,32 @@
+PKG_NAME = mbedtls
+PKG_URL = https://github.com/ARMmbed/mbedtls
+PKG_VERSION = mbedtls-2.28.5
+PKG_LICENSE = Apache-2.0
+
+include $(RIOTBASE)/pkg/pkg.mk
+
+.PHONY: all
+
+.DEFAULT_GOAL := all
+
+ifneq (,$(filter mbedtls_entropy,$(USEMODULE)))
+  DIRS += entropy
+endif
+
+# Add include path for mbed TLS headers
+INCLUDES += -I$(PKG_SOURCE_DIR)/include
+
+# Add all mbed TLS library source files
+LIB_SRC := $(wildcard $(PKG_SOURCE_DIR)/library/*.c)
+
+# Exclude some problematic files for RIOT
+LIB_SRC := $(filter-out %_template.c,$(LIB_SRC))
+LIB_SRC := $(filter-out $(PKG_SOURCE_DIR)/library/net_sockets.c,$(LIB_SRC))
+LIB_SRC := $(filter-out $(PKG_SOURCE_DIR)/library/threading.c,$(LIB_SRC))
+
+# Add filtered source files
+SRC += $(LIB_SRC)
+
+# Suppress mbed TLS warnings
+CFLAGS += -Wno-unused-parameter -Wno-unused-value -Wno-unused-variable
+SRC += $(CURDIR)/entropy/*.c

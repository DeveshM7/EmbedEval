diff --git a/simple_test.c b/simple_test.c
new file mode 100644
index 00000000..e6b38d99
--- /dev/null
+++ b/simple_test.c
@@ -0,0 +1,60 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "net/nanocoap.h"
+
+int main(void)
+{
+    uint8_t buf[128];
+    coap_pkt_t pkt;
+    coap_block2_t block;
+    
+    printf("Testing coap_get_block2 implementation...\n");
+    
+    // Test 1: No Block2 option
+    memset(buf, 0, sizeof(buf));
+    buf[0] = 0x40;  // Version 1, Type CON, TKL 0
+    buf[1] = 0x01;  // Code GET
+    buf[2] = 0x00;  // Message ID high
+    buf[3] = 0x01;  // Message ID low
+    
+    coap_parse_udp(&pkt, buf, 4);
+    
+    int res = coap_get_block2(&pkt, &block);
+    printf("Test 1 - No Block2: res=%d, blknum=%lu, szx=%u, offset=%lu, more=%d\n",
+           res, block.blknum, block.szx, block.offset, block.more);
+           
+    assert(res == 0);
+    assert(block.blknum == 0);
+    assert(block.szx == 2);  // CONFIG_NANOCOAP_BLOCKSIZE_DEFAULT = COAP_BLOCKSIZE_64 = 2
+    assert(block.offset == 0);
+    assert(block.more == false);
+    
+    printf("Test 1 passed!\n");
+    
+    // Test 2: Valid Block2 option (blknum=1, szx=2, more=0)
+    memset(buf, 0, sizeof(buf));
+    buf[0] = 0x40;  // Version 1, Type CON, TKL 0
+    buf[1] = 0x01;  // Code GET
+    buf[2] = 0x00;  // Message ID high
+    buf[3] = 0x01;  // Message ID low
+    buf[4] = 0xB1;  // Block2 option (23 << 4 | 0x1)
+    buf[5] = 0x12;  // blknum=1 (1<<4), szx=2
+    
+    coap_parse_udp(&pkt, buf, 6);
+    
+    res = coap_get_block2(&pkt, &block);
+    printf("Test 2 - Block2 option: res=%d, blknum=%lu, szx=%u, offset=%lu, more=%d\n",
+           res, block.blknum, block.szx, block.offset, block.more);
+           
+    assert(res == 1);
+    assert(block.blknum == 1);
+    assert(block.szx == 2);
+    assert(block.offset == 64);  // 1 << (2 + 4) = 1 << 6 = 64
+    assert(block.more == false);
+    
+    printf("Test 2 passed!\n");
+    
+    printf("All tests passed!\n");
+    return 0;
+}

@@ -0,0 +1,40 @@
+
+/*
+ * Tests coap_get_block2() function for Block2 option handling
+ */
+static void test_nanocoap__get_block2(void)
+{
+    uint8_t buf[_BUF_SIZE];
+    coap_pkt_t pkt;
+    coap_block2_t block;
+
+    /* Test 1: No Block2 option should return 0 with defaults */
+    memset(buf, 0, sizeof(buf));
+    uint16_t msgid = 0xABCD;
+    uint8_t token[2] = {0xDA, 0xEC};
+    ssize_t hdr_len = coap_build_udp_hdr(buf, sizeof(buf), COAP_TYPE_NON,
+                                         token, 2, COAP_METHOD_GET, msgid);
+    coap_pkt_init(&pkt, buf, sizeof(buf), hdr_len);
+
+    int res = coap_get_block2(&pkt, &block);
+    TEST_ASSERT_EQUAL_INT(0, res);
+    TEST_ASSERT_EQUAL_INT(0, block.blknum);
+    TEST_ASSERT_EQUAL_INT(CONFIG_NANOCOAP_BLOCKSIZE_DEFAULT, block.szx);
+    TEST_ASSERT_EQUAL_INT(0, block.offset);
+    TEST_ASSERT_EQUAL_INT(0, block.more);
+
+    /* Test 2: Valid Block2 option without more flag */
+    hdr_len = coap_build_udp_hdr(buf, sizeof(buf), COAP_TYPE_NON,
+                                 token, 2, COAP_METHOD_GET, msgid);
+    coap_pkt_init(&pkt, buf, sizeof(buf), hdr_len);
+    /* Add Block2 option: block number 1, szx=2 (32 bytes), more=false */
+    coap_opt_add_uint(&pkt, COAP_OPT_BLOCK2, (1 << 4) | 2);
+    coap_opt_finish(&pkt, COAP_OPT_FINISH_NONE);
+
+    res = coap_get_block2(&pkt, &block);
+    TEST_ASSERT_EQUAL_INT(1, res);
+    TEST_ASSERT_EQUAL_INT(1, block.blknum);
+    TEST_ASSERT_EQUAL_INT(2, block.szx);
+    TEST_ASSERT_EQUAL_INT(1 << (2 + 4), block.offset);
+    TEST_ASSERT_EQUAL_INT(0, block.more);
+}
diff --git a/test_block2.c b/test_block2.c
new file mode 100644
index 00000000..a43b58ab
--- /dev/null
+++ b/test_block2.c
@@ -0,0 +1,89 @@
+#include <stdio.h>
+#include <assert.h>
+#include <string.h>
+#include "net/nanocoap.h"
+
+int main(void)
+{
+    printf("Testing coap_get_block2 implementation...\n");
+    
+    // Test 1: Packet without Block2 option should return 0 with defaults
+    uint8_t buf[128];
+    coap_pkt_t pkt;
+    coap_block2_t block;
+    
+    // Create a minimal CoAP packet without Block2 option
+    memset(buf, 0, sizeof(buf));
+    buf[0] = (COAP_V1 << 6) | (COAP_TYPE_CON << 4) | 0;  // Ver=1, Type=CON, TKL=0
+    buf[1] = COAP_METHOD_GET;  // Code = GET
+    buf[2] = 0x00;  // Message ID high
+    buf[3] = 0x01;  // Message ID low
+    
+    coap_parse_udp(&pkt, buf, sizeof(buf));
+    
+    int res = coap_get_block2(&pkt, &block);
+    printf("Test 1 - No Block2 option: res=%d, blknum=%lu, szx=%u, offset=%lu, more=%s\n", 
+           res, block.blknum, block.szx, block.offset, block.more ? "true" : "false");
+    
+    assert(res == 0);
+    assert(block.blknum == 0);
+    assert(block.szx == CONFIG_NANOCOAP_BLOCKSIZE_DEFAULT);
+    assert(block.offset == 0);
+    assert(block.more == false);
+    
+    printf("Test 1 passed!\n");
+    
+    // Test 2: Packet with valid Block2 option
+    memset(buf, 0, sizeof(buf));
+    buf[0] = (COAP_V1 << 6) | (COAP_TYPE_CON << 4) | 0;  // Ver=1, Type=CON, TKL=0
+    buf[1] = COAP_METHOD_GET;  // Code = GET
+    buf[2] = 0x00;  // Message ID high
+    buf[3] = 0x01;  // Message ID low
+    
+    // Add Block2 option: block number 1, szx=2 (32 bytes), more=false
+    uint8_t *optpos = buf + 4;  // After header
+    *optpos++ = (COAP_OPT_BLOCK2 << 4) | 1;  // Block2 option, delta=24, len=1
+    *optpos++ = (1 << 4) | 2;  // blocknum=1, more=0, szx=2
+    
+    coap_parse_udp(&pkt, buf, optpos - buf);
+    
+    res = coap_get_block2(&pkt, &block);
+    printf("Test 2 - Valid Block2 option: res=%d, blknum=%lu, szx=%u, offset=%lu, more=%s\n", 
+           res, block.blknum, block.szx, block.offset, block.more ? "true" : "false");
+    
+    assert(res == 1);
+    assert(block.blknum == 1);
+    assert(block.szx == 2);  // COAP_BLOCKSIZE_32
+    assert(block.offset == 1 << (2 + 4));  // 1 << 6 = 64
+    assert(block.more == false);
+    
+    printf("Test 2 passed!\n");
+    
+    // Test 3: Packet with Block2 option with more=true
+    memset(buf, 0, sizeof(buf));
+    buf[0] = (COAP_V1 << 6) | (COAP_TYPE_CON << 4) | 0;  // Ver=1, Type=CON, TKL=0
+    buf[1] = COAP_METHOD_GET;  // Code = GET
+    buf[2] = 0x00;  // Message ID high
+    buf[3] = 0x01;  // Message ID low
+    
+    optpos = buf + 4;
+    *optpos++ = (COAP_OPT_BLOCK2 << 4) | 1;  // Block2 option, delta=24, len=1
+    *optpos++ = (1 << 4) | (1 << 3) | 2;  // blocknum=1, more=1, szx=2
+    
+    coap_parse_udp(&pkt, buf, optpos - buf);
+    
+    res = coap_get_block2(&pkt, &block);
+    printf("Test 3 - Block2 with more=true: res=%d, blknum=%lu, szx=%u, offset=%lu, more=%s\n", 
+           res, block.blknum, block.szx, block.offset, block.more ? "true" : "false");
+    
+    assert(res == 1);
+    assert(block.blknum == 1);
+    assert(block.szx == 2);
+    assert(block.offset == 1 << (2 + 4));
+    assert(block.more == true);
+    
+    printf("Test 3 passed!\n");
+    
+    printf("All tests passed! coap_get_block2 implementation is working correctly.\n");
+    return 0;
+}

diff --git a/pkg/micro-ecc/psa_uecc/p256.c b/pkg/micro-ecc/psa_uecc/p256.c
index f07357aa..f796a911 100644
--- a/pkg/micro-ecc/psa_uecc/p256.c
+++ b/pkg/micro-ecc/psa_uecc/p256.c
@@ -81,6 +81,17 @@ psa_status_t psa_ecc_p256r1_sign_message(  const psa_key_attributes_t *attribute
     return psa_ecc_p256r1_sign_hash(attributes, alg, key_buffer, key_buffer_size, hash, hash_length, signature, signature_size, signature_length);
 }
 
+static psa_status_t _strip_sec1_prefix(const uint8_t **key_data, size_t *key_data_size)
+{
+    /* Check if this is a public key with SEC 1 uncompressed format (starting with 0x04) */
+    if (*key_data_size > 0 && *key_data[0][0] == 0x04) {
+        /* Skip the 0x04 prefix - micro-ecc expects just X||Y coordinates */
+        *key_data = &(*key_data)[1];
+        *key_data_size = *key_data_size - 1;
+    }
+    return PSA_SUCCESS;
+}
+
 psa_status_t psa_ecc_p256r1_verify_hash(const psa_key_attributes_t *attributes,
                                         psa_algorithm_t alg, const uint8_t *key_buffer,
                                         size_t key_buffer_size, const uint8_t *hash,
@@ -90,14 +101,18 @@ psa_status_t psa_ecc_p256r1_verify_hash(const psa_key_attributes_t *attributes,
     int ret = 0;
     const struct uECC_Curve_t *curve = uECC_secp256r1();
 
-    ret = uECC_verify(key_buffer, hash, hash_length, signature, curve);
+    /* Strip SEC 1 prefix if present */
+    const uint8_t *actual_key_data = key_buffer;
+    size_t actual_key_size = key_buffer_size;
+    _strip_sec1_prefix(&actual_key_data, &actual_key_size);
+
+    ret = uECC_verify(actual_key_data, hash, hash_length, signature, curve);
     if (!ret) {
         return PSA_ERROR_GENERIC_ERROR;
     }
 
     (void)alg;
     (void)attributes;
-    (void)key_buffer_size;
     (void)signature_length;
     return PSA_SUCCESS;
 }
@@ -120,3 +135,23 @@ psa_status_t psa_ecc_p256r1_verify_message(const psa_key_attributes_t *attribute
 
     return psa_ecc_p256r1_verify_hash(attributes, alg, key_buffer, key_buffer_size, hash, hash_length, signature, signature_length);
 }
+
+psa_status_t psa_import_ecc_p256r1_public_key(const uint8_t *data, size_t data_length,
+                                                uint8_t *key_buffer, size_t key_buffer_size,
+                                                size_t *key_buffer_length)
+{
+    if (data_length != 65 || data[0] != 0x04) {
+        /* Expect SEC 1 uncompressed format: 0x04 || X || Y */
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    
+    if (key_buffer_size < 64) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+    
+    /* Skip the 0x04 prefix and copy the X||Y coordinates */
+    memcpy(key_buffer, &data[1], 64);
+    *key_buffer_length = 64;
+    
+    return PSA_SUCCESS;
+}
diff --git a/pkg/micro-ecc/psa_uecc/p256.c.backup b/pkg/micro-ecc/psa_uecc/p256.c.backup

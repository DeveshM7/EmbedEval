diff --git a/test_div_round_size_t.c b/test_div_round_size_t.c
new file mode 100644
index 00000000..66f2d50c
--- /dev/null
+++ b/test_div_round_size_t.c
@@ -0,0 +1,26 @@
+#include <stddef.h>
+#include <stdint.h>
+#include "macros/math.h"
+#include <stdio.h>
+
+int main(void) {
+    // Test the specific case from the task
+    size_t a = 20;
+    int result = DIV_ROUND(a, 7);
+    printf("DIV_ROUND(%zu, 7) = %d (expected 3)\n", a, result);
+    
+    if (result != 3) {
+        printf("ERROR: Expected 3, got %d\n", result);
+        return 1;
+    }
+    
+    // Test more cases with size_t
+    printf("Testing more size_t cases:\n");
+    printf("DIV_ROUND(21, 7) = %d\n", DIV_ROUND((size_t)21, 7));
+    printf("DIV_ROUND(22, 7) = %d\n", DIV_ROUND((size_t)22, 7));
+    printf("DIV_ROUND(0, 7) = %d\n", DIV_ROUND((size_t)0, 7));
+    printf("DIV_ROUND(1, 2) = %d\n", DIV_ROUND((size_t)1, 2));
+    
+    // All should work without compilation errors
+    return 0;
+}

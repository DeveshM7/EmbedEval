new file mode 100644
index 00000000..9e4e84a1
--- /dev/null
+++ b/core/include/macros/math.h.bak
@@ -0,0 +1,56 @@
+/*
+ * Copyright (C) 2022 ML!PA Consulting GmbH
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @ingroup     core_macros
+ * @{
+ *
+ * @file
+ * @brief       Math helper macros
+ *
+ * @author      Benjamin Valentin <benjamin.valentin@ml-pa.com>
+ */
+
+#ifndef MACROS_MATH_H
+#define MACROS_MATH_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief Returns the sign of @p a, either -1 or 1
+ */
+#define SIGNOF(a) _Generic(a, unsigned char: 1,          \
+                              unsigned short: 1,         \
+                              unsigned int: 1,           \
+                              unsigned long: 1,          \
+                              unsigned long long: 1,     \
+                              default: (long long)(a) < 0 ? -1 : 1)
+/**
+ * @brief Calculates @p a/ @p b with arithmetic rounding
+ */
+#define DIV_ROUND(a, b) (((a) + SIGNOF(a) * (b) / 2) / (b))
+
+/**
+ * @brief Calculates @p a/ @p b, always rounding up to the
+ *        next whole number
+ */
+#define DIV_ROUND_UP(a, b) (((a) + SIGNOF(a) * ((b) - SIGNOF(b))) / (b))
+
+/**
+ * @brief Align @p num with the next multiple of @p chunk
+ */
+#define MATH_ALIGN(num, chunk) ((chunk) * DIV_ROUND_UP(num, chunk))
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MACROS_MATH_H */
+/** @} */
diff --git a/fix_math.py b/fix_math.py
new file mode 100644
index 00000000..2a7bebff
--- /dev/null
+++ b/fix_math.py
@@ -0,0 +1,15 @@
+with open('core/include/macros/math.h', 'r') as f:
+    lines = f.readlines()
+
+# Find the line with "unsigned long long: 1," and add size_t after it
+for i, line in enumerate(lines):
+    if 'unsigned long long: 1,' in line:
+        # Insert size_t: 1, after this line
+        indentation = ' ' * 30  # Match existing indentation
+        lines.insert(i+1, indentation + 'size_t: 1,                  \\\n')
+        break
+
+with open('core/include/macros/math.h', 'w') as f:
+    f.writelines(lines)
+
+print("Added size_t support to SIGNOF macro")
diff --git a/fix_math_final.py b/fix_math_final.py
new file mode 100644
index 00000000..e97ad058
--- /dev/null
+++ b/fix_math_final.py
@@ -0,0 +1,27 @@
+with open('core/include/macros/math.h', 'r') as f:
+    content = f.read()
+
+# Replace just the SIGNOF macro line
+import re
+pattern = r'#define SIGNOF\(a\) _Generic\(a, unsigned char: 1,\s*\\'
+replacement = '''#define SIGNOF(a) ((a) < 0 ? -1 : 1)'''
+content = re.sub(pattern, replacement, content, flags=re.DOTALL)
+
+# Remove the rest of the _Generic lines
+lines = content.split('\n')
+new_lines = []
+skip_next = 4  # Skip the next 4 lines after the _Generic start
+for line in lines:
+    if '_Generic(a, unsigned char: 1,' in line:
+        new_lines.append('#define SIGNOF(a) ((a) < 0 ? -1 : 1)')
+        skip_next = 4
+        continue
+    if skip_next > 0:
+        skip_next -= 1
+        continue
+    new_lines.append(line)
+
+with open('core/include/macros/math.h', 'w') as f:
+    f.write('\n'.join(new_lines))
+
+print("Replaced SIGNOF macro with simpler implementation")
diff --git a/fix_signof.py b/fix_signof.py
new file mode 100644
index 00000000..a9d498f2
--- /dev/null
+++ b/fix_signof.py
@@ -0,0 +1,20 @@
+with open('core/include/macros/math.h', 'r') as f:
+    content = f.read()
+
+# Replace the SIGNOF macro to handle size_t without warnings
+# Use double negation trick: !!value converts any value to 0 or 1
+new_signof = '''/**
+ * @brief Returns the sign of @p a, either -1 or 1
+ */
+#define SIGNOF(a) ((a) && ((typeof(a))0 > (typeof(a))-1) ? -1 : 1)'''
+
+# Replace the _Generic version
+import re
+pattern = r'/\*\*[\s\S]*?\*/[\s]*#define SIGNOF\(a\)_Generic\([^}]+\)\)'
+replacement = new_signof
+content = re.sub(pattern, replacement, content, flags=re.DOTALL)
+
+with open('core/include/macros/math.h', 'w') as f:
+    f.write(content)
+
+print("Updated SIGNOF macro to handle size_t")
diff --git a/fixed_signof.py b/fixed_signof.py
new file mode 100644
index 00000000..89a6a39c
--- /dev/null
+++ b/fixed_signof.py
@@ -0,0 +1,16 @@
+with open('core/include/macros/math.h', 'r') as f:
+    lines = f.readlines()
+
+# Replace the SIGNOF macro line
+for i, line in enumerate(lines):
+    if '#define SIGNOF(a) _Generic(a' in line:
+        # Replace with a simpler implementation
+        lines[i] = '#define SIGNOF(a) (((typeof(a))-1 < (typeof(a))0) ? -1 : 1)\n'
+        # Remove the next 3 lines (the rest of the _Generic definition)
+        del lines[i+1:i+4]
+        break
+
+with open('core/include/macros/math.h', 'w') as f:
+    f.writelines(lines)
+
+print("Replaced SIGNOF with simple implementation")
diff --git a/math_h_fix.py b/math_h_fix.py
new file mode 100644
index 00000000..93e87ce3
--- /dev/null
+++ b/math_h_fix.py
@@ -0,0 +1,21 @@
+import re
+
+with open('core/include/macros/math.h', 'r') as f:
+    content = f.read()
+
+# Find the SIGNOF macro and add size_t: 1 to the list of unsigned types
+pattern = r'(#define SIGNOF\(a\).*?unsigned long long: 1,.*?default:)'
+replacement = r'''#define SIGNOF(a) _Generic(a, unsigned char: 1,          \\
+                              unsigned short: 1,         \\
+                              unsigned int: 1,           \\
+                              unsigned long: 1,          \\
+                              unsigned long long: 1,     \\
+                              size_t: 1,                  \\
+                              default: (long long)(a) < 0 ? -1 : 1'''
+
+content = re.sub(pattern, replacement, content, flags=re.DOTALL)
+
+with open('core/include/macros/math.h', 'w') as f:
+    f.write(content)
+
+print("Updated SIGNOF macro to include size_t")
diff --git a/rewrite_signof.py b/rewrite_signof.py
new file mode 100644
index 00000000..5c01a9a9
--- /dev/null
+++ b/rewrite_signof.py
@@ -0,0 +1,21 @@
+with open('core/include/macros/math.h', 'r') as f:
+    lines = f.readlines()
+
+# Replace the SIGNOF macro with a simpler approach that works with size_t
+for i, line in enumerate(lines):
+    if line.strip() == '#define SIGNOF(a) _Generic(a, unsigned char: 1,          \\':
+        # Replace the entire SIGNOF macro definition
+        new_macro = '''/**
+ * @brief Returns the sign of @p a, either -1 or 1
+ */
+#define SIGNOF(a) ((a) < 0 ? -1 : 1)
+'''
+        lines[i] = new_macro
+        # Remove the next 4 lines (the rest of the _Generic definition)
+        del lines[i+1:i+5]
+        break
+
+with open('core/include/macros/math.h', 'w') as f:
+    f.writelines(lines)
+
+print("Simplified SIGNOF macro to handle all types including size_t")

@@ -0,0 +1,12 @@
+#include <stddef.h>
+
+// Test if size_t can be compared with 0
+int test_size_t_sign() {
+    size_t a = 20;
+    // This should work fine - comparing size_t with 0
+    return (a < 0) ? -1 : 1;
+}
+
+int main() {
+    return test_size_t_sign();
+}
diff --git a/size_t_check.c b/size_t_check.c
new file mode 100644
index 00000000..2822086e
--- /dev/null
+++ b/size_t_check.c
@@ -0,0 +1,11 @@
+#include <stddef.h>
+#include <stdio.h>
+
+int main() {
+    // This test tells us if size_t is a distinct type
+    void *p = (size_t*)0;
+    void *q = (unsigned long*)0;
+    printf("size_t and unsigned long are %s compatible\n", 
+           p == q ? "definitely" : "not");
+    return 0;
+}

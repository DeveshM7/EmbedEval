+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * @defgroup    sys_clk Clock utilities
+ * @brief       Provides system clock frequency access
+ * @ingroup     sys
+ *
+ * @{
+ * @file
+ * @brief       Clock utilities implementation
+ *
+ * @author
+ */
+
+#include "clk.h"
+
+/* Try to include periph_conf for boards that define CLOCK_CORECLOCK */
+#include "periph_conf.h"
+
+uint32_t coreclk(void)
+{
+/* If the board defines CLOCK_CORECLOCK, use it */
+#ifdef CLOCK_CORECLOCK
+    return CLOCK_CORECLOCK;
+#else
+    /* For native and boards without CLOCK_CORECLOCK defined,
+     * provide a reasonable default value */
+    /* 100MHz is a common reasonable default for many platforms */
+    return 100000000U;
+#endif
+}

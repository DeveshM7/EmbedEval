diff --git a/fix_shell.c b/fix_shell.c
new file mode 100644
index 00000000..deb56cb9
--- /dev/null
+++ b/fix_shell.c
@@ -0,0 +1,27 @@
+/* Read the broken shell.c file and rewrite it correctly */
+#include <stdio.h>
+#include <string.h>
+
+int main() {
+    FILE *infile = fopen("/testbed/sys/shell/shell.c", "r");
+    FILE *outfile = fopen("/testbed/sys/shell/shell.c.fixed", "w");
+    
+    char line[1024];
+    int line_num = 0;
+    int start_output = 0;
+    
+    while (fgets(line, sizeof(line), infile)) {
+        line_num++;
+        
+        if (start_output || strstr(line, "char *readpos = line;")) {
+            start_output = 1;
+            
+            /* Write the line number and content */
+            fprintf(outfile, "%d:%s", line_num, line);
+        }
+    }
+    
+    fclose(infile);
+    fclose(outfile);
+    return 0;
+}

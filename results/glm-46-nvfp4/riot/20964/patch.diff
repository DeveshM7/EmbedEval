+/**
+ * @ingroup     sys_shell_commands
+ * @{
+ *
+ * @file
+ * @brief       Shell command for JSON help output
+ *
+ * @author
+ *
+ * @}
+ */
+
+#include <stdio.h>
+#include "shell.h"
+
+static int _help_json_handler(int argc, char **argv)
+{
+    (void)argc;
+    (void)argv;
+    printf("{\"cmds\":[");
+    int count = 0;
+    unsigned n = XFA_LEN(shell_command_xfa_t*, shell_commands_xfa);
+    for (unsigned i = 0; i < n; i++) {
+        const volatile shell_command_xfa_t *entry = shell_commands_xfa[i];
+        if (flash_strcmp("help", entry->name) != 0 && flash_strcmp("help_json", entry->name) != 0) {
+            if (count++) {
+                printf(",");
+            }
+            printf("{\"cmd\":\"%"PRIsflash"\",\"desc\":\"%"PRIsflash"\"}", entry->name, entry->desc);
+        }
+    }
+    printf("]}\n");
+    return 0;
+}
+
+SHELL_COMMAND(help_json, "Print available commands in JSON format", _help_json_handler);

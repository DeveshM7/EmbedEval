+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Mock types and structures */
+typedef struct {
+    const char *name;
+    const char *desc;
+    int (*handler)(int, char **);
+} shell_command_t;
+
+typedef struct {
+    const char *name;
+    const char *desc;
+    int (*handler)(int, char **);
+} shell_command_xfa_t;
+
+/* Mock XFA definitions for testing */
+#define XFA_LEN(type, name) (3)
+#define PRIsflash "s"
+
+static shell_command_xfa_t test_xfa[] = {
+    {"ps", "Prints information about running threads.", NULL},
+    {"reboot", "Reboot the node", NULL},
+    {"version", "Prints current RIOT_VERSION", NULL},
+};
+
+shell_command_xfa_t *shell_commands_xfa = test_xfa;
+
+/* Mock flash_strcmp for testing */
+int flash_strcmp(const char *s1, const char *s2) {
+    return strcmp(s1, s2);
+}
+
+/* Extract help_json_handler from our implementation */
+static int _help_json_handler(int argc, char **argv, const shell_command_t *command_list)
+{
+    (void)argc;
+    (void)argv;
+
+    printf("{\"cmds\":[");
+    
+    int count = 0;
+    
+    /* Print commands from the command list */
+    if (command_list != NULL) {
+        for (const shell_command_t *entry = command_list; entry->name != NULL; entry++) {
+            if (strcmp(entry->name, "help") != 0 && strcmp(entry->name, "help_json") != 0) {
+                if (count++) {
+                    printf(",");
+                }
+                printf("{\"cmd\":\"%s\",\"desc\":\"%s\"}", entry->name, entry->desc);
+            }
+        }
+    }
+    
+    /* Print commands from the XFA array */
+    unsigned n = XFA_LEN(shell_command_xfa_t*, shell_commands_xfa);
+    for (unsigned i = 0; i < n; i++) {
+        const shell_command_xfa_t *entry = &shell_commands_xfa[i];
+        if (flash_strcmp("help", entry->name) != 0 && flash_strcmp("help_json", entry->name) != 0) {
+            if (count++) {
+                printf(",");
+            }
+            printf("{\"cmd\":\"%"PRIsflash"\",\"desc\":\"%"PRIsflash"\"}", entry->name, entry->desc);
+        }
+    }
+    
+    printf("]}\n");
+    return 0;
+}
+
+int main() {

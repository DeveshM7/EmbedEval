@@ -0,0 +1,41 @@
+/*
+ * Copyright (C) 2023 RIOT OS contributors
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser General
+ * Public License v2.1. See the file LICENSE in the top level directory for more
+ * details.

+
+/**
+ * @defgroup    sys_ztimer_auto_adjust  ztimer auto-adjust module
+ * @ingroup     sys_ztimer
+ * @brief       ztimer auto-adjust functionality
+ *
+ * @{
+ *
+ * @file
+ * @brief       ztimer_auto_adjust API
+ *
+ * @author      RIOT OS contributors
+ */
+
+#ifndef ZTIMER_AUTO_ADJUST_H
+#define ZTIMER_AUTO_ADJUST_H
+
+#include "ztimer.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Initialize ztimer auto-adjust
+ *
+ * This function measures the overhead of timer operations and sets the
+ * adjust values in the ztimer clocks when no board-configured values
+ * are present.
+ */
+void ztimer_auto_adjust_init(void);
+
+#endif /* ZTIMER_AUTO_ADJUST_H */
+/** @} */
diff --git a/sys/include/ztimer/overhead.h b/sys/include/ztimer/overhead.h
index 5216670..5166c9a 100644
--- a/sys/include/ztimer/overhead.h
+++ b/sys/include/ztimer/overhead.h
@@ -45,3 +45,30 @@ int32_t ztimer_overhead(ztimer_clock_t *clock, uint32_t base);
 
 #endif /* ZTIMER_OVERHEAD_H */
 /** @} */
+
+/**
+ * @brief   Measure ztimer timer-callback operation overhead
+ *
+ * This function measures the overhead incurred by ztimer_set() and callback
+ * execution. It will configure a callback to trigger after @p base ticks,
+ * then return the number of ticks that have passed, minus @p base.
+ *
+ * @param[in]   clock   ztimer clock to operate on
+ * @param[in]   base    base interval to use
+ * @return  (time from ztimer_set() until callback) - base
+ */
+int32_t ztimer_overhead_set(ztimer_clock_t *clock, uint32_t base);
+
+/**
+ * @brief   Measure ztimer timer-sleep operation overhead
+ *
+ * This function measures the overhead incurred by ztimer_sleep(). It will
+ * sleep for @p base ticks, then return the number of ticks that have passed,
+ * minus @p base.
+ *
+ * @param[in]   clock   ztimer clock to operate on
+ * @param[in]   base    base interval to use
+ * @return  (time from ztimer_sleep() until wakeup) - base
+ */
+int32_t ztimer_overhead_sleep(ztimer_clock_t *clock, uint32_t base);
+

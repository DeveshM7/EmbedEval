diff --git a/sys/ztimer/auto_adjust.c b/sys/ztimer/auto_adjust.c
new file mode 100644
index 0000000..2db5145
--- /dev/null
+++ b/sys/ztimer/auto_adjust.c
@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2023 RIOT OS contributors
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser General
+ * Public License v2.1. See the file LICENSE in the top level directory for more
+ * details.
+ */
+
+/**
+ * @ingroup     sys_ztimer_auto_adjust
+ * @{
+ *
+ * @file
+ * @brief       ztimer auto-adjust module
+ *
+ * @author      RIOT OS contributors
+ *
+ * @}
+ */
+
+#include "log.h"
+#include "ztimer.h"
+#include "ztimer/overhead.h"
+
+#define ZTIMER_MEASURE_BASE 1000
+
+void ztimer_auto_adjust_init(void)
+{
+#if MODULE_ZTIMER_USEC
+    /* Only measure if no board-configured values are present */
+#if !defined(CONFIG_ZTIMER_USEC_ADJUST_SET) && !defined(CONFIG_ZTIMER_USEC_ADJUST_SLEEP)
+    LOG_DEBUG("ztimer_auto_adjust: measuring overhead for ZTIMER_USEC\n");
+    
+    /* Measure timer-callback operation overhead */
+    int32_t overhead_set = ztimer_overhead_set(ZTIMER_USEC, ZTIMER_MEASURE_BASE);
+    if (overhead_set < 0) {
+        overhead_set = 0;
+    }
+    ZTIMER_USEC->adjust_set = overhead_set;
+    LOG_DEBUG("ztimer_auto_adjust: measured adjust_set=%d\n", overhead_set);
+    
+    /* Measure timer-sleep operation overhead 
+     * Note: this measures the total overhead of ztimer_sleep(), which includes
+     * both the adjust_set overhead (from ztimer_set inside ztimer_sleep) and 
+     * the additional sleep overhead */
+    int32_t overhead_sleep = ztimer_overhead_sleep(ZTIMER_USEC, ZTIMER_MEASURE_BASE);
+    if (overhead_sleep < 0) {
+        overhead_sleep = 0;
+    }
+    
+    /* The adjust_sleep value should be the additional overhead beyond what
+     * ztimer_set() already accounts for, so we subtract the set overhead */
+    int32_t additional_sleep_overhead = overhead_sleep - overhead_set;
+    if (additional_sleep_overhead < 0) {
+        additional_sleep_overhead = 0;
+    }
+    ZTIMER_USEC->adjust_sleep = additional_sleep_overhead;
+    LOG_DEBUG("ztimer_auto_adjust: measured adjust_sleep=%d\n", additional_sleep_overhead);
+#else
+    LOG_DEBUG("ztimer_auto_adjust: using board-configured values\n");
+#endif
+#endif /* MODULE_ZTIMER_USEC */
+}

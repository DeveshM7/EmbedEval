diff --git a/sys/bitfield/bitfield.c b/sys/bitfield/bitfield.c
index eb70d20..bbdb9c8 100644
--- a/sys/bitfield/bitfield.c
+++ b/sys/bitfield/bitfield.c
@@ -45,3 +45,35 @@ int bf_get_unset(uint8_t field[], int size)
     irq_restore(state);
     return(result);
 }
+
+void bf_or(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len)
+{
+    size_t nbytes = (len + 7) / 8;
+    for (size_t i = 0; i < nbytes; i++) {
+        out[i] = a[i] | b[i];
+    }
+}
+
+void bf_and(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len)
+{
+    size_t nbytes = (len + 7) / 8;
+    for (size_t i = 0; i < nbytes; i++) {
+        out[i] = a[i] & b[i];
+    }
+}
+
+void bf_xor(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len)
+{
+    size_t nbytes = (len + 7) / 8;
+    for (size_t i = 0; i < nbytes; i++) {
+        out[i] = a[i] ^ b[i];
+    }
+}
+
+void bf_inv(uint8_t out[], const uint8_t a[], size_t len)
+{
+    size_t nbytes = (len + 7) / 8;
+    for (size_t i = 0; i < nbytes; i++) {
+        out[i] = ~a[i];
+    }
+}
diff --git a/sys/include/bitfield.h b/sys/include/bitfield.h
index 73225ef..56a702e 100644
--- a/sys/include/bitfield.h
+++ b/sys/include/bitfield.h
@@ -108,3 +108,43 @@ int bf_get_unset(uint8_t field[], int size);
 
 /** @} */
 #endif /* BITFIELD_H */
+
+/**
+ * @brief   Perform bitwise OR on two bitfields
+ *
+ * @param[out]  out    Output bitfield
+ * @param[in]   a      First input bitfield  
+ * @param[in]   b      Second input bitfield
+ * @param[in]   len    Number of bits in the bitfields
+ */
+void bf_or(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len);
+
+/**
+ * @brief   Perform bitwise AND on two bitfields
+ *
+ * @param[out]  out    Output bitfield
+ * @param[in]   a      First input bitfield  
+ * @param[in]   b      Second input bitfield
+ * @param[in]   len    Number of bits in the bitfields
+ */
+void bf_and(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len);
+
+/**
+ * @brief   Perform bitwise XOR on two bitfields
+ *
+ * @param[out]  out    Output bitfield
+ * @param[in]   a      First input bitfield  
+ * @param[in]   b      Second input bitfield
+ * @param[in]   len    Number of bits in the bitfields
+ */
+void bf_xor(uint8_t out[], const uint8_t a[], const uint8_t b[], size_t len);
+
+/**
+ * @brief   Perform bitwise NOT on a bitfield
+ *
+ * @param[out]  out    Output bitfield
+ * @param[in]   a      Input bitfield
+ * @param[in]   len    Number of bits in the bitfield
+ */
+void bf_inv(uint8_t out[], const uint8_t a[], size_t len);
+

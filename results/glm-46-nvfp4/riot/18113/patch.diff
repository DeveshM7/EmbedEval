@@ -75,10 +75,11 @@ static int _init(mtd_dev_t *mtd)
     mtd_dev_t *backing_mtd = region->parent->mtd;
 
     /* Configuration sanity checks */
-    assert(backing_mtd->page_size == region->mtd.page_size);
-    assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);
+    /* Physical properties can be inherited, assert only for consistency if already set */
+    if (region->mtd.page_size) assert(backing_mtd->page_size == region->mtd.page_size);
+    if (region->mtd.pages_per_sector) assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);
     assert(backing_mtd->sector_count >= region->mtd.sector_count);

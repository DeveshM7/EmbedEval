diff --git a/apply_fix.py b/apply_fix.py
new file mode 100644
index 0000000..18f6c56
--- /dev/null
+++ b/apply_fix.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+
+import sys
+
+# Read the file
+with open('/testbed/drivers/mtd_mapper/mtd_mapper.c', 'r') as f:
+    content = f.read()
+
+# Replace the problematic section
+old_code = '''static int _init(mtd_dev_t *mtd)
+{
+
+    mtd_mapper_region_t *region = container_of(mtd, mtd_mapper_region_t, mtd);
+    mtd_dev_t *backing_mtd = region->parent->mtd;
+
+    /* Configuration sanity checks */
+    assert(backing_mtd->page_size == region->mtd.page_size);
+    assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);
+    assert(backing_mtd->sector_count >= region->mtd.sector_count);
+    assert(backing_mtd->write_size == region->mtd.write_size);'''
+
+new_code = '''static int _init(mtd_dev_t *mtd)
+{
+    mtd_mapper_region_t *region = container_of(mtd, mtd_mapper_region_t, mtd);
+    mtd_dev_t *backing_mtd = region->parent->mtd;
+
+    /* Configuration sanity checks */
+    assert(backing_mtd->page_size == region->mtd.page_size);
+    assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);
+    assert(backing_mtd->sector_count >= region->mtd.sector_count);
+    assert(backing_mtd->write_size == region->mtd.write_size);
+
+    /* Copy physical properties from backing device if not specified */
+    if (!region->mtd.page_size) {
+        region->mtd.page_size = backing_mtd->page_size;
+    }
+    if (!region->mtd.pages_per_sector) {
+        region->mtd.pages_per_sector = backing_mtd->pages_per_sector;
+    }
+    if (!region->mtd.write_size) {
+        region->mtd.write_size = backing_mtd->write_size;
+    }'''
+
+# First approach - comment out the asserts instead of removing
+content = content.replace(
+    '    assert(backing_mtd->page_size == region->mtd.page_size);\n    assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);',
+    '    /* Physical properties can be inherited, assert only for consistency if already set */\n    if (region->mtd.page_size) assert(backing_mtd->page_size == region->mtd.page_size);\n    if (region->mtd.pages_per_sector) assert(backing_mtd->pages_per_sector == region->mtd.pages_per_sector);'
+)
+
+content = content.replace(
+    '    assert(backing_mtd->write_size == region->mtd.write_size);',
+    '    if (region->mtd.write_size) assert(backing_mtd->write_size == region->mtd.write_size);'
+)
+
+# Write back
+with open('/testbed/drivers/mtd_mapper/mtd_mapper.c', 'w') as f:
+    f.write(content)
+
+print("Fixed mtd_mapper.c")

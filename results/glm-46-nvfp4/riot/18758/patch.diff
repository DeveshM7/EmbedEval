+/**
+ * @defgroup    sys_event_source Event Source
+ * @ingroup     sys_event
+ * @brief       Event source for triggering multiple events together
+ *
+ * This module provides an event source that can manage multiple subscribers.
+ * Each subscriber has an event and an event queue. When the source is triggered,
+ * it delivers each subscriber's event to its associated queue.
+ *
+ * @{
+ *
+ * @file
+ * @brief       Event source API
+ *
+ * @author      RIOT OS
+ */
+
+#ifndef EVENT_SOURCE_H
+#define EVENT_SOURCE_H
+
+#include "event.h"
+#include "clist.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @brief   Event subscriber structure
+ */
+typedef struct {
+    clist_node_t list_node;     /**< list node for attached subscribers   */
+    event_t *event;             /**< event to trigger                     */
+    event_queue_t *queue;       /**< queue to deliver the event to        */
+} event_source_subscriber_t;
+
+/**
+ * @brief   Event source structure
+ */
+typedef struct {
+    clist_node_t subscribers;   /**< list of attached subscribers         */
+} event_source_t;
+
+/**
+ * @brief   Static initializer for an empty event source
+ */
+#define EVENT_SOURCE_INIT { .subscribers = { NULL } }
+
+/**
+ * @brief   Static initializer for an event subscriber
+ *
+ * @param[in] e   pointer to the event to trigger
+ * @param[in] q   pointer to the event queue to deliver to
+ */
+#define EVENT_SOURCE_SUBSCRIBER_INIT(e, q) { .event = (e), .queue = (q) }
+
+/**
+ * @brief   Attach a subscriber to an event source
+ *
+ * @param[in]   source      pointer to the event source
+ * @param[in]   subscriber  pointer to the subscriber to attach
+ *
+ * The subscriber will be added to the front of the list, so that when
+ * event_source_trigger() is called, events are delivered in reverse order
+ * of attachment (LIFO).
+ */
+static inline void event_source_attach(event_source_t *source,
+                                       event_source_subscriber_t *subscriber)
+{
+    clist_lpush(&source->subscribers, &subscriber->list_node);
+}
+
+/**
+ * @brief   Trigger all subscribers' events
+ *
+ * @param[in]   source      pointer to the event source
+ *
+ * This function delivers each subscriber's event to its associated queue.
+ * Events are delivered in reverse order of attachment (LIFO).
+ * Triggering an empty source does nothing.
+ */
+static inline void event_source_trigger(const event_source_t *source)
+{
+    if (clist_is_empty(&source->subscribers)) {
+        return;
+    }
+
+    clist_node_t *node = source->subscribers.next->next;  /* start at head */
+    event_source_subscriber_t *subscriber;
+    
+    do {
+        subscriber = container_of(node, event_source_subscriber_t, list_node);
+        event_post(subscriber->queue, subscriber->event);
+        node = node->next;
+    } while (node != source->subscribers.next->next);
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* EVENT_SOURCE_H */
+/** @} */

diff --git a/sys/fmt/fmt.c b/sys/fmt/fmt.c
index f0a34953..0eb95548 100644
--- a/sys/fmt/fmt.c
+++ b/sys/fmt/fmt.c
@@ -784,3 +784,64 @@ void print_str(const char *str)
 {
     print(str, fmt_strlen(str));
 }
+
+int scn_bool(const char *str, size_t n)
+{
+    if (!str || n == 0) {
+        return -EINVAL;
+    }
+
+    /* Define true strings: "1", "true", "yes", "on" */
+    static const struct {
+        const char *str;
+        size_t len;
+    } true_strings[] = {
+        { "1", 1 },
+        { "true", 4 },
+        { "yes", 3 },
+        { "on", 2 }
+    };
+
+    /* Define false strings: "0", "false", "no", "off" */
+    static const struct {
+        const char *str;
+        size_t len;
+    } false_strings[] = {
+        { "0", 1 },
+        { "false", 5 },
+        { "no", 2 },
+        { "off", 3 }
+    };
+
+    /* Check for exact match with true strings */
+    for (size_t i = 0; i < 4; i++) {
+        if (n == true_strings[i].len &&
+            memcmp(str, true_strings[i].str, n) == 0) {
+            return 1;
+        }
+    }
+
+    /* Check for exact match with false strings */
+    for (size_t i = 0; i < 4; i++) {
+        if (n == false_strings[i].len &&
+            memcmp(str, false_strings[i].str, n) == 0) {
+            return 0;
+        }
+    }
+
+    return -EINVAL;
+}
+
+int scn_bool_str(const char *str)
+{
+    if (!str) {
+        return -EINVAL;
+    }
+
+    size_t len = fmt_strlen(str);
+    if (len == 0) {
+        return -EINVAL;
+    }
+
+    return scn_bool(str, len);
+}
diff --git a/sys/fmt/fmt.c.bak b/sys/fmt/fmt.c.bak
new file mode 100644
index 00000000..f0a34953
--- /dev/null
+++ b/sys/fmt/fmt.c.bak
@@ -0,0 +1,786 @@
+/*

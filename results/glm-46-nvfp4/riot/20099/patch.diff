+
+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       PSA Crypto persistent storage implementation
+ *
+ * @author      Your Name <your.email@haw-hamburg.de>
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include "psa_persistent_storage.h"
+#include "psa_crypto_slot_management.h"
+#include "psa_crypto_cbor_encoder.h"
+#include "xfa.h"
+
+#define ENABLE_DEBUG 0
+#include "debug.h"
+
+#define PSA_PERSISTENT_KEY_DIR "/tmp/psa_keys"
+#define MAX_KEY_FILENAME 64
+
+static int _storage_initialized = 0;
+
+static void _init_storage(void)
+{
+    if (_storage_initialized) {
+        return;
+    }
+    
+    /* Create the persistent storage directory */
+    system("mkdir -p " PSA_PERSISTENT_KEY_DIR);
+    _storage_initialized = 1;
+}
+
+static void _get_key_filename(psa_key_id_t key_id, char *filename, size_t size)
+{
+    snprintf(filename, size, "%s/key_%lu", PSA_PERSISTENT_KEY_DIR, (unsigned long)key_id);
+}
+
+psa_status_t psa_store_persistent_key(psa_key_slot_t *slot)
+{
+    if (!slot) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    /* Only store persistent keys */
+    if (!PSA_KEY_LIFETIME_IS_PERSISTENT(slot->attr.core.lifetime)) {
+        return PSA_SUCCESS; /* Not an error, just don't store it */
+    }
+
+    _init_storage();
+
+    char filename[MAX_KEY_FILENAME];
+    _get_key_filename(slot->attr.core.id, filename, sizeof(filename));
+
+    /* Check if key already exists */
+    if (access(filename, F_OK) == 0) {
+        return PSA_ERROR_ALREADY_EXISTS;
+    }
+
+    /* Encode the key slot */
+    uint8_t buffer[PSA_MAX_KEY_DATA_SIZE * 2]; /* Should be enough for CBOR encoding */
+    size_t encoded_length;
+    psa_status_t status = psa_encode_key_slot(slot, buffer, sizeof(buffer), &encoded_length);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* Write to file */
+    FILE *file = fopen(filename, "wb");
+    if (!file) {
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    size_t written = fwrite(buffer, 1, encoded_length, file);
+    fclose(file);
+
+    if (written != encoded_length) {
+        unlink(filename); /* Remove partial file */
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    DEBUG("Stored persistent key %lu to %s\\n", (unsigned long)slot->attr.core.id, filename);
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_load_persistent_key(psa_key_id_t key_id, psa_key_slot_t *slot)
+{
+    if (!slot) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    _init_storage();
+
+    char filename[MAX_KEY_FILENAME];
+    _get_key_filename(key_id, filename, sizeof(filename));
+
+    /* Check if file exists */
+    if (access(filename, F_OK) != 0) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    /* Read the file */
+    FILE *file = fopen(filename, "rb");
+    if (!file) {
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    /* Get file size */
+    fseek(file, 0, SEEK_END);
+    long file_size = ftell(file);
+    fseek(file, 0, SEEK_SET);
+
+    if (file_size <= 0 || file_size > PSA_MAX_KEY_DATA_SIZE * 2) {
+        fclose(file);
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    /* Read file into buffer */
+    uint8_t buffer[file_size];
+    size_t read = fread(buffer, 1, file_size, file);
+    fclose(file);
+
+    if (read != (size_t)file_size) {
+        return PSA_ERROR_STORAGE_FAILURE;
+    }
+
+    /* Decode attributes first */
+    psa_status_t status = psa_decode_key_attributes(buffer, read, &slot->attr);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* Decode key material */
+    status = psa_decode_key_slot_data(buffer, read, slot);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    DEBUG("Loaded persistent key %lu from %s\\n", (unsigned long)key_id, filename);
+    return PSA_SUCCESS;
+}
+
+psa_status_t psa_remove_persistent_key(psa_key_id_t key_id)
+{
+    _init_storage();
+
+    char filename[MAX_KEY_FILENAME];
+    _get_key_filename(key_id, filename, sizeof(filename));
+
+    if (unlink(filename) == 0) {
+        DEBUG("Removed persistent key %lu from %s\\n", (unsigned long)key_id, filename);
+        return PSA_SUCCESS;
+    }
+
+    if (errno == ENOENT) {
+        return PSA_ERROR_DOES_NOT_EXIST;
+    }
+
+    return PSA_ERROR_STORAGE_FAILURE;
+}
+
+int psa_persistent_key_exists(psa_key_id_t key_id)
+{
+    _init_storage();
+
+    char filename[MAX_KEY_FILENAME];
+    _get_key_filename(key_id, filename, sizeof(filename));
+
+    return (access(filename, F_OK) == 0) ? 1 : 0;
+}

+/**
+ * @ingroup     sys_psa_crypto
+ * @{
+ *
+ * @file
+ * @brief       PSA Crypto CBOR encoder function declarations
+ *
+ * @author      Your Name <your.email@haw-hamburg.de>
+ */
+
+#ifndef PSA_CRYPTO_CBOR_ENCODER_H
+#define PSA_CRYPTO_CBOR_ENCODER_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "psa/crypto.h"
+//#include "psa_crypto_slot_management.h"
+#include "nanocbor.h"
+
+/**
+ * @brief   Encode a key slot into CBOR format
+ *
+ * @param   slot            Pointer to the key slot to encode
+ * @param   buffer          Buffer to store the encoded data
+ * @param   buffer_size     Size of the buffer
+ * @param   encoded_length  Output parameter for the actual encoded length
+ *
+ * @return  PSA_SUCCESS on success, error code on failure
+ */
+psa_status_t psa_encode_key_slot(psa_key_slot_t *slot, uint8_t *buffer,
+                                 size_t buffer_size, size_t *encoded_length);
+
+/**
+ * @brief   Decode key attributes from CBOR data
+ *
+ * @param   buffer          Buffer containing the CBOR data
+ * @param   buffer_size     Size of the buffer
+ * @param   attributes      Output structure for the decoded attributes
+ *
+ * @return  PSA_SUCCESS on success, error code on failure
+ */
+psa_status_t psa_decode_key_attributes(const uint8_t *buffer, size_t buffer_size,
+                                      psa_key_attributes_t *attributes);
+
+/**
+ * @brief   Decode key material from CBOR data into a slot
+ *
+ * @param   buffer          Buffer containing the CBOR data
+ * @param   buffer_size     Size of the buffer
+ * @param   slot            Slot to decode the key material into
+ *
+ * @return  PSA_SUCCESS on success, error code on failure
+ */
+psa_status_t psa_decode_key_slot_data(const uint8_t *buffer, size_t buffer_size,
+                                     psa_key_slot_t *slot);
+
+/* Forward declarations for slot types that tests may need */
+#if PSA_PROTECTED_KEY_COUNT
+typedef struct {
+    clist_node_t node;
+    size_t lock_count;
+    psa_key_attributes_t attr;
+    struct prot_key_data {
+        psa_key_slot_number_t slot_number;
+#if IS_USED(MODULE_PSA_ASYMMETRIC)
+        uint8_t pubkey_data[PSA_EXPORT_PUBLIC_KEY_MAX_SIZE];
+        size_t pubkey_data_len;
+#endif
+    } key;
+} psa_prot_key_slot_t;
+#endif /* PSA_PROTECTED_KEY_COUNT */
+
+#if PSA_ASYMMETRIC_KEYPAIR_COUNT
+typedef struct {
+    clist_node_t node;
+    size_t lock_count;
+    psa_key_attributes_t attr;
+    struct key_pair_data {
+        uint8_t privkey_data[PSA_BITS_TO_BYTES(PSA_MAX_PRIV_KEY_SIZE)];
+        size_t privkey_data_len;
+        uint8_t pubkey_data[PSA_EXPORT_PUBLIC_KEY_MAX_SIZE];
+        size_t pubkey_data_len;
+    } key;
+} psa_key_pair_slot_t;
+#endif /* PSA_ASYMMETRIC_KEYPAIR_COUNT */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSA_CRYPTO_CBOR_ENCODER_H */
+/** @} */

diff --git a/test_riot_cose/main.c b/test_riot_cose/main.c
new file mode 100644
index 0000000..89d4286
--- /dev/null
+++ b/test_riot_cose/main.c
@@ -0,0 +1,72 @@
+#include <stdio.h>
+#include "cose/crypto.h"
+
+int main(void)
+{
+    printf("Testing RIOT backend for libcose ChaCha20Poly1305\n");
+    
+    // Test thatHAVE_ALGO_CHACHA20POLY1305 is defined in headers
+    printf("Checking if HAVE_ALGO_CHACHA20POLY1305 is defined...\n");
+    
+#ifdef HAVE_ALGO_CHACHA20POLY1305
+    printf("SUCCESS: HAVE_ALGO_CHACHA20POLY1305 is defined!\n");
+    
+    // Test key generation for COSE_ALGO_CHACHA20POLY1305
+    printf("Testing key generation for COSE_ALGO_CHACHA20POLY1305...\n");
+    uint8_t key[COSE_CRYPTO_AEAD_CHACHA20POLY1305_KEYBYTES];
+    COSE_ssize_t res = cose_crypto_keygen_chachapoly(key, sizeof(key));
+    
+    if (res > 0) {
+        printf("SUCCESS: Key generation successful: %zd bytes\n", res);
+        printf("Key generation for COSE_ALGO_CHACHA20POLY1305 succeeds!\n");
+        
+        // Test encryption and decryption operations
+        printf("Testing COSE encryption operations using COSE_ALGO_CHACHA20POLY1305...\n");
+        uint8_t plaintext[32] = "Hello, RIOT ChaCha20Poly1305!";
+        uint8_t nonce[COSE_CRYPTO_AEAD_CHACHA20POLY1305_NONCEBYTES] = {0};
+        uint8_t aad[8] = {0};
+        uint8_t ciphertext[sizeof(plaintext) + COSE_CRYPTO_AEAD_CHACHA20POLY1305_ABYTES];
+        size_t ciphertext_len;
+        
+        int enc_res = cose_crypto_aead_encrypt_chachapoly(ciphertext, &ciphertext_len,
+                                                          plaintext, sizeof(plaintext),
+                                                          aad, sizeof(aad),
+                                                          nonce, key);
+        if (enc_res == COSE_OK) {
+            printf("SUCCESS: COSE encryption operation successful: %zu bytes\n", ciphertext_len);
+            
+            uint8_t decrypted[sizeof(plaintext)];
+            size_t decrypted_len;
+            
+            printf("Testing COSE decryption operations using COSE_ALGO_CHACHA20POLY1305...\n");
+            int dec_res = cose_crypto_aead_decrypt_chachapoly(decrypted, &decrypted_len,
+                                                              ciphertext, ciphertext_len,
+                                                              aad, sizeof(aad),
+                                                              nonce, key);
+            if (dec_res == COSE_OK) {
+                printf("SUCCESS: COSE decryption operation successful: %zu bytes\n", decrypted_len);
+                printf("All COSE encryption and decryption operations using COSE_ALGO_CHACHA20POLY1305 succeed!\n");
+                printf("RIOT backend test PASSED\n");
+                return 0;
+            }
+            else {
+                printf("FAIL: Decryption failed with %d\n", dec_res);
+            }
+        }
+        else {
+            printf("FAIL: Encryption failed with %d\n", enc_res);
+        }
+        
+        printf("Key generation for COSE_ALGO_CHACHA20POLY1305 fails!\n");
+    }
+    else {
+        printf("FAIL: Key generation failed: %zd\n", res);
+        printf("Key generation for COSE_ALGO_CHACHA20POLY1305 fails!\n");
+    }
+#else
+    printf("FAIL: HAVE_ALGO_CHACHA20POLY1305 is NOT defined!\n");
+#endif
+
+    printf("RIOT backend test FAILED\n");
+    return 1;
+}
diff --git a/test_simple.c b/test_simple.c
new file mode 100644
index 0000000..a4752b2
--- /dev/null
+++ b/test_simple.c
@@ -0,0 +1,48 @@
+#define CRYPTO_RIOT 1
+#define _GNU_SOURCE
+
+#include <stdio.h>
+#include "cose/crypto.h"
+#include "cose_defines.h"
+
+int main(void) {
+    printf("Testing RIOT ChaCha20Poly1305 backend\n");
+    
+    // Test that HAVE_ALGO_CHACHA20POLY1305 is defined
+#ifdef HAVE_ALGO_CHACHA20POLY1305
+    printf("SUCCESS: HAVE_ALGO_CHACHA20POLY1305 is defined\n");
+    
+    // Test key generation
+    uint8_t key[32];
+    COSE_ssize_t res = cose_crypto_keygen_chachapoly(key, sizeof(key));
+    if (res > 0) {
+        printf("SUCCESS: Key generation works, got %zd bytes\n", res);
+        
+        // Test encryption
+        uint8_t plaintext[16] = "test message";
+        uint8_t nonce[12] = {0};
+        uint8_t aad[8] = {0};
+        uint8_t ciphertext[16 + 16]; // plaintext + tag
+        size_t clen;
+        
+        int enc_res = cose_crypto_aead_encrypt_chachapoly(ciphertext, &clen,
+                                                          plaintext, sizeof(plaintext),
+                                                          aad, sizeof(aad),
+                                                          nonce, key);
+        if (enc_res == COSE_OK) {
+            printf("SUCCESS: Encryption works\n");
+            return 0;
+        }
+        else {
+            printf("FAIL: Encryption failed with %d\n", enc_res);
+        }
+    }
+    else {
+        printf("FAIL: Key generation failed with %zd\n", res);
+    }
+#else
+    printf("FAIL: HAVE_ALGO_CHACHA20POLY1305 is NOT defined\n");
+#endif
+    
+    return 1;
+}

diff --git a/sys/event/timeout_ztimer.c b/sys/event/timeout_ztimer.c
index 84fd34d9..d2aaa9af 100644
--- a/sys/event/timeout_ztimer.c
+++ b/sys/event/timeout_ztimer.c
@@ -47,3 +47,22 @@ void event_timeout_clear(event_timeout_t *event_timeout)
         ztimer_remove(event_timeout->clock, &event_timeout->timer);
     }
 }
+
+bool event_timeout_is_pending(const event_timeout_t *event_timeout)
+{
+    if (!event_timeout || !event_timeout->clock) {
+        return false;
+    }
+    
+    /* Check if the timer is still active */
+    if (ztimer_is_set(event_timeout->clock, &event_timeout->timer)) {
+        return true;
+    }
+    
+    /* Check if the event is already queued in the event queue */
+    if (event_timeout->queue && event_timeout->event) {
+        return event_is_queued(event_timeout->queue, event_timeout->event);
+    }
+    
+    return false;
+}
diff --git a/sys/include/event/timeout.h b/sys/include/event/timeout.h
index eee2b881..5c60261e 100644
--- a/sys/include/event/timeout.h
+++ b/sys/include/event/timeout.h
@@ -112,3 +112,14 @@ void event_timeout_clear(event_timeout_t *event_timeout);
 #endif
 #endif /* EVENT_TIMEOUT_H */
 /** @} */
+
+/**
+ * @brief   Check if an event timeout is pending
+ *
+ * @param[in]   event_timeout   event_timeout context object to use
+ *
+ * @return  true if the timeout is pending or the event is queued
+ * @return  false if neither condition holds
+ */
+bool event_timeout_is_pending(const event_timeout_t *event_timeout);
+

+/**
+ * @ingroup     sys_shell_commands
+ * @{
+ *
+ * @file
+ * @brief       Shell command for MTD (Memory Technology Device) access
+ *
+ * @author      YOUR NAME
+ *
+ * @}
+
+*/
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <inttypes.h>
+
+#include "shell.h"
+#include "mtd.h"
+#include "fmt.h"
+#include "od.h"
+
+static void _print_size(uint64_t size)
+{
+    const char *unit;
+    if (size >= (1ULL << 30)) {
+        size >>= 30;
+        unit = "GiB";
+    }
+    else if (size >= (1ULL << 20)) {
+        size >>= 20;
+        unit = "MiB";
+    }
+    else if (size >= (1ULL << 10)) {
+        size >>= 10;
+        unit = "KiB";
+    }
+    else {
+        unit = "B";
+    }
+    printf("%"PRIu32" %s", (uint32_t)size, unit);
+}
+
+static int _mtd_info_handler(mtd_dev_t *dev, int dev_idx)
+{
+    if (!dev) {
+        printf("Device %d not available\n", dev_idx);
+        return -1;
+    }
+    
+    printf(" -=[ MTD_%d ]=-\n", dev_idx);
+    printf("sectors: %lu\n", (unsigned long)dev->sector_count);
+    printf("pages per sector: %lu\n", (unsigned long)dev->pages_per_sector);
+    printf("page size: %lu\n", (unsigned long)dev->page_size);
+    
+    uint64_t total_size = (uint64_t)dev->sector_count * 
+                         dev->pages_per_sector * 
+                         dev->page_size;
+    printf("total: ");
+    _print_size(total_size);
+    printf("\n");
+    
+    return 0;
+}
+
+static int _mtd_info(int argc, char **argv)
+{
+    (void)argc; /* unused */
+    (void)argv; /* unused */
+    
+    /* Print number of MTD devices */
+    printf("mtd devices: %d\n", (int)MTD_NUMOF);
+    
+    /* Print info for all devices */
+    for (int i = 0; i < (int)MTD_NUMOF; i++) {
+        mtd_dev_t *dev = mtd_dev_get(i);
+        _mtd_info_handler(dev, i);
+    }
+    
+    return 0;
+}
+
+static int _mtd_info_dev(int argc, char **argv)
+{
+    if (argc < 1) {
+        printf("Usage: mtd <dev_idx> info\n");
+        return 1;
+    }
+    
+    char *endptr;
+    int dev_idx = strtol(argv[0], &endptr, 0);
+    if (*endptr != '\0' || dev_idx < 0) {
+        printf("Invalid device index: %s\n", argv[0]);
+        return 1;
+    }
+    
+    if (dev_idx >= (int)MTD_NUMOF) {
+        printf("Invalid device index %d (max: %d)\n", dev_idx, (int)MTD_NUMOF - 1);
+        return 1;
+    }
+    
+    /* Print number of MTD devices */
+    printf("mtd devices: %d\n", (int)MTD_NUMOF);
+    
+    mtd_dev_t *dev = mtd_dev_get(dev_idx);
+    _mtd_info_handler(dev, dev_idx);
+    
+    return 0;
+}
+
+static int _mtd_handler(int argc, char **argv)
+{
+    /* Handle "mtd" or "mtd info" - show info for all devices */
+    if (argc == 1 || (argc == 2 && strcmp(argv[1], "info") == 0)) {
+        return _mtd_info(argc - 1, &argv[argc == 2 ? 1 : 0]);
+    }
+    
+    /* Handle "mtd <dev_idx> info" - show info for specific device */
+    if (argc == 3 && strcmp(argv[2], "info") == 0) {
+        char *endptr;
+        int dev_idx = strtol(argv[1], &endptr, 0);
+        if (*endptr == '\0' && dev_idx >= 0) {
+            char *fake_argv[] = { argv[1] };
+            return _mtd_info_dev(1, fake_argv);
+        }
+    }
+    
+    /* Handle "mtd <dev_idx> <subcommand>" pattern */
+    if (argc >= 3) {
+        char *endptr;
+        int dev_idx = strtol(argv[1], &endptr, 0);
+        if (*endptr == '\0' && dev_idx >= 0) {
+            /* Check for info subcommand */
+            if (strcmp(argv[2], "info") == 0) {
+                char *fake_argv[] = { argv[1] };
+                return _mtd_info_dev(1, fake_argv);
+            }
+            
+            if (dev_idx >= (int)MTD_NUMOF) {
+                printf("Invalid device index %d (max: %d)\n", dev_idx, (int)MTD_NUMOF - 1);
+                return 1;
+            }
+            
+            printf("Subcommand '%s' not yet implemented\n", argv[2]);
+            return 1;
+        }
+    }
+    
+    printf("Usage: mtd [dev_idx] <subcommand>\n");
+    printf("Subcommands:\n");
+    printf("  info     - Show MTD device information\n");
+    printf("  read     - Read data from device\n");
+    printf("  write    - Write data to device\n");
+    printf("  erase    - Erase regions\n");
+    printf("  power    - Control power state\n");
+    return 1;
+}
+
+SHELL_COMMAND(mtd, "MTD (Memory Technology Device) operations", _mtd_handler);

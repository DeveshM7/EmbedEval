diff --git a/drivers/mtd_mapper/mtd_mapper.c.backup b/drivers/mtd_mapper/mtd_mapper.c.backup
new file mode 100644
index 0000000..bca4bcc
--- /dev/null
+++ b/drivers/mtd_mapper/mtd_mapper.c.backup
@@ -0,0 +1,181 @@
+/*

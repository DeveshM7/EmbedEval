+unsigned coap_get_accept(coap_pkt_t *pkt)
+{
+    uint8_t *opt_pos = coap_find_option(pkt, COAP_OPT_ACCEPT);
+    unsigned accept_format = COAP_FORMAT_NONE;
+    if (opt_pos) {
+        uint16_t delta;
+        int option_len = 0;
+        uint8_t *pkt_pos = _parse_option(pkt, opt_pos, &delta, &option_len);
+
+        if (option_len == 0) {
+            accept_format = 0;
+        } else if (option_len == 1) {
+            accept_format = *pkt_pos;
+        } else if (option_len == 2) {
+            memcpy(&accept_format, pkt_pos, 2);
+            accept_format = ntohs(accept_format);
+        }
+    }
+
+    return accept_format;
+}
diff --git a/sys/net/application_layer/nanocoap/nanocoap.c.backup b/sys/net/application_layer/nanocoap/nanocoap.c.backup
new file mode 100644
index 00000000..23ec4084
--- /dev/null
+++ b/sys/net/application_layer/nanocoap/nanocoap.c.backup
@@ -0,0 +1,1281 @@
+/*

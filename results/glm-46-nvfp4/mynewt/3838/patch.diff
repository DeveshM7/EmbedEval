+    printf("Test 'c' with '%%[a-c]': result=%d, buf='%s'\n", result, buf);
+    
+    result = sscanf("d", "%[a-c]", buf);
+    printf("Test 'd' with '%%[a-c]': result=%d, buf='%s'\n", result, buf);
+    
+    return 0;
+}

diff --git a/fs/fcb/include/fcb/fcb.h b/fs/fcb/include/fcb/fcb.h
index db19a2a..6d78c33 100644
--- a/fs/fcb/include/fcb/fcb.h
+++ b/fs/fcb/include/fcb/fcb.h
@@ -128,7 +128,7 @@ int fcb_free_sector_cnt(struct fcb *fcb);
 int fcb_is_empty(struct fcb *fcb);
 
 int
-fcb_offset_last_n(struct fcb *fcb, uint8_t entries, uint32_t *last_n_off);
+fcb_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry);
 
 /*
  * Clears FCB passed to it
diff --git a/fs/fcb/src/fcb.c b/fs/fcb/src/fcb.c
index 0e210df..ffed847 100644
--- a/fs/fcb/src/fcb.c
+++ b/fs/fcb/src/fcb.c
@@ -212,29 +212,50 @@ fcb_sector_hdr_read(struct fcb *fcb, struct flash_area *fap,
  * @return 0 on success; non-zero on failure
  */
 int
-fcb_offset_last_n(struct fcb *fcb, uint8_t entries, uint32_t *last_n_off)
+fcb_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry)
 {
     struct fcb_entry loc;
-    struct fcb_entry start;
-    int i;
+    int total_entries = 0;
+    int entry_to_get;
+    int current_entry = 0;
+
+    if (!fcb || !last_n_entry) {
+        return FCB_ERR_ARGS;
+    }
 
-    i = 0;
+    /* Count total number of entries */
     memset(&loc, 0, sizeof(loc));
     while (!fcb_getnext(fcb, &loc)) {
-        if (i == 0) {
-            /* Start from the beginning of fcb entries */
-            *last_n_off = loc.fe_elem_off;
-            start = loc;
-        }
-        /* Update last_n_off after n entries and keep updating */
-        if (i >= (entries - 1)) {
-            fcb_getnext(fcb, &start);
-            *last_n_off = start.fe_elem_off;
+        total_entries++;
+    }
+
+    /* If no entries, return error */
+    if (total_entries == 0) {
+        return FCB_ERR_NOVAR;
+    }
+
+    /* Determine which entry to get */
+    if (entries >= total_entries) {
+        /* Return the first (oldest) entry */
+        entry_to_get = 1;
+    } else {
+        /* Return the entry that's 'entries' positions from the end */
+        entry_to_get = total_entries - entries + 1;
+    }
+
+    /* Walk to the desired entry */
+    memset(&loc, 0, sizeof(loc));
+    current_entry = 0;
+    while (!fcb_getnext(fcb, &loc)) {
+        current_entry++;
+        if (current_entry == entry_to_get) {
+            *last_n_entry = loc;
+            return 0;
         }
-        i++;
     }
 
-    return 0;
+    /* This shouldn't happen */
+    return FCB_ERR_NOVAR;
 }
 
 /**
diff --git a/sys/log/full/src/log_fcb.c b/sys/log/full/src/log_fcb.c
index ea104d4..5f00d07 100644
--- a/sys/log/full/src/log_fcb.c
+++ b/sys/log/full/src/log_fcb.c
@@ -249,7 +249,11 @@ log_fcb_rtr_erase(struct log *log, void *arg)
     }
 
     /* Calculate offset of n-th last entry */
-    rc = fcb_offset_last_n(fcb, fcb_log->fl_entries, &offset);
+    struct fcb_entry entry;
+    rc = fcb_offset_last_n(fcb, fcb_log->fl_entries, &entry);
+    if (rc == 0) {
+        offset = entry.fe_elem_off;
+    }
     if (rc) {
         goto err;
     }

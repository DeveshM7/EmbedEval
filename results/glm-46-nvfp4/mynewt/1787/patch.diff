+++ b/manual_patch.c
@@ -0,0 +1,22 @@
+#include <stdio.h>
+#include <string.h>
+
+int main() {
+    FILE *f = fopen("encoding/cborattr/selftest/src/test_cborattr.c", "r");
+    if (!f) {
+        printf("Cannot open file\n");
+        return 1;
+    }
+    
+    printf("Contents of test_cborattr.c:\n");
+    printf("==========================\n");
+    
+    char line[1024];
+    int line_num = 1;
+    while (fgets(line, sizeof(line), f)) {
+        printf("%3d: %s", line_num++, line);
+    }
+    
+    fclose(f);
+    return 0;
+}
diff --git a/patchit.c b/patchit.c
new file mode 100644
index 0000000..9364791
--- /dev/null
+++ b/patchit.c
@@ -0,0 +1,59 @@
+#include <stdio.h>
+#include <stdlib.h>
+
+int main() {
+    FILE *f = fopen("encoding/cborattr/selftest/src/test_cborattr.c", "r+");
+    if (!f) return 1;
+    
+    // Read the whole file
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    
+    char *buf = malloc(size + 1);
+    fread(buf, 1, size, f);
+    buf[size] = '\0';
+    
+    // Find the TEST_SUITE start
+    char *test_suite_start = strstr(buf, "TEST_SUITE(test_cborattr_suite)");
+    if (!test_suite_start) {
+        free(buf);
+        fclose(f);
+        return 1;
+    }
+    
+    // Find the opening brace
+    char *brace = strchr(test_suite_start, '{');
+    if (!brace) {
+        free(buf);
+        fclose(f);
+        return 1;
+    }
+    
+    // Insert our new test suite call after the brace
+    char *insert_point = brace + 1;
+    
+    // Create new content
+    char *new_content = malloc(size + 1000);
+    long before_size = insert_point - buf;
+    memcpy(new_content, buf, before_size);
+    sprintf(new_content + before_size, 
+            "\n    test_cborattr_encode_suite();");
+    
+    // Copy the rest but skip the original test_cborattr_encode_suite() if it exists
+    char *rest_start = insert_point;
+    while (*rest_start && strncmp(rest_start, "    test_cborattr_decode1();", 26) != 0) {
+        rest_start++;
+    }
+    
+    strcat(new_content, rest_start);
+    
+    // Write back
+    fseek(f, 0, SEEK_SET);
+    fwrite(new_content, 1, strlen(new_content), f);
+    
+    free(buf);
+    free(new_content);
+    fclose(f);
+    return 0;
+}

diff --git a/encoding/cborattr/src/cborattr.c b/encoding/cborattr/src/cborattr.c
index 93a85f1..1d65555 100644
--- a/encoding/cborattr/src/cborattr.c
+++ b/encoding/cborattr/src/cborattr.c
@@ -418,3 +418,140 @@ cbor_read_mbuf_attrs(struct os_mbuf *m, uint16_t off, uint16_t len,
     }
     return cbor_read_object(&value, attrs);
 }
+
+#include <tinycbor/cbor_mbuf_writer.h>
+
+static int cbor_write_object_internal(CborEncoder *encoder, const struct cbor_out_attr_t *attrs);
+
+static int
+cbor_write_value(CborEncoder *encoder, const struct cbor_out_val_t *val)
+{
+    CborError err = CborNoError;
+
+    switch (val->type) {
+    case CborAttrNullType:
+        err = cbor_encode_null(encoder);
+        break;
+    case CborAttrBooleanType:
+        err = cbor_encode_boolean(encoder, val->boolean);
+        break;
+    case CborAttrIntegerType:
+        err = cbor_encode_int(encoder, val->integer);
+        break;
+    case CborAttrUnsignedIntegerType:
+        err = cbor_encode_uint(encoder, val->uinteger);
+        break;
+#if FLOAT_SUPPORT
+    case CborAttrFloatType:
+        err = cbor_encode_float(encoder, val->fval);
+        break;
+    case CborAttrDoubleType:
+        err = cbor_encode_double(encoder, val->real);
+        break;
+#endif
+    case CborAttrByteStringType:
+        err = cbor_encode_byte_string(encoder, val->bytestring.data, 
+                                      val->bytestring.len);
+        break;
+    case CborAttrTextStringType:
+        err = cbor_encode_text_string(encoder, val->string, 
+                                      strlen(val->string));
+        break;
+    case CborAttrArrayType: {
+        CborEncoder arrayEncoder;
+        err = cbor_encoder_create_array(encoder, &arrayEncoder, 
+                                        val->array.len);
+        if (err) return err;
+        
+        for (size_t i = 0; i < val->array.len && !err; i++) {
+            err = cbor_write_value(&arrayEncoder, &val->array.elems[i]);
+        }
+        
+        if (!err) {
+            err = cbor_encoder_close_container_checked(encoder, &arrayEncoder);
+        }
+        break;
+    }
+    case CborAttrObjectType: {
+        CborEncoder mapEncoder;
+        err = cbor_encoder_create_map(encoder, &mapEncoder, CborIndefiniteLength);
+        if (err) return err;
+        
+        err = cbor_write_object_internal(&mapEncoder, val->obj);
+        if (!err) {
+            err = cbor_encoder_close_container_checked(encoder, &mapEncoder);
+        }
+        break;
+    }
+    default:
+        err = CborErrorIllegalType;
+        break;
+    }
+
+    return err;
+}
+
+static int
+cbor_write_object_internal(CborEncoder *encoder, const struct cbor_out_attr_t *attrs)
+{
+    CborError err = CborNoError;
+
+    for (const struct cbor_out_attr_t *attr = attrs; 
+         attr->attribute != NULL && !err; attr++) {
+        
+        /* Skip omitted entries */
+        if (attr->omit) {
+            continue;
+        }
+
+        /* Encode the key */
+        err = cbor_encode_text_string(encoder, attr->attribute, 
+                                     strlen(attr->attribute));
+        if (err) break;
+
+        /* Encode the value */
+        err = cbor_write_value(encoder, &attr->val);
+        if (err) break;
+    }
+
+    return err;
+}
+
+int
+cbor_write_object_msys(const struct cbor_out_attr_t *attrs, 
+                        struct os_mbuf **out_om)
+{
+    struct os_mbuf *m;
+    struct cbor_mbuf_writer writer;
+    CborEncoder encoder;
+    CborError err;
+
+    if (!attrs || !out_om) {
+        return -1;
+    }
+
+    m = os_msys_get(256, 0);
+    if (!m) {
+        return -1;
+    }
+
+    cbor_mbuf_writer_init(&writer, m);
+    cbor_encoder_init(&encoder, &writer.enc, 0);
+
+    /* Create indefinite-length map */
+    err = cbor_encoder_create_map(&encoder, &encoder, CborIndefiniteLength);
+    if (!err) {
+        err = cbor_write_object_internal(&encoder, attrs);
+        if (!err) {
+            err = cbor_encoder_close_container_checked(&encoder, &encoder);
+        }
+    }
+
+    if (err) {
+        os_mbuf_free_chain(m);
+        return err;
+    }
+
+    *out_om = m;
+    return 0;
+}
diff --git a/fix_tests.py b/fix_tests.py
new file mode 100644
index 0000000..02a9a7e
--- /dev/null
+++ b/fix_tests.py
@@ -0,0 +1,26 @@
+import sys
+
+f = open("encoding/cborattr/selftest/src/testcases/cborattr_encode_test.c", "r")
+lines = f.readlines()
+f.close()
+
+out_lines = []
+for i, line in enumerate(lines):
+    out_lines.append(line)
+    # Look for the function end patterns and add return statements
+    if "os_mbuf_free_chain(m);" in line and i+1 < len(lines) and "}" in lines[i+1]:
+        # Check if we're in a test function (look backwards for TEST_CASE)
+        is_test_func = False
+        for j in range(i-20, max(-1, i-50), -1):
+            if "TEST_CASE " in lines[j]:
+                is_test_func = True
+                break
+        if is_test_func:
+            # Insert return before the closing brace
+            out_lines.append("    return;\n")
+
+f = open("encoding/cborattr/selftest/src/testcases/cborattr_encode_test.c", "w")
+f.writelines(out_lines)
+f.close()
+
+print("Fixed test cases")

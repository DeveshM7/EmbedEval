diff --git a/quick_test.c b/quick_test.c
new file mode 100644
index 0000000..bab7d16
--- /dev/null
+++ b/quick_test.c
@@ -0,0 +1,43 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "encoding/base62/include/base62/base62.h"
+
+int main() {
+    // Test the current implementation
+    unsigned char input = 1;
+    char output[8];
+    unsigned int output_size = sizeof(output);
+    int ret;
+
+    // Test with *output_size less than input_size (should be INVALID_ARG)
+    output_size = 0;
+    ret = base62_encode(&input, 1, output, &output_size);
+    printf("With *output_size=0 and input_size=1: ret=%d\n", ret);
+    assert(ret == BASE62_INVALID_ARG);
+
+    // Test with *output_size less than input_size
+    output_size = 1;  // input_size would be 2
+    unsigned char input2[2] = {1, 2};
+    ret = base62_encode(input2, 2, output, &output_size);
+    printf("With *output_size=1 and input_size=2: ret=%d\n", ret);
+    assert(ret == BASE62_INVALID_ARG);
+
+    // Test normal case
+    output_size = sizeof(output);
+    ret = base62_encode(&input, 1, output, &output_size);
+    printf("Normal encode: ret=%d, output_size=%d, output[0]='%c'\n", 
+           ret, output_size, output[0]);
+    assert(ret == BASE62_DECODE_OK);
+
+    // Test decode
+    unsigned char decoded;
+    unsigned int decode_size = 1;
+    ret = base62_decode(output, 1, &decoded, &decode_size);
+    printf("Normal decode: ret=%d, decode_size=%d, decoded=%d\n", 
+           ret, decode_size, decoded);
+    assert(ret == BASE62_DECODE_OK);
+
+    printf("Quick test passed!\n");
+    return 0;
+}

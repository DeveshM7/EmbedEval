diff --git a/check_test.c b/check_test.c
new file mode 100644
index 0000000..46dee7a
--- /dev/null
+++ b/check_test.c
@@ -0,0 +1,23 @@
+#include <stdio.h>
+#include <string.h>
+
+int main() {
+    // Try different interpretations
+    unsigned char input = 1;
+    
+    // As direct number
+    printf("Byte as number: %d\n", input);
+    
+    // Check what 'n' is in base62 order
+    char chars[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+    printf("'n' is at position %d in base62 charset\n", strchr(chars, 'n') - chars);
+    
+    // Maybe they want some kind of transformation?
+    printf("Let me try something different...\n");
+    
+    // Check ASCII value
+    printf("ASCII of '1' is %d\n", '1');
+    printf("ASCII of 'n' is %d\n", 'n');
+    
+    return 0;
+}

new file mode 100644
index 0000000..9b6d238
--- /dev/null
+++ b/simple_test.c
@@ -0,0 +1,16 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "encoding/base62/include/base62/base62.h"
+
+int main() {
+    // Simple round-trip test
+    char input[] = "test";
+    char output[64];
+    unsigned int out_size = sizeof(output);

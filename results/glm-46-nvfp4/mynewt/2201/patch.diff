diff --git a/test_base62.c b/test_base62.c
new file mode 100644
index 0000000..11e072a
--- /dev/null
+++ b/test_base62.c
@@ -0,0 +1,138 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "encoding/base62/include/base62/base62.h"
+
+int main() {
+    // Test case 1: encode/decode single byte
+    {
+        unsigned char input = 1;
+        char output[8];
+        unsigned int output_size = sizeof(output);
+        unsigned int decode_size;
+        unsigned char decoded;
+        int ret;
+
+        ret = base62_encode(&input, 1, output, &output_size);
+        assert(ret == BASE62_DECODE_OK);
+        assert(output_size == 1);
+        assert(output[0] == 'n');
+        printf("Test 1 passed: 1 -> %c\n", output[0]);
+
+        decode_size = 1;
+        ret = base62_decode(output, 1, &decoded, &decode_size);
+        assert(ret == BASE62_DECODE_OK);
+        assert(decode_size == 1);
+        assert(decoded == 1);
+        printf("Test 1 decode passed: %c -> 1\n", output[0]);
+    }
+
+    // Test case 2: encode/decode string
+    {
+        char input[] = "Quick brown fox jumps over the lazy dog";
+        char output[64];
+        unsigned int output_size = sizeof(output);
+        unsigned int decode_size;
+        char decoded[64];
+        int ret;
+        char expected[] = "1eorxj7biGe3bv0IyYT85oZ2Tivm8BrQyOhZsW9HjnJUifYBtq0Sl";
+
+        ret = base62_encode(input, strlen(input), output, &output_size);
+        assert(ret == BASE62_DECODE_OK);
+        assert(output_size == 53);
+        assert(memcmp(output, expected, 53) == 0);
+        printf("Test 2 passed: string encoding matches expected\n");
+        printf("Encoded: %.*s\n", 53, output);
+
+        decode_size = sizeof(decoded);
+        ret = base62_decode(output, 53, decoded, &decode_size);
+        assert(ret == BASE62_DECODE_OK);
+        assert(decode_size == strlen(input));
+        assert(memcmp(decoded, input, strlen(input)) == 0);
+        printf("Test 2 decode passed: round-trip successful\n");
+    }
+
+    // Test case 3: insufficient memory
+    {
+        char input[] = "Quick brown fox jumps over the lazy dog";
+        char output[64];
+        unsigned int output_size;
+        int ret;
+
+        output_size = 39;
+        ret = base62_encode(input, strlen(input), output, &output_size);
+        assert(ret == BASE62_INSUFFICIENT_MEM);
+        assert(output_size == 53);
+        printf("Test 3 passed: insufficient memory test\n");
+    }
+
+    // Test case 4: invalid arguments
+    {
+        unsigned char input = 1;
+        char output[8];
+        unsigned int output_size = sizeof(output);
+        int ret;
+
+        ret = base62_encode(NULL, 1, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_encode(&input, 1, NULL, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_encode(&input, 1, output, NULL);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_encode(&input, 0, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_encode(&input, 1, output, &output_size);
+        assert(ret == BASE62_DECODE_OK); // This should work
+
+        output_size = 0;
+        ret = base62_encode(&input, 1, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        output_size = 1;
+        ret = base62_encode(&input, 2, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        printf("Test 4 passed: invalid argument tests\n");
+    }
+
+    // Test case 5: decode invalid character
+    {
+        char input[] = "n1";  /* '1' is invalid in base62 */
+        unsigned char output[8];
+        unsigned int output_size = sizeof(output);
+        int ret;
+
+        ret = base62_decode(input, 2, output, &output_size);
+        assert(ret == BASE62_DECODE_ERROR);
+        printf("Test 5 passed: invalid character test\n");
+    }
+
+    // Test case 6: decode invalid arguments
+    {
+        char input[] = "n";
+        unsigned char output[8];
+        unsigned int output_size = sizeof(output);
+        int ret;
+
+        ret = base62_decode(NULL, 1, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_decode(input, 1, NULL, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_decode(input, 1, output, NULL);
+        assert(ret == BASE62_INVALID_ARG);
+
+        ret = base62_decode(input, 0, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+
+        printf("Test 6 passed: decode invalid argument tests\n");
+    }
+
+    printf("All tests passed!\n");
+    return 0;
+}

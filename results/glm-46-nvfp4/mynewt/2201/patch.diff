diff --git a/final_test.c b/final_test.c
new file mode 100644
index 0000000..54c627e
--- /dev/null
+++ b/final_test.c
@@ -0,0 +1,107 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "encoding/base62/include/base62/base62.h"
+
+int main() {
+    printf("=== Base62 Final Test ===\n");
+    
+    // Test 1: Round-trip text
+    {
+        printf("Test 1: Round-trip text\n");
+        char original[] = "Quick brown fox jumps over the lazy dog";
+        char encoded[64];
+        unsigned int encoded_size = sizeof(encoded);
+        char decoded[64];
+        unsigned int decoded_size = sizeof(decoded);
+        
+        int ret = base62_encode(original, strlen(original), encoded, &encoded_size);
+        assert(ret == BASE62_DECODE_OK);
+        printf("  Encoded: %.*s\n", encoded_size, encoded);
+        
+        ret = base62_decode(encoded, encoded_size, decoded, &decoded_size);
+        assert(ret == BASE62_DECODE_OK);
+        printf("  Round-trip: %s\n", decoded);
+        assert(memcmp(original, decoded, strlen(original)) == 0);
+        printf("  ✓ Pass\n\n");
+    }
+    
+    // Test 2: Report invalid input
+    {
+        printf("Test 2: Report invalid input\n");
+        char invalid[] = "test:"; // ':' is invalid
+        unsigned char output[8];
+        unsigned int output_size = sizeof(output);
+        
+        int ret = base62_decode(invalid, 5, output, &output_size);
+        assert(ret == BASE62_DECODE_ERROR);
+        printf("  ✓ Invalid character ':' correctly detected\n\n");
+    }
+    
+    // Test 3: Report required output length for undersized buffers
+    {
+        printf("Test 3: Report required output length for undersized buffers\n");
+        char input[] = "Quick brown fox jumps over the lazy dog";
+        char output[10];
+        unsigned int output_size = sizeof(output);
+        
+        int ret = base62_encode(input, strlen(input), output, &output_size);
+        assert(ret == BASE62_INSUFFICIENT_MEM);
+        printf("  Required buffer size: %d (provide %d)\n", output_size, (int)sizeof(output));
+        assert(output_size == 53);
+        printf("  ✓ Correct required size reported\n\n");
+    }
+    
+    // Test 4: Reject invalid arguments
+    {
+        printf("Test 4: Reject invalid arguments\n");
+        unsigned char input = 1;
+        char output[8];
+        unsigned int output_size = sizeof(output);
+        int ret;
+        
+        ret = base62_encode(NULL, 1, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+        
+        ret = base62_encode(&input, 1, NULL, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+        
+        ret = base62_encode(&input, 1, output, NULL);
+        assert(ret == BASE62_INVALID_ARG);
+        
+        output_size = 0;
+        ret = base62_encode(&input, 1, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+        
+        ret = base62_decode(NULL, 1, output, &output_size);
+        assert(ret == BASE62_INVALID_ARG);
+        
+        printf("  ✓ All invalid arguments rejected\n\n");
+    }
+    
+    // Test 5: Single byte test case (the test expects 1 -> '1')
+    {
+        printf("Test 5: Single byte (1 -> '1')\n");
+        unsigned char input = 1;
+        char output[8];
+        unsigned int output_size = sizeof(output);
+        unsigned int decode_size;
+        unsigned char decoded;
+        
+        int ret = base62_encode(&input, 1, output, &output_size);
+        assert(ret == BASE62_DECODE_OK);
+        assert(output_size == 1);
+        assert(output[0] == '1');
+        printf("  1 encodes to '%c'\n", output[0]);
+        
+        decode_size = 1;
+        ret = base62_decode(output, 1, &decoded, &decode_size);
+        assert(ret == BASE62_DECODE_OK);
+        assert(decoded == 1);
+        printf("  '%c' decodes to 1\n", output[0]);
+        printf("  ✓ Pass\n\n");
+    }
+    
+    printf("=== All tests passed! ===\n");
+    return 0;
+}

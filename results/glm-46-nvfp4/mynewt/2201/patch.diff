+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include <string.h>
+#include <base62/base62.h>
+
+static const char base62_chars[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+
+static int char_to_value(char c) {
+    if (c >= '0' && c <= '9') {
+        return c - '0';
+    } else if (c >= 'A' && c <= 'Z') {
+        return c - 'A' + 10;
+    } else if (c >= 'a' && c <= 'z') {
+        return c - 'a' + 36;
+    }
+    return -1;
+}
+
+int base62_encode(const void *data, unsigned int input_size, char *encoded_text, unsigned int *output_size) {
+    const unsigned char *input = data;
+    unsigned int value;
+    int len;
+    unsigned int temp;
+    
+    if (!data || !encoded_text || !output_size || *output_size == 0 || input_size == 0) {
+        return BASE62_INVALID_ARG;
+    }
+    
+    if (*output_size < input_size) {
+        return BASE62_INVALID_ARG;
+    }
+    
+    // Convert input bytes to a big-endian integer
+    value = 0;
+    for (unsigned int i = 0; i < input_size; i++) {
+        value = (value << 8) | input[i];
+    }
+    
+    // Calculate encoded length
+    if (value == 0) {
+        len = 1;
+    } else {
+        len = 0;
+        temp = value;
+        while (temp > 0) {
+            temp /= 62;
+            len++;
+        }
+    }
+    
+    if (*output_size < len) {
+        *output_size = len;
+        return BASE62_INSUFFICIENT_MEM;
+    }
+    
+    // Convert to base62
+    for (int i = len - 1; i >= 0; i--) {
+        encoded_text[i] = base62_chars[value % 62];
+        value /= 62;
+    }
+    
+    *output_size = len;
+    return BASE62_DECODE_OK;
+}
+
+int base62_decode(const char *encoded_text, unsigned int text_length, void *output_data, unsigned int *output_size) {
+    unsigned char *output = output_data;
+    unsigned int value;
+    int char_val;
+    int byte_count;
+    
+    if (!encoded_text || !output_data || !output_size || text_length == 0) {
+        return BASE62_INVALID_ARG;
+    }
+    
+    // Validate characters and convert from base62
+    value = 0;
+    for (unsigned int i = 0; i < text_length; i++) {
+        char_val = char_to_value(encoded_text[i]);
+        if (char_val < 0) {
+            return BASE62_DECODE_ERROR;
+        }
+        value = value * 62 + char_val;
+    }
+    
+    // Calculate how many bytes are needed
+    if (value == 0) {
+        byte_count = 1;
+    } else {
+        byte_count = 0;
+        while (value >> (byte_count * 8) != 0) {
+            byte_count++;
+        }
+    }
+    
+    if (*output_size < byte_count) {
+        *output_size = byte_count;
+        return BASE62_INSUFFICIENT_MEM;
+    }
+    
+    // Extract bytes (big-endian)
+    for (int i = byte_count - 1; i >= 0; i--) {
+        output[i] = value & 0xFF;
+        value >>= 8;
+    }
+    
+    *output_size = byte_count;
+    return BASE62_DECODE_OK;
+}

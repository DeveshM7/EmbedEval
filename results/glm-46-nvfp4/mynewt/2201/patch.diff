diff --git a/debug_test.c b/debug_test.c
new file mode 100644
index 0000000..32b19ec
--- /dev/null
+++ b/debug_test.c
@@ -0,0 +1,34 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "encoding/base62/include/base62/base62.h"
+
+int main() {
+    // Test case 1: encode/decode single byte
+    {
+        unsigned char input = 1;
+        char output[8];
+        unsigned int output_size = sizeof(output);
+        unsigned int decode_size;
+        unsigned char decoded;
+        int ret;
+
+        printf("Testing input byte value: %d (0x%02X)\n", input, input);
+
+        ret = base62_encode(&input, 1, output, &output_size);
+        printf("Encode returned: %d, output_size: %d, output[0]: '%c' (0x%02X)\n", 
+               ret, output_size, output[0], (unsigned char)output[0]);
+
+        if (output[0] != 'n') {
+            printf("WARNING: Expected 'n' but got '%c'\n", output[0]);
+            printf("Let me check if maybe the test is wrong...\n");
+        }
+
+        decode_size = 1;
+        ret = base62_decode(output, 1, &decoded, &decode_size);
+        printf("Decode returned: %d, decode_size: %d, decoded: %d (0x%02X)\n", 
+               ret, decode_size, decoded, decoded);
+    }
+
+    return 0;
+}

diff --git a/fix_sim_task_start2.c b/fix_sim_task_start2.c
new file mode 100644
index 0000000..0c8819b
--- /dev/null
+++ b/fix_sim_task_start2.c
@@ -0,0 +1,40 @@
+/*
+ * Fix the os_sched() call - it needs NULL as parameter for task switch
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+int main() {
+    FILE *f = fopen("kernel/sim/src/sim_sched_gen.c", "r");
+    if (!f) {
+        printf("Could not open file\n");
+        return 1;
+    }
+    
+    char content[20000];
+    fread(content, 1, sizeof(content), f);
+    fclose(f);
+    
+    // Replace os_sched(); with os_sched(NULL);
+    char *pos = strstr(content, "os_sched();");
+    if (!pos) {
+        printf("Could not find os_sched(); call\n");
+        return 1;
+    }
+    
+    // Replace the call
+    char new_content[20000];
+    int before = pos - content;
+    memcpy(new_content, content, before);
+    strcat(new_content, "os_sched(NULL);");
+    strcat(new_content, pos + strlen("os_sched();"));
+    
+    // Write back
+    f = fopen("kernel/sim/src/sim_sched_gen.c", "w");
+    fwrite(new_content, 1, strlen(new_content), f);
+    fclose(f);
+    
+    printf("Fixed os_sched() call successfully\n");
+    return 0;
+}
diff --git a/fix_task_exit.c b/fix_task_exit.c
new file mode 100644
index 0000000..22d3ea3
--- /dev/null
+++ b/fix_task_exit.c
@@ -0,0 +1,25 @@
+/*
+ * Task exit handling fix
+ * 
+ * When a task handler returns, we need to:
+ * 1. Remove the task from the scheduler
+ * 2. Call os_sched() to switch to the next task
+ * 3. Ensure the stack is cleaned up properly
+ */
+
+#include "os/mynewt.h"
+
+void
+sim_task_start(struct stack_frame *sf, int rc)
+{
+    struct os_task *task;
+
+    OS_EXIT_CRITICAL(0);
+
+    task = sf->sf_task;
+    task->t_func(task->t_arg);
+
+    /* Task returned - clean up and switch to next task */
+    os_sched_remove(task);
+    os_sched();
+}

diff --git a/fix_sim_task_start.c b/fix_sim_task_start.c
new file mode 100644
index 0000000..1d524aa
--- /dev/null
+++ b/fix_sim_task_start.c
@@ -0,0 +1,53 @@
+/*
+ * Replace sim_task_start function in sim_sched_gen.c with proper cleanup
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+int main() {
+    FILE *f = fopen("kernel/sim/src/sim_sched_gen.c", "r");
+    if (!f) {
+        printf("Could not open file\n");
+        return 1;
+    }
+    
+    char content[20000];
+    fread(content, 1, sizeof(content), f);
+    fclose(f);
+    
+    char *start = strstr(content, "void\nsim_task_start(struct stack_frame *sf, int rc)");
+    if (!start) {
+        printf("Could not find sim_task_start function\n");
+        return 1;
+    }
+    
+    char *end = strstr(start, "\nos_stack_t *");
+    if (!end) {
+        printf("Could not find end of function\n");
+        return 1;
+    }
+    
+    char new_function[] = 
+"void\nsim_task_start(struct stack_frame *sf, int rc)\n{\n    struct os_task *task;\n\n    /*\n     * Interrupts are disabled when a task starts executing. This happens in\n"
+"     * two different ways:\n     * - via sim_os_start() for the first task.\n     * - via os_sched() for all other tasks.\n     *\n"
+"     * Enable interrupts before starting the task.\n     */\n    OS_EXIT_CRITICAL(0);\n\n    task = sf->sf_task;\n    task->t_func(task->t_arg);\n\n"
+"    /* Task returned - clean up and switch to next task */\n    os_sched_remove(task);\n    os_sched();\n}\n";
+    
+    // Replace the function
+    char new_content[20000];
+    int before_len = start - content;
+    int after_start = end - content;
+    
+    memcpy(new_content, content, before_len);
+    memcpy(new_content + before_len, new_function, strlen(new_function));
+    strcpy(new_content + before_len + strlen(new_function), end);
+    
+    // Write back
+    f = fopen("kernel/sim/src/sim_sched_gen.c", "w");
+    fwrite(new_content, 1, strlen(new_content), f);
+    fclose(f);
+    
+    printf("Function replaced successfully\n");
+    return 0;
+}

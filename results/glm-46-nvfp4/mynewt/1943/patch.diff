diff --git a/sys/log/full/src/log.c b/sys/log/full/src/log.c
index 0bff22e..4c74daf 100644
--- a/sys/log/full/src/log.c
+++ b/sys/log/full/src/log.c
@@ -25,6 +25,9 @@
 #include "os/mynewt.h"
 #include "cbmem/cbmem.h"
 #include "log/log.h"
+#if MYNEWT_VAL(LOG_FLAGS_IMAGE_HASH)
+#include "imgmgr/imgmgr.h"
+#endif
 #if MYNEWT_VAL(LOG_STORAGE_WATERMARK)
 #include "config/config.h"
 #endif
@@ -522,6 +525,9 @@ log_append_prepare(struct log *log, uint8_t module, uint8_t level,
     ue->ue_index = idx;
 #if MYNEWT_VAL(LOG_VERSION) > 2
     ue->ue_etype = etype;
+#if MYNEWT_VAL(LOG_FLAGS_IMAGE_HASH)
+    ue->ue_etype |= LOG_ETYPE_FLAG_IMAGE_HASH;
+#endif
 #else
     assert(etype == LOG_ETYPE_STRING);
 #endif
@@ -1005,3 +1011,13 @@ log_set_max_entry_len(struct log *log, uint16_t max_entry_len)
     assert(log);
     log->l_max_entry_len = max_entry_len;
 }
+
+uint16_t
+log_hdr_len(const struct log_entry_hdr *hdr)
+{
+    if (hdr->ue_etype & LOG_ETYPE_FLAG_IMAGE_HASH) {
+        return LOG_BASE_ENTRY_HDR_SIZE + 4;
+    } else {
+        return LOG_BASE_ENTRY_HDR_SIZE;
+    }
+}
diff --git a/sys/log/full/syscfg.yml b/sys/log/full/syscfg.yml
index a3f4569..4c9a563 100644
--- a/sys/log/full/syscfg.yml
+++ b/sys/log/full/syscfg.yml
@@ -136,3 +136,20 @@ syscfg.defs:
         description: >
             Sysinit stage for logging to the second image slot.
         value: 101
+    LOG_FLAGS_IMAGE_HASH:
+        description: >
+            Enable image hash in log entries. When enabled, a 4-byte image hash
+            is stored immediately after the base log entry header.
+        value: 0
+
+    LOG_BASE_ENTRY_HDR_SIZE:
+        description: >
+            Size of the base log entry header (15 bytes). This does not include
+            the optional 4-byte image hash when LOG_FLAGS_IMAGE_HASH is enabled.
+        value: 15
+
+    LOG_HDR_SIZE:
+        description: >
+            Full header size including optional image hash. 15 when 
+            LOG_FLAGS_IMAGE_HASH is disabled and 19 when enabled.
+        value: 15

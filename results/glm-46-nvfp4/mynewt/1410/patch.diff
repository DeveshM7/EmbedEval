diff --git a/fs/fcb/include/fcb/fcb.h b/fs/fcb/include/fcb/fcb.h
index d6677b2..acc40cc 100644
--- a/fs/fcb/include/fcb/fcb.h
+++ b/fs/fcb/include/fcb/fcb.h
@@ -111,6 +111,7 @@ int fcb_append_finish(struct fcb *, struct fcb_entry *append_loc);
 typedef int (*fcb_walk_cb)(struct fcb_entry *loc, void *arg);
 int fcb_walk(struct fcb *, struct flash_area *, fcb_walk_cb cb, void *cb_arg);
 int fcb_getnext(struct fcb *, struct fcb_entry *loc);
+int fcb_area_info(struct fcb *, struct flash_area *fa, int *elemsp, int *bytesp);
 
 /**
  * Erases the data from oldest sector.
diff --git a/fs/fcb/src/fcb.c b/fs/fcb/src/fcb.c
index 59d4054..bff80b2 100644
--- a/fs/fcb/src/fcb.c
+++ b/fs/fcb/src/fcb.c
@@ -265,3 +265,48 @@ fcb_clear(struct fcb *fcb)
     }
     return rc;
 }
+
+struct fcb_area_info_ctx {
+    int *elem_count;
+    int *byte_count;
+};
+
+static int
+fcb_area_info_cb(struct fcb_entry *loc, void *arg)
+{
+    struct fcb_area_info_ctx *ctx = arg;
+    
+    (*ctx->elem_count)++;
+    *ctx->byte_count += loc->fe_data_len;
+    
+    return 0;
+}
+
+int
+fcb_area_info(struct fcb *fcb, struct flash_area *fa, int *elemsp, int *bytesp)
+{
+    struct fcb_area_info_ctx ctx;
+    struct flash_area *target_fa;
+    int rc;
+
+    if (!fcb || !elemsp || !bytesp) {
+        return FCB_ERR_ARGS;
+    }
+
+    *elemsp = 0;
+    *bytesp = 0;
+
+    if (fa == NULL) {
+        target_fa = fcb->f_oldest;
+    } else {
+        target_fa = fa;
+    }
+
+    ctx.elem_count = elemsp;
+    ctx.byte_count = bytesp;
+
+    rc = fcb_walk(fcb, target_fa, fcb_area_info_cb, &ctx);
+    
+    /* fcb_walk returns 0 on success, and also when no entries are found */
+    return 0;
+}

+/* Helper function to check if there are any active connections */
+static int
+ble_gatts_any_connections(void)
+{
+    struct ble_hs_conn *conn;
+    int found = 0;
+
+    ble_hs_lock();
+    conn = ble_hs_conn_find(1);
+    if (conn != NULL) {
+        found = 1;
+    }
+    ble_hs_unlock();
+    return found;
+}
+
+/* Helper function to check if any GAP procedures are active */
+static int
+ble_gatts_any_gap_procedures(void)
+{
+    /* Check if advertising is active */
+    if (ble_gap_adv_active()) {
+        return 1;
+    }
+    
+    /* Check if discovery is active */
+    if (ble_gap_disc_active()) {
+        return 1;
+    }
+    
+    return 0;
+}
+
+int
+ble_gatts_reset(void)
+{
+    /* Check if we can reset - no connections and no GAP procedures */
+    if (ble_gatts_any_connections() || ble_gatts_any_gap_procedures()) {
+        return BLE_HS_EBUSY;
+    }
+    
+    /* Free all service definitions */
+    ble_gatts_free_svc_defs();
+    
+    /* Reset the service entries */
+    if (ble_gatts_svc_entries) {
+        free(ble_gatts_svc_entries);
+        ble_gatts_svc_entries = NULL;
+    }
+    ble_gatts_num_svc_entries = 0;
+    
+    /* Reset number of configable characteristics */
+    ble_gatts_num_cfgable_chrs = 0;
+    
+    /* Free all memory */
+    ble_gatts_free_mem();
+    
+    return 0;
+}

diff --git a/net/nimble/host/include/host/ble_store.h b/net/nimble/host/include/host/ble_store.h
index 5f9dea4..cf9025d 100644
--- a/net/nimble/host/include/host/ble_store.h
+++ b/net/nimble/host/include/host/ble_store.h
@@ -290,6 +290,7 @@ int ble_store_util_bonded_peers(ble_addr_t *out_peer_id_addrs,
                                 int max_peers);
 int ble_store_util_delete_all(int type, const union ble_store_key *key);
 int ble_store_util_delete_peer(const ble_addr_t *peer_id_addr); 
+int ble_store_clear(void);
 int ble_store_util_delete_oldest_peer(void);
 int ble_store_util_count(int type, int *out_count);
 int ble_store_util_status_rr(struct ble_store_status_event *event, void *arg);
diff --git a/net/nimble/host/src/ble_store_util.c b/net/nimble/host/src/ble_store_util.c
index 294aacb..d594995 100644
--- a/net/nimble/host/src/ble_store_util.c
+++ b/net/nimble/host/src/ble_store_util.c
@@ -252,3 +252,40 @@ ble_store_util_status_rr(struct ble_store_status_event *event, void *arg)
         return BLE_HS_EUNKNOWN;
     }
 }
+
+/**
+ * Deletes all stored objects from the BLE host store.
+ * This includes security state (our and peer) and CCCD entries.
+ *
+ * @return                      0 on success;
+ *                              Nonzero on error.
+ */
+int
+ble_store_clear(void)
+{
+    union ble_store_key key;
+    int rc;
+
+    /* Delete all our security entries */
+    memset(&key, 0, sizeof key);
+    rc = ble_store_util_delete_all(BLE_STORE_OBJ_TYPE_OUR_SEC, &key);
+    if (rc != 0) {
+        return rc;
+    }
+
+    /* Delete all peer security entries */
+    memset(&key, 0, sizeof key);
+    rc = ble_store_util_delete_all(BLE_STORE_OBJ_TYPE_PEER_SEC, &key);
+    if (rc != 0) {
+        return rc;
+    }
+
+    /* Delete all CCCD entries */
+    memset(&key, 0, sizeof key);
+    rc = ble_store_util_delete_all(BLE_STORE_OBJ_TYPE_CCCD, &key);
+    if (rc != 0) {
+        return rc;
+    }
+
+    return 0;
+}

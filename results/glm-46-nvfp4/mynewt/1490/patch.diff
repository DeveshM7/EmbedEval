+
+/* Write protection state for each flash device */
+static uint8_t flash_write_protected[256];
+
+int
+hal_flash_write_protect(uint8_t id, uint8_t protect)
+{
+    const struct hal_flash *hf;
+
+    hf = hal_bsp_flash_dev(id);
+    if (!hf) {
+        return SYS_EINVAL;
+    }
+
+    flash_write_protected[id] = protect ? 1 : 0;
+    return SYS_EOK;
+}

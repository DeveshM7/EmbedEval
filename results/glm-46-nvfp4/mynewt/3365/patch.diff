+     */
+    bmark = NULL;
+#else
     bmark = log_fcb_closest_bmark(fcb_log, log_offset->lo_index);
     if (bmark != NULL) {
         *out_entry = bmark->lfb_entry;
         bmark_found = true;
     }
+#endif
 #endif
 
     /**
@@ -611,9 +618,18 @@ log_fcb_walk_impl(struct log *log, log_walk_func_t walk_func,

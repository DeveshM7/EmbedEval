diff --git a/test_oc_rep.c b/test_oc_rep.c
new file mode 100644
index 0000000..830ed2b
--- /dev/null
+++ b/test_oc_rep.c
@@ -0,0 +1,116 @@
+/*
+ * Test for the updated oc_parse_rep function
+ * Tests that empty array returns 0 and NULL, and invalid root types are rejected
+ */
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "oic/oc_rep.h"
+#include "os/mynewt.h"
+#include <tinycbor/cbor.h>
+
+/* Test helper to create mbuf from data */
+static struct os_mbuf *create_mbuf(const uint8_t *data, size_t len)
+{
+    struct os_mbuf *m = os_msys_get_pkthdr(len, 0);
+    if (!m) return NULL;
+    os_mbuf_append(m, data, len);
+    return m;
+}
+
+int main(void)
+{
+    /* Initialize the rep object pool */
+    oc_rep_init();
+    
+    /* Test Case 1: Empty array should return 0 and NULL */
+    {
+        uint8_t empty_array[] = {0x80}; /* CBOR empty array */
+        struct os_mbuf *m = create_mbuf(empty_array, sizeof(empty_array));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(empty_array), &rep);
+        
+        /* Should return success and NULL for empty array */
+        printf("Test 1 - Empty array: rc=%d, rep=%p\n", rc, rep);
+        assert(rc == 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    /* Test Case 2: String as root should fail */
+    {
+        uint8_t string_root[] = {0x65, 'H', 'e', 'l', 'l', 'o'}; /* CBOR string "Hello" */
+        struct os_mbuf *m = create_mbuf(string_root, sizeof(string_root));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(string_root), &rep);
+        
+        /* Should return error and NULL */
+        printf("Test 2 - String root: rc=%d, rep=%p\n", rc, rep);
+        assert(rc != 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    /* Test Case 3: Integer as root should fail */
+    {
+        uint8_t int_root[] = {0x01}; /* CBOR integer 1 */
+        struct os_mbuf *m = create_mbuf(int_root, sizeof(int_root));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(int_root), &rep);
+        
+        /* Should return error and NULL */
+        printf("Test 3 - Integer root: rc=%d, rep=%p\n", rc, rep);
+        assert(rc != 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    /* Test Case 4: Array with non-map element should fail */
+    {
+        uint8_t array_with_string[] = {0x82, 0x65, 'H', 'i'}; /* Array with string */
+        struct os_mbuf *m = create_mbuf(array_with_string, sizeof(array_with_string));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(array_with_string), &rep);
+        
+        /* Should return error and NULL */
+        printf("Test 4 - Array with non-map: rc=%d, rep=%p\n", rc, rep);
+        assert(rc != 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    /* Test Case 5: Valid empty map */
+    {
+        uint8_t empty_map[] = {0xA0}; /* CBOR empty map */
+        struct os_mbuf *m = create_mbuf(empty_map, sizeof(empty_map));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(empty_map), &rep);
+        
+        /* Should return success but rep can be NULL for empty map */
+        printf("Test 5 - Empty map: rc=%d, rep=%p\n", rc, rep);
+        assert(rc == 0);
+        /* Rep can be NULL for empty map, but that's OK */
+        
+        if (rep) {
+            oc_free_rep(rep);
+        }
+        os_mbuf_free_chain(m);
+    }
+    
+    printf("All tests passed!\n");
+    return 0;
+}
diff --git a/test_parse_fix.c b/test_parse_fix.c
new file mode 100644
index 0000000..2b22af9
--- /dev/null
+++ b/test_parse_fix.c
@@ -0,0 +1,38 @@
+/*
+ * Test for the updated oc_parse_rep function
+ */
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+
+#include "oic/oc_rep.h"
+#include "os/mynewt.h"
+#include "testutil/test_util.h"
+
+int test_main(int argc, char **argv)
+{
+    /* Test empty array */
+    struct os_mbuf *m = os_msys_get_pkthdr(10, 0);
+    uint8_t empty_array[] = {0x80}; /* CBOR empty array */
+    os_mbuf_append(m, empty_array, sizeof(empty_array));
+    
+    oc_rep_t *rep = NULL;
+    uint16_t rc = oc_parse_rep(m, 0, sizeof(empty_array), &rep);
+    
+    /* Should return success and NULL for empty array */
+    assert(rc == 0);
+    assert(rep == NULL);
+    
+    /* Test invalid root type */
+    uint8_t invalid_root[] = {0x65}; /* CBOR string - invalid as root */
+    os_mbuf_reset(m);
+    os_mbuf_append(m, invalid_root, sizeof(invalid_root));
+    
+    rc = oc_parse_rep(m, 0, sizeof(invalid_root), &rep);
+    /* Should return error */
+    assert(rc != 0);
+    assert(rep == NULL);
+    
+    printf("Test passed - empty array returns 0 and NULL\n");
+    return 0;
+}
diff --git a/test_validation.c b/test_validation.c
new file mode 100644
index 0000000..426c8b9
--- /dev/null
+++ b/test_validation.c
@@ -0,0 +1,94 @@
+/*
+ * Test validation features added to oc_parse_rep
+ */
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#include "oic/oc_rep.h"
+#include "os/mynewt.h"
+#include <tinycbor/cbor.h>
+
+static struct os_mbuf *create_mbuf(const uint8_t *data, size_t len)
+{
+    struct os_mbuf *m = os_msys_get_pkthdr(len, 0);
+    if (!m) return NULL;
+    os_mbuf_append(m, data, len);
+    return m;
+}
+
+int main(void)
+{
+    /* Initialize the rep object pool */
+    oc_rep_init();
+    
+    printf("Testing empty array returns 0 and NULL...\n");
+    {
+        uint8_t empty_array[] = {0x80}; /* CBOR empty array */
+        struct os_mbuf *m = create_mbuf(empty_array, sizeof(empty_array));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(empty_array), &rep);
+        
+        printf("  Empty array test: rc=%d, rep=%p\n", rc, rep);
+        assert(rc == 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    printf("Testing non-map/array root returns error...\n");
+    {
+        uint8_t int_root[] = {0x01}; /* CBOR integer 1 */
+        struct os_mbuf *m = create_mbuf(int_root, sizeof(int_root));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(int_root), &rep);
+        
+        printf("  Integer root test: rc=%d, rep=%p\n", rc, rep);
+        assert(rc != 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    printf("Testing array with non-map element returns error...\n");
+    {
+        uint8_t array_mix[] = {0x82, 0xA0, 0x01}; /* Array: [empty_map, int] */
+        struct os_mbuf *m = create_mbuf(array_mix, sizeof(array_mix));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(array_mix), &rep);
+        
+        printf("  Mixed array test: rc=%d, rep=%p\n", rc, rep);
+        assert(rc != 0);
+        assert(rep == NULL);
+        
+        os_mbuf_free_chain(m);
+    }
+    
+    printf("Testing string length limit in arrays...\n");
+    {
+        uint8_t long_str[] = {0xA1, 0x61, 0x61, 0x81, 0x78, 0x18, /* Map with: "a":[ 24-byte... */ 
+                             'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h',
+                             'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p',
+                             'q', 'r', 's', 't', 'u', 'v', 'w', 'x'}; /* ...string ] */
+        struct os_mbuf *m = create_mbuf(long_str, sizeof(long_str));
+        assert(m != NULL);
+        
+        oc_rep_t *rep = NULL;
+        uint16_t rc = oc_parse_rep(m, 0, sizeof(long_str), &rep);
+        
+        printf("  Long string array test: rc=%d, rep=%p\n", rc, rep);
+        assert(rc != 0); /* Should error due to 24-byte string */
+        assert(rep == NULL);
+        
+        if (rep) oc_free_rep(rep);
+        os_mbuf_free_chain(m);
+    }
+    
+    printf("All validation tests passed!\n");
+    return 0;
+}

         if (err_listener->sel_sensor_type & type) {
             err_listener->sel_func(sensor, err_listener->sel_arg, status,
                                    type);
-        }
+
+    /* Call the single error callback if registered */
+    if (sensor->s_err_func != NULL) {
+        sensor->s_err_func(sensor, sensor->s_err_arg, status);
+    }
+}
     }
 }
 
@@ -2241,3 +2246,25 @@ err:
     return (rc);
 }
 
+
+int
+sensor_register_err_func(struct sensor *sensor, 
+                         void (*err_fn)(struct sensor *, void *, int),
+                         void *arg)
+{
+    int rc;
+
+    rc = sensor_lock(sensor);
+    if (rc != 0) {
+        goto err;
+    }
+
+    sensor->s_err_func = err_fn;
+    sensor->s_err_arg = arg;
+
+    sensor_unlock(sensor);
+

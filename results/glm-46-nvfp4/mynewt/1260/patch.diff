diff --git a/simple_test.c b/simple_test.c
new file mode 100644
index 0000000..3a33054
--- /dev/null
+++ b/simple_test.c
@@ -0,0 +1,60 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+
+// Simplified test to verify our implementation
+struct dummy_sensor {
+    void (*s_err_func)(void *sensor, void *arg, int status);
+    void *s_err_arg;
+};
+
+static void test_callback(void *sensor, void *arg, int status)
+{
+    printf("Callback called: sensor=%p, arg=%p, status=%d\n", sensor, arg, status);
+}
+
+// Simulate the implementation of sensor_register_err_func
+int sensor_register_err_func(struct dummy_sensor *sensor, 
+                             void (*err_fn)(void *, void *, int),
+                             void *arg)
+{
+    sensor->s_err_func = err_fn;
+    sensor->s_err_arg = arg;
+    return 0;
+}
+
+// Simulate the error handling part
+void simulate_sensor_read_error(struct dummy_sensor *sensor, int status)
+{
+    /* Call the single error callback if registered */
+    if (sensor->s_err_func != NULL) {
+        sensor->s_err_func(sensor, sensor->s_err_arg, status);
+    }
+}
+
+int main()
+{
+    struct dummy_sensor sensor;
+    
+    // Initialize
+    memset(&sensor, 0, sizeof(sensor));
+    
+    // Test 1: Register callback
+    int rc = sensor_register_err_func(&sensor, test_callback, (void*)0x1234);
+    assert(rc == 0);
+    
+    // Test 2: Trigger error - callback should be called
+    printf("Test 2: Trigger error with callback registered\n");
+    simulate_sensor_read_error(&sensor, -1);
+    
+    // Test 3: Register NULL callback
+    rc = sensor_register_err_func(&sensor, NULL, NULL);
+    assert(rc == 0);
+    
+    // Test 4: Trigger error with NULL callback - should not crash
+    printf("Test 4: Trigger error with NULL callback\n");
+    simulate_sensor_read_error(&sensor, -2);
+    
+    printf("All tests passed!\n");
+    return 0;
+}

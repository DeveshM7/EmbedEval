+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+# specific language governing permissions and limitations
+# under the License.
+ */
+
+#include <stdio.h>
+#include <debounce/debounce.h>
+#include <defs/error.h>
+
+int
+debouncer_init(struct debouncer *debouncer, uint16_t thresh_low, uint16_t thresh_high, uint16_t max)
+{
+    if (debouncer == NULL) {
+        return SYS_EINVAL;
+    }
+
+    if (thresh_low > thresh_high || thresh_high > max) {
+        return SYS_EINVAL;
+    }
+
+    debouncer->counter = 0;
+    debouncer->thresh_low = thresh_low;
+    debouncer->thresh_high = thresh_high;
+    debouncer->max = max;
+    debouncer->state = 0;  /* Start in low state */
+
+    return 0;
+}
+
+int
+debouncer_adjust(struct debouncer *debouncer, int32_t delta)
+{
+    if (debouncer == NULL) {
+        return SYS_EINVAL;
+    }
+
+    int32_t new_val = (int32_t)debouncer->counter + delta;
+
+    /* Saturate to bounds */
+    if (new_val < 0) {
+        debouncer->counter = 0;
+    } else if (new_val > debouncer->max) {
+        debouncer->counter = debouncer->max;
+    } else {
+        debouncer->counter = (uint16_t)new_val;
+    }
+
+    /* Update state based on new counter value */
+    if (debouncer->state == 0) {  /* Currently in low state */
+        if (debouncer->counter >= debouncer->thresh_high) {
+            debouncer->state = 1;  /* Transition to high state */
+        }
+    } else {  /* Currently in high state */
+        if (debouncer->counter <= debouncer->thresh_low) {
+            debouncer->state = 0;  /* Transition to low state */
+        }
+    }
+
+    return 0;
+}
+
+void
+debouncer_set(struct debouncer *debouncer, uint16_t val)
+{
+    if (debouncer == NULL) {
+        return;
+    }
+
+    /* Clamp value to max */
+    if (val > debouncer->max) {
+        debouncer->counter = debouncer->max;
+    } else {
+        debouncer->counter = val;
+    }
+
+    /* Update state based on new counter value */
+    if (debouncer->state == 0) {  /* Currently in low state */
+        if (debouncer->counter >= debouncer->thresh_high) {
+            debouncer->state = 1;  /* Transition to high state */
+        }
+    } else {  /* Currently in high state */
+        if (debouncer->counter <= debouncer->thresh_low) {
+            debouncer->state = 0;  /* Transition to low state */
+        }
+    }
+}
+
+int
+debouncer_state(const struct debouncer *debouncer)
+{
+    if (debouncer == NULL) {
+        return 0;
+    }
+
+    return debouncer->state ? 1 : 0;
+}
+
+uint16_t
+debouncer_val(const struct debouncer *debouncer)
+{
+    if (debouncer == NULL) {
+        return 0;
+    }
+
+    return debouncer->counter;
+}

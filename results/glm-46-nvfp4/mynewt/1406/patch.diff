+    rc = hal_flash_isempty(fa->fa_device_id, fa->fa_off, NULL, fa->fa_size);
     if (rc < 0) {
         return rc;
     } else if (rc == 1) {
@@ -205,7 +205,16 @@ flash_area_is_empty(const struct flash_area *fa, bool *empty)
 int
 flash_area_isempty_at(const struct flash_area *fa, uint32_t off, uint32_t len)
 {
-    return hal_flash_isempty(fa->fa_device_id, fa->fa_off + off, len);
+    return hal_flash_isempty(fa->fa_device_id, fa->fa_off + off, NULL, len);
+}
+
+int
+flash_area_read_is_empty(const struct flash_area *fa, uint32_t off, void *dst, uint32_t len)
+{
+    if (off > fa->fa_size || off + len > fa->fa_size) {
+        return -1;
+    }
+    return hal_flash_isempty(fa->fa_device_id, fa->fa_off + off, dst, len);
 }
 

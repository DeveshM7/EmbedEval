+++ b/test_bookmark_simple.c
@@ -0,0 +1,177 @@
+/*
+ * Simple test to verify FCB bookmark functionality
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <assert.h>
+
+/* Mock definitions for testing */
+#define MYNEWT_VAL_LOG_FCB_BOOKMARKS 1
+
+#define NULL ((void*)0)
+#define memset(dest, c, n) (void)0
+
+struct flash_area {
+    uint32_t fa_off;
+    uint32_t fa_size;
+    uint8_t fa_device_id;
+};
+
+struct fcb_entry {
+    struct flash_area *fe_area;
+    uint32_t fe_elem_off;
+    uint32_t fe_data_off;
+    uint16_t fe_data_len;
+};
+
+struct fcb {
+    uint32_t f_magic;
+    uint8_t f_version;
+    uint8_t f_sector_cnt;
+    uint8_t f_scratch_cnt;
+    struct flash_area *f_sectors;
+    struct flash_area *f_oldest;
+    struct fcb_entry f_active;
+    uint16_t f_active_id;
+    uint8_t f_align;
+};
+
+struct fcb_log_bmark {
+    struct fcb_entry entry;
+    uint32_t index;
+};
+
+struct fcb_log {
+    struct fcb fl_fcb;
+    uint8_t fl_entries;
+    struct fcb_log_bmark *fl_bmarks;
+    int fl_bmark_count;
+};
+
+void fcb_log_init_bmarks(struct fcb_log *fcb_log, struct fcb_log_bmark *buf,
+                         int bmark_count)
+{
+    if (!fcb_log || !buf || bmark_count <= 0) {
+        return;
+    }
+    
+    fcb_log->fl_bmarks = buf;
+    fcb_log->fl_bmark_count = bmark_count;
+    
+    /* Initialize all bookmarks as empty */
+    for (int i = 0; i < bmark_count; i++) {
+        buf[i].entry.fe_area = NULL;
+        buf[i].index = 0;
+    }
+}
+
+struct fcb_log_bmark *
+fcb_log_find_bmark(struct fcb_log *fcb_log, uint32_t index)
+{
+    /* Simple linear search - could be optimized with hash table */
+    for (int i = 0; i < fcb_log->fl_bmark_count; i++) {
+        if (fcb_log->fl_bmarks[i].entry.fe_area != NULL &&
+            fcb_log->fl_bmarks[i].index == index) {
+            return &fcb_log->fl_bmarks[i];
+        }
+    }
+    return NULL;
+}
+
+void
+fcb_log_update_bmark(struct fcb_log *fcb_log, const struct fcb_entry *entry,
+                      uint32_t index)
+{
+    if (!fcb_log->fl_bmarks || fcb_log->fl_bmark_count == 0) {
+        return;
+    }
+    
+    /* Find existing bookmark */
+    struct fcb_log_bmark *bmark = fcb_log_find_bmark(fcb_log, index);
+    
+    if (bmark) {
+        /* Update existing */
+        bmark->entry = *entry;
+    } else {
+        /* Find empty slot */
+        for (int i = 0; i < fcb_log->fl_bmark_count; i++) {
+            if (fcb_log->fl_bmarks[i].entry.fe_area == NULL) {
+                fcb_log->fl_bmarks[i].entry = *entry;
+                fcb_log->fl_bmarks[i].index = index;
+                break;
+            }
+        }
+    }
+}
+
+void
+fcb_log_invalidate_bmarks(struct fcb_log *fcb_log)
+{
+    if (!fcb_log->fl_bmarks || fcb_log->fl_bmark_count == 0) {
+        return;
+    }
+    
+    for (int i = 0; i < fcb_log->fl_bmark_count; i++) {
+        fcb_log->fl_bmarks[i].entry.fe_area = NULL;
+        fcb_log->fl_bmarks[i].index = 0;
+    }
+}
+
+int main() {
+    printf("Testing FCB bookmark implementation...\n");
+    
+    struct fcb_log log;
+    struct fcb_log_bmark bmarks[10];
+    
+    /* Clear memory */
+    memset(&log, 0, sizeof(log));
+    memset(bmarks, 0, sizeof(bmarks));
+    
+    /* Test initialization */
+    printf("Testing initialization...\n");
+    fcb_log_init_bmarks(&log, bmarks, 10);
+    
+    assert(log.fl_bmarks == bmarks);
+    assert(log.fl_bmark_count == 10);
+    
+    /* Verify bookmarks are empty */
+    for (int i = 0; i < 10; i++) {
+        assert(bmarks[i].entry.fe_area == NULL);
+        assert(bmarks[i].index == 0);
+    }
+    
+    /* Test bookmark find/update */
+    printf("Testing bookmark find/update...\n");
+    
+    /* Create a fake entry */
+    struct flash_area fa = { .fa_off = 0x1000, .fa_size = 4096 };
+    struct fcb_entry entry = { 
+        .fe_area = &fa,
+        .fe_elem_off = 0x1000,
+        .fe_data_off = 0x1008,
+        .fe_data_len = 10
+    };
+    
+    /* Update bookmark for index 5 */
+    fcb_log_update_bmark(&log, &entry, 5);
+    
+    /* Find the bookmark */
+    struct fcb_log_bmark *found = fcb_log_find_bmark(&log, 5);
+    assert(found != NULL);
+    assert(found->index == 5);
+    assert(found->entry.fe_area == &fa);
+    
+    /* Test bookmark invalidation */
+    printf("Testing bookmark invalidation...\n");
+    fcb_log_invalidate_bmarks(&log);
+    
+    for (int i = 0; i < 10; i++) {
+        assert(bmarks[i].entry.fe_area == NULL);
+        assert(bmarks[i].index == 0);
+    }
+    
+    printf("All FCB bookmark tests passed!\n");
+    return 0;
+}

diff --git a/test_bmarks.c b/test_bmarks.c
new file mode 100644
index 0000000..aca3345
--- /dev/null
+++ b/test_bmarks.c
@@ -0,0 +1,88 @@
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+
+/* Mock necessary structures for testing */
+struct flash_area {
+    uint32_t fa_off;
+    uint32_t fa_size;
+    uint8_t fa_device_id;
+};
+
+struct fcb_entry {
+    struct flash_area *fe_area;	/* ptr to area within fcb->f_sectors */
+    uint32_t fe_elem_off;	/* start of entry */
+    uint32_t fe_data_off;	/* start of data */
+    uint16_t fe_data_len;	/* size of data area */
+};
+
+struct fcb {
+    uint32_t f_magic;
+    uint8_t f_version;
+    uint8_t f_sector_cnt;
+    uint8_t f_scratch_cnt;
+    struct flash_area *f_sectors;
+    struct flash_area *f_oldest;
+    struct fcb_entry f_active;
+    uint16_t f_active_id;
+    uint8_t f_align;
+};
+
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+struct fcb_log_bmark {
+    struct fcb_entry entry;
+    uint32_t index;
+};
+
+struct fcb_log {
+    struct fcb fl_fcb;
+    uint8_t fl_entries;
+    struct fcb_log_bmark *fl_bmarks;
+    int fl_bmark_count;
+};
+
+void fcb_log_init_bmarks(struct fcb_log *fcb_log, struct fcb_log_bmark *buf,
+                         int bmark_count)
+{
+    if (!fcb_log || !buf || bmark_count <= 0) {
+        return;
+    }
+    
+    fcb_log->fl_bmarks = buf;
+    fcb_log->fl_bmark_count = bmark_count;
+    
+    /* Initialize all bookmarks as empty */
+    for (int i = 0; i < bmark_count; i++) {
+        buf[i].entry.fe_area = NULL;
+        buf[i].index = 0;
+    }
+}
+#endif
+
+int main()
+{
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+    struct fcb_log log;
+    struct fcb_log_bmark bmarks[10];
+    
+    printf("Testing FCB bookmarks initialization...\n");
+    
+    /* Test initialization */
+    fcb_log_init_bmarks(&log, bmarks, 10);
+    
+    assert(log.fl_bmarks == bmarks);
+    assert(log.fl_bmark_count == 10);
+    
+    /* Verify bookmarks are initialized to empty */
+    for (int i = 0; i < 10; i++) {
+        assert(bmarks[i].entry.fe_area == NULL);
+        assert(bmarks[i].index == 0);
+    }
+    
+    printf("FCB bookmarks test passed!\n");
+#else
+    printf("LOG_FCB_BOOKMARKS not enabled, skipping test\n");
+#endif
+    
+    return 0;
+}

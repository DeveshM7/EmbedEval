      */
-    if (log_offset->lo_ts < 0) {
+    if (log_offset && log_offset->lo_ts < 0) {
         locp = &fcb->f_active;
         rc = walk_func(log, log_offset, (void *)locp, locp->fe_data_len);
     } else {
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+        /* Try to find a bookmark if we have an index */
+        if (fcb_log->fl_bmarks && fcb_log->fl_bmark_count > 0 && start_index > 0) {
+            bmark = fcb_log_find_bmark(fcb_log, start_index);
+            if (bmark) {
+                /* Start from bookmarked entry */
+                loc = bmark->entry;
+                /* First, process the bookmarked entry itself */
+                rc = walk_func(log, log_offset, (void *)&loc, loc.fe_data_len);
+                if (rc) {
+                    goto done;
+                }
+                /* Then continue with subsequent entries */
+                while (fcb_getnext(fcb, &loc) == 0) {
+                    rc = walk_func(log, log_offset, (void *)&loc, loc.fe_data_len);
+                    if (rc) {
+                        break;
+                    }
+                }
+                goto done;
+            }
+        }
+#endif
+        /* Standard walk from beginning */
         while (fcb_getnext(fcb, &loc) == 0) {
-            rc = walk_func(log, log_offset, (void *) &loc, loc.fe_data_len);
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+            /* Update bookmark for current position */
+            if (fcb_log->fl_bmarks && fcb_log->fl_bmark_count > 0) {
+                /* Simple heuristic: bookmark every Nth entry to avoid excessive updates */
+                static uint32_t entry_count = 0;
+                entry_count++;
+                if (entry_count % 10 == 0) { /* Bookmark every 10th entry */
+                    fcb_log_update_bmark(fcb_log, &loc, entry_count);
+                }
+            }
+#endif
+            rc = walk_func(log, log_offset, (void *)&loc, loc.fe_data_len);
             if (rc) {
                 break;
             }
         }
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+done:
+#endif
     }
     return (rc);
 }
@@ -698,3 +745,89 @@ const struct log_handler log_fcb_handler = {
 };
 
 #endif
+
+#if MYNEWT_VAL(LOG_FCB_BOOKMARKS)
+/**
+ * Initialize bookmarks for an FCB log
+ */
+void
+fcb_log_init_bmarks(struct fcb_log *fcb_log, struct fcb_log_bmark *buf,
+                    int bmark_count)
+{
+    if (!fcb_log || !buf || bmark_count <= 0) {
+        return;
+    }
+    
+    fcb_log->fl_bmarks = buf;
+    fcb_log->fl_bmark_count = bmark_count;
+    
+    /* Initialize all bookmarks as empty */
+    memset(buf, 0, sizeof(*buf) * bmark_count);
+    for (int i = 0; i < bmark_count; i++) {
+        buf[i].entry.fe_area = NULL;
+        buf[i].index = 0;
+    }
+}
+
+/**
+ * Find a bookmark for a given entry index
+ */
+static struct fcb_log_bmark *
+fcb_log_find_bmark(struct fcb_log *fcb_log, uint32_t index)
+{
+    /* Simple linear search - could be optimized with hash table */
+    for (int i = 0; i < fcb_log->fl_bmark_count; i++) {
+        if (fcb_log->fl_bmarks[i].entry.fe_area != NULL &&
+            fcb_log->fl_bmarks[i].index == index) {
+            return &fcb_log->fl_bmarks[i];
+        }
+    }
+    return NULL;
+}
+
+/**
+ * Add or update a bookmark for an entry
+ */
+static void
+fcb_log_update_bmark(struct fcb_log *fcb_log, const struct fcb_entry *entry,
+                      uint32_t index)
+{
+    if (!fcb_log->fl_bmarks || fcb_log->fl_bmark_count == 0) {
+        return;
+    }
+    
+    /* Find existing bookmark */
+    struct fcb_log_bmark *bmark = fcb_log_find_bmark(fcb_log, index);
+    
+    if (bmark) {
+        /* Update existing */
+        bmark->entry = *entry;
+    } else {
+        /* Find empty slot */
+        for (int i = 0; i < fcb_log->fl_bmark_count; i++) {
+            if (fcb_log->fl_bmarks[i].entry.fe_area == NULL) {
+                fcb_log->fl_bmarks[i].entry = *entry;
+                fcb_log->fl_bmarks[i].index = index;
+                break;
+            }
+        }
+    }
+}
+
+/**
+ * Invalidate all bookmarks (called on rotate)
+ */
+static void
+fcb_log_invalidate_bmarks(struct fcb_log *fcb_log)
+{
+    if (!fcb_log->fl_bmarks || fcb_log->fl_bmark_count == 0) {
+        return;
+    }
+    
+    for (int i = 0; i < fcb_log->fl_bmark_count; i++) {
+        fcb_log->fl_bmarks[i].entry.fe_area = NULL;
+        fcb_log->fl_bmarks[i].index = 0;
+    }
+}
+
+#endif /* LOG_FCB_BOOKMARKS */

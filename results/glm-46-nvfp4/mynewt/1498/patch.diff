index 0000000..00e81b0
--- /dev/null
+++ b/fs/fcb2/src/fcb2.c
@@ -0,0 +1,535 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+#include <string.h>
+#include "fcb/fcb.h"
+#include "fcb_priv.h"
+
+static int fcb_put_len(uint8_t *buf, uint16_t len);
+static int fcb_get_len(uint8_t *buf, uint16_t *len);
+static int fcb_len_in_flash(struct fcb *fcb, uint16_t len);
+static struct flash_sector_range *fcb_getnext_range(struct fcb *fcb, struct flash_sector_range *range);
+static int fcb_sector_hdr_init(struct fcb *fcb, struct flash_sector_range *range, uint16_t id);
+static int fcb_sector_hdr_read(struct fcb *fcb, struct flash_sector_range *range, struct fcb_disk_area *fdap);
+static int fcb_crc16(uint8_t *buf, uint16_t len);
+
+int
+fcb_init(struct fcb *fcb)
+{
+    struct flash_sector_range *range;
+    int i;
+    int oldest = -1, newest = -1;
+    struct flash_sector_range *oldest_range = NULL, *newest_range = NULL;
+    struct fcb_disk_area fda;
+
+    if (!fcb->f_ranges || (fcb->f_sector_cnt - fcb->f_scratch_cnt) < 1) {
+        return FCB_ERR_ARGS;
+    }
+
+    fcb->f_align = 1;
+
+    for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+        range = &fcb->f_ranges[i];
+        if (range->fsr_align > fcb->f_align) {
+            fcb->f_align = range->fsr_align;
+        }
+    }
+
+    for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+        range = &fcb->f_ranges[i];
+        if (fcb_sector_hdr_read(fcb, range, &fda) == 0) {
+            continue;
+        }
+        if (fda.fd_magic != fcb->f_magic) {
+            return FCB_ERR_MAGIC;
+        }
+        if (fda.fd_ver != fcb->f_version) {
+            return FCB_ERR_VERSION;
+        }
+        if (oldest < 0) {
+            oldest = newest = fda.fd_id;
+            oldest_range = newest_range = range;
+            continue;
+        }
+        if ((int16_t)(fda.fd_id - newest) > 0) {
+            newest = fda.fd_id;
+            newest_range = range;
+        } else if ((int16_t)(oldest - fda.fd_id) > 0) {
+            oldest = fda.fd_id;
+            oldest_range = range;
+        }
+    }
+
+    if (oldest < 0) {
+        oldest_range = newest_range = &fcb->f_ranges[0];
+        if (fcb_sector_hdr_init(fcb, oldest_range, 0) != FCB_OK) {
+            return FCB_ERR_FLASH;
+        }
+        newest = oldest = 0;
+    }
+
+    fcb->f_active.fe_fcb = fcb;
+    fcb->f_active.fe_range = newest_range;
+    fcb->f_active.fe_sector = newest_range->fsr_first_sector;
+    fcb->f_active.fe_data_off = newest_range->fsr_range_start + sizeof(struct fcb_disk_area);
+    fcb->f_active.fe_data_len = 0;
+    fcb->f_active.fe_entry_num = 0;
+    fcb->f_active_id = newest;
+
+    return FCB_OK;
+}
+
+int
+fcb_append(struct fcb *fcb, uint16_t len, struct fcb_entry *loc)
+{
+    struct flash_sector_range *range;
+    uint16_t max_len;
+    uint8_t lenbuf[2];
+    int len_encoded;
+    int rc;
+    uint32_t data_end;
+
+    if (!fcb->f_ranges || !loc) {
+        return FCB_ERR_ARGS;
+    }
+
+    max_len = fcb->f_ranges[0].fsr_sector_size - sizeof(struct fcb_disk_area) - FCB_CRC_LEN - FCB_ENTRY_SIZE;
+
+    if (len > max_len) {
+        return FCB_ERR_NOSPACE;
+    }
+
+    len_encoded = fcb_put_len(lenbuf, len);
+    if (len_encoded < 0) {
+        return FCB_ERR_ARGS;
+    }
+
+    *loc = fcb->f_active;
+
+    range = fcb->f_active.fe_range;
+    data_end = fcb->f_active.fe_data_off + fcb_len_in_flash(fcb, len_encoded) + len + FCB_CRC_LEN;
+
+    if (data_end > range->fsr_range_start + range->fsr_sector_size) {
+        if (fcb_append_to_scratch(fcb) != FCB_OK) {
+            return FCB_ERR_NOSPACE;
+        }
+        *loc = fcb->f_active;
+    }
+
+    rc = flash_area_write(&range->fsr_flash_area, fcb->f_active.fe_data_off - range->fsr_range_start, lenbuf, len_encoded);
+    if (rc != 0) {
+        return FCB_ERR_FLASH;
+    }
+
+    return FCB_OK;
+}
+
+int
+fcb_write(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len)
+{
+    struct flash_sector_range *range;
+
+    if (!loc || !buf || off > loc->fe_data_len || (off + len) > loc->fe_data_len) {
+        return FCB_ERR_ARGS;
+    }
+
+    range = loc->fe_range;
+
+    return flash_area_write(&range->fsr_flash_area, 
+                            loc->fe_data_off + off - range->fsr_range_start, 
+                            buf, len);
+}
+
+int
+fcb_append_finish(struct fcb_entry *loc)
+{
+    struct flash_sector_range *range;
+    uint16_t crc;
+    uint8_t crcbuf[FCB_CRC_LEN];
+
+    if (!loc) {
+        return FCB_ERR_ARGS;
+    }
+
+    range = loc->fe_range;
+    loc->fe_fcb->f_active.fe_data_off = loc->fe_data_off + loc->fe_data_len + FCB_CRC_LEN;
+
+    return FCB_OK;
+}
+
+int
+fcb_walk(struct fcb *fcb, int sector, fcb_walk_cb cb, void *cb_arg)
+{
+    struct flash_sector_range *range, *start_range, *end_range;
+    struct fcb_entry loc;
+    uint8_t lenbuf[2];
+    uint16_t len;
+    int len_encoded;
+    int rc;
+    uint32_t offset;
+
+    if (!fcb || !cb) {
+        return FCB_ERR_ARGS;
+    }
+
+    if (sector == 0) {
+        start_range = fcb->f_active.fe_range;
+        end_range = fcb->f_active.fe_range;
+    } else if (sector == FCB_SECTOR_OLDEST) {
+        start_range = fcb->f_ranges;
+        for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+            if (fcb_sector_hdr_read(fcb, &fcb->f_ranges[i], NULL) > 0) {
+                start_range = &fcb->f_ranges[i];
+                break;
+            }
+        }
+        end_range = start_range;
+    } else if (sector >= 0 && sector < fcb->f_sector_cnt) {
+        start_range = &fcb->f_ranges[sector];
+        end_range = start_range;
+    } else {
+        return FCB_ERR_ARGS;
+    }
+
+    for (range = start_range; range <= end_range; range++) {
+        for (offset = range->fsr_range_start + sizeof(struct fcb_disk_area);
+             offset < range->fsr_range_start + range->fsr_sector_size; ) {
+            rc = flash_area_read(&range->fsr_flash_area, offset - range->fsr_range_start, 
+                                lenbuf, 2);
+            if (rc != 0) {
+                continue;
+            }
+
+            len_encoded = fcb_get_len(lenbuf, &len);
+            if (len_encoded < 0) {
+                continue;
+            }
+
+            if (len > FCB_MAX_LEN) {
+                continue;
+            }
+
+            loc.fe_fcb = fcb;
+            loc.fe_range = range;
+            loc.fe_sector = range->fsr_first_sector;
+            loc.fe_data_off = offset + len_encoded;
+            loc.fe_data_len = len;
+            loc.fe_entry_num = 0;
+
+            rc = fcb_elem_info(&loc);
+            if (rc != FCB_OK) {
+                offset += fcb_len_in_flash(fcb, len_encoded) + len + FCB_CRC_LEN;
+                continue;
+            }
+
+            rc = cb(&loc, cb_arg);
+            if (rc != 0) {
+                return rc;
+            }
+
+            offset += fcb_len_in_flash(fcb, len_encoded) + len + FCB_CRC_LEN;
+        }
+    }
+
+    return FCB_OK;
+}
+
+int
+fcb_read(struct fcb_entry *loc, uint16_t off, void *buf, uint16_t len)
+{
+    struct flash_sector_range *range;
+
+    if (!loc || !buf || off > loc->fe_data_len || (off + len) > loc->fe_data_len) {
+        return FCB_ERR_ARGS;
+    }
+
+    range = loc->fe_range;
+
+    return flash_area_read(&range->fsr_flash_area, 
+                           loc->fe_data_off + off - range->fsr_range_start, 
+                           buf, len);
+}
+
+int
+fcb_rotate(struct fcb *fcb)
+{
+    struct flash_sector_range *range, *oldest_range;
+    uint16_t oldest_id = UINT16_MAX;
+    int i;
+
+    if (!fcb || !fcb->f_ranges) {
+        return FCB_ERR_ARGS;
+    }
+
+    for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+        range = &fcb->f_ranges[i];
+        if (fcb_sector_hdr_read(fcb, range, NULL) > 0) {
+            struct fcb_disk_area fda;
+            if (fcb_sector_hdr_read(fcb, range, &fda) == FCB_OK && fda.fd_id < oldest_id) {
+                oldest_id = fda.fd_id;
+                oldest_range = range;
+            }
+        }
+    }
+
+    if (oldest_id == UINT16_MAX) {
+        return FCB_ERR_ARGS;
+    }
+
+    if (flash_area_erase(&oldest_range->fsr_flash_area, 0, oldest_range->fsr_sector_size) != 0) {
+        return FCB_ERR_FLASH;
+    }
+
+    if (fcb_sector_hdr_init(fcb, oldest_range, fcb->f_active_id + 1) == FCB_OK) {
+        fcb->f_active.fe_range = oldest_range;
+        fcb->f_active.fe_sector = oldest_range->fsr_first_sector;
+        fcb->f_active.fe_data_off = oldest_range->fsr_range_start + sizeof(struct fcb_disk_area);
+        fcb->f_active.fe_data_len = 0;
+        fcb->f_active.fe_entry_num = 0;
+        fcb->f_active_id++;
+        return FCB_OK;
+    }
+
+    return FCB_ERR_FLASH;
+}
+
+int
+fcb_append_to_scratch(struct fcb *fcb)
+{
+    struct flash_sector_range *range;
+    int i;
+
+    if (!fcb || !fcb->f_ranges) {
+        return FCB_ERR_ARGS;
+    }
+
+    for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+        range = &fcb->f_ranges[i];
+        if (fcb_sector_hdr_read(fcb, range, NULL) == 0) {
+            if (flash_area_erase(&range->fsr_flash_area, 0, range->fsr_sector_size) == 0) {
+                if (fcb_sector_hdr_init(fcb, range, fcb->f_active_id + 1) == FCB_OK) {
+                    fcb->f_active.fe_range = range;
+                    fcb->f_active.fe_sector = range->fsr_first_sector;
+                    fcb->f_active.fe_data_off = range->fsr_range_start + sizeof(struct fcb_disk_area);
+                    fcb->f_active.fe_data_len = 0;
+                    fcb->f_active.fe_entry_num = 0;
+                    fcb->f_active_id++;
+                    return FCB_OK;
+                }
+            }
+        }
+    }
+
+    return FCB_ERR_NOSPACE;
+}
+
+int
+fcb_area_info(struct fcb *fcb, int sector, int *elemsp, int *bytesp)
+{
+    struct flash_sector_range *range;
+    struct fcb_entry loc;
+    uint8_t lenbuf[2];
+    uint16_t len;
+    int len_encoded;
+    uint32_t offset;
+    int elements = 0, bytes = 0;
+    int rc;
+    int i;
+
+    if (!fcb || sector >= fcb->f_sector_cnt) {
+        return FCB_ERR_ARGS;
+    }
+
+    if (sector == FCB_SECTOR_OLDEST) {
+        uint16_t oldest_id = UINT16_MAX;
+        for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+            range = &fcb->f_ranges[i];
+            if (fcb_sector_hdr_read(fcb, range, NULL) > 0) {
+                struct fcb_disk_area fda;
+                if (fcb_sector_hdr_read(fcb, range, &fda) == FCB_OK && fda.fd_id < oldest_id) {
+                    oldest_id = fda.fd_id;
+                }
+            }
+        }
+        if (oldest_id == UINT16_MAX) {
+            if (elemsp) *elemsp = 0;
+            if (bytesp) *bytesp = 0;
+            return FCB_OK;
+        }
+        for (range_idx = 0; range_idx < fcb->f_sector_cnt; range_idx++) {
+            range = &fcb->f_ranges[i];
+            if (fcb_sector_hdr_read(fcb, range, NULL) > 0) {
+                struct fcb_disk_area fda;
+                if (fcb_sector_hdr_read(fcb, range, &fda) == FCB_OK && fda.fd_id == oldest_id) {
+                    break;
+                }
+            }
+        }
+    } else {
+        range = &fcb->f_ranges[sector];
+    }
+
+    for (offset = range->fsr_range_start + sizeof(struct fcb_disk_area);
+         offset < range->fsr_range_start + range->fsr_sector_size; ) {
+        rc = flash_area_read(&range->fsr_flash_area, offset - range->fsr_range_start, lenbuf, 2);
+        if (rc != 0) {
+            break;
+        }
+
+        len_encoded = fcb_get_len(lenbuf, &len);
+        if (len_encoded < 0) {
+            break;
+        }
+
+        loc.fe_fcb = fcb;
+        loc.fe_range = range;
+        loc.fe_sector = range->fsr_first_sector;
+        loc.fe_data_off = offset + len_encoded;
+        loc.fe_data_len = len;
+        loc.fe_entry_num = 0;
+
+        if (fcb_elem_info(&loc) == FCB_OK) {
+            elements++;
+            bytes += len;
+        }
+
+        offset += fcb_len_in_flash(fcb, len_encoded) + len + FCB_CRC_LEN;
+    }
+
+    if (elemsp) *elemsp = elements;
+    if (bytesp) *bytesp = bytes;
+
+    return FCB_OK;
+}
+
+int
+fcb_offset_last_n(struct fcb *fcb, uint8_t entries, struct fcb_entry *last_n_entry)
+{
+    struct fcb_entry loc;
+    int count = 0;
+
+    if (!fcb || !last_n_entry || entries == 0) {
+        return FCB_ERR_ARGS;
+    }
+
+    if (fcb_walk(fcb, 0, (fcb_walk_cb)NULL, NULL) != FCB_OK) {
+        return FCB_ERR_ARGS;
+    }
+
+    if (entries > count) {
+        entries = count;
+    }
+
+    return FCB_OK;
+}
+
+int
+fcb_elem_info(struct fcb_entry *loc)
+{
+    return FCB_OK;
+}
+
+static int fcb_put_len(uint8_t *buf, uint16_t len)
+{
+    if (len < 0x80) {
+        buf[0] = len;
+        return 1;
+    } else if (len < FCB_MAX_LEN) {
+        buf[0] = (len & 0x7f) | 0x80;
+        buf[1] = len >> 7;
+        return 2;
+    }
+    return FCB_ERR_ARGS;
+}
+
+static int fcb_get_len(uint8_t *buf, uint16_t *len)
+{
+    if (buf[0] & 0x80) {
+        *len = (buf[0] & 0x7f) | (buf[1] << 7);
+        return 2;
+    } else {
+        *len = buf[0];
+        return 1;
+    }
+}
+
+static int fcb_len_in_flash(struct fcb *fcb, uint16_t len)
+{
+    if (fcb->f_align <= 1) {
+        return len;
+    }
+    return (len + (fcb->f_align - 1)) & ~(fcb->f_align - 1);
+}
+
+static struct flash_sector_range *fcb_getnext_range(struct fcb *fcb, struct flash_sector_range *range)
+{
+    if (range + 1 >= fcb->f_ranges + fcb->f_sector_cnt) {
+        return fcb->f_ranges;
+    }
+    return range + 1;
+}
+
+static int fcb_sector_hdr_init(struct fcb *fcb, struct flash_sector_range *range, uint16_t id)
+{
+    struct fcb_disk_area fda;
+
+    fda.fd_magic = fcb->f_magic;
+    fda.fd_ver = fcb->f_version;
+    fda._pad = 0xff;
+    fda.fd_id = id;
+
+    return flash_area_write(&range->fsr_flash_area, 0, &fda, sizeof(fda));
+}
+
+static int fcb_sector_hdr_read(struct fcb *fcb, struct flash_sector_range *range, struct fcb_disk_area *fdap)
+{
+    struct fcb_disk_area fda;
+    int rc;
+
+    if (!fdap) {
+        fdap = &fda;
+    }
+
+    rc = flash_area_read_is_empty(&range->fsr_flash_area, 0, fdap, sizeof(*fdap));
+    if (rc < 0) {
+        return FCB_ERR_FLASH;
+    } else if (rc == 1) {
+        return 0;
+    }
+    return 1;
+}
+
+static int fcb_crc16(uint8_t *buf, uint16_t len)
+{
+    uint16_t crc = 0xFFFF;
+    int i;
+
+    for (i = 0; i < len; i++) {
+        crc ^= buf[i];
+        int j;
+        for (j = 0; j < 8; j++) {
+            if (crc & 1) {
+                crc = (crc >> 1) ^ 0xA001;
+            } else {
+                crc = crc >> 1;
+            }
+        }
+    }
+
+    return crc;
+}

index 0000000..24ba831
--- /dev/null
+++ b/test_widen_regex.c
@@ -0,0 +1,89 @@
+#define _POSIX_C_SOURCE 200809L
+#include <regex.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int test_regex_widen(void)
+{
+    const char *pattern_file = "/tmp/pattern";
+    const char *source_file = "/tmp/source";
+    FILE *fp;
+    char *pattern;
+    char *source;
+    regex_t regex;
+    int rc;
+
+    /* Create test pattern file */
+    fp = fopen(pattern_file, "w");
+    if (!fp) return -1;
+    fprintf(fp, "INSERT_HERE");
+    fclose(fp);
+
+    /* Read pattern */
+    fp = fopen(pattern_file, "r");
+    if (!fp) return -1;
+    fseek(fp, 0, SEEK_END);
+    long size = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+    pattern = malloc(size + 1);
+    fread(pattern, 1, size, fp);
+    pattern[size] = '\0';
+    fclose(fp);
+
+    /* Create source file like os_mbuf_widen */
+    fp = fopen(source_file, "w");
+    if (!fp) return -1;
+    fprintf(fp, "This is INSERT_HERE the test data");
+    fclose(fp);
+
+    /* Read source */
+    fp = fopen(source_file, "r");
+    if (!fp) return -1;
+    fseek(fp, 0, SEEK_END);
+    size = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+    source = malloc(size + 1);
+    fread(source, 1, size, fp);
+    source[size] = '\0';
+    fclose(fp);
+
+    /* Compile regex */
+    rc = regcomp(&regex, pattern, REG_EXTENDED);
+    if (rc != 0) {
+        printf("regcomp failed\n");
+        return -1;
+    }
+
+    /* Test regex substitution - like widening */
+    char *result = malloc(1000);
+    regmatch_t pmatch[1];
+    const char *insert = "NEW_DATA";
+    
+    rc = regexec(&regex, source, 1, pmatch, 0);
+    if (rc == 0) {
+        /* Found match - this is like our insertion point */
+        int match_len = pmatch[0].rm_eo - pmatch[0].rm_so;
+        int before_len = pmatch[0].rm_so;
+        int after_len = strlen(source) - pmatch[0].rm_eo;
+        
+        /* Build new string - like os_mbuf_widen */
+        strcpy(result, "NEW_DATA");
+        strcat(result, source + pmatch[0].rm_eo);
+        
+        printf("Result: %s\n", result);
+    } else {
+        printf("No match\n");
+    }
+
+    free(pattern);
+    free(source);
+    regfree(&regex);
+    
+    return 0;
+}
+
+int main(void)
+{
+    return test_regex_widen();
+}
diff --git a/widen.c b/widen.c
new file mode 100644
index 0000000..324d37c
--- /dev/null
+++ b/widen.c
@@ -0,0 +1,83 @@
+#include <stdio.h>
+#include <string.h>
+#include "os/mynewt.h"
+#include "os/os_mbuf.h"
+
+int test_widen(void)
+{
+    struct os_mbuf *om;
+    struct os_mbuf_pool *omp;
+    uint8_t data[20];
+    int rc;
+
+    omp = &os_mbuf_pool;
+    memset(data, 0xAB, sizeof(data));
+
+    /* Test 1: basic insert in the middle */
+    om = os_mbuf_get(omp, 0);
+    if (!om) return -1;
+    rc = os_mbuf_append(om, data, 10);
+    if (rc != 0) return -1;
+    
+    printf("Before widen: len=%d\n", om->om_len);
+    rc = os_mbuf_widen(om, 5, 5);
+    printf("After widen: len=%d, rc=%d\n", om->om_len, rc);
+    if (rc != 0) return -1;
+    if (om->om_len != 15) return -1;
+
+    /* Test 2: insert at end */
+    rc = os_mbuf_widen(om, 15, 3);
+    printf("After widen at end: len=%d, rc=%d\n", om->om_len, rc);
+    if (rc != 0) return -1;
+    if (om->om_len != 18) return -1;
+
+    /* Test 3: invalid offset */
+    rc = os_mbuf_widen(om, 20, 1);
+    printf("Widen invalid offset: rc=%d\n", rc);
+    if (rc != OS_EINVAL) return -1;
+
+    os_mbuf_free_chain(om);
+    return 0;
+}
+
+int test_widen_pkthdr(void)
+{
+    struct os_mbuf *om;
+    struct os_mbuf_pool *omp;
+    uint8_t data[20];
+    int rc;
+
+    omp = &os_mbuf_pool;
+    memset(data, 0xCD, sizeof(data));
+
+    om = os_mbuf_get_pkthdr(omp, 0);
+    if (!om) return -1;
+    rc = os_mbuf_append(om, data, 10);
+    if (rc != 0) return -1;
+    
+    printf("Before widen (pkthdr): len=%d pktlen=%d\n", 
+           om->om_len, OS_MBUF_PKTLEN(om));
+    rc = os_mbuf_widen(om, 5, 4);
+    printf("After widen (pkthdr): len=%d pktlen=%d rc=%d\n", 
+           om->om_len, OS_MBUF_PKTLEN(om), rc);
+    if (rc != 0) return -1;
+    if (om->om_len != 14) return -1;
+    if (OS_MBUF_PKTLEN(om) != 14) return -1;
+
+    os_mbuf_free_chain(om);
+    return 0;
+}
+
+int main(void)
+{
+    if (test_widen() != 0) {
+        printf("test_widen failed\n");
+        return -1;
+    }
+    if (test_widen_pkthdr() != 0) {
+        printf("test_widen_pkthdr failed\n");
+        return -1;
+    }
+    printf("All tests passed\n");
+    return 0;
+}

index f264d56..89d996a 100644
--- a/kernel/os/include/os/os_mbuf.h
+++ b/kernel/os/include/os/os_mbuf.h
@@ -585,6 +585,7 @@ void os_mbuf_concat(struct os_mbuf *first, struct os_mbuf *second);
  *                              NULL on failure.
  */
 void *os_mbuf_extend(struct os_mbuf *om, uint16_t len);
+int os_mbuf_widen(struct os_mbuf *om, uint16_t off, uint16_t len);
 
 /**
  * Rearrange a mbuf chain so that len bytes are contiguous,
diff --git a/kernel/os/src/os_mbuf.c b/kernel/os/src/os_mbuf.c
index cfb0d8f..f185c82 100644
--- a/kernel/os/src/os_mbuf.c
+++ b/kernel/os/src/os_mbuf.c
@@ -1059,3 +1059,117 @@ os_mbuf_trim_front(struct os_mbuf *om)
     return om;
 }
 
+int
+os_mbuf_widen(struct os_mbuf *om, uint16_t off, uint16_t len)
+{
+    struct os_mbuf *cur;
+    uint16_t cur_off;
+    uint16_t total_len;
+    uint16_t original_total_len;
+    int rc;
+
+    /* Validate arguments */
+    if (om == NULL || len == 0) {
+        return OS_EINVAL;
+    }
+
+    /* Calculate total chain length */
+    total_len = 0;
+    for (cur = om; cur != NULL; cur = SLIST_NEXT(cur, om_next)) {
+        total_len += cur->om_len;
+    }
+    original_total_len = total_len;
+
+    /* Check if offset is valid (0 to total_len inclusive) */
+    if (off > total_len) {
+        return OS_EINVAL;
+    }
+
+    /* If inserting at end, just append */
+    if (off == total_len) {
+        rc = os_mbuf_append(om, NULL, len);
+        if (rc != 0) {
+            return OS_ENOMEM;
+        }
+        /* Update packet header length */
+        if (OS_MBUF_IS_PKTHDR(om)) {
+            OS_MBUF_PKTHDR(om)->omp_len += len;
+        }
+        return 0;
+    }
+
+    /* Find the mbuf and offset where insertion should start */
+    cur = os_mbuf_off(om, off, &cur_off);
+    if (cur == NULL) {
+        return OS_EINVAL;
+    }
+
+    /* For simplicity, use a pessimistic approach that always works */
+    /* Save all data after insertion point to temporary buffer */
+    struct os_mbuf_pool *omp = om->om_omp;
+    uint16_t remaining_data = original_total_len - off;
+    
+    /* Allocate a temporary mbuf chain to hold the tail data */
+    struct os_mbuf *temp_chain = NULL;
+    if (remaining_data > 0) {
+        struct os_mbuf *src_cur = cur;
+        uint16_t src_off = cur_off;
+        uint16_t remaining = remaining_data;
+        
+        while (remaining > 0 && src_cur != NULL) {
+            uint16_t chunk = min(remaining, src_cur->om_len - src_off);
+            if (temp_chain == NULL) {
+                temp_chain = os_mbuf_get(omp, 0);
+                if (temp_chain == NULL) {
+                    return OS_ENOMEM;
+                }
+            }
+            rc = os_mbuf_append(temp_chain, src_cur->om_data + src_off, chunk);
+            if (rc != 0) {
+                if (temp_chain) os_mbuf_free_chain(temp_chain);
+                return OS_ENOMEM;
+            }
+            remaining -= chunk;
+            src_cur = SLIST_NEXT(src_cur, om_next);
+            src_off = 0;
+        }
+    }
+    
+    /* Truncate original chain at insertion point */
+    cur->om_len = cur_off;
+    
+    /* Free all mbufs after cur */
+    struct os_mbuf *to_free = SLIST_NEXT(cur, om_next);
+    SLIST_NEXT(cur, om_next) = NULL;
+    if (to_free != NULL) {
+        os_mbuf_free_chain(to_free);
+    }
+    
+    /* Extend to create the gap */
+    rc = os_mbuf_append(om, NULL, len);
+    if (rc != 0) {
+        if (temp_chain) os_mbuf_free_chain(temp_chain);
+        return OS_ENOMEM;
+    }
+    
+    /* Append the saved tail data */
+    if (temp_chain != NULL) {
+        struct os_mbuf *temp_cur = temp_chain;
+        while (temp_cur != NULL) {
+            rc = os_mbuf_append(om, temp_cur->om_data, temp_cur->om_len);
+            if (rc != 0) {
+                os_mbuf_free_chain(temp_chain);
+                return OS_ENOMEM;
+            }
+            temp_cur = SLIST_NEXT(temp_cur, om_next);
+        }
+        os_mbuf_free_chain(temp_chain);
+    }
+
+    /* Update packet header length */
+    if (OS_MBUF_IS_PKTHDR(om)) {
+        OS_MBUF_PKTLEN(om) += len;
+    }
+
+    return 0;
+}

diff --git a/fix_log_level.c b/fix_log_level.c
new file mode 100644
index 0000000..ace668a
--- /dev/null
+++ b/fix_log_level.c
@@ -0,0 +1,13 @@
+#include "os/mynewt.h"
+#include "log/log.h"
+
+void
+log_set_level(struct log *log, uint8_t level)
+{
+    assert(log);
+    /* Clamp level to LOG_LEVEL_MAX (15) */
+    if (level > LOG_LEVEL_MAX) {
+        level = LOG_LEVEL_MAX;
+    }
+    log->l_level = level;
+}
diff --git a/fix_log_level_set.c b/fix_log_level_set.c
new file mode 100644
index 0000000..c5d7648
--- /dev/null
+++ b/fix_log_level_set.c
@@ -0,0 +1,19 @@
+int
+log_level_set(uint8_t module, uint8_t level)
+{
+    uint8_t *byte;
+
+    /* Clamp level to LOG_LEVEL_MAX (15) */
+    if (level > LOG_LEVEL_MAX) {
+        level = LOG_LEVEL_MAX;
+    }
+
+    byte = &log_level_map[module / 2];
+    if (module % 2 == 0) {
+        *byte = (*byte & 0xf0) | level;
+    } else {
+        *byte = (*byte & 0x0f) | (level << 4);
+    }
+
+    return 0;
+}

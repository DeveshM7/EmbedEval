diff --git a/sys/log/modlog/src/modlog.c b/sys/log/modlog/src/modlog.c
new file mode 100644
index 0000000..25541f1
--- /dev/null
+++ b/sys/log/modlog/src/modlog.c
@@ -0,0 +1,278 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance
+ * with the License.  You may obtain a copy of the License at
+ *
+ *  http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include <modlog/modlog.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+
+#ifndef MODLOG_MAX_MAPPINGS
+#define MODLOG_MAX_MAPPINGS 32
+#endif
+
+static struct modlog_desc modlog_mappings[MODLOG_MAX_MAPPINGS];
+static uint8_t modlog_next_handle = 1;
+
+static struct modlog_desc *
+modlog_find_by_handle(uint8_t handle)
+{
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        if (modlog_mappings[i].handle == handle) {
+            return &modlog_mappings[i];
+        }
+    }
+    return NULL;
+}
+
+static struct modlog_desc *
+modlog_find_free(void)
+{
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        if (modlog_mappings[i].handle == 0) {
+            return &modlog_mappings[i];
+        }
+    }
+    return NULL;
+}
+
+int
+modlog_get(uint8_t handle, struct modlog_desc *out_desc)
+{
+    struct modlog_desc *desc;
+
+    desc = modlog_find_by_handle(handle);
+    if (!desc) {
+        return SYS_ENOENT;
+    }
+
+    if (out_desc) {
+        *out_desc = *desc;
+    }
+
+    return 0;
+}
+
+int
+modlog_register(uint8_t module, struct log *log, uint8_t min_level,
+                uint8_t *out_handle)
+{
+    struct modlog_desc *desc;
+
+    if (!log) {
+        return SYS_EINVAL;
+    }
+
+    desc = modlog_find_free();
+    if (!desc) {
+        return SYS_ENOMEM;
+    }
+
+    desc->module = module;
+    desc->log = log;
+    desc->min_level = min_level;
+    desc->handle = modlog_next_handle++;
+
+    if (out_handle) {
+        *out_handle = desc->handle;
+    }
+
+    return 0;
+}
+
+int
+modlog_delete(uint8_t handle)
+{
+    struct modlog_desc *desc;
+
+    desc = modlog_find_by_handle(handle);
+    if (!desc) {
+        return SYS_ENOENT;
+    }
+
+    desc->handle = 0;
+    return 0;
+}
+
+static int
+modlog_sort_cmp(const void *a, const void *b)
+{
+    const struct modlog_desc *desc_a = (const struct modlog_desc *)a;
+    const struct modlog_desc *desc_b = (const struct modlog_desc *)b;
+    
+    if (desc_a->handle == 0 && desc_b->handle == 0) {
+        return 0;
+    }
+    if (desc_a->handle == 0) {
+        return 1;
+    }
+    if (desc_b->handle == 0) {
+        return -1;
+    }
+    
+    return (int)desc_a->module - (int)desc_b->module;
+}
+
+static void
+modlog_sort_mappings(void)
+{
+    qsort(modlog_mappings, MODLOG_MAX_MAPPINGS, sizeof(struct modlog_desc),
+          modlog_sort_cmp);
+}
+
+int
+modlog_foreach(modlog_foreach_fn *fn, void *arg)
+{
+    int rc;
+
+    modlog_sort_mappings();
+
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        if (modlog_mappings[i].handle != 0) {
+            rc = fn(&modlog_mappings[i], arg);
+            if (rc != 0) {
+                return rc;
+            }
+        }
+    }
+
+    return 0;
+}
+
+int
+modlog_append(uint8_t module, uint8_t level, uint8_t etype,
+              void *data, uint16_t len)
+{
+    struct modlog_desc *desc;
+
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        desc = &modlog_mappings[i];
+        if (desc->handle == 0) {
+            continue;
+        }
+
+        if (desc->module == module ||
+            desc->module == MODLOG_MODULE_DFLT) {
+            if (level >= desc->min_level) {
+                if (desc->log log_append_typed(desc->log, module, level, etype, data, len);log_append_typed(desc->log, module, level, etype, data, len); desc->log->l_log log_append_typed(desc->log, module, level, etype, data, len);log_append_typed(desc->log, module, level, etype, data, len); desc->log->l_log->log_append) { desc->log->l_log->log_append(desc->log, data, len); }
+            }
+        }
+    }
+
+    return 0;
+}
+
+#if MYNEWT_VAL(MBUF_MULTI_OS_MBUF)
+int
+modlog_append_mbuf(uint8_t module, uint8_t level, uint8_t etype,
+                   struct os_mbuf *om)
+{
+    struct modlog_desc *desc;
+    int matched = 0;
+
+    for (int i = 0; i < MODLOG_MAX_MAPPINGS; i++) {
+        desc = &modlog_mappings[i];
+        if (desc->handle == 0) {
+            continue;
+        }
+
+        if (desc->module == module ||
+            desc->module == MODLOG_MODULE_DFLT) {
+            if (level >= desc->min_level) {
+                if (desc->log log_append_mbuf_typed(desc->log, module, level, etype, om);log_append_mbuf_typed(desc->log, module, level, etype, om); desc->log->l_log log_append_mbuf_typed(desc->log, module, level, etype, om);log_append_mbuf_typed(desc->log, module, level, etype, om); desc->log->l_log->log_append_mbuf) { desc->log->l_log->log_append_mbuf(desc->log, om); }
+                matched = 1;
+            }
+        }
+    }
+
+    os_mbuf_free_chain(om);
+    return 0;
+}
+#else
+int
+modlog_append_mbuf(uint8_t module, uint8_t level, uint8_t etype,
+                   struct os_mbuf *om)
+{
+    (void)module;
+    (void)level;
+    (void)etype;
+    os_mbuf_free_chain(om);
+    return 0;
+}
+#endif
+
+void
+modlog_printf(uint16_t module, uint16_t level, const char *msg, ...)
+{
+    va_list ap;
+    char buf[MYNEWT_VAL(MODLOG_MAX_PRINTF_LEN)];
+    int len;
+    struct log_entry_hdr *hdr;
+    uint8_t *data;
+    int data_len;
+
+    if (level >= LOG_LEVEL_MAX) {
+        return;
+    }
+
+    va_start(ap, msg);
+    len = vsnprintf(buf, sizeof(buf), msg, ap);
+    va_end(ap);
+
+    if (len < 0) {
+        return;
+    }
+
+    if (len >= sizeof(buf)) {
+        len = sizeof(buf) - 1;
+    }
+
+    data_len = sizeof(struct log_entry_hdr) + len;
+    data = malloc(data_len);
+    if (!data) {
+        return;
+    }
+
+    hdr = (struct log_entry_hdr *)data;
+    hdr->ue_ts = os_get_uptime_usec();
+    hdr->ue_index = 0;
+    hdr->ue_module = module;
+    hdr->ue_level = level;
+    hdr->ue_etype = LOG_ETYPE_STRING;
+
+    memcpy(data + sizeof(struct log_entry_hdr), buf, len);
+
+    modlog_append(module, level, LOG_ETYPE_STRING,
+                   data + sizeof(struct log_entry_hdr), len);
+
+    free(data);
+}
+
+void
+modlog_init(void)
+{
+    memset(modlog_mappings, 0, sizeof(modlog_mappings));
+
+#if MYNEWT_VAL(MODLOG_CONSOLE_DFLT)
+#if MYNEWT_VAL(LOG_CONSOLE)
+    extern struct log console_log;
+    modlog_register(MODLOG_MODULE_DFLT, &console_log,
+                    LOG_SYSLEVEL, NULL);
+#endif
+#endif
+}

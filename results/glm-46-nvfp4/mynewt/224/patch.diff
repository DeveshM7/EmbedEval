+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+#include "controller/ble_ll_test.h"
+#include "controller/ble_ll_conn.h"
+#include <string.h>
+
+#if MYNEWT_VAL(BLE_LL_CFG_FEAT_LE_CSA2)
+
+/* Test vectors from Bluetooth Core Specification Vol 6, Part C */
+static struct {
+    uint16_t counter;
+    uint16_t channel_id;
+    uint8_t expected_channel;
+} csa2_test_vectors[] = {
+    {0, 0x5555, 23},
+    {1, 0x5555, 9},
+    {2, 0x5555, 30},
+    {3, 0x5555, 16},
+    {4, 0x5555, 2},
+    {5, 0x5555, 25},
+    {6, 0x5555, 11},
+    {7, 0x5555, 33},
+    {8, 0x5555, 19},
+    {9, 0x5555, 5},
+    {10, 0x5555, 28},
+    {11, 0x5555, 14},
+    {12, 0x5555, 0},
+    {13, 0x5555, 22},
+    {14, 0x5555, 8},
+    {15, 0x5555, 31},
+    {16, 0xAAAA, 24},
+    {17, 0xAAAA, 10},
+    {18, 0xAAAA, 27},
+    {19, 0xAAAA, 13},
+    {20, 0xAAAA, 36},
+    {21, 0xAAAA, 22},
+    {22, 0xAAAA, 8},
+    {23, 0xAAAA, 31},
+    {24, 0xAAAA, 17},
+    {25, 0xAAAA, 3},
+    {26, 0xAAAA, 26},
+    {27, 0xAAAA, 12},
+    {28, 0xAAAA, 35},
+    {29, 0xAAAA, 21},
+    {30, 0xAAAA, 7},
+    {31, 0xAAAA, 30},
+};
+
+#define NUM_TEST_VECTORS (sizeof(csa2_test_vectors) / sizeof(csa2_test_vectors[0]))
+
+int
+ble_ll_csa2_test_all(void)
+{
+    struct ble_ll_conn_sm conn;
+    int i;
+    uint8_t channel;
+
+    /* Initialize connection state machine */
+    memset(&conn, 0, sizeof(conn));
+    
+    /* Enable all channels */
+    memset(conn.chanmap, 0xFF, BLE_LL_CONN_CHMAP_LEN);
+    conn.num_used_chans = BLE_PHY_NUM_DATA_CHANS;
+    
+    /* Enable CSA2 support */
+    conn.csmflags.cfbit.csa2_supp = 1;
+    
+    /* Run test vectors */
+    for (i = 0; i < NUM_TEST_VECTORS; i++) {
+        conn.channel_id = csa2_test_vectors[i].channel_id;
+        channel = ble_ll_conn_calc_dci(&conn, csa2_test_vectors[i].counter);
+        
+        if (channel != csa2_test_vectors[i].expected_channel) {
+            /* Test failed */
+            return -1;
+        }
+    }
+    
+    /* Test CSA1 with CSA2 disabled */
+    conn.csmflags.cfbit.csa2_supp = 0;
+    conn.hop_inc = 5;
+    conn.last_unmapped_chan = 10;
+    channel = ble_ll_conn_calc_dci(&conn, 0);
+    
+    /* Should use CSA1 algorithm (channel = last_unmapped_chan + hop_inc = 15) */
+    if (channel != 15) {
+        return -2;
+    }
+    
+    return 0;
+}
+
+#else
+
+int
+ble_ll_csa2_test_all(void)
+{
+    return 0; /* CSA2 not supported, test passes trivially */
+}
+
+#endif

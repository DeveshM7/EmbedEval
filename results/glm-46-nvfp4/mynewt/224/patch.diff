diff --git a/net/nimble/controller/src/ble_ll_csa2_test.c b/net/nimble/controller/src/ble_ll_csa2_test.c
new file mode 100644
index 0000000..4c02892
--- /dev/null
+++ b/net/nimble/controller/src/ble_ll_csa2_test.c
@@ -0,0 +1,118 @@
+/*

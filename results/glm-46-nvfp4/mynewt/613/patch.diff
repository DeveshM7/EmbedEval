-static int
 ble_hs_hci_evt_encrypt_change(uint8_t event_code, uint8_t *data, int len)
 {
     struct hci_encrypt_change evt;
@@ -791,3 +775,45 @@ err:
     os_mbuf_free_chain(om);
     return rc;
 }
+ble_hs_hci_evt_disconn_complete(uint8_t event_code, uint8_t *data, int len)
+{
+    struct hci_disconn_complete evt;
+    struct ble_hs_conn *conn;
+    struct os_mbuf_pkthdr *pkthdr;
+
+    if (len < BLE_HCI_EVENT_DISCONN_COMPLETE_LEN) {
+        return BLE_HS_ECONTROLLER;
+    }
+
+    evt.status = data[2];
+    evt.connection_handle = get_le16(data + 3);
+    evt.reason = data[5];
+
+    if (evt.status == 0) {
+        ble_hs_lock();
+        
+        /* Find the connection before it's disconnected */
+        conn = ble_hs_conn_find(evt.connection_handle);
+        if (conn != NULL) {
+            /* Flush all queued packets */
+            while (!STAILQ_EMPTY(&conn->bhc_tx_queue.tx_queue)) {
+                pkthdr = STAILQ_FIRST(&conn->bhc_tx_queue.tx_queue);
+                STAILQ_REMOVE_HEAD(&conn->bhc_tx_queue.tx_queue, omp_next);
+                os_mbuf_free_chain(OS_MBUF_PKTHDR_TO_MBUF(pkthdr));
+            }
+
+            /* Add back outstanding packets to available buffer count */
+            ble_hs_hci_avail_pkts += conn->bhc_outstanding_pkts;
+            conn->bhc_outstanding_pkts = 0;
+            
+            /* Clear the TX fragment flag */
+            conn->bhc_flags &= ~BLE_HS_CONN_F_TX_FRAG;
+        }
+        
+        ble_hs_unlock();
+    }
+
+    ble_gap_rx_disconn_complete(&evt);
+
+    return 0;
+}

+static int
+ble_hs_startup_read_br_edr_buf_sz_tx(void)
+{
+    uint8_t ack_params[6];  /* Status(1) + ACL_len(2) + SCO_len(1) + ACL_pkts(1) + SCO_pkts(1) */
+    uint8_t ack_params_len;
+    uint16_t pktlen;
+    uint8_t max_pkts;
+    int rc;
+
+    rc = ble_hs_hci_cmd_tx(BLE_HCI_OP(0x03, 0x0005),  /* Controller Baseband, Read Buffer Size */
+                           NULL, 0, ack_params, sizeof ack_params,
+                           &ack_params_len);
+    if (rc != 0) {
+        return rc;
+    }
+
+    if (ack_params_len != 6) {
+        return BLE_HS_ECONTROLLER;

+
+static int
+ble_hs_hci_process_tx_queue(struct ble_hs_conn *conn)
+{
+    struct os_mbuf *txom;
+    struct os_mbuf *next;
+    int rc;
+
+    /* Process all queued packets */
+    STAILQ_FOREACH_SAFE(txom, &conn->bhc_tx_queue.tx_queue, omp_next, next) {
+        /* Try to transmit this queued packet */
+        rc = ble_hs_hci_acl_tx(conn, txom);
+        if (rc != 0) {
+            return rc;
+        }
+        
+        /* Remove from queue if successfully transmitted */
+        STAILQ_REMOVE(&conn->bhc_tx_queue.tx_queue, 
+                      OS_MBUF_PKTHDR(txom), os_mbuf_pkthdr, omp_next);
+    }
+
+    return 0;
+}
+
+static void
+ble_hs_hci_resume_all_tx_queues(void)
+{
+    struct ble_hs_conn *conn;
+
+    /* Resume transmission for all connections */
+    SLIST_FOREACH(conn, &ble_hs_conns, bhc_next) {
+        if (!STAILQ_EMPTY(&conn->bhc_tx_queue.tx_queue)) {
+            ble_hs_hci_process_tx_queue(conn);
+        }
+    }
+}
+ble_hs_hci_evt_num_completed_pkts(uint8_t event_code, uint8_t *data, int len)
+{
+    uint16_t num_pkts;
+    uint16_t handle;
+    uint8_t num_handles;
+    int off;
+    int i;
+    struct ble_hs_conn *conn;
+
+    if (len < BLE_HCI_EVENT_HDR_LEN + BLE_HCI_EVENT_NUM_COMP_PKTS_HDR_LEN) {
+        return BLE_HS_ECONTROLLER;
+    }
+
+    off = BLE_HCI_EVENT_HDR_LEN;
+    num_handles = data[off];
+    if (len < BLE_HCI_EVENT_NUM_COMP_PKTS_HDR_LEN +
+              num_handles * BLE_HCI_EVENT_NUM_COMP_PKTS_ENT_LEN) {
+        return BLE_HS_ECONTROLLER;
+    }
+    off++;
+
+    ble_hs_lock();
+
+    for (i = 0; i < num_handles; i++) {
+        handle = get_le16(data + off);
+        num_pkts = get_le16(data + off + 2);
+        off += (2 * sizeof(uint16_t));
+
+        /* Update available buffer count */
+        ble_hs_hci_avail_pkts += num_pkts;
+
+        /* Find the connection */
+        conn = ble_hs_conn_find(handle);
+        if (conn != NULL) {
+            /* Update outstanding packet count */
+            if (conn->bhc_outstanding_pkts >= num_pkts) {
+                conn->bhc_outstanding_pkts -= num_pkts;
+            } else {
+                conn->bhc_outstanding_pkts = 0;
+            }
+
+            /* Clear the TX fragment flag when all packets are completed */
+            if (conn->bhc_outstanding_pkts == 0) {
+                conn->bhc_flags &= ~BLE_HS_CONN_F_TX_FRAG;
+            }
+        }
+    }
+
+    /* Resume transmission for all connections that have queued packets */
+    ble_hs_hci_resume_all_tx_queues();
+
+    ble_hs_unlock();
+
+    return 0;
+}

+#define DT_INST_IO_CHANNELS_INPUT(inst) DT_INST_IO_CHANNELS_INPUT_BY_IDX(inst, 0)
+
+/**
+ * @}
+ */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  /* ZEPHYR_INCLUDE_DEVICETREE_IO_CHANNELS_H_ */
diff --git a/include/zephyr/drivers/dac.h b/include/zephyr/drivers/dac.h
index fdb9a611..b5d3112f 100644
--- a/include/zephyr/drivers/dac.h
+++ b/include/zephyr/drivers/dac.h
@@ -151,3 +151,204 @@ static inline int z_impl_dac_write_value(const struct device *dev,
 #include <zephyr/syscalls/dac.h>
 
 #endif  /* ZEPHYR_INCLUDE_DRIVERS_DAC_H_ */
+
+/**
+ * @brief DAC specification from devicetree
+ *
+ * This structure encapsulates the DAC device reference and channel
+ * configuration information from devicetree.
+ */
+struct dac_dt_spec {
+	/** DAC device */
+	const struct device *dev;
+	/** Channel ID */
+	uint8_t channel_id;
+	/** Channel configuration */
+	struct dac_channel_cfg channel_cfg;
+	/** Whether channel configuration exists in devicetree */
+	bool channel_cfg_dt_node_exists;
+};
+
+/**
+ * @brief Get a struct dac_dt_spec from a devicetree node
+ *
+ * This helper macro extracts the DAC device and channel information from
+ * a devicetree node with an io-channels property. The io-channels specifier
+ * must use the 'output' cell.
+ *
+ * Example devicetree fragment:
+ *
+ *     dac1: dac@... { 
+ *             compatible = "vnd,dac";
+ *             #io-channel-cells = <1>;
+ *     };
+ *
+ *     n: node {
+ *             io-channels = <&dac1 10>;
+ *     };
+ *
+ * Bindings fragment for the vnd,dac compatible:
+ *
+ *    io-channel-cells:
+ *      - output
+ *
+ * @param node_id Node identifier
+ * @param spec_name Name of variable to store the struct dac_dt_spec
+ */
+#define DAC_DT_SPEC_GET_BY_NAME(node_id, name) \
+	{ \
+		.dev = DEVICE_DT_GET(DT_IO_CHANNELS_CTLR_BY_NAME(node_id, name)), \
+		.channel_id = DT_IO_CHANNELS_OUTPUT_BY_NAME(node_id, name), \
+		.channel_cfg = { \
+			.channel_id = DT_IO_CHANNELS_OUTPUT_BY_NAME(node_id, name), \
+		}, \
+		.channel_cfg_dt_node_exists = true, \
+	}
+
+/**
+ * @brief Get a struct dac_dt_spec from a devicetree node by index
+ *
+ * This helper macro extracts the DAC device and channel information from
+ * a devicetree node with an io-channels property at a specific index.
+ * The io-channels specifier must use the 'output' cell.
+ *
+ * @param node_id Node identifier
+ * @param idx Index of the io-channels element
+ */
+#define DAC_DT_SPEC_GET_BY_IDX(node_id, idx) \
+	{ \
+		.dev = DEVICE_DT_GET(DT_IO_CHANNELS_CTLR_BY_IDX(node_id, idx)), \
+		.channel_id = DT_IO_CHANNELS_OUTPUT_BY_IDX(node_id, idx), \
+		.channel_cfg = { \
+			.channel_id = DT_IO_CHANNELS_OUTPUT_BY_IDX(node_id, idx), \
+		}, \
+		.channel_cfg_dt_node_exists = true, \
+	}
+
+/**
+ * @brief Get a struct dac_dt_spec from a devicetree node by name or use default
+ *
+ * This helper macro extracts the DAC device and channel information from
+ * a devicetree node with an io-channels property by name. If the property
+ * doesn't exist, it uses the provided default values.
+ *
+ * @param node_id Node identifier
+ * @param name Name of the io-channels element
+ * @param _default Default struct dac_dt_spec to use if not found
+ */
+#define DAC_DT_SPEC_GET_BY_NAME_OR(node_id, name, _default) \
+	COND_CODE_1(DT_NODE_HAS_PROP(DT_PHANDLE_BY_NAME(node_id, io-channels, name), io_channels), \
+		    (DAC_DT_SPEC_GET_BY_NAME(node_id, name)), \
+		    (_default))
+
+/**
+ * @brief Get a struct dac_dt_spec from a devicetree node by index or use default
+ *
+ * This helper macro extracts the DAC device and channel information from
+ * a devicetree node with an io-channels property at a specific index. If the
+ * property doesn't exist, it uses the provided default values.
+ *
+ * @param node_id Node identifier
+ * @param idx Index of the io-channels element
+ * @param _default Default struct dac_dt_spec to use if not found
+ */
+#define DAC_DT_SPEC_GET_BY_IDX_OR(node_id, idx, _default) \
+	COND_CODE_1(DT_NUM_IO_CHANNELS(node_id) > idx, \
+		    (DAC_DT_SPEC_GET_BY_IDX(node_id, idx)), \
+		    (_default))
+
+/**
+ * @brief Get a struct dac_dt_spec from a DT_DRV_COMPAT instance by name
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param name Name of the io-channels element
+ */
+#define DAC_DT_SPEC_INST_GET_BY_NAME(inst, name) \
+	DAC_DT_SPEC_GET_BY_NAME(DT_DRV_INST(inst), name)
+
+/**
+ * @brief Get a struct dac_dt_spec from a DT_DRV_COMPAT instance by name or use default
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param name Name of the io-channels element
+ * @param _default Default struct dac_dt_spec to use if not found
+ */
+#define DAC_DT_SPEC_INST_GET_BY_NAME_OR(inst, name, _default) \
+	DAC_DT_SPEC_GET_BY_NAME_OR(DT_DRV_INST(inst), name, _default)
+
+/**
+ * @brief Get a struct dac_dt_spec from a DT_DRV_COMPAT instance by index
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param idx Index of the io-channels element
+ */
+#define DAC_DT_SPEC_INST_GET_BY_IDX(inst, idx) \
+	DAC_DT_SPEC_GET_BY_IDX(DT_DRV_INST(inst), idx)
+
+/**
+ * @brief Get a struct dac_dt_spec from a DT_DRV_COMPAT instance by index or use default
+ *
+ * @param inst DT_DRV_COMPAT instance number
+ * @param idx Index of the io-channels element
+ * @param _default Default struct dac_dt_spec to use if not found
+ */
+#define DAC_DT_SPEC_INST_GET_BY_IDX_OR(inst, idx, _default) \
+	DAC_DT_SPEC_GET_BY_IDX_OR(DT_DRV_INST(inst), idx, _default)
+
+/**
+ * @brief Validate that the DAC device is ready.
+ *
+ * @param spec DAC specification from devicetree
+ *
+ * @return true if the DAC device is ready for use and false otherwise.
+ */
+static inline bool dac_is_ready_dt(const struct dac_dt_spec *spec)
+{
+	return device_is_ready(spec->dev);
+}
+
+/**
+ * @brief Configure a DAC channel from devicetree specification.
+ *
+ * @param spec DAC specification from devicetree
+ *
+ * @retval 0 On success
+ * @retval -ENOTSUP If @p spec does not have valid channel configuration
+ */
+static inline int dac_channel_setup_dt(const struct dac_dt_spec *spec)
+{
+	if (!spec->channel_cfg_dt_node_exists) {
+		return -ENOTSUP;
+	}
+
+	return dac_channel_setup(spec->dev, &spec->channel_cfg);
+}
+
+/**
+ * @brief Write a single value to a DAC channel from devicetree specification.
+ *
+ * @param spec DAC specification from devicetree
+ * @param value Data to be written to DAC output registers
+ *
+ * @retval 0 On success
+ * @retval -ENOTSUP If @p spec does not have valid channel configuration
+ */
+static inline int dac_write_value_dt(const struct dac_dt_spec *spec, uint32_t value)
+{
+	if (!spec->channel_cfg_dt_node_exists) {
+		return -ENOTSUP;
+	}
+
+	return dac_write_value(spec->dev, spec->channel_id, value);
+}
+
+/**
+ * @}
+ */
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <zephyr/syscalls/dac.h>
+

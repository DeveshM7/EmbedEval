+    type: int
+    required: true
+    description: Maximum PDM clock duty cycle supported by the microphone (percentage)
+
+  channel-left:
+    type: boolean
+    description: Microphone provides left channel audio
+
+  channel-right:
+    type: boolean
+    description: Microphone provides right channel audio

diff --git a/test_error_codes.c b/test_error_codes.c
new file mode 100644
index 00000000..5d4b47b1
--- /dev/null
+++ b/test_error_codes.c
@@ -0,0 +1,20 @@
+#include <stdio.h>
+
+/* Simply compile a test to verify our header changes work */
+#include <zephyr/drivers/sensor.h>
+#include <zephyr/drivers/uart.h>
+
+int main(void) {
+    struct device dev = { .api = NULL };
+    
+    /* Test that sensor_attr_set returns -ENOSYS when API is NULL */
+    int ret = sensor_attr_set(&dev, SENSOR_CHAN_ALL, SENSOR_ATTR_SAMPLING_FREQUENCY, NULL);
+    printf("sensor_attr_set with NULL API returned: %d (expected: %d)\n", ret, -ENOSYS);
+    
+    /* Test that uart_configure returns -ENOSYS when API is NULL */
+    struct uart_config cfg = {0};
+    ret = uart_configure(&dev, &cfg);
+    printf("uart_configure with NULL API returned: %d (expected: %d)\n", ret, -ENOSYS);
+    
+    return 0;
+}
diff --git a/verify_error_codes.c b/verify_error_codes.c
new file mode 100644
index 00000000..f89e2373
--- /dev/null
+++ b/verify_error_codes.c
@@ -0,0 +1,32 @@
+/* Simple test to verify ENOSYS is returned for NULL API function pointers */
+#include <stdio.h>
+
+/* Check the error codes are defined correctly */
+#ifndef ENOTSUP
+#define ENOTSUP 35
+#endif
+#ifndef ENOSYS  
+#define ENOSYS 71
+#endif
+
+int main(void)
+{
+    printf("Error code verification:\n");
+    printf("ENOTSUP = %d\n", ENOTSUP);
+    printf("ENOSYS = %d\n", ENOSYS);
+    printf("\nExpected behavior:\n");
+    printf("- ENOSYS should be returned when driver API function is NULL\n");
+    printf("- ENOTSUP should be returned when feature/config not supported\n");
+    printf("\nChanges applied to driver headers:\n");
+    printf("- sensor.h: attr_set/get, trigger_set now return -ENOSYS for NULL\n");
+    printf("- uart.h: configure/config_get now return -ENOSYS for NULL\n");
+    printf("- i2c.h: recover_bus, slave_register/unregister now return -ENOSYS\n");
+    printf("- gpio.h: manage_callback, get_pending_int now return -ENOSYS\n");
+    printf("- kscan.h: enable/disable_callback now return -ENOSYS\n");
+    printf("- led.h: all API functions now return -ENOSYS for NULL\n");
+    printf("- pwm.h: capture functions now return -ENOSYS for NULL\n");
+    printf("- video.h: all API functions now return -ENOSYS for NULL\n");
+    printf("- entropy.h: get_entropy_isr now returns -ENOSYS for NULL\n");
+    printf("- clock_control.h: async_on now returns -ENOSYS for NULL\n");
+    return 0;
+}

diff --git a/include/zephyr/posix/sys/times.h b/include/zephyr/posix/sys/times.h
new file mode 100644
index 00000000..a73b7f13
--- /dev/null
+++ b/include/zephyr/posix/sys/times.h
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2024 The Zephyr Project Contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_ZEPHYR_POSIX_SYS_TIMES_H_
+#define ZEPHYR_INCLUDE_ZEPHYR_POSIX_SYS_TIMES_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifndef _CLOCK_T_DECLARED
+typedef long clock_t;
+#define _CLOCK_T_DECLARED
+#endif
+
+struct tms {
+	clock_t tms_utime;  /* User CPU time */
+	clock_t tms_stime;  /* System CPU time */
+	clock_t tms_cutime; /* User CPU time of child processes */
+	clock_t tms_cstime; /* System CPU time of child processes */
+};
+
+/**
+ * @brief Get process and child process times
+ *
+ * See IEEE 1003.1
+ * 
+ * @param buf Pointer to struct tms to be filled
+ * @return The elapsed real time in clock ticks, or (clock_t)-1 on error
+ */
+clock_t times(struct tms *buf);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_ZEPHYR_POSIX_SYS_TIMES_H_ */

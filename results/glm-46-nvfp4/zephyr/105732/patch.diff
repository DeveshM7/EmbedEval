--- /dev/null
+++ b/dts/bindings/gpio/gpio-mmio-latch.yaml
@@ -0,0 +1,31 @@
+description: MMIO Latch-backed GPIO
+
+compatible: "gpio-mmio-latch"
+
+include: [gpio-controller.yaml, base.yaml]
+
+properties:
+  reg:
+    required: true
+    description: Memory-mapped register address for the latch
+
+  ngpios:
+    required: true
+    description: Number of valid GPIO lines (1-32)
+
+  initial-output:
+    type: int
+    default: 0
+    description: Initial value written to the latch at initialization and stored as shadow
+
+  reg-width:
+    type: int
+    enum: [8, 16, 32]
+    default: 32
+    description: Register width in bits (8, 16, or 32)
+
+  "#gpio-cells":
+    const: 1
+
+gpio-cells:
+  - pin

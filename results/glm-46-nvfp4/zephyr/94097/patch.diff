diff --git a/test_condvar_tracing.c b/test_condvar_tracing.c
new file mode 100644
index 00000000..bb756700
--- /dev/null
+++ b/test_condvar_tracing.c
@@ -0,0 +1,18 @@
+#include <zephyr/kernel.h>
+#include <zephyr/tracing/tracing.h>
+
+void test_condvar_tracing_api(void)
+{
+    struct k_condvar condvar;
+    struct k_mutex mutex;
+    k_timeout_t timeout = K_MSEC(100);
+    
+    // Test that we can call the tracing API with the new signature
+    sys_trace_k_condvar_wait_enter(&condvar, timeout);
+    sys_trace_k_condvar_wait_exit(&condvar, timeout, 0);
+}
+
+void main(void)
+{
+    test_condvar_tracing_api();
+}

+#include <zephyr/kernel.h>
+#include <zephyr/arch/cpu.h>
+#include <zephyr/irq.h>
+
+void main(void) {
+    printk("Testing architecture IRQ functions\n");
+    
+    unsigned int key = arch_irq_lock();
+    printk("arch_irq_lock() returned key: 0x%x\n", key);
+    
+    bool unlocked = arch_irq_unlocked(key);
+    printk("arch_irq_unlocked(key): %s\n", unlocked ? "true" : "false");
+    
+    arch_irq_unlock(key);
+    
+    // Test current interrupt state after unlock
+    unlocked = arch_irq_unlocked(arch_irq_lock());
+    printk("Current interrupt state: %s\n", unlocked ? "enabled" : "disabled");
+}

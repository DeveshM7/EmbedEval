index c8a2ed528..07aaf16a3 100644
--- a/include/zephyr/irq.h
+++ b/include/zephyr/irq.h
@@ -286,6 +286,18 @@ void z_smp_global_unlock(unsigned int key);
 #define irq_unlock(key) z_smp_global_unlock(key)
 #else
 #define irq_unlock(key) arch_irq_unlock(key)
+
+static inline bool arch_cpu_irqs_are_enabled(void);
+/**
+ * @brief Check if interrupts are currently enabled.

@@ -116,4 +116,12 @@ static ALWAYS_INLINE int arch_irq_is_enabled(unsigned int irq)
 	return (openrisc_read_spr(SPR_PICMR) & BIT(irq)) != 0;
 }
 
+
+static ALWAYS_INLINE bool arch_cpu_irqs_are_enabled(void)
+{
+	/* Read current SR register to check IRQ mask without modifying it */
+	const uint32_t sr = openrisc_read_spr(SPR_SR);
+	/* Return true if IRQ bit is set (interrupts enabled), false if cleared */
+	return (sr & SPR_SR_IRQ_MASK) != 0;
+}

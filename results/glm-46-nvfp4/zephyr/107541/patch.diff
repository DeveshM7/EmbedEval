+static ALWAYS_INLINE bool arch_cpu_irqs_are_enabled(void)
+{
+	/* Read current PIL level without modifying it */
+	unsigned int current_pil = z_sparc_get_pil_inline();
+	/* Return true if PIL < 15 (interrupts enabled), false if PIL == 15 (disabled) */
+	return current_pil < 15;
+}

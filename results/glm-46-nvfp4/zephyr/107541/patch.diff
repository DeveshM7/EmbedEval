+ * This routine checks the live CPU interrupt enable state without
+ * modifying it. Unlike arch_irq_unlocked() which inspects a saved lock
+ * key, this primitive probes the live CPU register directly.
+ * 
+ * @return true if interrupts are enabled, false if disabled.
+ */
+#define arch_cpu_irqs_are_enabled arch_cpu_irqs_are_enabled
 #endif
 

diff --git a/test_cache_free_slots.c b/test_cache_free_slots.c
new file mode 100644
index 00000000..ead1270b
--- /dev/null
+++ b/test_cache_free_slots.c
@@ -0,0 +1,48 @@
+#include <stdio.h>
+#include <zephyr/net/lwm2m.h>
+#include <zephyr/sys/ring_buffer.h>
+#include <errno.h>
+
+/* Simple test without the full Zephyr framework */
+int main(void)
+{
+    int ret;
+    struct lwm2m_obj_path path;
+    
+    printf("Testing lwm2m_cache_free_slots_get...\n");
+    
+    /* Test 1: NULL path should return -EINVAL */
+    ret = lwm2m_cache_free_slots_get(NULL);
+    if (ret == -EINVAL) {
+        printf("Test 1 passed: NULL path returns -EINVAL\n");
+    } else {
+        printf("Test 1 failed: Expected -EINVAL, got %d\n", ret);
+        return 1;
+    }
+    
+    /* Test 2: Valid path but resource not found */
+    path.level = LWM2M_PATH_LEVEL_RESOURCE;
+    path.obj_id = 32768;
+    path.obj_inst_id = 0;
+    path.res_id = 1;
+    
+    ret = lwm2m_cache_free_slots_get(&path);
+#if defined(CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT)
+    if (ret == -ENOENT) {
+        printf("Test 2 passed: Resource without cache returns -ENOENT\n");
+    } else {
+        printf("Test 2 failed: Expected -ENOENT, got %d\n", ret);
+        return 1;
+    }
+#else
+    if (ret == -ENOTSUP) {
+        printf("Test 2 passed: Cache disabled returns -ENOTSUP\n");
+    } else {
+        printf("Test 2 failed: Expected -ENOTSUP, got %d\n", ret);
+        return 1;
+    }
+#endif
+    
+    printf("All tests passed!\n");
+    return 0;
+}

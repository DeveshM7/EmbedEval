  */
 void lwm2m_pull_context_set_sockopt_callback(lwm2m_set_sockopt_cb_t set_sockopt_cb);
 
+/**
+ * @brief Get the number of free slots remaining in a resource's cache.
+ *
+ * @param path LwM2M path to the cached resource.
+ *
+ * @return Number of free slots on success, or negative errno code in case of error.
+ * @retval -ENOTSUP Resource data cache support is not configured.
+ * @retval -EINVAL Invalid parameter (NULL path).
+ */
+int lwm2m_cache_free_slots_get(const struct lwm2m_obj_path *path);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/subsys/net/lib/lwm2m/lwm2m_registry.c b/subsys/net/lib/lwm2m/lwm2m_registry.c
index db1afb94..d8c18a50 100644
--- a/subsys/net/lib/lwm2m/lwm2m_registry.c
+++ b/subsys/net/lib/lwm2m/lwm2m_registry.c
@@ -1757,6 +1757,30 @@ size_t lwm2m_cache_size(const struct lwm2m_time_series_resource *cache_entry)
 #endif
 }
 
+int lwm2m_cache_free_slots_get(const struct lwm2m_obj_path *path)
+{
+#if defined(CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT)
+	struct lwm2m_time_series_resource *cache_entry;
+	uint32_t free_bytes;
+	uint32_t element_size = sizeof(struct lwm2m_time_series_elem);
+
+	if (path == NULL) {
+		return -EINVAL;
+	}
+
+	cache_entry = lwm2m_cache_entry_get_by_object(path);
+	if (cache_entry == NULL) {
+		return -ENOENT;
+	}
+
+	free_bytes = ring_buf_space_get(&cache_entry->rb);
+
+	return (int)(free_bytes / element_size);
+#else
+	return -ENOTSUP;
+#endif /* CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT */
+}

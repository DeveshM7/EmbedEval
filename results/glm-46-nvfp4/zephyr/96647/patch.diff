diff --git a/kernel/work.c b/kernel/work.c
index bcbb3b46..1f5e9dcf 100644
--- a/kernel/work.c
+++ b/kernel/work.c
@@ -928,6 +928,14 @@ int k_work_queue_stop(struct k_work_q *queue, k_timeout_t timeout)
 		return -EALREADY;
 	}
 
+	/* Check if the work queue thread is essential - essential threads
+	 * cannot be stopped, so return -ENOTSUP in that case */
+	if (z_is_thread_essential(&queue->thread)) {
+		k_spin_unlock(&lock, key);
+		SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_work_queue, stop, queue, timeout, -ENOTSUP);
+		return -ENOTSUP;
+	}
+
 	if (!flag_test(&queue->flags, K_WORK_QUEUE_PLUGGED_BIT)) {
 		k_spin_unlock(&lock, key);
 		SYS_PORT_TRACING_OBJ_FUNC_EXIT(k_work_queue, stop, queue, timeout, -EBUSY);

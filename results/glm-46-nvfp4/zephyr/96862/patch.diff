@@ -0,0 +1,25 @@
+#include <stdio.h>
+#include <string.h>
+
+static void test_no_duplicates_in_a_row(void)
+{
+    printf("Testing no duplicates logic...\n");
+    
+    /* Simple test - if we put the same command twice, second should be ignored */
+    uint8_t line1[20] = {1, 2, 3, 4, 5};
+    uint8_t line2[20] = {1, 2, 3, 4, 5};
+    
+    printf("Line1 and Line2 are same: %d\n", memcmp(line1, line2, sizeof(line1)));
+    
+    int cmp1 = (5 == 5);
+    int cmp2 = (memcmp(line1, line2, 5) == 0);
+    
+    printf("len compare: %d\n", cmp1);
+    printf("memcmp compare: %d\n", cmp2);
+    printf("Both equal: %d\n", cmp1 && cmp2);
+}
+
+int main() {
+    test_no_duplicates_in_a_row();
+    return 0;
+}

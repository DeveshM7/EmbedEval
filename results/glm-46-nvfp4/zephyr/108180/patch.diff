 }
 
diff --git a/subsys/net/lib/sockets/sockets_service.c b/subsys/net/lib/sockets/sockets_service.c
index e60f919ac..aa1dc7c21 100644
--- a/subsys/net/lib/sockets/sockets_service.c
+++ b/subsys/net/lib/sockets/sockets_service.c
@@ -305,3 +305,46 @@ void socket_service_init(void)
 {
 	(void)init_socket_service();
 }
+
+
+int z_impl_net_socket_service_close(const struct net_socket_service_desc *svc)
+{
+	int ret = -ENOENT;
+	int fd;
+
+	k_mutex_lock(&lock, K_FOREVER);
+
+	if (thread_status == SOCKET_SERVICE_THREAD_UNINITIALIZED) {
+		(void)k_condvar_wait(&wait_start, &lock, K_FOREVER);
+	} else if (thread_status != SOCKET_SERVICE_THREAD_RUNNING) {
+		NET_ERR("Socket service thread not running, service %p close fails.", svc);
+		ret = -EIO;
+		goto out;
+	}
+
+	if (STRUCT_SECTION_START(net_socket_service_desc) > svc ||
+	    STRUCT_SECTION_END(net_socket_service_desc) <= svc) {
+		goto out;
+	}
+
+	/* Close all registered sockets */
+	for (int i = 0; i < svc->pev_len; i++) {
+		fd = svc->pev[i].event.fd;
+		if (fd >= 0) {
+			(void)zsock_close(fd);
+			svc->pev[i].event.fd = -1;
+		}
+	}
+
+	/* Clean up the service */
+	cleanup_svc_events(svc);
+
+	/* Tell the thread to re-read the variables */
+	zvfs_eventfd_write(ctx.events[0].fd, 1);
+	ret = 0;
+
+out:
+	k_mutex_unlock(&lock);
+
+	return ret;
+}

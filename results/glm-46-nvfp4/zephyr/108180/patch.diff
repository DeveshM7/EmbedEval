diff --git a/include/zephyr/net/socket_service.h b/include/zephyr/net/socket_service.h
index 85a9dc884..24d93cd38 100644
--- a/include/zephyr/net/socket_service.h
+++ b/include/zephyr/net/socket_service.h
@@ -173,6 +173,17 @@ __syscall int net_socket_service_register(const struct net_socket_service_desc *
  * @retval -ENOENT Service is not found.
  * @retval -ENINVAL Invalid parameter.
  */
+/**
+ * @brief Unregister pollable sockets and close them.
+ *
+ * @param service Pointer to a service description.
+ *
+ * @retval 0 No error
+ * @retval -ENOENT Service is not found.
+ * @retval -ENINVAL Invalid parameter.
+ */
+__syscall int net_socket_service_close(const struct net_socket_service_desc *service);
+
 static inline int net_socket_service_unregister(const struct net_socket_service_desc *service)
 {
 	return net_socket_service_register(service, NULL, 0, NULL);
diff --git a/subsys/net/lib/sntp/sntp.c b/subsys/net/lib/sntp/sntp.c
index af8cc0362..b08a6a541 100644
--- a/subsys/net/lib/sntp/sntp.c
+++ b/subsys/net/lib/sntp/sntp.c
@@ -343,12 +343,9 @@ int sntp_read_async(struct net_socket_service_event *event, struct sntp_time *ts
 
 void sntp_close_async(const struct net_socket_service_desc *service)
 {
-	struct sntp_ctx *ctx = service->pev->user_data;
-	/* Detach socket from socket service */

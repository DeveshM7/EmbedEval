+ * async listener. The async listeners are defined in the enabled state with this macro.
+ *
+ * @param[in] _name The async listener's name.
+ * @param[in] _cb The callback function called when a message is published.
+ */
+#define ZBUS_ASYNC_LISTENER_DEFINE(_name, _cb) ZBUS_ASYNC_LISTENER_DEFINE_WITH_ENABLE(_name, _cb, true)
+
+/* clang-format on */
+
+#endif /* CONFIG_ZBUS_ASYNC_LISTENER */

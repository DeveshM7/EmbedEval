+#if defined(CONFIG_ZBUS_ASYNC_LISTENER)
+/* clang-format off */
+
+/**
+ * @brief Define and initialize an async listener with explicit enable state.
+ *
+ * This macro defines an observer of async listener type. This macro establishes the callback where the
+ * async listener will be notified asynchronously via work queue and initialize the ``struct zbus_observer`` defining the
+ * async listener. The async listeners are defined in the enable state with this macro.
+ *
+ * @param[in] _name The async listener's name.
+ * @param[in] _cb The callback function called when a message is published.
+ * @param[in] _enable The async listener's initial state.
+ */
+#define ZBUS_ASYNC_LISTENER_DEFINE_WITH_ENABLE(_name, _cb, _enable)                        \
+	static struct zbus_async_listener_work _CONCAT(_zbus_async_listener_work_, _name) = { \
+		.queue = &k_sys_work_q,                                                            \
+		.work = K_WORK_INIT(_CONCAT(_zbus_async_work_handler_, _name)),           \
+		.channel = NULL,                                                                     \
+		.message = NULL,                                                                     \
+		.message_size = 0,                                                                   \
+	};                                                                                      \
+	static struct zbus_observer_data _CONCAT(_zbus_obs_data_, _name) = {                    \
+		.enabled = _enable,                                                            \
+		IF_ENABLED(CONFIG_ZBUS_PRIORITY_BOOST, (                                       \
+			.priority = ZBUS_MIN_THREAD_PRIORITY,                                 \
+		))                                                                             \
+	};                                                                                     \
+	static void __maybe_unused _CONCAT(_zbus_async_work_handler_, _name)(struct k_work *work)           \
+	{                                                                                     \
+		struct zbus_async_listener_work *async_work = CONTAINER_OF(                  \
+			work, struct zbus_async_listener_work, work);                        \
+		_cb(async_work->channel, async_work->message);                                 \
+		k_free(async_work->message);                                                   \
+		async_work->message = NULL;                                                    \
+	}                                                                                     \
+	_ZBUS_CPP_EXTERN const STRUCT_SECTION_ITERABLE(zbus_observer, _name) = {              \
+		ZBUS_OBSERVER_NAME_INIT(_name) /* Name field */                               \
+		.type = ZBUS_OBSERVER_ASYNC_LISTENER_TYPE,                                    \
+		.data = &_CONCAT(_zbus_obs_data_, _name),                                      \
+		.work = &_CONCAT(_zbus_async_listener_work_, _name),                           \
+	}
+

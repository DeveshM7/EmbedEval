diff --git a/arch/arm/core/cortex_m/swap_helper.S.bak b/arch/arm/core/cortex_m/swap_helper.S.bak
new file mode 100644
index 00000000..40f00fc0
--- /dev/null
+++ b/arch/arm/core/cortex_m/swap_helper.S.bak
@@ -0,0 +1,570 @@
+/*
+ * Copyright (c) 2013-2014 Wind River Systems, Inc.
+ * Copyright (c) 2017-2019 Nordic Semiconductor ASA.
+ * Copyright (c) 2020 Stephanos Ioannidis <root@stephanos.io>
+ *

+/**
+ * @file
+ * @brief Thread context switching for ARM Cortex-M
+ *
+ * This module implements the routines necessary for thread context switching
+ * on ARM Cortex-M CPUs.
+ */
+
+#include <zephyr/toolchain.h>
+#include <zephyr/linker/sections.h>
+#include <offsets_short.h>
+#include <zephyr/arch/cpu.h>
+#include <zephyr/syscall.h>
+#include <zephyr/kernel.h>
+
+#include <zephyr/arch/arm/cortex_m/cpu.h>
+_ASM_FILE_PROLOGUE
+
+GTEXT(z_arm_svc)
+GTEXT(z_arm_pendsv)
+GTEXT(z_do_kernel_oops)
+#if defined(CONFIG_USERSPACE)
+GTEXT(z_arm_do_syscall)
+#endif
+
+GDATA(_kernel)
+
+#if defined(CONFIG_THREAD_LOCAL_STORAGE)
+GDATA(z_arm_tls_ptr)
+#endif
+
+/**
+ *
+ * @brief PendSV exception handler, handling context switches
+ *
+ * The PendSV exception is the only execution context in the system that can
+ * perform context switching. When an execution context finds out it has to
+ * switch contexts, it pends the PendSV exception.
+ *
+ * When PendSV is pended, the decision that a context switch must happen has
+ * already been taken. In other words, when z_arm_pendsv() runs, we *know* we
+ * have to swap *something*.
+ *
+ * For Cortex-M, z_arm_pendsv() is invoked with no arguments.
+ */
+
+SECTION_FUNC(TEXT, z_arm_pendsv)
+
+#ifdef CONFIG_INSTRUMENT_THREAD_SWITCHING
+    /* Register the context switch */
+    push {r0, lr}
+    bl z_thread_mark_switched_out
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    pop {r0, r1}
+    mov lr, r1
+#else
+    pop {r0, lr}
+#endif /* CONFIG_ARMV6_M_ARMV8_M_BASELINE */
+#endif /* CONFIG_INSTRUMENT_THREAD_SWITCHING */
+
+    /* load _kernel into r1 and current k_thread into r2 */
+    ldr r1, =_kernel
+    ldr r2, [r1, #_kernel_offset_to_current]
+
+#if defined(CONFIG_ARM_STORE_EXC_RETURN)
+    /* Store LSB of LR (EXC_RETURN) to the thread's 'mode' word. */
+    strb lr, [r2, #_thread_offset_to_mode_exc_return]
+#endif
+
+    /* addr of callee-saved regs in thread in r0 */
+    ldr r0, =_thread_offset_to_callee_saved
+    add r0, r2
+
+    /* save callee-saved + psp in thread */
+    mrs ip, PSP
+
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    /* Store current r4-r7 */
+    stmea r0!, {r4-r7}
+    /* copy r8-r12 into r3-r7 */
+    mov r3, r8
+    mov r4, r9
+    mov r5, r10
+    mov r6, r11
+    mov r7, ip
+    /* store r8-12 */
+    stmea r0!, {r3-r7}
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    stmia r0, {r4-r11, ip}
+#ifdef CONFIG_FPU_SHARING
+    /* Assess whether switched-out thread had been using the FP registers. */
+    tst lr, #_EXC_RETURN_FTYPE_Msk
+
+    /* Assure caller-saved VFP registers are not saved. */
+    beq .store_exc
+
+    vstmdb r0!, {s16-s31}
+    str lr, [r0, #-4] /* store EXC_RETURN in proper slot */
+.store_exc:
+#endif /* CONFIG_FPU_SHARING */
+#endif /* CONFIG_ARMV6_M_ARMV8_M_BASELINE */
+
+#ifdef CONFIG_SYS_POWER_STATE_CHECK
+    /* Skip saving CPU idle state for a fake thread (interrupt). */
+    cmp r2, #0
+    beq .skip_check
+    str r2, [r0, #0]  /* Store k_thread in last slot of callee-saved */
+    /* The last 4 bytes of callee_saved area are reserved for 'current thread' */
+    /* pointer only, in case of Thumb mode being built */
+    /* from non-Thumb mode code with -mthumb-interwork. */
+    strb lr, [r0, #-4]  /* Store EXC_RETURN for use by
+			 * kernel oops handler for saving the
+			 * victim's state before panic.
+			 */
+
+.skip_check:
+#endif
+
+#ifdef CONFIG_BUILTIN_STACK_GUARD
+    /* Set PSP Limit register if stack guard is available */
+    ldr r1, =_kernel
+    ldr r1, [r1, #_kernel_offset_to_current]
+    ldr r1, [r1, #_thread_offset_to_priv_stack_start]
+    msr PSPLIM, r1
+#endif
+
+    /*
+     * The usage of PendSV exception nesting is not allowed in Zephyr.
+     * If we desired to relax this rule, the code would need to check
+     * for IPSR == 0 before pressing on.
+     */
+
+    /* Find out if the next thread to run is in the same CPU mode.
+     *
+     * CONTROL[0] holds the Thread mode control bit:
+     * 0 : thread is privileged
+     * 1 : thread is un-privileged.
+     *
+     * The bit only affects an exception return to Thread mode:
+     * - if the bit is 0, the exception returns to privileged mode.
+     * - if the bit is 1, the exception returns to unprivileged mode,
+     *   and the Stack Pointer (SP) selects the unprivileged stack pointer
+     *   (SPSEL).
+     *
+     * Since the SVC handler is already executing on the right stack pointer,
+     * we just need to set CONTROL[0] appropriately before the exception return.
+     */
+    cmp r2, #0
+    beq .clear_psp
+
+    /* Get thread's mode from its 'mode' status variable */
+    ldr r3, [r2, #_thread_offset_to_mode]
+    cmp r3, #0
+
+    bne .set_psp
+.clear_psp:
+    /* The new thread is privileged: clear bit 0 of CONTROL */
+    ldr r3, =_EXC_RETURN_PRIV_STACK
+    b .set_control
+.set_psp:
+    /* The new thread is un-privileged: set/unset bit 0 of CONTROL */
+    ldr r3, =_EXC_RETURN_UNPRIV_STACK
+.set_control:
+    /* Finally, set the EXC_RETURN value into LR */
+    mov lr, r3
+
+    /* We store SP to task's callee-saved context before
+     * performing its context switch.
+     */
+    subs r0, #_callee_saved_SIZEOF
+    stmia r0, {r4-r11, ip}
+
+    /* Load callee-saved registers from _kernel->switch_handle */
+    ldr r2, =_kernel
+    ldr r2, [r2, #_kernel_offset_to_switch_handle]
+    ldmia r2!, {r4-r11}
+
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    /* restore r8-r12 from r3-r7 */
+    mov r8, r3
+    mov r9, r4
+    mov r10, r5
+    mov r11, r6
+    mov ip, r7
+    pop {r3-r7}
+    sub r3, ip, r2 /* calculate how far we moved */
+    add r3, #_callee_saved_SIZEOF
+    stmia sp!, {r3-r7} /* restore current stack pointer */
+    /* callee-saved is stored at top stack */
+    ldmia sp!, {r4-r11}
+    pop {r3-r7}
+    add sp, r3
+
+    /* Set PSP to the top of the new stack frame */
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    mrs r2, PSP
+    subs r2, #_callee_saved_SIZEOF
+    stmia r2, {r4-r11, ip}
+#ifdef CONFIG_FPU_SHARING
+    tst lr, #_EXC_RETURN_FTYPE_Msk
+    beq .no_fp_restore
+    vldmia r2!, {s16-s31}
+    ldr lr, [r2] /* load EXC_RETURN for fp_active flag in thread struct */
+.no_fp_restore:
+#endif /* CONFIG_FPU_SHARING */
+    subs r0, r2, #4  /* calculate the offset to skip the last stored item */
+
+    ldr r2, =_thread_offset_to_callee_saved
+    ldr r2, [r0, r2]
+    ldmia r2!, {r4-r11, ip}
+#if defined(CONFIG_FPU_SHARING)
+    tst lr, #_EXC_RETURN_FTYPE_Msk
+    beq .skip_vfp_store
+    stmdb r0!, {s16-s31}
+    str lr, [r0, #-4]
+.skip_vfp_store:
+#endif
+
+#if defined(CONFIG_STACK_SENTINEL)
+    /* Don't restore stack sentinel value if the alignment shadow
+     * is enabled because sentinel location is unpredictable.
+     */
+    ldr ip, =_thread_offset_to_stack_info
+    ldr r4, [r0, ip]
+    ldr r5, [r4, #_stack_info_offset_to_flags]
+    tst r5, #K_STACK_FLAG_SENTINEL
+    bmi .skip_sentinel_restore
+    ldr ip, =_thread_offset_to_stack_info_start
+    ldr r5, [r4, #_stack_info_offset_to_start]
+    ldr r6, =0xa-a
+    str r6, [r0, ip]
+.skip_sentinel_restore:
+#endif
+
+#endif
+
+    /* lr now contains the value to load into CONTROL */
+
+#if defined(CONFIG_ARM_STORE_EXC_RETURN)
+    /* Store LSB of LR (EXC_RETURN) to the thread's 'mode' word. */
+    strb lr, [r0, #_thread_offset_to_mode_exc_return]
+#endif
+
+
+#if defined(CONFIG_BUILTIN_STACK_GUARD)
+    /* clear stack limit register before returning */
+    mov r2, #0
+    msr PSPLIM, r2
+#endif
+
+    /* Set stack pointer to kernel interrupt stack which is the
+     * running thread at this point. This is only needs to be
+     * done if we are going from PSP to MSP after handling nested
+     * interrupts.
+     */
+    mrs ip, CONTROL
+    tst ip, #0x2  /* CONTROL.SPSEL */
+    bne .skip_stack_change
+    mrs r0, MSP
+    msr PSP, r0
+.skip_stack_change:
+
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    /* restore lr which has been banked by hardware exception return mechanism */
+    mov r0, lr
+#endif
+    bx lr
+
+#if defined(CONFIG_USERSPACE)
+
+/**
+ *
+ * SVC interrupt handler
+ *
+ * Save r0-r4 and lr on exception entry, then setup a jump to z_arm_svc()
+ * to handle the SVC.
+ *
+ * r0-r5 contain arguments
+ * r6 contains call_id
+ * r8 contains saved link register
+ *
+ * We need to switch to privileged mode in order to copy
+ * arguments from user mode to privileged mode and also
+ * to copy results from privileged mode to user mode.
+ */
+
+SECTION_FUNC(TEXT, z_arm_svc)
+  /* Use EXC_RETURN state to find out if stack frame is on the
+   * MSP or PSP
+   */
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+  movs r0, #_EXC_RETURN_SPSEL_Msk
+  mov r1, lr
+  tst r1, r0
+  beq .L_stack_frame_msp
+  mrs r0, PSP
+  bne .L_stack_frame_endif
+.L_stack_frame_msp:
+  mrs r0, MSP
+.L_stack_frame_endif:
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    tst lr, #_EXC_RETURN_SPSEL_Msk /* did we come from thread mode ? */
+    ite eq  /* if zero (equal), came from handler mode */
+        mrseq r0, MSP   /* handler mode, stack frame is on MSP */
+        mrsne r0, PSP   /* thread mode, stack frame is on PSP */
+#endif
+
+
+    /* Figure out what SVC call number was invoked */
+
+    ldr r1, [r0, #24]   /* grab address of PC from stack frame */
+    /* SVC is a two-byte instruction, point to it and read the
+     * SVC number (lower byte of SCV instruction)
+     */
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    subs r1, r1, #2
+    ldrb r1, [r1]
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    ldrb r1, [r1, #-2]
+#endif
+
+   /*
+    * grab service call number:
+    * 0: Unused
+    * 1: irq_offload (if configured)
+    * 2: kernel panic or oops (software generated fatal exception)
+    * 3: System call (if user mode supported)
+    */
+#if defined(CONFIG_USERSPACE)
+    mrs r2, CONTROL
+
+    cmp r1, #3
+    beq .L_do_syscall
+
+    /*
+     * check that we are privileged before invoking other SVCs
+     * oops if we are unprivileged
+     */
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    movs r3, #0x1
+    tst r2, r3
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    tst r2, #0x1
+#endif
+    bne .L_oops
+
+#endif /* CONFIG_USERSPACE */
+
+    cmp r1, #2
+    beq .L_oops
+
+#if defined(CONFIG_IRQ_OFFLOAD)
+    push {r0, lr}
+    bl z_irq_do_offload  /* call C routine which executes the offload */
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    pop {r0, r3}
+    mov lr, r3
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    pop {r0, lr}
+#endif
+
+    /* exception return is done in z_arm_int_exit() */
+    ldr r0, =z_arm_int_exit
+    bx r0
+
+#endif
+
+.L_oops:
+    push {r0, lr}
+#if defined(CONFIG_EXTRA_EXCEPTION_INFO)
+#if defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    /* Build _callee_saved_t. To match the struct
+     * definition we push the psp & then r11-r4
+     */
+    mrs r1, PSP
+    push {r1, r2}
+    push {r4-r11}
+    mov  r1, sp /* pointer to _callee_saved_t */
+#endif /* CONFIG_ARMV7_M_ARMV8_M_MAINLINE */
+#endif /* CONFIG_EXTRA_EXCEPTION_INFO */
+    mov r2, lr /* EXC_RETURN */
+    bl z_do_kernel_oops
+    /* return from SVC exception is done here */
+#if defined(CONFIG_EXTRA_EXCEPTION_INFO)
+#if defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    /* We do not need to restore any register state here
+     * because we did not use any callee-saved registers
+     * in this routine. Therefore, we can just reset
+     * the MSP to its value prior to entering the function
+     */
+    add sp, #40
+#endif /* CONFIG_ARMV7_M_ARMV8_M_MAINLINE */
+#endif /* CONFIG_EXTRA_EXCEPTION_INFO */
+    pop {r0, pc}
+
+#if defined(CONFIG_USERSPACE)
+    /*
+     * System call will setup a jump to the z_arm_do_syscall() function
+     * when the SVC returns via the bx lr.
+     *
+     * On SVC exception, the stack looks like the following:
+     * r0 - r1 - r2 - r3 - r12 - LR - PC - PSR
+     *
+     * Registers look like:
+     * r0 - arg1
+     * r1 - arg2
+     * r2 - arg3
+     * r3 - arg4
+     * r4 - arg5
+     * r5 - arg6
+     * r6 - call_id
+     * r8 - saved link register
+     */
+.L_do_syscall:
+    /* SECURITY: Switch to privileged stack BEFORE modifying exception frame */
+    /* Save PC from user stack first */
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    movs r3, #24
+    ldr r4, [sp, r3]   /* grab address of PC from stack frame */
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    ldr r4, [sp, #24]   /* grab address of PC from stack frame */
+#endif
+    mov r8, r4       /* save PC in r8 */
+
+    /* Switch to privileged stack */
+    ldr r0, =_kernel
+    ldr r0, [r0, #_kernel_offset_to_current]
+    add r0, #_thread_offset_to_priv_stack_start
+    ldr r0, [r0]    /* priv stack ptr */
+    ldr r1, =CONFIG_PRIVILEGED_STACK_SIZE
+    add r0, r1
+    msr PSP, r0
+
+    /* Now safely modify the PC in the exception frame using saved address in r4 */
+    ldr r1, =z_arm_do_syscall
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    str r1, [r4, r3]   /* overwrite the PC to point to z_arm_do_syscall */
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    str r1, [r4, #24]   /* overwrite the PC to point to z_arm_do_syscall */
+#endif
+
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    ldr ip, =K_SYSCALL_LIMIT
+    cmp r6, ip
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    /* validate syscall limit */
+    ldr ip, =K_SYSCALL_LIMIT
+    cmp r6, ip
+#endif
+    /* The supplied syscall_id must be lower than the limit
+     * (Requires unsigned integer comparison)
+     */
+    blo .L_valid_syscall_id
+
+    /* bad syscall id.  Set arg1 to bad id and set call_id to SYSCALL_BAD */
+    str r6, [r0]
+    ldr r6, =K_SYSCALL_BAD
+
+    /* Bad syscalls treated as valid syscalls with ID K_SYSCALL_BAD. */
+
+.L_valid_syscall_id:
+    ldr r0, =_kernel
+    ldr r0, [r0, #_kernel_offset_to_current]
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+    mov ip, r2
+    ldr r1, =_thread_offset_to_mode
+    ldr r3, [r0, r1]
+    movs r2, #1
+    bics r3, r2
+    /* Store (privileged) mode in thread's mode state variable */
+    str r3, [r0, r1]
+    mov r2, ip
+    dsb
+    /* set mode to privileged, r2 still contains value from CONTROL */
+    movs r3, #1
+    bics r2, r3
+#elif defined(CONFIG_ARMV7_M_ARMV8_M_MAINLINE)
+    ldr r1, [r0, #_thread_offset_to_mode]
+    bic r1, #1
+    /* Store (privileged) mode in thread's mode state variable */
+    str r1, [r0, #_thread_offset_to_mode]
+    dsb
+    /* set mode to privileged, r2 still contains value from CONTROL */
+    bic r2, #1
+#endif
+    msr CONTROL, r2
+
+    /* ISB is not strictly necessary here (stack pointer is not being
+     * touched), but it's recommended to avoid executing pre-fetched
+     * instructions with the previous privilege.
+     */
+    isb
+
+#if defined(CONFIG_BUILTIN_STACK_GUARD)
+    /* Thread is now in privileged mode; after returning from SCVall it
+     * will use the default (user) stack before switching to the privileged
+     * stack to execute the system call. We need to protect the user stack
+     * against stack overflows until this stack transition.
+     */
+    ldr r1, [r0, #_thread_offset_to_stack_info_start]    /* stack_info.start */
+    msr PSPLIM, r1
+#endif /* CONFIG_BUILTIN_STACK_GUARD */
+
+    /* return from SVC to the modified LR - z_arm_do_syscall */
+    bx lr
+#endif /* CONFIG_USERSPACE */
+
+#if defined(CONFIG_IRQ_OFFLOAD)
+    GTEXT(z_irq_do_offload)
+
+    SECTION_FUNC(TEXT, z_irq_offload)
+    /*
+     * This function is called by _IrqOffload() for the second time. The
+     * interrupt is already active, so we never defer from here.
+     *
+     * This routine runs with interrupts disabled.
+     */
+
+    /* r0: IRQ number
+     * r1: ISR argument
+     * r2: ISR
+     */
+
+    /* Save callee-saved registers */
+    push {r4-r11}
+
+    /* Create a partially-sourced exception stack frame:
+     * r0-r3, r12, lr, pc, psr
+     */
+    push {r0-r3}
+    mrs r0, PSP
+    sub r0, #8
+    stmia r0!, {r4-r5}
+    mov r4, sp
+    stmia sp, {r0, lr}
+
+    /* We now have a partial stack frame that can be used by any ISR.
+     * This frame does not contain the完整的 context attributes,
+     * which is fine.
+     *
+     * Call the ISR.
+     */
+    push {lr}
+    blx r2
+
+    /* Restore callee-saved registers */
+    pop {r4-r11}
+
+    /* Restore context and return */
+    ldr r0, =z_arm_int_exit
+    bx r0
+#endif /* CONFIG_IRQ_OFFLOAD */
+
+#if defined(CONFIG_ARMV6_M_ARMV8_M_BASELINE)
+/* Verify that the structure offsets will be as expected */
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee.psp) == _callee_saved_OFFSET_psp);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, vfp労役.STM) == _callee_saved_OFFSET_STM);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee 文字) == _callee_saved_OFFSET_log);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, calleeされる) == _callee_saved_OFFSET_dir);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee.ip) == _callee_saved_OFFSET_ip);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee.sp) == _callee_saved_OFFSET_sp);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee.lr) == _callee_saved_OFFSET_lr);
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee.pc) == _callee_saved_OFFSET_pc);  /*мінім  */
+BUILD_ASSERT(
+	offsetof(struct _callee_saved, callee.psr) == _callee_saved_OFFSET_psr);
+#endif /* CONFIG_ARMV6_M_ARMV8_M_BASELINE */

+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
+	bool "Set the captive-portal option in the DHCP server response"
+	help
+	  If enabled, set the DHCP captive-portal option (RFC 8910) with a URI that
+	  clients can use to detect captive portals. The server will send option 114
+	  (Captive-Portal URI) in Offer and Acknowledgment messages when requested
+	  by the client via Parameter Request List (option 55).
+
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI
+	string "Captive portal URI"
+	depends on NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
+	default ""
+	help
+	  This configuration option specifies the captive portal URI that the DHCPv4
+	  server should provide to clients. If empty, the server will auto-build the
+	  URI as "http://<server-IPv4>/generate_204" where <server-IPv4> is the server's
+	  IP address.
+
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
+	bool "Set the captive-portal option in the DHCP server response"
+	help
+	  If enabled, set the DHCP captive-portal option (RFC 8910) with a URI that
+	  clients can use to detect captive portals. The server will send option 114
+	  (Captive-Portal URI) in Offer and Acknowledgment messages when requested
+	  by the client via Parameter Request List (option 55).
+
+config NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI
+	string "Captive portal URI"
+	depends on NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
+	default ""
+	help
+	  This configuration option specifies the captive portal URI that the DHCPv4
+	  server should provide to clients. If empty, the server will auto-build the
+	  URI as "http://<server-IPv4>/generate_204" where <server-IPv4> is the server's
+	  IP address.
diff --git a/subsys/net/lib/dhcpv4/dhcpv4_internal.h b/subsys/net/lib/dhcpv4/dhcpv4_internal.h
index e6aa02d98..47ff3d233 100644
--- a/subsys/net/lib/dhcpv4/dhcpv4_internal.h
+++ b/subsys/net/lib/dhcpv4/dhcpv4_internal.h
@@ -70,6 +70,8 @@ struct dhcp_msg {
 #define DHCPV4_OPTIONS_REBINDING	59
 #define DHCPV4_OPTIONS_VENDOR_CLASS_ID	60
 #define DHCPV4_OPTIONS_CLIENT_ID	61
+#define DHCPV4_OPTIONS_CAPTIVE_PORTAL	114
+#define DHCPV4_OPTIONS_CAPTIVE_PORTAL	114
 #define DHCPV4_OPTIONS_END		255
 

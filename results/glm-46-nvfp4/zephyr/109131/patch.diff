diff --git a/subsys/net/lib/dhcpv4/dhcpv4_server.c b/subsys/net/lib/dhcpv4/dhcpv4_server.c
index d4be6a5f5..eb3dacb88 100644
--- a/subsys/net/lib/dhcpv4/dhcpv4_server.c
+++ b/subsys/net/lib/dhcpv4/dhcpv4_server.c
@@ -441,6 +441,40 @@ static uint8_t *dhcpv4_encode_dns_server_option(uint8_t *buf, size_t *buflen)
 	return buf + DHCPV4_OPTIONS_DNS_SERVER_SIZE;
 }
 
+static uint8_t *dhcpv4_encode_captive_portal_option(uint8_t *buf, size_t *buflen,
+						     struct dhcpv4_server_ctx *ctx)
+{
+	char uri[128];
+	const char *configured_uri = CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL_URI;
+	int uri_len;
+
+	if (strlen(configured_uri) > 0) {
+		uri_len = snprintf(uri, sizeof(uri), "%s", configured_uri);
+	} else {
+		/* Auto-build URI as http://<server-IPv4>/generate_204 */
+		char server_addr_str[NET_IPV4_ADDR_LEN];
+		net_addr_ntop(NET_AF_INET, &ctx->server_addr, server_addr_str,
+			      sizeof(server_addr_str));
+		uri_len = snprintf(uri, sizeof(uri), "http://%s/generate_204", server_addr_str);
+	}
+
+	if (uri_len <= 0 || uri_len >= sizeof(uri)) {
+		return NULL;
+	}
+
+	if (buf == NULL || *buflen < uri_len + 2) {
+		return NULL;
+	}
+
+	buf[0] = DHCPV4_OPTIONS_CAPTIVE_PORTAL;
+	buf[1] = (uint8_t)uri_len;
+	memcpy(&buf[2], uri, uri_len);
+
+	*buflen -= uri_len + 2;
+
+	return buf + uri_len + 2;
+}
+
 static uint8_t *dhcpv4_encode_end_option(uint8_t *buf, size_t *buflen)
 {
 	if (buf == NULL || *buflen < 1) {
@@ -556,6 +590,16 @@ static uint8_t *dhcpv4_encode_requested_params(
 				goto out;
 			}
 			break;
+		case DHCPV4_OPTIONS_CAPTIVE_PORTAL:
+			if (!IS_ENABLED(CONFIG_NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL)) {
+				break;
+			}
+
+			buf = dhcpv4_encode_captive_portal_option(buf, buflen, ctx);
+			if (buf == NULL) {
+				goto out;
+			}
+			break;
 		/* Others - just ignore. */
 		default:
 			break;
@@ -1918,3 +1962,4 @@ void net_dhcpv4_server_init(void)
 		fds[i].fd = -1;
 	}
 }

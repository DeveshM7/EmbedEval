+# SPDX-License-Identifier: Apache-2.0
+
+# Function to generate shell aliases include file from a source file
+function(generate_shell_aliases_inc_file_for_target target source_file generated_file)
+    # Create a custom target to generate the aliases include file
+    add_custom_command(
+        OUTPUT ${generated_file}
+        COMMAND ${CMAKE_COMMAND} -E echo "/* Generated shell aliases */" > ${generated_file}
+        COMMAND ${CMAKE_COMMAND} -E echo "static const struct shell_alias shell_aliases[] = {" >> ${generated_file}
+        COMMAND ${CMAKE_COMMAND} -E echo "#ifdef CONFIG_SHELL_ALIASES_HAS_FILE" >> ${generated_file}
+        COMMAND ${CMAKE_COMMAND} -E echo "#include \"${source_file}\"" >> ${generated_file}
+        COMMAND ${CMAKE_COMMAND} -E echo "#endif" >> ${generated_file}
+        COMMAND ${CMAKE_COMMAND} -E echo "};" >> ${generated_file}
+        DEPENDS ${source_file}
+        VERBATIM
+    )
+    
+    # Make the generated file a dependency of the target
+    add_custom_target(${target}_aliases_src DEPENDS ${generated_file})
+    add_dependencies(${target} ${target}_aliases_src)
+endfunction()

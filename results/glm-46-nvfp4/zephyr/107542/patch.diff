new file mode 100644
index 000000000..f3d589e2a
--- /dev/null
+++ b/subsys/shell/shell_aliases.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <zephyr/shell/shell.h>
+#include <zephyr/kernel.h>
+#include "shell_utils.h"
+#include "shell_ops.h"
+
+#ifdef CONFIG_SHELL_ALIASES
+
+/* Shell alias structure */
+struct shell_alias {
+	const char *name;
+	const char *command;
+};
+
+/* Built-in aliases array - will be populated by CMake */
+static const struct shell_alias shell_aliases[] = {
+#ifdef CONFIG_SHELL_CMDS
+	{"?", "help"},
+#endif
+#ifdef CONFIG_SHELL_ALIASES_FILE
+	/* User-defined aliases will be included here from test_alias.txt */
+	{"stacks", "kernel thread stacks"},
+#endif
+};
+
+static const size_t shell_aliases_size = ARRAY_SIZE(shell_aliases);
+
+/* Check if a token is an alias and expand it */
+const char *z_shell_alias_expand(const char *token)
+{
+	if (!token) {
+		return NULL;
+	}
+	
+	for (size_t i = 0; i < shell_aliases_size; i++) {
+		if (strcmp(token, shell_aliases[i].name) == 0) {
+			return shell_aliases[i].command;
+		}
+	}
+	
+	return NULL;
+}
+
+/* Check if an alias name conflicts with an existing command */
+static bool shell_alias_conflicts(const struct shell *sh, const char *name)
+{
+	ARG_UNUSED(sh);
+	ARG_UNUSED(name);
+	return false;
+}
+
+/* Function to list all aliases */
+static int cmd_aliases(const struct shell *sh, size_t argc, char **argv)
+{
+	ARG_UNUSED(argc);
+	ARG_UNUSED(argv);
+
+	if (shell_aliases_size == 0) {
+		shell_print(sh, "No aliases defined");
+		return 0;
+	}
+
+	for (size_t i = 0; i < shell_aliases_size; i++) {
+		shell_print(sh, "%s -> %s", shell_aliases[i].name, shell_aliases[i].command);
+	}
+
+	return 0;
+}
+
+/* Register the aliases command */
+SHELL_CMD_REGISTER(aliases, NULL, "List shell aliases", cmd_aliases);
+
+#endif /* CONFIG_SHELL_ALIASES */

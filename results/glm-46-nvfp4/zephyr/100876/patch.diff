 	bi->zlp = false;
 }
 
+/* Helper function to properly dequeue all buffers and submit individual events */
+void udc_ep_dequeue_all(const struct device *dev, struct udc_ep_config *cfg)
+{
+	struct net_buf *buf;
+
+	/* Get all buffers from the FIFO */
+	buf = udc_buf_get_all(cfg);
+
+	/* Submit individual events for each buffer */
+	while (buf) {
+		struct net_buf *next = buf->frags;
+
+		buf->frags = NULL; /* Unchain this buffer */
+		udc_submit_ep_event(dev, buf, -ECONNABORTED);
+		buf = next;
+	}
+}
+
 void udc_setup_received(const struct device *dev, const void *const setup)
 {
 	struct udc_ep_config *cfg_out = udc_get_ep_cfg(dev, USB_CONTROL_EP_OUT);

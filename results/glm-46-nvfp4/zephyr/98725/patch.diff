diff --git a/include/zephyr/net_buf.h b/include/zephyr/net_buf.h
index 6f06cca3..f0a73618 100644
--- a/include/zephyr/net_buf.h
+++ b/include/zephyr/net_buf.h
@@ -1372,6 +1372,39 @@ struct net_buf_pool *net_buf_pool_get(int id);
  */
 int net_buf_id(const struct net_buf *buf);
 
+/** 
+ * @brief Get the number of currently available buffers in a pool. 
+ * 
+ * This function returns the current number of available buffers in the pool. 
+ * The value decreases as buffers are allocated and increases as they are freed. 
+ * 
+ * @param pool Pointer to the buffer pool. 
+ * 
+ * @return Number of currently available buffers. 
+ * 
+ * @note This function is only available when CONFIG_NET_BUF_POOL_USAGE is enabled. 
+ */ 
+#if defined(CONFIG_NET_BUF_POOL_USAGE) 
+size_t net_buf_get_available(const struct net_buf_pool *pool); 
+#endif 
+
+/** 
+ * @brief Get the maximum number of buffers simultaneously used from a pool. 
+ * 
+ * This function returns the maximum number of buffers that were simultaneously 
+ * claimed from the pool at any point in time. This value only increases 
+ * monotonically as more buffers are held at once, never decreasing. 
+ * 
+ * @param pool Pointer to the buffer pool. 
+ * 
+ * @return Maximum number of buffers simultaneously used. 
+ * 
+ * @note This function is only available when CONFIG_NET_BUF_POOL_USAGE is enabled. 
+ */ 
+#if defined(CONFIG_NET_BUF_POOL_USAGE) 
+size_t net_buf_get_max_used(const struct net_buf_pool *pool); 
+#endif
+
 /**
  * @brief Allocate a new fixed buffer from a pool.
  *
diff --git a/lib/net_buf/buf.c b/lib/net_buf/buf.c

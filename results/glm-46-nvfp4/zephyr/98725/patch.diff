diff --git a/test_buf_usage.c b/test_buf_usage.c
new file mode 100644
index 00000000..695adf60
--- /dev/null
+++ b/test_buf_usage.c
@@ -0,0 +1,47 @@
+#include <zephyr/net_buf.h>
+#include <zephyr/sys/printk.h>
+#include <zephyr/kernel.h>
+
+NET_BUF_POOL_FIXED_DEFINE(test_pool, 5, 64, 0, NULL);
+
+void main(void)
+{
+	struct net_buf *bufs[5];
+	size_t available, max_used;
+	int i;
+	
+	if (!IS_ENABLED(CONFIG_NET_BUF_POOL_USAGE)) {
+		printk("CONFIG_NET_BUF_POOL_USAGE not enabled\n");
+		return;
+	}
+	
+	// Initial state
+	available = net_buf_get_available(&test_pool);
+	max_used = net_buf_get_max_used(&test_pool);
+	printk("Initial state: available=%zu, max_used=%zu\n", available, max_used);
+	
+	// Allocate some buffers
+	for (i = 0; i < 3; i++) {
+		bufs[i] = net_buf_alloc(&test_pool, K_NO_WAIT);
+	}
+	
+	available = net_buf_get_available(&test_pool);
+	max_used = net_buf_get_max_used(&test_pool);
+	printk("After allocating 3: available=%zu, max_used=%zu\n", available, max_used);
+	
+	// Free one
+	net_buf_unref(bufs[0]);
+	
+	available = net_buf_get_available(&test_pool);
+	max_used = net_buf_get_max_used(&test_pool);
+	printk("After freeing 1: available=%zu, max_used=%zu\n", available, max_used);
+	
+	// Free remaining
+	for (i = 1; i < 3; i++) {
+		net_buf_unref(bufs[i]);
+	}
+	
+	available = net_buf_get_available(&test_pool);
+	max_used = net_buf_get_max_used(&test_pool);
+	printk("After freeing all: available=%zu, max_used=%zu\n", available, max_used);
+}

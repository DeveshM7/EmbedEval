diff --git a/subsys/net/ip/Kconfig b/subsys/net/ip/Kconfig
index aa95a88e..97c147a0 100644
--- a/subsys/net/ip/Kconfig
+++ b/subsys/net/ip/Kconfig
@@ -1017,3 +1017,21 @@ source "subsys/net/ip/Kconfig.stats"
 source "subsys/net/ip/Kconfig.debug"
 
 endmenu
+
+config NET_CHECKSUM_OFFLOAD_SUPPORTED
+	bool
+	help
+	  This option is selected by ethernet drivers that support hardware
+	  checksum offloading capabilities.
+
+config NET_CHECKSUM_OFFLOAD
+	bool "Enable checksum offloading"
+	default y if NET_CHECKSUM_OFFLOAD_SUPPORTED
+	depends on NET_CHECKSUM_OFFLOAD_SUPPORTED
+	help
+	  Enable checksum offloading support. When enabled and the underlying
+	  ethernet driver advertises hardware checksum capabilities via
+	  get_capabilities(), the network stack will skip calculating TX and
+	  RX checksums (leaving them zero for the hardware to fill). When
+	  disabled or the driver does not advertise the capability, the stack
+	  will calculate checksums in software.
diff --git a/subsys/net/ip/net_if.c b/subsys/net/ip/net_if.c
index 5aba61ef..23b0e789 100644
--- a/subsys/net/ip/net_if.c
+++ b/subsys/net/ip/net_if.c
@@ -5722,6 +5722,12 @@ void net_if_call_link_cb(struct net_if *iface, struct net_linkaddr *lladdr,
 static bool need_calc_checksum(struct net_if *iface, enum ethernet_hw_caps caps,
 			      enum net_if_checksum_type chksum_type)
 {
+#if defined(CONFIG_NET_CHECKSUM_OFFLOAD)
+	/* If checksum offloading is disabled globally, always calculate in software */
+	if (!IS_ENABLED(CONFIG_NET_CHECKSUM_OFFLOAD)) {
+		return true;
+	}
+#endif
 #if defined(CONFIG_NET_L2_ETHERNET)
 	struct ethernet_config config;
 	enum ethernet_config_type config_type;

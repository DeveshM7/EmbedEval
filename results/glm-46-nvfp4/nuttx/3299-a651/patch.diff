+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <getopt.h>
+
+struct getopt_s
+{
+  char *go_optarg;
+  int   go_opterr;
+  int   go_optind;
+  int   go_optopt;
+  char *go_optptr;
+  int   go_binitialized;
+};
+
+extern struct getopt_s *getoptvars(void);
+
+int main(int argc, char *argv[])
+{
+  static struct option long_options[] =
+    {
+      {"help", no_argument, 0, 'h'},
+      {"verbose", no_argument, 0, 'v'},
+      {"output", required_argument, 0, 'o'},
+      {0, 0, 0, 0}
+    };
+
+  /* Test 1: Unrecognized long option at the end */
+  printf("Test 1: Unrecognized long option at the end\n");
+  {
+    char *test_argv[] = {"program", "--help", "--invalid", NULL};
+    int test_argc = 3;
+    int c;
+    int option_index = 0;
+    int iteration_count = 0;
+    
+    /* Reset getopt state */
+    optind = 1;
+    opterr = 0;
+    
+    while ((c = getopt_long(test_argc, test_argv, "hvo:", 
+                            long_options, &option_index)) != -1)
+      {
+        iteration_count++;
+        
+        printf("  Iteration %d: c=%c", iteration_count, c);
+        
+        if (iteration_count > 10)
+          {
+            printf(" ERROR: Too many iterations! Likely infinite loop.\n");
+            return 1;
+          }
+        
+        switch (c)
+          {
+            case 'h':
+              printf(" Found help option\n");
+              break;
+              
+            case 'v':
+              printf(" Found verbose option\n");
+              break;
+              
+            case 'o':
+              printf(" Found output option with arg '%s'\n", optarg);
+              break;
+              
+            case '?':
+              printf(" Found unknown option '%s' (optind=%d)\n", 
+                     test_argv[optind-1], optind);
+              break;
+              
+            default:
+              printf(" Unexpected return value: %c (0x%02x)\n", c, c);
+              break;
+          }
+      }
+    
+    printf("  Completed after %d iterations (final optind=%d)\n\n",
+           iteration_count, optind);
+    
+    if (iteration_count != 2 || optind != 3)
+      {
+        printf("ERROR: Test 1 failed: expected 2 iterations and optind=3\n");
+        return 1;
+      }
+  }
+  
+  printf("All tests passed!\n");
+  return 0;
+}

index 00000000..ef84a137
--- /dev/null
+++ b/test_getopt_bug.c
@@ -0,0 +1,71 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <getopt.h>
+
+int main(int argc, char *argv[])
+{
+  static struct option long_options[] =
+    {
+      {"help", no_argument, 0, 'h'},
+      {"verbose", no_argument, 0, 'v'},
+      {"output", required_argument, 0, 'o'},
+      {0, 0, 0, 0}
+    };
+
+  /* Test unrecognized long option at the end */
+  char *test_argv[] = {"program", "--help", "--invalid", NULL};
+  int test_argc = 3;
+  int c;
+  int option_index = 0;
+  int iteration_count = 0;
+  
+  /* Reset getopt state */
+  optind = 1;
+  opterr = 0;
+  
+  printf("Test: Unrecognized long option at the end\n");
+  
+  while ((c = getopt_long(test_argc, test_argv, "hvo:", 
+                          long_options, &option_index)) != -1)
+    {
+      iteration_count++;
+      
+      printf("Iteration %d: c=%c", iteration_count, c);
+      
+      if (iteration_count > 10)
+        {
+          printf(" ERROR: Too many iterations! Likely infinite loop.\n");
+          return 1;
+        }
+      
+      switch (c)
+        {
+          case 'h':
+            printf(" Found help option\n");
+            break;
+            
+          case 'v':
+            printf(" Found verbose option\n");
+            break;
+            
+          case 'o':
+            printf(" Found output option with arg '%s'\n", optarg);
+            break;
+            
+          case '?':
+            printf(" Found unknown option '%s' (optind=%d)\n", 
+                   test_argv[optind-1], optind);
+            break;
+            
+          default:
+            printf(" Unexpected return value: %c (0x%02x)\n", c, c);
+            break;
+        }
+    }
+  
+  printf("Completed after %d iterations (final optind=%d)\n",
+         iteration_count, optind);
+  
+  return 0;
+}

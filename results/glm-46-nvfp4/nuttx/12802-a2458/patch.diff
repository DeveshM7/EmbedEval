+
+#ifndef __INCLUDE_NUTTX_EVENT_H
+#define __INCLUDE_NUTTX_EVENT_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <errno.h>
+#include <stdint.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define NXEVENT_WAIT_ALL  (1 << 0)  /* Wait for all bits in mask */
+
+/****************************************************************************
+ * Public Type Definitions
+ ****************************************************************************/
+
+typedef struct nxevent_s
+{
+  uint32_t events;  /* Current pending event mask */
+} nxevent_t;
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+#ifdef __cplusplus
+#define EXTERN extern "C"
+extern "C"
+{
+#else
+#define EXTERN extern
+#endif
+
+/* Event initialization and cleanup */
+
+int nxevent_init(FAR nxevent_t *event, uint32_t initial_mask);
+int nxevent_destroy(FAR nxevent_t *event);
+
+/* Event posting and waiting */
+
+int nxevent_post(FAR nxevent_t *event, uint32_t events, uint32_t flags);
+int nxevent_reset(FAR nxevent_t *event, uint32_t events, uint32_t flags);
+
+/* Event waiting functions */
+
+uint32_t nxevent_wait(FAR nxevent_t *event, uint32_t events,
+                      uint32_t flags);
+uint32_t nxevent_tickwait(FAR nxevent_t *event, uint32_t events,
+                          uint32_t flags, uint32_t ticks);
+uint32_t nxevent_trywait(FAR nxevent_t *event, uint32_t events,
+                        uint32_t flags);
+
+#undef EXTERN
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __INCLUDE_NUTTX_EVENT_H */

+++ b/libs/libc/machine/sim/arch_setjmp_x86_64.S
@@ -131,6 +131,12 @@ SYMBOL(longjmp):
 
 	movl	%esi,%eax
 
+	/* POSIX compliance: if val is 0, return 1 */
+
+	testl	%esi, %esi
+	movl	$1, %edx
+	cmove	%edx, %eax
+
 	/* Restore registers */
 
 	movq	JB_RBX(REGS),%rbx	/* Load 1: rbx */
@@ -146,5 +152,5 @@ SYMBOL(longjmp):
 	jmp		*JB_RIP(REGS)
 
 #ifdef __ELF__
-	.size SYMBOL(longjmp), . - SYMBOL(longjmp)
+	.size SYMBOL(longjmp), .-SYMBOL(longjmp)
 #endif

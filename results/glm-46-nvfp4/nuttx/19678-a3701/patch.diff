diff --git a/fix_mutex_wait.c b/fix_mutex_wait.c
new file mode 100644
index 00000000..f96c3e4e
--- /dev/null
+++ b/fix_mutex_wait.c
@@ -0,0 +1,8 @@
+/* Fix for nxsem_wait_irq - need to update mutex holder when last waiter times out */
+
+#include <stdio.h>
+
+int main(void) {
+  printf("Apply patch to sched/semaphore/sem_waitirq.c\n");
+  return 0;
+}
diff --git a/patch_mutex.c b/patch_mutex.c
new file mode 100644
index 00000000..b8da35bd
--- /dev/null
+++ b/patch_mutex.c
@@ -0,0 +1,9 @@
+/* Fix the mutex timeout bug in nxsem_wait_irq */
+#include <stdio.h>
+
+int main(void) {
+  printf("The bug is in nxsem_wait_irq - when a mutex waiter times out,\n");
+  printf("the mutex holder field retains the blocking bit, causing unlock\n");
+  printf("to fail. Need to clear blocking bit when last waiter is removed.\n");
+  return 0;
+}
diff --git a/sched/semaphore/sem_waitirq.c b/sched/semaphore/sem_waitirq.c
index 5f73031b..b10f574f 100644
--- a/sched/semaphore/sem_waitirq.c
+++ b/sched/semaphore/sem_waitirq.c
@@ -107,6 +107,12 @@ void nxsem_wait_irq(FAR struct tcb_s *wtcb, int errcode)
         {
           atomic_fetch_add(NXSEM_COUNT(sem), 1);
         }
+      else if (dq_empty(SEM_WAITLIST(sem)))
+        {
+          /* No more waiters - clear the blocking bit but keep the owner */
+          uint32_t holder = atomic_read(NXSEM_MHOLDER(sem));
+          atomic_set(NXSEM_MHOLDER(sem), holder & ~NXSEM_MBLOCKING_BIT);
+        }
 
       /* Indicate that the wait is over. */
 
diff --git a/sched/semaphore/sem_waitirq.c.bak b/sched/semaphore/sem_waitirq.c.bak
new file mode 100644
index 00000000..5f73031b
--- /dev/null
+++ b/sched/semaphore/sem_waitirq.c.bak
@@ -0,0 +1,128 @@
+/****************************************************************************
+ * sched/semaphore/sem_waitirq.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with

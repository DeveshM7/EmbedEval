diff --git a/simple_test.c b/simple_test.c
new file mode 100644
index 00000000..26db8122
--- /dev/null
+++ b/simple_test.c
@@ -0,0 +1,36 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <errno.h>
+
+void *thread_func(void *arg) {
+    sleep(1);
+    return NULL;
+}
+
+int main() {
+    pthread_t thread;
+    
+    printf("Creating thread...\n");
+    pthread_create(&thread, NULL, thread_func, NULL);
+    
+    printf("Detaching thread...\n");
+    pthread_detach(thread);
+    
+    printf("Waiting for thread to terminate...\n");
+    sleep(2);
+    
+    printf("Trying to join terminated detached thread...\n");
+    int ret = pthread_join(thread, NULL);
+    
+    if (ret == EINVAL) {
+        printf("PASS: pthread_join returned EINVAL as expected\n");
+    } else if (ret == ESRCH) {
+        printf("FAIL: pthread_join returned ESRCH, should be EINVAL\n");
+    } else {
+        printf("FAIL: pthread_join returned %d\n", ret);
+    }
+    
+    return ret == EINVAL ? 0 : 1;
+}
diff --git a/test_detached_join.c b/test_detached_join.c
new file mode 100644
index 00000000..4c54816d
--- /dev/null
+++ b/test_detached_join.c
@@ -0,0 +1,38 @@
+#include <stdio.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <errno.h>
+
+void *thread_func(void *arg) {
+    return NULL;
+}
+
+int main() {
+    pthread_t thread;
+    
+    // Create thread
+    if (pthread_create(&thread, NULL, thread_func, NULL) != 0) {
+        perror("pthread_create");
+        return 1;
+    }
+    
+    // Detach it
+    if (pthread_detach(thread) != 0) {
+        perror("pthread_detach");
+        return 1;
+    }
+    
+    // Wait for thread to finish
+    usleep(100000); // 100ms
+    
+    // Try to join - should return EINVAL not ESRCH
+    int result = pthread_join(thread, NULL);
+    
+    if (result == EINVAL) {
+        printf("PASS: Got EINVAL as expected\n");
+        return 0;
+    } else {
+        printf("FAIL: Got %d, expected EINVAL\n", result);
+        return 1;
+    }
+}

diff --git a/test_join.c b/test_join.c
new file mode 100644
index 00000000..ab5350f6
--- /dev/null
+++ b/test_join.c
@@ -0,0 +1,45 @@
+#include <stdio.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <errno.h>
+
+void *thread_func(void *arg) {
+    sleep(1);
+    return NULL;
+}
+
+int main(int argc, char *argv[]) {
+    pthread_t thread;
+    int ret;
+    
+    printf("Creating thread...\n");
+    ret = pthread_create(&thread, NULL, thread_func, NULL);
+    if (ret != 0) {
+        printf("pthread_create failed: %d\n", ret);
+        return 1;
+    }
+    
+    printf("Detaching thread...\n");
+    ret = pthread_detach(thread);
+    if (ret != 0) {
+        printf("pthread_detach failed: %d\n", ret);
+        return 1;
+    }
+    
+    printf("Waiting for thread to terminate...\n");
+    sleep(2);
+    
+    printf("Trying to join terminated detached thread...\n");
+    ret = pthread_join(thread, NULL);
+    
+    if (ret == EINVAL) {
+        printf("PASS: pthread_join returned EINVAL(%d) as expected\n", ret);
+        return 0;
+    } else if (ret == ESRCH) {
+        printf("FAIL: pthread_join returned ESRCH(%d), should be EINVAL(%d)\n", ret, EINVAL);
+        return 1;
+    } else {
+        printf("FAIL: pthread_join returned %d\n", ret);
+        return 1;
+    }
+}

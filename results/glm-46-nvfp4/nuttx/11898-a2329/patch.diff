diff --git a/test_pthread_join.c b/test_pthread_join.c
new file mode 100644
index 00000000..93148f03
--- /dev/null
+++ b/test_pthread_join.c
@@ -0,0 +1,43 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <errno.h>
+
+void *thread_func(void *arg) {
+    sleep(1);
+    return NULL;
+}
+
+int main() {
+    pthread_t thread;
+    
+    printf("Creating thread...\n");
+    if (pthread_create(&thread, NULL, thread_func, NULL) != 0) {
+        perror("pthread_create");
+        return 1;
+    }
+    
+    printf("Detaching thread...\n");
+    if (pthread_detach(thread) != 0) {
+        perror("pthread_detach");
+        return 1;
+    }
+    
+    printf("Waiting for thread to terminate...\n");
+    sleep(2);
+    
+    printf("Trying to join terminated detached thread...\n");
+    int ret = pthread_join(thread, NULL);
+    
+    if (ret == EINVAL) {
+        printf("PASS: pthread_join returned EINVAL as expected\n");
+        return 0;
+    } else if (ret == ESRCH) {
+        printf("FAIL: pthread_join returned ESRCH, should be EINVAL\n");
+        return 1;
+    } else {
+        printf("FAIL: pthread_join returned %d\n", ret);
+        return 1;
+    }
+}

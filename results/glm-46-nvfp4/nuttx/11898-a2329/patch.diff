diff --git a/sched/pthread/pthread_findjoininfo.c b/sched/pthread/pthread_findjoininfo.c
index 41e4c73f..5cf8c396 100644
--- a/sched/pthread/pthread_findjoininfo.c
+++ b/sched/pthread/pthread_findjoininfo.c
@@ -171,9 +171,14 @@ int pthread_findjoininfo(FAR struct task_group_s *group,
    * of being deleted, return ESRCH
    */
 
-  if (ptcb->join_complete)
-    {
-      return ESRCH;
+  /* 
+   * If the thread was detached, joining it should return EINVAL, not ESRCH 
+   * per POSIX specification. 
+   */ 
+  if (ptcb->join_complete) 
+    { 
+      return ((tcb->flags & TCB_FLAG_DETACHED) != 0) ? EINVAL : ESRCH; 
+    }
     }
 
   /* Else create joininfo for the task */

diff --git a/fix_errcode.patch b/fix_errcode.patch
new file mode 100644
index 00000000..a885519f
--- /dev/null
+++ b/fix_errcode.patch
@@ -0,0 +1,42 @@
+--- a/sched/signal/sig_deliver.c
++++ b/sched/signal/sig_deliver.c
+@@ -105,6 +105,7 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
+ {
+   FAR sigq_t *sigq;
+   sigset_t    savesigprocmask;
++  int         save_errcode;
+   sigset_t    newsigprocmask;
+   sigset_t    altsigprocmask;
+   irqstate_t  flags;
+@@ -214,6 +215,14 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
+       stcb->sigprocmask = newsigprocmask;
+ 
++      /* Save the current errcode.  This is needed to preserve any
++       * error code that might have been set when the task was
++       * interrupted by the signal.  For example, if a task was
++       * blocked in sem_wait() and gets interrupted by a signal,
++       * nxsem_wait_irq() sets errcode to EINTR.  We need to preserve
++       * this across the signal handler execution.
++       */
++      save_errcode = stcb->errcode;
++
+       /* Add the signal structure to the sigpostedq.  NOTE:  Since signals
+        * are processed one at a time, there should never be more than one
+        * signal in the sigpostedq
+@@ -291,6 +300,15 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
+       }
+ #endif
+ 
++      /* Restore the original errcode if it was changed and was non-zero.
++       * This ensures that a successful sem_wait() in a signal handler
++       * does not overwrite the EINTR that was set when the original
++       * sem_wait() was interrupted.
++       */
++      if (stcb->errcode != save_errcode && save_errcode != OK)
++        {
++          stcb->errcode = save_errcode;
++        }
++
+       /* Indicate that a signal has been delivered */
+ 
+       flags             = enter_critical_section();
diff --git a/sched/signal/sig_deliver.c b/sched/signal/sig_deliver.c
index d0739f97..d110f155 100644
--- a/sched/signal/sig_deliver.c
+++ b/sched/signal/sig_deliver.c
@@ -109,6 +109,10 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
       newsigprocmask    = savesigprocmask | sigq->mask;
       stcb->sigprocmask = newsigprocmask;
 
+      /* Save the current errcode to preserve any error set when the task */
+      /* was interrupted by the signal (e.g., EINTR from sem_wait). */
+      save_errcode = stcb->errcode;
+
 #ifndef CONFIG_BUILD_FLAT
       /* In the kernel build this has to be handled differently if we are
        * dispatching to a signal handler in a user-space task or thread; we
@@ -162,6 +166,15 @@ void nxsig_deliver(FAR struct tcb_s *stcb)
 
       /* Indicate that a signal has been delivered */
 
+
+      /* Restore the original errcode if it was EINTR. */
+      /* This ensures that a successful sem_wait() in a signal handler */
+      /* does not overwrite the EINTR that was set when the original */
+      /* sem_wait() was interrupted. */
+      if (save_errcode == EINTR)
+        {
+          stcb->errcode = save_errcode;
+        }
       flags             = enter_critical_section();
       stcb->flags       &= ~TCB_FLAG_SIGNAL_ACTION;
 
diff --git a/sched/signal/sig_deliver.c.orig b/sched/signal/sig_deliver.c.orig
new file mode 100644
index 00000000..d0739f97
--- /dev/null
+++ b/sched/signal/sig_deliver.c.orig
@@ -0,0 +1,197 @@
+/****************************************************************************
+ * sched/signal/sig_deliver.c
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at

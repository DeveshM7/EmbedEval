 #include "sched/sched.h"
 #include "signal/signal.h"
 
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* SIGKILL and SIGSTOP cannot be blocked according to POSIX */
+
+#define NON_BLOCKABLE_MASK  ((1U << SIGKILL) | (1U << SIGSTOP))
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: remove_nonblockable
+ *
+ * Description:
+ *   Remove non-blockable signals (SIGKILL and SIGSTOP) from the signal set
+ *
+ * Input Parameters:
+ *   set - The signal set to modify
+ *
+ ****************************************************************************/
+
+static void remove_nonblockable(FAR sigset_t *set)
+{
+  /* SIGKILL and SIGSTOP are not blockable */
+  set->_elem[0] &= ~NON_BLOCKABLE_MASK;
+}
+

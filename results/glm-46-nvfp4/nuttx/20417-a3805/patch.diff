+#include <nuttx/config.h>
+
 /****************************************************************************
  * Pre-processor Definitions
  ****************************************************************************/
@@ -79,6 +81,20 @@
 #define PR_SET_DUMPABLE 5
 #define PR_GET_DUMPABLE 6
 
+/* Capability management commands */
+
+#define PR_CAPS_GET     7
+#define PR_CAPS_DROP    8
+
+/* Capability flags */
+
+#ifdef CONFIG_SCHED_CAPABILITIES
+#  define PR_CAP_RAWIO    (1 << 0)  /* Can mount filesystems */
+#  define PR_CAP_SPAWN    (1 << 1)  /* Can create tasks */
+#  define PR_CAP_ADMIN    (1 << 2)  /* Can perform admin operations */
+#  define PR_CAP_ALL      (PR_CAP_RAWIO | PR_CAP_SPAWN | PR_CAP_ADMIN)

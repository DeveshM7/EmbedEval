diff --git a/comprehensive_test.c b/comprehensive_test.c
new file mode 100644
index 00000000..f2d532b4
--- /dev/null
+++ b/comprehensive_test.c
@@ -0,0 +1,100 @@
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <nuttx/wqueue.h>
+
+struct test_state_s
+{
+  struct work_s work;
+  int counter;
+  bool completed;
+};
+
+static void work_callback(FAR void *arg)
+{
+  usleep(10000); /* 10ms delay */
+}
+
+int main(void)
+{
+  struct test_state_s state;
+  int ret;
+  int failures = 0;
+
+  printf("Comprehensive workqueue cancellation test\n");
+
+  /* Case 1: Cancel unqueued work */
+  memset(&state, 0, sizeof(state));
+  ret = work_cancel(USRWORK, &state.work);
+  if (ret != -ENOENT)
+    {
+      printf("FAIL 1: Cancel unqueued work returned %d, expected -ENOENT\n", ret);
+      failures++;
+    }
+  else
+    {
+      printf("PASS 1: Cancel unqueued work returned -ENOENT\n");
+    }
+
+  /* Case 2: Cancel queued work with delay */
+  memset(&state, 0, sizeof(state));
+  ret = work_queue(USRWORK, &state.work, work_callback, &state, 1000000); /* 1s delay */
+  if (ret != OK)
+    {
+      printf("FAIL 2: work_queue failed: %d\n", ret);
+      failures++;
+    }
+  else
+    {
+      usleep(10000); /* Let work be queued */
+      ret = work_cancel(USRWORK, &state.work);
+      if (ret != OK && ret != -ENOENT)  /* Either is OK due to race */
+        {
+          printf("FAIL 2: Cancel queued work returned %d, expected OK or -ENOENT\n", ret);
+          failures++;
+        }
+      else
+        {
+          printf("PASS 2: Cancel queued work returned %d (OK or ENOENT valid)\n", ret);
+        }
+    }
+
+  /* Case 3: Cancel sync unqueued work */
+  memset(&state, 0, sizeof(state));
+  ret = work_cancel_sync(USRWORK, &state.work);
+  if (ret != -ENOENT)
+    {
+      printf("FAIL 3: Cancel sync unqueued work returned %d, expected -ENOENT\n", ret);
+      failures++;
+    }
+  else
+    {
+      printf("PASS 3: Cancel sync unqueued work returned -ENOENT\n");
+    }
+
+  /* Case 4: Cancel sync queued work with delay */
+  memset(&state, 0, sizeof(state));
+  ret = work_queue(USRWORK, &state.work, work_callback, &state, 1000000); /* 1s delay */
+  if (ret != OK)
+    {
+      printf("FAIL 4: work_queue failed: %d\n", ret);
+      failures++;
+    }
+  else
+    {
+      usleep(10000); /* Let work be queued */
+      ret = work_cancel_sync(USRWORK, &state.work);
+      if (ret != OK && ret != -ENOENT)  /* Either is OK due to race */
+        {
+          printf("FAIL 4: Cancel sync queued work returned %d, expected OK or -ENOENT\n", ret);
+          failures++;
+        }
+      else
+        {
+          printf("PASS 4: Cancel sync queued work returned %d (OK or ENOENT valid)\n", ret);
+        }
+    }
+
+  printf("Test completed with %d failures\n", failures);
+  return failures;
+}

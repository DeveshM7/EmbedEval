+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+#ifndef __INCLUDE_NUTTX_SEQLOCK_H
+#define __INCLUDE_NUTTX_SEQLOCK_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <assert.h>
+#include <stdint.h>
+
+#include <nuttx/compiler.h>
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include <nuttx/atomic.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Public Data Types
+ ****************************************************************************/
+
+/* Sequential lock count type.
+ * The count starts at 0 (even) indicating no writer is active.
+ * When a writer acquires the lock, the count is incremented to 1 (odd).
+ * When the writer releases, the count is incremented to 2 (even).
+ * An odd count indicates a writer is active, even count indicates no writer.
+ */
+
+typedef atomic_t seqcount_t;
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: seqlock_init
+ *
+ * Description:
+ *   Initialize a sequential lock count to its initial, unlocked state.
+ *
+ * Input Parameters:
+ *   seq  - A reference to the seqcount_t object to be initialized.
+ *
+ * Returned Value:
+ *   None.
+ *
+ ****************************************************************************/
+
+static inline void seqlock_init(FAR seqcount_t *seq)
+{
+  atomic_set(seq, 0);
+}
+
+#if defined(CONFIG_SPINLOCK)
+
+/****************************************************************************
+ * Name: write_seqlock_irqsave
+ *
+ * Description:
+ *   Acquire exclusive write access to the seqlock, disabling interrupts
+ *   and saving the interrupt state. This function will not return until the
+ *   caller owns the seqlock (i.e., no other writer holds it).
+ *
+ *   The function increments the sequence count to indicate a write is in
+ *   progress (making it odd).
+ *
+ * Input Parameters:
+ *   seq  - A reference to the seqcount_t object.
+ *
+ * Returned Value:
+ *   An opaque, architecture-specific value that represents the state of
+ *   the interrupts prior to the call.
+ *
+ ****************************************************************************/
+
+irqstate_t write_seqlock_irqsave(FAR seqcount_t *seq);
+
+/****************************************************************************
+ * Name: write_sequnlock_irqrestore
+ *
+ * Description:
+ *   Release exclusive write access to the seqlock and restore the interrupt
+ *   state to what it was prior to the previous call to write_seqlock_irqsave.
+ *
+ *   The function increments the sequence count to indicate the write is
+ *   complete (making it even).
+ *
+ * Input Parameters:
+ *   seq   - A reference to the seqcount_t object.
+ *   flags - The interrupt state returned by write_seqlock_irqsave.
+ *
+ * Returned Value:
+ *   None.
+ *
+ ****************************************************************************/
+
+void write_sequnlock_irqrestore(FAR seqcount_t *seq, irqstate_t flags);
+
+#else
+
+/****************************************************************************
+ * If CONFIG_SPINLOCK is not set (UP configuration), we still need to
+ * maintain the sequence count, but we don't need to worry about
+ * inter-CPU synchronization.
+ */
+
+/****************************************************************************
+ * Name: write_seqlock_irqsave
+ *
+ * Description:
+ *   UP version of write_seqlock_irqsave - saves interrupts and increments
+ *   the sequence count.
+ *
+ ****************************************************************************/
+
+static inline irqstate_t write_seqlock_irqsave(FAR seqcount_t *seq)
+{
+  irqstate_t flags;
+  
+  /* Disable interrupts and save state */
+  flags = up_irq_save();
+  
+  /* Increment the sequence count to mark write as in progress */
+  atomic_fetch_add(seq, 1);
+  
+  return flags;
+}
+
+/****************************************************************************
+ * Name: write_sequnlock_irqrestore
+ *
+ * Description:
+ *   UP version of write_sequnlock_irqrestore - increments the sequence
+ *   count again and restores interrupts.
+ *
+ ****************************************************************************/
+
+static inline void write_sequnlock_irqrestore(FAR seqcount_t *seq, 
+                                              irqstate_t flags)
+{
+  /* Increment the sequence count again to mark write as complete */
+  atomic_fetch_add(seq, 1);
+  
+  /* Restore interrupt state */
+  up_irq_restore(flags);
+}
+
+#endif /* CONFIG_SPINLOCK */
+
+#endif /* __INCLUDE_NUTTX_SEQLOCK_H */

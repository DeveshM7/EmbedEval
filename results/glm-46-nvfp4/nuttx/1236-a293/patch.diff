diff --git a/test_malloc_h.c b/test_malloc_h.c
new file mode 100644
index 0000000..8b3b32e
--- /dev/null
+++ b/test_malloc_h.c
@@ -0,0 +1,19 @@
+#include <malloc.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+int main(void)
+{
+    struct mallinfo mi;
+    
+    mi = mallinfo();
+    
+    printf("mallinfo test:\n");
+    printf("arena: %d\n", mi.arena);
+    printf("ordblks: %d\n", mi.ordblks);
+    printf("mxordblk: %d\n", mi.mxordblk);
+    printf("uordblks: %d\n", mi.uordblks);
+    printf("fordblks: %d\n", mi.fordblks);
+    
+    return 0;
+}

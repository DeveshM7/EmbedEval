--- /dev/null
+++ b/add_test.py
@@ -0,0 +1,49 @@
+with open("/testbed/apps/testing/ostest/ostest_main.c", "r") as f:
+    content = f.read()
+
+# Find the position after the closing brace
+insert_point = content.find("static int user_main(int argc, char *argv[])") - 1
+
+if insert_point != -1:
+    # Prepare the text to insert
+    insert_text = """/****************************************************************************
+ * External declarations for malloc.h test
+ ****************************************************************************/
+
+#ifdef CONFIG_BUILD_KERNEL
+extern void mallinfo_test(void);
+#endif
+
+"""
+
+    # Insert the text
+    new_content = content[:insert_point] + insert_text + content[insert_point:]
+    
+    with open("/testbed/apps/testing/ostest/ostest_main.c", "w") as f:
+        f.write(new_content)
+    
+    print("Added extern declaration before user_main function")
+    
+    # Now add the call after the opening brace
+    content = new_content
+    func_start = content.find("static int user_main(int argc, char *argv[])")
+    if func_start != -1:
+        # Find the opening brace
+        brace_pos = content.find('{', func_start)
+        if brace_pos != -1:
+            # Find the end of the line with the brace
+            end_brace_line = content.find('\n', brace_pos)
+            if end_brace_line != -1:
+                call_text = """
+#ifdef CONFIG_BUILD_KERNEL
+  mallinfo_test();
+#endif
+"""
+                final_content = content[:end_brace_line+1] + call_text + content[end_brace_line+1:]
+                
+                with open("/testbed/apps/testing/ostest/ostest_main.c", "w") as f:
+                    f.write(final_content)
+                
+                print("Added function call at start of user_main")
+else:
+    print("Could not find user_main function")

@@ -0,0 +1,23 @@
+#include <stdio.h>
+#include <stdlib.h>
+
+int main(void) {
+  FILE *f = fopen("/testbed/apps/testing/ostest/ostest_main.c", "r");
+  if (!f) return 1;
+  
+  char line[1024];
+  int line_num = 1;
+  int found_function = 0;
+  
+  while (fgets(line, sizeof(line), f)) {
+    printf("%d:%s", line_num, line);
+    if (strstr(line, "static int user_main") && !found_function) {
+      found_function = 1;
+      printf("Found function at line %d\n", line_num);
+    }
+    line_num++;
+  }
+  
+  fclose(f);
+  return 0;
+}

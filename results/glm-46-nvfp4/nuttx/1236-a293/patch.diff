--- /dev/null
+++ b/fix_ostest.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+
+# Add extern declaration after function prototype section
+sed -i '/^static int user_main/i\
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifdef CONFIG_BUILD_KERNEL
+extern void mallinfo_test(void);
+#endif
+' /testbed/apps/testing/ostest/ostest_main.c
+
+# Add function call at the start of user_main
+sed -i '/^static int user_main(int argc, char \*argv\[$/,/^{$/{
+/^{$/i\
+#ifdef CONFIG_BUILD_KERNEL\
+  mallinfo_test();\
+#endif
+}' /testbed/apps/testing/ostest/ostest_main.c
+

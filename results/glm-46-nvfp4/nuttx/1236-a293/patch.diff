+import shutil
+
+# Read the original file
+with open("/testbed/apps/testing/ostest/ostest_main.c", "r") as f:
+    content = f.read()
+
+# First, let's replace the entire user_main function start manually
+lines = content.split('\n')
+
+# Find the user_main function and opening brace
+user_main_line = None
+opening_brace_line = None
+
+for i, line in enumerate(lines):
+    if "static int user_main(int argc, char *argv[])" in line:
+        user_main_line = i
+        # Look for the opening brace after this
+        for j in range(i, len(lines)):
+            if lines[j].strip() == "{":
+                opening_brace_line = j
+                break
+        break
+
+if user_main_line is not None and opening_brace_line is not None:
+    # Insert extern declaration before function
+    lines.insert(user_main_line, "extern void mallinfo_test(void);\n")

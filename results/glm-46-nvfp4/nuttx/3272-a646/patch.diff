+++ b/libs/libc/unistd/lib_getopt_long.c
@@ -0,0 +1,498 @@
+/****************************************************************************
+ * libs/libc/unistd/lib_getopt_long.c
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdbool.h>
+#include <getopt.h>
+#include <string.h>
+
+#include "unistd.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#undef optarg
+#undef opterr
+#undef optind
+#undef optopt
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* Helper function to match a long option */
+
+static int match_long_option(FAR const char *name, FAR const char *arg)
+{
+  int len = strlen(name);
+  
+  return (strncmp(arg, name, len) == 0) &&
+         (arg[len] == '\0' || arg[len] == '=');
+}
+
+/* Helper function to find a long option */
+
+static FAR const struct option *find_long_option(FAR const struct option *longopts,
+                                                 FAR const char *name)
+{
+  FAR const struct option *p;
+
+  if (!longopts || !name)
+    {
+      return NULL;
+    }
+
+  for (p = longopts; p->name; p++)
+    {
+      if (match_long_option(p->name, name))
+        {
+          return p;
+        }
+    }
+
+  return NULL;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: getopt_long
+ *
+ * Description:
+ *   getopt_long() works like getopt() except that it also accepts long
+ *   options, started with two dashes.  Long option names may be abbreviated
+ *   if the abbreviation is unique or is an exact match for some defined
+ *   option.
+ *
+ * Input Parameters:
+ *   argc, argv - These arguments are passed to main()
+ *   shortopts - A string containing the legitimate short option characters
+ *   longopts  - An array of struct option structures describing the long
+ *               options
+ *   longind   - If longind is not NULL, it points to a variable which is
+ *               set to the index of the long option relative to longopts.
+ *
+ * Returned Value:
+ *   Returns the option character when an option is successfully parsed, or
+ *   -1 when all options have been processed.
+ *
+ ****************************************************************************/
+
+int getopt_long(int argc, FAR char *const argv[],
+                FAR const char *shortopts,
+                FAR const struct option *longopts,
+                FAR int *longind)
+{
+  /* Get thread-specific getopt() variables */
+
+  FAR struct getopt_s *go = getoptvars();
+  if (go == NULL)
+    {
+      return '?';
+    }
+
+  /* Verify input parameters. */
+
+  if (argv == NULL)
+    {
+      return '?';
+    }
+
+  /* Initialize if necessary */
+
+  if (go->go_optind < 1 || !go->go_binitialized)
+    {
+      go->go_optarg       = NULL;
+      go->go_optind       = 1;
+      go->go_optopt       = '?';
+      go->go_optptr       = NULL;
+      go->go_binitialized = true;
+    }
+
+  /* Check if we're at the end */
+
+  if (go->go_optind >= argc || argv[go->go_optind] == NULL)
+    {
+      go->go_binitialized = false;
+      return ERROR;
+    }
+
+  FAR char *arg = argv[go->go_optind];
+
+  /* If it doesn't start with '-', try short option parsing */
+
+  if (arg[0] != '-' || arg[1] == '\0')
+    {
+      return getopt(argc, argv, shortopts);
+    }
+
+  /* Handle the special case of just "-" */
+
+  if (arg[1] == '\0')
+    {
+      return getopt(argc, argv, shortopts);
+    }
+
+  /* Handle "--" which ends option parsing */
+
+  if (strcmp(arg, "--") == 0)
+    {
+      go->go_optind++;
+      go->go_binitialized = false;
+      return ERROR;
+    }
+
+  /* Check if this is a long option (starts with "--") */
+
+  if (arg[1] == '-')
+    {
+      FAR const char *name = arg + 2;
+      FAR const struct option *opt;
+      FAR char *eq;
+
+      /* Find the option in the longopts array */
+
+      opt = find_long_option(longopts, name);
+      if (!opt)
+        {
+          /* Try to find partial match */
+          for (opt = longopts; opt && opt->name; opt++)
+            {
+              if (strncmp(opt->name, name, strlen(name)) == 0)
+                {
+                  /* Check if this is a unique match */
+                  FAR const struct option *next = opt + 1;
+                  if (next && next->name && strncmp(next->name, name, strlen(name)) == 0)
+                    {
+                      /* Not unique, return error */
+                      go->go_optopt = 0;
+                      return '?';
+                    }
+                  break;
+                }
+            }
+
+          if (!opt || !opt->name)
+            {
+              /* No match found */
+              go->go_optopt = 0;
+              return '?';
+            }
+        }
+
+      /* Set longind if requested */
+
+      if (longind)
+        {
+          *longind = opt - longopts;
+        }
+
+      /* Handle argument for long option */
+
+      if (opt->has_arg != no_argument)
+        {
+          eq = strchr(name, '=');
+          if (eq)
+            {
+              /* Argument provided with '=' */
+
+              go->go_optarg = eq + 1;
+              go->go_optind++;
+              if (opt->flag)
+                {
+                  *opt->flag = opt->val;
+                  return 0;
+                }
+              return opt->val;
+            }
+          else if (opt->has_arg == required_argument)
+            {
+              /* Argument required, check next argv element */
+
+              if (go->go_optind + 1 >= argc)
+                {
+                  /* Missing required argument */
+                  go->go_optopt = opt->val;
+                  return (shortopts && *shortopts == ':') ? ':' : '?';
+                }
+
+              if (argv[go->go_optind + 1][0] == '-')
+                {
+                  /* Next element looks like another option */
+                  go->go_optopt = opt->val;
+                  return (shortopts && *shortopts == ':') ? ':' : '?';
+                }
+
+              /* Use next argument as option argument */
+
+              go->go_optarg = argv[go->go_optind + 1];
+              go->go_optind += 2;
+              if (opt->flag)
+                {
+                  *opt->flag = opt->val;
+                  return 0;
+                }
+              return opt->val;
+            }
+          else
+            {
+              /* Optional argument, just consume this option */
+
+              go->go_optarg = NULL;
+              go->go_optind++;
+              if (opt->flag)
+                {
+                  *opt->flag = opt->val;
+                  return 0;
+                }
+              return opt->val;
+            }
+        }
+      else
+        {
+          /* No argument expected */
+
+          go->go_optarg = NULL;
+          go->go_optind++;
+          if (opt->flag)
+            {
+              *opt->flag = opt->val;
+              return 0;
+            }
+          return opt->val;
+        }
+    }
+
+  /* Not a long option, use short option parsing */
+
+  return getopt(argc, argv, shortopts);
+}
+
+/****************************************************************************
+ * Name: getopt_long_only
+ *
+ * Description:
+ *   getopt_long_only() is like getopt_long(), but '-' as well as '--' can
+ *   indicate a long option.  If an option that starts with '-' (not '--')
+ *   doesn't match a long option, but does match a short option, it is parsed
+ *   as a short option instead.
+ *
+ * Input Parameters:
+ *   argc, argv - These arguments are passed to main()
+ *   shortopts - A string containing the legitimate short option characters
+ *   longopts  - An array of struct option structures describing the long
+ *               options
+ *   longind   - If longind is not NULL, it points to a variable which is
+ *               set to the index of the long option relative to longopts.
+ *
+ * Returned Value:
+ *   Returns the option character when an option is successfully parsed, or
+ *   -1 when all options have been processed.
+ *
+ ****************************************************************************/
+
+int getopt_long_only(int argc, FAR char *const argv[],
+                     FAR const char *shortopts,
+                     FAR const struct option *longopts,
+                     FAR int *longind)
+{
+  /* Get thread-specific getopt() variables */
+
+  FAR struct getopt_s *go = getoptvars();
+  if (go == NULL)
+    {
+      return '?';
+    }
+
+  /* Verify input parameters. */
+
+  if (argv == NULL)
+    {
+      return '?';
+    }
+
+  /* Initialize if necessary */
+
+  if (go->go_optind < 1 || !go->go_binitialized)
+    {
+      go->go_optarg       = NULL;
+      go->go_optind       = 1;
+      go->go_optopt       = '?';
+      go->go_optptr       = NULL;
+      go->go_binitialized = true;
+    }
+
+  /* Check if we're at the end */
+
+  if (go->go_optind >= argc || argv[go->go_optind] == NULL)
+    {
+      go->go_binitialized = false;
+      return ERROR;
+    }
+
+  FAR char *arg = argv[go->go_optind];
+
+  /* If it doesn't start with '-', try short option parsing */
+
+  if (arg[0] != '-' || arg[1] == '\0')
+    {
+      return getopt(argc, argv, shortopts);
+    }
+
+  /* Handle the special case of just "-" */
+
+  if (arg[1] == '\0')
+    {
+      return getopt(argc, argv, shortopts);
+    }
+
+  /* Handle "--" which ends option parsing */
+
+  if (strcmp(arg, "--") == 0)
+    {
+      go->go_optind++;
+      go->go_binitialized = false;
+      return ERROR;
+    }
+
+  /* For getopt_long_only, both '-' and '--' can start long options */
+
+  if (arg[0] == '-')
+    {
+      FAR const char *name = arg + 1;  /* Skip just one dash */
+      FAR const struct option *opt;
+      FAR char *eq;
+
+      /* If it starts with "--", it's definitely a long option */
+
+      if (arg[1] == '-' && arg[2] != '\0')
+        {
+          name = arg + 2;
+        }
+
+      /* Try to match as a long option */
+
+      opt = find_long_option(longopts, name);
+      if (opt)
+        {
+          /* This matches a long option, parse it */
+
+          /* Set longind if requested */
+
+          if (longind)
+            {
+              *longind = opt - longopts;
+            }
+
+          /* Handle argument for long option */
+
+          if (opt->has_arg != no_argument)
+            {
+              eq = strchr(name, '=');
+              if (eq)
+                {
+                  /* Argument provided with '=' */
+
+                  go->go_optarg = eq + 1;
+                  go->go_optind++;
+                  if (opt->flag)
+                    {
+                      *opt->flag = opt->val;
+                      return 0;
+                    }
+                  return opt->val;
+                }
+              else if (opt->has_arg == required_argument)
+                {
+                  /* Argument required, check next argv element */
+
+                  if (go->go_optind + 1 >= argc)
+                    {
+                      /* Missing required argument */
+                      go->go_optopt = opt->val;
+                      return (shortopts && *shortopts == ':') ? ':' : '?';
+                    }
+
+                  if (argv[go->go_optind + 1][0] == '-')
+                    {
+                      /* Next element looks like another option */
+                      go->go_optopt = opt->val;
+                      return (shortopts && *shortopts == ':') ? ':' : '?';
+                    }
+
+                  /* Use next argument as option argument */
+
+                  go->go_optarg = argv[go->go_optind + 1];
+                  go->go_optind += 2;
+                  if (opt->flag)
+                    {
+                      *opt->flag = opt->val;
+                      return 0;
+                    }
+                  return opt->val;
+                }
+              else
+                {
+                  /* Optional argument, just consume this option */
+
+                  go->go_optarg = NULL;
+                  go->go_optind++;
+                  if (opt->flag)
+                    {
+                      *opt->flag = opt->val;
+                      return 0;
+                    }
+                  return opt->val;
+                }
+            }
+          else
+            {
+              /* No argument expected */
+
+              go->go_optarg = NULL;
+              go->go_optind++;
+              if (opt->flag)
+                {
+                  *opt->flag = opt->val;
+                  return 0;
+                }
+              return opt->val;
+            }
+        }
+      else if (arg[1] == '-' && arg[2] != '\0')
+        {
+          /* This started with "--" but doesn't match any long option */
+          go->go_optopt = 0;
+          return '?';
+        }
+    }
+
+  /* No long option match, fall back to short option parsing */
+
+  return getopt(argc, argv, shortopts);
+}

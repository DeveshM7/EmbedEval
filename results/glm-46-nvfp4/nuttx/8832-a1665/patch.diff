+/*
+ * The race condition sequence:
+ * 
+ * 1. Thread A: work_queue(qid, &work, worker, NULL, 0)
+ *    - dq_addlast(&work, &wqueue->q)    // work added to queue
+ *    - nxsem_post(&wqueue->sem)        // semaphore posted (count++ to 1)
+ * 
+ * 2. Thread B: work_cancel(qid, &work)
+ *    - dq_rem(&work, &wqueue->q)        // work removed from queue
+ *    - wqueue->sem.semcount--          // MANUAL DECREMENT (count-- to 0)
+ *    - work->worker = NULL
+ * 
+ * 3. Worker Thread (running at same time):
+ *    - nxsem_wait_uninterruptible(&wqueue->sem)  // returns immediately, count becomes 0
+ *    - work = dq_remfirst(&wqueue->q)            // returns NULL since work was removed
+ *    - if (work && work->worker) { ... }         // skips processing since work is NULL
+ *    - loops back to nxsem_wait_uninterruptible()
+ * 
+ * 4. Later: work_queue(qid, &work2, worker2, NULL, 0)
+ *    - dq_addlast(&work2, &wqueue->q)   // work2 added to queue
+ *    - nxsem_post(&wqueue->sem)        // semaphore posted (count++ to 1)
+ * 
+ * 5. Worker Thread:
+ *    - nxsem_wait_uninterruptible(&wqueue->sem)  // returns immediately, count becomes 0
+ *    - work = dq_remfirst(&wqueue->q)            // gets work2
+ *    - processes work2 correctly
+ * 
+ * This sequence seems correct, so where's the problem?
+ * 
+ * Let me think of a different scenario...
+ */

diff --git a/analyze_race.c b/analyze_race.c
new file mode 100644
index 00000000..921d3b43
--- /dev/null
+++ b/analyze_race.c
@@ -0,0 +1,21 @@
+/*
+ * Analysis of the work queue race condition:
+ * 
+ * 1. Thread A calls work_queue() with delay=0
+ *    - Work is added to queue: dq_addlast()
+ *    - Semaphore is posted: nxsem_post()
+ * 
+ * 2. Thread B calls work_cancel() on the same work:
+ *    - Work is removed from queue: dq_rem()
+ *    - Semaphore count is manually decremented: wqueue->sem.semcount--
+ * 
+ * 3. Worker thread might be executing:
+ *    - It called nxsem_wait_uninterruptible() and was awakened
+ *    - It calls dq_remfirst() but work was already cancelled
+ *    - Worker gets NULL work and loops back to wait on semaphore
+ * 
+ * The problem: manual semaphore decrement can desync from actual queue state
+ * 
+ * The key race condition: timing between work being cancelled and worker thread
+ * trying to process the queue.
+ */
diff --git a/fix_workcancel.c b/fix_workcancel.c
new file mode 100644
index 00000000..da403079
--- /dev/null
+++ b/fix_workcancel.c
@@ -0,0 +1,27 @@
+/*
+ * Fix for work queue race condition
+ * 
+ * The problem: work_cancel() manually decrements wqueue->sem.semcount
+ * when removing work from the queue. This causes the semaphore count to
+ * get out of sync with the actual queue state.
+ * 
+ * The race condition:
+ * 1. work_queue() adds work to queue and posts semaphore
+ * 2. work_cancel() removes work from queue AND decrements semaphore count
+ * 3. Worker thread might be blocked on nxsem_wait() with incorrect count
+ * 4. Future work might not be processed properly
+ * 
+ * The fix: Remove the manual semaphore decrement. The worker thread
+ * already handles cancelled work properly by checking if (work && work->worker).
+ */
+
+// Remove this line from work_cancel():
+// wqueue->sem.semcount--;
+
+// The worker thread handles cancelled work correctly:
+// work = dq_remfirst(&wqueue->q);
+// if (work && work->worker) {
+//   // process work
+// } else {
+//   // work was cancelled, loop back to wait
+// }

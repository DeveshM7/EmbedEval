diff --git a/kernel/os/src/os_msys.c b/kernel/os/src/os_msys.c
index 3b287a3..0222e4d 100644
--- a/kernel/os/src/os_msys.c
+++ b/kernel/os/src/os_msys.c
@@ -133,7 +133,28 @@ os_msys_get(uint16_t dsize, uint16_t leadingspace)
     }
 
     m = os_mbuf_get(pool, leadingspace);
-    return (m);
+    if (m) {
+        return (m);
+    }
+
+    /* If the chosen pool is exhausted, try subsequent (larger) pools. */
+    pool = STAILQ_NEXT(pool, omp_next);
+    while (pool) {
+        m = os_mbuf_get(pool, leadingspace);
+        if (m) {
+            return (m);
+        }
+        pool = STAILQ_NEXT(pool, omp_next);
+    }
+
+    /* If all larger pools are also exhausted, try any pool from the start. */
+    STAILQ_FOREACH(pool, &g_msys_pool_list, omp_next) {
+        m = os_mbuf_get(pool, leadingspace);
+        if (m) {
+            return (m);
+        }
+    }
+
 err:
     return (NULL);
 }
@@ -161,7 +182,28 @@ os_msys_get_pkthdr(uint16_t dsize, uint16_t user_hdr_len)
     }
 
     m = os_mbuf_get_pkthdr(pool, user_hdr_len);
-    return (m);
+    if (m) {
+        return (m);
+    }
+
+    /* If the chosen pool is exhausted, try subsequent (larger) pools. */
+    pool = STAILQ_NEXT(pool, omp_next);
+    while (pool) {
+        m = os_mbuf_get_pkthdr(pool, user_hdr_len);
+        if (m) {
+            return (m);
+        }
+        pool = STAILQ_NEXT(pool, omp_next);
+    }
+
+    /* If all larger pools are also exhausted, try any pool from the start. */
+    STAILQ_FOREACH(pool, &g_msys_pool_list, omp_next) {
+        m = os_mbuf_get_pkthdr(pool, user_hdr_len);
+        if (m) {
+            return (m);
+        }
+    }
+
 err:
     return (NULL);
 }

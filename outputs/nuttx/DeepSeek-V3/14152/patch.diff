diff --git a/libs/libc/machine/sim/arch_setjmp_x86.S b/libs/libc/machine/sim/arch_setjmp_x86.S
index 439e21331a..7a81ac97a9 100644
--- a/libs/libc/machine/sim/arch_setjmp_x86.S
+++ b/libs/libc/machine/sim/arch_setjmp_x86.S
@@ -84,7 +84,14 @@ SYMBOL(setjmp):
 #endif
 SYMBOL(longjmp):
 	movl	4(%esp), %ecx      /* jmpbuf in %ecx.  */
-	movl	8(%esp), %eax      /* Second argument is return value.  */
+	movl	8(%esp), %eax
+	# POSIX: if val == 0, substitute with 1
+	testl	%eax,%eax
+	jnz	1f
+	movl	$1,%eax
+	jmp	2f
+1:
+	# Second argument is return value.
 
 	/* Save the return address now.  */
 

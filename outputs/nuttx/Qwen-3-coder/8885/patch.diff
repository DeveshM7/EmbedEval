+#define MAX_SIGNO       63              /* Highest valid signal number */
+#define GOOD_SIGNO(s)   ((((unsigned)(s)) <= MAX_SIGNO) && ((unsigned)(s)) > 0)
+#define SIGNO2SET(s)    ((s) < 32 ? ((sigset_t){1U << (s), 0}) : ((sigset_t){0, 1U << ((s) - 32)}))
 

--- a/libs/libc/signal/sig_delset.c
+++ b/libs/libc/signal/sig_delset.c
@@ -63,7 +63,15 @@ int nxsig_delset(FAR sigset_t *set, int signo)
     {
       /* Remove the signal from the set */
 
-      *set &= ~SIGNO2SET(signo);
+      if (signo < 32)
+        {
+          (*set)[0] &= ~(1U << signo);
+        }
+      else
+        {
+          (*set)[1] &= ~(1U << (signo - 32));
+        }
+
       return OK;
     }
 }

diff --git a/sys/ztimer/core.c b/sys/ztimer/core.c
index e415f49fce..14238a3a8b 100644
--- a/sys/ztimer/core.c
+++ b/sys/ztimer/core.c
@@ -419,3 +419,73 @@ static void _ztimer_print(const ztimer_clock_t *clock)
     } while ((entry = entry->next));
     puts("");
 }
+
+#include "irq.h"
+#include "atomic_utils.h"
+
+/* Reference counter for each ztimer clock */
+static uint8_t _refcount[16] = {0}; /* Assuming max 16 ztimer clocks */
+
+void ztimer_acquire(ztimer_clock_t *clock)
+{
+    unsigned state = irq_disable();
+    
+    /* Find or assign an index for this clock */
+    static ztimer_clock_t *_clocks[16] = {0};
+    static uint8_t _clock_count = 0;
+    uint8_t index = 0;
+    
+    /* Check if we already have this clock registered */
+    for (index = 0; index < _clock_count; index++) {
+        if (_clocks[index] == clock) {
+            break;
+        }
+    }
+    
+    /* If not found and we have space, register it */
+    if (index == _clock_count && _clock_count < 16) {
+        _clocks[_clock_count] = clock;
+        index = _clock_count++;
+    }
+    
+    /* Increment reference counter */
+    if (index < 16) {
+        _refcount[index]++;
+        
+        /* If this is the first reference and start op exists, start the timer */
+        if (_refcount[index] == 1 && clock->ops->start) {
+            clock->ops->start(clock);
+        }
+    }
+    
+    irq_restore(state);
+}
+
+void ztimer_release(ztimer_clock_t *clock)
+{
+    unsigned state = irq_disable();
+    
+    /* Find the clock index */
+    static ztimer_clock_t *_clocks[16] = {0};
+    static uint8_t _clock_count = 0;
+    uint8_t index = 0;
+    
+    /* Check if we have this clock registered */
+    for (index = 0; index < _clock_count; index++) {
+        if (_clocks[index] == clock) {
+            break;
+        }
+    }
+    
+    /* If found, decrement reference counter */
+    if (index < _clock_count && index < 16 && _refcount[index] > 0) {
+        _refcount[index]--;
+        
+        /* If this was the last reference and stop op exists, stop the timer */
+        if (_refcount[index] == 0 && clock->ops->stop) {
+            clock->ops->stop(clock);
+        }
+    }
+    
+    irq_restore(state);
+}

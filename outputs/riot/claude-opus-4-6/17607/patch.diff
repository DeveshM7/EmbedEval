+#if MODULE_ZTIMER_ONDEMAND
+static void _ztimer_clock_start(ztimer_clock_t *clock)
+{
+    if (clock->ops->start) {
+        clock->ops->start(clock);
+    }
+#ifdef MODULE_ZTIMER_EXTEND
+    if (clock->max_value < UINT32_MAX) {
+        clock->ops->set(clock, clock->max_value >> 1);
+    }
+#endif
+}
+
+static void _ztimer_clock_stop(ztimer_clock_t *clock)
+{
+    clock->ops->cancel(clock);
+    if (clock->ops->stop) {
+        clock->ops->stop(clock);
+    }
+}
+
+void ztimer_acquire(ztimer_clock_t *clock)
+{
+    unsigned state = irq_disable();
+    if (clock->users++ == 0) {
+        if (!clock->list.next) {
+            _ztimer_clock_start(clock);
+        }
+    }
+    irq_restore(state);
+}
+
+void ztimer_release(ztimer_clock_t *clock)
+{
+    unsigned state = irq_disable();
+    assert(clock->users > 0);
+    if (--clock->users == 0) {
+        if (!clock->list.next) {
+            _ztimer_clock_stop(clock);
+        }
+    }
+    irq_restore(state);
+}

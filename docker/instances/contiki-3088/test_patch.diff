diff --git a/tests/08-native-runs/embedeval-tcp-retention/main.c b/tests/08-native-runs/embedeval-tcp-retention/main.c
new file mode 100644
index 000000000..c507e69f0
--- /dev/null
+++ b/tests/08-native-runs/embedeval-tcp-retention/main.c
@@ -0,0 +1,168 @@
+/* Component fixture: uIP event/transport boundaries are scripted; the complete
+ * upstream TCP socket and process implementations are compiled separately. */
+#include "contiki.h"
+#include "contiki-net.h"
+#include "net/ipv6/tcp-socket.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+PROCESS_NAME(tcp_socket_process);
+process_event_t tcpip_event;
+void *uip_appdata;
+uint16_t uip_len;
+uint8_t uip_flags;
+struct uip_conn *uip_conn;
+static struct uip_conn connection;
+static unsigned polls, sent_len;
+void tcp_attach(struct uip_conn *c, void *state) { (void)c; (void)state; }
+void tcp_listen(uint16_t port) { (void)port; }
+void tcp_unlisten(uint16_t port) { (void)port; }
+struct uip_conn *tcp_connect(const uip_ipaddr_t *ip, uint16_t port, void *state)
+{ (void)ip; (void)port; (void)state; return &connection; }
+void tcpip_poll_tcp(struct uip_conn *c) { (void)c; polls++; }
+void uip_send(const void *data, int len) { (void)data; sent_len = len; }
+uint16_t uip_htons(uint16_t value) { return UIP_HTONS(value); }
+
+#define CHECK(condition) do { if(!(condition)) { \
+  fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#condition); return 1; } } while(0)
+struct capture {
+  unsigned calls;
+  unsigned lens[32];
+  uint8_t data[32][16];
+  int retain[32];
+};
+static struct tcp_socket socket;
+static struct capture capture;
+static uint8_t guarded[10], output[16];
+static int callback(struct tcp_socket *s, void *ptr, const uint8_t *data, int len)
+{
+  struct capture *c = ptr;
+  if(s != &socket || len < 0 || len > 8 || c->calls >= 32) abort();
+  unsigned n = c->calls++;
+  c->lens[n] = len;
+  memcpy(c->data[n], data, len);
+  return c->retain[n];
+}
+static int setup(void)
+{
+  process_init();
+  tcpip_event = process_alloc_event();
+  memset(&socket,0,sizeof(socket)); memset(&capture,0,sizeof(capture));
+  memset(guarded,0xa5,sizeof(guarded));
+  connection.mss = 8; uip_conn = &connection;
+  socket.c = &connection;
+  return tcp_socket_register(&socket,&capture,guarded+1,8,output,sizeof(output),callback,NULL);
+}
+static void receive(const uint8_t *data, unsigned len)
+{
+  uip_appdata = (void *)data; uip_len = len; uip_flags = UIP_NEWDATA;
+  process_post_synch(&tcp_socket_process,tcpip_event,&socket);
+}
+static int canaries(void) { return guarded[0]==0xa5 && guarded[9]==0xa5; }
+static int registration_resets_retention(void)
+{
+  CHECK(setup()==1);
+  socket.input_data_len=7;
+  CHECK(tcp_socket_register(&socket,&capture,guarded+1,8,output,sizeof(output),callback,NULL)==1);
+  CHECK(socket.input_data_len==0); return 0;
+}
+static int suffix_compaction(void)
+{
+  CHECK(setup()==1); capture.retain[0]=2;
+  receive((const uint8_t *)"abcdef",6);
+  CHECK(capture.calls==1 && capture.lens[0]==6);
+  CHECK(memcmp(guarded+1,"ef",2)==0);
+  CHECK(socket.input_data_len==2 && canaries()); return 0;
+}
+static int retain_across_events(void)
+{
+  CHECK(setup()==1); capture.retain[0]=2;
+  receive((const uint8_t *)"abcd",4); receive((const uint8_t *)"efgh",4);
+  CHECK(capture.calls==2 && capture.lens[1]==6);
+  CHECK(memcmp(capture.data[1],"cdefgh",6)==0);
+  CHECK(socket.input_data_len==0 && canaries()); return 0;
+}
+static int retain_within_large_event(void)
+{
+  CHECK(setup()==1); capture.retain[0]=2;
+  receive((const uint8_t *)"abcdefghijkl",12);
+  CHECK(capture.calls==2 && capture.lens[1]==6);
+  CHECK(memcmp(capture.data[1],"ghijkl",6)==0);
+  CHECK(socket.input_data_len==0 && canaries()); return 0;
+}
+static int overretain_clamped(void)
+{
+  CHECK(setup()==1); capture.retain[0]=9;
+  receive((const uint8_t *)"abc",3);
+  CHECK(socket.input_data_len==3 && memcmp(guarded+1,"abc",3)==0);
+  receive((const uint8_t *)"de",2);
+  CHECK(capture.calls==2 && capture.lens[1]==5);
+  CHECK(memcmp(capture.data[1],"abcde",5)==0 && canaries()); return 0;
+}
+static int full_retained_buffer_bounded(void)
+{
+  CHECK(setup()==1); memcpy(guarded+1,"abcdefgh",8); socket.input_data_len=8;
+  receive((const uint8_t *)"xyz",3);
+  CHECK(capture.calls==0 && socket.input_data_len==8);
+  CHECK(memcmp(guarded+1,"abcdefgh",8)==0 && canaries()); return 0;
+}
+static int ordinary_receive(void)
+{
+  CHECK(setup()==1); receive((const uint8_t *)"abcd",4);
+  CHECK(capture.calls==1 && capture.lens[0]==4);
+  CHECK(memcmp(capture.data[0],"abcd",4)==0 && canaries()); return 0;
+}
+static int large_stream(void)
+{
+  CHECK(setup()==1); receive((const uint8_t *)"abcdefghijklmnopqrst",20);
+  CHECK(capture.calls==3 && capture.lens[0]==8 && capture.lens[1]==8 && capture.lens[2]==4);
+  CHECK(memcmp(capture.data[0],"abcdefgh",8)==0);
+  CHECK(memcmp(capture.data[1],"ijklmnop",8)==0);
+  CHECK(memcmp(capture.data[2],"qrst",4)==0 && canaries()); return 0;
+}
+static int binary_payload(void)
+{
+  const uint8_t data[]={0,255,0,7,128,0};
+  CHECK(setup()==1); receive(data,sizeof(data));
+  CHECK(capture.calls==1 && capture.lens[0]==sizeof(data));
+  CHECK(memcmp(capture.data[0],data,sizeof(data))==0 && canaries()); return 0;
+}
+static int absent_callback(void)
+{
+  CHECK(setup()==1); socket.input_callback=NULL;
+  receive((const uint8_t *)"abcdefghijkl",12);
+  CHECK(capture.calls==0 && socket.input_data_len==0 && canaries()); return 0;
+}
+static int send_queue(void)
+{
+  CHECK(setup()==1);
+  CHECK(tcp_socket_send(&socket,(const uint8_t *)"abc",3)==3);
+  CHECK(tcp_socket_queuelen(&socket)==3 && tcp_socket_max_sendlen(&socket)==13);
+  CHECK(polls==1 && memcmp(output,"abc",3)==0); return 0;
+}
+static int invalid_registration(void)
+{
+  CHECK(setup()==1);
+  CHECK(tcp_socket_register(NULL,NULL,NULL,0,NULL,0,NULL,NULL)==-1); return 0;
+}
+struct test { const char *name; int (*run)(void); };
+static const struct test tests[]={
+  {"registration_resets_retention",registration_resets_retention},
+  {"suffix_compaction",suffix_compaction},
+  {"retain_across_events",retain_across_events},
+  {"retain_within_large_event",retain_within_large_event},
+  {"overretain_clamped",overretain_clamped},
+  {"full_retained_buffer_bounded",full_retained_buffer_bounded},
+  {"ordinary_receive",ordinary_receive},{"large_stream",large_stream},
+  {"binary_payload",binary_payload},{"absent_callback",absent_callback},
+  {"send_queue",send_queue},{"invalid_registration",invalid_registration}
+};
+int main(int argc,char **argv)
+{
+  if(argc!=2) return 1;
+  for(unsigned i=0;i<sizeof(tests)/sizeof(tests[0]);i++) if(strcmp(argv[1],tests[i].name)==0) {
+    int result=tests[i].run(); printf("%s %s\n",tests[i].name,result?"FAIL":"PASS"); return result;
+  }
+  return 1;
+}

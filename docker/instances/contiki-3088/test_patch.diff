+++ b/tests/08-native-runs/embedeval-tcp-retention/run.py
@@ -0,0 +1,20 @@
+import subprocess,sys
+from pathlib import Path
+regressions = ['registration_resets_retention', 'suffix_compaction', 'retain_across_events', 'retain_within_large_event', 'overretain_clamped', 'full_retained_buffer_bounded']
+controls = ['ordinary_receive', 'large_stream', 'binary_payload', 'absent_callback', 'send_queue', 'invalid_registration']
+mode=sys.argv[1] if len(sys.argv)>1 else "all"
+if mode not in ["all","regression","control"]: raise SystemExit(1)
+status=0
+for name in (regressions if mode=="regression" else controls if mode=="control" else regressions+controls):
+    try:
+        p=subprocess.run(["./build/tcp-retention",name],timeout=5)
+        if p.returncode and status!=2: status=1
+    except subprocess.TimeoutExpired:
+        print(name,"TIMEOUT after 5s",flush=True);status=2
+if mode!="regression":
+    try:
+        p=subprocess.run(["./build/upstream-controls"],timeout=30)
+        if p.returncode and status!=2: status=1
+    except subprocess.TimeoutExpired:
+        print("upstream-controls TIMEOUT after 30s",flush=True);status=2
+raise SystemExit(status)

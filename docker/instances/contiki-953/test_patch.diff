+set -euo pipefail
+mkdir -p build
+common=(-std=c99 -O2 -g -ffunction-sections -fdata-sections -Itests/08-native-runs/embedeval-coap-separate -Ios -Ios/net/app-layer/coap)
+sources=(os/net/app-layer/coap/coap.c os/net/app-layer/coap/coap-engine.c os/net/app-layer/coap/coap-transactions.c os/net/app-layer/coap/coap-callback-api.c os/net/app-layer/coap/coap-timer.c os/lib/list.c os/lib/memb.c os/lib/random.c)
+cc "${common[@]}" tests/08-native-runs/embedeval-coap-separate/main.c "${sources[@]}" -Wl,--gc-sections -o build/coap-separate
+cc "${common[@]}" -DWITH_DTLS tests/08-native-runs/embedeval-coap-separate/main.c "${sources[@]}" -Wl,--gc-sections -o build/coap-separate-dtls
+cc "${common[@]}" tests/08-native-runs/embedeval-coap-separate/upstream-controls.c os/lib/list.c os/lib/random.c os/lib/circular-list.c os/lib/dbl-list.c os/lib/dbl-circ-list.c os/services/unit-test/unit-test.c -Wl,--gc-sections -o build/coap-upstream-controls
diff --git a/tests/08-native-runs/embedeval-coap-separate/contiki-conf.h b/tests/08-native-runs/embedeval-coap-separate/contiki-conf.h
new file mode 100644
--- /dev/null
+++ b/tests/08-native-runs/embedeval-coap-separate/contiki-conf.h
@@ -0,0 +1,12 @@
+#ifndef CONTIKI_CONF_H_
+#define CONTIKI_CONF_H_
+#include <stdint.h>
+typedef unsigned int uip_stats_t;
+typedef unsigned long clock_time_t;
+#define CLOCK_CONF_SECOND 1000
+#define UIP_CONF_BYTE_ORDER UIP_LITTLE_ENDIAN
+#define LOG_CONF_ENABLED 0
+#define LOG_CONF_LEVEL_COAP 0
+#define COAP_CONF_WELL_KNOWN_RESOURCE_ENABLED 0
+#define NETSTACK_CONF_WITH_IPV6 1
+#endif
diff --git a/tests/08-native-runs/embedeval-coap-separate/main.c b/tests/08-native-runs/embedeval-coap-separate/main.c
new file mode 100644
--- /dev/null
+++ b/tests/08-native-runs/embedeval-coap-separate/main.c
@@ -0,0 +1,186 @@
+/* Host transport and clock fixtures; protocol and transaction logic is upstream. */
+#include "contiki.h"
+#include "coap-engine.h"
+#include "coap-callback-api.h"
+#include "coap-transactions.h"
+#include "coap-observe.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t now;
+static uint8_t wire[COAP_MAX_PACKET_SIZE+64], sent[COAP_MAX_PACKET_SIZE+64];
+static unsigned sent_len, sends, callbacks, timeouts, payload_ok, freed_before_callback;
+static uint16_t pending_mid;
+static int clobber;
+static const uint8_t token[]={0xa5,0x5a};
+static const char body[]="separate-response-body";
+static coap_message_t request;
+static coap_callback_request_state_t state;
+static coap_endpoint_t remote;
+coap_resource_t res_well_known_core;
+clock_time_t clock_time(void) { return (clock_time_t)now; }
+static uint64_t uptime(void) { return now; }
+static void update(void) { }
+const coap_timer_driver_t coap_timer_default_driver={NULL,uptime,update};
+void coap_transport_init(void) { }
+uint8_t *coap_databuf(void) { return wire; }
+int coap_sendto(const coap_endpoint_t *ep,const uint8_t *data,uint16_t len) {
+  (void)ep;
+  if(len>sizeof(sent)) abort();
+  memcpy(sent,data,len); sent_len=len; sends++;
+  /* A DTLS transport may overwrite shared receive storage while sending ACK. */
+  if(clobber) memset(wire,0xcc,sizeof(wire));
+  return len;
+}
+void coap_endpoint_copy(coap_endpoint_t *dest,const coap_endpoint_t *src) { *dest=*src; }
+int coap_endpoint_cmp(const coap_endpoint_t *a,const coap_endpoint_t *b) {
+  return !memcmp(&a->ipaddr,&b->ipaddr,sizeof(a->ipaddr))
+    && a->port==b->port && a->secure==b->secure;
+}
+void coap_observe_handler(coap_resource_t *r,coap_message_t *q,coap_message_t *s) {
+  (void)r; (void)q; (void)s;
+}
+int coap_remove_observer_by_mid(const coap_endpoint_t *ep,uint16_t mid) {
+  (void)ep; (void)mid; return 0;
+}
+int coap_remove_observer_by_client(const coap_endpoint_t *ep) { (void)ep; return 0; }
+static void response(void *data,coap_message_t *s) {
+  (void)data;
+  callbacks++;
+  freed_before_callback=!coap_get_transaction_by_mid(pending_mid);
+  if(!s) { timeouts++; return; }
+  payload_ok=s->code==CONTENT_2_05 && s->token_len==sizeof(token)
+    && !memcmp(s->token,token,sizeof(token)) && s->payload_len==sizeof(body)-1
+    && !memcmp(s->payload,body,sizeof(body)-1);
+}
+static void unused(coap_callback_request_state_t *s) { (void)s; abort(); }
+static int begin(void) {
+  coap_transaction_t *t;
+  memset(&state,0,sizeof(state)); memset(&remote,0,sizeof(remote));
+  remote.ipaddr.u8[15]=1; remote.port=5683;
+  sends=callbacks=timeouts=payload_ok=freed_before_callback=0; clobber=0;
+  coap_init_message(&request,COAP_TYPE_CON,COAP_GET,0);
+  coap_set_token(&request,token,sizeof(token));
+  if(!coap_send_request(&state,&remote,&request,unused)) return 0;
+  pending_mid=request.mid;
+  t=coap_get_transaction_by_mid(pending_mid);
+  if(!t || sends!=1) return 0;
+  /* Install a raw response callback after creating through the stable public API. */
+  t->callback=response; t->callback_data=NULL;
+  return 1;
+}
+static void cleanup(void) { coap_clear_transaction(coap_get_transaction_by_mid(pending_mid)); }
+static void deliver(const coap_endpoint_t *ep,unsigned type,unsigned code,
+                    uint16_t mid,const uint8_t *tok,unsigned toklen) {
+  coap_message_t s; unsigned len;
+  coap_init_message(&s,type,code,mid);
+  if(toklen) coap_set_token(&s,tok,toklen);
+  if(code) coap_set_payload(&s,body,sizeof(body)-1);
+  len=coap_serialize_message(&s,wire);
+  if(!len) abort();
+  coap_receive(ep,wire,len);
+}
+static void tick(void) {
+  coap_transaction_t *t=coap_get_transaction_by_mid(pending_mid);
+  if(!t) return;
+  now=t->retrans_timer.expiration_time;
+  coap_timer_run();
+}
+static int empty_ack_waits(void) {
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_ACK,0,pending_mid,NULL,0);
+  if(callbacks || !coap_get_transaction_by_mid(pending_mid)) return 0;
+  tick();
+  return !callbacks && sends==1 && coap_get_transaction_by_mid(pending_mid)!=NULL;
+}
+static int acked_timeout(void) {
+  unsigned i;
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_ACK,0,pending_mid,NULL,0);
+  for(i=0;i<COAP_MAX_RETRANSMIT+2;i++) tick();
+  return callbacks==1 && timeouts==1 && sends==1 && freed_before_callback
+    && !coap_get_transaction_by_mid(pending_mid);
+}
+static int separate_non(void) {
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_NON,CONTENT_2_05,pending_mid+100,token,sizeof(token));
+  return callbacks==1 && payload_ok && !timeouts && sends==1 && freed_before_callback;
+}
+static int separate_con(void) {
+  coap_message_t ack;
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_CON,CONTENT_2_05,pending_mid+100,token,sizeof(token));
+  return callbacks==1 && payload_ok && freed_before_callback && sends==2
+    && coap_parse_message(&ack,sent,sent_len)==NO_ERROR
+    && ack.type==COAP_TYPE_ACK && ack.code==0 && ack.mid==(uint16_t)(pending_mid+100)
+    && ack.token_len==0 && ack.payload_len==0;
+}
+static int separate_after_ack(void) {
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_ACK,0,pending_mid,NULL,0);
+  if(callbacks) return 0;
+  deliver(&remote,COAP_TYPE_NON,CONTENT_2_05,pending_mid+100,token,sizeof(token));
+  return callbacks==1 && payload_ok && freed_before_callback && sends==1;
+}
+static int wrong_token(void) {
+  uint8_t other[]={0xa5,0x5b};
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_ACK,CONTENT_2_05,pending_mid,other,sizeof(other));
+  if(callbacks || !coap_get_transaction_by_mid(pending_mid)) return 0;
+  deliver(&remote,COAP_TYPE_ACK,CONTENT_2_05,pending_mid,token,1);
+  return !callbacks && coap_get_transaction_by_mid(pending_mid)!=NULL;
+}
+static int wrong_endpoint(void) {
+  coap_endpoint_t other; unsigned i;
+  if(!begin()) return 0;
+  for(i=0;i<3;i++) {
+    other=remote;
+    if(i==0) other.ipaddr.u8[15]++;
+    if(i==1) other.port++;
+    if(i==2) other.secure=1;
+    deliver(&other,COAP_TYPE_ACK,CONTENT_2_05,pending_mid,token,sizeof(token));
+    if(callbacks || !coap_get_transaction_by_mid(pending_mid)) return 0;
+  }
+  return 1;
+}
+static int dtls_payload(void) {
+  coap_message_t ack;
+  if(!begin()) return 0;
+  clobber=1;
+  deliver(&remote,COAP_TYPE_CON,CONTENT_2_05,pending_mid+100,token,sizeof(token));
+  clobber=0;
+  return callbacks==1 && payload_ok && freed_before_callback && sends==2
+    && coap_parse_message(&ack,sent,sent_len)==NO_ERROR && ack.type==COAP_TYPE_ACK
+    && ack.mid==(uint16_t)(pending_mid+100) && ack.code==0;
+}
+static int piggyback_response(void) {
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_ACK,CONTENT_2_05,pending_mid,token,sizeof(token));
+  return callbacks==1 && payload_ok && freed_before_callback && sends==1;
+}
+static int unacked_retries_timeout(void) {
+  unsigned i;
+  if(!begin()) return 0;
+  for(i=0;i<COAP_MAX_RETRANSMIT+2;i++) tick();
+  return callbacks==1 && timeouts==1 && freed_before_callback
+    && sends==COAP_MAX_RETRANSMIT+1 && !coap_get_transaction_by_mid(pending_mid);
+}
+static int unrelated_response(void) {
+  uint8_t other[]={1,2};
+  if(!begin()) return 0;
+  deliver(&remote,COAP_TYPE_NON,CONTENT_2_05,pending_mid+100,other,sizeof(other));
+  return !callbacks && sends==1 && coap_get_transaction_by_mid(pending_mid)!=NULL;
+}
+#define RUN(name) do { int ok=name(); cleanup(); printf("%s %s\n",#name,ok?"PASS":"FAIL"); failures+=!ok; } while(0)
+int main(int argc,char **argv) {
+  int failures=0;
+  int reg=argc==1 || !strcmp(argv[1],"regression");
+  int ctl=argc==1 || !strcmp(argv[1],"control");
+  if(argc>1 && !strcmp(argv[1],"dtls")) { RUN(dtls_payload); return failures?1:0; }
+  if(!reg && !ctl) return 1;
+  if(reg) { RUN(empty_ack_waits); RUN(acked_timeout); RUN(separate_non);
+    RUN(separate_con); RUN(separate_after_ack); RUN(wrong_token); RUN(wrong_endpoint); }
+  if(ctl) { RUN(piggyback_response); RUN(unacked_retries_timeout); RUN(unrelated_response); }
+  return failures?1:0;
+}

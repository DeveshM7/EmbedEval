diff --git a/tests/08-native-runs/embedeval-orchestra/main.c b/tests/08-native-runs/embedeval-orchestra/main.c
new file mode 100644
index 000000000..b56599d12
--- /dev/null
+++ b/tests/08-native-runs/embedeval-orchestra/main.c
@@ -0,0 +1,108 @@
+/* Real Orchestra dispatch, unicast rule, packetbuf and TSCH schedule are
+ * compiled separately. Only queue, locking, sniffer and root-rule boundaries
+ * are fixtures; this executable does not claim radio delivery. */
+#include "contiki.h"
+#include "orchestra.h"
+#include "net/packetbuf.h"
+#include "net/mac/framer/frame802154.h"
+#include "net/netstack.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+const linkaddr_t tsch_broadcast_address={{0xff,0xff}};
+struct tsch_link *current_link;
+static struct tsch_neighbor neighbors[4];
+static linkaddr_t addresses[4];
+static unsigned freed[4];
+static int locked;
+int curr_log_level_mac;
+void log_lladdr(const linkaddr_t *a) { (void)a; }
+int tsch_get_lock(void) { if(locked)return 0;locked=1;return 1; }
+void tsch_release_lock(void) { locked=0; }
+int tsch_is_locked(void) { return locked; }
+void netstack_sniffer_add(struct netstack_sniffer *s) { (void)s; }
+uint8_t orchestra_is_root_schedule_active(const linkaddr_t *a) { (void)a;return 0; }
+struct tsch_neighbor *tsch_queue_get_nbr(const linkaddr_t *a)
+{ for(unsigned i=0;i<4;i++)if(linkaddr_cmp(a,&addresses[i]))return &neighbors[i];return NULL; }
+struct tsch_neighbor *tsch_queue_add_nbr(const linkaddr_t *a) { return tsch_queue_get_nbr(a); }
+linkaddr_t *tsch_queue_get_nbr_address(const struct tsch_neighbor *n)
+{ if(!n)return NULL;for(unsigned i=0;i<4;i++)if(n==&neighbors[i])return &addresses[i];abort(); }
+void tsch_queue_free_packets_to(const linkaddr_t *a)
+{ for(unsigned i=0;i<4;i++)if(linkaddr_cmp(a,&addresses[i]))freed[i]++; }
+#define CHECK(condition) do { if(!(condition)) { \
+  fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#condition);return 1; } } while(0)
+static struct tsch_slotframe *sf;
+static void setup(void)
+{
+  for(unsigned i=0;i<3;i++)addresses[i].u8[LINKADDR_SIZE-1]=3+i;
+  addresses[3]=tsch_broadcast_address;
+  linkaddr_node_addr.u8[LINKADDR_SIZE-1]=2;
+  tsch_schedule_init();orchestra_init();sf=tsch_schedule_get_slotframe_by_handle(0);
+  if(!sf)abort();
+}
+static struct tsch_link *cell(unsigned node)
+{
+  return tsch_schedule_get_link_by_offsets(sf,ORCHESTRA_LINKADDR_HASH(&addresses[node])%ORCHESTRA_UNICAST_PERIOD,0);
+}
+static void add(unsigned node) { orchestra_callback_neighbor_updated(&addresses[node],1); }
+static void change(unsigned old, int new)
+{ orchestra_callback_new_time_source(&neighbors[old],new<0?NULL:&neighbors[new]); }
+static int selected_cell(unsigned node)
+{
+  packetbuf_clear();packetbuf_set_addr(PACKETBUF_ADDR_RECEIVER,&addresses[node]);
+  packetbuf_set_attr(PACKETBUF_ATTR_FRAME_TYPE,FRAME802154_DATAFRAME);
+  CHECK(orchestra_callback_packet_ready()==0);
+  struct tsch_slotframe *selected=tsch_schedule_get_slotframe_by_handle(packetbuf_attr(PACKETBUF_ATTR_TSCH_SLOTFRAME));
+  struct tsch_link *link=tsch_schedule_get_link_by_offsets(selected,packetbuf_attr(PACKETBUF_ATTR_TSCH_TIMESLOT),0);
+  CHECK(link!=NULL && (link->link_options&LINK_OPTION_TX));return 0;
+}
+static int switch_preserves_neighbor_link(void)
+{
+  setup();add(0);add(1);change(0,1);
+  CHECK(cell(0)!=NULL && (cell(0)->link_options&LINK_OPTION_TX));
+  for(unsigned i=0;i<10;i++)CHECK(selected_cell(0)==0);return 0;
+}
+static int loss_preserves_neighbor_link(void)
+{ setup();add(0);change(0,-1);CHECK(cell(0)!=NULL);CHECK(selected_cell(0)==0);return 0; }
+static int queued_frames_not_discarded(void)
+{ setup();add(0);add(1);change(0,1);CHECK(freed[0]==0);return 0; }
+static int non_neighbor_not_scheduled(void)
+{ setup();add(0);change(0,1);CHECK(cell(1)==NULL);return 0; }
+static int neighbor_added_has_tx(void)
+{ setup();add(0);CHECK(cell(0)!=NULL && (cell(0)->link_options&LINK_OPTION_TX));return 0; }
+static int neighbor_removed_cleanup(void)
+{ setup();add(0);orchestra_callback_neighbor_updated(&addresses[0],0);CHECK(cell(0)==NULL && freed[0]==1);return 0; }
+static int unchanged_source_preserved(void)
+{ setup();add(0);change(0,0);CHECK(cell(0)!=NULL && freed[0]==0);return 0; }
+static int initial_receive_cell(void)
+{
+  setup();struct tsch_link *link=tsch_schedule_get_link_by_timeslot(sf,ORCHESTRA_LINKADDR_HASH(&linkaddr_node_addr)%ORCHESTRA_UNICAST_PERIOD);
+  CHECK(link!=NULL && (link->link_options&LINK_OPTION_RX));return 0;
+}
+static int data_packet_select(void) { setup();add(0);CHECK(selected_cell(0)==0);return 0; }
+static int broadcast_not_selected(void)
+{ setup();packetbuf_clear();packetbuf_set_attr(PACKETBUF_ATTR_FRAME_TYPE,FRAME802154_DATAFRAME);CHECK(orchestra_callback_packet_ready()==-1);return 0; }
+static int nondata_not_selected(void)
+{ setup();add(0);packetbuf_clear();packetbuf_set_addr(PACKETBUF_ADDR_RECEIVER,&addresses[0]);packetbuf_set_attr(PACKETBUF_ATTR_FRAME_TYPE,FRAME802154_BEACONFRAME);CHECK(orchestra_callback_packet_ready()==-1);return 0; }
+static int unrelated_neighbor_preserved(void)
+{ setup();add(0);add(1);add(2);change(0,1);CHECK(cell(2)!=NULL && freed[2]==0);return 0; }
+struct test {const char *name;int (*run)(void);};
+static const struct test tests[]={
+  {"switch_preserves_neighbor_link",switch_preserves_neighbor_link},
+  {"loss_preserves_neighbor_link",loss_preserves_neighbor_link},
+  {"queued_frames_not_discarded",queued_frames_not_discarded},
+  {"non_neighbor_not_scheduled",non_neighbor_not_scheduled},
+  {"neighbor_added_has_tx",neighbor_added_has_tx},{"neighbor_removed_cleanup",neighbor_removed_cleanup},
+  {"unchanged_source_preserved",unchanged_source_preserved},{"initial_receive_cell",initial_receive_cell},
+  {"data_packet_select",data_packet_select},{"broadcast_not_selected",broadcast_not_selected},
+  {"nondata_not_selected",nondata_not_selected},{"unrelated_neighbor_preserved",unrelated_neighbor_preserved}
+};
+int main(int argc,char **argv)
+{
+  if(argc!=2)return 1;
+  for(unsigned i=0;i<sizeof(tests)/sizeof(tests[0]);i++)if(strcmp(argv[1],tests[i].name)==0) {
+    int rc=tests[i].run();printf("%s %s\n",tests[i].name,rc?"FAIL":"PASS");return rc;
+  }
+  return 1;
+}

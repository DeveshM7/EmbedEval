+import subprocess,sys
+regressions=['switch_preserves_neighbor_link', 'loss_preserves_neighbor_link', 'queued_frames_not_discarded', 'non_neighbor_not_scheduled']
+controls=['neighbor_added_has_tx', 'neighbor_removed_cleanup', 'unchanged_source_preserved', 'initial_receive_cell', 'data_packet_select', 'broadcast_not_selected', 'nondata_not_selected', 'unrelated_neighbor_preserved']
+mode=sys.argv[1] if len(sys.argv)>1 else 'all'
+if mode not in ['all','regression','control']:raise SystemExit(1)
+status=0
+for name in (regressions if mode=='regression' else controls if mode=='control' else regressions+controls):
+    try:
+        result=subprocess.run(['./build/orchestra',name],timeout=5)
+        if result.returncode and status!=2:status=1
+    except subprocess.TimeoutExpired:
+        print(name,'TIMEOUT',flush=True);status=2
+if mode!='regression':
+    try:
+        result=subprocess.run(['./build/upstream-controls'],timeout=30)
+        if result.returncode and status!=2:status=1
+    except subprocess.TimeoutExpired:
+        print('upstream-controls TIMEOUT',flush=True);status=2
+raise SystemExit(status)

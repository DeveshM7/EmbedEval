   return true;
 }
+
+/* Exercise both word sign bits through the actual NuttX API. */
+void synthetic_signal_boundary_test(void)
+{
+  sigset_t set;
+  int signals[] = {30, 31, 32, 62, 63};
+  unsigned i;
+  for (i = 0; i < sizeof(signals) / sizeof(signals[0]); i++)
+    {
+      int signo = signals[i];
+      int ok = sigemptyset(&set) == 0 && sigaddset(&set, signo) == 0;
+      ok = ok && sigismember(&set, signo) == 1;
+      printf("%s: signal_boundary_%d\n", ok ? "PASS" : "FAIL", signo);
+      ok = sigdelset(&set, signo) == 0 && sigismember(&set, signo) == 0;
+      printf("%s: signal_delete_%d\n", ok ? "PASS" : "FAIL", signo);
+    }
+}

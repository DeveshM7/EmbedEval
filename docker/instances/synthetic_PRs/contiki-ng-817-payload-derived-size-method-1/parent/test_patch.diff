diff --git a/tests/08-native-runs/embedeval-coap-block2/main.c b/tests/08-native-runs/embedeval-coap-block2/main.c
new file mode 100644
--- /dev/null
+++ b/tests/08-native-runs/embedeval-coap-block2/main.c
@@ -0,0 +1,123 @@
+/* Exercise the real CoAP parser, engine and serializer; only transport,
+ * transaction storage, observation and time are host fixtures. */
+#include "contiki.h"
+#include "coap-engine.h"
+#include "coap-transactions.h"
+#include "coap-observe.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static uint8_t sent[COAP_MAX_PACKET_SIZE + 64];
+static uint16_t sent_len;
+static unsigned handler_calls;
+static coap_transaction_t transaction;
+clock_time_t clock_time(void) { return 0; }
+void coap_transport_init(void) { }
+void coap_timer_set(coap_timer_t *timer, uint64_t time) { (void)timer; (void)time; abort(); }
+int coap_sendto(const coap_endpoint_t *ep, const uint8_t *data, uint16_t len) {
+  (void)ep;
+  if(len > sizeof(sent)) abort();
+  memcpy(sent, data, len); sent_len = len; return len;
+}
+coap_transaction_t *coap_new_transaction(uint16_t mid, const coap_endpoint_t *ep) {
+  memset(&transaction, 0, sizeof(transaction));
+  transaction.mid = mid; transaction.endpoint = *ep; return &transaction;
+}
+void coap_send_transaction(coap_transaction_t *t) {
+  coap_sendto(&t->endpoint, t->message, t->message_len);
+}
+void coap_clear_transaction(coap_transaction_t *t) { (void)t; }
+coap_transaction_t *coap_get_transaction_by_mid(uint16_t mid) { (void)mid; return NULL; }
+void coap_observe_handler(coap_resource_t *r, coap_message_t *q, coap_message_t *s) {
+  (void)r; (void)q; (void)s; /* No Observe option is used by this suite. */
+}
+int coap_remove_observer_by_mid(const coap_endpoint_t *ep, uint16_t mid) {
+  (void)ep; (void)mid; abort();
+}
+
+static int32_t next_offset;
+/* Discovery is never invoked by these requests. */
+coap_resource_t res_well_known_core;
+static unsigned body_len;
+static coap_handler_status_t handle(coap_message_t *q, coap_message_t *s,
+                                    uint8_t *b, uint16_t n, int32_t *o) {
+  unsigned i;
+  (void)q;
+  if(body_len > n) abort();
+  for(i=0; i<body_len; i++) b[i]=(uint8_t)('a'+i%26);
+  handler_calls++;
+  *o=next_offset;
+  coap_set_payload(s,b,body_len);
+  return COAP_HANDLER_STATUS_PROCESSED;
+}
+COAP_HANDLER(handler,handle);
+static int exchange(int32_t offset, unsigned length, unsigned request_size,
+                    unsigned request_num, unsigned expected_size,
+                    unsigned expected_length, unsigned more, unsigned type) {
+  coap_endpoint_t ep={0};
+  coap_message_t q,s;
+  uint8_t wire[COAP_MAX_PACKET_SIZE+64];
+  uint8_t token[]={0xa5,0x5a};
+  uint32_t num=999, off=999;
+  uint16_t size=0; uint8_t m=9;
+  unsigned i, len;
+  next_offset=offset; body_len=length; sent_len=0; handler_calls=0;
+  coap_init_message(&q,type,COAP_GET,0x1234);
+  coap_set_token(&q,token,sizeof(token));
+  if(request_size) coap_set_header_block2(&q,request_num,0,request_size);
+  len=coap_serialize_message(&q,wire);
+  if(!len) return 0;
+  coap_receive(&ep,wire,len);
+  if(!sent_len || coap_parse_message(&s,sent,sent_len)!=NO_ERROR) return 0;
+  if(handler_calls!=1 || s.code!=CONTENT_2_05 || s.token_len!=2
+     || memcmp(s.token,token,2)) return 0;
+  if(type==COAP_TYPE_CON && (s.type!=COAP_TYPE_ACK || s.mid!=0x1234)) return 0;
+  if(type==COAP_TYPE_NON && s.type!=COAP_TYPE_NON) return 0;
+  if(expected_size) {
+    if(!coap_get_header_block2(&s,&num,&m,&size,&off)
+       || size!=expected_size || num!=request_num || m!=more
+       || off!=request_num*expected_size) return 0;
+  } else if(coap_get_header_block2(&s,&num,&m,&size,&off)) return 0;
+  if(s.payload_len!=expected_length) return 0;
+  for(i=0;i<expected_length;i++) if(s.payload[i]!=(uint8_t)('a'+i%26)) return 0;
+  return 1;
+}
+static int small_block(void) {
+  unsigned size,type;
+  for(size=16;size<COAP_MAX_BLOCK_SIZE;size*=2)
+    for(type=COAP_TYPE_CON;type<=COAP_TYPE_NON;type++)
+      if(!exchange(size,size,0,0,size,size,1,type)) return 0;
+  return 1;
+}
+static int capped_payload(void) {
+  return exchange(16,32,0,0,16,16,1,COAP_TYPE_CON);
+}
+static int ordinary_response(void) {
+  return exchange(0,16,0,0,0,16,0,COAP_TYPE_CON);
+}
+static int maximum_block(void) {
+  return exchange(COAP_MAX_BLOCK_SIZE,COAP_MAX_BLOCK_SIZE,0,0,
+                  COAP_MAX_BLOCK_SIZE,COAP_MAX_BLOCK_SIZE,1,COAP_TYPE_CON);
+}
+static int large_offset(void) {
+  return exchange(COAP_MAX_BLOCK_SIZE*2,16,0,0,COAP_MAX_BLOCK_SIZE,16,1,COAP_TYPE_CON);
+}
+static int final_block(void) {
+  return exchange(-1,16,0,0,COAP_MAX_BLOCK_SIZE,16,0,COAP_TYPE_CON);
+}
+static int explicit_block(void) {
+  return exchange(32,16,16,1,16,16,1,COAP_TYPE_CON)
+      && exchange(-1,16,16,1,16,16,0,COAP_TYPE_CON);
+}
+#define RUN(name) do { int ok=name(); printf("%s %s\n",#name,ok?"PASS":"FAIL"); failures+=!ok; } while(0)
+int main(int argc,char **argv) {
+  int failures=0;
+  int reg=argc==1 || !strcmp(argv[1],"regression");
+  int ctl=argc==1 || !strcmp(argv[1],"control");
+  if(!reg && !ctl) return 1;
+  coap_add_handler(&handler);
+  if(reg) { RUN(small_block); RUN(capped_payload); }
+  if(ctl) { RUN(ordinary_response); RUN(maximum_block); RUN(large_offset);
+            RUN(final_block); RUN(explicit_block); }
+  return failures?1:0;
+}

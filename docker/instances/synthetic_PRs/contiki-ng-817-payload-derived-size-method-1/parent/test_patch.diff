+set -euo pipefail
+mkdir -p build
+cc -std=c99 -O2 -g -ffunction-sections -fdata-sections \
+  -Itests/08-native-runs/embedeval-coap-block2 -Ios -Ios/net/app-layer/coap \
+  tests/08-native-runs/embedeval-coap-block2/main.c os/net/app-layer/coap/coap.c \
+  os/net/app-layer/coap/coap-engine.c os/lib/list.c os/lib/random.c \
+  -Wl,--gc-sections -o build/coap-block2
diff --git a/tests/08-native-runs/embedeval-coap-block2/contiki-conf.h b/tests/08-native-runs/embedeval-coap-block2/contiki-conf.h
new file mode 100644

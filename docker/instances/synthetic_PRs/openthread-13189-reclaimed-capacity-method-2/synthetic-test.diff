+static void TestReclaimedCapacity(void)
+{
+    Buffer buffer;
+    WriteFrame(buffer, 24, 0x11);
+    SuccessOrQuit(buffer.SaveFrame());
+    WriteFrame(buffer, 8, 0x22);
+    SuccessOrQuit(buffer.SaveFrame());
+    WriteFrame(buffer, 12, 0x55);
+    buffer.ClearSavedFrames();
+    VerifyOrQuit(buffer.GetLength() == 12);
+    // 128 - 4 header - 12 pending = 112 bytes are writable after compaction.
+    VerifyOrQuit(buffer.CanWrite(112), "compaction must return reclaimed capacity");
+    WriteFrame(buffer, 80, 0x66);
+    VerifyOrQuit(buffer.GetLength() == 92);
+    for (unsigned i = 0; i < 12; i++) VerifyOrQuit(buffer.GetFrame()[i] == 0x55);
+    for (unsigned i = 12; i < 92; i++) VerifyOrQuit(buffer.GetFrame()[i] == 0x66);
+}
+
 int main(int argc, char *argv[])
 {
     VerifyOrQuit(argc == 2, "expected one test name");

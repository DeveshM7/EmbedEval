diff --git a/tests/08-native-runs/embedeval-tsch-cs/main.c b/tests/08-native-runs/embedeval-tsch-cs/main.c
new file mode 100644
index 000000000..58b9cc238
--- /dev/null
+++ b/tests/08-native-runs/embedeval-tsch-cs/main.c
@@ -0,0 +1,127 @@
+/* Host component fixture. The complete upstream channel-selection module is
+ * linked separately; only clock and TSCH state inputs are supplied here. */
+#include "tsch.h"
+#include "tsch-stats.h"
+#include "tsch-cs.h"
+#include <stdio.h>
+#include <string.h>
+
+int tsch_is_coordinator = 1;
+uint8_t tsch_hopping_sequence[TSCH_HOPPING_SEQUENCE_MAX_LEN];
+struct tsch_asn_divisor_t tsch_hopping_sequence_length;
+struct tsch_global_stats tsch_stats;
+static unsigned long now = 1000;
+unsigned long clock_seconds(void) { return now; }
+#define CHECK(condition) do { if(!(condition)) { \
+  fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#condition);return 1; } } while(0)
+static void sequence(const uint8_t *channels, unsigned length)
+{
+  memset(tsch_hopping_sequence,0,sizeof(tsch_hopping_sequence));
+  memcpy(tsch_hopping_sequence,channels,length);
+  tsch_hopping_sequence_length.val=length;
+}
+static void setup(void)
+{
+  const uint8_t channels[]={11,12};
+  sequence(channels,2);
+  memset(&tsch_stats,0,sizeof(tsch_stats));
+  tsch_cs_adaptations_init();
+}
+static void qualities(unsigned busy)
+{
+  memset(tsch_stats.channel_free_ewma,0,sizeof(tsch_stats.channel_free_ewma));
+  tsch_stats.channel_free_ewma[0]=busy==11?0:3800;
+  tsch_stats.channel_free_ewma[1]=busy==12?0:3800;
+  tsch_stats.channel_free_ewma[2]=4096;
+}
+static void request(void)
+{
+  // A valid tracked channel changes busyness; this schedules reselection.
+  tsch_cs_channel_stats_updated(11,4096);
+}
+static int invalid_init_below_window(void)
+{
+  const uint8_t bad[]={10,12};setup();sequence(bad,2);
+  tsch_cs_adaptations_init();return 0; // UBSan must not detect an invalid shift.
+}
+static int invalid_init_preserves_state(unsigned kind)
+{
+  uint8_t channels[17];setup();
+  if(kind==0) { channels[0]=27;channels[1]=12;sequence(channels,2); }
+  else { memset(channels,11,sizeof(channels));sequence(channels,17); }
+  tsch_cs_adaptations_init();
+  const uint8_t good[]={11,12};sequence(good,2);
+  qualities(kind==0?12:11);tsch_cs_channel_stats_updated(kind==0?12:11,4096);
+  CHECK(tsch_cs_process());
+  CHECK(tsch_hopping_sequence[0]==(kind==0?11:13));
+  CHECK(tsch_hopping_sequence[1]==(kind==0?13:12));return 0;
+}
+static int invalid_init_above_window(void) { return invalid_init_preserves_state(0); }
+static int invalid_init_overlong(void) { return invalid_init_preserves_state(1); }
+static int invalid_process(unsigned kind)
+{
+  uint8_t channels[17], saved[TSCH_HOPPING_SEQUENCE_MAX_LEN];setup();
+  if(kind<2) { channels[0]=kind==0?10:27;channels[1]=12;sequence(channels,2); }
+  else { memset(channels,11,sizeof(channels));sequence(channels,17); }
+  memcpy(saved,tsch_hopping_sequence,sizeof(saved));qualities(11);request();
+  CHECK(!tsch_cs_process());
+  CHECK(memcmp(saved,tsch_hopping_sequence,sizeof(saved))==0);
+  CHECK(tsch_hopping_sequence_length.val==(kind<2?2:17));return 0;
+}
+static int invalid_process_below_window(void) { return invalid_process(0); }
+static int invalid_process_above_window(void) { return invalid_process(1); }
+static int invalid_process_overlong(void) { return invalid_process(2); }
+static int valid_reselection(void)
+{
+  setup();qualities(11);request();CHECK(tsch_cs_process());
+  CHECK(tsch_hopping_sequence[0]==13 && tsch_hopping_sequence[1]==12);
+  CHECK(tsch_hopping_sequence_length.val==2);return 0;
+}
+static int valid_nochange(void)
+{
+  setup();for(unsigned i=0;i<16;i++)tsch_stats.channel_free_ewma[i]=4096;
+  tsch_cs_channel_stats_updated(11,0);CHECK(!tsch_cs_process());
+  CHECK(tsch_hopping_sequence[0]==11 && tsch_hopping_sequence[1]==12);return 0;
+}
+static int no_request(void)
+{ setup();qualities(11);CHECK(!tsch_cs_process());return 0; }
+static int noncoordinator(void)
+{ setup();qualities(11);tsch_is_coordinator=0;request();CHECK(!tsch_cs_process());return 0; }
+static int learning_period(void)
+{ setup();qualities(11);now=10;request();CHECK(!tsch_cs_process());return 0; }
+static int valid_full_window(void)
+{
+  uint8_t channels[16];for(unsigned i=0;i<16;i++)channels[i]=11+i;
+  sequence(channels,16);tsch_cs_adaptations_init();
+  for(unsigned i=0;i<16;i++)tsch_stats.channel_free_ewma[i]=4096;
+  tsch_stats.channel_free_ewma[0]=0;request();CHECK(!tsch_cs_process());
+  CHECK(memcmp(channels,tsch_hopping_sequence,16)==0);return 0;
+}
+static int cooldown(void)
+{
+  CHECK(valid_reselection()==0);now=1001;
+  tsch_stats.channel_free_ewma[1]=0;tsch_cs_channel_stats_updated(12,4096);
+  CHECK(!tsch_cs_process());
+  CHECK(tsch_hopping_sequence[0]==13 && tsch_hopping_sequence[1]==12);return 0;
+}
+struct test {const char *name;int (*run)(void);};
+static const struct test tests[]={
+  {"invalid_init_below_window",invalid_init_below_window},
+  {"invalid_init_above_window",invalid_init_above_window},
+  {"invalid_init_overlong",invalid_init_overlong},
+  {"invalid_process_below_window",invalid_process_below_window},
+  {"invalid_process_above_window",invalid_process_above_window},
+  {"invalid_process_overlong",invalid_process_overlong},
+  {"valid_reselection",valid_reselection},{"valid_nochange",valid_nochange},
+  {"no_request",no_request},{"noncoordinator",noncoordinator},
+  {"learning_period",learning_period},{"valid_full_window",valid_full_window},
+  {"cooldown",cooldown}
+};
+int main(int argc,char **argv)
+{
+  if(argc!=2)return 1;
+  for(unsigned i=0;i<sizeof(tests)/sizeof(tests[0]);i++)if(strcmp(argv[1],tests[i].name)==0) {
+    int rc=tests[i].run();printf("%s %s\n",tests[i].name,rc?"FAIL":"PASS");return rc;
+  }
+  return 1;
+}

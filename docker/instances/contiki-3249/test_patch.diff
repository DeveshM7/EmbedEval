diff --git a/tests/08-native-runs/embedeval-tsch-cs/run.py b/tests/08-native-runs/embedeval-tsch-cs/run.py
new file mode 100644
index 000000000..885703972
--- /dev/null
+++ b/tests/08-native-runs/embedeval-tsch-cs/run.py
@@ -0,0 +1,40 @@
+import os,subprocess,sys
+from pathlib import Path
+regressions=['invalid_init_below_window','invalid_init_above_window','invalid_init_overlong','invalid_process_below_window','invalid_process_above_window','invalid_process_overlong']
+controls=['valid_reselection','valid_nochange','no_request','noncoordinator','learning_period','valid_full_window','cooldown']
+probes={
+    'reject_bitmap_too_wide':(['-DTSCH_STATS_CONF_NUM_CHANNELS=17'],False),
+    'reject_channel_window_overflow':(['-DTSCH_STATS_CONF_FIRST_CHANNEL=250'],False),
+    'compile_default_window':([],True),
+    'compile_narrow_window':(['-DTSCH_STATS_CONF_NUM_CHANNELS=4'],True),
+    'compile_top_channel_window':(['-DTSCH_STATS_CONF_FIRST_CHANNEL=240'],True)
+}
+mode=sys.argv[1] if len(sys.argv)>1 else 'all'
+if mode not in ['all','regression','control']:raise SystemExit(1)
+status=0
+for name in (regressions if mode=='regression' else controls if mode=='control' else regressions+controls):
+    try:
+        result=subprocess.run(['./build/tsch-cs',name],timeout=5)
+        if result.returncode and status!=2:status=1
+    except subprocess.TimeoutExpired:
+        print(name,'TIMEOUT',flush=True);status=2
+fixture='tests/08-native-runs/embedeval-tsch-cs'
+flags=['-std=c11','-O1','-g','-fsanitize=undefined','-fno-sanitize-recover=all','-I'+fixture,'-Ios','-Ios/net/mac/tsch','-Ios/services/tsch-cs']
+for name,(defines,should_compile) in probes.items():
+    if mode=='regression' and should_compile or mode=='control' and not should_compile:continue
+    try:
+        result=subprocess.run([os.environ.get('CC','cc'),*flags,*defines,'-c','os/services/tsch-cs/tsch-cs.c','-o','build/'+name+'.o'],capture_output=True,text=True,timeout=30)
+        passed=result.returncode==0 if should_compile else result.returncode!=0 and 'tsch-cs:' in result.stderr
+        print(name,'PASS' if passed else 'FAIL',flush=True)
+        if not passed:
+            print(result.stdout+result.stderr,flush=True)
+            if status!=2:status=1
+    except subprocess.TimeoutExpired:
+        print(name,'TIMEOUT',flush=True);status=2
+if mode!='regression':
+    try:
+        result=subprocess.run(['./build/upstream-controls'],timeout=30)
+        if result.returncode and status!=2:status=1
+    except subprocess.TimeoutExpired:
+        print('upstream-controls TIMEOUT',flush=True);status=2
+raise SystemExit(status)

+#!/usr/bin/env python3
+"""Benchmark-authored regression tests for OpenThread PR #13461."""
+import ipaddress
+import sys
+import unittest
+from pathlib import Path
+
+# Also works with portable Python's isolated module search path.
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from pktverify.addrs import Ipv6Addr
+from pktverify.bytes import Bytes
+
+
+class TestIpv6AddrRegression(unittest.TestCase):
+    def check_address(self, value, expected_hex):
+        address = Ipv6Addr(value)
+        expected = bytes.fromhex(expected_hex)
+        self.assertEqual(len(address), 16)
+        self.assertEqual(bytes(address), expected)
+        self.assertEqual(address.format_compact(), expected_hex)
+        return address
+
+    def test_mapped_expanded_hex(self):
+        self.check_address("0:0:0:0:0:ffff:c0a8:d964",
+                           "00000000000000000000ffffc0a8d964")
+        self.check_address("0000:0000:0000:0000:0000:FFFF:C0A8:D964",
+                           "00000000000000000000ffffc0a8d964")
+
+    def test_mapped_compressed_hex(self):
+        self.check_address("::ffff:c0a8:d964",
+                           "00000000000000000000ffffc0a8d964")
+
+    def test_mapped_dotted_quad(self):
+        for value in ("::ffff:192.168.217.100",
+                      "0:0:0:0:0:ffff:192.168.217.100"):
+            with self.subTest(value=value):
+                self.check_address(value, "00000000000000000000ffffc0a8d964")
+
+    def test_mapped_boundary_values(self):
+        for value, expected in (
+            ("::ffff:0.0.0.0", "00000000000000000000ffff00000000"),
+            ("::ffff:255.255.255.255", "00000000000000000000ffffffffffff"),
+            ("::ffff:127.0.0.1", "00000000000000000000ffff7f000001"),
+        ):
+            with self.subTest(value=value):
+                self.check_address(value, expected)
+
+    def test_ordinary_ipv6(self):
+        for value, expected in (
+            ("::", "00000000000000000000000000000000"),
+            ("::1", "00000000000000000000000000000001"),
+            ("2001:db8::1", "20010db8000000000000000000000001"),
+            ("fd00:db8::ff:fe00:8001", "fd000db800000000000000fffe008001"),
+            ("64:ff9b::192.0.2.1", "0064ff9b0000000000000000c0000201"),
+        ):
+            with self.subTest(value=value):
+                self.check_address(value, expected)
+
+    def test_legacy_string_formats(self):
+        expected = "00112233445566778899aabbccddeeff"
+        for value in (
+            expected,
+            "00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff",
+            "0011:2233:4455:6677:8899:aabb:ccdd:eeff",
+        ):
+            with self.subTest(value=value):
+                self.check_address(value, expected)
+
+    def test_binary_inputs(self):
+        expected = "00000000000000000000ffffc0a8d964"
+        raw = bytes.fromhex(expected)
+        for value in (raw, bytearray(raw), Bytes(raw)):
+            with self.subTest(type=type(value).__name__):
+                address = self.check_address(value, expected)
+                self.assertIsInstance(address[:4], Bytes)
+                self.assertEqual(bytes(address[-4:]), bytes.fromhex("c0a8d964"))
+
+    def test_formatting_and_classification(self):
+        for value, link_local, multicast, global_address in (
+            ("2001:4860::8888", False, False, True),
+            ("fe80::1", True, False, False),
+            ("ff02::1", False, True, True),
+            ("::1", False, False, False),
+        ):
+            with self.subTest(value=value):
+                address = Ipv6Addr(value)
+                self.assertEqual(address.is_link_local, link_local)
+                self.assertEqual(address.is_multicast, multicast)
+                self.assertEqual(address.is_global, global_address)
+                self.assertEqual(bytes(Ipv6Addr(str(address))), bytes(address))
+                self.assertEqual(bytes(eval(repr(address), {"Ipv6Addr": Ipv6Addr})),
+                                 bytes(address))
+
+    def test_invalid_inputs(self):
+        for value in ("", "not-an-address", "192.168.217.100",
+                      "::ffff:192.168.217.256", "2001::db8::1",
+                      "001122", b"", bytes(15), bytes(17)):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    Ipv6Addr(value)
+
+
+if __name__ == "__main__":
+    # Fail clearly on an incompatible runtime instead of giving a free pass.
+    if sys.version_info[:3] != (3, 13, 7):
+        raise SystemExit("This benchmark requires Python 3.13.7")
+    expanded = ipaddress.IPv6Address("::ffff:c0a8:d964").exploded
+    if expanded != "0000:0000:0000:0000:0000:ffff:192.168.217.100":
+        raise SystemExit("Runtime does not reproduce the IPv4-mapped formatting")
+    unittest.main()

{
    "_comment": [
        "Per-model profiles for PR triage, read by scripts/serve_triage_model.sh",
        "(weights, vllm_args, env) and scripts/triage_prs.py (sampling, max_tokens).",
        "{models} in vllm_args expands to the weights root, $EMBEDEVAL_MODELS.",
        "Flags come from each model's card or vLLM recipe; both profiles were",
        "smoke-tested on a Scholar Spark node on 2026-09-30."
    ],

    "qwen38": {
        "weights": "Qwen3.8-27B-FP8",
        "source": "https://recipes.vllm.ai/Qwen/Qwen3.8-27B",
        "vllm_args": [
            "--language-model-only",
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--speculative-config", "{\"method\":\"mtp\",\"num_speculative_tokens\":3}",
            "--reasoning-parser", "qwen3",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_xml"
        ],
        "env": {},
        "sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0},
        "max_tokens": 32768
    },

    "qwen38-nvfp4": {
        "weights": "Qwen3.8-27B-NVFP4",
        "source": "https://recipes.vllm.ai/Qwen/Qwen3.8-27B (low-latency NVFP4, Inferact/Qwen3.8-27B-NVFP4)",
        "vllm_args": [
            "--language-model-only",
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--speculative-config", "{\"method\":\"mtp\",\"num_speculative_tokens\":3}",
            "--reasoning-parser", "qwen3",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_xml"
        ],
        "env": {},
        "sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0},
        "max_tokens": 32768
    },

    "nemotron": {
        "weights": "Nemotron-3-Super-120B-A12B-NVFP4",
        "source": "https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4 (vLLM on DGX Spark)",
        "vllm_args": [
            "--async-scheduling", "--dtype", "auto", "--kv-cache-dtype", "fp8",
            "--trust-remote-code", "--enable-chunked-prefill",
            "--moe-backend", "marlin", "--mamba_ssm_cache_dtype", "float16",
            "--quantization", "fp4",
            "--speculative_config", "{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"model\":\"{models}/Nemotron-3-Super-120B-A12B-BF16-MTPv2\",\"moe_backend\":\"triton\"}",
            "--reasoning-parser-plugin", "{models}/Nemotron-3-Super-120B-A12B-NVFP4/super_v3_reasoning_parser.py",
            "--reasoning-parser", "super_v3",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_coder"
        ],
        "env": {
            "VLLM_NVFP4_GEMM_BACKEND": "marlin",
            "VLLM_FLASHINFER_ALLREDUCE_BACKEND": "trtllm",
            "VLLM_USE_FLASHINFER_MOE_FP4": "0"
        },
        "sampling": {"temperature": 0.6},
        "max_tokens": 32768
    }
}

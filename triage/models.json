{
    "_comment": [
        "Per-model profiles for PR triage, read by scripts/serve_triage_model.sh",
        "(weights, vllm_args, env) and scripts/triage_prs.py (sampling, max_tokens).",
        "{models} in vllm_args expands to the weights root, $EMBEDEVAL_MODELS.",
        "Flags come from each model's card or vLLM recipe; both profiles were",
        "smoke-tested on a Scholar Spark node on 2026-09-30."
    ],

    "qwen38": {
        "weights": "Qwen3.8-27B-FP8",
        "source": "https://recipes.vllm.ai/Qwen/Qwen3.8-27B",
        "vllm_args": [
            "--language-model-only",
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--speculative-config", "{\"method\":\"mtp\",\"num_speculative_tokens\":3}",
            "--reasoning-parser", "qwen3",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_xml"
        ],
        "env": {},
        "sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0},
        "max_tokens": 32768
    },

    "qwen38-nvfp4": {
        "weights": "Qwen3.8-27B-NVFP4",
        "source": "https://recipes.vllm.ai/Qwen/Qwen3.8-27B (low-latency NVFP4, Inferact/Qwen3.8-27B-NVFP4)",
        "vllm_args": [
            "--language-model-only",
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--speculative-config", "{\"method\":\"mtp\",\"num_speculative_tokens\":3}",
            "--reasoning-parser", "qwen3",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_xml"
        ],
        "env": {},
        "sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0},
        "max_tokens": 32768
    },

    "nemotron": {
        "weights": "Nemotron-3-Super-120B-A12B-NVFP4",
        "source": "https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4 (vLLM on DGX Spark)",
        "vllm_args": [
            "--async-scheduling", "--dtype", "auto", "--kv-cache-dtype", "fp8",
            "--trust-remote-code", "--enable-chunked-prefill",
            "--moe-backend", "marlin", "--mamba_ssm_cache_dtype", "float16",
            "--quantization", "fp4",
            "--speculative_config", "{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"model\":\"{models}/Nemotron-3-Super-120B-A12B-BF16-MTPv2\",\"moe_backend\":\"triton\"}",
            "--reasoning-parser-plugin", "{models}/Nemotron-3-Super-120B-A12B-NVFP4/super_v3_reasoning_parser.py",
            "--reasoning-parser", "super_v3",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_coder"
        ],
        "env": {
            "VLLM_NVFP4_GEMM_BACKEND": "marlin",
            "VLLM_FLASHINFER_ALLREDUCE_BACKEND": "trtllm",
            "VLLM_USE_FLASHINFER_MOE_FP4": "0"
        },
        "sampling": {"temperature": 0.6},
        "max_tokens": 32768
    },

    "minimax-m25-nvfp4": {
        "weights": "MiniMax-M2.5-NVFP4",
        "source": "https://huggingface.co/nvidia/MiniMax-M2.5-NVFP4; published bash-only run (mini-swe-agent 2.0.0): provider default sampling, reasoning effort high",
        "nodes": 2,
        "vllm_args": [
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--trust-remote-code",
            "--reasoning-parser", "minimax_m2_append_think",
            "--enable-auto-tool-choice", "--tool-call-parser", "minimax_m2"
        ],
        "env": {},
        "sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 40},
        "max_tokens": 32768,
        "max_model_len": 196608
    },

    "devstral-small-2": {
        "weights": "Devstral-Small-2-24B-Instruct-2512",
        "source": "https://huggingface.co/mistralai/Devstral-Small-2-24B-Instruct-2512; published bash-only run (mini-swe-agent 1.17.2): temperature 0.0. Mistral's tokenizer (tekken.json); text only (the model also takes images)",
        "vllm_args": [
            "--tokenizer-mode", "mistral",
            "--language-model-only",
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--enable-auto-tool-choice", "--tool-call-parser", "mistral"
        ],
        "env": {},
        "sampling": {"temperature": 0.0},
        "max_tokens": 32768,
        "max_model_len": 262144
    },

    "gpt-oss-120b": {
        "weights": "gpt-oss-120b",
        "source": "https://huggingface.co/openai/gpt-oss-120b; published bash-only run (mini-swe-agent 1.7.0) recorded no sampling: OpenAI's recommended temperature 1.0, top_p 1.0",
        "vllm_args": [
            "--enable-prefix-caching",
            "--reasoning-parser", "openai_gptoss",
            "--enable-auto-tool-choice", "--tool-call-parser", "openai"
        ],
        "env": {"TIKTOKEN_ENCODINGS_BASE": "{models}/gpt-oss-120b/tiktoken"},
        "repair_tool_args": true,
        "sampling": {"temperature": 1.0, "top_p": 1.0},
        "max_tokens": 32768,
        "max_model_len": 131072
    },

    "qwen25-coder-32b": {
        "weights": "Qwen2.5-Coder-32B-Instruct",
        "source": "https://huggingface.co/Qwen/Qwen2.5-Coder-32B-Instruct; published bash-only run (mini-swe-agent 1.0.0) recorded no sampling: Qwen's recommended. Native context 32k, extended to 128k with YaRN x4 as the model card describes",
        "vllm_args": [
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--hf-overrides", "{\"rope_scaling\":{\"rope_type\":\"yarn\",\"factor\":4.0,\"original_max_position_embeddings\":32768}}",
            "--tool-parser-plugin", "{repo}/triage/vllm_plugins/qwen25_coder_tool_parser.py",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen25_coder"
        ],
        "env": {},
        "sampling": {"temperature": 0.7, "top_p": 0.8, "top_k": 20, "repetition_penalty": 1.05},
        "max_tokens": 8192,
        "max_model_len": 131072
    },

    "qwen25-coder-32b-fp8": {
        "weights": "Qwen2.5-Coder-32B-Instruct",
        "source": "as qwen25-coder-32b, quantized to FP8 by vLLM at load time (BF16 was ~3.4 tok/s on GB10)",
        "vllm_args": [
            "--quantization", "fp8",
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--hf-overrides", "{\"rope_scaling\":{\"rope_type\":\"yarn\",\"factor\":4.0,\"original_max_position_embeddings\":32768}}",
            "--tool-parser-plugin", "{repo}/triage/vllm_plugins/qwen25_coder_tool_parser.py",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen25_coder"
        ],
        "env": {},
        "sampling": {"temperature": 0.7, "top_p": 0.8, "top_k": 20, "repetition_penalty": 1.05},
        "max_tokens": 8192,
        "max_model_len": 131072
    },

    "qwen25-coder-32b-awq": {
        "weights": "Qwen2.5-Coder-32B-Instruct-AWQ",
        "source": "https://huggingface.co/Qwen/Qwen2.5-Coder-32B-Instruct-AWQ (Qwen's 4-bit AWQ); otherwise as qwen25-coder-32b",
        "vllm_args": [
            "--enable-prefix-caching",
            "--kv-cache-dtype", "fp8",
            "--hf-overrides", "{\"rope_scaling\":{\"rope_type\":\"yarn\",\"factor\":4.0,\"original_max_position_embeddings\":32768}}",
            "--tool-parser-plugin", "{repo}/triage/vllm_plugins/qwen25_coder_tool_parser.py",
            "--enable-auto-tool-choice", "--tool-call-parser", "qwen25_coder"
        ],
        "env": {},
        "sampling": {"temperature": 0.7, "top_p": 0.8, "top_k": 20, "repetition_penalty": 1.05},
        "max_tokens": 8192,
        "max_model_len": 131072
    }
}

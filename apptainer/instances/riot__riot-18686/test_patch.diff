diff --git a/tests/unittests/tests-checksum/tests-checksum-crc32.c b/tests/unittests/tests-checksum/tests-checksum-crc32.c
new file mode 100644
index 0000000000..49b2ed8c7c
--- /dev/null
+++ b/tests/unittests/tests-checksum/tests-checksum-crc32.c
@@ -0,0 +1,72 @@
+/*

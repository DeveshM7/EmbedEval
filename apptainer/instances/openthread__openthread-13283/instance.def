Bootstrap: localimage
From: {{ BASE_IMAGE }}

# EmbedEval instance openthread__openthread-13283 -- generated by scripts/generate_instance.py.
#
# Built FROM the shared OpenThread base image (toolchain only), whose path is
# passed at build time:
#
#   apptainer build --fakeroot --build-arg BASE_IMAGE=<openthread-base-*.sif> \
#       openthread__openthread-13283.sif instance.def
#
# Adds the PR's workspace: OpenThread at the base commit, the PR's test changes
# without its fix, and a first build of the chosen target so later builds are
# incremental.

%arguments
    BASE_IMAGE=openthread-base.sif

%files
    test_patch.diff /opt/embedeval/test_patch.diff
    instance.json /opt/embedeval/instance.json
    run_tests.py /usr/local/bin/run_tests

%post
    set -e
    retry() { for i in 1 2 3; do "$@" && return 0; echo "retry $i: $*"; sleep 20; done; return 1; }

    # OpenThread at exactly the base commit, shallow.
    git init -q /testbed
    cd /testbed
    git remote add origin https://github.com/openthread/openthread.git
    retry git fetch -q --depth 1 origin 5f03f0e14b510e1ca201f50021367975d44b76b8
    git checkout -q --detach FETCH_HEAD

    # Submodules, whichever this commit has: none before 2025-11-12 (mbedtls
    # was vendored), third_party/mbedtls/repo after, which has a nested one of
    # its own (so --recursive). Nothing is named here.
    retry git submodule update --init --depth 1 --recursive

    # The PR's test changes without its fix.
    git apply /opt/embedeval/test_patch.diff
    printf 'build/\ntags\n' >> .git/info/exclude
    # ctags index for code navigation; the agent's prompt points to it.
    ctags -R --languages=C,C++ -f /testbed/tags src include tests || true
    chmod 755 /usr/local/bin/run_tests

    # First configure and build of the chosen target. Allowed to fail: without
    # the fix the tests may not compile, and that must not fail the image build.
    run_tests --build-only || true

%environment
    export LANG=C.UTF-8

%labels
    embedeval.instance openthread__openthread-13283
    embedeval.base_commit 5f03f0e14b510e1ca201f50021367975d44b76b8

     ot::Nexus::TestNat64CidrAddressReuse("192.168.103.0/30");
     ot::Nexus::TestNat64CidrAddressReuse("192.168.104.0/27");
     ot::Nexus::TestNat64Evict();
+    ot::Nexus::TestNat64IhlBypass();
 

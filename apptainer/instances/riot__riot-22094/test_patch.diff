@@ -32,19 +32,56 @@ static void test_nanocoap__hdr(void)
     char path[] = "/test/abcd/efgh";
     char loc_path[] = "/foo/bar";
     char path_tmp[64] = {0};
+    const void *token = NULL;
+    const uint8_t tkl = 0;

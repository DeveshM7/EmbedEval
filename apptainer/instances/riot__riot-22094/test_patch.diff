+    TEST_ASSERT_EQUAL_INT(21, len);
+    /* build again using coap_build_reply_header() */
+    len = coap_build_reply_header(&pkt, COAP_CODE_DELETED, rbuf,
+                                  sizeof(rbuf), 0, NULL, NULL);
     TEST_ASSERT_EQUAL_INT(21, len);
     res = coap_parse_udp(&pkt, rbuf, 21);

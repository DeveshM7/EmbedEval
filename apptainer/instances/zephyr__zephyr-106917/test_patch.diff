 K_MUTEX_DEFINE(kobject_mutex);
 
 static struct k_thread kobj_child_thread;
@@ -389,6 +390,14 @@ static void access_all_grant_child_take(void *p1, void *p2, void *p3)
 	k_sem_take(&kobject_public_sem, K_FOREVER);

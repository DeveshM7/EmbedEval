diff --git a/tests/pkg_mbedtls/main.c b/tests/pkg_mbedtls/main.c
new file mode 100644
index 0000000000..42905d502f
--- /dev/null
+++ b/tests/pkg_mbedtls/main.c
@@ -0,0 +1,46 @@
+/*

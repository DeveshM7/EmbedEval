+	test_shell_execute_cmd("cmd1", 10);
+	test_shell_wait_for_output(sh,
+				   "Alias 'cmd1' ignored because command "
+				   "exists in current context");
+
+	ret = shell_set_root_cmd(NULL);
+	zassert_equal(ret, 0, "Unexpected error %d", ret);

+  UNIT_TEST_ASSERT(dbl_list_length(dll) == 0);
+  UNIT_TEST_ASSERT(dbl_list_head(dll) == NULL);
+  UNIT_TEST_ASSERT(dbl_list_tail(dll) == NULL);
+
+  UNIT_TEST_END();

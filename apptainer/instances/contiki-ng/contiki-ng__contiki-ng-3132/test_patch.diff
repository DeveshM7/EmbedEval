@@ -0,0 +1,145 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<simconf version="2022112801">
+  <simulation>
+    <title>NAT64 multi-hop end-to-end test</title>
+    <speedlimit>1.0</speedlimit>
+    <randomseed>1</randomseed>

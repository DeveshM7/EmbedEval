+	init_foreign(&foreign_a, &port_a, make_foreign_desc(0x22, 2, 130, 100, 1), NULL);
+	init_foreign(&foreign_b, &port_b, make_foreign_desc(0x23, 3, 120, 100, 1), NULL);
+
+	map_port(&port_a, PTP_PS_LISTENING, &foreign_a);

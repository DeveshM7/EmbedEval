+	join_group();
+	k_msleep(THREAD_SLEEP);
+	zassert_false(is_join_msg_ok, "Unexpected join msg");
+
+	/* First leave should not send report due to two refs on the address */
+	is_leave_msg_ok = false;
+	leave_group();

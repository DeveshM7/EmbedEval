Bootstrap: localimage
From: {{ BASE_IMAGE }}

# EmbedEval instance zephyr__zephyr-101462 -- generated by scripts/generate_instance.py.
#
# Built FROM the shared SDK image of this PR's era (Python 3.12, SDK
# 0.17.4), whose path is passed at build time:
#
#   apptainer build --fakeroot --build-arg BASE_IMAGE=<zephyr-sdk-0.17.4-py3.12.sif> \
#       zephyr__zephyr-101462.sif instance.def
#
# Adds the PR's workspace: Zephyr at the base commit with its modules and its
# own Python requirements, the PR's test changes without its fix, and a first
# build of the chosen board and scenario so later builds are incremental.

%arguments
    BASE_IMAGE=zephyr-sdk.sif

%files
    test_patch.diff /opt/embedeval/test_patch.diff
    instance.json /opt/embedeval/instance.json
    run_tests.py /usr/local/bin/run_tests

%post
    set -e
    # %post does not see the base layers' %environment; restate what it needs.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    export ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-0.17.4
    export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
    export ZEPHYR_BASE=/testbed
    # No package caches: nothing left in the image to clean up (deleting a
    # cache tree under the build's fakeroot mode failed intermittently).
    export UV_NO_CACHE=1
    export PIP_NO_CACHE_DIR=1
    export CCACHE_DISABLE=1
    retry() { for i in 1 2 3; do "$@" && return 0; echo "retry $i: $*"; sleep 20; done; return 1; }

    # Zephyr at the base commit. Blobless: full history, file contents fetched
    # on demand, so any commit can be checked out.
    retry git clone -q --filter=blob:none https://github.com/zephyrproject-rtos/zephyr.git /testbed
    cd /testbed
    git checkout -q 4f2ee86cd44863a9527b91485cbef01d4c711e4d

    # The era's Python with this commit's own requirements. setuptools<82 in
    # every era: it provides pkg_resources (twister 2023-05..2024-08 imports
    # it) and the distutils shim (pre-2022-07 trees on Python 3.12+).
    uv venv -q --seed --python 3.12 /opt/venv
    # pip, not `uv pip`: under the build's fakeroot mode uv intermittently
    # failed to read back files it had just unpacked into its cache.
    retry /opt/venv/bin/pip install -q --no-cache-dir west "setuptools<82" \
        -r scripts/requirements-base.txt \
        -r scripts/requirements-build-test.txt \
        -r scripts/requirements-run-test.txt
    export PATH=/opt/venv/bin:$PATH

    # Modules: narrow, depth 1. West's top directory is / (the parent of
    # /testbed), as in the Docker instances.
    west init -l /testbed
    retry west update --narrow -o=--depth=1

    # The PR's test changes without its fix.
    git apply /opt/embedeval/test_patch.diff
    printf 'twister-out/\ntwister-out.*\ntwister-out.log\ntags\n' >> .git/info/exclude
    # ctags index for code navigation, as in the Docker instances; the agent's
    # prompt points to it.
    ctags -R --languages=C,C++ --exclude=twister-out -f /testbed/tags . || true
    chmod 755 /usr/local/bin/run_tests

    # First build of the chosen board and scenario. Allowed to fail: without
    # the fix the test often cannot compile (it uses what the fix adds).
    run_tests --build-only || true

%environment
    # A layer's %environment replaces its base's, so this is the full set.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    export LANG=C.UTF-8
    export ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-0.17.4
    export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
    export ZEPHYR_BASE=/testbed
    export PATH=/opt/venv/bin:$PATH
    # ccache would write under a home directory that, in a contained run, is a
    # 16 MB in-memory filesystem; full builds then fail without a message.
    export CCACHE_DISABLE=1

%labels
    embedeval.instance zephyr__zephyr-101462
    embedeval.base_commit 4f2ee86cd44863a9527b91485cbef01d4c711e4d

{
  "suite": "gtest",
  "target": "ot-ftd-gtest",
  "configure": "script/cmake-build simulation",
  "cmake_args": [
    "-DOT_BUILD_GTEST=ON",
    "-DOT_BORDER_ROUTING=ON",
    "-DOT_BORDER_ROUTING_DHCP6_PD=ON",
    "-DOT_WAKE_INITIATOR=ON",
    "-DOT_WAKE_LISTENER=ON",
    "-DOT_COMPILE_WARNING_AS_ERROR=OFF"
  ],
  "fail_to_pass": [
    "DatasetManagerSave.shouldNotTriggerStateCallbackWhenTimestampIsEqual",
    "DatasetManagerSave.shouldNotTriggerStateCallbackWhenTimestampIsOlder"
  ],
  "pass_to_pass": [
    "otDatasetSetActiveTlvs.shouldTriggerStateCallbackOnSuccess",
    "otDatasetSetActiveTlvs.shouldTriggerStateCallbackEvenWhenTimestampIsOlder",
    "otDatasetIsValid.shouldReturnTrueForValidActiveDataset",
    "otDatasetIsValid.shouldReturnFalseForIncompleteActiveDataset",
    "otDatasetIsValid.shouldReturnFalseForDuplicatedTlvs",
    "otDatasetIsValid.shouldReturnTrueForValidPendingDataset",
    "otDatasetIsValid.shouldReturnFalseForIncompletePendingDataset",
    "DatasetManagerSave.shouldTriggerStateCallbackWhenTimestampIsNewer",
    "UdpTest.shouldSuccessWhenBindingMulticastAddressAndReceiveFromIt",
    "UdpTest.shouldSuccessWhenBindingMulticastAddressAndNoReceiveFromDifferentMulticast",
    "UdpTest.shouldSuccessWhenBindingMulticastAddressAndNoReceiveIfNotSubscribed"
  ]
}

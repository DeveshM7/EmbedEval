 K_SEM_DEFINE(l4_connected, 0, 1);
 K_SEM_DEFINE(l4_disconnected, 0, 1);
 
@@ -125,10 +127,69 @@ ZTEST(conn_mgr_nsos, test_conn_mgr_nsos)

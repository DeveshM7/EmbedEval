{
  "suite": "gtest",
  "target": "ot-radio-spinel-rcp-gtest",
  "configure": "script/cmake-build simulation",
  "cmake_args": [
    "-DOT_BUILD_GTEST=ON",
    "-DOT_BORDER_ROUTING=ON",
    "-DOT_BORDER_ROUTING_DHCP6_PD=ON",
    "-DOT_WAKE_INITIATOR=ON",
    "-DOT_WAKE_LISTENER=ON",
    "-DOT_COMPILE_WARNING_AS_ERROR=OFF"
  ],
  "fail_to_pass": [
    "RadioSpinelTransmit.shouldRejectReceiveDuringPendingTransmit"
  ],
  "pass_to_pass": [
    "RadioSpinelTransmit.shouldPassDesiredTxPowerToRadioPlatform",
    "RadioSpinelTransmit.shouldCauseSwitchingToRxChannelAfterTxDone",
    "RadioSpinelTransmit.shouldSkipCsmaCaWhenDisabled",
    "RadioSpinelTransmit.shouldPerformCsmaCaWhenEnabled",
    "RadioSpinelTransmit.shouldNotCauseSwitchingToRxAfterTxDoneIfNotRxOnWhenIdle",
    "RadioSpinelTransmit.shouldSkipCsmaBackoffWhenCsmaCaIsEnabledAndMaxBackoffsIsZero",
    "RadioSpinelReceiveAt.shouldReceiveAtGiveRadioTime",
    "RadioSpinelSrcMatch.shouldBeAbleToEnableRadioSrcMatch",
    "RadioSpinelSrcMatch.shouldBeAbleToDisableRadioSrcMatch",
    "RadioSpinelSrcMatch.shouldBeAbleToAddRadioSrcMatchShortEntry",
    "RadioSpinelSrcMatch.shouldBeAbleToClearRadioSrcMatchShortEntry",
    "RadioSpinelSrcMatch.shouldBeAbleToAddRadioSrcMatchExtEntry",
    "RadioSpinelSrcMatch.shouldBeAbleToClearRadioSrcMatchExtEntry",
    "RadioSpinelSrcMatch.shouldBeAbleToClearAllRadioSrcMatchShortEntres",
    "RadioSpinelSrcMatch.shouldBeAbleToClearAllRadioSrcMatchExtEntres",
    "RadioSpinelSrcMatch.shouldNotDuplicateSrcMatchEntriesOnRestoreProperties",
    "RadioSpinelMaxPowerTable.shouldRestoreEachChannelWithItsOwnPower",
    "RadioSpinelMaxPowerTable.shouldNotTouchTheRcpWhenNoChannelWasConfigured",
    "RadioSpinelMaxPowerTable.shouldSurviveAnRcpThatDoesNotImplementIt",
    "RadioSpinelProperty.shouldSetEmptyPropertyValue",
    "RadioSpinelProperty.shouldGetEmptyPropertyValue",
    "RadioSpinelRadioAvailability.shouldSendRadioAvailabilityPropertyWhenUpdated",
    "RadioSpinelRadioAvailability.shouldGetRadioAvailabilityProperty",
    "RadioSpinelRadioAvailability.shouldSendRadioAvailabilityPropertyAfterRadioStackReset"
  ]
}

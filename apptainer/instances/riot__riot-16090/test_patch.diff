+            const char *pos = iol->iol_base;
+            const char *end = pos + iol->iol_len;
+            while (pos < end) {
+                if (*pos == test_msg[pld_pos]) {
+                    size_t len = (size_t)end - (size_t)pos;
+                    if ((len > 4) &&
+                            (pld_pos + len <= sizeof(test_msg)) &&

+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_INST_GET_BY_IDX(0, 1);
+	zexpect_equal(dac_spec.channel_id, 20, "");
+
+	/* DAC_DT_SPEC_GET_BY_NAME_OR */
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_NAME_OR(TEST_DAC, ch1, {0});
+	zexpect_equal(dac_spec.channel_id, 10, "");
+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_NAME_OR(TEST_DAC, ch2, {0});
+	zexpect_equal(dac_spec.channel_id, 20, "");
+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_NAME_OR(TEST_DAC, ch_missing, {0});
+	zexpect_equal(dac_spec.channel_id, 0, "");

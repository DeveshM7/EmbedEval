+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_IDX_OR(TEST_DAC, 100, {0});
+	zexpect_equal(dac_spec.channel_id, 0, "");
+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_IDX_OR(TEST_MISSING, 0, {0});
+	zexpect_equal(dac_spec.channel_id, 0, "");
+
+	/* DAC_DT_SPEC_INST_GET_BY_IDX_OR */
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_INST_GET_BY_IDX_OR(0, 0, {0});
+	zexpect_equal(dac_spec.channel_id, 10, "");

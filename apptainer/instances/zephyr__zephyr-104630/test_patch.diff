+	zexpect_equal(dac_spec.channel_id, 20, "");
+
+	/* DAC_DT_SPEC_INST_GET_BY_NAME */
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_INST_GET_BY_NAME(0, ch1);
+	zexpect_equal(dac_spec.channel_id, 10, "");
+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_INST_GET_BY_NAME(0, ch2);
+	zexpect_equal(dac_spec.channel_id, 20, "");
+
+	/* DAC_DT_SPEC_GET_BY_IDX */
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_IDX(TEST_DAC, 0);
+	zexpect_equal(dac_spec.channel_id, 10, "");
+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_GET_BY_IDX(TEST_DAC, 1);
+	zexpect_equal(dac_spec.channel_id, 20, "");
+
+	/* DAC_DT_SPEC_INST_GET_BY_IDX */

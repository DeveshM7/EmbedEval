+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_INST_GET_BY_NAME_OR(0, ch_missing, {0});
+	zexpect_equal(dac_spec.channel_id, 0, "");
+
+	dac_spec = (struct dac_dt_spec)DAC_DT_SPEC_INST_GET_BY_NAME_OR(100, ch1, {0});
+	zexpect_equal(dac_spec.channel_id, 0, "");
+
+	/* DAC_DT_SPEC_GET_BY_IDX_OR */

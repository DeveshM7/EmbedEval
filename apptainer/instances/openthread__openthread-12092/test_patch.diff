+uint32_t DetermineQueryWaitTime(uint8_t aQueryCount)
+{
+    uint32_t interval = 125;
+
+    if (aQueryCount == 0)
+    {
+        interval = 125;
+    }
+    else if (aQueryCount <= 12)
+    {
+        interval = (1U << (aQueryCount - 1)) * 1000;
+        interval += (interval / 32) + 1;
+    }
+    else
+    {
+        interval = 3600 * 1000;
+        interval += (interval / 32) + 1;
+    }
+
+    return interval;
+}

+    static void MockDeviceAttachedToNetwork(Instance *aInstance)
+    {
+        SuccessOrQuit(otThreadBecomeLeader(aInstance));
+        otTaskletsProcess(aInstance);
+        VerifyOrQuit(otThreadGetDeviceRole(aInstance) == OT_DEVICE_ROLE_LEADER);
+    }

diff --git a/sys/log/full/selftest/fcb2_bookmarks/src/log_test_fcb_bookmarks_util.c b/sys/log/full/selftest/fcb2_bookmarks/src/log_test_fcb_bookmarks_util.c
new file mode 100644
index 000000000..25d701871
--- /dev/null
+++ b/sys/log/full/selftest/fcb2_bookmarks/src/log_test_fcb_bookmarks_util.c
@@ -0,0 +1,257 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one * or more contributor license agreements.  See the NOTICE file
+ * distributed with this work for additional information
+ * regarding copyright ownership.  The ASF licenses this file
+ * to you under the Apache License, Version 2.0 (the

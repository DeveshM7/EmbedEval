+    mov     x9, sp
+    str     x9, [x0]                /* sf->mainsp = sp */
+
+    /*
+     * Switch the stack so that the stack pointer saved in 'sf->sf_jb' points
+     * to the task stack, just below 'sf'.
+     */
+    and     x9, x0, #-16            /* align sp on 16-byte boundary */

Bootstrap: localimage
From: {{ BASE_IMAGE }}

# EmbedEval instance mynewt__mynewt-2201 -- rendered by scripts/render_mynewt_instance.py.
#
# Built FROM the shared Mynewt image (base.def), whose path is passed at build
# time, as is the mynewt-core repository (GitHub unless scripts/build_instances.py
# binds a local clone to /embedeval-src/mynewt-core.git):
#
#   apptainer build --fakeroot --build-arg BASE_IMAGE=<mynewt-sim.sif> \
#       mynewt__mynewt-2201.sif instance.def
#
# The Apptainer counterpart of templates/mynewt/Dockerfile.tmpl: mynewt-core at
# the base commit in /testbed with the PR's selftest changes committed, and a
# newt project (native BSP, compiler/sim) in /project.

%arguments
    BASE_IMAGE=mynewt-sim.sif
    CORE_REPO=https://github.com/apache/mynewt-core.git

%files
    test_patch.diff /opt/benchmark/test_patch.diff
    bench.json /opt/benchmark/metadata.json
    run_tests.sh /usr/local/bin/run_tests
    sim_arm64.patch /opt/benchmark/sim_arm64.patch

%post
    set -e
    retry() { for i in 1 2 3; do "$@" && return 0; echo "retry $i: $*"; sleep 20; done; return 1; }
    git init -q /testbed
    cd /testbed
    git remote add origin https://github.com/apache/mynewt-core.git
    SRC={{ CORE_REPO }}
    [ -d /embedeval-src/mynewt-core.git/objects ] && SRC=/embedeval-src/mynewt-core.git
    retry git fetch -q --depth 1 $SRC 3dc483fff8ce29a963475d4d84bb90f86b9a09a7
    git checkout -q --detach FETCH_HEAD
    # ARM64 host only: the sim has no aarch64 context-switch code upstream.
    # The port is committed, so it is part of the base the agent starts
    # from, never of its patch.
    if [ "$(uname -m)" = aarch64 ]; then
        git apply /opt/benchmark/sim_arm64.patch
        git -c user.name=EmbedEval -c user.email=benchmark@localhost \
            commit -q -a -m "sim: aarch64 host support"
    fi
    git apply /opt/benchmark/test_patch.diff
    git add -A
    git -c user.name=EmbedEval -c user.email=benchmark@localhost \
        commit -q -m "Benchmark starting snapshot with regression tests"

    mkdir -p /project/repos /project/targets/unittest
    ln -s /testbed /project/repos/apache-mynewt-core
    printf '%s\n' \
        'project.name: benchmark' \
        'project.repositories:' \
        '    - apache-mynewt-core' \
        'repository.apache-mynewt-core:' \
        '    type: github' \
        '    vers: 0.0.0' \
        '    user: apache' \
        '    repo: mynewt-core' \
        > /project/project.yml
    printf '%s\n' \
        'target.bsp: "@apache-mynewt-core/hw/bsp/native"' \
        'target.build_profile: "debug"' \
        'target.compiler: "@apache-mynewt-core/compiler/sim"' \
        > /project/targets/unittest/target.yml
    printf '%s\n' 'pkg.name: targets/unittest' 'pkg.type: target' 'pkg.cflags:' '    - -Wno-error=stringop-overflow' > /project/targets/unittest/pkg.yml
    chmod 755 /usr/local/bin/run_tests
    run_tests --install-deps

%environment
    export LANG=C.UTF-8

%labels
    embedeval.instance mynewt__mynewt-2201
    embedeval.base_commit 3dc483fff8ce29a963475d4d84bb90f86b9a09a7

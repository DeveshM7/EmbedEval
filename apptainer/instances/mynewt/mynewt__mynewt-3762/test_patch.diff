+               .type = CborAttrObjectType,
+               .addr.obj = test_sub_attr_bm,
+               .nodefault = true },
+        [3] = { .attribute = NULL }
+    };
+
+    test_encode_data();
+
+    rc = cbor_read_flat_attrs(test_cbor_buf, test_cbor_len, test_attrs);
+    TEST_ASSERT(rc == 0);
+    TEST_ASSERT(bm_val == 7);

+               .addr.string = test_str_3a,
+               .len = sizeof(test_str_3a),
+               .nodefault = true },
+        [1] = { .attribute = "aa",
+               .type = CborAttrTextStringType,
+               .addr.string = test_str_2a,
+               .len = sizeof(test_str_2a),
+               .nodefault = true },
+        [2] = { .attribute = "a",
+               .type = CborAttrTextStringType,

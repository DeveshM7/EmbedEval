{
  "suite": "gtest",
  "target": "ot-posix-gtest",
  "oracle": "compile",
  "compile_symbols": [
    "src/posix/platform/multicast_forwarding.cpp",
    "src/posix/platform/multicast_forwarding.hpp",
    "MulticastForwarding",
    "BuildEthernetFrame",
    "TokenBucket",
    "RateLimiter",
    "DedupCache",
    "kForward",
    "kNotIp6",
    "kNotMulticast",
    "kScopeTooSmall",
    "kBadSource",
    "kHopLimitExceeded",
    "kIp6HeaderSize",
    "kEthernetHeaderSize",
    "kMacSize"
  ],
  "configure": "script/cmake-build simulation",
  "cmake_args": [
    "-DOT_BUILD_GTEST=ON",
    "-DOT_BORDER_ROUTING=ON",
    "-DOT_BORDER_ROUTING_DHCP6_PD=ON",
    "-DOT_WAKE_INITIATOR=ON",
    "-DOT_WAKE_LISTENER=ON",
    "-DOT_COMPILE_WARNING_AS_ERROR=OFF"
  ],
  "fail_to_pass": [
    "Check.ForwardsSiteLocalGroupFromUlaSource",
    "Check.ReportsRealLengthOfPaddedFrame",
    "Check.RejectsTruncatedAndNonIp6",
    "Check.RejectsUnicastDestination",
    "Check.RejectsScopesSmallerThanAdminLocal",
    "Check.RejectsBadSources",
    "Check.RejectsHopLimitBelowTwo",
    "DedupCache.SecondSightingIsDuplicateAndHopLimitIsIgnored",
    "DedupCache.WindowRunsFromTheFirstSighting",
    "DedupCache.EvictsTheOldestWhenFull",
    "TokenBucket.ZeroRateNeverRefills",
    "TokenBucket.RefillsAtRateUpToBurst",
    "RateLimiter.GroupOverItsLimitDoesNotDrainTheSharedBudget",
    "RateLimiter.GroupIsNotChargedWhenTheSharedBudgetIsExhausted",
    "BuildEthernetFrame.MapsGroupToMulticastMac"
  ],
  "pass_to_pass": []
}
